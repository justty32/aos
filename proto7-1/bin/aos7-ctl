#!/usr/bin/env python3
"""aos7-ctl 的命令列入口——本體在 ../lib/aos7_ctl.py。"""
# 供人或任務寫 daemon／任務控制檔；參數與原子寫檔交給本體（spec.md 第 8 節）。
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import aos7_ctl  # noqa: E402
if __name__ == "__main__":
    sys.exit(aos7_ctl.main())
