{
  "_metainfo": {
    "_type": "aos_team_routes",
    "_version": 1
  },
  "negations": [
    "不要",
    "別",
    "取消",
    "不用",
    "勿",
    "不准"
  ],
  "routes": [
    {
      "name": "tasks",
      "pattern": "(列|看)(一下)?(任務|單子)",
      "do": "tool",
      "run": [
        "task",
        "ls"
      ],
      "tests": {
        "hit": [
          "列任務",
          "看一下單子"
        ],
        "miss": [
          "列任務給 bob 看"
        ]
      }
    },
    {
      "name": "waiting",
      "pattern": "(有什麼|哪些)(在)?等我(回答|決定)的?",
      "do": "tool",
      "run": [
        "wait",
        "ls"
      ],
      "tests": {
        "hit": [
          "有什麼等我回答的"
        ],
        "miss": [
          "等我回來再說"
        ]
      }
    },
    {
      "name": "one-character",
      "pattern": "補人物 ?(?P<name>[^\\s，,、：:；;]+)",
      "do": "handoff",
      "handoff": {
        "assignee": "writer-1",
        "workflow": "workflows/lore-extraction/README.md",
        "goal": "補人物「{name}」：讀 aos-drafts/{name}/ 的詞條草稿與證據草稿，逐句回原文核對改正後，寫成 lore/characters/{name}.md 與 lore/evidence/characters/{name}.md（超過 5120 位元組就照人格第 8 條拆檔），回填 character_map、lore/characters/INDEX.md 與五處計數。這張單只有你在改索引，不用拿鎖。",
        "facts": "aos-drafts/{name}/",
        "done_when": [
          {
            "kind": "file_exists",
            "path": "lore/characters/{name}.md"
          },
          {
            "kind": "file_exists",
            "path": "lore/evidence/characters/{name}.md"
          },
          {
            "kind": "check",
            "name": "last_line_contains",
            "args": {
              "path": "lore/characters/{name}.md",
              "text": "詳見："
            }
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "lore/characters/{name}.md",
              "text": "evidence/characters/{name}.md"
            }
          },
          {
            "kind": "check",
            "name": "max_bytes",
            "args": {
              "path": "lore/evidence/characters/{name}.md",
              "bytes": 5119
            }
          },
          {
            "kind": "check",
            "name": "max_bytes",
            "args": {
              "path": "lore/evidence/characters/{name}",
              "bytes": 5119,
              "missing_ok": true
            }
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "lore/characters/INDEX.md",
              "text": "[{name}]({name}.md)"
            }
          },
          {
            "kind": "cmd_ok",
            "run": [
              "python3",
              "scripts/check_links.py",
              "lore"
            ]
          },
          {
            "kind": "cmd_ok",
            "run": [
              "python3",
              "scripts/check_simplified.py",
              "lore/characters/{name}.md",
              "lore/evidence/characters/{name}.md"
            ]
          },
          {
            "kind": "judge",
            "text": "證據檔（含拆出的子檔）每一列：寫的原文檔名＋行號打開後確實說了那件事、行號沒超過檔長；推論與原文明寫分開、原文沒說的有明講未知；同名／泛稱／共用立繪的切割有交代"
          },
          {
            "kind": "judge",
            "text": "詞條 lore/characters/{name}.md 每一句都能在證據檔找到依據、沒有證據檔沒有的新說法，全劇透（結局、生死有寫或明講未知）"
          },
          {
            "kind": "judge",
            "text": "character_map 對應敘事線分片有 {name} 的一列且連結對；lore/characters.md、lore/characters/INDEX.md、lore/INDEX.md、lore/evidence/README.md、lore/evidence/character_map.md 的計數是重新點算、彼此一致"
          }
        ]
      },
      "tests": {
        "hit": [
          "補人物 老何塞",
          "補人物老成的杜林人（雙月密錄）"
        ],
        "miss": [
          "補一批人物：老木頭、老薑、老財",
          "補人物 老木頭、老薑",
          "不要補人物 老何塞"
        ]
      }
    }
  ]
}
