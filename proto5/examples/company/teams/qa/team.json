{
  "_metainfo": {
    "_type": "aos_team",
    "_version": 1
  },
  "project": "~/tmp/company-run/proj",
  "tz": "Asia/Taipei",
  "members": {
    "qa-inspector": {
      "template": "worker",
      "model": "deepseek-chat",
      "mail_to": [
        "human"
      ],
      "mounts": {
        "arknights-corpus": {
          "$opt": "ro",
          "$val": "~/tmp/arknights-corpus"
        }
      }
    }
  },
  "limits": {
    "stale_minutes": 30,
    "max_members": 3
  },
  "spawn": {
