[
  {
    "type": "function",
    "function": {
      "name": "note",
      "description": "Long-term notes, not chat memory; call find to search. add upserts by key; find matches words/tags; get returns text; rm deletes.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {"type": "string", "enum": ["add", "find", "get", "rm"]},
          "key": {"type": "string", "description": "max 80 chars (add/get/rm)"},
          "text": {"type": "string", "description": "max 4000 chars (add)"},
          "tags": {"type": "array", "items": {"type": "string"}, "description": "up to 10 (add/find)"},
          "query": {"type": "string", "description": "search words (find)"},
          "limit": {"type": "integer", "description": "default 20, max 100 (find)"}
        },
        "required": ["op"]
      }
    },
    "_meta": {"argv": ["tools/notes/note"]}
  },
  {
    "type": "function",
    "function": {
      "name": "recall",
      "description": "Find old text in your chat memory and compacted archives; all words must match. Returns file, message number, snippet.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {"type": "string", "description": "words, case-insensitive"},
          "limit": {"type": "integer", "description": "default 5, max 20"}
        },
        "required": ["query"]
      }
    },
    "_meta": {"argv": ["tools/notes/recall"]}
  },
  {
    "type": "function",
    "function": {
      "name": "context",
      "description": "Size of your chat memory: messages per role, estimated tokens, the three largest.",
      "parameters": {"type": "object", "properties": {}}
    },
    "_meta": {"argv": ["tools/notes/context"]}
  }
