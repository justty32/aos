#!/usr/bin/env python3
"""review_result：審查員逐條回一張審查子單（寫一份 kind=review_result 申請）。"""
import sys

from _team import arg, fail, load_ticket, only_keys, run, send


def main(args, cfg):
    only_keys(args, ('task', 'items'))
    tid = arg(args, 'task', str, required=True)
    items = arg(args, 'items', list, required=True)
    t = load_ticket(cfg, tid)
    if not t.get('parent'):
        fail('BadArguments', '%s is not a review task (they look like t-0001.r1)' % tid)
    if t.get('assignee') != cfg['member']:
        fail('BadArguments', '%s is assigned to %s, not you' % (tid, t.get('assignee')))
    # i is the ORIGINAL index from the parent task's done_when (review_of.indices), not 0..n here
    # (09-24 W2C fix: numbering used to be re-counted from 0, out of sync with task show / board show).
    want = (t.get('review_of') or {}).get('indices') or list(range(len(t.get('done_when', []))))
    seen = []
    for k, it in enumerate(items):
        if not isinstance(it, dict) or set(it) != {'i', 'pass', 'why'}:
            fail('BadArguments', 'items[%d] must be {"i": n, "pass": true|false, "why": "..."}' % k)
        if not isinstance(it['i'], int) or isinstance(it['i'], bool) or it['i'] not in want or it['i'] in seen:
            fail('BadArguments', 'items[%d].i must be one of %s, each once' % (k, want))
        if not isinstance(it['pass'], bool) or not isinstance(it['why'], str) or not it['why'].strip():
            fail('BadArguments', 'items[%d] needs pass true/false and a one-line why' % k)
        seen.append(it['i'])
    if sorted(seen) != want:
        fail('BadArguments', 'answer every item: %s (missing %s)' % (want, sorted(set(want) - set(seen))))
    rid = send(cfg, 'review_result', {'task': tid, 'items': items})
    verdict = 'PASS' if all(it['pass'] for it in items) else 'FAIL'
    return 'queued review_result %s for %s (%s). End this turn.' % (rid, tid, verdict)


if __name__ == '__main__':
    sys.exit(run(main))
