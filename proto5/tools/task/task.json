[
  {
    "type": "function",
    "function": {
      "name": "handoff",
      "description": "Hand one piece of work to a team mate. The postman opens a task (t-NNNN) and sends it; you get mail when it is done, blocked or failed.",
      "parameters": {
        "type": "object",
        "properties": {
          "assignee": {"type": "string", "description": "Team mate name"},
          "workflow": {"type": "string", "description": "Workflow entry file to follow, or \"無\" if none"},
          "goal": {"type": "string", "description": "One sentence: what done looks like"},
          "facts": {"type": "string", "description": "Facts file or short facts"},
          "done_when": {
            "type": "array",
            "description": "After DONE: file_exists{path}, table_filled{path}, check{name,args} (contains/not_contains{path,text}, wf_residue, wf_lint_strict), cmd_ok{run}, judge{text} (reviewer)",
            "items": {"type": "object", "properties": {"kind": {"type": "string", "enum": ["file_exists", "table_filled", "check", "cmd_ok", "judge"]}}, "required": ["kind"]}
          },
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
          "deadline_minutes": {"type": "integer", "minimum": 1}
        },
        "required": ["assignee", "workflow", "goal", "done_when"]
      }
    },
    "_meta": {"argv": ["tools/task/handoff"]}
  },
  {
    "type": "function",
    "function": {
      "name": "board",
      "description": "Read the team task board. op=ls lists open tasks (all=true includes finished); op=show shows one task.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {"type": "string", "enum": ["ls", "show"]},
          "task": {"type": "string", "description": "Task id for show"},
          "all": {"type": "boolean"}
        }
      }
    },
    "_meta": {"argv": ["tools/task/board"]}
  },
  {
    "type": "function",
    "function": {
      "name": "review_result",
      "description": "Answer a review task: one item per listed point, each with pass and a one-line why.",
      "parameters": {
        "type": "object",
        "properties": {
          "task": {"type": "string", "description": "Review task id, like t-0001.r1"},
          "items": {
            "type": "array",
            "items": {"type": "object", "properties": {"i": {"type": "integer"}, "pass": {"type": "boolean"}, "why": {"type": "string"}}, "required": ["i", "pass", "why"]}
          }
        },
        "required": ["task", "items"]
      }
    },
    "_meta": {"argv": ["tools/task/review_result"]}
  },
  {
    "type": "function",
    "function": {
      "name": "ask_human",
      "description": "Ask the user something only they can decide. The answer arrives later as new mail; end your turn after asking.",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {"type": "string"},
          "options": {"type": "array", "items": {"type": "string"}},
          "default": {"type": "string"},
          "reply_to": {"type": "string", "description": "Task id this is about"}
        },
        "required": ["question"]
      }
    },
    "_meta": {"argv": ["tools/task/ask_human"]}
  },
  {
    "type": "function",
    "function": {
      "name": "compact_me",
      "description": "Shrink your own memory: old rounds become a short summary after this turn ends.",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"},
          "keep_rounds": {"type": "integer", "minimum": 0, "maximum": 1000, "description": "Recent rounds kept word for word"},
          "max_tokens": {"type": "integer", "minimum": 100}
        }
      }
    },
    "_meta": {"argv": ["tools/task/compact_me"]}
  },
  {
    "type": "function",
    "function": {
      "name": "lock",
      "description": "Short-term exclusive lock on a file or folder name, for teammates sharing a project. acquire fails fast if busy; ls/acquire/release results arrive as new mail.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {"type": "string", "enum": ["acquire", "release", "ls"]},
          "name": {"type": "string"},
          "why": {"type": "string"},
          "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 86400, "description": "Auto-release after this long if not released (default 1800)"}
        },
        "required": ["op"]
      }
    },
    "_meta": {"argv": ["tools/task/lock"]}
  },
  {
    "type": "function",
    "function": {
      "name": "access_request",
      "description": "Ask the user to mount one more folder or turn networking on for you. You cannot edit access.json yourself; the answer arrives as new mail.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Mount name to request"},
          "path_hint": {"type": "string", "description": "Where it should point"},
          "mode": {"type": "string", "enum": ["ro", "rw"]},
          "why": {"type": "string"}
        },
        "required": ["name", "path_hint", "mode", "why"]
      }
    },
    "_meta": {"argv": ["tools/task/access_request"]}
  },
  {
    "type": "function",
    "function": {
      "name": "persona_propose",
      "description": "Propose adding one sentence to your own persona. You cannot edit it yourself; the user's answer arrives as new mail.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "The sentence to add"},
          "why": {"type": "string"}
        },
        "required": ["text"]
      }
    },
    "_meta": {"argv": ["tools/task/persona_propose"]}
  },
  {
    "type": "function",
    "function": {
      "name": "routine_propose",
      "description": "Propose a recurring heartbeat routine (every/daily/once). Opens a question for the user to approve; only runs after they say yes.",
      "parameters": {
        "type": "object",
        "properties": {
          "op": {"type": "string", "enum": ["add", "rm"]},
          "name": {"type": "string"},
          "every": {"type": "string", "description": "Interval like 2m, 6h, 1d"},
          "daily": {"type": "string", "description": "Time of day like 09:00"},
          "once": {"type": "string", "description": "One-shot ISO timestamp with timezone"},
          "to": {"type": "string", "description": "Who does it (team mate name)"},
          "goal": {"type": "string"},
          "done_when": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string", "enum": ["file_exists", "table_filled", "check", "judge"]}}, "required": ["kind"]}},
          "workflow": {"type": "string"},
          "tz": {"type": "string"},
          "timeout_minutes": {"type": "integer", "minimum": 1},
          "retries": {"type": "integer", "minimum": 0, "maximum": 5}
        },
        "required": ["name"]
      }
    },
    "_meta": {"argv": ["tools/task/routine_propose"]}
  }
]
