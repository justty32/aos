#!/usr/bin/env python3
"""spawn_member：申請生一個新成員（T-spawn，第三波 W3-1；spec/team/spawn.md）。

只寄一份 kind: spawn 申請；郵差照名冊檢查（模板白名單、人數上限、mail_to 與權限不超過自己），
過了開一題「[成員]」問人，人 aos-team spawn approve 才真的生家、登記、改名冊，然後回一封信給你。
新成員跟其他成員一樣是名冊的一列（平的），不是你的「小孩」；你們之間一樣只經郵差交流。
這裡只擋手誤（名字格式、mail_to 超過自己的），真正的把關在郵差。
"""
import re
import sys

from _team import arg, fail, only_keys, run, send

NAME = re.compile(r'[a-z][a-z0-9_-]{0,31}\Z')


def main(args, cfg):
    only_keys(args, ('template', 'name', 'reason', 'mail_to'))
    template = arg(args, 'template', str, required=True)
    if '/' in template:
        fail('BadArguments', 'template must be a built-in template name (no /)')
    allowed = cfg.get('spawn_templates')
    if isinstance(allowed, list) and template not in allowed:
        fail('BadArguments', 'template %r is not allowed; the team allows: %s'
             % (template, ', '.join(allowed) or 'none (the user has not enabled spawning)'))
    name = arg(args, 'name', str, required=True)
    if not NAME.match(name) or name in cfg.get('members', []) or name in ('human', 'post', 'beat'):
        fail('BadArguments', 'name must match [a-z][a-z0-9_-]{0,31} and not be taken (taken: %s)'
             % ', '.join(cfg.get('members', [])))
    reason = arg(args, 'reason', str, required=True)
    if len(reason) > 500:
        fail('BadArguments', 'reason is too long (max 500 chars)')
    body = {'template': template, 'name': name, 'reason': reason}
    mail_to = arg(args, 'mail_to', list)
    if mail_to is not None:
        mine = set(cfg.get('mail_to', [])) | {cfg['member']}
        over = [x for x in mail_to if not isinstance(x, str) or x not in mine]
        if over:
            fail('BadArguments', 'mail_to can only list you or names in your mail_to (%s)' % ', '.join(sorted(mine)))
        body['mail_to'] = mail_to
    rid = send(cfg, 'spawn', body)
    return 'queued spawn request %s for %s. The user decides; the answer arrives as new mail. End this turn.' % (rid, name)


if __name__ == '__main__':
    sys.exit(run(main))
