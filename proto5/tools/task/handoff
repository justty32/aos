#!/usr/bin/env python3
"""handoff：領隊派一件事（寫一份 kind=handoff 申請；郵差開單並派出去）。"""
import sys

from _team import arg, fail, only_keys, run, send

KEYS = ('assignee', 'workflow', 'goal', 'facts', 'done_when', 'max_attempts', 'deadline_minutes')
KINDS = {'file_exists': 'path', 'table_filled': 'path', 'check': 'name', 'cmd_ok': 'run', 'judge': 'text'}
# G（09-24 W2C，t5/README.md §8）：兩輪試玩，領隊派「把 X.md 改寫得更白話」這類單都忘記放 wf_lint_strict。
# 選在這裡（handoff 這一層）機械補、不改門房規則：門房／routes.json 是 A 隊地盤（T-route），這裡改動範圍最小、
# 不管請求是不是經過門房都補得到（領隊自己開單、心跳照例行開單一樣有效）。判法很土：goal／facts／workflow
# 合起來的文字裡同時有 .md 與一個改寫用詞，就當作是「改 workflows 文件類」單子。
LINT_TRIGGER_WORDS = ('白話', '改寫', '更好懂', '更易讀', '講白話')


def _wants_auto_lint(body):
    text = ' '.join(str(body.get(k) or '') for k in ('goal', 'facts', 'workflow'))
    return '.md' in text and any(w in text for w in LINT_TRIGGER_WORDS)


def main(args, cfg):
    only_keys(args, KEYS)
    who = arg(args, 'assignee', str, required=True)
    if who == cfg['member']:
        fail('BadArguments', 'you cannot hand off to yourself')
    if who not in cfg.get('members', []) or who not in cfg.get('mail_to', []):
        workers = [m for m in cfg.get('mail_to', []) if m in cfg.get('members', [])]
        fail('BadArguments', 'assignee %r is not one of your team mates: %s' % (who, ', '.join(workers) or '(none)'))
    body = {'assignee': who, 'workflow': arg(args, 'workflow', str, required=True),
            'goal': arg(args, 'goal', str, required=True)}
    done = arg(args, 'done_when', list, required=True)
    if not done:
        fail('BadArguments', 'done_when needs at least one item')
    for i, it in enumerate(done):
        if not isinstance(it, dict) or it.get('kind') not in KINDS:
            fail('BadArguments', 'done_when[%d].kind must be one of %s' % (i, ', '.join(KINDS)))
        key = KINDS[it['kind']]
        if key == 'run':            # cmd_ok：指令陣列；在不在 team.json 的白名單由郵差驗（不在＝退件、列出可用的）
            if not isinstance(it.get('run'), list) or not it['run'] or \
                    not all(isinstance(x, str) and x for x in it['run']):
                fail('BadArguments', 'done_when[%d] (cmd_ok) needs "run": a non-empty array of strings' % i)
            continue
        if not isinstance(it.get(key), str) or not it[key].strip():
            fail('BadArguments', 'done_when[%d] (%s) needs a non-empty "%s"' % (i, it['kind'], key))
    body['done_when'] = done
    facts = arg(args, 'facts', str)
    if facts is not None:
        body['facts'] = facts
    tries = arg(args, 'max_attempts', int)
    if tries is not None:
        if not 1 <= tries <= 10:
            fail('BadArguments', 'max_attempts must be 1..10')
        body['max_attempts'] = tries
    minutes = arg(args, 'deadline_minutes', int)
    if minutes is not None:
        if not 1 <= minutes <= 10080:
            fail('BadArguments', 'deadline_minutes must be 1..10080')
        body['deadline_minutes'] = minutes
    auto_lint = False
    if _wants_auto_lint(body) and not any(isinstance(d, dict) and d.get('kind') == 'check'
                                          and d.get('name') == 'wf_lint_strict' for d in body['done_when']):
        body['done_when'] = body['done_when'] + [{'kind': 'check', 'name': 'wf_lint_strict'}]
        auto_lint = True
    rid = send(cfg, 'handoff', body)
    note = ' (this looks like a wording rewrite of a workflows doc, so wf_lint_strict was auto-added to done_when.)' \
        if auto_lint else ''
    return ('queued handoff %s -> %s.%s The postman opens the task and sends it; you will get mail when it is '
            'done, blocked or failed. Nothing to wait for: end this turn.' % (rid, who, note))


if __name__ == '__main__':
    sys.exit(run(main))
