#!/usr/bin/env python3
"""ask_human：問人一個只有人能決定的問題（寫一份 kind=ask 申請；答案之後會是一封新信）。"""
import sys

from _team import arg, fail, only_keys, run, send


def main(args, cfg):
    only_keys(args, ('question', 'options', 'default', 'reply_to'))
    body = {'question': arg(args, 'question', str, required=True)}
    if len(body['question']) > 4000:
        fail('BadArguments', 'question is too long (max 4000 chars)')
    opts = arg(args, 'options', list)
    if opts is not None:
        if not opts or not all(isinstance(o, str) and o.strip() for o in opts):
            fail('BadArguments', 'options must be a non-empty array of strings')
        body['options'] = opts
    default = arg(args, 'default', str)
    if default is not None:
        if opts is not None and default not in opts:
            fail('BadArguments', 'default must be one of options')
        body['default'] = default
    reply = arg(args, 'reply_to', str)
    if reply is not None:
        body['reply_to'] = reply
    rid = send(cfg, 'ask', body)
    return ('queued question %s. The user answers with aos-team answer; the answer arrives as new mail. '
            'Do not wait: end this turn.' % rid)


if __name__ == '__main__':
    sys.exit(run(main))
