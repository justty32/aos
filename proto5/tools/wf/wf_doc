#!/usr/bin/env python3
"""wf_doc：唯讀讀 workflows 快照裡的手冊（IMPORT.md 等）；資料夾＝列目錄。只讀得到快照，讀不到專案或別處。"""
import sys
sys.dont_write_bytecode = True
import os  # noqa: E402
from _common import run, arg, resolve, fail, open_regular, ToolError, MAX_BYTES  # noqa: E402
import _wf  # noqa: E402
import _common  # noqa: E402

MAX_LIMIT = 2000
# T5 真跑：模型找不到手冊裡的 wf-init.sh，就照快照的 template/ 一檔一檔手抄（51 次模型、220 萬 token）。
# 手冊的指令在這個包裡都有對應的工具，讀手冊時先講清楚。
IMPORT_NOTE = ('[wf tools: the scripts below are already wrapped as tools - step 1 wf-init.sh = wf_init '
               '(no bash, no copying files by hand); steps 2-4: if there is a facts file, call wf_fill first '
               '(fills {{...}} from it, deletes 〔模板說明〕, lists what is left), then edit the rest; '
               'grep = wf_residue (gives file:line); step 5 wf-lint.sh = wf_lint.]\n\n')


def main(args, _root):
    # 快照在工具包裡（關牢時是 /opt/tool/snapshot），不在 /work 裡：碰得到的範圍只看快照本身，
    # 不看 AOS_TOOL_FENCE（不然關牢時一律 OutsideRoot；T5 真跑撞到）。
    _common._FENCE = None
    snap = os.path.realpath(_wf.SNAP)
    path = arg(args, 'path', str, '.')
    offset = arg(args, 'offset', int, 1)
    limit = arg(args, 'limit', int, MAX_LIMIT)
    if offset < 1:
        fail('BadArguments', 'offset is 1-based and must be >= 1')
    if not 1 <= limit <= MAX_LIMIT:
        fail('BadArguments', 'limit must be 1..%d' % MAX_LIMIT)
    try:
        full = resolve(snap, path or '.')
    except ToolError as e:
        if e.code == 'OutsideRoot':
            fail('OutsideRoot', '%s is outside the workflows snapshot; wf_doc only reads the workflows snapshot '
                 '(use read for project files)' % path)
        if e.code == 'NotFound':
            fail('NotFound', 'no such file in the workflows snapshot: %s (call wf_doc with no path to list it)'
                 % path)
        raise
    if os.path.isdir(full):
        names = sorted(os.listdir(full))
        return '\n'.join(n + ('/' if os.path.isdir(os.path.join(full, n)) else '') for n in names) or '(empty)'
    with open_regular(snap, full, path) as f:
        lines = f.read().decode('utf-8', 'replace').splitlines(True)
    total = len(lines)
    if total == 0:
        return '(empty file)'
    if offset > total:
        fail('BadArguments', 'offset %d is past the end of %s (%d lines)' % (offset, path, total))
    out, size = [], 0
    for line in lines[offset - 1:offset - 1 + limit]:
        b = len(line.encode('utf-8'))
        if size + b > MAX_BYTES and out:
            break
        out.append(line)
        size += b
    text = ''.join(out)
    if os.path.normpath(os.path.relpath(full, snap)) == 'IMPORT.md' and offset == 1:
        text = IMPORT_NOTE + text
    last = offset + len(out) - 1
    if last < total:
        text += ('' if text.endswith('\n') else '\n') + \
            '[showing lines %d-%d of %d; use offset=%d to continue]' % (offset, last, total, last + 1)
    return text


if __name__ == '__main__':
    sys.exit(run(main))
