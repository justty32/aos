#!/usr/bin/env python3
"""llm-call：把 prompt（argv 或 stdin）丟給 OpenAI 相容端點，印 assistant 的 message JSON。
環境：LLM_BASE（預設 http://localhost:1234/v1）、LLM_MODEL（預設 google/gemma-4-e4b）、LLM_TIMEOUT（秒，預設 120）、LLM_MAX_TOKENS（預設 2048；gemma-4 會先想，太小 content 是空的）。
退出碼：0 成功；1 連線／HTTP／回應形狀錯（stderr 一行）；2 沒有 prompt。"""
import json, os, sys, urllib.request, urllib.error

prompt = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else sys.stdin.read()
if not prompt.strip():
    print("llm-call: Usage: 沒有 prompt（argv 或 stdin）", file=sys.stderr); sys.exit(2)
base = os.environ.get("LLM_BASE", "http://localhost:1234/v1").rstrip("/")
body = {"model": os.environ.get("LLM_MODEL", "google/gemma-4-e4b"),
        "messages": [{"role": "user", "content": prompt}], "temperature": 0, "max_tokens": int(os.environ.get("LLM_MAX_TOKENS", "2048"))}
req = urllib.request.Request(base + "/chat/completions", data=json.dumps(body).encode(),
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=float(os.environ.get("LLM_TIMEOUT", "120"))) as r:
        data = json.load(r)
    message = data["choices"][0]["message"]
except (urllib.error.URLError, OSError, ValueError, KeyError, IndexError) as e:
    print("llm-call: %s: %s" % (type(e).__name__, e), file=sys.stderr); sys.exit(1)
print(json.dumps(message, ensure_ascii=False))
