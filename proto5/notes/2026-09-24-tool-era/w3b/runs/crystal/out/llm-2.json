{
  "_metainfo": {
    "_type": "aos_team_routes",
    "_version": 1,
    "crystal": {
      "candidates": [
        "llm-create-md",
        "llm-rename-md",
        "llm-count-lines",
        "llm-delete-line"
      ],
      "source": "llm",
      "made_at": "2026-09-24T23:20:22+08:00",
      "note": "候選不會自動生效：aos-team route test --file 這個檔 → aos-team route save 這個檔"
    }
  },
  "negations": [
    "不要",
    "別",
    "取消",
    "不用",
    "勿",
    "不准"
  ],
  "routes": [
    {
      "name": "tasks",
      "pattern": "(列|看)(一下)?(任務|單子)",
      "do": "tool",
      "run": [
        "task",
        "ls"
      ],
      "tests": {
        "hit": [
          "列任務",
          "看一下單子"
        ],
        "miss": [
          "列任務給 bob 看",
          "把任務刪掉"
        ]
      }
    },
    {
      "name": "waiting",
      "pattern": "(有什麼|哪些)(在)?等我(回答|決定)的?",
      "do": "tool",
      "run": [
        "wait",
        "ls"
      ],
      "tests": {
        "hit": [
          "有什麼等我回答的",
          "哪些在等我決定"
        ],
        "miss": [
          "等我回來再說"
        ]
      }
    },
    {
      "name": "routines",
      "pattern": "(列|看)(一下)?(例行|心跳|定時)(工作|排程)?",
      "do": "tool",
      "run": [
        "routine",
        "ls"
      ],
      "tests": {
        "hit": [
          "看一下例行",
          "列心跳排程",
          "看定時工作"
        ],
        "miss": [
          "加一條例行",
          "心跳停了嗎"
        ]
      }
    },
    {
      "name": "count-md",
      "pattern": "每 ?(?P<every>[1-9][0-9]*[mhd]) ?數一次 ?md ?檔",
      "do": "tool",
      "run": [
        "routine",
        "add",
        "count-md",
        "--every",
        "{every}",
        "--to",
        "worker-1",
        "--goal",
        "數專案裡有幾個 .md 檔（不含 .git），只把數字寫進 notes/md-count.txt（整檔覆蓋）",
        "--done-file",
        "notes/md-count.txt"
      ],
      "tests": {
        "hit": [
          "每 2m 數一次 md 檔",
          "每1h數一次md檔"
        ],
        "miss": [
          "數一次 md 檔",
          "每 2m 數一次 md 檔給我看看"
        ]
      }
    },
    {
      "name": "import",
      "pattern": "把 workflows 導入 (?P<project>\\S+)，照 (?P<facts>\\S+)",
      "do": "handoff",
      "handoff": {
        "assignee": "worker-1",
        "workflow": "IMPORT.md",
        "goal": "把 workflows 的 heartbeat 包導入專案（就是你的起點資料夾；人說的是 {project}），先用 wf_init 導入，再用 wf_fill 照專案裡的 {facts} 填佔位，剩下的照它列的處理；事實表沒有的用 ask_human 問，不要猜",
        "facts": "{facts}",
        "done_when": [
          {
            "kind": "check",
            "name": "wf_residue"
          },
          {
            "kind": "check",
            "name": "wf_lint_strict"
          },
          {
            "kind": "file_exists",
            "path": "AGENTS.md"
          },
          {
            "kind": "file_exists",
            "path": "workflows/tick.md"
          },
          {
            "kind": "file_exists",
            "path": "workflows/routines.md"
          },
          {
            "kind": "file_exists",
            "path": "workflows/schedule.md"
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "WORKFLOWS.md",
              "text": "(workflows/tick.md)"
            }
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "WORKFLOWS.md",
              "text": "(workflows/routines.md)"
            }
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "WORKFLOWS.md",
              "text": "(workflows/schedule.md)"
            }
          }
        ]
      },
      "tests": {
        "hit": [
          "把 workflows 導入 ~/tmp/wf-try/p，照 facts.json"
        ],
        "miss": [
          "把 workflows 導入 p",
          "不要把 workflows 導入 p，照 facts.json"
        ]
      }
    },
    {
      "name": "llm-create-md",
      "pattern": "在專案建一個 (?P<file>\\S+\\.md)，內容寫「(?P<content>[^」]+)」",
      "do": "handoff",
      "handoff": {
        "assignee": "worker-1",
        "workflow": "無",
        "goal": "在專案根目錄建立 {file}，內容為「{content}」（原話：內容寫「{content}」，意思不能變）。",
        "done_when": [
          {
            "kind": "file_exists",
            "path": "{file}"
          },
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "{file}",
              "text": "{content}"
            }
          },
          {
            "kind": "judge",
            "text": "{file} 的內容是否就是「{content}」，沒有多餘文字、標點或改寫，原意未變。"
          }
        ]
      },
      "tests": {
        "hit": [
          "在專案建一個 hello.md，內容寫「你好世界」",
          "在專案建一個 todo.md，內容寫「買牛奶」",
          "在專案建一個 idea.md，內容寫「做一個小遊戲」",
          "在專案建一個 memo.md，內容寫「明天開會」"
        ],
        "miss": [
          "在專案建一個 hello.md",
          "把 a.md 改名成 alpha.md"
        ]
      }
    },
    {
      "name": "llm-rename-md",
      "pattern": "把 (?P<old>\\S+\\.md) 改名成 (?P<new>\\S+\\.md)",
      "do": "handoff",
      "handoff": {
        "assignee": "worker-1",
        "workflow": "無",
        "goal": "把專案根目錄的 {old} 改名成 {new}：改名後專案裡看得到 {new}、看不到 {old}，內容與改名前一模一樣（原話：把 {old} 改名成 {new}，意思不能變）。",
        "done_when": [
          {
            "kind": "file_exists",
            "path": "{new}"
          },
          {
            "kind": "check",
            "name": "wf_residue",
            "args": {
              "path": "{old}"
            }
          }
        ]
      },
      "tests": {
        "hit": [
          "把 a.md 改名成 alpha.md",
          "把 b.md 改名成 beta.md",
          "把 c.md 改名成 gamma.md",
          "把 d.md 改名成 delta.md"
        ],
        "miss": [
          "把 a.md 的第 2 行刪掉",
          "在專案建一個 hello.md，內容寫「你好世界」"
        ]
      }
    },
    {
      "name": "llm-count-lines",
      "pattern": "數 (?P<src>\\S+\\.md) 有幾行，寫進 (?P<dst>\\S+)",
      "do": "handoff",
      "handoff": {
        "assignee": "worker-1",
        "workflow": "無",
        "goal": "數專案根目錄 {src} 有幾行，把這個行數寫進新檔 {dst}（原話：數 {src} 有幾行，寫進 {dst}）。{dst} 內容要是那個行數數字。",
        "done_when": [
          {
            "kind": "file_exists",
            "path": "{dst}"
          },
          {
            "kind": "judge",
            "text": "{dst} 裡的數字是否等於 {src} 的實際行數（不多不少、沒有其他多餘文字）。"
          }
        ]
      },
      "tests": {
        "hit": [
          "數 poem.md 有幾行，寫進 poem-lines.txt",
          "數 story.md 有幾行，寫進 story-lines.txt",
          "數 list.md 有幾行，寫進 count.txt",
          "數 notes.md 有幾行，寫進 n.txt"
        ],
        "miss": [
          "數 poem.md 有幾行",
          "把 a.md 改名成 alpha.md"
        ]
      }
    },
    {
      "name": "llm-delete-line",
      "pattern": "把 (?P<file>\\S+\\.md) 的第 (?P<line>[0-9]+) 行刪掉",
      "do": "handoff",
      "handoff": {
        "assignee": "worker-1",
        "workflow": "無",
        "goal": "把專案根目錄 {file} 的第 {line} 行刪掉，其餘每一行原文照留、順序不變（原話：把 {file} 的第 {line} 行刪掉）。做完後 {file} 的行數比原本少 1 行，且原本第 {line} 行以外的每一行是否原封不動、順序未變、內容未改寫。",
        "done_when": [
          {
            "kind": "check",
            "name": "contains",
            "args": {
              "path": "{file}",
              "text": "{file}"
            }
          },
          {
            "kind": "judge",
            "text": "比對改前改後：原第 {line} 行是否已被刪掉，且其餘每一行是否原封不動、順序未變、內容未改寫。"
          }
        ]
      },
      "tests": {
        "hit": [
          "把 e.md 的第 2 行刪掉",
          "把 f.md 的第 3 行刪掉",
          "把 g.md 的第 1 行刪掉",
          "把 h.md 的第 4 行刪掉"
        ],
        "miss": [
          "把 e.md 刪掉",
          "把 a.md 改名成 alpha.md"
        ]
      }
    }
  ]
}
