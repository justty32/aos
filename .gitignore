build/
install/
vcpkg_installed/
bin/
# proto8 的薄入口腳本（不是建置產物）要進版控
# proto8/archive/langs 的 bin/ 是手寫的啟動檔（11-17 從 extras/langs 搬來）
!proto8/archive/langs/*/bin/
.cache/
compile_commands.json
CMakeUserPresets.json
.lock/
wf/inbox/.inbox-send.*
.claude/worktrees/

# Python 的位元碼快取：不進版控
__pycache__/
*.pyc

# proto 劇本跑出來的紀錄（每次 1 MB 級，不進版本）
archive/proto/play-logs/
archive/proto/play/home-*

# wf/ 試驗沙盒的執行產物（mktemp 世界、agent 動態狀態）：repro/*.sh 會重生，不進版控
# sandbox/ 2026-09-25 封存到 trial/archive/sandbox/（repro 腳本仍可能重跑，規則跟著搬）
wf/workflows/dispatch/trial/archive/sandbox/**/repro-tmp.*/
wf/workflows/dispatch/trial/archive/sandbox/**/repro-A-01.*/
wf/workflows/dispatch/trial/archive/sandbox/**/.aos/agents/*/history.json
wf/workflows/dispatch/trial/archive/sandbox/**/.aos/agents/*/log.md
wf/workflows/dispatch/trial/archive/sandbox/**/.aos/agents/*/say/

# 頂層分給掛在 repo-aos 底下的 kernel 的工作區（使用者 11-14「你可以在wf弄temp/xxx分給他們」），不進版控
# 任何一層叫 temp 的資料夾都不進（wf/temp/ 也被這行蓋到；私有地盤 wf/ws/ 裡的 temp/ 同理，使用者 11-22 決定 C「*/temp/就是一律不進」）
temp/
# 使用者專屬區裡不公開的私人那格（要留、只是不公開；換台不會跟著走，使用者 11-22 待裁第 1 題選 a）
/wf/user/private/
# repo 根的 .stack：aos 那棵樹的 stack，每台各有各的、不進 git、不跟著機器搬（使用者 11-23「直接變成.stack，然後把它git ignore，就這樣。換機那一套就不用了。」）
/.stack/
# 舊名 _stack（11-22～11-23）：這行留著。別台 pull 之後、還沒把資料夾改名成 .stack 之前，它仍在那裡，不能變成未追蹤檔被 git clean 掃到
/_stack/
# proto8/frontend 的 bin/ 是手寫的啟動檔（11-17 aos-view 改名 aos-frontend、搬到頂層）
!proto8/frontend/bin/
# proto8 的安裝產物（install.py 產生，不進版控；proto8/bin/ 已被上面的 bin/ 擋掉；lib/ 是 py/ 的抄本加 C++ 函式庫，11-18 S3 起）
/proto8/include/
/proto8/lib/
