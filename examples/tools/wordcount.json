{
  "type": "function",
  "function": {
    "name": "wordcount",
    "description": "數一個檔案有幾行、幾個字、幾個位元組。",
    "parameters": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "要數的檔案路徑"
        },
        "lines_only": {
          "type": "boolean",
          "description": "只要行數"
        }
      },
      "required": ["path"]
    }
  },
  "_extra": {
    "_version": "0.1.0",
    "_type": "exec",
    "exec": ["wc"],
    "argv": {
      "lines_only": {"position": 1, "flag": "-l"},
      "path": {"position": 2}
    },
    "stdout": {"clip": "head"},
    "stderr": {"mode": "merge"}
  }
}
