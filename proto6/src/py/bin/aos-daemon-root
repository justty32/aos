#!/usr/bin/env python3
"""aos-daemon-root 的命令列入口——薄薄一層，真東西在 ../lib/aos_daemon_root.py。"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import aos_daemon_root  # noqa: E402

if __name__ == "__main__":
    sys.exit(aos_daemon_root.main())
