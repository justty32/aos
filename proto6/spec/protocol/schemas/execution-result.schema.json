{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B-103 ExecResult",
  "description": "〔建議預設，未拍板〕可信 supervisor 的詳細結果；不代替 Attempt 或 Outcome。schema 不證明 cgroup 清空、持久發布、owner、取消競態或結果授權。",
  "$ref": "#/$defs/ExecResult",
  "$defs": {
    "ExecResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "attempt_id",
        "job_id",
        "agent_id",
        "state",
        "reason",
        "exit_code",
        "signal",
        "started_at_ms",
        "finished_at_ms",
        "stdout_blob",
        "stderr_blob",
        "stdout_bytes",
        "stderr_bytes",
        "truncated"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "job_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "state": {
          "enum": [
            "succeeded",
            "failed",
            "canceled",
            "unknown"
          ]
        },
        "reason": {
          "enum": [
            "exit",
            "signal",
            "spawn_error",
            "timeout",
            "canceled",
            "oom",
            "quota",
            "output_limit",
            "lost"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "finished_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stdout_blob": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr_blob": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "exit"
              },
              "exit_code": {
                "const": 0
              },
              "signal": {
                "type": "null"
              },
              "started_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "truncated": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "exit",
                  "signal",
                  "spawn_error",
                  "timeout",
                  "oom",
                  "quota",
                  "output_limit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "canceled"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "canceled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "const": "lost"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "exit"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "signal": {
                "type": "null"
              },
              "exit_code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "state": {
                "enum": [
                  "succeeded",
                  "failed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "exit"
              },
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "reason",
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "canceled"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "canceled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "lost"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "output_limit"
              }
            },
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "state": {
                "const": "failed"
              },
              "truncated": {
                "const": true
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "signal": {
                "type": "integer"
              }
            },
            "required": [
              "exit_code",
              "signal"
            ]
          }
        }
      ]
    }
  }
}
