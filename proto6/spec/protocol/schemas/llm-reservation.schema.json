{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-reservation",
  "description": "proto6 協議篇 llm.md：建議預設，未拍板；授權、引用與狀態轉移另作語意驗證。",
  "$ref": "#/$defs/Reservation",
  "$defs": {
    "Reservation": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/ID"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "held",
            "sent",
            "settled",
            "uncertain",
            "released"
          ]
        },
        "reserved_requests": {
          "const": 1
        },
        "reserved_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "created_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sent_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extensions": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "version",
        "attempt_id",
        "scope_ids",
        "state",
        "reserved_requests",
        "reserved_tokens",
        "created_at_ms",
        "expires_at_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "sent",
                  "settled",
                  "uncertain"
                ]
              }
            }
          },
          "then": {
            "required": [
              "sent_at_ms"
            ],
            "properties": {
              "sent_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      ]
    },
    "Settlement": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "usage_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens_known": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rate_accounting_revision": {
          "const": "reserved-window-v1"
        },
        "settled_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "version",
        "attempt_id",
        "agent_id",
        "run_id",
        "usage_ref",
        "usage_digest",
        "tokens_known",
        "tokens_uncertain",
        "tokens_reserved",
        "rate_tokens",
        "rate_accounting_revision",
        "settled_at_ms"
      ],
      "additionalProperties": false
    },
    "Backoff": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "job_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "scope_ids": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/ID"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "classification": {
          "const": "rate_limited_not_processed"
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "evidence_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "retry_after_due_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "base_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jitter_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "next_due_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cooldown_until_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recorded_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "version",
        "attempt_id",
        "job_id",
        "ordinal",
        "scope_ids",
        "classification",
        "http_status",
        "evidence_ref",
        "retry_after_due_at_ms",
        "base_delay_ms",
        "jitter_ms",
        "next_due_at_ms",
        "cooldown_until_ms",
        "recorded_at_ms"
      ],
      "additionalProperties": false
    },
    "UncertainEvidence": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "request_deadline_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertain_hold_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "remote_release_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "local_connection_closed": {
          "type": "boolean"
        },
        "remote_slot_released": {
          "type": "boolean"
        },
        "tokens_estimate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "version",
        "attempt_id",
        "request_deadline_at_ms",
        "uncertain_hold_ms",
        "remote_release_at_ms",
        "local_connection_closed",
        "remote_slot_released",
        "tokens_estimate",
        "evidence_ref",
        "recorded_at_ms"
      ],
      "additionalProperties": false
    },
    "ReleaseEvidence": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "reason": {
          "enum": [
            "canceled_before_sent",
            "held_expired_not_sent",
            "launch_failed_not_sent",
            "deadline_before_http"
          ]
        },
        "gate_closed": {
          "const": true
        },
        "local_connection_closed": {
          "const": true
        },
        "evidence_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "released_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object",
          "default": {}
        }
      },
      "required": [
        "version",
        "attempt_id",
        "reason",
        "gate_closed",
        "local_connection_closed",
        "evidence_ref",
        "released_at_ms"
      ],
      "additionalProperties": false
    }
  }
}
