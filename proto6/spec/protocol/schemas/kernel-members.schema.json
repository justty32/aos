{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-members",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "node_id": {
            "$ref": "common.schema.json#/$defs/NodeId",
            "description": "成員資料夾的絕對路徑；建議在本 kernel 資料夾之內（預設上層就是本 kernel，B-628），在外面時 sync 以覆蓋登記（S-202）。"
          },
          "identity_grant": {
            "$ref": "daemon-registration.schema.json#/$defs/IdentityGrantOpen"
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 1
          },
          "provision": {
            "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrantOpen"
          },
          "quota": {
            "$ref": "res-quota.schema.json"
          }
        },
        "required": [
          "id",
          "node_id",
          "identity_grant",
          "quota"
        ]
      }
    }
  },
  "required": [
    "version",
    "revision",
    "members"
  ]
}
