{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "retention_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 2592000000
    },
    "batch_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 64
    },
    "mode": {
      "enum": [
        "archive",
        "delete"
      ],
      "default": "archive"
    },
    "archive_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000]+$"
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "delete"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "archive_dir"
          ]
        }
      }
    }
  ]
}
