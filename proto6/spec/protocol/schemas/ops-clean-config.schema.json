{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "retention_ticks": {
      "$ref": "common.schema.json#/$defs/Ticks",
      "default": 100000,
      "description": "〔第二十批，取代 retention_ms〕保留期，本 node 的格數（P-605、B-404）；〔使用者方向 2026-09-30，第二十批〕預設 100000，週期 1 秒約 28 小時、週期 30 秒約 35 日"
    },
    "batch_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 64
    },
    "mode": {
      "enum": [
        "archive",
        "delete"
      ],
      "default": "archive"
    },
    "archive_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\u0000]+$"
    },
    "interval_ticks": {
      "$ref": "common.schema.json#/$defs/Ticks",
      "default": 1000,
      "description": "〔第二十批，取代 interval_seconds〕多久清一次，本 node 的格數（P-605、B-404）；〔使用者方向 2026-09-30，第二十批〕預設 1000，週期 1 秒約 17 分鐘、週期 30 秒約 8 小時"
    }
  },
  "required": [
    "version"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "delete"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "not": {
          "required": [
            "archive_dir"
          ]
        }
      }
    }
  ]
}
