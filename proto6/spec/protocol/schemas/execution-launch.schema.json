{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "P-200～P-212 機器協議；新增編碼均為建議預設，未拍板。語意／權限／持久性須另驗。",
  "oneOf": [
    {
      "$ref": "#/$defs/LaunchRequest"
    },
    {
      "$ref": "#/$defs/LaunchReply"
    },
    {
      "$ref": "#/$defs/LaunchRejected"
    },
    {
      "$ref": "#/$defs/GateRelease"
    },
    {
      "$ref": "#/$defs/GateRecord"
    },
    {
      "$ref": "#/$defs/ExecError"
    },
    {
      "$ref": "#/$defs/ResultDelivery"
    },
    {
      "$ref": "#/$defs/ResultReceipt"
    },
    {
      "$ref": "#/$defs/WaitStatus"
    }
  ],
  "$defs": {
    "LaunchRequest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "launch"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "execution_kind": {
          "enum": [
            "tool",
            "tick",
            "agent_hook",
            "system_hook"
          ]
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "fd_roles": {
          "type": "array",
          "items": {
            "enum": [
              "work",
              "stdin",
              "tick_input",
              "tick_commit",
              "blob",
              "tick_content",
              "clean_channel"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "registry_revision",
        "snapshot_revision",
        "execution_kind",
        "hook_run_id",
        "fd_roles"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_kind": {
                "enum": [
                  "tool",
                  "tick"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "hook_run_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "hook_run_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_kind": {
                "const": "tool"
              }
            }
          },
          "then": {
            "properties": {
              "fd_roles": {
                "enum": [
                  [
                    "work"
                  ],
                  [
                    "work",
                    "stdin"
                  ]
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_kind": {
                "const": "tick"
              }
            }
          },
          "then": {
            "properties": {
              "fd_roles": {
                "type": "array",
                "prefixItems": [
                  {
                    "const": "work"
                  },
                  {
                    "const": "tick_input"
                  },
                  {
                    "const": "tick_commit"
                  },
                  {
                    "const": "blob"
                  }
                ],
                "items": {
                  "const": "tick_content"
                },
                "minItems": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_kind": {
                "const": "agent_hook"
              }
            }
          },
          "then": {
            "properties": {
              "fd_roles": {
                "const": [
                  "work",
                  "stdin"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_kind": {
                "const": "system_hook"
              }
            }
          },
          "then": {
            "properties": {
              "fd_roles": {
                "enum": [
                  [
                    "work",
                    "stdin"
                  ],
                  [
                    "work",
                    "stdin",
                    "clean_channel"
                  ]
                ]
              }
            }
          }
        }
      ]
    },
    "LaunchReply": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "prepared"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "identity": {
          "$ref": "execution-observation.schema.json#/$defs/ProcessIdentity"
        },
        "fd_roles": {
          "const": [
            "pidfd",
            "gate_write",
            "exec_error_read",
            "stdout_read",
            "stderr_read"
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "hook_run_id",
        "snapshot_revision",
        "identity",
        "fd_roles"
      ],
      "additionalProperties": false
    },
    "LaunchRejected": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "rejected"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "control-common.schema.json#/$defs/Error"
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "hook_run_id",
        "error"
      ],
      "additionalProperties": false
    },
    "GateRelease": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "release"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "gate_record_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "hook_run_id",
        "snapshot_revision",
        "gate_record_id"
      ],
      "additionalProperties": false
    },
    "GateRecord": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "gate"
        },
        "gate_record_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "recorded_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "phase": {
          "enum": [
            "prepared",
            "release_intent",
            "release_observed",
            "never_released"
          ]
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "execution-observation.schema.json#/$defs/ProcessIdentity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "gate_record_id",
        "attempt_id",
        "hook_run_id",
        "snapshot_revision",
        "recorded_at_ms",
        "phase",
        "identity"
      ],
      "additionalProperties": false
    },
    "ExecError": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "exec_error"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "stage": {
          "enum": [
            "resource",
            "groups",
            "gid",
            "uid",
            "capabilities",
            "no_new_privs",
            "fd",
            "identity",
            "gate",
            "work_decode",
            "stdin",
            "cwd",
            "exec"
          ]
        },
        "errno": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "control-common.schema.json#/$defs/Error"
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "hook_run_id",
        "stage",
        "errno",
        "error"
      ],
      "additionalProperties": false
    },
    "ResultDelivery": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "result"
        },
        "report_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "outcome": {
          "$ref": "control-common.schema.json#/$defs/Outcome"
        },
        "cleanup_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        }
      },
      "required": [
        "version",
        "kind",
        "report_id",
        "attempt_id",
        "outcome",
        "cleanup_ref"
      ],
      "additionalProperties": false
    },
    "ResultReceipt": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "result_receipt"
        },
        "report_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "disposition": {
          "enum": [
            "recorded",
            "duplicate",
            "conflict"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "report_id",
        "attempt_id",
        "disposition",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "control-common.schema.json#/$defs/Error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "WaitStatus": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "wait_status"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "identity": {
          "$ref": "execution-observation.schema.json#/$defs/ProcessIdentity"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "attempt_id",
        "hook_run_id",
        "snapshot_revision",
        "identity",
        "exit_code",
        "signal"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "exit_code": {
              "type": "integer"
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "exit_code": {
              "type": "null"
            },
            "signal": {
              "type": "integer"
            }
          }
        }
      ]
    }
  }
}
