{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/FileRpcRequest"
    },
    {
      "oneOf": [
        {
          "properties": {
            "method": {
              "const": "agent.send"
            },
            "params": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "attachments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^/[^\\u0000]*$"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "kernel.recheck"
            },
            "params": {
              "type": "object",
              "maxProperties": 0
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "resources.set"
            },
            "params": {
              "$ref": "res-quota.schema.json"
            }
          }
        },
        {
          "properties": {
            "method": {
              "const": "resources.measure"
            },
            "params": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": false
            }
          }
        }
      ]
    }
  ]
}
