{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-schedule-state",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "next_seq": {
      "type": "integer",
      "minimum": 1
    },
    "scan_after": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/ID"
        },
        {
          "type": "null"
        }
      ]
    },
    "next_scan_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "ready_seq": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "due_ms": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/TimeMs"
              },
              {
                "type": "null"
              }
            ]
          },
          "summary_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "wake_mark": {
            "description": "wake 回應的 registration_id 與 tick_seq（還沒跑過是 0）及叫醒時間；新格判斷見 S-201，失聯見 S-206。沒叫醒過為 null。",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "registration_id": {
                    "$ref": "common.schema.json#/$defs/ID"
                  },
                  "tick_seq": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "woken_at_ms": {
                    "$ref": "common.schema.json#/$defs/TimeMs"
                  }
                },
                "required": [
                  "registration_id",
                  "tick_seq",
                  "woken_at_ms"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "member_id",
          "ready_seq",
          "due_ms",
          "summary_commit",
          "wake_mark"
        ]
      }
    }
  },
  "required": [
    "version",
    "next_seq",
    "scan_after",
    "next_scan_ms",
    "members"
  ]
}
