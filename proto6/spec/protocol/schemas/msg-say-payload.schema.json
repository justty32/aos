{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^/[^\\u0000]*$"
      }
    },
    "in_reply_to": {
      "$ref": "common.schema.json#/$defs/ID"
    }
  }
}
