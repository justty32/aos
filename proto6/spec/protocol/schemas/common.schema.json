{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 共用型別（P-002、P-004、P-005、P-007）",
  "$defs": {
    "ID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$(?![\\s\\S])"
    },
    "NodeId": {
      "type": "string",
      "pattern": "^/[^/\\u0000]+(?:/[^/\\u0000]+)*$",
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      }
    },
    "TimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32000
          ]
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "additionalProperties": false
    },
    "ErrorOpen": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            -32700,
            -32600,
            -32601,
            -32602,
            -32603,
            -32000
          ]
        },
        "message": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$(?![\\s\\S])"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ]
    },
    "RpcRequest": {
      "allOf": [
        {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "#/$defs/ID"
            },
            "method": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*)+$(?![\\s\\S])"
            },
            "params": {
              "type": "object"
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "RpcResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "type": "null"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "enum": [
                      -32700,
                      -32600
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "FileRpcRequest": {
      "allOf": [
        {
          "$ref": "#/$defs/RpcRequest/allOf/0"
        },
        {
          "properties": {
            "reply_to": {
              "$ref": "#/$defs/NodeId"
            },
            "params": {
              "$ref": "node-inst.schema.json"
            }
          },
          "required": [
            "reply_to"
          ]
        }
      ]
    },
    "FileRpcResponse": {
      "type": "object",
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "type": "object"
        },
        "error": {
          "$ref": "#/$defs/ErrorOpen"
        }
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "oneOf": [
        {
          "required": [
            "result"
          ]
        },
        {
          "required": [
            "error"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "type": "null"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "properties": {
                  "code": {
                    "enum": [
                      -32700,
                      -32600
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
