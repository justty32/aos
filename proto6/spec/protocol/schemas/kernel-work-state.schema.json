{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-work-state",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "submitter_uid": {
      "description": "接件時原請求檔（requests/<id>.json）的擁有 UID；work.cancel 核權用（P-411）。",
      "type": "integer",
      "minimum": 0
    },
    "attempt_allocator": {
      "description": "配出這個 attempt_id 的 node（工作目錄前綴的來源，P-402）；LLM 池限流重試由池配 ID 時是池 node。省略表示就是工作材料的 node_id。",
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "owner_exec_uid": {
      "description": "接件時記下、接件那一項任務實際的有效 UID（任務不帶 user 時就是 node inst 的執行帳號；暫定：任務帶了自己的 user 時記那個帳號）；取消核權的第二種主人（B-203）。掛載行程（once）自己 inst 的 user 不算（B-613）。",
      "type": "integer",
      "minimum": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "phase": {
      "enum": [
        "queued",
        "prepared",
        "dispatched",
        "canceling",
        "completed",
        "unknown"
      ]
    },
    "boot_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "work_dir": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "finished_at_ms": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/TimeMs"
        },
        {
          "type": "null"
        }
      ]
    },
    "llm": {
      "type": "object",
      "properties": {
        "pool_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "quota_scope": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "reserved_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_at_ms": {
          "$ref": "common.schema.json#/$defs/TimeMs"
        },
        "retry_at_ms": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "pool_id",
        "quota_scope",
        "reserved_tokens",
        "reserved_at_ms",
        "retry_at_ms"
      ],
      "description": "LLM 工作才有，由 pool 任務維護的預留（P-811）。"
    }
  },
  "required": [
    "version",
    "request_id",
    "submitter_uid",
    "seq",
    "phase",
    "boot_id",
    "work_dir",
    "finished_at_ms"
  ]
}
