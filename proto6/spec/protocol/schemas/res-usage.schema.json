{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 resource usage",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "node_id": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "observed_at_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "object",
          "properties": {
            "usage_us": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "usage_us"
          ],
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "properties": {
            "current_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "current_bytes"
          ],
          "additionalProperties": false
        },
        "pids": {
          "type": "object",
          "properties": {
            "current": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "current"
          ],
          "additionalProperties": false
        },
        "llm": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pool_id": {
                "$ref": "common.schema.json#/$defs/ID"
              },
              "active_requests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unknown_requests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pool_id",
              "active_requests",
              "unknown_requests"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "disk": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^/",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "rx_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tx_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "scope",
              "rx_bytes",
              "tx_bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "node_id",
    "observed_at_ms",
    "resources"
  ],
  "additionalProperties": false
}
