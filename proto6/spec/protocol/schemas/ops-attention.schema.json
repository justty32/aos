{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "source_node": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "issue_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "suggestion": {
      "type": "string",
      "minLength": 1,
      "description": "白話的建議處理，可含建議指令的文字；不會自動執行。"
    }
  },
  "required": [
    "version",
    "source_node",
    "issue_id",
    "reason",
    "message"
  ],
  "additionalProperties": false
}
