{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "十個公開控制 RPC 的 payload",
  "description": "〔建議預設，未拍板〕methods.json 為 method 正本。本 schema 不含 checkpoint.commit；其 payload 由 agent-commit.schema.json 擁有。result.ack 不公開。回覆沒有 method，必須以原請求選對應 *Response 驗證，聚合 Response 只供通用解碼；request_id 與 envelope id 必須相同，另作語意核對。",
  "$defs": {
    "AgentSubmitParams": {
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "input_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        }
      },
      "required": [
        "agent_id",
        "input_ref"
      ],
      "additionalProperties": false
    },
    "AgentSubmitResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "input_seq": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id",
        "input_seq"
      ],
      "additionalProperties": false
    },
    "AgentSubmitRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "agent.submit"
            },
            "params": {
              "$ref": "#/$defs/AgentSubmitParams"
            }
          }
        }
      ]
    },
    "AgentSubmitResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/AgentSubmitResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "AgentGetParams": {
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "agent_id"
      ],
      "additionalProperties": false
    },
    "AgentGetResult": {
      "$ref": "control-state.schema.json#/$defs/AgentQuery"
    },
    "AgentGetRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "agent.get"
            },
            "params": {
              "$ref": "#/$defs/AgentGetParams"
            }
          }
        }
      ]
    },
    "AgentGetResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/AgentGetResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunGetParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunGetResult": {
      "$ref": "control-state.schema.json#/$defs/RunQuery"
    },
    "RunGetRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.get"
            },
            "params": {
              "$ref": "#/$defs/RunGetParams"
            }
          }
        }
      ]
    },
    "RunGetResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunGetResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunPauseParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunPauseResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunPauseRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.pause"
            },
            "params": {
              "$ref": "#/$defs/RunPauseParams"
            }
          }
        }
      ]
    },
    "RunPauseResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunPauseResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunResumeParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "budget": {
          "$ref": "control-state.schema.json#/$defs/Budget"
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunResumeResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunResumeRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.resume"
            },
            "params": {
              "$ref": "#/$defs/RunResumeParams"
            }
          }
        }
      ]
    },
    "RunResumeResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunResumeResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunCancelParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunCancelResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunCancelRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.cancel"
            },
            "params": {
              "$ref": "#/$defs/RunCancelParams"
            }
          }
        }
      ]
    },
    "RunCancelResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunCancelResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunResolveParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "job_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "decision": {
          "enum": [
            "retry",
            "fail",
            "cancel_with_unknown"
          ]
        },
        "allow_duplicate_effects": {
          "const": true
        },
        "new_max_attempts": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "clear_cancel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "job_id",
        "decision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "retry"
              }
            }
          },
          "then": {
            "required": [
              "allow_duplicate_effects",
              "new_max_attempts"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "allow_duplicate_effects"
                  ]
                },
                {
                  "required": [
                    "new_max_attempts"
                  ]
                },
                {
                  "required": [
                    "clear_cancel_requested"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "retry 仍須管理者授權、舊本機工作清空、新上限大於已建 attempt 數；cancel_requested 尚在時必須 clear_cancel_requested:true。這些跨帳本條件不能只靠 schema 驗證。"
    },
    "RunResolveResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunResolveRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.resolve"
            },
            "params": {
              "$ref": "#/$defs/RunResolveParams"
            }
          }
        }
      ]
    },
    "RunResolveResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunResolveResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "RunOutputsParams": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "after_seq": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger",
          "default": 0
        },
        "limit": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger",
          "maximum": 1000,
          "default": 100
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    },
    "RunOutputsResult": {
      "type": "object",
      "properties": {
        "outputs": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "agent-output.schema.json#/$defs/Output"
          }
        },
        "next_seq": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "outputs",
        "next_seq",
        "has_more"
      ],
      "additionalProperties": false
    },
    "RunOutputsRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "run.outputs"
            },
            "params": {
              "$ref": "#/$defs/RunOutputsParams"
            }
          }
        }
      ]
    },
    "RunOutputsResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/RunOutputsResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "AttemptGetParams": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "attempt_id"
      ],
      "additionalProperties": false
    },
    "AttemptGetResult": {
      "$ref": "control-state.schema.json#/$defs/AttemptQuery"
    },
    "AttemptGetRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "attempt.get"
            },
            "params": {
              "$ref": "#/$defs/AttemptGetParams"
            }
          }
        }
      ]
    },
    "AttemptGetResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/AttemptGetResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "AttemptCancelParams": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "attempt_id"
      ],
      "additionalProperties": false
    },
    "AttemptCancelResult": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "accepted",
        "request_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "AttemptCancelRequest": {
      "allOf": [
        {
          "$ref": "control-rpc.schema.json#/$defs/Request"
        },
        {
          "properties": {
            "method": {
              "const": "attempt.cancel"
            },
            "params": {
              "$ref": "#/$defs/AttemptCancelParams"
            }
          }
        }
      ]
    },
    "AttemptCancelResponse": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "control-rpc.schema.json#/$defs/SuccessResponse"
            },
            {
              "properties": {
                "result": {
                  "$ref": "#/$defs/AttemptCancelResult"
                }
              }
            }
          ]
        },
        {
          "$ref": "control-rpc.schema.json#/$defs/ErrorResponse"
        }
      ]
    },
    "Request": {
      "oneOf": [
        {
          "$ref": "#/$defs/AgentSubmitRequest"
        },
        {
          "$ref": "#/$defs/AgentGetRequest"
        },
        {
          "$ref": "#/$defs/RunGetRequest"
        },
        {
          "$ref": "#/$defs/RunPauseRequest"
        },
        {
          "$ref": "#/$defs/RunResumeRequest"
        },
        {
          "$ref": "#/$defs/RunCancelRequest"
        },
        {
          "$ref": "#/$defs/RunResolveRequest"
        },
        {
          "$ref": "#/$defs/RunOutputsRequest"
        },
        {
          "$ref": "#/$defs/AttemptGetRequest"
        },
        {
          "$ref": "#/$defs/AttemptCancelRequest"
        }
      ]
    },
    "Response": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentSubmitResponse"
        },
        {
          "$ref": "#/$defs/AgentGetResponse"
        },
        {
          "$ref": "#/$defs/RunGetResponse"
        },
        {
          "$ref": "#/$defs/RunPauseResponse"
        },
        {
          "$ref": "#/$defs/RunResumeResponse"
        },
        {
          "$ref": "#/$defs/RunCancelResponse"
        },
        {
          "$ref": "#/$defs/RunResolveResponse"
        },
        {
          "$ref": "#/$defs/RunOutputsResponse"
        },
        {
          "$ref": "#/$defs/AttemptGetResponse"
        },
        {
          "$ref": "#/$defs/AttemptCancelResponse"
        }
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ]
}
