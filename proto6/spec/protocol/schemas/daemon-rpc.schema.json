{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 公開 IPC 請求與回應（P-103～107、P-111、P-115）",
  "$defs": {
    "AckResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        }
      },
      "required": [
        "node_id"
      ],
      "additionalProperties": false
    },
    "GetResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "daemon-registration.schema.json#/$defs/User"
              },
              {
                "not": {
                  "enum": [
                    0,
                    "root"
                  ]
                }
              }
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrant"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "once": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "pending": {
          "type": "boolean"
        },
        "stopping": {
          "type": "boolean"
        },
        "cgroup": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu_max": {
                      "type": "object",
                      "properties": {
                        "quota_us": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            {
                              "const": "max"
                            }
                          ]
                        },
                        "period_us": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "quota_us",
                        "period_us"
                      ],
                      "additionalProperties": false
                    },
                    "memory_max_bytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "const": "max"
                        }
                      ]
                    },
                    "pids_max": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "const": "max"
                        }
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "path",
                "limits"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "registered": {
          "type": "boolean"
        },
        "last_tick": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastTick"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node_id",
        "parent_id",
        "identity_grant",
        "owner_uid",
        "once",
        "paused",
        "running",
        "pending",
        "stopping",
        "cgroup",
        "boot_id",
        "registered",
        "last_tick"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "once": {
                "const": true
              }
            },
            "required": [
              "once"
            ]
          },
          "then": {
            "not": {
              "required": [
                "interval_ms"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "parent_id": {
                "type": "null"
              }
            },
            "required": [
              "parent_id"
            ]
          },
          "then": {
            "properties": {
              "once": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "registered": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "once": {
                "const": true
              },
              "paused": {
                "const": false
              },
              "running": {
                "const": false
              },
              "pending": {
                "const": false
              },
              "stopping": {
                "const": false
              },
              "cgroup": {
                "type": "null"
              },
              "last_tick": {
                "allOf": [
                  {
                    "$ref": "#/$defs/LastTick"
                  },
                  {
                    "properties": {
                      "outcome": {
                        "not": {
                          "const": "running"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "running": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "last_tick": {
                "allOf": [
                  {
                    "$ref": "#/$defs/LastTick"
                  },
                  {
                    "properties": {
                      "outcome": {
                        "const": "running"
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "last_tick": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/LastTick"
                      },
                      {
                        "properties": {
                          "outcome": {
                            "not": {
                              "const": "running"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "LastTick": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "running",
            "completed",
            "launch_failed",
            "unknown"
          ]
        },
        "started_at_ms": {
          "$ref": "common.schema.json#/$defs/TimeMs"
        },
        "ended_at_ms": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "started": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "outcome",
        "started_at_ms",
        "ended_at_ms",
        "exit_code",
        "started",
        "signal"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "running"
            },
            "ended_at_ms": {
              "type": "null"
            },
            "exit_code": {
              "type": "null"
            },
            "started": {
              "type": "null"
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "completed"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "type": "integer"
            },
            "started": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "launch_failed"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "enum": [
                2,
                125
              ]
            },
            "started": {
              "const": false
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "unknown"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "type": "null"
            },
            "started": {
              "enum": [
                true,
                null
              ]
            },
            "signal": {
              "type": "null"
            }
          }
        }
      ]
    },
    "InfoResult": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "boot_id"
      ],
      "additionalProperties": false
    },
    "ListResult": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GetResult"
          },
          "maxItems": 64
        },
        "next_after_node_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "boot_id",
        "nodes",
        "next_after_node_id"
      ],
      "additionalProperties": false
    },
    "AttentionShow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "source_node": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "issue_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "status": {
          "enum": [
            "open",
            "done"
          ]
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "description": "白話的建議處理，可含建議指令的文字；不會自動執行。"
        }
      },
      "required": [
        "version",
        "source_node",
        "issue_id",
        "reason",
        "message",
        "status"
      ],
      "additionalProperties": false
    },
    "AttentionKey": {
      "type": "object",
      "properties": {
        "source_node": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "issue_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "source_node",
        "issue_id"
      ],
      "additionalProperties": false
    },
    "AttentionList": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttentionShow"
          },
          "maxItems": 64
        },
        "next_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issues",
        "next_after"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "oneOf": [
            {
              "properties": {
                "method": {
                  "const": "node.register"
                },
                "params": {
                  "$ref": "daemon-registration.schema.json#/$defs/Registration"
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.unregister"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.wake"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.pause"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.resume"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.show"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.provision"
                },
                "params": {
                  "$ref": "daemon-provision.schema.json"
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.info"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.ls"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "after_node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.done"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "source_node": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "issue_id": {
                      "$ref": "common.schema.json#/$defs/ID"
                    }
                  },
                  "required": [
                    "source_node",
                    "issue_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.show"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "source_node": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "issue_id": {
                      "$ref": "common.schema.json#/$defs/ID"
                    }
                  },
                  "required": [
                    "source_node",
                    "issue_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.ls"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "source_node": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "status": {
                      "enum": [
                        "open",
                        "done"
                      ]
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "after": {
                      "type": "string"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            }
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcResponse"
        },
        {
          "properties": {
            "result": {
              "oneOf": [
                {
                  "$ref": "#/$defs/AckResult"
                },
                {
                  "$ref": "#/$defs/GetResult"
                },
                {
                  "$ref": "#/$defs/InfoResult"
                },
                {
                  "$ref": "#/$defs/ListResult"
                },
                {
                  "$ref": "#/$defs/AttentionKey"
                },
                {
                  "$ref": "#/$defs/AttentionShow"
                },
                {
                  "$ref": "#/$defs/AttentionList"
                }
              ]
            }
          },
          "required": [
            "result"
          ]
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcResponse"
        },
        {
          "properties": {
            "error": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/Error"
                },
                {
                  "oneOf": [
                    {
                      "properties": {
                        "code": {
                          "const": -32000
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "enum": [
                                "forbidden",
                                "user_not_granted",
                                "user_invalid",
                                "user_mismatch",
                                "not_registered",
                                "registration_conflict",
                                "busy",
                                "stopping",
                                "cleanup_failed",
                                "helper_unavailable",
                                "unsupported",
                                "path_not_granted",
                                "conflict",
                                "provision_failed",
                                "start_failed",
                                "resource_observation_failed",
                                "response_too_large"
                              ]
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "code": {
                          "const": -32700
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "const": "parse_error"
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "code": {
                          "const": -32600
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "const": "invalid_request"
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "code": {
                          "const": -32601
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "const": "method_not_found"
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "code": {
                          "const": -32602
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "const": "invalid_params"
                            }
                          }
                        }
                      }
                    },
                    {
                      "properties": {
                        "code": {
                          "const": -32603
                        },
                        "data": {
                          "properties": {
                            "code": {
                              "const": "internal_error"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    }
  ]
}
