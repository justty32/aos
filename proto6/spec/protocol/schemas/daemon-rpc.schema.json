{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 公開 IPC 請求與回應（P-103～107、P-111、P-115、P-117～119）；嚴格，不認得的欄位拒絕（C-07）",
  "$defs": {
    "AckResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        }
      },
      "required": [
        "node_id"
      ],
      "additionalProperties": false
    },
    "WakeResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "registration_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "tick_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "node_id",
        "registration_id",
        "tick_seq"
      ],
      "additionalProperties": false
    },
    "ClearResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "cleared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "node_id",
        "cleared"
      ],
      "additionalProperties": false
    },
    "GetResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "$ref": "daemon-registration.schema.json#/$defs/IdentityGrant"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrant"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_override": {
          "type": "boolean",
          "description": "true＝上層來自登記覆蓋；頂層與看資料夾推得的為 false（B-606）"
        },
        "owner_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mount": {
          "type": "boolean",
          "description": "true＝掛載行程（B-613）"
        },
        "paused": {
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "pending": {
          "type": "boolean"
        },
        "stopping": {
          "type": "boolean"
        },
        "cgroup": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                },
                "limits": {
                  "type": "object",
                  "properties": {
                    "cpu_max": {
                      "type": "object",
                      "properties": {
                        "quota_us": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            },
                            {
                              "const": "max"
                            }
                          ]
                        },
                        "period_us": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "quota_us",
                        "period_us"
                      ],
                      "additionalProperties": false
                    },
                    "memory_max_bytes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "const": "max"
                        }
                      ]
                    },
                    "pids_max": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "const": "max"
                        }
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "path",
                "limits"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "registered": {
          "type": "boolean"
        },
        "last_tick": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastTick"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "node_id",
        "parent_id",
        "owner_uid",
        "parent_override",
        "mount",
        "paused",
        "running",
        "pending",
        "stopping",
        "cgroup",
        "boot_id",
        "registered",
        "last_tick",
        "registration_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mount": {
                "const": true
              }
            },
            "required": [
              "mount"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "interval_ms"
                  ]
                },
                {
                  "required": [
                    "identity_grant"
                  ]
                },
                {
                  "required": [
                    "provision"
                  ]
                }
              ]
            },
            "properties": {
              "parent_override": {
                "const": false
              }
            }
          },
          "else": {
            "required": [
              "identity_grant"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "parent_id": {
                "type": "null"
              }
            },
            "required": [
              "parent_id"
            ]
          },
          "then": {
            "properties": {
              "mount": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "registered": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "mount": {
                "const": true
              },
              "paused": {
                "const": false
              },
              "running": {
                "const": false
              },
              "pending": {
                "const": false
              },
              "stopping": {
                "const": false
              },
              "cgroup": {
                "type": "null"
              },
              "last_tick": {
                "allOf": [
                  {
                    "$ref": "#/$defs/LastTick"
                  },
                  {
                    "properties": {
                      "outcome": {
                        "not": {
                          "const": "running"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "running": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "last_tick": {
                "allOf": [
                  {
                    "$ref": "#/$defs/LastTick"
                  },
                  {
                    "properties": {
                      "outcome": {
                        "const": "running"
                      }
                    }
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "last_tick": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/LastTick"
                      },
                      {
                        "properties": {
                          "outcome": {
                            "not": {
                              "const": "running"
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "LastTick": {
      "type": "object",
      "properties": {
        "tick_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "enum": [
            "running",
            "completed",
            "launch_failed",
            "unknown"
          ]
        },
        "started_at_ms": {
          "$ref": "common.schema.json#/$defs/TimeMs"
        },
        "ended_at_ms": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/TimeMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 255
        },
        "started": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": [
        "tick_seq",
        "outcome",
        "started_at_ms",
        "ended_at_ms",
        "exit_code",
        "started",
        "signal"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "running"
            },
            "ended_at_ms": {
              "type": "null"
            },
            "exit_code": {
              "type": "null"
            },
            "started": {
              "type": "null"
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "completed"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "type": "integer"
            },
            "started": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "launch_failed"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "enum": [
                2,
                125
              ]
            },
            "started": {
              "const": false
            },
            "signal": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "unknown"
            },
            "ended_at_ms": {
              "type": "integer"
            },
            "exit_code": {
              "type": "null"
            },
            "started": {
              "enum": [
                true,
                null
              ]
            },
            "signal": {
              "type": "null"
            }
          }
        }
      ]
    },
    "InfoResult": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "boot_id"
      ],
      "additionalProperties": false
    },
    "ListResult": {
      "type": "object",
      "properties": {
        "boot_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GetResult"
          },
          "maxItems": 64
        },
        "next_after_node_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "boot_id",
        "nodes",
        "next_after_node_id"
      ],
      "additionalProperties": false
    },
    "AttentionShow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "source_node": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "issue_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "status": {
          "enum": [
            "open",
            "done"
          ]
        },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "description": "白話的建議處理，可含建議指令的文字；不會自動執行。"
        }
      },
      "required": [
        "version",
        "source_node",
        "issue_id",
        "reason",
        "message",
        "status"
      ],
      "additionalProperties": false
    },
    "AttentionKey": {
      "type": "object",
      "properties": {
        "source_node": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "issue_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "source_node",
        "issue_id"
      ],
      "additionalProperties": false
    },
    "AttentionList": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttentionShow"
          },
          "maxItems": 64
        },
        "next_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issues",
        "next_after"
      ],
      "additionalProperties": false
    },
    "RegisterResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "registration_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "node_id",
        "parent_id",
        "registration_id"
      ],
      "additionalProperties": false,
      "description": "node.register：正規化後的 node id、有效上層與登記識別（P-104）"
    },
    "MountResult": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "registration_id": {
          "$ref": "common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "node_id",
        "registration_id"
      ],
      "additionalProperties": false,
      "description": "node.mount（P-118）"
    },
    "TakeResult": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/FileRpcRequest"
          },
          "maxItems": 256
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "messages",
        "more"
      ],
      "additionalProperties": false,
      "description": "node.take：先進先出取走的訊息；more＝還有沒取完的（P-119）"
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "oneOf": [
            {
              "properties": {
                "method": {
                  "const": "node.register"
                },
                "params": {
                  "$ref": "daemon-registration.schema.json#/$defs/RegisterParams"
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.unregister"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.wake"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.mount"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "parent_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false,
                  "anyOf": [
                    {
                      "required": [
                        "token"
                      ]
                    },
                    {
                      "required": [
                        "parent_id"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.kill"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.send"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    },
                    "to": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "message": {
                      "$ref": "common.schema.json#/$defs/FileRpcRequest"
                    },
                    "urgent": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "token",
                    "to",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.take"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "$ref": "daemon-registration.schema.json#/$defs/Token"
                    },
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256,
                      "default": 256
                    }
                  },
                  "required": [
                    "token"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.pause"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.resume"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.show"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [
                    "node_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.provision"
                },
                "params": {
                  "$ref": "daemon-provision.schema.json"
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.info"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "node.ls"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 64
                    },
                    "after_node_id": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.done"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "source_node": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "issue_id": {
                      "$ref": "common.schema.json#/$defs/ID"
                    }
                  },
                  "required": [
                    "source_node",
                    "issue_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.show"
                },
                "params": {
                  "type": "object",
                  "properties": {
                    "source_node": {
                      "$ref": "common.schema.json#/$defs/NodeId"
                    },
                    "issue_id": {
                      "$ref": "common.schema.json#/$defs/ID"
                    }
                  },
                  "required": [
                    "source_node",
                    "issue_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "method",
                "params"
              ]
            },
            {
              "properties": {
                "method": {
                  "const": "daemon.attention.ls"
                },
                "params": {
