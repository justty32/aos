{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storage-clean-candidates",
  "description": "proto6 storage 協議；建議預設，未拍板。授權、引用及持久化另依 storage.md。",
  "oneOf": [
    {
      "$ref": "#/$defs/Batch"
    }
  ],
  "$defs": {
    "Batch": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "clean_candidates"
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "batch_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "agent"
                },
                "agent_id": {
                  "$ref": "control-common.schema.json#/$defs/ID"
                }
              },
              "required": [
                "kind",
                "agent_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "all_agents",
                    "control"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "policy_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "issued_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "candidate_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "record_type": {
                "enum": [
                  "result",
                  "blob",
                  "history",
                  "diagnostic",
                  "attention_done",
                  "import_temp"
                ]
              },
              "record_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "agent_id": {
                "anyOf": [
                  {
                    "$ref": "control-common.schema.json#/$defs/ID"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "run_id": {
                "anyOf": [
                  {
                    "$ref": "control-common.schema.json#/$defs/ID"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "action": {
                "enum": [
                  "archive",
                  "delete"
                ]
              },
              "source_slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "archive_slot": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eligible_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expected_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
                "minLength": 64,
                "maxLength": 64
              },
              "fence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "source_name": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,191}(?![\\s\\S])"
              },
              "archive": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "archive_id": {
                        "$ref": "control-common.schema.json#/$defs/ID"
                      },
                      "entry_id": {
                        "$ref": "control-common.schema.json#/$defs/ID"
                      },
                      "manifest_id": {
                        "$ref": "control-common.schema.json#/$defs/ID"
                      }
                    },
                    "required": [
                      "archive_id",
                      "entry_id",
                      "manifest_id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "summary": {
                "$ref": "storage-retention.schema.json#/$defs/Summary"
              },
              "source_device": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
              },
              "source_inode": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,19})(?![\\s\\S])"
              }
            },
            "required": [
              "candidate_id",
              "record_type",
              "record_id",
              "agent_id",
              "run_id",
              "action",
              "source_slot",
              "archive_slot",
              "eligible_at_ms",
              "expected_bytes",
              "expected_sha256",
              "fence",
              "source_name",
              "archive",
              "summary",
              "source_device",
              "source_inode"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "action": {
                      "const": "archive"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "archive_slot": {
                      "type": "integer"
                    },
                    "archive": {
                      "type": "object"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "archive_slot": {
                      "type": "null"
                    },
                    "archive": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 256
        },
        "more": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_elapsed_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max_items",
            "max_bytes",
            "max_elapsed_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "batch_id",
        "scope",
        "policy_id",
        "issued_at_ms",
        "candidates",
        "more",
        "limits"
      ],
      "additionalProperties": false
    }
  }
}
