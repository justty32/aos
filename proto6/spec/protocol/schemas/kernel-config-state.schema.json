{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "issue_id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "resolved": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "issue_id",
          "resolved"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "issues"
  ],
  "additionalProperties": false
}
