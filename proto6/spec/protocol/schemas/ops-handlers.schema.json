{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "handlers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "safety": {
            "enum": [
              "safe",
              "dangerous",
              "human"
            ]
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "exec"
                  },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      }
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "kind",
                  "argv"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "daemon_ipc"
                  },
                  "socket": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\u0000]+$"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "type": "object"
                  },
                  "bindings": {
                    "type": "object",
                    "propertyNames": {
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "additionalProperties": {
                      "enum": [
                        "source_node",
                        "issue_id",
                        "job_id",
                        "attempt_id",
                        "request_id",
                        "operation_id"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "socket",
                  "method",
                  "params"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "node_rpc"
                  },
                  "target_node": {
                    "$ref": "common.schema.json#/$defs/NodeId"
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "params": {
                    "$ref": "node-inst.schema.json"
                  }
                },
                "required": [
                  "kind",
                  "target_node",
                  "method",
                  "params"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "reason",
          "safety",
          "effect"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "safety": {
                  "const": "human"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "action"
                ]
              }
            },
            "else": {
              "required": [
                "action"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "unknown"
                }
              }
            },
            "then": {
              "properties": {
                "safety": {
                  "enum": [
                    "dangerous",
                    "human"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "handlers"
  ],
  "additionalProperties": false
}
