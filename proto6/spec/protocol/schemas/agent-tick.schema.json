{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-tick",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "$ref": "#/$defs/TickInput",
  "$defs": {
    "TickInput": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "claim": {
          "allOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "properties": {
                "state": {
                  "const": "held"
                }
              }
            }
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "config_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "bundle_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "ledger_snapshot_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "content_fds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentFD"
          },
          "minItems": 2
        }
      },
      "required": [
        "version",
        "claim",
        "run_id",
        "config_revision",
        "bundle_ref",
        "ledger_snapshot_ref",
        "content_fds"
      ],
      "additionalProperties": false
    },
    "Claim": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checkpoint_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "claimed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "held",
            "released"
          ]
        }
      },
      "required": [
        "version",
        "agent_id",
        "attempt_id",
        "generation",
        "checkpoint_revision",
        "claimed_at_ms",
        "state"
      ],
      "additionalProperties": false
    },
    "ContentFD": {
      "type": "object",
      "properties": {
        "fd": {
          "type": "integer",
          "minimum": 6,
          "maximum": 2147483647
        },
        "role": {
          "enum": [
            "bundle",
            "ledger",
            "checkpoint",
            "input",
            "history",
            "notes",
            "context",
            "job_payload",
            "result",
            "other"
          ]
        },
        "ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        }
      },
      "required": [
        "fd",
        "role",
        "ref"
      ],
      "additionalProperties": false
    },
    "LedgerSnapshot": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "snapshot_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "checkpoint_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "agent_phase": {
          "enum": [
            "idle",
            "think",
            "act",
            "wait",
            "paused",
            "error"
          ]
        },
        "run": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Run"
            },
            {
              "type": "null"
            }
          ]
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/Job"
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/Attempt"
          }
        },
        "pending_job_ids": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/ID"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "agent-input.schema.json#/$defs/InputDelivery"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResultDelivery"
          }
        },
        "input_received_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_consumed_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "history_tail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wait_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_due_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetSnapshot"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "agent_id",
        "snapshot_at_ms",
        "checkpoint_ref",
        "checkpoint_revision",
        "agent_phase",
        "run",
        "jobs",
        "attempts",
        "pending_job_ids",
        "inputs",
        "results",
        "input_received_seq",
        "input_consumed_seq",
        "history_tail",
        "output_tail",
        "wait_reason",
        "next_due_at_ms",
        "budget"
      ],
      "additionalProperties": false
    },
    "ResultDelivery": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "consumed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "attempt_id",
        "consumed"
      ],
      "additionalProperties": false
    },
    "WaitReason": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "not_due",
            "quota_wait",
            "local_limit",
            "tool_result",
            "llm_result",
            "paused",
            "canceling",
            "result_unknown",
            "deployment_unavailable",
            "budget_exceeded",
            "needs_attention"
          ]
        },
        "since_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "next_due_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "code",
        "since_at_ms"
      ],
      "additionalProperties": false
    },
    "BudgetSnapshot": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "max_jobs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_llm_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_tokens_estimate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "max_elapsed_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max_jobs",
            "max_llm_attempts",
            "max_tokens_estimate",
            "max_elapsed_ms"
          ],
          "additionalProperties": false
        },
        "jobs_created": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "llm_attempts_created": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_known": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokens_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "active_elapsed_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "limits",
        "jobs_created",
        "llm_attempts_created",
        "tokens_known",
        "tokens_uncertain",
        "tokens_reserved",
        "active_elapsed_ms"
      ],
      "additionalProperties": false
    },
    "BlobTransferDecoded": {
      "$ref": "storage-blob-transfer.schema.json"
    }
  }
}
