{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-proposal",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "$ref": "#/$defs/Proposal",
  "$defs": {
    "Proposal": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "consumed_input_ids": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/ID"
          },
          "uniqueItems": true
        },
        "consumed_attempt_ids": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/ID"
          },
          "uniqueItems": true
        },
        "new_jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobDraft"
          }
        },
        "finish": {
          "enum": [
            "none",
            "succeeded",
            "failed",
            "needs_attention"
          ]
        },
        "checkpoint_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "history_append": {
          "type": "array",
          "items": {
            "$ref": "agent-content.schema.json#/$defs/HistoryEvent"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "agent-output.schema.json#/$defs/Output"
          }
        },
        "final_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "append_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "agent_id",
        "run_id",
        "attempt_id",
        "generation",
        "expected_revision",
        "consumed_input_ids",
        "consumed_attempt_ids",
        "new_jobs",
        "finish",
        "checkpoint_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "finish": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "final_ref"
            ],
            "properties": {
              "final_ref": {
                "$ref": "control-common.schema.json#/$defs/BlobRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finish": {
                "enum": [
                  "failed",
                  "needs_attention"
                ]
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "$ref": "control-common.schema.json#/$defs/Error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "finish": {
                "const": "needs_attention"
              }
            }
          },
          "then": {
            "properties": {
              "new_jobs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "append_ref"
            ],
            "properties": {
              "append_ref": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "history_append": {
                "maxItems": 0
              },
              "outputs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run_id": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "finish": {
                "const": "none"
              },
              "consumed_input_ids": {
                "maxItems": 0
              },
              "consumed_attempt_ids": {
                "maxItems": 0
              },
              "new_jobs": {
                "maxItems": 0
              },
              "history_append": {
                "maxItems": 0
              },
              "outputs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "JobDraft": {
      "type": "object",
      "properties": {
        "job_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "kind": {
          "enum": [
            "tool",
            "llm"
          ]
        },
        "payload_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "retry_class": {
          "enum": [
            "never",
            "safe"
          ],
          "default": "never"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "job_id",
        "kind",
        "payload_ref"
      ],
      "additionalProperties": false
    },
    "Append": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "history_append": {
          "type": "array",
          "items": {
            "$ref": "agent-content.schema.json#/$defs/HistoryEvent"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "agent-output.schema.json#/$defs/Output"
          }
        }
      },
      "required": [
        "version",
        "history_append",
        "outputs"
      ],
      "additionalProperties": false
    },
    "LLMPayloadDecoded": {
      "$ref": "llm-request.schema.json"
    },
    "ToolPayloadDecoded": {
      "$ref": "agent-tools.schema.json#/$defs/ToolPayload"
    }
  }
}
