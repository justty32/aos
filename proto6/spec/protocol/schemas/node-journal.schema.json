{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-journal.schema.json",
  "title": "git 備援的完成紀錄",
  "description": ".aos/journal/<seq>.json；標準配備在 git 不能用時，每組全成功寫一筆（B-632、P-205）。不認得的欄位忽略（P-007）。",
  "type": "object",
  "required": [
    "version",
    "seq",
    "at_ms",
    "tasks",
    "consumed",
    "outbox"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999
    },
    "at_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "exit"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "consumed": {
      "description": "本組的消費副本，相對 node 根的路徑。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)"
      }
    },
    "outbox": {
      "description": "本組的待送檔，相對 node 根的路徑。",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)"
      }
    }
  }
}
