{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "不可變工具 manifest、模型 tool call 與工具 schema 子集",
  "$comment": "〔建議預設，未拍板〕欄位與語意依 agent-state.md；schema 通過不代表引用存在、授權成立或控制交易已提交。",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tool"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "tools"
  ],
  "additionalProperties": false,
  "$defs": {
    "Tool": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "description": {
          "type": "string"
        },
        "input_schema": {
          "allOf": [
            {
              "$ref": "#/$defs/ToolSchema"
            },
            {
              "properties": {
                "type": {
                  "const": "object"
                }
              }
            }
          ]
        },
        "exec_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "result_mode": {
          "enum": [
            "text",
            "json"
          ],
          "default": "text"
        },
        "result_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "input_schema",
        "exec_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result_mode": {
                "const": "json"
              }
            },
            "required": [
              "result_mode"
            ]
          },
          "then": {
            "required": [
              "result_schema"
            ],
            "properties": {
              "result_schema": {
                "$ref": "#/$defs/ToolSchema"
              }
            }
          }
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "call_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "name": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "ToolSchema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ToolSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/ToolSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "$comment": "A-401 keyword 白名單 meta-schema。登記另驗 min <= max、有限數、原 JSON token 與 duplicate key；各 keyword 對 instance 的適用型別依 JSON Schema 2020-12。"
    },
    "ExecTemplate": {
      "$ref": "execution-template.schema.json"
    },
    "ToolPayload": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "config_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "tool_manifest_ref": {
          "type": "string",
          "minLength": 1
        },
        "exec_template_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "work_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "call",
        "config_revision",
        "tool_manifest_ref",
        "exec_template_ref",
        "work_ref"
      ],
      "additionalProperties": false,
      "$comment": "Tool JobDraft.payload_ref 解碼後的持久映射；work_ref 內容另驗 WorkDecoded。控制端核對固定 manifest、owner/run/job 與 canonical arguments 的 stdin 摘要，不按模型內容自選模板。"
    },
    "WorkDecoded": {
      "$ref": "execution-work.schema.json"
    }
  }
}
