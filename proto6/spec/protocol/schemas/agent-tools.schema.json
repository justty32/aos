{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-tools.schema.json",
  "title": "proto6 agent-tools",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "required": [
              "type"
            ]
          },
          "argv": {
            "$ref": "node-inst.schema.json#/$defs/LiteralArgv"
          },
          "cwd": {
            "$ref": "common.schema.json#/$defs/NodeId"
          },
          "result": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "json"
                ]
              },
              "schema": {
                "type": "object"
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "json"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "required": [
                    "schema"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "schema"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "output_limit_bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "description",
          "parameters",
          "argv",
          "cwd",
          "result",
          "timeout_ms",
          "output_limit_bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "tools"
  ],
  "additionalProperties": false
}
