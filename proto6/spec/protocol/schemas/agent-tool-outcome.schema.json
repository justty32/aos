{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeAdapter 模型可見工具結果封套",
  "$comment": "A-403 純讀取模型封套；exec_result_ref 非 null 時須等於 outcome.result_ref，解引用內容另驗 $defs/ExecResult；兩個 preview 合計 UTF-8 byte 上限及結果歸屬另驗。",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "call_id": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "outcome": {
      "$ref": "control-common.schema.json#/$defs/Outcome"
    },
    "exec_result_ref": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout_preview": {
      "type": "string",
      "default": ""
    },
    "stderr_preview": {
      "type": "string",
      "default": ""
    },
    "preview_truncated": {
      "type": "boolean"
    },
    "output_truncated": {
      "type": "boolean"
    },
    "semantic_error": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "call_id",
    "outcome",
    "exec_result_ref",
    "stdout_preview",
    "stderr_preview",
    "preview_truncated",
    "output_truncated",
    "semantic_error"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExecResult": {
      "$ref": "execution-result.schema.json"
    }
  }
}
