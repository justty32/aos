{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon state.json（P-116）；持久檔，不認得的欄位忽略（C-07）",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "clean_shutdown": {
      "type": "boolean"
    },
    "registrations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "$ref": "common.schema.json#/$defs/NodeId"
          },
          "identity_grant": {
            "$ref": "daemon-registration.schema.json#/$defs/IdentityGrantOpen"
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "provision": {
            "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrantOpen"
          },
          "parent_id": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/NodeId"
              },
              {
                "type": "null"
              }
            ]
          },
          "once": {
            "type": "boolean"
          },
          "paused": {
            "type": "boolean"
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "node_id",
          "parent_id",
          "identity_grant",
          "paused",
          "pending",
          "once"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "once": {
                  "const": true
                }
              },
              "required": [
                "once"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "interval_ms"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "parent_id": {
                  "type": "null"
                }
              }
            },
            "then": {
              "properties": {
                "once": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "clean_shutdown",
    "registrations"
  ]
}
