{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttentionPolicy",
  "description": "proto6 control 協議；建議預設，未拍板。權限、引用、容量與帳本狀態須另做語意驗證。",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "policy_id": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      },
      "maxItems": 1024
    },
    "default_action": {
      "const": "inspect"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "policy_id",
    "rules",
    "default_action"
  ],
  "additionalProperties": false,
  "$defs": {
    "Rule": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "risk": {
          "enum": [
            "safe",
            "dangerous",
            "manual"
          ]
        },
        "action": {
          "enum": [
            "run.resume",
            "run.cancel",
            "run.resolve.retry",
            "run.resolve.fail",
            "run.resolve.cancel_with_unknown",
            "aos-clean",
            "inspect"
          ]
        },
        "clean_policy_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "code",
        "risk",
        "action"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "risk": {
                "const": "safe"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "run.resume",
                  "aos-clean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "dangerous"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "run.resume",
                  "run.cancel",
                  "run.resolve.retry",
                  "run.resolve.fail",
                  "run.resolve.cancel_with_unknown"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "inspect"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "aos-clean"
              }
            }
          },
          "then": {
            "required": [
              "clean_policy_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "clean_policy_id"
              ]
            }
          }
        }
      ]
    }
  }
}
