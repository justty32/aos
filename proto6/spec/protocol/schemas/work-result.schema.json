{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "outcome": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "canceled",
            "unknown"
          ]
        },
        "reason": {
          "enum": [
            "exited",
            "signal",
            "start_failed",
            "timeout",
            "canceled",
            "oom",
            "output_limit",
            "descendants_remaining",
            "output_incomplete",
            "unknown"
          ]
        },
        "started": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          ]
        },
        "signal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          ]
        },
        "stdout": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/[^\\u0000]*$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "bytes",
                "truncated"
              ]
            }
          ]
        },
        "stderr": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/[^\\u0000]*$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "path",
                "bytes",
                "truncated"
              ]
            }
          ]
        },
        "version": {
          "const": 1
        },
        "diagnostic": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "node_id",
        "job_id",
        "attempt_id",
        "status",
        "reason",
        "started",
        "exit_code",
        "signal",
        "stdout",
        "stderr"
      ],
      "allOf": [
        {
          "not": {
            "properties": {
              "exit_code": {
                "type": "integer"
              },
              "signal": {
                "type": "integer"
              }
            },
            "required": [
              "exit_code",
              "signal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "exited"
              },
              "started": {
                "const": true
              },
              "exit_code": {
                "const": 0
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "canceled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "start_failed"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "failed"
              },
              "started": {
                "const": false
              },
              "exit_code": {
                "type": "null"
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "signal"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "failed"
              },
              "started": {
                "const": true
              },
              "signal": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "exit_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": [
                  "timeout",
                  "oom",
                  "output_limit",
                  "descendants_remaining",
                  "output_incomplete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "exited"
              }
            }
          },
          "then": {
            "properties": {
              "started": {
                "const": true
              },
              "exit_code": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "signal": {
                "type": "null"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "const": "canceled"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "started": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "signal": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "stdout": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "truncated": {
                        "const": false
                      }
                    }
                  }
                ]
              },
              "stderr": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "truncated": {
                        "const": false
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "#/$defs/outcome"
        }
      ],
      "properties": {
        "version": {
          "const": 1
        }
      },
      "required": [
        "version"
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/FileRpcResponse"
        },
        {
          "properties": {
            "result": {
              "allOf": [
                {
                  "$ref": "#/$defs/outcome"
                },
                {
                  "not": {
                    "required": [
                      "version"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
