{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-config.schema.json",
  "title": "proto6 agent-config",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "llm": {
      "type": "object",
      "properties": {
        "target_node": {
          "description": "node id＝把 llm.chat 投給這個 node（池或 kernel）；null＝直連：agent 自己打 endpoint，endpoint 與 key 放哪由 agent 自己定（S-301）",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "pool": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "target_node",
        "pool",
        "model",
        "max_completion_tokens",
        "timeout_ms",
        "context_tokens"
      ],
      "additionalProperties": false
    },
    "system_prompt": {
      "type": "string"
    },
    "tools_file": {
      "const": "config/tools.json"
    },
    "tools": {
      "type": "object",
      "properties": {
        "target_node": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target_node"
      ],
      "additionalProperties": false
    },
    "daemon_socket": {
      "$ref": "common.schema.json#/$defs/NodeId"
    }
  },
  "required": [
    "version",
    "llm",
    "system_prompt",
    "tools_file",
    "tools",
    "daemon_socket"
  ],
  "additionalProperties": false
}
