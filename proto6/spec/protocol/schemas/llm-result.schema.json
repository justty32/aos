{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "outcome": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "job_id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt_id": {
                "$ref": "common.schema.json#/$defs/ID"
              },
              "status": {
                "enum": [
                  "succeeded",
                  "failed",
                  "canceled",
                  "unknown"
                ]
              },
              "reason": {
                "enum": [
                  "completed",
                  "rate_limited",
                  "rejected",
                  "not_sent",
                  "response_invalid",
                  "canceled",
                  "unknown"
                ]
              },
              "message": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "llm-messages.schema.json#/$defs/assistant"
                  }
                ]
              },
              "finish_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "usage": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "prompt_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "completion_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "total_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "prompt_tokens",
                      "completion_tokens",
                      "total_tokens"
                    ]
                  }
                ]
              },
              "http_status": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  }
                ]
              },
              "retry_at_ms": {
                "$ref": "common.schema.json#/$defs/TimeMs"
              }
            },
            "required": [
              "attempt_id",
              "status",
              "reason",
              "message",
              "finish_reason",
              "usage",
              "http_status"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "succeeded"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "completed"
                    },
                    "message": {
                      "$ref": "llm-messages.schema.json#/$defs/assistant"
                    },
                    "finish_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "http_status": {
                      "type": "integer",
                      "minimum": 200,
                      "maximum": 299
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unknown"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "unknown"
                    },
                    "message": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "canceled"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "canceled"
                    },
                    "message": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "failed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "reason": {
                      "enum": [
                        "rate_limited",
                        "rejected",
                        "not_sent",
                        "response_invalid"
                      ]
                    },
                    "message": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "retry_at_ms"
                  ]
                },
                "then": {
                  "properties": {
                    "reason": {
                      "const": "rate_limited"
                    },
                    "status": {
                      "const": "failed"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "node_id",
        "job_id",
        "attempts"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/outcome"
    }
  ],
  "required": [
    "version"
  ]
}
