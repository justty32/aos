{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storage-clean-request",
  "description": "proto6 storage 協議；建議預設，未拍板。授權、引用及持久化另依 storage.md。",
  "oneOf": [
    {
      "$ref": "#/$defs/Acquire"
    },
    {
      "$ref": "#/$defs/HookReceipt"
    },
    {
      "$ref": "#/$defs/AcquireError"
    },
    {
      "$ref": "#/$defs/HookAcquire"
    }
  ],
  "$defs": {
    "Acquire": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "clean_acquire"
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "agent"
                },
                "agent_id": {
                  "$ref": "control-common.schema.json#/$defs/ID"
                }
              },
              "required": [
                "kind",
                "agent_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "all_agents",
                    "control"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "trigger": {
          "enum": [
            "system_post",
            "administrator"
          ]
        },
        "hook_run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "policy_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_elapsed_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "scope",
        "trigger",
        "policy_id",
        "max_items",
        "max_bytes",
        "max_elapsed_ms"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "trigger": {
                "const": "system_post"
              }
            }
          },
          "then": {
            "required": [
              "hook_run_id"
            ],
            "properties": {
              "scope": {
                "properties": {
                  "kind": {
                    "const": "agent"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "hook_run_id"
              ]
            }
          }
        }
      ]
    },
    "HookReceipt": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "clean_hook_result"
        },
        "hook_run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "batch_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "completed",
            "partial",
            "failed",
            "unknown"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "kind",
        "hook_run_id",
        "request_id",
        "batch_id",
        "status",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "failed",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "control-common.schema.json#/$defs/Error"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AcquireError": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "clean_acquire_error"
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "error": {
          "$ref": "control-common.schema.json#/$defs/Error"
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "error"
      ],
      "additionalProperties": false
    },
    "HookAcquire": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "const": "clean_hook_acquire"
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "hook_run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "version",
        "kind",
        "request_id",
        "hook_run_id",
        "agent_id"
      ],
      "additionalProperties": false
    }
  }
}
