{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRegistration",
  "$ref": "#/$defs/AgentRegistration",
  "$defs": {
    "AgentRegistration": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "uniqueItems": true
        },
        "home": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "resource_domain": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "project": {
          "anyOf": [
            {
              "$ref": "#/$defs/Project"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "enabled",
            "disabled",
            "retired"
          ]
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profile_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resource_limits": {
          "$ref": "execution-profile.schema.json#/$defs/ResourceLimits"
        },
        "quota_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "quota_inodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "agent_id",
        "uid",
        "gid",
        "groups",
        "home",
        "resource_domain",
        "project",
        "status",
        "registry_revision",
        "profile_id",
        "resource_limits"
      ],
      "additionalProperties": false,
      "description": "C-02/B-302/B-303/B-304；〔建議預設，未拍板〕管理者登記的一筆不可變版本。uid/gid 排除 0；profile 允許範圍、live agent UID 不共用、群組核准須另驗。generation 是控制層觀測欄，可省，初始 1，不接受管理 adapter 擅改。resource_limits 為 agent 合計上限。quota_backend=none 時 project=null 且省略 quota_bytes/quota_inodes；啟用時三者必填，額度只記帳。",
      "allOf": [
        {
          "if": {
            "properties": {
              "project": {
                "type": "null"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "quota_bytes"
                  ]
                },
                {
                  "required": [
                    "quota_inodes"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "quota_bytes",
              "quota_inodes"
            ]
          }
        }
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "filesystem_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "project_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "filesystem_id",
        "project_id"
      ],
      "additionalProperties": false
    },
    "LaunchSnapshot": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "snapshot_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "attempt_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "registry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profile_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "probe_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "execution_kind": {
          "enum": [
            "tool",
            "tick",
            "agent_hook",
            "system_hook"
          ]
        },
        "work_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stdin_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hook_run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_attempt_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "registration": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentRegistration"
            },
            {
              "type": "null"
            }
          ]
        },
        "service_uid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "service_gid": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_domain": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "service_limits": {
          "anyOf": [
            {
              "$ref": "execution-profile.schema.json#/$defs/ResourceLimits"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_home": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "description": "由管理者配置、daemon 匯出的 HOME；tool/tick/agent_hook 必須等於 registration.home，system_hook 使用專用服務 home。相等檢查由語意驗證執行；helper 不代開此路徑。"
        },
        "runtime_tmpdir": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "description": "由管理者預先佈建、daemon 匯出的 TMPDIR；必須位於 profile.writable_scope 核准的容量範圍，核對實際容量歸屬及執行身分可存取性；不接受 agent 自選，helper 不代開此路徑。"
        }
      },
      "required": [
        "version",
        "snapshot_revision",
        "attempt_id",
        "agent_id",
        "registry_revision",
        "profile_id",
        "probe_revision",
        "execution_kind",
        "work_sha256",
        "stdin_sha256",
        "hook_run_id",
        "claim_attempt_id",
        "generation",
        "registration",
        "service_uid",
        "service_gid",
        "resource_domain",
        "service_limits",
        "runtime_home",
        "runtime_tmpdir"
      ],
      "additionalProperties": false,
      "description": "P-011 暫定 6；〔建議預設，未拍板〕daemon 按已提交派出意圖輸出、管理者保護的唯讀快照。helper 只能取得受保護 fd，核對來源、revision、白名單、摘要及授權，不解析工作內容；本紀錄不含 argv/cwd/env/stdin。snapshot_revision 標識不可變快照；同值異內容拒絕。啟動去重鍵為 (attempt_id,hook_run_id)。tool/tick 的 hook_run_id=null；hook 的 attempt_id/claim_attempt_id 同為父 tick attempt ID，hook_run_id 獨立，不建立 hook Job 或 Attempt。hook generation 必須等於 live claim；tool/tick generation 也由控制帳本核對。agent_id 在 system_hook 仍為所屬 agent；service 身分須為部署核准的非 root 控制側服務身分，不得等於 agent UID。registration 及 resource_domain 的重複欄位必須與可信登記吻合，不接受 caller 自報。",
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_kind": {
                "enum": [
                  "agent_hook",
                  "system_hook"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "hook_run_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "claim_attempt_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          "else": {
            "properties": {
              "hook_run_id": {
                "type": "null"
              },
              "claim_attempt_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "execution_kind": {
                "const": "system_hook"
              }
            }
          },
          "then": {
            "properties": {
              "registration": {
                "type": "null"
              },
              "service_uid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "service_gid": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "service_limits": {
                "$ref": "execution-profile.schema.json#/$defs/ResourceLimits"
              }
            }
          },
          "else": {
            "properties": {
              "registration": {
                "$ref": "#/$defs/AgentRegistration"
              },
              "service_uid": {
                "type": "null"
              },
              "service_gid": {
                "type": "null"
              },
              "service_limits": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
