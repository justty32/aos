{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-content",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "anyOf": [
    {
      "$ref": "#/$defs/HistoryEvent"
    },
    {
      "$ref": "#/$defs/Notes"
    },
    {
      "$ref": "#/$defs/Context"
    }
  ],
  "$defs": {
    "HistoryEvent": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "event_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "kind": {
          "enum": [
            "input",
            "assistant",
            "tool_result",
            "summary",
            "note"
          ]
        },
        "content_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          }
        }
      },
      "required": [
        "version",
        "event_seq",
        "run_id",
        "kind",
        "content_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "summary"
              }
            }
          },
          "then": {
            "required": [
              "source_refs"
            ],
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "Notes": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "content_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          }
        }
      },
      "required": [
        "version",
        "content_ref",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "config_revision": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "messages_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          },
          "minItems": 1
        },
        "omitted_source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          }
        },
        "estimation": {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "const": 1
            },
            "estimator_revision": {
              "type": "string",
              "minLength": 1
            },
            "is_estimate": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "output_token_reserve": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "method",
            "version",
            "estimator_revision",
            "is_estimate",
            "input_tokens",
            "output_token_reserve"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "config_revision",
        "messages_ref",
        "source_refs",
        "omitted_source_refs",
        "estimation"
      ],
      "additionalProperties": false
    },
    "ProviderMessagesDecoded": {
      "$ref": "llm-messages.schema.json"
    },
    "LLMRequestDecoded": {
      "$ref": "llm-request.schema.json"
    }
  }
}
