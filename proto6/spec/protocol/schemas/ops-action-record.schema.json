{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "operation_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "source_node": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "issue_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "action_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "actor_uid": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "at_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "outcome": {
      "enum": [
        "prepared",
        "submitted",
        "succeeded",
        "failed",
        "unknown",
        "skipped"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "$ref": "common.schema.json#/$defs/Error"
    }
  },
  "required": [
    "version",
    "operation_id",
    "source_node",
    "issue_id",
    "actor_uid",
    "at_ms",
    "outcome",
    "message"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "skipped"
          }
        }
      },
      "then": {},
      "else": {
        "required": [
          "action_id"
        ]
      }
    }
  ]
}
