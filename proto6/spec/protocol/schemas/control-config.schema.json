{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControlConfig",
  "description": "proto6 control 協議；建議預設，未拍板。權限、引用、容量與帳本狀態須另做語意驗證。",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "deployment": {
      "$ref": "#/$defs/Deployment"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Channel"
      }
    },
    "admission": {
      "$ref": "#/$defs/Admission"
    },
    "capacity": {
      "$ref": "#/$defs/Capacity"
    },
    "shutdown": {
      "type": "object",
      "properties": {
        "stop_grace_ms": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "stop_grace_ms"
      ],
      "additionalProperties": false
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "claim_batch_size": {
          "default": 64,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "reconcile_interval_ms": {
          "default": 60000,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "reconcile_batch_size": {
          "default": 64,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "hook_skip_initial_backoff_ms": {
          "default": 60000,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "hook_skip_max_backoff_ms": {
          "default": 900000,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "resume_needs_attention": {
          "type": "boolean",
          "default": false
        },
        "resume_budget_increase": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "system_hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SystemHook"
      },
      "default": []
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "deployment",
    "channels",
    "admission",
    "capacity",
    "shutdown"
  ],
  "additionalProperties": false,
  "$defs": {
    "Deployment": {
      "type": "object",
      "properties": {
        "control_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "entry_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "spool_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "attention_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "rpc_socket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "service_socket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "helper_socket": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/[^\\u0000]*$"
        },
        "control_uid": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "service_uid": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "control_root",
        "entry_root",
        "spool_root",
        "attention_dir",
        "rpc_socket",
        "service_socket",
        "helper_socket",
        "control_uid",
        "service_uid"
      ],
      "additionalProperties": false
    },
    "Channel": {
      "type": "object",
      "properties": {
        "channel_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "principal_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "uid": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "purpose": {
          "enum": [
            "control_rpc",
            "tick_commit",
            "tool_llm"
          ]
        },
        "agent_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "channel_id",
        "principal_id",
        "uid",
        "purpose",
        "agent_id"
      ],
      "additionalProperties": false
    },
    "Admission": {
      "type": "object",
      "properties": {
        "max_tick_inflight": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "max_tool_inflight": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "max_llm_inflight": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "max_pending_jobs": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "per_agent_inflight": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "per_agent_pending_jobs": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "max_tick_inflight",
        "max_tool_inflight",
        "max_llm_inflight",
        "max_pending_jobs",
        "per_agent_inflight"
      ],
      "additionalProperties": false
    },
    "Capacity": {
      "type": "object",
      "properties": {
        "reservation_policy_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "reserve_bytes": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "max_metadata_bytes": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "diagnostic_limit_bytes": {
          "maximum": 65536,
          "default": 65536,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "reservation_policy_id",
        "reserve_bytes",
        "max_metadata_bytes"
      ],
      "additionalProperties": false
    },
    "SystemHook": {
      "type": "object",
      "properties": {
        "hook": {
          "$ref": "agent-hook-registration.schema.json"
        },
        "agent_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "hook",
        "agent_ids"
      ],
      "additionalProperties": false
    }
  }
}
