{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-input",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "$ref": "#/$defs/Input",
  "$defs": {
    "Input": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          }
        },
        "extensions": {
          "type": "object"
        }
      },
      "required": [
        "version",
        "text"
      ],
      "additionalProperties": false
    },
    "InputDelivery": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "input_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sender": {
          "type": "string",
          "minLength": 1
        },
        "input_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "consumed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "request_id",
        "run_id",
        "input_seq",
        "sender",
        "input_ref",
        "consumed"
      ],
      "additionalProperties": false
    }
  }
}
