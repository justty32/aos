{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "pool": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "$ref": "llm-messages.schema.json"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "llm-messages.schema.json#/$defs/tool"
      },
      "minItems": 1
    },
    "max_completion_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "stream_path": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    }
  },
  "required": [
    "node_id",
    "job_id",
    "attempt_id",
    "pool",
    "model",
    "messages",
    "max_completion_tokens",
    "timeout_ms"
  ],
  "additionalProperties": false
}
