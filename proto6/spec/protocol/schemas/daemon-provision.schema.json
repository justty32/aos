{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 固定佈建動作參數（P-107、B-609）",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "account_create"
        },
        "user": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node_id",
        "action",
        "user"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "chown"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "user": {
          "$ref": "daemon-registration.schema.json#/$defs/User"
        }
      },
      "required": [
        "node_id",
        "action",
        "path",
        "user"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "cgroup_create"
        }
      },
      "required": [
        "node_id",
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "cgroup_limits"
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu_max": {
              "type": "object",
              "properties": {
                "quota_us": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "period_us": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "quota_us",
                "period_us"
              ],
              "additionalProperties": false
            },
            "memory_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "pids_max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "required": [
        "node_id",
        "action",
        "limits"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "quota"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "project_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "node_id",
        "action",
        "path",
        "project_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "cgroup_delegate"
        }
      },
      "required": [
        "node_id",
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "group_create"
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node_id",
        "action",
        "group"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "group_add_member"
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "$ref": "daemon-registration.schema.json#/$defs/User"
        }
      },
      "required": [
        "node_id",
        "action",
        "group",
        "user"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "chgrp"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "node_id",
        "action",
        "path",
        "group"
      ],
      "additionalProperties": false
    },
    {
      "description": "〔第十九批疑點裁定 10〕以指定帳號開程序：只收帶憑證的通道請求；同一個 sendmsg 以 SCM_RIGHTS 附鎖 fd 與回報 pipe 寫端共 2 個 fd（運行時核對）",
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "action": {
          "const": "spawn_as"
        },
        "user": {
          "$ref": "daemon-registration.schema.json#/$defs/User"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "frame": {
          "type": "string",
          "pattern": "^task-[1-9][0-9]*$"
        },
        "token": {
          "$ref": "daemon-registration.schema.json#/$defs/Token"
        }
      },
      "required": [
        "node_id",
        "action",
        "user",
        "path",
        "token"
      ],
      "additionalProperties": false
    }
  ]
}
