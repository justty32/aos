{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-llm-limits",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quota_scope": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "concurrent_requests": {
            "type": "integer",
            "minimum": 1
          },
          "window_ms": {
            "type": "integer",
            "minimum": 1
          },
          "requests_per_window": {
            "type": "integer",
            "minimum": 1
          },
          "tokens_per_window": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "quota_scope",
          "concurrent_requests",
          "window_ms",
          "requests_per_window",
          "tokens_per_window"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "scopes"
  ],
  "additionalProperties": false
}
