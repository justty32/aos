{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttentionAction",
  "description": "proto6 control 協議；建議預設，未拍板。權限、引用、容量與帳本狀態須另做語意驗證。",
  "$ref": "#/$defs/ActionRecord",
  "$defs": {
    "ActionRecord": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "action_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "batch_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "item_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "agent_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "actor": {
          "type": "object",
          "properties": {
            "principal_id": {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            "uid": {
              "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
            }
          },
          "required": [
            "principal_id",
            "uid"
          ],
          "additionalProperties": false
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "at_ms": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "policy_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "code": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "action": {
          "enum": [
            "run.resume",
            "run.cancel",
            "run.resolve.retry",
            "run.resolve.fail",
            "run.resolve.cancel_with_unknown",
            "aos-clean",
            "inspect"
          ]
        },
        "risk": {
          "enum": [
            "safe",
            "dangerous",
            "manual"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "accepted",
            "completed",
            "skipped",
            "failed",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 4096
        },
        "query_request_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "rpc": {
          "type": "object",
          "properties": {
            "jsonrpc": {
              "const": "2.0"
            },
            "id": {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            "method": {
              "const": "run.resume"
            },
            "params": {
              "type": "object",
              "properties": {
                "run_id": {
                  "$ref": "control-common.schema.json#/$defs/ID"
                }
              },
              "required": [
                "run_id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "jsonrpc",
            "id",
            "method",
            "params"
          ],
          "additionalProperties": false
        },
        "clean_request": {
          "allOf": [
            {
              "$ref": "storage-clean-request.schema.json#/$defs/Acquire"
            },
            {
              "properties": {
                "scope": {
                  "properties": {
                    "kind": {
                      "const": "agent"
                    }
                  }
                },
                "trigger": {
                  "const": "administrator"
                }
              },
              "not": {
                "required": [
                  "hook_run_id"
                ]
              }
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "action_id",
        "batch_id",
        "item_id",
        "agent_id",
        "run_id",
        "actor",
        "request_id",
        "at_ms",
        "policy_id",
        "code",
        "action",
        "risk",
        "status",
        "reason",
        "query_request_id",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "risk": {
                "enum": [
                  "dangerous",
                  "manual"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "skipped"
              },
              "request_id": {
                "type": "null"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rpc"
                  ]
                },
                {
                  "required": [
                    "clean_request"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "required": [
              "rpc"
            ],
            "properties": {
              "action": {
                "const": "run.resume"
              },
              "risk": {
                "const": "safe"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "rpc"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "run.resume"
              },
              "risk": {
                "const": "safe"
              },
              "agent_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "run_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "request_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "query_request_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              }
            },
            "not": {
              "required": [
                "clean_request"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "clean_request"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "aos-clean"
              },
              "risk": {
                "const": "safe"
              },
              "agent_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "request_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "query_request_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              }
            },
            "not": {
              "required": [
                "rpc"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "control-common.schema.json#/$defs/Error"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "required": [
              "clean_request"
            ],
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "properties": {
              "request_id": {
                "type": "null"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "rpc"
                  ]
                },
                {
                  "required": [
                    "clean_request"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "safe"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "run.resume",
                  "aos-clean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "risk": {
                "const": "manual"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "const": "inspect"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            }
          },
          "then": {
            "properties": {
              "risk": {
                "const": "safe"
              },
              "request_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "error": {
                "type": "null"
              }
            },
            "oneOf": [
              {
                "required": [
                  "rpc"
                ]
              },
              {
                "required": [
                  "clean_request"
                ]
              }
            ]
          }
        }
      ]
    },
    "Actor": {
      "type": "object",
      "properties": {
        "principal_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "uid": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        }
      },
      "required": [
        "principal_id",
        "uid"
      ],
      "additionalProperties": false
    },
    "BatchRequest": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "batch_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "max_items": {
          "maximum": 1000,
          "default": 64,
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "version",
        "batch_id"
      ],
      "additionalProperties": false
    },
    "BatchResult": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "batch_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionRecord"
          },
          "maxItems": 1000
        },
        "has_more": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "batch_id",
        "actions",
        "has_more"
      ],
      "additionalProperties": false
    },
    "CleanLaunchRequest": {
      "allOf": [
        {
          "$ref": "storage-clean-request.schema.json#/$defs/Acquire"
        },
        {
          "properties": {
            "scope": {
              "properties": {
                "kind": {
                  "const": "agent"
                }
              }
            },
            "trigger": {
              "const": "administrator"
            }
          },
          "not": {
            "required": [
              "hook_run_id"
            ]
          }
        }
      ]
    },
    "CleanLaunchReply": {
      "oneOf": [
        {
          "$ref": "storage-clean-result.schema.json#/$defs/Receipt"
        },
        {
          "$ref": "storage-clean-request.schema.json#/$defs/AcquireError"
        },
        {
          "$ref": "storage-clean-result.schema.json#/$defs/Error"
        }
      ]
    }
  }
}
