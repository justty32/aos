{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "控制狀態與查詢投影",
  "description": "〔建議預設，未拍板〕邏輯交換及快照格式；不指定 SQLite layout，不接受一般 caller 直接寫入。query payload 不帶持久 version；單獨保存 query 時須另包既定持久 RPC 包裝。",
  "$defs": {
    "Budget": {
      "type": "object",
      "properties": {
        "max_jobs": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger",
          "default": 32
        },
        "max_llm_attempts": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger",
          "default": 16
        },
        "max_tokens_estimate": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger",
          "default": 100000
        },
        "max_elapsed_ms": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger",
          "default": 600000
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "〔建議預設，未拍板〕S-306。接納時補齊預設；resume 僅管理者能提高，省略維度保留目前值，不能拿初始預設降低既有額度。"
    },
    "BudgetCounters": {
      "type": "object",
      "properties": {
        "jobs_created": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "llm_attempts_created": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "tokens_known": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "tokens_uncertain": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "tokens_reserved": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "active_elapsed_ms": {
          "$ref": "control-common.schema.json#/$defs/DurationMs"
        },
        "active_started_at_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/EpochMs"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "jobs_created",
        "llm_attempts_created",
        "tokens_known",
        "tokens_uncertain",
        "tokens_reserved",
        "active_elapsed_ms",
        "active_started_at_ms"
      ],
      "additionalProperties": false,
      "description": "S-306 計數；active_started_at_ms 僅為持久核對時間，實際逾時使用經過時間，重啟不可重新給完整預算。paused／needs_attention 時起點為 null。"
    },
    "ReadyDue": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "ready": {
          "type": "boolean"
        },
        "next_due_at_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/EpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "ready_since_at_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/EpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_seq": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "served_seq": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        }
      },
      "required": [
        "version",
        "agent_id",
        "ready",
        "next_due_at_ms",
        "ready_since_at_ms",
        "pending_seq",
        "served_seq"
      ],
      "additionalProperties": false,
      "description": "S-201 權威排程摘要；served_seq 不得大於 pending_seq；兩者不是語意消費 cursor。"
    },
    "SchedulerCursor": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "cursor_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "kind": {
          "enum": [
            "reconcile",
            "import",
            "round_robin"
          ]
        },
        "position": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_size": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "last_advanced_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "round_started_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "last_completed_at_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/EpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_round_duration_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/DurationMs"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "cursor_id",
        "kind",
        "position",
        "batch_size",
        "last_advanced_at_ms",
        "round_started_at_ms",
        "last_completed_at_ms",
        "last_round_duration_ms"
      ],
      "additionalProperties": false,
      "description": "〔建議預設，未拍板〕S-202／S-204 的邏輯游標，不是 SQL layout。position 是控制端可重建索引中的不透明 ID，null 表示該輪起點；不得解成路徑。round_robin position 為上次選取的 agent_id；reconcile/import 由 cursor_id 綁定可信索引。"
    },
    "SchedulingSequences": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "next_job_seq": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "next_ready_seq": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        }
      },
      "required": [
        "version",
        "next_job_seq",
        "next_ready_seq"
      ],
      "additionalProperties": false,
      "description": "S-204 的下一可配發持久序號；配發與 job／ready 變更同交易，重啟不重置。"
    },
    "PendingResolution": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "fail",
            "cancel_with_unknown"
          ]
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        }
      },
      "required": [
        "decision",
        "request_id"
      ],
      "additionalProperties": false
    },
    "ResolutionRecord": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "job_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "request_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "resolved_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "decision": {
          "enum": [
            "retry",
            "fail",
            "cancel_with_unknown"
          ]
        },
        "accepted_unknown_effects": {
          "const": true
        },
        "new_max_attempts": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "clear_cancel_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "agent_id",
        "run_id",
        "job_id",
        "actor",
        "request_id",
        "resolved_at_ms",
        "decision",
        "accepted_unknown_effects"
      ],
      "additionalProperties": false,
      "description": "S-401 處置已登記的稽核；不表示本機已清空或 run 終局，不改原 attempt 的 unknown 證據。",
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "retry"
              }
            }
          },
          "then": {
            "required": [
              "new_max_attempts"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "new_max_attempts"
                  ]
                },
                {
                  "required": [
                    "clear_cancel_requested"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "CancellationState": {
      "type": "object",
      "properties": {
        "cancel_requested": {
          "type": "boolean"
        },
        "requested_at_ms": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/EpochMs"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup_state": {
          "enum": [
            "not_required",
            "pending",
            "cleared",
            "unknown"
          ]
        },
        "cleanup_evidence_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cancel_requested",
        "requested_at_ms",
        "cleanup_state",
        "cleanup_evidence_ref"
      ],
      "additionalProperties": false,
      "description": "〔建議預設，未拍板〕B-203／S-402 查詢投影。not_required 只用於未建立本機程序；cleared 須可信清空證據。unknown 不代表名額可釋放。證據格式由 execution-observation 擁有。"
    },
    "WaitReason": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "not_due",
            "quota_wait",
            "local_limit",
            "tool_result",
            "llm_result",
            "paused",
            "canceling",
            "result_unknown",
            "deployment_unavailable",
            "budget_exceeded",
            "needs_attention"
          ]
        },
        "since_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "scope_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "next_due_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        }
      },
      "required": [
        "code",
        "since_at_ms"
      ],
      "additionalProperties": false
    },
    "AgentQuery": {
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "phase": {
          "enum": [
            "idle",
            "think",
            "act",
            "wait",
            "paused",
            "error"
          ]
        },
        "generation": {
          "$ref": "control-common.schema.json#/$defs/PositiveInteger"
        },
        "checkpoint_revision": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_jobs": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "can_resume": {
          "type": "boolean"
        },
        "snapshot_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        }
      },
      "required": [
        "agent_id",
        "phase",
        "generation",
        "checkpoint_revision",
        "run_id",
        "wait_reason",
        "pending_jobs",
        "error",
        "can_resume",
        "snapshot_at_ms"
      ],
      "additionalProperties": false,
      "description": "A-505；phase、wait_reason、can_resume 為當下投影，不可寫回帳本作新權威；查詢不啟動 tick。"
    },
    "RunQuery": {
      "type": "object",
      "properties": {
        "run": {
          "$ref": "control-common.schema.json#/$defs/Run"
        },
        "agent_phase": {
          "enum": [
            "idle",
            "think",
            "act",
            "wait",
            "paused",
            "error"
          ]
        },
        "pending_jobs": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "inflight_jobs": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "wait_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/WaitReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "budget_counters": {
          "$ref": "#/$defs/BudgetCounters"
        }
      },
      "required": [
        "run",
        "agent_phase",
        "pending_jobs",
        "inflight_jobs",
        "wait_reason",
        "snapshot_at_ms",
        "budget_counters"
      ],
      "additionalProperties": false,
      "description": "S-402；paused／unknown／needs_attention 等屏障優先於 continuation 推導。"
    },
    "AttemptQuery": {
      "type": "object",
      "properties": {
        "attempt": {
          "$ref": "control-common.schema.json#/$defs/Attempt"
        },
        "cancellation": {
          "$ref": "#/$defs/CancellationState"
        },
        "snapshot_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        }
      },
      "required": [
        "attempt",
        "cancellation",
        "snapshot_at_ms"
      ],
      "additionalProperties": false,
      "description": "S-402；取消收據與可信清空證據分開。"
    },
    "ControlIntent": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "accepted_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "request": {
          "oneOf": [
            {
              "$ref": "control-methods.schema.json#/$defs/RunPauseRequest"
            },
            {
              "$ref": "control-methods.schema.json#/$defs/RunResumeRequest"
            },
            {
              "$ref": "control-methods.schema.json#/$defs/RunCancelRequest"
            },
            {
              "$ref": "control-methods.schema.json#/$defs/RunResolveRequest"
            },
            {
              "$ref": "control-methods.schema.json#/$defs/AttemptCancelRequest"
            }
          ]
        }
      },
      "required": [
        "version",
        "agent_id",
        "actor",
        "accepted_at_ms",
        "request"
      ],
      "additionalProperties": false,
      "description": "可信入口與去重收據同交易登記；actor 由認證通道產生，不採 request 自稱。保存的是原 request，重啟按帳本狀態推進，不能重建第二次操作。"
    },
    "MetricsWindow": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "window_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "mode": {
          "enum": [
            "steady_state",
            "startup_reconcile"
          ]
        },
        "started_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "finished_at_ms": {
          "$ref": "control-common.schema.json#/$defs/EpochMs"
        },
        "registered": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "unique_active": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "ready": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "tick_inflight": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "tool_inflight": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "http_inflight": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "queue_age_max_ms": {
          "$ref": "control-common.schema.json#/$defs/DurationMs"
        },
        "scope_waits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope_id": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "waiting_jobs": {
                "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
              },
              "oldest_wait_ms": {
                "$ref": "control-common.schema.json#/$defs/DurationMs"
              }
            },
            "required": [
              "scope_id",
              "waiting_jobs",
              "oldest_wait_ms"
            ],
            "additionalProperties": false
          }
        },
        "unknown_count": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "retry_count": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "control_cpu_ms": {
          "$ref": "control-common.schema.json#/$defs/DurationMs"
        },
        "control_rss_peak_bytes": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "control_fd_peak_count": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "ledger_commit_count": {
          "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
        },
        "ledger_commit_total_ms": {
          "$ref": "control-common.schema.json#/$defs/DurationMs"
        },
        "ledger_commit_max_ms": {
          "$ref": "control-common.schema.json#/$defs/DurationMs"
        },
        "rejections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "control-common.schema.json#/$defs/ID"
              },
              "count": {
                "$ref": "control-common.schema.json#/$defs/NonNegativeInteger"
              }
            },
            "required": [
              "code",
              "count"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "window_id",
        "mode",
        "started_at_ms",
        "finished_at_ms",
        "registered",
        "unique_active",
        "ready",
        "tick_inflight",
        "tool_inflight",
        "http_inflight",
        "queue_age_max_ms",
        "scope_waits",
        "unknown_count",
        "retry_count",
        "control_cpu_ms",
        "control_rss_peak_bytes",
        "control_fd_peak_count",
        "ledger_commit_count",
        "ledger_commit_total_ms",
        "ledger_commit_max_ms",
        "rejections"
      ],
      "additionalProperties": false,
      "description": "〔建議預設，未拍板〕S-403：registered／ready／inflight／unknown 為窗末快照，unique_active 為窗內去重數，CPU／retry／commit／rejection 為窗內增量，peak／max 為窗內最大值。每個 scope/code 只一項；時間先後與彙總一致性另驗。"
    },
    "BudgetState": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "agent_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "counters": {
          "$ref": "#/$defs/BudgetCounters"
        }
      },
      "required": [
        "version",
        "agent_id",
        "run_id",
        "budget",
        "counters"
      ],
      "additionalProperties": false,
      "description": "S-306 的控制帳本預算快照；budget 與 common.Run.budget 是同一權威的兩種投影，不另存可獨立修改的額度。計數與 reserve／settle／run 屏障同交易。"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReadyDue"
    },
    {
      "$ref": "#/$defs/SchedulerCursor"
    },
    {
      "$ref": "#/$defs/SchedulingSequences"
    },
    {
      "$ref": "#/$defs/ResolutionRecord"
    },
    {
      "$ref": "#/$defs/ControlIntent"
    },
    {
      "$ref": "#/$defs/MetricsWindow"
    },
    {
      "$ref": "#/$defs/AgentQuery"
    },
    {
      "$ref": "#/$defs/RunQuery"
    },
    {
      "$ref": "#/$defs/AttemptQuery"
    },
    {
      "$ref": "#/$defs/BudgetState"
    }
  ]
}
