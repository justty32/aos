{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-output",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "$ref": "#/$defs/Output",
  "$defs": {
    "Output": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "run_id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "output_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "progress",
            "final"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "run_id",
        "output_seq",
        "kind",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
