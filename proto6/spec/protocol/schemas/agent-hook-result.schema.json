{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "掛勾執行證據及所屬 tick 結果的持久紀錄",
  "$comment": "控制端根據可信 supervisor 觀測保存，不從掛勾 stdout 反序列化此紀錄。attempt_id 是所屬 tick，不建立 hook Job/Attempt；hook_run_id + claim_generation 追到原 claim。未在重啟前持久確認完成者為 unknown，不補跑。",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "hook_run_id": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "agent_id": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        {
          "type": "null"
        }
      ]
    },
    "claim_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "scope": {
      "enum": [
        "system",
        "agent"
      ]
    },
    "when": {
      "enum": [
        "pre",
        "post"
      ]
    },
    "tick_outcome": {
      "anyOf": [
        {
          "enum": [
            "committed",
            "rejected",
            "no_proposal",
            "timeout",
            "killed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "canceled",
        "unknown"
      ]
    },
    "reason": {
      "enum": [
        "exit",
        "signal",
        "spawn_error",
        "timeout",
        "canceled",
        "oom",
        "quota",
        "output_limit",
        "lost"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "signal": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stdout_blob": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "stderr_blob": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stderr_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "truncated": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "control-common.schema.json#/$defs/Error"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "hook_run_id",
    "agent_id",
    "run_id",
    "attempt_id",
    "claim_generation",
    "name",
    "scope",
    "when",
    "tick_outcome",
    "status",
    "reason",
    "exit_code",
    "signal",
    "started_at_ms",
    "finished_at_ms",
    "stdout_blob",
    "stderr_blob",
    "stdout_bytes",
    "stderr_bytes",
    "truncated",
    "error"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "when": {
            "const": "pre"
          }
        }
      },
      "then": {
        "properties": {
          "tick_outcome": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "tick_outcome": {
            "enum": [
              "committed",
              "rejected",
              "no_proposal",
              "timeout",
              "killed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "exit"
          },
          "exit_code": {
            "const": 0
          },
          "signal": {
            "type": "null"
          },
          "error": {
            "type": "null"
          },
          "truncated": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "$ref": "control-common.schema.json#/$defs/Error"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "lost"
          },
          "exit_code": {
            "type": "null"
          },
          "signal": {
            "type": "null"
          }
        }
      }
    }
  ]
}
