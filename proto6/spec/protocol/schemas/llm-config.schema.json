{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "endpoint": {
            "type": "string",
            "pattern": "^https?://[^\\s?#@]+$"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "key_ref": {
            "type": "string",
            "pattern": "^/[^\\u0000]*$"
          },
          "quota_scope": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "schedule": {
            "enum": [
              "aos",
              "endpoint"
            ],
            "default": "aos"
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "只給 schedule=aos（省略即此值）的池；schedule=endpoint 時不允許這欄（P-405）"
          }
        },
        "required": [
          "id",
          "endpoint",
          "model",
          "quota_scope"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "schedule": {
              "const": "endpoint"
            }
          },
          "required": [
            "schedule"
          ]
        },
        "then": {
          "not": {
            "required": [
              "max_attempts"
            ]
          }
        }
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "pools"
  ],
  "additionalProperties": false
}
