{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tick-tasks.schema.json",
  "title": "工作資料夾的任務註冊表",
  "description": "<工作資料夾>/.aos/tasks.json（AOS_DIRNAME 空字串時是 <工作資料夾>/tasks.json）。整份是指示詞時先解開再驗。這是完整格式，給恢復前驗證與工具用；aos-tick 核心開格只做極簡檢查（有 tasks 陣列、每項解一層後是物件、合併頂層預設後有 argv，B-620）。任務是 inst 的超集；id、kind 可省（沒寫 id 時 id 是陣列位置字串，P-202）；沒有 user（inst 頂層沒有，2026-10-01 撤回），寫了照陌生鍵。不認得的鍵照收、核心忽略（P-007），group、needs、methods 都當陌生鍵。id 是否重複不驗（默認不重複）。〔使用者 2026-10-01〕頂層可放 inst 的七個欄位（argv、cwd、envs、stdin、stdout、stderr、exit）當每一項的預設：淺層合併，項自己寫了某個鍵就整個蓋過頂層那個鍵（envs 也整包換）；頂層 _metainfo 是整份表的格式標記、id／kind 是 aos 欄位，都不是預設。頂層 cwd 不改 tick 自己的 cwd（tick 永遠在工作資料夾跑），只是任務的預設 cwd，相對路徑以工作資料夾為起點。指示詞展開時機：讀表時頂層每個鍵的值、tasks 本身、tasks 每一元素各解一層（$ref 相對工作資料夾）；值的內部讀表時不解；跑到某一項時先合併預設，再把合併結果當一份 inst 照 inst 規則展開（這時 $ref:\"\"／#… 指合併後的這一項）。頂層 modules 是模組設定（比照 daemon 設定檔），不是預設值，核心不看。",
  "type": "object",
  "required": [
    "_metainfo",
    "tasks"
  ],
  "properties": {
    "tasks": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Task"
              },
              {
                "$ref": "#/$defs/Ref"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/Ref",
          "description": "讀表時解一層成陣列，例如 {\"$ref\": \"tasks.d/list.json\"}"
        }
      ]
    },
    "_metainfo": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ]
    },
    "argv": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/argv",
      "description": "每一項的預設 argv；有它時各項可不寫 argv"
    },
    "cwd": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/cwd",
      "description": "每一項的預設 cwd；不改 tick 自己的 cwd，相對路徑以工作資料夾為起點"
    },
    "envs": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/envs",
      "description": "每一項的預設 envs；項自己寫了 envs 就整包換掉，不逐變數合併"
    },
    "stdin": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stdin"
    },
    "stdout": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stdout"
    },
    "stderr": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stderr"
    },
    "exit": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/exit"
    },
    "modules": {
      "type": "object",
      "description": "〔使用者 2026-10-01〕一個模組一個鍵，內容不限；不是 inst 欄位、不當任務預設值；核心照收不理、內部不展開（留給之後的模組）"
    }
  },
  "if": {
    "not": {
      "required": [
        "argv"
      ]
    }
  },
  "then": {
    "description": "頂層沒給 argv 時，每一項（整項 $ref 的除外，解開後才知道）都要自己有 argv",
    "properties": {
      "tasks": {
        "items": {
          "anyOf": [
            {
              "required": [
                "argv"
              ]
            },
            {
              "required": [
                "$ref"
              ]
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string"
        },
        "$at": {
          "type": "string"
        }
      },
      "required": [
        "$ref"
      ]
    },
    "Task": {
      "type": "object",
      "description": "inst 的欄位加上 id、kind；argv 可由頂層預設補上（必填與否由根的 if／then 判）",
      "propertyNames": {
        "not": {
          "pattern": "^\\$"
        }
      },
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID",
          "description": "可省；沒寫時 id＝它在 tasks 陣列的位置轉字串（P-202、B-620）"
        },
        "kind": {
          "description": "可省（B-620、B-626）。system／kernel／agent／custom，或〔暫定〕自訂的「類別.名稱」，類別限 kernel／agent／custom；system 標記系統級任務、不開放自訂。只是標記，核心不看，不驗順序。",
          "anyOf": [
            {
              "enum": [
                "system",
                "kernel",
                "agent",
                "custom"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:kernel|agent|custom)\\.[a-z][a-z0-9_-]*$(?![\\s\\S])"
            }
          ]
        },
        "_metainfo": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/_metainfo"
        },
        "argv": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/argv"
        },
        "cwd": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/cwd"
        },
        "envs": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/envs"
        },
        "stdin": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stdin"
        },
        "stdout": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stdout"
        },
        "stderr": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stderr"
        },
        "exit": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/exit"
        }
      }
    }
  }
}
