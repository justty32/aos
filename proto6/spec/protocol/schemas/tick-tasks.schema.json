{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-tasks.schema.json",
  "title": "node 任務註冊表",
  "description": ".aos/tasks.json（aos-tick 的目標給檔時就是那個檔）；整份 $ref 展開後再驗證 Task。這是完整格式，給恢復前驗證與工具用；aos-tick 核心開格只做極簡檢查（有 tasks 陣列、每項是物件且有 argv，B-620）。任務是 inst 的超集；id、kind 可省（沒寫 id 時 id 是陣列位置字串，P-202）；沒有 user（inst 頂層沒有，2026-10-01 撤回），寫了照陌生鍵。不認得的鍵照收、核心忽略（P-007），group、needs、methods 都當陌生鍵。id 是否重複不驗（默認不重複）。",
  "type": "object",
  "required": [
    "_metainfo",
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Task"
          },
          {
            "type": "object",
            "properties": {
              "$ref": {
                "type": "string"
              },
              "$at": {
                "type": "string"
              }
            },
            "required": [
              "$ref"
            ]
          }
        ]
      }
    },
    "_metainfo": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ]
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID",
          "description": "可省；沒寫時 id＝它在 tasks 陣列的位置轉字串（P-202、B-620）"
        },
        "kind": {
          "description": "可省（B-620、B-626）。system／kernel／agent／custom，或〔暫定〕自訂的「類別.名稱」，類別限 kernel／agent／custom；system 標記系統級任務、不開放自訂。只是標記，核心不看，不驗順序。",
          "anyOf": [
            {
              "enum": [
                "system",
                "kernel",
                "agent",
                "custom"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:kernel|agent|custom)\\.[a-z][a-z0-9_-]*$(?![\\s\\S])"
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "node-inst.schema.json#/$defs/Inst"
        }
      ]
    }
  }
}
