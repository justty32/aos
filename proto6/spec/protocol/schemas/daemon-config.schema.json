{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 啟動設定（P-101）；持久檔，不認得的欄位忽略（C-07）",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "common_user": {
      "$ref": "daemon-registration.schema.json#/$defs/User"
    },
    "socket_path": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "shutdown_grace_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "cgroup_root": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "create_cgroup": {
      "type": "boolean",
      "default": false,
      "description": "true＝cgroup 子樹不在時 daemon 自己建（同 --create-cgroup）；此時 cgroup_root 必填（B-605）"
    },
    "disable": {
      "type": "array",
      "items": {
        "enum": [
          "quota"
        ]
      },
      "uniqueItems": true
    },
    "roots": {
      "type": "array",
      "items": {
        "$ref": "daemon-registration.schema.json#/$defs/TopRegistrationOpen"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "state_dir": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "pause_save_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "default": 1000
    },
    "stop_mode": {
      "enum": [
        "immediate",
        "drain"
      ],
      "default": "immediate",
      "description": "SIGINT／SIGTERM 走立即停或排空停（B-604）"
    },
    "drain_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 600000
    },
    "kill_escape_cgroups": {
      "type": "boolean",
      "default": false,
      "description": "重啟與解除登記時要不要一併收尾 node 自開的子框（B-605）"
    },
    "mount_diag_max": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 1024,
      "description": "掛載行程的診斷最多留幾筆，0＝不留（B-610）"
    },
    "mount_diag_ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 86400000,
      "description": "掛載行程的診斷結束後留多久（B-610）"
    }
  },
  "required": [
    "version",
    "socket_path",
    "state_dir",
    "roots"
  ],
  "if": {
    "properties": {
      "create_cgroup": {
        "const": true
      }
    },
    "required": [
      "create_cgroup"
    ]
  },
  "then": {
    "required": [
      "cgroup_root"
    ]
  }
}
