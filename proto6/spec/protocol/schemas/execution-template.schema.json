{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-401 ExecTemplate",
  "description": "〔建議預設，未拍板〕A-401 工具執行模板；A-402 委託 owner 從可信 claim 補入，不接受 owner 或 stdin 欄位。",
  "$ref": "#/$defs/ExecTemplate",
  "$defs": {
    "ExecTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "argv"
      ],
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "type": "string",
              "pattern": "^[^\\u0000]*$",
              "minLength": 1
            }
          ],
          "items": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "cwd": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$",
          "description": "省略時採本次 tick 固定設定 bundle 的 cwd；不能以 null 代省略。"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "anyOf": [
                {
                  "enum": [
                    "HOME",
                    "TMPDIR"
                  ]
                },
                {
                  "pattern": "[^A-Za-z0-9_]"
                }
              ]
            }
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          },
          "default": {},
          "description": "僅套用於降權後工作；HOME/TMPDIR 不可覆寫。loader env、憑證與控制通道排除仍須語意驗證。"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000,
          "default": 60000
        },
        "output_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216,
          "default": 1048576
        }
      }
    }
  }
}
