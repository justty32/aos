{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aos-daemon 訊息模組的一行 JSON（P-125）：請求或回應",
  "description": "每扇門（modules.mq 的每個 socket）都一樣：一連線一請求，客戶端送一行請求、daemon 回一行回應。請求與回應分開驗：請求用 #/$defs/Request、回應用 #/$defs/Reply（根只是兩者擇一的總覽）。請求不認得的欄位照收不理（照控制模組 P-121）。〔第二十五批〕信＝send 的值原樣，daemon 不加任何欄位；舊的 msg、from、from_socket、urgent、broadcast、channel、to 篩選、delivered 都拿掉了（請求帶了照不認得的欄位忽略）。",
  "anyOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Reply"
    }
  ],
  "$defs": {
    "Inst": {
      "type": "string",
      "description": "inst 字面值，跟設定檔 insts 的鍵逐字比對"
    },
    "Request": {
      "type": "object",
      "description": "send、take、peek 剛好出現一個；其他欄位照收不理",
      "properties": {
        "send": {
          "description": "〔第二十五批〕信本身：任何 JSON 值（含 null）。放進訂了這扇門的每一項的信箱、叫醒它們"
        },
        "take": {
          "$ref": "#/$defs/Inst",
          "description": "取走這一項全部的信；daemon 不核對是誰來取"
        },
        "peek": {
          "$ref": "#/$defs/Inst",
          "description": "看這一項全部的信，不取走"
        }
      },
      "oneOf": [
        {
          "required": [
            "send"
          ]
        },
        {
          "required": [
            "take"
          ]
        },
        {
          "required": [
            "peek"
          ]
        }
      ]
    },
    "Reply": {
      "type": "object",
      "required": [
        "ok"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/Ok"
        },
        {
          "$ref": "#/$defs/Taken"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    },
    "Ok": {
      "description": "寄成功（含沒人訂這扇門：信丟掉、照樣成功）；第二十五批起不帶 delivered",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "messages"
            ]
          },
          {
            "required": [
              "error"
            ]
          },
          {
            "required": [
              "delivered"
            ]
          }
        ]
      }
    },
    "Taken": {
      "description": "take／peek 成功：每個元素就是當初寄的 JSON 原樣，先寄的在前；take 取走、peek 不取；沒信是空陣列",
      "type": "object",
      "required": [
        "ok",
        "messages"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "messages": {
          "type": "array",
          "items": {
            "description": "一封信：任何 JSON 值"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "ok",
        "error",
        "detail"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "enum": [
            "unknown_inst",
            "bad_request"
          ]
        },
        "detail": {
          "type": "string",
          "description": "unknown_inst 是那個 inst 字面值；bad_request 是白話說明"
        }
      }
    }
  }
}
