{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "aos-daemon 訊息模組的一行 JSON（P-125）：請求或回應",
  "description": "一連線一請求：客戶端送一行請求、daemon 回一行回應。請求與回應分開驗：請求用 #/$defs/Request、回應用 #/$defs/Reply（根只是兩者擇一的總覽）。請求不認得的欄位照收不理（照控制模組 P-121）。",
  "anyOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Reply"
    }
  ],
  "$defs": {
    "Inst": {
      "type": "string",
      "description": "inst 字面值，跟設定檔 insts 的鍵逐字比對"
    },
    "Request": {
      "type": "object",
      "description": "send、take、peek 剛好出現一個；其他欄位照收不理。msg、from_socket、urgent 只在 send 時看；from 在 send 是寄件 inst（字串或 null），在 take／peek 是寄件人篩選（非空陣列，元素字串或 null）",
      "properties": {
        "send": {
          "$ref": "#/$defs/Inst"
        },
        "take": {
          "$ref": "#/$defs/Inst"
        },
        "peek": {
          "$ref": "#/$defs/Inst"
        }
      },
      "oneOf": [
        {
          "required": [
            "send"
          ]
        },
        {
          "required": [
            "take"
          ]
        },
        {
          "required": [
            "peek"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "send"
            ]
          },
          "then": {
            "required": [
              "msg"
            ],
            "properties": {
              "msg": {
                "description": "信的內容，任何 JSON 值（含 null）；daemon 不看"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null,
                "description": "寄件 inst；原樣存、不核對"
              },
              "from_socket": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null,
                "description": "〔第二十一批〕寄件方 daemon 的訊息 socket 路徑（aos-mq send 填絕對路徑）；原樣存、不核對，收件方回信用（跨 daemon＝前綴是對方 socket 路徑）"
              },
              "urgent": {
                "type": "boolean",
                "default": false,
                "description": "放進信箱後叫醒收件那一項（照 wake 不帶選項）"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "take"
                ]
              },
              {
                "required": [
                  "peek"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "from": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": "只要寄件人在陣列裡的信（null＝寄件人是 null 的信）；省略＝全部（第十五批）"
              }
            }
          }
        }
      ]
    },
    "Message": {
      "type": "object",
      "required": [
        "from",
        "from_socket",
        "msg"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_socket": {
          "type": [
            "string",
            "null"
          ],
          "description": "寄件方的訊息 socket；寄的時候沒帶就是 null（第二十一批）"
        },
        "msg": {}
      }
    },
    "Reply": {
      "type": "object",
      "required": [
        "ok"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/Ok"
        },
        {
          "$ref": "#/$defs/Taken"
        },
        {
          "$ref": "#/$defs/Error"
        }
      ]
    },
    "Ok": {
      "description": "send 成功",
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        }
      },
      "required": [
        "ok"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "messages"
            ]
          },
          {
            "required": [
              "error"
            ]
          }
        ]
      }
    },
    "Taken": {
      "description": "take／peek 成功：信照先進先出；take 取走、peek 不取；沒信是空陣列",
      "type": "object",
      "required": [
        "ok",
        "messages"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "required": [
        "ok",
        "error",
        "detail"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "enum": [
            "unknown_inst",
            "bad_request"
          ]
        },
        "detail": {
          "type": "string",
          "description": "unknown_inst 是那個 inst 字面值；bad_request 是白話說明"
        }
      }
    }
  }
}
