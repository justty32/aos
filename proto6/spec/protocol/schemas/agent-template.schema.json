{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-template.schema.json",
  "title": "proto6 agent-template",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "node_id": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "files": {
      "type": "object",
      "properties": {
        ".aos/inst.json": {
          "$ref": "node-inst.schema.json"
        },
        "config/agent.json": {
          "$ref": "agent-config.schema.json"
        },
        "config/tools.json": {
          "$ref": "agent-tools.schema.json"
        },
        ".gitignore": {
          "type": "string"
        },
        ".aos/tasks.json": {
          "$ref": "agent-tasks.schema.json"
        },
        "config/clean.json": {
          "$ref": "ops-clean-config.schema.json"
        }
      },
      "required": [
        ".aos/inst.json",
        ".aos/tasks.json",
        "config/agent.json",
        "config/tools.json",
        ".gitignore",
        "config/clean.json"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "node_id",
    "files"
  ],
  "additionalProperties": false
}
