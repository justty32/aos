{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-config-state.schema.json",
  "title": "proto6 agent-config-state",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "issue": {
      "anyOf": [
        {
          "$ref": "ops-attention.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "issue"
  ],
  "additionalProperties": false
}
