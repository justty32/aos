{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-messages",
  "description": "proto6 協議篇 llm.md：建議預設，未拍板；授權、引用與狀態轉移另作語意驗證。",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Message"
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ToolDefinition"
      }
    },
    "extensions": {
      "type": "object",
      "default": {}
    }
  },
  "required": [
    "version",
    "messages"
  ],
  "additionalProperties": false,
  "$defs": {
    "Message": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "role": {
              "enum": [
                "system",
                "user"
              ]
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "content"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/AssistantMessage"
        },
        {
          "type": "object",
          "properties": {
            "role": {
              "const": "tool"
            },
            "tool_call_id": {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "role",
            "tool_call_id",
            "content"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AssistantMessage": {
      "type": "object",
      "properties": {
        "role": {
          "const": "assistant"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "minItems": 1
        }
      },
      "required": [
        "role",
        "content"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "content": {
                "type": "null"
              }
            },
            "required": [
              "content"
            ]
          },
          "then": {
            "required": [
              "tool_calls"
            ]
          }
        }
      ]
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "control-common.schema.json#/$defs/ID"
        },
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            "arguments": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "arguments"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "ToolDefinition": {
      "type": "object",
      "properties": {
        "type": {
          "const": "function"
        },
        "function": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "control-common.schema.json#/$defs/ID"
            },
            "description": {
              "type": "string"
            },
            "parameters": {
              "allOf": [
                {
                  "$ref": "agent-tools.schema.json#/$defs/ToolSchema"
                },
                {
                  "properties": {
                    "type": {
                      "const": "object"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "name",
            "description",
            "parameters"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "function"
      ],
      "additionalProperties": false
    },
    "ProviderRequest": {
      "type": "object",
      "description": "openai-chat-v1 送往 provider 的 HTTP body，非 aos 持久 envelope，故不加 version。",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Message"
          }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          }
        },
        "stream": {
          "const": false
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "model",
        "messages",
        "stream"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "max_tokens"
          ],
          "not": {
            "required": [
              "max_completion_tokens"
            ]
          }
        },
        {
          "required": [
            "max_completion_tokens"
          ],
          "not": {
            "required": [
              "max_tokens"
            ]
          }
        }
      ]
    }
  }
}
