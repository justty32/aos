{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "target_node": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "message": {
      "$ref": "msg-file-rpc.schema.json"
    },
    "alarm_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "可選鬧鐘：投出後這麼多毫秒，原件仍在對方收件區就報 request_not_handled（P-206）"
    }
  },
  "required": [
    "version",
    "target_node",
    "message"
  ],
  "additionalProperties": false
}
