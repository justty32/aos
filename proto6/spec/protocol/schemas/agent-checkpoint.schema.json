{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-checkpoint",
  "$comment": "〔建議預設，未拍板〕依 agent-state.md；schema 僅驗形狀，owner、摘要、權限與提交原子性另驗。",
  "$ref": "#/$defs/Checkpoint",
  "$defs": {
    "Checkpoint": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "invalid_response_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "continuation_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "invalid_response_count"
      ],
      "additionalProperties": false
    },
    "Continuation": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "selected_context_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ref": {
          "anyOf": [
            {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "selected_context_ref",
        "decision_ref",
        "source_refs"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "selected_context_ref": {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            }
          }
        },
        {
          "properties": {
            "decision_ref": {
              "$ref": "control-common.schema.json#/$defs/BlobRef"
            }
          }
        }
      ]
    },
    "Decision": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "kind": {
          "enum": [
            "prepare_llm",
            "prepare_tools",
            "prepare_output"
          ]
        },
        "content_ref": {
          "$ref": "control-common.schema.json#/$defs/BlobRef"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "control-common.schema.json#/$defs/BlobRef"
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "kind",
        "content_ref",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "ToolCallCandidates": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "agent-tools.schema.json#/$defs/ToolCall"
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "calls"
      ],
      "additionalProperties": false
    },
    "ContextDecoded": {
      "$ref": "agent-content.schema.json#/$defs/Context"
    },
    "LLMDecisionDecoded": {
      "$ref": "llm-request.schema.json"
    },
    "OutputDecisionDecoded": {
      "$ref": "agent-output.schema.json"
    }
  }
}
