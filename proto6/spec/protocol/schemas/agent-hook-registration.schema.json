{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "單一 tick pre/post 掛勾登記",
  "$comment": "單一掛勾登記；agent/system scope 由可信外層容器決定。name 在所屬登記內唯一，排序按 order 再 name。timeout_ms 的安全數值上界為 B-101 建議上界，總 deadline 接縫見正文待決。",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "$ref": "control-common.schema.json#/$defs/ID"
    },
    "when": {
      "enum": [
        "pre",
        "post"
      ]
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\u0000"
          }
        }
      ],
      "items": {
        "type": "string",
        "not": {
          "pattern": "\u0000"
        }
      }
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000,
      "default": 30000
    },
    "on_failure": {
      "enum": [
        "continue",
        "skip_tick"
      ],
      "default": "continue",
      "description": "只對 pre 有效；post 失敗僅記錄。"
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "default": 0
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "name",
    "when",
    "argv"
  ],
  "additionalProperties": false
}
