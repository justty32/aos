{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-history.schema.json",
  "title": "proto6 agent-history",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "input_id": {
      "$ref": "common.schema.json#/$defs/ID"
    },
    "at_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\u0000]+(?:/[^/\\u0000]+)*$(?![\\s\\S])",
      "not": {
        "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
      }
    },
    "message": {
      "$ref": "llm-messages.schema.json#/$defs/message"
    },
    "in_reply_to": {
      "$ref": "common.schema.json#/$defs/ID"
    }
  },
  "required": [
    "version",
    "id",
    "seq",
    "input_id",
    "at_ms",
    "source_path",
    "message"
  ],
  "additionalProperties": false
}
