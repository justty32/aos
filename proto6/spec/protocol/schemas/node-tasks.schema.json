{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-tasks.schema.json",
  "title": "node 任務註冊表",
  "description": ".aos/tasks.json；整份 $ref 展開後再驗證 Task，含唯一 id、前置依賴與禁止 user（C-07 永遠禁止鍵）。不認得的欄位忽略（P-007）。",
  "type": "object",
  "required": [
    "_metainfo",
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Task"
          },
          {
            "type": "object",
            "properties": {
              "$ref": {
                "type": "string"
              },
              "$at": {
                "type": "string"
              },
              "user": false
            },
            "required": [
              "$ref"
            ]
          }
        ]
      }
    },
    "_metainfo": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ]
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "kind": {
          "description": "B-620：system／kernel／agent／custom，或〔暫定〕自訂的「類別.名稱」，類別限 kernel／agent／custom；system 不開放自訂。",
          "anyOf": [
            {
              "enum": [
                "system",
                "kernel",
                "agent",
                "custom"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:kernel|agent|custom)\\.[a-z][a-z0-9_-]*$(?![\\s\\S])"
            }
          ]
        },
        "group": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "uniqueItems": true
        },
        "methods": {
          "description": "本任務處理的檔案請求 method（P-202）；同一 method 不能由兩項任務宣告，跨項唯一性由 tick 驗。",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Method"
          }
        },
        "user": false
      },
      "allOf": [
        {
          "$ref": "node-inst.schema.json#/$defs/Inst"
        }
      ]
    },
    "Method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$(?![\\s\\S])"
    }
  }
}
