{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-tasks.schema.json",
  "title": "node 任務註冊表",
  "description": ".aos/tasks.json；整份 $ref 展開後再驗證 Task，含唯一 id、前置依賴與禁止 user。",
  "type": "object",
  "required": [
    "_metainfo",
    "tasks"
  ],
  "additionalProperties": false,
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Task"
          },
          {
            "type": "object",
            "properties": {
              "$ref": {
                "type": "string"
              },
              "$at": {
                "type": "string"
              }
            },
            "required": [
              "$ref"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "_metainfo": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ],
      "additionalProperties": false
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "kind": {
          "enum": [
            "system",
            "kernel",
            "agent",
            "custom"
          ]
        },
        "group": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "needs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "$ref": "node-inst.schema.json#/$defs/Inst"
        }
      ],
      "not": {
        "required": [
          "user"
        ]
      }
    }
  }
}
