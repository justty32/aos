{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node-tasks.schema.json",
  "title": "node 任務註冊表",
  "description": ".aos/tasks.json；整份 $ref 展開後再驗證 Task，含唯一 id。任務是 inst 的超集，可帶 user（第十九批；第二十批：跟 tick 帳號不同時那一項回 125，要切帳號包 aos-as，B-620）。核心只看 id、inst 部分與 user，kind 與 methods 由系統級任務讀。第二十批撤 group、needs（組由存檔點界定、前置改用 aos-needs，B-621）；舊表寫了照不認得的欄位忽略（P-007）。",
  "type": "object",
  "required": [
    "_metainfo",
    "tasks"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/Task"
          },
          {
            "type": "object",
            "properties": {
              "$ref": {
                "type": "string"
              },
              "$at": {
                "type": "string"
              }
            },
            "required": [
              "$ref"
            ]
          }
        ]
      }
    },
    "_metainfo": {
      "type": "object",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ]
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "kind": {
          "description": "B-620、B-626：system／kernel／agent／custom，或〔暫定〕自訂的「類別.名稱」，類別限 kernel／agent／custom；system 標記系統級任務、不開放自訂。只是標記，核心不看，不驗順序。",
          "anyOf": [
            {
              "enum": [
                "system",
                "kernel",
                "agent",
                "custom"
              ]
            },
            {
              "type": "string",
              "pattern": "^(?:kernel|agent|custom)\\.[a-z][a-z0-9_-]*$(?![\\s\\S])"
            }
          ]
        },
        "methods": {
          "description": "本任務處理的檔案請求 method（P-202）；同一 method 不能由兩項任務宣告，跨項唯一性由收件任務 aos-inbox 驗（B-623）。",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Method"
          }
        }
      },
      "allOf": [
        {
          "$ref": "node-inst.schema.json#/$defs/Inst"
        }
      ]
    },
    "Method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$(?![\\s\\S])"
    }
  }
}
