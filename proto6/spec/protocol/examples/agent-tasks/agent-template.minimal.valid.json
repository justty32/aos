{
  "version": 1,
  "node_id": "/srv/aos/a",
  "files": {
    ".aos/inst.json": {
      "user": 1000,
      "argv": [
        "aos-tick"
      ],
      "stderr": {
        "$opt": "inherit"
      }
    },
    "config/agent.json": {
      "version": 1,
      "llm": {
        "target_node": "/srv/aos/top",
        "pool": "local",
        "model": "example-model",
        "max_completion_tokens": 1024,
        "timeout_ms": 60000,
        "context_tokens": 16384
      },
      "system_prompt": "請用繁體中文清楚回答；需要工具時先呼叫工具。",
      "tools_file": "config/tools.json",
      "tools": {
        "target_node": "/srv/aos/top"
      },
      "daemon_socket": "/run/user/1000/aos.sock"
    },
    "config/tools.json": {
      "version": 1,
      "tools": []
    },
    ".gitignore": "/requests/\n/responses/\n/work/\n/.aos/jobs/\n/.aos/summary/published.json\n/.aos/attention/\n",
    ".aos/tasks.json": {
      "_metainfo": {
        "_type": "aos-tasks",
        "_version": 1
      },
      "tasks": [
        {
          "_metainfo": {
            "_type": "posix",
            "_version": 1
          },
          "argv": [
            "aos-agent-step"
          ],
          "id": "agent",
          "kind": "agent",
          "stderr": {
            "$opt": "inherit"
          }
        }
      ]
    }
  }
}
