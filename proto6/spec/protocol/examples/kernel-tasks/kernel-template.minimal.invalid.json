{
  "version": 1,
  "node_id": "/srv/aos/top",
  "files": {
    ".aos/inst.json": {
      "_metainfo": {
        "_type": "posix",
        "_version": 1
      },
      "user": 1000,
      "argv": [
        "aos-tick"
      ],
      "stderr": {
        "$opt": "inherit"
      }
    },
    "config/kernel.json": {
      "version": 1,
      "daemon_socket": "/run/user/1000/aos.sock",
      "scan_interval_ms": 60000,
      "scan_batch_limit": 64,
      "usage_max_age_ms": 60000,
      "max_active_members": 64
    },
    "config/members.json": {
      "version": 1,
      "revision": 1,
      "members": []
    },
    "config/llm-routes.json": {
      "version": 1,
      "routes": []
    },
    "config/llm-pools.json": {
      "version": 1,
      "pools": [
        {
          "id": "local",
          "endpoint": "http://127.0.0.1:1234/v1",
          "model": "example-model",
          "quota_scope": "local-account",
          "max_attempts": 3
        }
      ]
    },
    "config/llm-limits.json": {
      "version": 1,
      "scopes": [
        {
          "quota_scope": "local-account",
          "concurrent_requests": 1,
          "window_ms": 60000,
          "requests_per_window": 60,
          "tokens_per_window": 60000
        }
      ]
    },
    "config/clean.json": {
      "version": 1,
      "mode": "archive",
      "archive_dir": "archive",
      "retention_ms": 2592000000,
      "batch_limit": 64
    },
    ".gitignore": "/requests/\n/responses/\n/work/\n/.aos/jobs/\n/.aos/summary/published.json\n"
  }
}
