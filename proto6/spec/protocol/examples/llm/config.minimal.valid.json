{
  "version": 1,
  "config_revision": "llm_cfg_1",
  "control_uid": 900,
  "service_uid": 901,
  "service_gid": 901,
  "state_root": "/var/lib/aos-llm",
  "max_concurrent_http": 4,
  "memory_max_bytes": 268435456,
  "cpu_quota_us": 100000,
  "cpu_period_us": 100000,
  "uncertain_hold_ms": 60000,
  "remote_concurrency_policy": "estimated_release",
  "response_limit_bytes": 16777216,
  "stop_grace_ms": 8000,
  "scopes": [
    {
      "scope_id": "account_1",
      "max_concurrent": 1,
      "window_ms": 60000,
      "request_limit": 20,
      "token_limit": 10000
    }
  ],
  "credentials": [
    {
      "credential_id": "cred_1",
      "source": "service_file",
      "path": "/run/credentials/aos-llm/provider_key"
    }
  ],
  "endpoints": [
    {
      "endpoint_id": "ep_1",
      "base_url": "https://provider.example/v1",
      "credential_ref": "cred_1",
      "scope_ids": [
        "account_1"
      ],
      "adapter_revision": "openai-chat-v1",
      "estimator_revision": "estimator_1",
      "rate_accounting_revision": "reserved-window-v1",
      "models": [
        {
          "model": "small",
          "provider_model": "provider-small",
          "input_token_limit": 4096,
          "output_token_reserve": 16,
          "output_token_field": "max_tokens"
        }
      ]
    }
  ]
}
