{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 登記、掛載與佈建授權（P-101、P-104、P-118）；Open 字尾給持久檔（設定、state.json 等），其餘嚴格",
  "$defs": {
    "User": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      ]
    },
    "GrantItem": {
      "description": "身分額度的一項：確切名稱、UID、前綴或 UID 範圍（B-606）",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "daemon-registration.schema.json#/$defs/User"
            },
            {
              "not": {
                "enum": [
                  0,
                  "root"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prefix"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "uid_min": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            },
            "uid_max": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "uid_min",
            "uid_max"
          ],
          "description": "uid_min ≤ uid_max 由程式核對（B-606）",
          "additionalProperties": false
        }
      ]
    },
    "GrantItemOpen": {
      "description": "身分額度的一項：確切名稱、UID、前綴或 UID 範圍（B-606）",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "daemon-registration.schema.json#/$defs/User"
            },
            {
              "not": {
                "enum": [
                  0,
                  "root"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prefix"
          ]
        },
        {
          "type": "object",
          "properties": {
            "uid_min": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            },
            "uid_max": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "uid_min",
            "uid_max"
          ],
          "description": "uid_min ≤ uid_max 由程式核對（B-606）"
        }
      ]
    },
    "IdentityGrant": {
      "type": "array",
      "items": {
        "$ref": "daemon-registration.schema.json#/$defs/GrantItem"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "IdentityGrantOpen": {
      "type": "array",
      "items": {
        "$ref": "daemon-registration.schema.json#/$defs/GrantItemOpen"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "GroupItem": {
      "description": "群組授權的一項：確切名稱或前綴（B-609）",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prefix"
          ],
          "additionalProperties": false
        }
      ]
    },
    "GroupItemOpen": {
      "description": "群組授權的一項：確切名稱或前綴（B-609）",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "prefix"
          ]
        }
      ]
    },
    "ProvisionGrant": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "account_create",
              "chown",
              "cgroup_limits",
              "quota",
              "group_create",
              "group_add_member",
              "chgrp"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NodeId"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "daemon-registration.schema.json#/$defs/GroupItem"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "actions",
        "paths"
      ],
      "additionalProperties": false
    },
    "ProvisionGrantOpen": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "account_create",
              "chown",
              "cgroup_limits",
              "quota",
              "group_create",
              "group_add_member",
              "chgrp"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/NodeId"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "daemon-registration.schema.json#/$defs/GroupItemOpen"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "actions",
        "paths"
      ]
    },
    "TopRegistration": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "$ref": "daemon-registration.schema.json#/$defs/IdentityGrant"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrant"
        }
      },
      "required": [
        "node_id",
        "identity_grant"
      ],
      "additionalProperties": false
    },
    "TopRegistrationOpen": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "$ref": "daemon-registration.schema.json#/$defs/IdentityGrantOpen"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrantOpen"
        }
      },
      "required": [
        "node_id",
        "identity_grant"
      ]
    },
    "RegistrationOpen": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "$ref": "daemon-registration.schema.json#/$defs/IdentityGrantOpen"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrantOpen"
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/NodeId",
          "description": "有效上層（B-606）。可省：省略＝看資料夾包含推得的上層；帶了就是覆蓋，新舊兩個上層都要同意；舊上層沒在這個 daemon 登記時只要新上層同意。"
        }
      },
      "required": [
        "node_id",
        "identity_grant"
      ],
      "description": "Registration 的開放版，給持久檔引用（例如 kernel-sync-state）；不認得的欄位忽略（C-07）"
    },
    "RegistrationBody": {
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "identity_grant": {
          "$ref": "daemon-registration.schema.json#/$defs/IdentityGrant"
        },
        "interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "provision": {
          "$ref": "daemon-registration.schema.json#/$defs/ProvisionGrant"
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/NodeId",
          "description": "有效上層（B-606）。可省：省略＝看資料夾包含推得的上層；帶了就是覆蓋，新舊兩個上層都要同意；舊上層沒在這個 daemon 登記時只要新上層同意。"
        }
      },
      "required": [
        "node_id",
        "identity_grant"
      ]
    },
    "RegisterParams": {
      "description": "node.register 的 params：登記內容外加可省的通道憑證（B-612）",
      "allOf": [
        {
          "$ref": "daemon-registration.schema.json#/$defs/RegistrationBody"
        },
        {
          "properties": {
            "token": {
              "$ref": "daemon-registration.schema.json#/$defs/Token"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "Token": {
      "description": "tick–daemon 通道的本格憑證：128 位元隨機值，32 個小寫 hex（P-117）",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$(?![\\s\\S])"
    },
    "MountRecord": {
      "description": "掛載行程交給 helper 的登記內容（B-613）；上層已由 daemon 解出",
      "type": "object",
      "properties": {
        "node_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "parent_id": {
          "$ref": "common.schema.json#/$defs/NodeId"
        },
        "mount": {
          "const": true
        }
      },
      "required": [
        "node_id",
        "parent_id",
        "mount"
      ],
      "additionalProperties": false
    },
    "BoundRegistration": {
      "description": "daemon 交給 helper bind 的非頂層登記：有效上層已解出，所以 parent_id 必填（P-108）",
      "allOf": [
        {
          "$ref": "daemon-registration.schema.json#/$defs/RegistrationBody"
        },
        {
          "required": [
            "parent_id"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "$ref": "#/$defs/RegisterParams"
}
