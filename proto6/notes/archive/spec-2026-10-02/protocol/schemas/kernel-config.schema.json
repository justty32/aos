{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-config",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "daemon_socket": {
      "$ref": "common.schema.json#/$defs/NodeId",
      "description": "可省（P-801）：沒有通道時找 daemon 用的 socket 絕對路徑；省略時讀 AOS_DAEMON_SOCKET。本格有 AOS_TICK_TOKEN 時一律用環境變數的 socket。"
    },
    "scan_interval_ms": {
      "type": "integer",
      "minimum": 1
    },
    "scan_batch_limit": {
      "type": "integer",
      "minimum": 1
    },
    "usage_max_age_ms": {
      "type": "integer",
      "minimum": 1
    },
    "max_active_members": {
      "type": "integer",
      "minimum": 1
    },
    "member_stale_ms": {
      "description": "叫醒後多久沒完成新的一格就寫一件失聯事項（S-206）；預設 600000。",
      "type": "integer",
      "minimum": 1
    },
    "quota_file": {
      "$ref": "common.schema.json#/$defs/NodeId"
    }
  },
  "required": [
    "version"
  ]
}
