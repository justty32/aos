{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "target_node": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "message": {
      "$ref": "msg-file-rpc.schema.json"
    },
    "alarm_ticks": {
      "$ref": "common.schema.json#/$defs/Ticks",
      "description": "〔第二十批，取代 alarm_ms〕可選鬧鐘：投出後本 node 再過這麼多格，原件仍在對方收件區就報 request_not_handled（P-206、B-624）"
    },
    "channel": {
      "type": "boolean",
      "description": "〔第十九批〕true：本格有通道時改經 daemon 送（B-624）；預設 false"
    },
    "urgent": {
      "type": "boolean",
      "description": "〔第十九批〕急件：送到時 daemon 叫醒收件 tick；只在 channel:true 時可寫 true（P-206）"
    }
  },
  "required": [
    "version",
    "target_node",
    "message"
  ],
  "if": {
    "properties": {
      "urgent": {
        "const": true
      }
    },
    "required": [
      "urgent"
    ]
  },
  "then": {
    "properties": {
      "channel": {
        "const": true
      }
    },
    "required": [
      "channel"
    ]
  }
}
