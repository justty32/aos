{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "node_id",
    "observed_seq",
    "ready",
    "due_after_ticks",
    "status"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "node_id": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "observed_seq": {
      "$ref": "common.schema.json#/$defs/TickSeq",
      "description": "〔第二十批，取代 observed_at_ms〕寫這份摘要時是成員自己的第幾格（B-633）；上層只比有沒有前進，不跟自己的格數相減（P-307）"
    },
    "ready": {
      "type": "boolean"
    },
    "due_after_ticks": {
      "description": "〔第二十批，取代 due_ms；暫定，疑-10 照 a〕希望上層從讀到這一版摘要起再過幾格叫醒我，算上層的格；沒有到期事件用 null（P-307）",
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/Ticks"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "idle",
        "queued",
        "waiting_resources",
        "waiting_result",
        "running",
        "paused",
        "canceling",
        "unknown",
        "needs_attention"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "$ref": "res-usage.schema.json"
    }
  }
}
