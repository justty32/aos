{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon／helper 私有訊息（P-108；fd 數量另作運行時核對）",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.bind"
            },
            "params": {
              "type": "object",
              "properties": {
                "registration": {
                  "oneOf": [
                    {
                      "$ref": "daemon-registration.schema.json#/$defs/BoundRegistration"
                    },
                    {
                      "$ref": "daemon-registration.schema.json#/$defs/TopRegistration"
                    },
                    {
                      "$ref": "daemon-registration.schema.json#/$defs/MountRecord"
                    }
                  ]
                },
                "owner_uid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "registration",
                "owner_uid"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.unbind"
            },
            "params": {
              "type": "object",
              "properties": {
                "node_id": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                }
              },
              "required": [
                "node_id"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.start"
            },
            "params": {
              "type": "object",
              "properties": {
                "node_id": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                },
                "target_uid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "token": {
                  "$ref": "daemon-registration.schema.json#/$defs/Token"
                }
              },
              "required": [
                "node_id",
                "target_uid",
                "token"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.stop"
            },
            "params": {
              "type": "object",
              "properties": {
                "node_id": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                },
                "grace_ms": {
                  "$ref": "common.schema.json#/$defs/TimeMs"
                }
              },
              "required": [
                "node_id",
                "grace_ms"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.provision"
            },
            "params": {
              "allOf": [
                {
                  "$ref": "daemon-provision.schema.json"
                },
                {
                  "not": {
                    "properties": {
                      "action": {
                        "const": "spawn_as"
                      }
                    },
                    "required": [
                      "action"
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.spawn"
            },
            "params": {
              "type": "object",
              "properties": {
                "node_id": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                },
                "target_uid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "path": {
                  "$ref": "common.schema.json#/$defs/NodeId",
                  "description": "已核准的來源：本 node .aos/jobs/ 下 aos-as 寫的那份 inst 的絕對路徑；helper 拿它當 runner 的 --target（P-108、B-609）"
                },
                "token": {
                  "$ref": "daemon-registration.schema.json#/$defs/Token"
                },
                "frame": {
                  "type": "string",
                  "pattern": "^task-(0|[1-9][0-9]*)-[1-9][0-9]*$"
                }
              },
              "required": [
                "node_id",
                "target_uid",
                "path",
                "token"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.cgroup_setup"
            },
            "params": {
              "type": "object",
              "description": "建本 node 的 n-<h> 與 tick 框並交給目前執行帳號；只給 daemon 用（B-605、B-609）",
              "properties": {
                "node_id": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                }
              },
              "required": [
                "node_id"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcRequest"
        },
        {
          "properties": {
            "method": {
              "const": "daemon.helper.cgroup_remove"
            },
            "params": {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "common.schema.json#/$defs/NodeId"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcResponse"
        },
        {
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "$ref": "daemon-rpc.schema.json#/$defs/AckResult"
            }
          }
        }
      ]
    },
    {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/RpcResponse"
        },
        {
          "required": [
            "error"
          ]
        }
      ]
    }
  ]
}
