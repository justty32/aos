{
  "format_version": 1,
  "name": "main",
  "steps": [
    {
      "name": "prep",
      "kind": "inst",
      "inst": {"argv": ["python3", "brain.py", "prep"]},
      "then": "ask"
    },
    {
      "name": "ask",
      "kind": "inst",
      "inst": {"argv": ["aos", "deliver", "${llm_world}", "state/req.json",
                        "--sender", "${land}"]},
      "then": "wait"
    },
    {
      "name": "wait",
      "kind": "await",
      "result": "state/answer.txt",
      "then": "act"
    },
    {
      "name": "act",
      "kind": "inst",
      "inst": {"argv": ["python3", "brain.py", "act"]},
      "select": "state/next.txt",
      "then": "end"
    }
  ]
}
