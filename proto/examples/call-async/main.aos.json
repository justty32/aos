{
  "format_version": 1,
  "name": "main",
  "steps": [
    {
      "name": "ask",
      "kind": "call",
      "child": "child",
      "mode": "async",
      "clock": {"kind": "until", "until": "idle"},
      "result": "out/child-said.txt",
      "then": "wait"
    },
    {
      "name": "wait",
      "kind": "await",
      "result": "out/child-said.txt",
      "max_ticks": 5,
      "then": "print"
    },
    {
      "name": "print",
      "kind": "inst",
      "inst": {
        "argv": [
          "python3", "-c",
          "import sys; sys.stdout.write(open(sys.argv[1]).read())",
          "${land}/out/child-said.txt"
        ]
      },
      "then": "end"
    }
  ]
}
