{"description": "Search file contents with a Python regular expression, like grep -rn: one line PATH:LINE:TEXT per match. To find files by name use glob. More: aos/tools/grep.md.",
 "parameters": {"type": "object",
                "properties": {"pattern": {"type": "string", "description": "the regular expression"},
                               "path": {"type": "string", "default": ".", "description": "folder or file to search (default .)"},
                               "glob": {"type": "string", "description": "only files matching this, e.g. *.py"},
                               "fixed": {"type": "boolean", "default": false, "description": "true = plain text, not a regex"},
                               "ignore_case": {"type": "boolean", "default": false, "description": "true = ignore case"},
                               "context": {"type": "integer", "default": 0, "description": "lines around each match (0-5)"},
                               "files": {"type": "boolean", "default": false, "description": "true = only list matching files"},
                               "hidden": {"type": "boolean", "default": false, "description": "true = include names starting with ."},
                               "gitignore": {"type": "boolean", "default": true, "description": "false = include .gitignore'd files"},
                               "offset": {"type": "integer", "default": 0, "description": "first one to show (paging)"},
                               "max_matches": {"type": "integer", "default": 100, "description": "most to show"}},
                "required": ["pattern"]},
 "errors": ["ArgumentsBad", "PatternBad", "FileMissing", "ReadFailed", "WsMissing"]}
