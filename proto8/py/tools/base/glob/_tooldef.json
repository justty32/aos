{"description": "Find files by name pattern under a folder (*, **, ?; \"*.py\" matches at any depth); one path per line. To search inside files use grep. More: aos/tools/glob.md.",
 "parameters": {"type": "object",
                "properties": {"pattern": {"type": "string", "description": "e.g. *.py, src/**/*.json"},
                               "path": {"type": "string", "default": ".", "description": "folder to search under (default .)"},
                               "type": {"type": "string", "enum": ["file", "dir", "any"], "default": "file", "description": "file, dir or any"},
                               "sort": {"type": "string", "enum": ["name", "mtime"], "default": "name", "description": "name or mtime (newest first)"},
                               "hidden": {"type": "boolean", "default": false, "description": "true = include names starting with ."},
                               "gitignore": {"type": "boolean", "default": true, "description": "false = include .gitignore'd files"},
                               "offset": {"type": "integer", "default": 0, "description": "first one to show (paging)"},
                               "max_items": {"type": "integer", "default": 100, "description": "most to show"}},
                "required": ["pattern"]},
 "errors": ["ArgumentsBad", "PatternBad", "FileMissing", "FileBad", "ReadFailed", "WsMissing"]}
