#!/usr/bin/env python3
# json_get - 拿一格的值（一行緊湊 JSON）；太大只回型別與大小、請改用 json_ls
# 殼：邏輯全在 py/aos/json.py（json 工具一族，thinking 2026-11/12/json-tools）；介面看 _tooldef.json。
import os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先裡有 aos 套件（aos/__init__.py）的那層（py/ 或裝好的 lib/），再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.isfile(os.path.join(_lib, "aos", "__init__.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.isfile(os.path.join(_lib, "aos", "__init__.py")) else [])
try:
    from aos import json as aos_json  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "aos":
        raise
    _line = "%s: error: ModuleMissing %s not in the tool folder, not in py/ or lib/ above it, not on the Python path\n" % (os.path.basename(HERE), error.name)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

aos_json.main("get", directives=False)
