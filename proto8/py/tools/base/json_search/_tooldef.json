{
 "description": "Find a key and/or exact value below FILE#/POINTER (up: true = in the levels above); contains = substring; no regular expressions; 1 is not \"1\". One FILE#/POINTER per hit. More: aos/tools/json_search.json.",
 "parameters": {
  "type": "object",
  "properties": {
   "path": {
    "type": "string",
    "description": "FILE#/POINTER or FILE"
   },
   "key": {
    "type": "string",
    "description": "key name to find"
   },
   "value": {
    "description": "exact JSON value to find"
   },
   "contains": {
    "type": "boolean",
    "default": false,
    "description": "true = substring match"
   },
   "up": {
    "type": "boolean",
    "default": false,
    "description": "true = search the levels above"
   },
   "limit": {
    "type": "integer",
    "default": 200,
    "description": "most to show"
   }
  },
  "required": [
   "path"
  ]
 },
 "errors": [
  "ArgumentsBad",
  "PointerBad",
  "FileMissing",
  "FileBad",
  "PointerMissing",
  "LaunchFailed",
  "CommandFailed",
  "WsMissing"
 ]
}
