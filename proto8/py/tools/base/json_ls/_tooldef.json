{
 "description": "List the keys or indexes at FILE#/POINTER, one per line; long adds type and size, depth lists deeper. More: aos/tools/json_ls.json.",
 "parameters": {
  "type": "object",
  "properties": {
   "path": {
    "type": "string",
    "description": "FILE#/POINTER, e.g. cfg.json#/states"
   },
   "long": {
    "type": "boolean",
    "default": false,
    "description": "true = more detail"
   },
   "depth": {
    "type": "integer",
    "default": 1,
    "description": "levels to list"
   },
   "offset": {
    "type": "integer",
    "default": 0,
    "description": "first one to show (paging)"
   },
   "limit": {
    "type": "integer",
    "default": 200,
    "description": "most to show"
   }
  },
  "required": [
   "path"
  ]
 },
 "errors": [
  "ArgumentsBad",
  "PointerBad",
  "FileMissing",
  "FileBad",
  "PointerMissing",
  "LaunchFailed",
  "CommandFailed",
  "WsMissing"
 ]
}
