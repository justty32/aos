{
 "description": "json_get for several places at once: one line PATH TAB VALUE per place; one failing does not stop the others. More: aos/tools/json_multi_get.json.",
 "parameters": {
  "type": "object",
  "properties": {
   "paths": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "FILE#/POINTER each"
   },
   "max_bytes": {
    "type": "integer",
    "default": 8000,
    "description": "size limit for the printed value"
   },
   "full": {
    "type": "boolean",
    "default": false,
    "description": "true = print however big"
   }
  },
  "required": [
   "paths"
  ]
 },
 "errors": [
  "ArgumentsBad",
  "PlacesFailed",
  "PointerBad",
  "SpecBad",
  "FileMissing",
  "FileBad",
  "PointerMissing",
  "LaunchFailed",
  "CommandFailed",
  "WsMissing"
 ]
}
