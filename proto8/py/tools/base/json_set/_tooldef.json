{
 "description": "Set FILE#/POINTER to value, stored exactly as given (replace, or add the key); /- appends; parents creates missing levels. More: aos/tools/json_set.md.",
 "parameters": {
  "type": "object",
  "properties": {
   "path": {
    "type": "string",
    "description": "FILE#/POINTER, e.g. cfg.json#/states/act/next"
   },
   "value": {
    "description": "required: any JSON"
   },
   "parents": {
    "type": "boolean",
    "default": false,
    "description": "true = create missing levels"
   }
  },
  "required": [
   "path"
  ]
 },
 "errors": [
  "ArgumentsBad",
  "PointerBad",
  "FileMissing",
  "FileBad",
  "PointerMissing",
  "TargetBad",
  "ValueBad",
  "WriteFailed",
  "LaunchFailed",
  "CommandFailed",
  "WsMissing"
 ]
}
