{
 "description": "Add a new key or array item at FILE#/POINTER (/2 inserts before item 2, /- appends); never overwrites (KeyExists: use json_set). More: aos/tools/json_add.md.",
 "parameters": {
  "type": "object",
  "properties": {
   "path": {
    "type": "string",
    "description": "FILE#/POINTER"
   },
   "value": {
    "description": "required: any JSON"
   },
   "parents": {
    "type": "boolean",
    "default": false,
    "description": "true = create missing levels"
   }
  },
  "required": [
   "path"
  ]
 },
 "errors": [
  "ArgumentsBad",
  "PointerBad",
  "KeyExists",
  "FileMissing",
  "FileBad",
  "PointerMissing",
  "TargetBad",
  "ValueBad",
  "WriteFailed",
  "LaunchFailed",
  "CommandFailed",
  "WsMissing"
 ]
}
