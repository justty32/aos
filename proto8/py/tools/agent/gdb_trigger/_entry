#!/usr/bin/env python3
# gdb_trigger - aos-gdb 條件觸發器的 hook handler：讀自己小格的 trigger.json 判條件，成立（連續 times 次）時，事件還沒發生的（before_tool、before_queue）就自己不回、扣住等人放行，已經發生的就叫 aos-agent ctl pause --no-wait；兩種都留字條。
# 使用者 11-19：斷點＝「特定條件發生時，暫停loop或fsm，停下來等待檢閱」，條件主要由 hook 承載、「hook不用動」；第二版：「stop_before_tool不就是在工具開始前停下嗎？」。
#   所以這支就是一個普通 hook handler，由 aos.gdb（REPL 那邊）用 aos-agent hook add 掛上；判法、字條、計數、扣住檔都在 py/aos/gdb/trigger.py（共用）。
# 介面：stdin＝事件 JSON（event、hook、stack＝agent 的 stack、事件自己的欄）；$AOS_STACK＝這個 hook 的小格（<agent stack>/hookeds/<名>/），
#   設定 trigger.json、計數 count.json 都在那裡；字條往 <agent stack>/gdb/log.jsonl 加一行。
# hold（trigger.json 的 how）：寫 <agent stack>/gdb/hold.json（帶 token、自己的 pid），每 0.2 秒看一次放行單 gdb/release.json（token 對得上＝放行：
#   退 0、工具照原樣跑），或 ctl.json 出現比扣住時新的 resume（在 shell 下 aos-agent ctl resume）＝放行。
#   「放行但那次工具不跑」使用者 11-19 說「不該有這個方法」（線 aosgdb-verbs-1119 拿掉）：這支只退 0、什麼都不印。
#   掛的時候 timeout_ms 0（不限時）。被 TERM（agent 被 sleep、daemon 收工、rm）或 act 那一格死了（父行程換人）
#   ＝不放行、留一張 hold_ended，count.json 的 pending 留著：重跑同一個工具呼叫 id 時直接再扣住（工具始終沒跑）。
# pause：先記數、再發停、再留字條（帶 ctl.json 的 seq）。
# 條件自己壞了（sh 退 0／10 以外、py 函式丟例外）＝不算、stderr 一行 warning、記進 count.json 的 last_error；
#   這支自己壞了（讀不到設定、寫不了檔）＝stderr 一行 warning、退 0（11-21 線 top-1121-hooknew：hook 沒有 on_error 了，能攔的點與 loop 的點
#   hook 一失敗 agent 就停，所以「斷點壞了也不擋 agent」改由這支自己保證）；只有命令列用錯（給了參數、沒有 AOS_STACK）才是錯誤行、退 1。
import json, os, signal, subprocess, sys, time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))))   # 放 aos 套件的那層：py/（或裝好的 lib/）
from aos.gdb import trigger  # noqa: E402
from aos import tool_io  # noqa: E402

NAME = "gdb_trigger"
HELP = """usage: gdb_trigger < EVENT.json   (a hook handler put in place by aos.gdb; $AOS_STACK = this hook's own cell)
Read the trigger settings in $AOS_STACK/trigger.json and check the condition against the event.
When it holds (times in a row):
  how "hold" (before_tool, before_queue: the event has not happened yet): write <agent stack>/gdb/hold.json,
    append a note to <agent stack>/gdb/log.jsonl, and wait until released: gdb/release.json with the same
    token, or a newer "resume" in the agent's ctl.json (aos-agent ctl resume); then exit 0 and the tool
    (or letter) goes on as it was.
    Stopped by a signal, or its parent step died = no release; the same call is held again when it comes back.
  how "pause" (other events): append the note, then run aos-agent -d DAEMON ctl pause --no-wait AGENT.
A broken condition counts as no hit and prints one warning line.
A broken trigger (no trigger.json, a bad one, a file it cannot write) is one warning line and exit 0:
a broken breakpoint never stops the agent.
exit codes: 0 done (no hit, paused, released, or a broken trigger); 1 wrong use ("gdb_trigger: error: CODE reason").
"""
PAUSE_S = 10
POLL_S = 0.2


class Cut(Exception):
    """扣住時收到 TERM／HUP／INT：這一格被收掉了。"""


def die(code, why):
    tool_io.die(code, why, prog=NAME, echo=False)


def trigger_broken(code, why):
    """這支自己壞了（設定、寫檔）：一行 warning、退 0，不讓斷點擋住 agent。"""
    warn("%s %s (the breakpoint did nothing this time)" % (code, why))
    sys.exit(0)


def warn(text):
    sys.stderr.write("%s: warning: %s\n" % (NAME, text))
    sys.stderr.flush()


def pause(spec):
    """aos-agent ctl pause --no-wait；回 "sent" 或失敗的一句（不丟：字條照留）。"""
    argv = ["aos-agent"] + (["--daemon", spec["daemon"]] if spec.get("daemon") else []) + ["ctl", "pause", "--no-wait", spec["agent"]]
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, timeout=PAUSE_S)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "failed: %s" % e
    if p.returncode:
        last = [x for x in p.stderr.splitlines() if x.strip()]
        return "failed: %s" % (last[-1] if last else "exit %d" % p.returncode)
    return "sent"


def note_of(spec, event, count, agent_stack, kind):
    return {"kind": kind, "at": trigger.now(), "by": "hook", "trigger": event.get("hook"), "event": event.get("event"),
            "how": spec["how"], "about": spec.get("about"), "times": spec.get("times", 1), "fired": count["fired"],
            "ctl_seq": trigger.ctl_seq(agent_stack), "detail": trigger.brief(event)}


def ctl_mtime(agent_stack):
    try:
        return os.stat(os.path.join(agent_stack, "ctl.json")).st_mtime_ns
    except OSError:
        return None


def hold(event, agent_stack, token, parent, start_ns):
    """扣住，等放行（hold.json 已寫好、訊號已接好）。回 (放行了沒, 誰放的或怎麼結束的)。
    沒放行＝父行程不在；被訊號收掉＝丟 Cut。shell 的 ctl resume 只認扣住之後才寫的（ctl.json 的修改時間比扣住晚，Argon A5）。"""
    release_path = os.path.join(agent_stack, trigger.LOG_DIR, trigger.RELEASE)
    while True:
        try:
            rel = trigger.read_json(release_path)
        except (OSError, ValueError):
            rel = None
        if isinstance(rel, dict) and rel.get("token") == token:
            try:
                os.remove(release_path)
            except FileNotFoundError:
                pass
            return True, rel.get("by") or "repl"
        seq, cmd = trigger.ctl_doc(agent_stack)
        m = ctl_mtime(agent_stack)
        if cmd == "resume" and m is not None and m > start_ns:
            return True, "ctl"
        if os.getppid() != parent:
            return False, "its step is gone (the hook's parent process ended)"
        time.sleep(POLL_S)


def main():
    parent = os.getppid()                        # 一開頭就記（Argon A4：跑條件時父行程死了也認得出）
    if sys.argv[1:] in (["--help"], ["-h"]):
        sys.stdout.write(HELP)
        return
    if sys.argv[1:]:
        die("ArgumentsBad", "takes no arguments (the event JSON comes on stdin; see --help)")
    cell = os.environ.get("AOS_STACK", "")
    if not cell:
        die("StackMissing", "AOS_STACK is not set (run it as a hook: aos-exec --stack <cell>/ ...)")
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            raise ValueError("not a JSON object")
    except ValueError as e:
        die("ArgumentsBad", "the event on stdin is not JSON: %s" % e)
    spec_path, count_path = os.path.join(cell, trigger.SPEC), os.path.join(cell, trigger.COUNT)
    try:
        spec = trigger.read_json(spec_path)
        if spec is None:
            trigger_broken("SpecMissing", "no %s (put the trigger in place with aos.gdb, or remove this hook)" % spec_path)
        trigger.validate(spec)
        count = trigger.read_json(count_path, {})
    except (OSError, ValueError) as e:
        trigger_broken("SpecBad", "%s: %s" % (spec_path, e))
    count = count if isinstance(count, dict) else {}
    agent_stack = event.get("stack") or os.path.dirname(os.path.dirname(os.path.abspath(cell)))
    held = spec["how"] == "hold" and event.get("event") in trigger.HOLD_EVENTS
    key = trigger.key_of(event) if held else None
    decided = count.get("decided") if isinstance(count.get("decided"), dict) else {}
    if held and key and decided.get("key") == key:
        return                                   # 這一次已經放行過，那一格被收掉後重跑：照跑，不再扣、不再數（Argon A1、A2）
    if held and count.get("pending") and count.get("pending") != key:
        count["pending"] = None                  # 扣住被打斷的那一次沒再回來：過期了
    again = bool(held and key and count.get("pending") == key)
    if again:                                    # 上次扣住這一次時被收掉了：工具始終沒跑，直接再扣住
        hit, broken = True, None
    else:
        count, hit, broken = trigger.step(spec, count, event)
    if broken:
        warn("trigger %s: %s (counted as no hit)" % (event.get("hook"), broken))
    if not held:
        try:
            trigger.write_json(count_path, count)
            if not hit:
                return
            # 先發停、再留字條（帶 pause 實際用的 ctl seq）：hook 是同步跑在格裡的，pause 要等這一格做完 loop 才套用，
            # 所以字條一定比「表上變 paused」早寫好（Argon A4；見 08-Argon審與採納）。
            result = pause(spec)
            note = note_of(spec, event, count, agent_stack, "stop" if result == "sent" else "pause_failed")
            if result != "sent":
                note["why"] = result
                warn("trigger %s: cannot pause %s: %s" % (event.get("hook"), spec.get("agent"), result))
            trigger.append_log(agent_stack, note)
        except OSError as e:
            trigger_broken("WriteFailed", str(e))
        return
    if not hit:
        try:
            trigger.write_json(count_path, count)
        except OSError as e:
            trigger_broken("WriteFailed", str(e))
        return
    if parent == 1 or os.getppid() != parent:
        return                                   # 那一格已經不在了：不扣（扣了也沒人等）
    # ---- 扣住：先接好訊號，再寫任何東西（Argon A4）----
    def cut(signum, frame):
        raise Cut(signal.Signals(signum).name)
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, cut)
    hold_path = os.path.join(agent_stack, trigger.LOG_DIR, trigger.HOLD)
    token = "%d-%d" % (os.getpid(), time.time_ns())
    start_ns = time.time_ns()
    go, via = False, None
    try:
        try:
            count["pending"] = key
            trigger.write_json(count_path, count)
            note = note_of(spec, event, count, agent_stack, "stop")
            note.update(again=again, token=token)
            trigger.append_log(agent_stack, note)
            trigger.write_json(hold_path, {"token": token, "pid": os.getpid(), "at": trigger.now(), "trigger": event.get("hook"),
                                           "event": event.get("event"), "about": spec.get("about"), "key": key, "again": again,
                                           "ctl_seq": trigger.ctl_seq(agent_stack),
                                           "detail": trigger.brief(event)})
        except OSError as e:
            trigger_broken("WriteFailed", str(e))
        go, via = hold(event, agent_stack, token, parent, start_ns)
    except Cut as e:
        via = "the step was stopped (%s: the agent was put to sleep, removed, or its daemon stopped)" % e
    for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(s, signal.SIG_IGN)         # 收尾時不再被打斷
    # 收尾：先記數與字條（resume／hold_ended 由這裡寫，act 還在等這支，下一個 hook 還沒起），最後才刪 hold.json（Argon A2）。
    # 寫不了只 warning。
    try:
        count = trigger.read_json(count_path, count) or count
        if not go:
            if not again:
                count["fired"] = max(0, count.get("fired", 1) - 1)   # 沒放行＝這次不算（once 沒用掉；同一次回來會再扣住）
            trigger.write_json(count_path, count)
            trigger.append_log(agent_stack, {"kind": "hold_ended", "at": trigger.now(), "by": "hook", "trigger": event.get("hook"),
                                             "event": event.get("event"), "why": via, "token": token, "detail": trigger.brief(event),
                                             "next": "not released: the %s did not go on; it is held again when the agent runs it again"
                                                     % ("tool" if event.get("event") == "before_tool" else "letter")})
        else:
            if again:
                count["fired"] = count.get("fired", 0) + 1
            count["pending"] = None
            count["decided"] = {"key": key}
            trigger.write_json(count_path, count)
            trigger.append_log(agent_stack, {"kind": "resume", "at": trigger.now(), "by": via, "token": token,
                                             "trigger": event.get("hook")})
    except OSError as e:
        warn("trigger %s: cannot write %s or the note: %s" % (event.get("hook"), count_path, e))
    try:
        doc = trigger.read_json(hold_path)
        if isinstance(doc, dict) and doc.get("token") == token:
            os.remove(hold_path)
    except (OSError, ValueError):
        pass
    if not go:
        sys.exit(143 if via.startswith("the step was stopped") else 0)


if __name__ == "__main__":
    main()
