#!/usr/bin/env python3
# board_ls - aos-comm board ls 的包裝：我這張 daemon 表上每隻一行布告欄（名字、mode、doing、等誰、幾點回），最後一行計數；scope deep 再往下走有表的那幾隻。
# 圖紙：proto8/thinking/2026-11/14/board-1114/ 02 §2.5、§5.1；純包裝。介面：stdin {scope?: team|deep, only?: dnd|away|waiting|waiting_user}。結果：aos-comm 的文字原樣。
import os, signal, sys
NAME = "board_ls"
HELP = """\
usage: board_ls < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
One line per proc on my daemon table with its board (aos-comm board ls); scope deep also walks the tables below.
Result on stdout. On error: one line "board_ls: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先裡有 aos 套件（aos/__init__.py）的那層（py/ 或裝好的 lib/），再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.isfile(os.path.join(_lib, "aos", "__init__.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.isfile(os.path.join(_lib, "aos", "__init__.py")) else [])
try:
    from aos import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "aos":
        raise
    _line = "%s: error: ModuleMissing aos not in the tool folder, not in py/ or lib/ above it, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

tool_io.start(NAME, HELP)
signal.signal(signal.SIGINT, lambda s, f: sys.exit(130))
from aos.agentlib import cmd_call  # noqa: E402

cmd_call.catch_signals((signal.SIGTERM,))
args = tool_io.arguments()
scope = args.get("scope") or "team"
if scope not in ("team", "deep"):
    tool_io.die("ArgumentsBad", "scope must be team or deep, not %r" % scope)
only = args.get("only")
if only is not None and only not in ("dnd", "away", "waiting", "waiting_user"):
    tool_io.die("ArgumentsBad", "only must be one of dnd, away, waiting, waiting_user, not %r" % only)
more = ["board", "ls"] + (["--deep"] if scope == "deep" else []) + (["--only", only.replace("_", "-")] if only else [])
_, out, _ = cmd_call.call("aos-comm", more)
print("NAME\tMODE\tDOING\tWAITING FOR\tBACK")
sys.stdout.write(out if out.endswith("\n") else out + "\n")
