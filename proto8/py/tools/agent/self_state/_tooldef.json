{
  "description": "Facts and numbers about yourself; only reads. {} = one line per part; parts = details (who, state, tools, llm, system, hooks, history, mailbox, subagents, resources, time, all). More: `aos/me.md#/Looking at yourself: self_state`.",
  "env": [
    "AOS_DAEMON"
  ],
  "errors": [
    "ArgumentsBad",
    "WsMissing",
    "LaunchFailed",
    "CommandFailed",
    "DaemonMissing",
    "DaemonFailed",
    "InstanceMissing",
    "StateMissing"
  ],
  "parameters": {
    "type": "object",
    "properties": {
      "parts": {
        "type": [
          "array",
          "string"
        ],
        "items": {
          "type": "string",
          "enum": [
            "who",
            "state",
            "tools",
            "llm",
            "system",
            "hooks",
            "history",
            "mailbox",
            "subagents",
            "resources",
            "time",
            "all"
          ]
        },
        "description": "leave out for the overview"
      },
      "json": {
        "type": "boolean",
        "description": "true = JSON output"
      }
    },
    "additionalProperties": false
  }
}