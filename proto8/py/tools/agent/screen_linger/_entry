#!/usr/bin/env python3
# screen_linger - after_start 撤單、after_stop 排延後關畫面，或由 tmux 呼叫 reap 核對到期單。
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))))   # 放 aos 套件的那層：py/（或裝好的 lib/）
from aos.agentlib import cli_linger

HELP = """usage: screen_linger [reap STACK KIND TOKEN]
Without arguments, read an after_start or after_stop hook event as JSON on stdin.
Use the event's stack, not the handler's AOS_STACK. after_start cancels pending screen
closures; after_stop schedules them (cli.json screen_close_after_s, default 600).
reap is called by tmux; KIND is claude or codex. No daemon or kernel is needed.
Exit 0 on success or stale orders; as a hook (no arguments) a bad event or an I/O error is one
warning line and exit 0, so a screen problem never stops the agent's loop; reap: exit 1 on errors.
"""


def main():
    if sys.argv[1:] in (["--help"], ["-h"]):
        print(HELP, end="")
        return 0
    if len(sys.argv) == 5 and sys.argv[1] == "reap":
        cli_linger.reap(*sys.argv[2:])
        return 0
    if len(sys.argv) != 1:
        raise ValueError("expected no arguments or reap STACK KIND TOKEN")
    event = json.load(sys.stdin)
    if not isinstance(event, dict) or event.get("event") not in ("after_start", "after_stop"):
        raise ValueError("expected an after_start or after_stop event")
    stack = event.get("stack")
    if not isinstance(stack, str) or not os.path.isabs(stack):
        raise ValueError("event stack must be an absolute path")
    (cli_linger.arm if event["event"] == "after_stop" else cli_linger.cancel)(stack)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        hook = len(sys.argv) == 1                # 掛在 after_start／after_stop：失敗會讓 loop 收工（11-21 沒有 on_error 了），所以只提醒
        try:
            sys.stderr.write("screen_linger: %s %s\n" % ("warning:" if hook else "error: CommandFailed",
                                                         " ".join(str(error).splitlines())))
        except BrokenPipeError:
            pass
        sys.exit(0 if hook else 1)
