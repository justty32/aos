{
 "description": "See or change your own conversation history by line number. Ops: ls, rm a range, summarize a range into one message, set one line. The step in progress cannot be changed. ls first. More: aos/me/self_history.md.",
 "env": [
  "AOS_DAEMON"
 ],
 "errors": [
  "ArgumentsBad",
  "OpUnknown",
  "RangeBad",
  "MessageBad",
  "HistoryMissing",
  "HistoryBad",
  "InterfaceBad",
  "WriteFailed",
  "WsMissing",
  "LaunchFailed",
  "CommandFailed",
  "DaemonMissing",
  "DaemonFailed",
  "InstanceMissing"
 ],
 "parameters": {
  "type": "object",
  "properties": {
   "op": {
    "type": "string",
    "enum": [
     "ls",
     "rm",
     "summarize",
     "set"
    ],
    "description": "what to do"
   },
   "range": {
    "type": [
     "string",
     "integer"
    ],
    "description": "\"4\", \"2-5\", \"6-\" or \"-3\" (last 3)"
   },
   "all": {
    "type": "boolean",
    "description": "ls: true = every message"
   },
   "text": {
    "type": "string",
    "description": "summarize: your summary"
   },
   "role": {
    "type": "string",
    "description": "summarize: role of the new message (default user)"
   },
   "line": {
    "type": [
     "integer",
     "string"
    ],
    "description": "set: the line"
   },
   "message": {
    "type": "object",
    "description": "set: the whole new message"
   },
   "json": {
    "type": "boolean",
    "description": "ls: true = JSON output"
   },
   "long": {
    "type": "boolean",
    "description": "ls: true = full text"
   },
   "keep": {
    "type": "string",
    "description": "keep removed messages in this file"
   },
   "no_keep": {
    "type": "boolean",
    "description": "true = do not keep removed messages"
   }
  },
  "required": [
   "op"
  ]
 }
}
