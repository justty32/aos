#!/usr/bin/env python3
# board_clear - aos-comm board clear 的包裝，目標＝叫我的那隻 agent 的根（05 A2）：撕掉自己的布告欄（mode here、清文字與等待）。
# 圖紙：proto8/thinking/2026-11/14/board-1114/ 02 §5.1；純包裝。介面：stdin {}；沒有參數（別的鍵＝ArgumentsBad，tool_io 擋）。結果：寫好的整張（一行 JSON）。
import json, os, signal, sys
NAME = "board_clear"
HELP = """\
usage: board_clear < {}   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Take my board down (aos-comm board clear): mode here, no text, no waiting lines.
Result on stdout. On error: one line "board_clear: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先裡有 tool_io.py 的那層（py/ 或裝好的 lib/；含 cmd_call），再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.isfile(os.path.join(_lib, "tool_io.py")) else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in py/ or lib/ above it, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

tool_io.start(NAME, HELP)
signal.signal(signal.SIGINT, lambda s, f: sys.exit(130))
import cmd_call  # noqa: E402

cmd_call.catch_signals((signal.SIGTERM,))
tool_io.arguments()
_, out, _ = cmd_call.call("aos-comm", ["board", "clear", "-j"])
print("board taken down:")
print(json.dumps(json.loads(out), ensure_ascii=False))
