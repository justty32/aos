#!/usr/bin/env python3
# hook_fire - 發 after_start／after_stop 事件：agent 範本 loop.json 的 on_start／on_stop 叫它（hook_fire EVENT DEF_DIR，$AOS_STACK＝agent 的 stack）。
# 使用者 11-11：hook 要加的事件選「起來與停下」、掛哪層選「aos-loop 自己加」——aos-loop 只跑被指定的東西（C-52），這支才認得 hook
# （經 py/aos/agentlib/agent_hooks.py 的遙控器發，11-20 hook 介面第 2 刀；介面不變）。
# after_start 之前先 hook_clock.clock_restart（清掉 on_clock 的狀態檔：起來後第一次看時鐘就跑一次，使用者 11-11「起來就先觸發一次」）。
# after_stop 的事件 JSON 多 code（$AOS_LOOP_CODE，aos-loop 給的要退的碼）、signal（$AOS_LOOP_SIGNAL，沒有＝null）、
# cause（11-14 B7，ok-devt 定稿 2.3：$AOS_LOOP_CAUSE 去掉頭尾空白，空的或沒設＝null；值不檢查、照抄：stop、sleep、remove、shutdown、
# stuck、signal、max、body_exit、error）。撞限額沒有獨立的值，看表上的 limit_hit；error 只是停止的分類，不是錯誤代號；
# cause 跟表上的 reason 不同（reason 是給人看的一句話）。欄位名、環境變數名各只在下面定一次（CAUSE_KEY、CAUSE_ENV）。沒有這個事件的 hook＝什麼都不做、退 0。
# 錯：stderr 一行「hook_fire: error: 代號 原因」、退 1（HookFailed＝on_error stop 的 hook 失敗、HooksBad、ArgumentsBad、StackMissing）；
# aos-loop 只把它當一行 warning，不擋 agent 起停。on_error continue 的 hook 失敗＝一行 warning。--help 印英文用法。
import os, signal, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.dirname(HERE))))   # 放 aos 套件的那層：py/（或裝好的 lib/）
from aos.agentlib import agent_hooks, hook_clock  # noqa: E402
from aos import tool_io  # noqa: E402

NAME = "hook_fire"
HELP = """usage: hook_fire EVENT DEF_DIR   (EVENT: after_start | after_stop; $AOS_STACK = the agent's stack)
Fire the hooks of an agent for EVENT (the agent definition DEF_DIR, its stack copy on top).
Meant for the on_start / on_stop keys of an agent's loop.json. after_stop also gets code
($AOS_LOOP_CODE), signal ($AOS_LOOP_SIGNAL, null when none) and cause ($AOS_LOOP_CAUSE, null
when empty or unset; stop, sleep, remove, shutdown, stuck, signal, max, body_exit or error) in the
event JSON.
exit codes: 0 done (also when no hook listens); 1 error ("hook_fire: error: CODE reason").
"""
EVENTS = ("after_start", "after_stop")
CAUSE_KEY = "cause"            # after_stop 事件的欄位名（11-14 B7，ok-devt 定稿）
CAUSE_ENV = "AOS_LOOP_CAUSE"   # aos-loop 給的環境變數（同 aos/loop.hpp 的 cause_env）


def die(code, why):
    tool_io.die(code, why, prog=NAME, echo=False)   # hook：錯誤行只在 stderr（stdout 是給 hook 引擎解回話的）


def warn(line):
    tool_io.warn(line, prog=NAME)


def number(key):
    v = os.environ.get(key, "")
    return int(v) if v.lstrip("-").isdigit() else None


def cause():
    v = os.environ.get(CAUSE_ENV, "").strip()
    return v or None


def main():
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(130))
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        sys.stdout.write(HELP)
        return 0
    if len(args) != 2 or args[0] not in EVENTS:
        die("ArgumentsBad", "give EVENT (%s) and DEF_DIR (usage: hook_fire EVENT DEF_DIR)" % " or ".join(EVENTS))
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "AOS_STACK is not set")
    if args[0] == "after_start":
        try:
            hook_clock.clock_restart(stack)
        except OSError as e:
            warn("cannot reset the on_clock state in %s: %s" % (stack, e))
    data = {} if args[0] == "after_start" else {"code": number("AOS_LOOP_CODE"), "signal": number("AOS_LOOP_SIGNAL"), CAUSE_KEY: cause()}
    agent_hooks.open(args[1], stack, fail=die, warn=warn).fire(args[0], data)
    return 0


sys.exit(main())
