#!/usr/bin/env python3
"""aos-listen - 看一隻 agent 回了什麼：等一封信的回答、跟著看對話、看快照（給人用，2026-10-24；10-30 改看 stack）。

    aos-listen [--ws WS] [--stack STACK] [--timeout 秒] [--trace] 信號     等這封信的回答，印出來就退 0
    aos-listen [--ws WS] [--stack STACK] [--last N] [--trace] [--follow]   跟著看：之後每多一則回答就印一段（像 tail -f）
    aos-listen [--ws WS] [--stack STACK] --status                          快照：誰在跑、aos-loop 的 phase、最後一格、queue 幾封

只看 stack（CONVENTION P-42；thinking 2026-10-30-agent-lifecycle A-8）：
- 等一封（信號＝aos-say 印的那一行）：信還在 <stack>/queue/new/ 或 cur/ 就等；不見了就印 history.jsonl 最新那則沒有 tool_calls 的
  assistant 的 content（回答就是它，沒有 out/；先 say、後 listen 不會漏）。queue 沒這封、history 也沒有回答＝QuestionUnknown；
  等的期間看到過、信不見了 history 卻沒有回答＝AnswerMissing。每秒看一次有沒有程式在跑這隻 agent（/proc 裡 AOS_STACK＝這個 stack、
  或 AOS_WS＝這個工作區，argv[0] 是 aos-loop／aos-fsm／aos-exec／aos-daemon；或 stack 的 server.txt），沒有就在 stderr 提醒一次
  它停在哪（trace.jsonl 最後一行失敗＝「停在 <unit> 那格、結束碼 N」，round 寫 unit、fsm 寫 state）、怎麼跑起來，然後**繼續等**。
  --timeout 沒給＝一直等；Ctrl-C 離開（退 130）。
- 沒給信號：先印最後 N 段一問一答（--last N；沒給＝0 段），再跟著看新的；給了 --last 沒給 --follow＝印完就走。
  一段＝「== #第幾則回答」、問的話每行前面加「> 」、回答。
- --trace：同時把 stack 裡新長出來的 trace.jsonl（每格一行）與 history.jsonl 的工具呼叫翻成短行印到 stderr。
- --status：誰在服務、aos-loop state.json 的 phase（看得出 paused）、認領中的信、queue 各格幾封、最後一格、history 幾則。
stdout 只有回答；提醒、trace、錯都在 stderr。stack＝--stack ＞ $AOS_STACK ＞ <工作區>/.stack/；工作區＝--ws ＞ $AOS_WS ＞ cwd。
10-30 起不認工作區的 new/ out/（舊協議的 fsm 範本，P-11 的 10-30 改口）。
錯：stderr 一行 `aos-listen: 代號 原因`、退 1（ArgumentsBad、FlagUnknown、WsMissing、QuestionUnknown、AnswerMissing〔逾時、或信不見了卻沒有回答〕）。"""
import sys, time
import os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_human as h

PROG = "aos-listen"
USAGE = "aos-listen [--ws WS] [--stack STACK] [--timeout 秒] [--trace] 信號 | [--last N] [--follow] | --status"


def show_tail(tail):
    if tail:
        for line in tail.lines():
            print(line, file=sys.stderr, flush=True)


def wait_one(w, sig, timeout, tail):
    start, warned, seen, next_check = time.monotonic(), False, False, 0.0
    while True:
        stages = [s for s in h.where(w.stack, sig) if s in ("new", "cur")]
        if not stages:
            got = h.aos_ws.answers(w.stack)
            show_tail(tail)
            if got:
                sys.stdout.write(got[-1] if got[-1].endswith("\n") else got[-1] + "\n")
                sys.stdout.flush()
                return
            if seen:
                h.die(PROG, "AnswerMissing", "%s 已經不在 queue 了，history 卻沒有回答" % sig)
            h.die(PROG, "QuestionUnknown", "queue 的 new/ cur/ 都沒有 %s，history 也沒有回答" % sig)
        seen = True
        show_tail(tail)
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            if h.runners(w):
                t = h.last_trace(w)                    # 10-28：常駐的服務者（aos-hub-kernel）答這封失敗時，在 trace 留 question＋error
                bad = t and t.get("question") == sig and t.get("error") and "cur" in stages
                if bad and not warned:
                    h.note("%s 答 %s 失敗：%s。修好後讓它再收一次；我繼續等，Ctrl-C 離開" % (h.aos_ws.unit_of(t), sig, t["error"]))
                warned = bool(bad)
            elif not warned:
                h.note(h.stuck_hint(w, sig) + "。我繼續等，Ctrl-C 離開")
                warned = True
        if timeout is not None and now - start >= timeout:
            h.die(PROG, "AnswerMissing", "等了 %g 秒，%s 還沒答（信在 queue 的 %s/）" % (timeout, sig, "、".join(stages)))
        time.sleep(h.POLL)


def block(n, asked, answer):
    out = "== #%d\n" % n
    for q in asked:
        out += "".join("> %s\n" % l for l in q.rstrip("\n").splitlines())
    return out + answer + ("" if answer.endswith("\n") else "\n")


def follow(w, last, keep, tail):
    ex = h.aos_ws.exchanges(w.stack)
    seen = len(ex)
    for i in range(max(0, seen - last), seen) if last else []:
        sys.stdout.write(block(i + 1, *ex[i]))
    sys.stdout.flush()
    if not keep:
        return
    warned, next_check = False, 0.0
    while True:
        ex = h.aos_ws.exchanges(w.stack)
        if len(ex) < seen:                            # history 被 compact 換短了：從現在的尾巴接著看
            seen = len(ex)
        show_tail(tail)
        for i in range(seen, len(ex)):
            sys.stdout.write(block(i + 1, *ex[i]))
        seen = len(ex)
        sys.stdout.flush()
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            waiting = h.aos_ws.waiting(w.stack)
            if not waiting or h.runners(w):
                warned = False
            elif not warned:
                h.note("queue 裡還有 %d 封沒答（%s），但目前沒有程式在跑這隻 agent。%s。我繼續等，Ctrl-C 離開"
                       % (len(waiting), "、".join(waiting[:3]) + ("…" if len(waiting) > 3 else ""), h.run_hint(w)))
                warned = True
        time.sleep(h.POLL)


def number(opts, key, flag):
    v = opts.get(key)
    if v is None:
        return None
    try:
        n = float(v)
        if n < 0 or n != n:
            raise ValueError
    except ValueError:
        h.die(PROG, "ArgumentsBad", "usage: %s（%s 要給不小於 0 的數字：%s）" % (USAGE, flag, v))
    return n


def main():
    opts, rest = h.parse(PROG, USAGE, sys.argv[1:], {"--ws": "ws", "--stack": "stack", "--timeout": "timeout", "--last": "last"},
                         {"--trace": "trace", "--follow": "follow", "--status": "status"})
    timeout, last = number(opts, "timeout", "--timeout"), number(opts, "last", "--last")
    if len(rest) > 1:
        h.die(PROG, "ArgumentsBad", "usage: %s（信號只能一個，多給了 %s）" % (USAGE, rest[1]))
    if rest and (last is not None or opts.get("follow") or opts.get("status")):
        h.die(PROG, "ArgumentsBad", "usage: %s（給了信號就不收 --last／--follow／--status）" % USAGE)
    if opts.get("status") and (last is not None or opts.get("follow") or timeout is not None or opts.get("trace")):
        h.die(PROG, "ArgumentsBad", "usage: %s（--status 不跟別的旗標一起用）" % USAGE)
    if not rest and timeout is not None:
        h.die(PROG, "ArgumentsBad", "usage: %s（--timeout 只給等一封用）" % USAGE)
    try:
        w = h.Where(opts.get("ws"), opts.get("stack"))
    except h.Error as e:
        h.die(PROG, e.code, str(e))
    tail = h.Tail(w) if opts.get("trace") else None
    try:
        if opts.get("status"):
            print("\n".join(h.status_lines(w)))
        elif rest:
            wait_one(w, rest[0], timeout, tail)
        else:
            follow(w, int(last or 0), last is None or bool(opts.get("follow")), tail)
    except KeyboardInterrupt:
        sys.exit(130 if rest else 0)


main()
