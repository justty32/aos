#!/usr/bin/env python3
"""aos-listen - 看一隻 agent 回了什麼：等最新那封信的回答、跟著看對話（給人用，2026-10-24；10-30 改看 stack；11-02 拿掉信件名稱參數）。

    aos-listen [--ws WS] [--stack STACK] [--timeout 秒]              等最新那封信的回答，印出來就退 0（正規用法：aos-say 話 && aos-listen）
    aos-listen [--ws WS] [--stack STACK] [--last N] [--follow]       --last N＝印最後 N 段一問一答就走；--follow＝之後每多一則回答就印一段（像 tail -f）

11-03 拿掉 --status、--trace 與 LetterUnclaimed（使用者「trace.jsonl……整個拿掉」「aos-listen --status其實也是沒必要的，要看他的狀態，應該是用aos-eca status」，
thinking 2026-11-03-trace）：給 --status／--trace＝FlagUnknown。

只看 stack（CONVENTION P-42；thinking 2026-10-30-agent-lifecycle A-8）：
- 等（不帶旗標）：「最新那封」＝queue 的 new/、cur/ 裡照處理順序排最後的一封（aos_ws.letter_key 取 max：有序在前、無序在後，各照名字；
  aos-say 寄的都是有序＝最後寄出的、或剛被認領的；不管誰寄的；11-03 aos-post 改版），開始時挑一次；
  new/ cur/ 都空＝答案已經到了，直接印 history 最新那則回答（都沒有＝QuestionUnknown）。11-01 晚使用者翻案：信件名稱參數拿掉
  （thinking 2026-10-24-say-listen「11-01 晚」一節）。信還在 <stack>/queue/new/ 或 cur/ 就等；不見了就印 history.jsonl 最新那則沒有 tool_calls 的
  assistant 的 content（回答就是它，沒有 out/；先 say、後 listen 不會漏）。信不見了 history 卻沒有回答＝AnswerMissing。
  11-03 外部 coding agent（aos-eca-turn）交給 CLI 就收信、答完才接回答（thinking 2026-10-30-eca/20-11-03-交出去就收.md）：信不見了、
  history 最後一則是 user、回答也沒比開始時多＝已經交出去、還在答，接著等回答出來（開始時 new/ cur/ 就空、history 最後一則是 user 也一樣，
  不印上一則舊回答）；這時沒有程式在跑它＝AnswerMissing
  （中途掛掉的那批不會自動重答，要重答再 aos-say）。每秒看一次有沒有程式在跑這隻 agent（/proc 裡 AOS_STACK＝這個 stack、
  或 AOS_WS＝這個工作區，argv[0] 是 aos-loop／aos-fsm／aos-exec／aos-daemon；只看 /proc），沒有就在 stderr 提醒一次
  信在 queue 的哪裡、怎麼跑起來，然後**繼續等**。
  --timeout 沒給＝一直等；Ctrl-C 離開（退 130）。
- --last N／--follow：先印最後 N 段一問一答（沒給 --last＝0 段）；有 --follow 才接著跟著看新的，沒有＝印完就走。
  一段＝「== #第幾則回答」、問的話每行前面加「> 」、回答。
stdout 只有回答；提醒、錯都在 stderr。stack＝--stack ＞ $AOS_STACK ＞ <工作區>/.stack/；工作區＝--ws ＞ $AOS_WS ＞ cwd。
10-30 起不認工作區的 new/ out/（舊協議的 fsm 範本，P-11 的 10-30 改口）。
錯：stderr 一行 `aos-listen: 代號 原因`、退 1（ArgumentsBad〔含多給了位置參數〕、FlagUnknown、WsMissing、QuestionUnknown〔queue 沒有信、history 也沒有回答〕、
AnswerMissing〔逾時、或信不見了卻沒有回答〕）。"""
import sys, time
import os
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_human as h

PROG = "aos-listen"
USAGE = "aos-listen [--ws WS] [--stack STACK] [--timeout 秒] | [--last N] [--follow]"


def latest(w):
    """最新那封：queue 的 new/、cur/ 裡照處理順序排最後的（letter_key 取 max；11-03 aos-post 改版：有序先、無序後）；都空＝None。"""
    sigs = h.names(w.stack, "new") + h.names(w.stack, "cur")
    return max(sigs, key=h.letter_key) if sigs else None


def print_answer(w, sig):
    """印 history 最新那則回答；沒有＝sig 是 None（沒有信可等）就 QuestionUnknown，否則 AnswerMissing。"""
    got = h.aos_ws.answers(w.stack)
    if got:
        sys.stdout.write(got[-1] if got[-1].endswith("\n") else got[-1] + "\n")
        sys.stdout.flush()
        return
    if sig is None:
        h.die(PROG, "QuestionUnknown", "queue 的 new/ cur/ 沒有信，history 也沒有回答")
    h.die(PROG, "AnswerMissing", "%s 已經不在 queue 了，history 卻沒有回答" % sig)


def handed_unanswered(w, before):
    """信不見了、回答沒比開始時（before 則）多、history 最後一則是 user＝交給 CLI 了、還在答（aos-eca-turn 交出去就收信，11-03）。"""
    rows = h.aos_ws.history(w.stack)
    return len(h.aos_ws.answers(w.stack)) <= before and bool(rows) and rows[-1].get("role") == "user"


def wait_latest(w, timeout):
    sig = latest(w)
    before = len(h.aos_ws.answers(w.stack))
    if sig is None and not handed_unanswered(w, before):   # 答案已經到了（或根本沒寄過）：立刻印最新那則回答
        return print_answer(w, None)
    start, warned, next_check = time.monotonic(), False, 0.0
    what = sig or "最新那封"                           # queue 已經空、但交出去還沒答（eca，11-03）
    while True:
        stages = [s for s in h.where(w.stack, sig) if s in ("new", "cur")] if sig else []
        if not stages:
            if not handed_unanswered(w, before):
                return print_answer(w, sig)
            if time.monotonic() >= next_check:                 # 交出去了、還在答（eca，11-03）：沒人在跑就不會有回答了
                next_check = time.monotonic() + 1.0
                if not h.runners(w) and handed_unanswered(w, before):   # 再看一次：可能剛好答完退掉
                    h.die(PROG, "AnswerMissing", "%s 已經交出去了（不在 queue），history 卻沒有回答，也沒有程式在跑這隻 agent"
                          "（中途掛掉的那批不會自動重答；要重答就再 aos-say）" % what)
            if timeout is not None and time.monotonic() - start >= timeout:
                h.die(PROG, "AnswerMissing", "等了 %g 秒，%s 已經交出去、還沒答" % (timeout, what))
            time.sleep(h.POLL)
            continue
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            if h.runners(w):
                warned = False
            elif not warned:
                h.note(h.stuck_hint(w, sig) + "。我繼續等，Ctrl-C 離開")
                warned = True
        if timeout is not None and now - start >= timeout:
            h.die(PROG, "AnswerMissing", "等了 %g 秒，%s 還沒答（信在 queue 的 %s/）" % (timeout, sig, "、".join(stages)))
        time.sleep(h.POLL)


def block(n, asked, answer):
    out = "== #%d\n" % n
    for q in asked:
        out += "".join("> %s\n" % l for l in q.rstrip("\n").splitlines())
    return out + answer + ("" if answer.endswith("\n") else "\n")


def follow(w, last, keep):
    ex = h.aos_ws.exchanges(w.stack)
    seen = len(ex)
    for i in range(max(0, seen - last), seen) if last else []:
        sys.stdout.write(block(i + 1, *ex[i]))
    sys.stdout.flush()
    if not keep:
        return
    warned, next_check = False, 0.0
    while True:
        ex = h.aos_ws.exchanges(w.stack)
        if len(ex) < seen:                            # history 被 compact 換短了：從現在的尾巴接著看
            seen = len(ex)
        for i in range(seen, len(ex)):
            sys.stdout.write(block(i + 1, *ex[i]))
        seen = len(ex)
        sys.stdout.flush()
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            waiting = h.aos_ws.waiting(w.stack)
            if not waiting or h.runners(w):
                warned = False
            elif not warned:
                h.note("queue 裡還有 %d 封沒答（%s），但目前沒有程式在跑這隻 agent。%s。我繼續等，Ctrl-C 離開"
                       % (len(waiting), "、".join(waiting[:3]) + ("…" if len(waiting) > 3 else ""), h.run_hint(w)))
                warned = True
        time.sleep(h.POLL)


def number(opts, key, flag):
    v = opts.get(key)
    if v is None:
        return None
    try:
        n = float(v)
        if n < 0 or n != n:
            raise ValueError
    except ValueError:
        h.die(PROG, "ArgumentsBad", "usage: %s（%s 要給不小於 0 的數字：%s）" % (USAGE, flag, v))
    return n


def main():
    opts, rest = h.parse(PROG, USAGE, sys.argv[1:], {"--ws": "ws", "--stack": "stack", "--timeout": "timeout", "--last": "last"},
                         {"--follow": "follow"})
    timeout, last = number(opts, "timeout", "--timeout"), number(opts, "last", "--last")
    if rest:                                          # 11-01 晚翻案：不收信件名稱，等的永遠是最新那封
        h.die(PROG, "ArgumentsBad", "usage: %s（不收位置參數：%s；要等剛寄的那封就 aos-say 話 && aos-listen）" % (USAGE, rest[0]))
    waits = last is None and not opts.get("follow")
    if not waits and timeout is not None:
        h.die(PROG, "ArgumentsBad", "usage: %s（--timeout 只給等最新那封用，不跟 --last／--follow 一起）" % USAGE)
    try:
        w = h.Where(opts.get("ws"), opts.get("stack"))
    except h.Error as e:
        h.die(PROG, e.code, str(e))
    try:
        if waits:
            wait_latest(w, timeout)
        else:
            follow(w, int(last or 0), bool(opts.get("follow")))
    except KeyboardInterrupt:
        sys.exit(130 if waits else 0)


main()
