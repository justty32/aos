#!/usr/bin/env python3
"""aos-chat - 跟一隻 agent 一問一答：你打一句，它回一句（給人用，2026-10-24；＝aos-say＋aos-listen 串起來）。

    aos-chat [--ws WS] [--trace] [agent 資料夾]

每打一行＝aos-say 一題進 $AOS_WS/new/，然後等那題的 out/。
- **給了 agent 資料夾**：chat 自己跑它——每句之後 `aos-exec --ws WS <agent>` 跑一次（loop 跑到 new/ 空了自己停，CONVENTION P-19），
  agent 的 stderr 原樣出現在你的終端機（錯誤一行看得到）、stdout 也轉到 stderr；跑完印答案。agent 失敗（非 0）就說停在哪，
  題目留在 cur/，修好打 /run 再跑一次會接著做（P-20）。aos-exec、aos-loop、aos-fsm 要在 PATH 上（同 demo/run.sh）。
- **沒給**：chat 只放題、等答案，要別人跑（另一個終端機的 aos-exec，或常駐的 loop）；沒人在跑時提醒一次怎麼跑、繼續等。
對話記憶是 agent 自己的事：agent-dan 把對話接在 stack 的 history.jsonl，所以同一個工作區（同一個 stack）連問就接著聊；agent-bob 每題獨立。
指令（/ 開頭不送出；要送 / 開頭的話打兩個 //）：/status 一份快照、/run 再跑一次（只在給了 agent 時）、/trace 開關 trace、/help、/quit。
空行不送。Ctrl-C、Ctrl-D、/quit 都退 0；離開時還有題沒答，提醒一行（題目已放進去，之後 aos-listen 題名 看）。
stdout 只有答案；提示符在 stdin、stdout 都是終端機時才印。工作區＝--ws ＞ $AOS_WS ＞ cwd。
錯（進入前）：stderr 一行 `aos-chat: 代號 原因`、退 1（ArgumentsBad、FlagUnknown、WsMissing、AgentMissing〔agent 資料夾不在〕）。"""
import os, subprocess, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_human as h

PROG, USAGE = "aos-chat", "aos-chat [--ws WS] [--trace] [agent 資料夾]"
HELP = """/status   一份快照：誰在跑、停在哪一格、正在做哪題、各階段幾題
/run      再跑一次 agent（只在 aos-chat 有給 agent 資料夾時；題目卡在 cur/ 時修好用它接著做）
/trace    開／關 trace（每格一行、工具呼叫）
/help     這張表
/quit     離開（Ctrl-C、Ctrl-D 也是）
//xxx     送出 /xxx 這句話"""


class Chat:
    def __init__(self, ws, agent, trace):
        self.ws, self.agent, self.trace = ws, agent, trace
        self.pending = []                      # 送出去還沒印答案的題名（照送出順序）
        self.last = None                       # 最後送出的那題
        self.tail = h.Tail(ws)

    def flush_tail(self):
        lines = self.tail.lines()             # 不開 trace 也要讀，免得打開時倒出一大串舊的
        if self.trace:
            for line in lines:
                print(line, file=sys.stderr, flush=True)

    def print_ready(self):
        """印已經到了的答案（照送出順序）；回還沒到的有幾題。"""
        for n in list(self.pending):
            text = h.aos_ws.answer_text(self.ws, n)
            if text is None:
                continue
            self.pending.remove(n)
            if self.pending or n != self.last:
                h.note("較早那題 %s 的回答" % n)
            sys.stdout.write(text if text.endswith("\n") else text + "\n")
            sys.stdout.flush()
        return len(self.pending)

    def run_agent(self):
        """跑一次 agent，跑的期間照樣印 trace；回結束碼。"""
        try:
            p = subprocess.Popen(["aos-exec", "--ws", self.ws, self.agent], stdout=sys.stderr)
        except OSError as e:
            h.note("aos-exec 起不來（%s）：PATH 上要有 aos-exec、aos-loop、aos-fsm" % e)
            return None
        try:
            while p.poll() is None:
                self.flush_tail()
                time.sleep(h.POLL)
        except KeyboardInterrupt:          # Ctrl-C 也送到了 agent（同一個行程群組）：等它收完那次再走（P-36）
            try:
                p.wait(timeout=10)
            except (subprocess.TimeoutExpired, KeyboardInterrupt):
                pass
            raise
        self.flush_tail()
        return p.returncode

    def after_run(self, code):
        left = self.print_ready()
        if code is None or not left:
            return
        if code != 0:
            t = h.last_trace(self.ws)
            where = "停在 %s 格、" % t.get("state") if t and t.get("code") not in (0, 10) else ""
            h.note("agent 停了（%s結束碼 %d）；還有 %d 題沒答，題目留在 cur/／new/。上面那行錯誤修好後打 /run 接著做"
                   % (where, code, left))
        else:
            h.note("agent 跑完了，但還有 %d 題沒答（%s）；打 /status 看看" % (left, "、".join(self.pending)))

    def wait_other(self):
        """沒給 agent：等別人跑。答案到了就回；沒人跑提醒一次、繼續等。"""
        warned, next_check = False, 0.0
        while self.pending:
            self.flush_tail()
            if not self.print_ready():
                return
            now = time.monotonic()
            if now >= next_check:
                next_check = now + 1.0
                if h.runners(self.ws):
                    warned = False
                elif not warned:
                    h.note(h.stuck_hint(self.ws, self.pending[-1]) + "。我繼續等，Ctrl-C 離開")
                    warned = True
            time.sleep(h.POLL)

    def send(self, text):
        try:
            name = h.say(self.ws, text)
        except h.Error as e:
            print("%s: %s %s" % (PROG, e.code, e), file=sys.stderr)
            return
        self.last = name
        self.pending.append(name)
        if self.agent:
            self.after_run(self.run_agent())
        else:
            self.wait_other()

    def command(self, line):
        cmd = line.split()
        if cmd == ["/status"]:
            print("\n".join(h.status_lines(self.ws)), file=sys.stderr)
        elif cmd == ["/run"]:
            if not self.agent:
                h.note("沒給 agent 資料夾，chat 不幫你跑；重開：aos-chat <agent 資料夾>")
            else:
                self.after_run(self.run_agent())
        elif cmd == ["/trace"]:
            self.trace = not self.trace
            h.note("trace %s" % ("開" if self.trace else "關"))
        elif cmd == ["/help"]:
            print(HELP, file=sys.stderr)
        elif cmd in (["/quit"], ["/exit"]):
            raise EOFError
        else:
            h.note("沒有這個指令，/help 看清單（要把 / 開頭的話送出去就打兩個 //）")

    def loop(self):
        prompt = "> " if sys.stdin.isatty() and sys.stdout.isatty() else ""
        try:
            import readline  # noqa: F401  有就載：方向鍵、上一句
        except ImportError:
            pass
        while True:
            if self.pending:
                self.print_ready()
            try:
                line = input(prompt).strip()
            except EOFError:
                if prompt:
                    print()
                return
            if not line:
                continue
            if line.startswith("//"):
                self.send(line[1:])
            elif line.startswith("/"):
                self.command(line)
            else:
                self.send(line)


def main():
    opts, rest = h.parse(PROG, USAGE, sys.argv[1:], {"--ws": "ws"}, {"--trace": "trace"})
    if len(rest) > 1:
        h.die(PROG, "ArgumentsBad", "usage: %s（agent 資料夾只能一個，多給了 %s）" % (USAGE, rest[1]))
    try:
        ws = h.workspace(opts.get("ws"))
    except h.Error as e:
        h.die(PROG, e.code, str(e))
    agent = os.path.abspath(rest[0]) if rest else None
    if agent and not os.path.exists(agent):
        h.die(PROG, "AgentMissing", "agent 資料夾不在：%s" % agent)
    run = h.runners(ws)
    who = ("每句之後由我跑 %s" % agent if agent else
           "沒給 agent，由別人跑；目前在跑的：%s" % "、".join("%s（pid %d）" % (n, i) for i, n in run) if run else
           "沒給 agent，要別人跑，目前沒人在跑（%s）" % h.run_hint(ws))
    h.note("工作區 %s；%s。/help 看指令，Ctrl-C 或 Ctrl-D 離開" % (ws, who))
    chat = Chat(ws, agent, bool(opts.get("trace")))
    chat.pending = h.names(ws, "cur") + [n for n in h.names(ws, "new") if n not in h.names(ws, "cur")]
    if chat.pending:                           # 之前放進去、還沒答的題（例如上次 agent 停在半路）：答案到了一起印
        h.note("工作區裡已經有 %d 題還沒答（%s），答案到了會一起印%s"
               % (len(chat.pending), "、".join(chat.pending), "；打 /run 先跑一次" if agent else ""))
    try:
        chat.loop()
    except (KeyboardInterrupt, EOFError):
        print(file=sys.stderr)
    if chat.pending:
        chat.print_ready()
    if chat.pending:
        h.note("還有 %d 題沒答（%s）：題目已經放進去了，不用再說一次；之後 aos-listen --ws %s %s 看"
               % (len(chat.pending), "、".join(chat.pending), ws, chat.pending[-1]))


main()
