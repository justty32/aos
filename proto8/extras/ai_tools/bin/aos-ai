#!/usr/bin/env python3
"""aos-ai - 給 AI 用的 aos 指令與資料夾工具：起 agent、丟題、跑一次、背景顧、看狀態、停；每次輸出一行 JSON。

只在一個工作資料夾（root）裡動：--root 給，沒給用 $AOS_AI_ROOT，再沒有用 cwd。不刪東西、不碰 git。
root 的樣子：
  agents/<名>/agent/      agent 定義（從範本複製來的，例 proto8/demo/agent-dan）
  agents/<名>/ws/         它的工作區：new/ cur/ out/ done/，stack 在 ws/.stack/
  agents/<名>/runs.jsonl  aos-ai run 每跑一次記一行（結束碼、錯誤、答案）
  daemon/                 背景用的 aos-daemon：daemon.json、.stack/（ctl.json、state.json、loops_ctl.json、loops_state.json、各 agent 的小格）
錯：stderr 一行「aos-ai: 代號 原因（下一步：…）」、退 1。跑的結果（agent 失敗也算）是資料，照樣退 0、看 JSON 的 ok／code。
設計與代定見 proto8/thinking/2026-10-24-ai-tools.md。"""
import fcntl, json, os, re, shlex, shutil, signal, subprocess, sys, time, urllib.request
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent               # proto8/extras/ai_tools/bin
PROTO8 = HERE.parent.parent.parent
TEMPLATES = PROTO8 / "demo"
DAN_TOOLS = PROTO8 / "lib" / "aos"                   # 給 agent 掛的工具（--tool）：proto8/lib/aos（10-24 遷移前是 ai_tools/dan_tools）
IMPLS = ("aos-exec", "aos-loop", "aos-fsm", "aos-daemon", "aos-directive")
BIN_DIRS = [PROTO8 / "impls" / n / "bin" for n in IMPLS + ("aos-json",)] + [PROTO8 / "bin", HERE]
sys.path.insert(0, str(HERE))
import aos_ai_make as mk, aos_ai_explain as ex  # noqa: E402
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path.insert(0, str(PROTO8 / "lib" / "aos"))
import aos_ws  # noqa: E402  放題、等答案、讀 stack：跟 proto8/extras/human 共用一份（lib/aos/aos_ws.py，10-24 遷移）
NAME_RE = re.compile(r"[a-z0-9][a-z0-9_-]{0,63}\Z")
QID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,99}\Z")
LINE_RE = re.compile(r"([a-z][a-z0-9_-]*): (?:([A-Z][A-Za-z]+) )?(.*)")
TEXT_MAX = 4000
HINTS = {   # 下層的錯誤代號 → 下一步（只放常見的）
    "CommandMissing": "PATH 上找不到某支程式：先建 proto8/impls（wf/workflows/testing.md）",
    "EntryMissing": "目標裡沒有 _entry：aos-ai templates 看可用範本",
    "BrainFailed": "腦連不上：設 AOS_BRAIN_URL（家機 LiteLLM http://localhost:4000/v1），或拿掉它用假腦",
    "ReplyBad": "腦回的不是 OpenAI 形狀：換模型，或 aos-ai history 看最後一則",
    "ToolUnknown": "腦叫了沒登記的工具：aos-ai history 看最後一則；工具放 agents/<名>/agent/tools/<工具>/、"
                   "登記進 agents/<名>/agent/tools.json（aos-tools --file 那份 add 工具資料夾）",
    "ToolFailed": "工具起不來（aos-tools、aos-exec 不在 PATH？）；工具自己退非 0 不會停在這裡，那行已回給腦",
    "ToolsBad": "tools.json 登記的工具有壞的：aos-tools --file agents/<名>/agent/tools.json ls 看是哪個",
    "ArgumentsBad": "參數不對：看原因那句",
    "QuestionMissing": "沒有題目：先 aos-ai ask",
    "HistoryBad": "history.jsonl 壞了：人工看 ws/.stack/history.jsonl",
}
AGAIN = "修好後再 aos-ai run 一次，會從同一格、同一題接著做"


class Fail(Exception):
    def __init__(self, code, reason, hint=None):
        super().__init__(code)
        self.code, self.reason, self.hint = code, reason, hint


def now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def out(obj):
    print(json.dumps(obj, ensure_ascii=False))


def clip(text):
    return text if len(text) <= TEXT_MAX else text[:TEXT_MAX] + "…（截斷，全文看 path）"


def write_atomic(path, text):                        # N-05：先寫 . 開頭的暫存檔再改名
    path = Path(path)
    tmp = path.with_name("." + path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def tail_jsonl(path, n):
    return aos_ws.tail_jsonl(str(path), n)


def parse_errors(stderr):
    """stderr 每行「程式名: 代號 原因」拆成物件；認不出的行放 raw。"""
    rows = []
    for line in stderr.splitlines():
        if not line.strip():
            continue
        m = LINE_RE.match(line)
        rows.append({"prog": m.group(1), "code": m.group(2), "reason": m.group(3)} if m else {"raw": line[:500]})
    return rows


def hint_for(errors):
    for e in errors:
        if e.get("code") in HINTS:
            return HINTS[e["code"]] + "；" + AGAIN
    return AGAIN if errors else None


def child_env(extra=None):
    """PATH 前面放 impls 各支、proto8/bin、aos-ai 自己（aos 的程式不動 PATH，呼叫者放；ideas § 24）。"""
    e = dict(os.environ)
    bins = [str(b) for b in BIN_DIRS if b.is_dir()]
    e["PATH"] = os.pathsep.join(bins + [p for p in e.get("PATH", "").split(os.pathsep) if p and p not in bins])
    e.update(extra or {})
    return e


def which(prog):
    return shutil.which(prog, path=child_env()["PATH"])


def aos_tools(agent, *args):
    """aos-tools --file <agent>/tools.json ……（aos-tools 在 proto8/bin，child_env 已放進 PATH）→ CompletedProcess。"""
    prog = which("aos-tools")
    if not prog:
        raise Fail("CommandMissing", "PATH 上沒有 aos-tools（proto8/bin）", HINTS["CommandMissing"])
    return subprocess.run([prog, "--file", str(Path(agent) / "tools.json")] + list(args), capture_output=True,
                          text=True, env=child_env(), stdin=subprocess.DEVNULL)


def register_tool(agent, tool_dir):
    """把 tool_dir 登記進 agent 的 tools.json（aos-tools add，存絕對路徑）；不成＝Fail。"""
    r = aos_tools(agent, "add", os.path.abspath(tool_dir))
    if r.returncode != 0:
        err = (r.stderr.strip().splitlines() or ["aos-tools 退 %d" % r.returncode])[-1]
        raise Fail("ToolsBad", "登記 %s 進 %s/tools.json 失敗：%s" % (Path(tool_dir).name, agent, err), HINTS["ToolsBad"])


def tool_rows(agent):
    """agent 的工具＝它 tools.json 登記的（aos-tools ls）→ {"tools": [名…]}；登記了壞的工具＝多一個 tools_error（那行錯）。"""
    r = aos_tools(agent, "ls", "--json")
    if r.returncode != 0:
        return {"tools": [], "tools_error": (r.stderr.strip().splitlines() or ["aos-tools 退 %d" % r.returncode])[-1]}
    return {"tools": [t["name"] for t in json.loads(r.stdout)]}


def ticks(pid):                                       # /proc/<pid>/stat 第 22 欄（N-17：pid＋started_at_ticks 認行程）
    try:
        stat = Path("/proc/%d/stat" % pid).read_text()
        return int(stat[stat.rindex(")") + 2:].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def alive(pid, started):
    return bool(pid) and ticks(pid) is not None and (started is None or ticks(pid) == started)


# ---------- root 與路徑（安全邊界：只寫 root 底下） ----------

class Root:
    def __init__(self, given):
        self.dir = Path(given or os.environ.get("AOS_AI_ROOT") or os.getcwd()).resolve()
        if not self.dir.is_dir():
            raise Fail("RootMissing", "工作資料夾不在：%s" % self.dir, "先 mkdir，或用 --root 指別的")

    def inside(self, path, what="路徑"):
        p = Path(path).resolve()
        if p != self.dir and self.dir not in p.parents:
            raise Fail("PathBad", "%s 在工作資料夾外面：%s（root＝%s）" % (what, p, self.dir), "只能動 root 底下的東西")
        return p

    def agent(self, name, must=True):
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise Fail("NameBad", "agent 名字不合：%r" % (name,), "只用小寫英數、_、-，開頭英數，最長 64")
        a = Agent(self.dir / "agents" / name, name)
        if must and not a.agent.is_dir():
            raise Fail("AgentMissing", "沒有這隻 agent：%s" % name, "先 aos-ai spawn %s" % name)
        return a


class Agent:
    def __init__(self, base, name):
        self.base, self.name = base, name
        self.agent, self.ws = base / "agent", base / "ws"
        self.stack = self.ws / ".stack"

    def ls(self, d):
        return aos_ws.names(str(self.ws), d)

    def qid_used(self, qid):
        return bool(aos_ws.where(str(self.ws), qid))


# ---------- 背景：一個 root 一個 aos-daemon ----------

class Daemon:
    def __init__(self, root):
        self.dir = root.dir / "daemon"
        self.stack = self.dir / ".stack"
        self.cfg, self.ctl, self.state = self.dir / "daemon.json", self.stack / "ctl.json", self.stack / "state.json"
        # 10-29 aos-daemon 拆窗：名單的手把、子項表另外一對（daemon.json 沒寫＝這兩個預設檔名）
        self.lctl, self.lstate = self.stack / "loops_ctl.json", self.stack / "loops_state.json"

    def read_state(self):
        st = read_json(self.state)
        return st if isinstance(st, dict) else None

    def read_lstate(self):
        st = read_json(self.lstate)
        if not isinstance(st, dict):
            return None
        loops = st.get("loops")
        if isinstance(loops, dict) and "$ref" in loops:   # 超過 100 列會切檔：交給 aos-directive 解
            d = which("aos-directive")
            if d:
                r = subprocess.run([d], input=self.lstate.read_text(encoding="utf-8"), capture_output=True,
                                   text=True, cwd=self.stack)
                st = read_json_text(r.stdout) or st
        return st

    def running(self):
        st = self.read_state()
        if st and st.get("phase") not in ("done", "stopped") and alive(st.get("pid"), st.get("started_at_ticks")):
            return st.get("pid")
        up = read_json(self.dir / "up.json") or {}
        if alive(up.get("pid"), up.get("started_at_ticks")) and not (st and st.get("pid") == up.get("pid")
                                                                       and st.get("phase") in ("done", "stopped")):
            return up.get("pid")
        return None

    def row(self, name):
        st = self.read_lstate() or {}
        return (st.get("loops") or {}).get(name) if self.running() else None

    def write_ctl(self, change, path=None):
        """ctl 是宣告（N-06）：讀現在那份、改、seq＋1、整份換掉；同時只一個 aos-ai 寫（flock）。回 seq。
        path 沒給＝ctl.json（stopped 這類 loop 面向）；名單寫 self.lctl（loops_ctl.json，10-29 拆窗）。"""
        path = path or self.ctl
        self.stack.mkdir(parents=True, exist_ok=True)
        with open(self.dir / ".ctl.flock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            ctl = read_json(path, {})
            ctl = ctl if isinstance(ctl, dict) else {}
            change(ctl)
            ctl["seq"] = int(ctl.get("seq") or 0) + 1
            write_atomic(path, json.dumps(ctl, ensure_ascii=False, indent=1) + "\n")
            return ctl["seq"]

    def wait_seq(self, seq, until=None, timeout=8.0):
        """等 daemon 讀到這份 loops_ctl（loops_state 的 ctl_seq 回音）；until(loops_state) 另給條件。回 (loops_state, 是否等到)。"""
        end = time.monotonic() + timeout
        while True:
            st = self.read_lstate() or {}
            if (st.get("ctl_seq") or 0) >= seq and (until is None or until(st)):
                return st, True
            if time.monotonic() > end or not self.running():
                return st, False
            time.sleep(0.1)


def read_json_text(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


# ---------- 命令 ----------

def cmd_templates(root, o, pos):
    rows = []
    for d in sorted(TEMPLATES.iterdir()):
        if d.name.startswith("agent-") and (d / "_entry").exists():
            rows.append({"name": d.name, "path": str(d), **tool_rows(d)})
    out({"ok": True, "templates": rows, "default": "agent-dan",
         "bundled_tools": sorted(p.name for p in DAN_TOOLS.iterdir() if (p / "_tooldef.json").exists())})


def resolve_src(spec, home, what):
    p = Path(spec) if ("/" in spec or spec.startswith(".")) else home / spec
    if not p.is_dir():
        raise Fail(what + "Missing", "找不到%s：%s" % ({"Template": "範本", "Tool": "工具"}[what], spec),
                   "aos-ai templates 看有哪些")
    return p.resolve()


def absolutize(src, reg, key):
    """複製來的註冊檔（parts.json／tools.json）：每一格 {"path": 相對路徑} 從範本資料夾算、指到範本外面的，改成絕對路徑。
    指在範本裡面的（例 tools/clock，跟著複製了）照舊相對；指示詞（$ref／$env）與不是字串的不碰；沒有要改的就不寫檔。"""
    if not reg.is_file():
        return
    data = read_json(reg)
    table = data.get(key) if isinstance(data, dict) else None
    if not isinstance(table, dict) or "$ref" in table or "$env" in table:
        return
    changed = False
    for row in table.values():
        path = row.get("path") if isinstance(row, dict) else None
        if not isinstance(path, str) or os.path.isabs(path):
            continue
        target = os.path.normpath(os.path.join(src, path))           # 不解開捷徑（同 add 存 abspath）
        if target != str(src) and not target.startswith(str(src) + os.sep):
            row["path"], changed = target, True
    if changed:
        write_atomic(reg, json.dumps(data, ensure_ascii=False, indent=1) + "\n")


def cmd_spawn(root, o, pos):
    need(pos, 1, "spawn NAME [--from 範本] [--tool 工具]...")
    a = root.agent(pos[0], must=False)
    if a.base.exists():
        raise Fail("AgentExists", "已經有 %s 了：%s" % (a.name, a.base), "換個名字，或直接 aos-ai ask %s" % a.name)
    src = resolve_src(o.get("from", ["agent-dan"])[-1], TEMPLATES, "Template")
    tools = [resolve_src(t, DAN_TOOLS, "Tool") for t in o.get("tool", [])]
    for t in tools:
        if (src / "tools" / t.name).exists():
            raise Fail("ToolExists", "範本裡已經有工具 %s" % t.name)
    ignore = shutil.ignore_patterns("__pycache__", ".stack", "*.pyc")
    shutil.copytree(src, a.agent, symlinks=True, ignore=ignore)
    for link in [p for p in a.agent.rglob("*") if p.is_symlink()]:     # 範本裡指出範本的相對捷徑（例：tools/read -> ../../../lib/base/read）
        target = os.readlink(link)                                      # 搬到新位置會斷：改成指同一個東西的絕對路徑（照舊跟著庫走）
        if not os.path.isabs(target) and not link.exists():
            orig = src / link.relative_to(a.agent)
            if orig.exists():
                link.unlink()
                link.symlink_to(orig.resolve())
    for reg in ("parts.json", "tools.json"):                           # 註冊檔裡指出範本的相對路徑（例：agent-nia 的 ../../lib/agent/round）
        absolutize(src, a.agent / reg, "parts" if reg == "parts.json" else "tools")   # 搬家會斷：改成絕對（同 aos-parts／aos-tools add）
    for t in tools:
        shutil.copytree(t, a.agent / "tools" / t.name, symlinks=True, ignore=ignore)
        register_tool(a.agent, a.agent / "tools" / t.name)             # 範本的 tools.json 是相對路徑、複製後照用；加的工具登記絕對路徑
    for d in ("new", "cur", "out", "done", ".stack"):
        (a.ws / d).mkdir(parents=True, exist_ok=True)
    out({"ok": True, "name": a.name, "from": str(src), "agent": str(a.agent), "ws": str(a.ws), **tool_rows(a.agent)})


def cmd_ask(root, o, pos):
    need(pos, 2, "ask NAME 題目文字（或 - 從 stdin 讀）[--id 題名]")
    a = root.agent(pos[0])
    text = sys.stdin.read() if pos[1:] == ["-"] else " ".join(pos[1:])
    if not text.strip():
        raise Fail("QuestionBad", "題目是空的")
    qid = o.get("id", [None])[-1] or "q" + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f")[:-3]
    if not qid.endswith(".txt"):
        qid += ".txt"
    if not QID_RE.match(qid):
        raise Fail("QuestionBad", "題名不合：%r" % qid, "只用英數、_ . -")
    if a.qid_used(qid):
        raise Fail("QuestionExists", "題名用過了：%s" % qid, "換個 --id，或不給讓 aos-ai 取")
    try:                                                # 暫存放 new/ 外面、再 link 進去（aos_ws.put，跟 aos-say 同一份）
        aos_ws.put(str(a.ws), text, qid, tag="ask")
    except aos_ws.Error:
        raise Fail("QuestionExists", "題名剛好被用了：%s" % qid, "換個 --id，或不給讓 aos-ai 取")
    out({"ok": True, "name": a.name, "id": qid, "path": str(a.ws / "new" / qid),
         "next": "aos-ai run %s（前景跑完）或 aos-ai start %s（背景）" % (a.name, a.name)})


def run_group(argv, env, cwd, timeout, stdin=None):
    """起一個自成行程群組的子行程、等它；逾時送 SIGTERM 給整群、10 秒後 SIGKILL。回 (碼, stdout, stderr, 逾時?, ms)。"""
    t0 = time.monotonic()
    p = subprocess.Popen(argv, env=env, cwd=cwd, stdin=subprocess.PIPE if stdin is not None else subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    timed_out = False
    try:
        so, se = p.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        os.killpg(p.pid, signal.SIGTERM)
        try:
            so, se = p.communicate(timeout=10)
        except subprocess.TimeoutExpired:
            os.killpg(p.pid, signal.SIGKILL)
            so, se = p.communicate()
    return p.returncode, so, se, timed_out, int((time.monotonic() - t0) * 1000)


def code_fields(rc):
    return {"code": 128 - rc if rc < 0 else rc, "signal": -rc if rc < 0 else None}


def cmd_run(root, o, pos):
    need(pos, 1, "run NAME [--timeout 秒] [--env K=V]...")
    a = root.agent(pos[0])
    if Daemon(root).row(a.name) and Daemon(root).row(a.name).get("phase") in ("running", "stopping"):
        raise Fail("AgentBusy", "%s 正在背景跑" % a.name, "等它（aos-ai wait）或先 aos-ai stop %s" % a.name)
    with open(a.base / ".run.flock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fail("AgentBusy", "%s 已經有一個 aos-ai run 在跑" % a.name, "等它跑完")
        before = set(a.ls("out"))
        extra = {"AOS_STACK": str(a.stack) + "/"}       # 明寫：被別的 aos 程式叫時外面的 AOS_STACK 不能漏進來
        extra.update(env_pairs(o))
        rc, so, se, timed_out, ms = run_group(["aos-exec", "--ws", str(a.ws), str(a.agent)], child_env(extra),
                                              str(a.base), float(o.get("timeout", ["300"])[-1]))
    errors = parse_errors(se)
    answers = [{"id": q, "text": clip((a.ws / "out" / q).read_text(encoding="utf-8", errors="replace")),
                "path": str(a.ws / "out" / q)} for q in a.ls("out") if q not in before]
    res = {"ok": rc == 0 and not timed_out, "name": a.name, **code_fields(rc), "timed_out": timed_out,
           "elapsed_ms": ms, "answers": answers, "waiting": a.ls("new") + a.ls("cur"),
           "fsm_state": read_text(a.stack / "state.txt"), "errors": errors}
    if so.strip():
        res["stdout"] = clip(so)
    if not res["ok"]:
        res["hint"] = ("超過 --timeout 被收掉；" + AGAIN) if timed_out else hint_for(errors) or AGAIN
    with open(a.base / "runs.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps({"finished_at": now(), **{k: res[k] for k in ("code", "signal", "timed_out", "elapsed_ms", "errors")},
                            "answers": [x["id"] for x in answers]}, ensure_ascii=False) + "\n")
    out(res)


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8").strip()
    except OSError:
        return None


def agent_status(root, a, brief=False):
    d = Daemon(root)
    s = {"name": a.name, "fsm_state": read_text(a.stack / "state.txt"),
         "new": a.ls("new"), "cur": a.ls("cur"), "done": a.ls("done"), "out": a.ls("out"),
         "background": d.row(a.name), "last_run": (tail_jsonl(a.base / "runs.jsonl", 1) or [None])[0]}
    if not brief:
        s["trace_tail"] = tail_jsonl(a.stack / "trace.jsonl", 5)
        s["paths"] = {"agent": str(a.agent), "ws": str(a.ws), "stack": str(a.stack),
                      "cfgs": sorted(str(p.relative_to(a.agent)) for p in a.agent.rglob("*.json")
                                     if "__pycache__" not in p.parts),
                      **tool_rows(a.agent)}
    return s


def cmd_status(root, o, pos):
    if pos:
        out({"ok": True, **agent_status(root, root.agent(pos[0]))})
        return
    names = sorted(p.name for p in (root.dir / "agents").glob("*") if (p / "agent").is_dir())
    out({"ok": True, "root": str(root.dir), "daemon_pid": Daemon(root).running(),
         "agents": [agent_status(root, root.agent(n), brief=True) for n in names]})


def find_answer(a, qid):
    return aos_ws.answer_name(str(a.ws), qid)


def cmd_answer(root, o, pos):
    need(pos, 1, "answer NAME [題名]")
    a = root.agent(pos[0])
    if len(pos) == 1:
        out({"ok": True, "name": a.name, "answers": [{"id": q, "text": clip((a.ws / "out" / q).read_text(
            encoding="utf-8", errors="replace"))} for q in a.ls("out")], "waiting": a.ls("new") + a.ls("cur")})
        return
    q = find_answer(a, pos[1])
    if not q:
        where = "還在排隊（new/）" if pos[1] in a.ls("new") or pos[1] + ".txt" in a.ls("new") else \
                "做到一半（cur/）" if pos[1] in a.ls("cur") or pos[1] + ".txt" in a.ls("cur") else "沒這題"
        raise Fail("AnswerMissing", "%s 還沒有答案：%s" % (pos[1], where), "aos-ai run %s，或背景的話 aos-ai wait" % a.name)
    p = a.ws / "out" / q
    out({"ok": True, "name": a.name, "id": q, "text": clip(p.read_text(encoding="utf-8", errors="replace")),
         "path": str(p)})


def cmd_wait(root, o, pos):
    need(pos, 2, "wait NAME 題名 [--timeout 秒]")
    a = root.agent(pos[0])
    end = time.monotonic() + float(o.get("timeout", ["120"])[-1])
    t0 = time.monotonic()
    while True:
        q = find_answer(a, pos[1])
        if q:
            p = a.ws / "out" / q
            out({"ok": True, "name": a.name, "id": q, "text": clip(p.read_text(encoding="utf-8", errors="replace")),
                 "path": str(p), "waited_ms": int((time.monotonic() - t0) * 1000)})
            return
        row = Daemon(root).row(a.name)
        if row is None or row.get("phase") not in ("running", "stopping"):
            raise Fail("WaitFailed", "%s 沒在背景跑（%s），不會有人做這題" % (a.name, (row or {}).get("phase", "不在表上")),
                       "aos-ai start %s 或 aos-ai run %s；失敗原因看 ws/.stack/stderr.txt 與 aos-ai status" % (a.name, a.name))
        if time.monotonic() > end:
            raise Fail("WaitFailed", "等了 %s 秒還沒有答案" % o.get("timeout", ["120"])[-1], "aos-ai status %s 看卡在哪" % a.name)
        time.sleep(0.3)


def cmd_trace(root, o, pos):
    need(pos, 1, "trace NAME [-n 行數]")
    a = root.agent(pos[0])
    out({"ok": True, "name": a.name, "fsm_state": read_text(a.stack / "state.txt"),
         "trace": tail_jsonl(a.stack / "trace.jsonl", int(o.get("n", ["10"])[-1]))})


def cmd_history(root, o, pos):
    need(pos, 1, "history NAME [-n 則數]")
    a = root.agent(pos[0])
    rows = tail_jsonl(a.stack / "history.jsonl", int(o.get("n", ["6"])[-1]))
    for m in rows:
        if isinstance(m.get("content"), str) and len(m["content"]) > 500:
            m["content"] = m["content"][:500] + "…"
    out({"ok": True, "name": a.name, "history": rows})


def cmd_exec(root, o, pos):
    need(pos, 1, "exec [--ws WS] [--timeout 秒] 目標 [參數...]")
    ws = root.inside(o.get("ws", [str(root.dir)])[-1], "--ws")
    stdin = None if sys.stdin.isatty() else sys.stdin.read()
    rc, so, se, timed_out, ms = run_group(["aos-exec", "--ws", str(ws), "--"] + pos, child_env(env_pairs(o)),
                                          os.getcwd(), float(o.get("timeout", ["300"])[-1]), stdin)
    errors = parse_errors(se)
    res = {"ok": rc == 0 and not timed_out, **code_fields(rc), "timed_out": timed_out, "elapsed_ms": ms,
           "stdout": clip(so), "errors": errors}
    if not res["ok"] and errors:
        res["hint"] = hint_for(errors)
    out(res)


def daemon_up(root):
    d = Daemon(root)
    pid = d.running()
    if pid:
        return pid, True
    d.stack.mkdir(parents=True, exist_ok=True)       # aos-daemon 不自己建 stack（N-59 第 1 件）
    if not d.cfg.exists():
        write_atomic(d.cfg, json.dumps({"interval_ms": 500, "ctl": "ctl.json", "state": "state.json", "loops": {}},
                                       indent=1) + "\n")
    d.write_ctl(lambda c: c.pop("stopped", None))    # 上次 down 留下的 stopped 拿掉；loops_ctl 的 loops_added 照留＝上次在跑的照起
    prog = which("aos-daemon")
    if not prog:
        raise Fail("CommandMissing", "PATH 上沒有 aos-daemon", HINTS["CommandMissing"])
    with open(d.dir / "stderr.txt", "a") as err:
        p = subprocess.Popen([prog, str(d.cfg)], cwd=d.dir, env=child_env({"AOS_STACK": str(d.stack) + "/"}),
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=err, start_new_session=True)
    for _ in range(50):
        if ticks(p.pid) is not None:
            break
        time.sleep(0.02)
    write_atomic(d.dir / "up.json", json.dumps({"pid": p.pid, "started_at_ticks": ticks(p.pid), "started_at": now()}) + "\n")
    time.sleep(0.3)
    if p.poll() is not None:
        raise Fail("DaemonFailed", "aos-daemon 起來就結束了（碼 %s）：%s" % (p.returncode, (read_text(d.dir / "stderr.txt") or "")[-300:]))
    return p.pid, False


def cmd_daemon(root, o, pos):
    need(pos, 1, "daemon up|down|status")
    d = Daemon(root)
    if pos[0] == "up":
        pid, already = daemon_up(root)
        out({"ok": True, "pid": pid, "already_running": already, "dir": str(d.dir)})
    elif pos[0] == "down":
        pid = d.running()
        if not pid:
            out({"ok": True, "running": False})
            return
        d.write_ctl(lambda c: c.__setitem__("stopped", True))
        end = time.monotonic() + 20
        while d.running() and time.monotonic() < end:
            time.sleep(0.2)
        st = d.read_state() or {}
        out({"ok": not d.running(), "running": bool(d.running()), "phase": st.get("phase"), "code": st.get("code")})
    elif pos[0] == "status":
        st = d.read_state() or {}
        ls = d.read_lstate() or {}
        out({"ok": True, "running": bool(d.running()), "pid": d.running(), "phase": st.get("phase"),
             "loops": ls.get("loops") or {}, "ctl_seq": st.get("ctl_seq"), "ctl_warning": st.get("ctl_warning"),
             "loops_ctl_seq": ls.get("ctl_seq"), "loops_ctl_warning": ls.get("ctl_warning"),
             "recorded_at": st.get("recorded_at"), "stderr_tail": (read_text(d.dir / "stderr.txt") or "")[-500:] or None})
    else:
        raise Fail("ArgumentsBad", "daemon 只認 up、down、status：%s" % pos[0])


def cmd_start(root, o, pos):
    need(pos, 1, "start NAME [--interval-ms N]")
    a = root.agent(pos[0])
    with open(a.base / ".run.flock", "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            raise Fail("AgentBusy", "%s 正在前景 aos-ai run" % a.name, "等它跑完")
    daemon_up(root)
    d = Daemon(root)
    spec = {"exec": {"argv": ["aos-exec", "--ws", str(a.ws), str(a.agent)], "envs": {"AOS_STACK": str(a.stack) + "/"}},
            "interval_ms": int(o.get("interval-ms", ["2000"])[-1])}
    row = d.row(a.name)
    if row and row.get("phase") in ("running", "stopping"):
        out({"ok": True, "name": a.name, "already_running": True, "background": row})
        return
    if row:                                            # done／stopped 還在表上：拿掉、等它下表，再放回（daemon 不自己重起）
        seq = d.write_ctl(lambda c: (c.setdefault("loops_added", {}).pop(a.name, None)), d.lctl)
        d.wait_seq(seq, until=lambda st: a.name not in (st.get("loops") or {}))
    seq = d.write_ctl(lambda c: c.setdefault("loops_added", {}).__setitem__(a.name, spec), d.lctl)
    st, acked = d.wait_seq(seq, until=lambda st: a.name in (st.get("loops") or {}))
    row = (st.get("loops") or {}).get(a.name)
    res = {"ok": acked and bool(row), "name": a.name, "background": row, "ctl_warning": st.get("ctl_warning"),
           "next": "aos-ai ask %s …，再 aos-ai wait %s <題名>" % (a.name, a.name)}
    if not res["ok"]:
        res["hint"] = "daemon 沒接到（ctl_warning 或 aos-ai daemon status 看）"
    out(res)


def cmd_stop(root, o, pos):
    need(pos, 1, "stop NAME")
    a = root.agent(pos[0])
    d = Daemon(root)
    if not d.running():
        out({"ok": True, "name": a.name, "background": None, "note": "daemon 沒在跑"})
        return
    seq = d.write_ctl(lambda c: c.setdefault("loops_added", {}).pop(a.name, None), d.lctl)
    st, acked = d.wait_seq(seq, until=lambda st: (st.get("loops") or {}).get(a.name, {}).get("phase") != "running")
    out({"ok": acked, "name": a.name, "background": (st.get("loops") or {}).get(a.name),
         "note": "已叫停；正在跑的那次收完才真的停（stopping → 下表）"})


def cmd_edit(root, o, pos):
    """JSON 編輯只留接口：交給 $AOS_AI_JSON_EDITOR（另一套「JSON 修改工具集」），aos-ai 只管邊界。"""
    need(pos, 2, "edit NAME 檔（相對 agents/NAME/）[給編輯器的參數...]")
    a = root.agent(pos[0])
    target = Path(root.inside(a.base / pos[1], "要改的檔"))
    if a.base.resolve() not in target.parents:
        raise Fail("PathBad", "只能改 agents/%s/ 底下的檔：%s" % (a.name, target))
    editor = os.environ.get("AOS_AI_JSON_EDITOR")
    if not editor:
        raise Fail("EditorMissing", "還沒接 JSON 修改工具（環境變數 AOS_AI_JSON_EDITOR 沒設）",
                   "先直接改檔：%s；之後接上 JSON 修改工具集" % target)
    r = subprocess.run(shlex.split(editor) + [str(target)] + pos[2:], capture_output=True, text=True, env=child_env())
    out({"ok": r.returncode == 0, "code": r.returncode, "path": str(target), "stdout": clip(r.stdout),
         "errors": parse_errors(r.stderr)})


def cmd_doctor(root, o, pos):
    url = os.environ.get("AOS_BRAIN_URL")
    reach = None
    if url:
        try:
            urllib.request.urlopen(url.rstrip("/") + "/models", timeout=3).close()
            reach = True
        except Exception:
            reach = False
    bins = {n: which(n) for n in IMPLS + ("aos-tick", "aos-ai")}
    out({"ok": all(bins[n] for n in IMPLS[:4]), "root": str(root.dir), "bins": bins,
         "brain": {"url": url, "reachable": reach, "note": None if url else "沒設 AOS_BRAIN_URL＝假腦"}})


def cmd_make(root, o, pos):
    """make <inst|loop|fsm|daemon|metainfo|tool_json> [旗標] [--out 檔]；make tool 名 工具；make cell 名 格；make func 資料夾。"""
    need(pos, 1, "make inst|loop|fsm|daemon|metainfo|tool_json [旗標] [--out 檔] | make tool NAME 工具 | make cell NAME 格 | make func 資料夾")
    kind, notes = pos[0], "no-notes" not in o
    env = child_env()
    if kind in mk.GEN:
        x = mk.GEN[kind](o)
        res = {"ok": True, "kind": kind, "json": x}
        if opt1(o, "out"):
            path = root.inside(opt1(o, "out"), "--out")
            mk.write_new(path, mk.dump(x), force="force" in o)
            res["path"] = str(path)
            chk = mk.aos_json_check(which, env, path)
            if chk is not None:
                res["check"] = chk
                res["ok"] = chk["ok"]
        if notes:
            res["notes"] = mk.notes_for(x, kind)
        out(res)
    elif kind == "tool":
        need(pos, 3, "make tool NAME 工具名 --description 一句話 [--param 名:型別[:說明][:required]]... [--lang python|sh]")
        a = root.agent(pos[1])
        if not NAME_RE.match(pos[2]):
            raise Fail("NameBad", "工具名不合：%r" % pos[2], "小寫英數、_、-")
        res = {"ok": True, "name": a.name, "tool": pos[2], **mk.scaffold_tool(a.agent / "tools", pos[2], o),
               "next": "改 _entry 的 TODO；已登記進 tools.json，腦下次 think 就看得到（aos-tools ls）"}
        register_tool(a.agent, a.agent / "tools" / pos[2])
        if notes:
            res["notes"] = {**mk.notes_for(res["tool_json"], "tool_json"),
                            "_entry": "工具本體：stdin 收 arguments（JSON）、stdout 整段是結果；退非 0＝ToolFailed、整隻停（explain tool）"}
        out(res)
    elif kind == "cell":
        need(pos, 3, "make cell NAME 格名 [--exec 目標或單子JSON | --dir] [--next 下一格] [--after 前一格]")
        a = root.agent(pos[1])
        cell, fsm = pos[2], a.agent / "fsm.json"
        if not NAME_RE.match(cell):
            raise Fail("NameBad", "格名不合：%r" % cell)
        table = read_json(fsm)
        if not isinstance(table, dict) or not isinstance(table.get("states"), dict):
            raise Fail("CfgBad", "%s 不是 fsm 表" % fsm)
        if cell in table["states"]:
            raise Fail("CellExists", "已經有格 %s" % cell, "改它用 aos-json set %s#/states/%s …" % (fsm, cell))
        after = opt1(o, "after")
        if after and after not in table["states"]:
            raise Fail("CellMissing", "沒有格 %s" % after)
        made = []
        if "dir" in o:
            mk.write_new(a.agent / cell / "_entry", mk.SH_CELL.format(name=cell), mode=0o755)
            made.append(str(a.agent / cell / "_entry"))
            exe = cell
        elif opt1(o, "exec"):
            exe = mk.value(opt1(o, "exec"))
        else:
            raise Fail("ArgumentsBad", "要 --exec（目標或單子 JSON）或 --dir（起一個格資料夾）")
        nxt = opt1(o, "next") or (table["states"][after]["next"] if after else table.get("start"))
        spec = {"exec": exe, "next": nxt}
        trial = json.loads(json.dumps(table))
        trial["states"][cell] = spec
        if after:
            trial["states"][after]["next"] = cell
        mk.check_fsm(trial)                               # 先驗整張表，再交給 aos-json 改
        by = mk.aos_json_set(which, env, "%s#/states/%s" % (fsm, cell), spec)
        if after:
            mk.aos_json_set(which, env, "%s#/states/%s/next" % (fsm, after), cell)
        res = {"ok": True, "name": a.name, "cell": cell, "spec": spec, "after": after, "edited_by": by,
               "made": made, "fsm": str(fsm)}
        chk = mk.aos_json_check(which, env, fsm)
        if chk is not None:
            res["check"], res["ok"] = chk, chk["ok"]
        if notes:
            res["notes"] = {"exec": mk.NOTES["exec"], "next": "這格退 0 才換到 next；10 或失敗 state 不動（explain fsm）"}
        out(res)
    elif kind == "func":
        need(pos, 2, "make func 資料夾 [--summary 一句話] [--argv 命令 | --inst 單子JSON] [_metainfo 旗標...]")
        d = root.inside(pos[1], "函數資料夾")
        res = {"ok": True, **mk.scaffold_func(d, o), "next": "aos-ai exec %s 跑跑看" % d}
        if notes:
            res["notes"] = {"_entry": mk.NOTES["_entry"].split("；")[0] + "；這裡是可執行檔或單子（explain entry）",
                            "_metainfo": "跟 _entry 並列＝這個函數的特性，aos-exec 不讀（explain metainfo）"}
        out(res)
    else:
        raise Fail("ArgumentsBad", "make 不認得 %s；認 %s、tool、cell、func" % (kind, "、".join(mk.GEN)))


def opt1(o, k):
    return o.get(k, [None])[-1]


def cmd_explain(root, o, pos):
    if "here" in o:
        out(ex.here(pos[0] if pos else ".", opt1(o, "ws"), os.environ, override="dotenv-override" in o))
        return
    if not pos:
        secs = ex.sections()
        out({"ok": True, "concepts": list(secs), "how": "aos-ai explain <概念>；aos-ai explain --here [目標] 算具體值",
             "file": str(ex.CONCEPTS)})
        return
    k, text = ex.find(pos[0])
    if not k:
        raise Fail("ConceptUnknown", "沒有概念 %s" % pos[0], "aos-ai explain 列出全部：" + "、".join(ex.sections()))
    out({"ok": True, "concept": k, "text": text})


COMMANDS = {"make": cmd_make, "explain": cmd_explain, "templates": cmd_templates, "spawn": cmd_spawn, "ask": cmd_ask, "run": cmd_run, "status": cmd_status,
            "answer": cmd_answer, "wait": cmd_wait, "trace": cmd_trace, "history": cmd_history, "exec": cmd_exec,
            "daemon": cmd_daemon, "start": cmd_start, "stop": cmd_stop, "edit": cmd_edit, "doctor": cmd_doctor}
VALUED = {"root", "from", "tool", "id", "timeout", "env", "n", "ws", "interval-ms", "out", "spec", "set", "argv", "cwd",
          "stdin", "stdout", "stderr", "timeout-ms", "grace-ms", "envs", "exec", "max", "ctl", "state", "entry", "cell",
          "start", "next", "loop", "summary", "time-ms", "mem-mb", "gpu-mem-mb", "llm-calls", "llm-tokens", "cost",
          "side-effect", "idempotent", "deterministic", "parallel", "resource", "interrupt", "description", "param",
          "lang", "inst", "after"}
SWITCHES = {"force", "no-notes", "here", "dir", "dotenv-override"}
USAGE = ("usage: aos-ai [--root DIR] 命令 ...；命令：templates | spawn NAME [--from 範本] [--tool 工具]... | "
         "ask NAME 文字|- [--id 題名] | run NAME [--timeout 秒] [--env K=V]... | status [NAME] | answer NAME [題名] | "
         "wait NAME 題名 [--timeout 秒] | trace NAME [-n N] | history NAME [-n N] | "
         "exec [--ws WS] 目標 [參數...] | daemon up|down|status | start NAME [--interval-ms N] | stop NAME | "
         "edit NAME 檔 ... | doctor | make inst|loop|fsm|daemon|metainfo|tool_json [--out 檔] | make tool NAME 工具 | "
         "make cell NAME 格 | make func 資料夾 | explain [概念] | explain --here [目標] [--ws WS]")


def need(pos, n, usage):
    if len(pos) < n:
        raise Fail("ArgumentsBad", "usage: aos-ai " + usage)


def env_pairs(o):
    pairs = {}
    for kv in o.get("env", []):
        if "=" not in kv:
            raise Fail("ArgumentsBad", "--env 要寫 K=V：%s" % kv)
        k, v = kv.split("=", 1)
        pairs[k] = v
    return pairs


def parse(argv):
    """旗標 --x V／--x=V／-n V 收成 {x: [值...]}；exec 遇到第一個位置參數就停（後面原樣給 aos-exec）。"""
    opts, pos, cmd, i = {}, [], None, 0
    while i < len(argv):
        a = argv[i]
        if cmd == "exec" and pos:
            pos.extend(argv[i:])
            break
        if a == "--":
            pos.extend(argv[i + 1:])
            break
        if a.startswith("-") and a != "-":
            key, _, val = a.lstrip("-").partition("=")
            if key in SWITCHES and not _:
                opts.setdefault(key, []).append(True)
                i += 1
                continue
            if key not in VALUED:
                raise Fail("FlagUnknown", "不認得的旗標 %s" % a, "aos-ai help 看用法")
            if not _:
                i += 1
                if i >= len(argv):
                    raise Fail("ArgumentsBad", "%s 缺值" % a)
                val = argv[i]
            opts.setdefault(key, []).append(val)
        elif cmd is None:
            cmd = a
        else:
            pos.append(a)
        i += 1
    return cmd, opts, pos


def main(argv):
    try:
        if argv[:1] in (["-h"], ["--help"]):
            argv = ["help"]
        cmd, opts, pos = parse(argv)
        if cmd in (None, "help"):
            print(USAGE)
            return 0 if cmd else 1
        if cmd not in COMMANDS:
            raise Fail("CommandUnknown", "不認得的命令 %s" % cmd, "aos-ai help 看用法")
        root = Root(opts.pop("root", [None])[-1])
        COMMANDS[cmd](root, opts, pos)
        return 0
    except mk.MakeBad as f:
        print("aos-ai: %s %s%s" % (f.code, f.reason, "（下一步：%s）" % f.hint if f.hint else ""), file=sys.stderr)
        return 1
    except Fail as f:
        print("aos-ai: %s %s%s" % (f.code, f.reason, "（下一步：%s）" % f.hint if f.hint else ""), file=sys.stderr)
        return 1
    except (OSError, ValueError) as e:
        print("aos-ai: Internal %s: %s" % (type(e).__name__, e), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
