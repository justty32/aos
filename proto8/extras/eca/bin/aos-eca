#!/usr/bin/env python3
"""aos-eca（11-03 前叫 aos-eca-hub、aos-eca-ctl；使用者「好像也不用aos-eca-ctl，改成aos-eca就好。」）- 管掛在 aos-daemon 底下的外部 coding agent（claude／codex）：建立／刪除、掛上／拿下 daemon、開／關畫面、列出（10-30 eca）。
每個子命令只管一隻（使用者 11-03「我預期aos-eca xxx這條指令，就是針對單個eca」）；管所有 eca 的事等以後的 aos-eca-hub（ls 暫時留著）。

三對指令（使用者 11-02 晚「很好，所以三個對應：open/close, start/stop, add/remove」，11-03「統一成add/rm吧」）：open／close＝畫面，
start／stop＝掛不掛在 daemon 上（stop 留小格），add／rm＝建立與刪除（rm 刪小格、不封存）。

    aos-eca [--daemon-stack D] add [--name N] [--ws WS] XXX   建立：XXX＝eca 資料夾（頂層有 cli.json，例 proto8/demo/eca-claude）；
                                                   掛到 daemon（aos-daemon-ctl add --ws WS --name N XXX）；印小格
    aos-eca ls    [--json]                         列外部 agent（掛著的、停了的）：名字、狀態、種類、工作區、對話 id 前 8 碼
    aos-eca state [資料夾|名字]                    這裡有沒有外部 agent（掛著或停了；沒有＝InstanceMissing、退 1）
    aos-eca status [資料夾|名字]                   同 state（別名、行為一樣；11-03 使用者「status和state兩個指令都可以」）
    aos-eca open  [-d] [--name N] [--ws WS] [名字|資料夾|XXX]   接進畫面（沒開就開、有對話就 --resume）；認不出、是 eca 資料夾＝先 add 再開
    aos-eca close [資料夾|名字]                    收起：關畫面、對話留著（aos-eca-turn 照樣用 --resume 答）；只管畫面、不碰 daemon
    aos-eca start [資料夾|名字]                    掛回 daemon：停了、收工了、出錯停了的照 eca.json 的工作區與 eca 資料夾同名掛回，接著答 queue 裡的信
    aos-eca stop  [資料夾|名字]                    從 daemon 拿掉（aos-daemon-ctl rm）、關畫面；小格原樣留
    aos-eca rm    [資料夾|名字]                    刪除：關畫面、從 daemon 拿掉、刪小格（不封存；要留的先自己複製）
    aos-eca watch [資料夾|名字]                    跟著看非互動那次在做什麼（小格的 live.jsonl），到一次回答結束就走

資料夾的意思：add（和 open 新建的那條）的 XXX＝eca 本身（同 aos-daemon-ctl add XXX）；其他子命令的資料夾＝工作區（或小格裡面）。
  名字、資料夾都認時先比名字；都沒給＝cwd 當資料夾。
設計：proto8/thinking/2026-10-30-eca.md C 結論 7～10（daemon＋三件 daemon 做不到的事：畫面、對話接回、CLI 自己的 session 檔）；11-03 改動見 eca 18。
沒有自己的常駐 kernel：常駐的是 aos-daemon（信箱模式），以它的 loops_state.json 為準（衝突 2）；每個子命令都是
「叫 aos-daemon-ctl ＋ 動小格裡 cli_session 的東西」。哪個 daemon＝--daemon-stack ＞ $AOS_DAEMON_STACK（同 aos-daemon-ctl，11-02 從 --daemon／AOS_DAEMON 改名；沒設、不是資料夾、
daemon 沒在跑〔loops_state.json 的 pid＋started_at_ticks 對不上〕＝DaemonMissing）。不另設 hub 的環境變數（10-28 那個退場，衝突 4）。
add：名字沒給＝XXX 的資料夾名；--ws 沒給＝cwd（就是 claude 的 cwd）。撞名＝InstanceExists、退 1、不送信：daemon 表上（loops／execs）已有
  這個名字，或小格 <daemon>/loops/<名字>/ 還在（停了、收工了、出錯停了的）——換 --name，或先 aos-eca rm；要接著用停了的那隻＝aos-eca start。
「一隻外部 agent」＝daemon 的 loops 表上、小格裡有 eca.json 的（aos-eca-turn 每次跑都寫：kind、ws、template〔＝eca 資料夾〕）；add 之後子 loop 跑第一次才有。
  11-02 起子項結束 daemon 就從表上拿掉（不留 done 列）：表上沒有、小格在（有 eca.json）的照樣列，狀態看小格的 state.json（子 loop 自己的窗）：
  done 而且結束碼不是 0＝「出錯停了」；done／stopped 而且結束碼 0（例如外部寫了小格 ctl.json {"stopped": true} 收工，11-02 晚）＝「收工了」；
  其他（stop 或 aos-daemon-ctl rm 拿掉的，stopped＋非 0；state.json 不在）＝「停了」（11-02 晚第二輪）。這三種都用 start 掛回。
  start 掛回之前，小格 ctl 窗裡殘留的 stopped 先拿掉（只拿這個 key），免得新的子 loop 一起來就收工。
CLI 的小格＝<daemon>/loops/<名字>/<kind>/（cli_session 的 session.txt、tty.sock、live.jsonl、transcripts/）。
畫面裡按 Ctrl-]（或 Ctrl-\\）＝跳出、實例不結束。「暫停」只有 ctl.json 的 paused 一種（寫 <小格>/ctl.json），這裡不另做。
錯：stderr 一行 `aos-eca: 代號 原因`、退 1。代號：ArgumentsBad、FlagUnknown、CommandUnknown、DaemonMissing、InstanceMissing、
  InstanceExists（add 撞名）、PathMissing（XXX、--ws 不在或不是資料夾）、EcaBad（XXX 沒有 cli.json）、SessionBad（正在答題時 close、stop、rm）、
  Timeout（等 daemon 收掉逾時），加 aos-daemon-ctl 與 cli_session 的。"""
import json, os, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.normpath(os.path.join(HERE, "..", "..", ".."))           # proto8/
CTL = os.path.join(ROOT, "bin", "aos-daemon-ctl")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(ROOT, "lib", "agent"))
import cli_session  # noqa: E402

PROG = "aos-eca"
WAIT_S = 30                                     # stop／rm／start 等 daemon 收掉的上限（daemon 的 grace 是 10 秒）


def die(code, msg):
    print("%s: %s %s" % (PROG, code, str(msg).replace("\n", " ")), file=sys.stderr)
    sys.exit(1)


cli_session.PROG = PROG                         # cli_session 出錯時那一行用這支的名字


def parse(argv, flags=(), switches=()):
    opts, rest, it = {}, [], iter(argv)
    for a in it:
        name, eq, val = a.partition("=")
        if name in flags:
            v = val if eq else next(it, None)
            if v is None:
                die("ArgumentsBad", "%s 要一個值" % a)
            opts[name] = v
        elif a in switches:
            opts[a] = True
        elif a.startswith("-") and a != "-":
            die("FlagUnknown", a)
        else:
            rest.append(a)
    if len(rest) > 1:
        die("ArgumentsBad", "多給了 %s" % rest[1])
    return opts, (rest[0] if rest else None)


# ---------------------------------------------------------------- daemon（經 aos-daemon-ctl）

DAEMON = None                                   # main 裡從 --daemon-stack／$AOS_DAEMON_STACK 定


def daemon_dir():
    d = DAEMON or os.environ.get("AOS_DAEMON_STACK", "")
    if not d:
        hint = ("；AOS_DAEMON 11-02 起改名，請改設 AOS_DAEMON_STACK（或 --daemon-stack）"
                if os.environ.get("AOS_DAEMON") else "")
        die("DaemonMissing", "沒給 --daemon-stack、也沒設 AOS_DAEMON_STACK（要指到 aos-daemon 的 $AOS_STACK 資料夾）" + hint)
    if not os.path.isdir(d):
        die("DaemonMissing", "daemon 的資料夾不在：%s" % d)
    d = os.path.abspath(d)
    try:
        with open(os.path.join(d, "loops_state.json"), encoding="utf-8") as f:
            st = json.load(f)
        pid, ticks = int(st["pid"]), st["started_at_ticks"]
        with open("/proc/%d/stat" % pid, encoding="utf-8") as f:
            alive = int(f.read().rpartition(")")[2].split()[19]) == ticks
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        alive = False
    if not alive:
        die("DaemonMissing", "%s 的 aos-daemon 沒在跑（loops_state.json 不在或寫它的行程不在）" % d)
    return d


def ctl(*args):
    """叫 aos-daemon-ctl；錯＝把它那一行換成這支的名字、退 1。回 stdout。stderr 的提醒照轉。"""
    try:
        r = subprocess.run([sys.executable, CTL, "--daemon-stack", daemon_dir()] + list(args), capture_output=True, text=True)
    except OSError as e:
        die("CommandMissing", "叫不了 aos-daemon-ctl：%s" % e)
    if r.returncode != 0:
        line = (r.stderr.strip().splitlines() or ["aos-daemon-ctl: CtlFailed 退 %d" % r.returncode])[-1]
        code, _, why = line.partition(": ")[2].partition(" ")
        die(code or "CtlFailed", why or line)
    if r.stderr:
        sys.stderr.write(r.stderr)
    return r.stdout


def ended(d, rows):
    """表上沒有、小格在的（11-02 起 daemon 不留結束的列）：{名字: 小格 state.json 的 phase、code 當列}（照名字排）。
    state.json 不在、讀不懂＝phase、code 都 None（label 算「停了」）。有沒有 eca.json 由 instances 篩。"""
    out = {}
    try:
        names = sorted(os.listdir(os.path.join(d, "loops")))
    except OSError:
        return out
    for name in names:
        if name in rows or not os.path.isdir(os.path.join(d, "loops", name)):
            continue
        try:
            with open(os.path.join(d, "loops", name, "state.json"), encoding="utf-8") as f:
                st = json.load(f)
        except (OSError, ValueError):
            st = None
        st = st if isinstance(st, dict) else {}
        code = st.get("code")
        code = code if isinstance(code, int) and not isinstance(code, bool) else None
        out[name] = {"phase": st.get("phase") if isinstance(st.get("phase"), str) else None, "code": code, "pid": None, "ended": True}
    return out


def instances():
    """daemon 的 loops 表上（＋下了表、小格還在的）、小格有 eca.json 的：[{name, cell, phase, code, pid, ended, kind, ws, template}]（照表的順序）。"""
    d = daemon_dir()
    rows = json.loads(ctl("ls", "--json") or "{}").get("loops", {})
    rows = dict(rows, **ended(d, rows))
    out = []
    for name, r in rows.items():
        cell = os.path.join(d, "loops", name)          # 11-02：子項的小格在 <daemon>/loops/<名字>/
        try:
            with open(os.path.join(cell, "eca.json"), encoding="utf-8") as f:
                eca = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(eca, dict) or eca.get("kind") not in ("claude", "codex"):
            continue
        out.append(dict(name=name, cell=cell, phase=r.get("phase"), code=r.get("code"), pid=r.get("pid"),
                        ended=bool(r.get("ended")),
                        kind=eca["kind"], ws=eca.get("ws") or r.get("ws") or "", template=eca.get("template") or ""))
    return out


def cli_cell(it):
    return os.path.join(it["cell"], it["kind"])


def has_screen(it):
    p = cli_cell(it)
    return os.path.exists(os.path.join(p, "tty.sock")) and cli_session.Cell(p).alive()


def session_of(it):
    try:
        with open(os.path.join(cli_cell(it), "session.txt"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def failed(it):
    return it["ended"] and it["phase"] == "done" and it["code"] not in (0, None)


def finished(it):
    """收工了：下了表、自己以 0 結束（例如小格 ctl.json 寫了 stopped）。"""
    return it["ended"] and it["code"] == 0


def label(it):
    if failed(it):
        return "出錯停了"
    if finished(it):
        return "收工了"
    if it["ended"]:
        return "停了"                                   # stop（或 aos-daemon-ctl rm）拿掉的：小格原樣留，start 掛回
    if it["phase"] != "running":
        return it["phase"] or "-"
    return "畫面開著" if has_screen(it) else "收起了"


def find(arg, rows=None):
    """名字或資料夾 → 一隻；資料夾比對：工作區相同、或在它的小格裡面。找不到＝None。"""
    rows = instances() if rows is None else rows
    for r in rows:
        if arg and r["name"] == arg:
            return r
    d = os.path.abspath(arg or ".")
    hit = [r for r in rows if r["ws"] == d or d == r["cell"] or d.startswith(r["cell"] + os.sep)]
    if len(hit) > 1:
        die("ArgumentsBad", "%s 有 %d 隻掛著，用名字指定（aos-eca ls）" % (d, len(hit)))
    return hit[0] if hit else None


def resolve(arg):
    r = find(arg)
    if r is None:
        die("InstanceMissing", "%s 不是外部 agent（aos-eca add 或 open 建立；rm 過的就沒了）" % (arg or os.getcwd()))
    return r


def is_eca(xxx):
    return bool(xxx) and os.path.isfile(os.path.join(xxx, "cli.json"))


def eca_dir(xxx):
    """add 的 XXX：eca 資料夾（頂層有 cli.json）→ 絕對路徑。不在＝PathMissing、沒有 cli.json＝EcaBad。"""
    if not os.path.isdir(xxx):
        die("PathMissing", "沒有 %s（add 要一個 eca 資料夾，例 proto8/demo/eca-claude）" % xxx)
    if not is_eca(xxx):
        die("EcaBad", "%s 沒有 cli.json（不是外部 coding agent）" % xxx)
    return os.path.abspath(xxx)


def wait_for(cond, what, secs=WAIT_S):
    end = time.time() + secs
    while time.time() < end:
        v = cond()
        if v:
            return v
        time.sleep(0.1)
    die("Timeout", "等了 %d 秒，%s" % (secs, what))


def rows_named(name):
    return [r for t in json.loads(ctl("ls", "--json") or "{}").values() for n, r in t.items() if n == name]


def gone(name):
    """daemon 收掉它了：表上沒有這列（11-02 起結束的就下表），或那列是 done／stopped（不會再動）。"""
    rows = rows_named(name)
    return not rows or all(r.get("phase") in ("done", "stopped") for r in rows)


def clear_stopped(cell, template):
    """小格的 ctl 窗（定義 loop.json 的 ctl，相對小格）有 stopped 就只拿掉這個 key（常駐 bob install 那條代定）：
    沒別的 key＝刪檔，有＝先寫 .名字 再改名。檔不在、讀不懂、定義沒寫 ctl＝不動。"""
    try:
        with open(os.path.join(template, "loop.json"), encoding="utf-8") as f:
            text = f.read()
        if text.startswith("#!"):
            text = text.split("\n", 1)[1] if "\n" in text else ""
        name = json.loads(text).get("ctl")
        if not isinstance(name, str) or not name:
            return
        p = os.path.join(cell, name)
        with open(p, encoding="utf-8") as f:
            c = json.load(f)
        if not isinstance(c, dict) or "stopped" not in c:
            return
        del c["stopped"]
        if not c:
            os.unlink(p)
            return
        tmp = os.path.join(os.path.dirname(p), "." + os.path.basename(p))
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(c, f, ensure_ascii=False)
        os.replace(tmp, p)
    except (OSError, ValueError, AttributeError):
        pass


def hang(ws, name, xxx):
    """掛上（aos-daemon-ctl add）；之前先拿掉小格殘留的 stopped（start 掛回時才會有）。回小格。"""
    cell = os.path.join(daemon_dir(), "loops", name)
    clear_stopped(cell, xxx)
    ctl("add", "--ws", ws, "--name", name, xxx)
    return cell


def do_add(opts, xxx):
    """add：XXX＝eca 資料夾；--name 沒給＝XXX 的資料夾名，--ws 沒給＝cwd。撞名（daemon 表上有、或小格還在）＝InstanceExists、不送信。"""
    if not xxx:
        die("ArgumentsBad", "add 要一個 eca 資料夾 XXX（aos-eca add [--name N] [--ws WS] XXX）")
    xxx = eca_dir(xxx)
    ws = os.path.abspath(opts.get("--ws") or ".")
    if not os.path.isdir(ws):
        die("PathMissing", "--ws 不是資料夾：%s" % ws)
    name = opts.get("--name") or os.path.basename(xxx.rstrip("/"))
    if rows_named(name):
        die("InstanceExists", "daemon 上已經有 %s 了；換個名字（--name），或先 aos-eca rm %s" % (name, name))
    cell = os.path.join(daemon_dir(), "loops", name)
    if os.path.lexists(cell):
        die("InstanceExists", "%s 的小格還在（%s）；換個名字（--name）、先 aos-eca rm %s，或用 aos-eca start %s 接著用"
            % (name, cell, name, name))
    return name, hang(ws, name, xxx)


# ---------------------------------------------------------------- 子命令

def cmd_add(argv):
    opts, arg = parse(argv, flags=("--name", "--ws"))
    print(do_add(opts, arg)[1])


def cmd_ls(argv):
    opts, _ = parse(argv, switches=("--json",))
    rows = instances()
    if opts.get("--json"):
        print(json.dumps([dict(r, state=label(r), screen=has_screen(r), session=session_of(r)) for r in rows],
                         ensure_ascii=False))
        return
    for r in rows:
        print("%-12s %-10s %-6s %s  對話 %s" % (r["name"], label(r), r["kind"], r["ws"], session_of(r)[:8] or "-"))


def cmd_state(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    print("名字   %s\n狀態   %s（daemon phase %s）\n種類   %s（eca 資料夾 %s）\n工作區 %s\n小格   %s\n對話   %s" % (
        r["name"], label(r), r["phase"], r["kind"], r["template"], r["ws"], r["cell"], session_of(r) or "（還沒有）"))


def cmd_open(argv):
    opts, arg = parse(argv, flags=("--name", "--ws"), switches=("-d",))
    r = find(arg)
    if r is not None and ("--name" in opts or "--ws" in opts):
        die("ArgumentsBad", "%s 已經有了；--name、--ws 只在 open 新建（給 eca 資料夾）時用" % r["name"])
    if r is None:                                        # 認不出：是 eca 資料夾就先 add，等子 loop 跑第一次（寫 eca.json）
        if not is_eca(arg):
            die("InstanceMissing", "%s 不是外部 agent 的名字或工作區，也不是 eca 資料夾（沒有 cli.json）" % (arg or os.getcwd()))
        name, _ = do_add(opts, arg)
        r = wait_for(lambda: next((x for x in instances() if x["name"] == name), None), "%s 的子 loop 還沒跑起來" % name)
    if r["ended"]:                                       # 有小格、沒掛在 daemon 上：只開畫面，不替人 start
        print("%s: 注意 %s 沒掛在 daemon 上（%s），aos-say 的信不會有人答；要接著答用 aos-eca start" % (
            PROG, r["name"], label(r)), file=sys.stderr)
    cell = cli_session.Cell(cli_cell(r))
    cli_session.note_cell(cell, r["template"], r["ws"])  # open_cell 照 tool.txt（定義）、ws.txt 開
    opened = cli_session.open_cell(cell)                 # 正在答題就等它答完（格的 lock）、等畫面穩
    if opts.get("-d"):
        print("畫面%s：%s" % ("開好了（有對話就是 --resume 叫回）" if opened else "本來就開著", cell.file("tty.sock")))
        return
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    print("接進 %s（Ctrl-] 跳出、實例不結束）" % r["ws"], file=sys.stderr)
    os.execvpe("tmux", ["tmux", "-S", cell.file("tty.sock"), "attach", "-t", cli_session.TMUX_SESSION], env)


def close_screen(it):
    """關畫面；正在答題（格的 lock 被拿著）＝SessionBad。回 True＝本來開著。"""
    cell = cli_session.Cell(cli_cell(it))
    f, ok = cell.lock()
    with f:
        if not ok:
            raise Busy(it)
        return cli_session.close(cell)


class Busy(Exception):
    def __init__(self, it):
        super().__init__("%s 正在答題，等它答完再收" % it["name"])


def cmd_close(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    try:
        closed = close_screen(r)
    except Busy as e:
        die("SessionBad", e)
    print("收起了" if closed else "本來就沒畫面（已收起）")
    if r["ended"]:                                       # close 只管畫面（11-02 晚第二輪）；掛回 daemon 是 start 的事
        print("%s: 注意 %s 沒掛在 daemon 上（%s）；要接著答用 aos-eca start" % (PROG, r["name"], label(r)), file=sys.stderr)


def queued(it):
    """queue 裡還沒答的信：new/ 加 cur/ 幾封。"""
    n = 0
    for sub in ("new", "cur"):
        try:
            n += len([x for x in os.listdir(os.path.join(it["cell"], "queue", sub)) if not x.startswith(".")])
        except OSError:
            pass
    return n


def take_down(it):
    """關畫面（正在答題＝SessionBad）；還掛在 daemon 上就 aos-daemon-ctl rm、等它收掉。"""
    try:
        close_screen(it)
    except Busy as e:
        die("SessionBad", e)
    if it["ended"]:
        return False
    ctl("rm", it["name"])                                # aos-daemon-ctl 順手拿掉指到小格的 <ws>/.stack symlink
    wait_for(lambda: gone(it["name"]), "daemon 還沒收掉 %s" % it["name"])
    return True


def points_into(link, cell):
    """link 是 symlink、指到 cell 或 cell 裡面。"""
    cell = os.path.realpath(cell)
    return os.path.islink(link) and (os.path.realpath(link) + os.sep).startswith(cell + os.sep)


def cmd_start(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    if not r["ended"]:
        print("本來就掛著（%s）" % label(r))
        return
    if not os.path.isfile(os.path.join(r["template"], "cli.json")):
        die("EcaBad", "%s 沒有 cli.json（eca.json 記的 eca 資料夾不在了）" % (r["template"] or "（eca.json 沒記 eca 資料夾）"))
    if rows_named(r["name"]):                            # 還在收的途中（stopping）：等它下表
        wait_for(lambda: not rows_named(r["name"]), "daemon 還沒把 %s 拿掉" % r["name"])
    was = label(r)
    hang(r["ws"], r["name"], r["template"])              # aos-daemon 用回既有小格（只重寫 loop.json），前文、queue 都在
    print("掛回 daemon 了（上次%s），queue 裡 %d 封接著答" % (was, queued(r)))


def cmd_stop(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    if not take_down(r):
        print("本來就沒掛在 daemon 上（%s）" % label(r))
        return
    link = os.path.join(r["ws"], ".stack")
    if r["ws"] and os.path.isdir(r["ws"]) and not os.path.lexists(link):
        try:                                             # ctl rm 拆了捷徑：補回來，cd 進去 aos-say 的信照收在小格的 queue
            os.symlink(r["cell"], link)
        except OSError:
            pass
    print("從 daemon 拿掉了，小格留著（%s）；aos-say 的信照收，aos-eca start 接著答" % r["cell"])


def cmd_rm(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    take_down(r)
    link = os.path.join(r["ws"], ".stack") if r["ws"] else ""
    if link and points_into(link, r["cell"]):
        os.unlink(link)                                  # 還指著小格（或小格裡面；ctl 沒拿掉，例如本來就沒掛著）
    shutil.rmtree(r["cell"])                             # 不封存（使用者 11-02 晚）；CLI 自己存的對話檔（~/.claude/projects…）不動
    print("刪了 %s（小格 %s、工作區的 .stack 捷徑）" % (r["name"], r["cell"]))


def describe(ev):
    """live.jsonl 一行 → 給人看的短行（claude stream-json、codex --json）；不認得的＝None。"""
    t = ev.get("type")
    if t == "system" and ev.get("subtype") == "init":
        return "── 開始（對話 %s，模型 %s）" % ((ev.get("session_id") or "")[:8], ev.get("model"))
    if t == "assistant":
        out = []
        for c in (ev.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                out.append(c["text"].strip())
            elif c.get("type") == "tool_use":
                out.append("  ▶ %s %s" % (c.get("name"), json.dumps(c.get("input"), ensure_ascii=False)[:120]))
        return "\n".join(out) or None
    if t == "user":
        for c in (ev.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                body = c.get("content")
                body = body if isinstance(body, str) else json.dumps(body, ensure_ascii=False)
                return "  ◀ %s" % body.replace("\n", " ")[:120]
    if t == "result":
        return "── 結束（%s，%.4f 美元）" % ("出錯" if ev.get("is_error") else "完成", ev.get("total_cost_usd") or 0)
    if t in ("item.completed", "item.started") and isinstance(ev.get("item"), dict):
        item = ev["item"]
        return "  %s %s" % (item.get("type") or item.get("item_type"), (item.get("text") or item.get("command") or "")[:120])
    if t == "turn.completed":
        return "── 結束"
    return None


def cmd_watch(argv):
    _, arg = parse(argv)
    path = os.path.join(cli_cell(resolve(arg)), "live.jsonl")
    pos = os.path.getsize(path) if os.path.exists(path) else 0
    print("（跟著看 %s；Ctrl-C 離開）" % path, file=sys.stderr, flush=True)
    try:
        while True:
            try:
                with open(path, "rb") as f:
                    f.seek(pos)
                    data = f.read()
            except OSError:
                data = b""
            end = data.rfind(b"\n") + 1
            pos += end
            for line in data[:end].decode("utf-8", "replace").splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                s = describe(ev) if isinstance(ev, dict) else None
                if s:
                    print(s, flush=True)
                if isinstance(ev, dict) and ev.get("type") in ("result", "turn.completed"):
                    return
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass


CMDS = {"add": cmd_add, "rm": cmd_rm, "start": cmd_start, "stop": cmd_stop, "open": cmd_open, "close": cmd_close,
        "ls": cmd_ls, "state": cmd_state, "status": cmd_state, "watch": cmd_watch}   # status＝state 的別名（11-03）


def main():
    global DAEMON
    a = sys.argv[1:]
    while a and (a[0] == "--daemon-stack" or a[0].startswith("--daemon-stack=")):
        if a[0] == "--daemon-stack":
            if len(a) < 2:
                die("ArgumentsBad", "--daemon-stack 要一個值")
            DAEMON, a = a[1], a[2:]
        else:
            DAEMON, a = a[0][len("--daemon-stack="):], a[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    if a[0].startswith("-"):
        die("FlagUnknown", "不認得的旗標 %s（子命令前只認 --daemon-stack）" % a[0])
    if a[0] not in CMDS:
        die("CommandUnknown", "不認得的子命令 %s（%s）" % (a[0], "、".join(CMDS)))
    CMDS[a[0]](a[1:])


if __name__ == "__main__":
    main()
