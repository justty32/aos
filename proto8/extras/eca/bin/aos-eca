#!/usr/bin/env python3
"""aos-eca（11-03 前叫 aos-eca-hub、aos-eca-ctl；使用者「好像也不用aos-eca-ctl，改成aos-eca就好。」）- 管掛在 aos-daemon 底下的外部 coding agent（claude／codex）：建立／刪除、掛上／拿下 daemon、開／關畫面、列出（10-30 eca）。
每個子命令只管一隻（使用者 11-03「我預期aos-eca xxx這條指令，就是針對單個eca」）；管所有 eca 的事等以後的 aos-eca-hub（ls 暫時留著）。

三對指令（使用者 11-02 晚「很好，所以三個對應：open/close, start/stop, add/remove」，11-03「統一成add/rm吧」）：open／close＝畫面，
start／stop＝daemon 的起停（11-03 procs 起＝aos-daemon-ctl start／stop：stop 後還在 daemon 表上、phase stopped、stack 留著），
add／rm＝建立與刪除（rm＝aos-daemon-ctl rm＋刪它的 stack、不封存）。

    aos-eca [--daemon-stack D] add [--name N] [--ws WS] [--stack S] XXX   建立：XXX＝eca 資料夾（頂層有 cli.json，例 proto8/demo/eca-claude）；
                                                   掛到 daemon（aos-daemon-ctl add --ws WS --name N [--stack S] XXX）；印它的 stack
    aos-eca ls    [--json]                         列外部 agent（掛著的、停了的）：名字、狀態、畫面、種類、工作區、session（對話 id 前 8 碼）；
                                                   狀態 running／paused／stopping／stopped、畫面 open／closed（11-03 起英文，procs § 0 名詞表）
    aos-eca state [資料夾|名字]                    這裡有沒有外部 agent（掛著或停了；沒有＝InstanceMissing、退 1）；11-03 起多印一行工具箱（登記檔）
    aos-eca status [資料夾|名字]                   同 state（別名、行為一樣；11-03 使用者「status和state兩個指令都可以」）
    aos-eca open  [-d] [--name N] [--ws WS] [--stack S] [名字|資料夾|XXX]   接進畫面（沒開就開、有對話就 --resume）；認不出、是 eca 資料夾＝先 add 再開
    aos-eca close [資料夾|名字]                    收起：關畫面、對話留著（aos-eca-turn 照樣用 --resume 答）；只管畫面、不碰 daemon
    aos-eca start [資料夾|名字]                    再起（aos-daemon-ctl start）：停了的用同一個 stack 起來，接著答 queue 裡的信
    aos-eca stop  [資料夾|名字]                    停（aos-daemon-ctl stop）、關畫面：答完手上這題就停，還在 daemon 表上（stopped）、stack 原樣留
    aos-eca rm    [資料夾|名字]                    刪除：關畫面、從 daemon 拿掉（aos-daemon-ctl rm）、刪它的 stack（不封存；要留的先自己複製）
    aos-eca watch [資料夾|名字]                    跟著看非互動那次在做什麼（小格的 live.jsonl），到一次回答結束就走

資料夾的意思：add（和 open 新建的那條）的 XXX＝eca 本身（同 aos-daemon-ctl add XXX）；其他子命令的資料夾＝工作區（或小格裡面）。
  名字、資料夾都認時先比名字；都沒給＝cwd 當資料夾。
設計：proto8/thinking/2026-10-30-eca.md C 結論 7～10（daemon＋三件 daemon 做不到的事：畫面、對話接回、CLI 自己的 session 檔）；11-03 改動見 eca 18。
沒有自己的常駐 kernel：常駐的是 aos-daemon（信箱模式），以它的 procs_state.json 為準（衝突 2）；每個子命令都是
「叫 aos-daemon-ctl ＋ 動它 stack 裡 cli_session 的東西」。哪個 daemon＝--daemon-stack ＞ $AOS_DAEMON_STACK（同 aos-daemon-ctl，11-02 從 --daemon／AOS_DAEMON 改名；沒設、不是資料夾、
daemon 沒在跑〔procs_state.json 的 pid＋started_at_ticks 對不上〕＝DaemonMissing）。不另設 hub 的環境變數（10-28 那個退場，衝突 4）。
add：名字沒給＝XXX 的資料夾名；--ws 沒給＝cwd（就是 claude 的 cwd）；--stack 沒給＝daemon 的預設小格 <daemon>/procs/<名字>/，給了＝從呼叫的 cwd
  轉絕對、照傳給 aos-daemon-ctl add --stack（不驗在不在，daemon 起它時建；空＝ArgumentsBad；11-03 使用者「aos-eca add沒辦法指定stack嗎？」）。
  撞名＝InstanceExists、退 1、不送信：daemon 表上已有這個名字（不論是不是 eca、running／stopping／stopped）——換 --name，或先 aos-eca rm；
  表上是停了的 eca＝要接著用就 aos-eca start。表上沒有的不算撞名（舊 stack 資料夾還在也不擋：照用，前文接著，使用者自己承擔）。
「一隻外部 agent」＝daemon 的 procs 表上、它的 stack（那一列的 stack，11-03 procs）裡有 eca.json 的（aos-eca-turn 每次跑都寫：kind、ws、template〔＝eca 資料夾〕）；
  add 之後子 loop 跑第一次才有。stack 一律從表上那一列拿，不自己拼 <daemon>/procs/<名字>。
  狀態（ls、state 印的；11-03 起英文）：表上的 phase running＝running（子 loop 的 state.json 是 paused＝paused，aos-daemon-ctl pause 的；讀不到當 running）、
  stopping、stopped（aos-eca stop／aos-daemon-ctl stop 停的，start 叫得回）。畫面另一欄：open／closed（aos-eca open／close）。
  自己結束的（CLI 出錯退 1、外部直接寫它 ctl.json 的 {"cmd": "stop"}）daemon 照 11-02 從表上拿掉＝對 daemon、對這支都不在了（procs 衝突 2
  使用者「照舊拿掉」）：ls 不列、state／start／rm＝InstanceMissing；它的 stack 資料夾留著，要接著用＝同名再 add（同一個 --stack 或預設小格，前文、queue 都在），
  不要了自己 rm -r。所以掛在 daemon 下要停就用 aos-eca stop。
CLI 的小格＝<stack>/<kind>/（cli_session 的 session.txt、tty.sock、live.jsonl、transcripts/）。
對它說話（11-03 起工作區不建 .stack 捷徑，thinking 2026-11-03-stack-where）：aos-say --stack $(aos-daemon-ctl where --stack 名字) 話 && aos-listen --stack …；
  停著（stopped）時 where 照找得到，信排在 queue，start 後接著答。
畫面裡按 Ctrl-]（或 Ctrl-\\）＝跳出、實例不結束。「暫停」＝aos-daemon-ctl pause／resume（寫它 stack 裡的 ctl.json），這裡不另做。
錯：stderr 一行 `aos-eca: 代號 原因`、退 1。代號：ArgumentsBad、FlagUnknown、CommandUnknown、DaemonMissing、InstanceMissing、
  InstanceExists（add 撞名）、PathMissing（XXX、--ws 不在或不是資料夾）、EcaBad（XXX 沒有 cli.json）、
  CfgBad／ToolsMissing（add、open 新建時 XXX 的 cli.json 壞、tools 指的登記檔不在；11-03 eca-tools，不送信）、SessionBad（正在答題時 close、stop、rm）、
  Timeout（等 daemon 放上表、停好、收掉逾時），加 aos-daemon-ctl 與 cli_session 的。"""
import json, os, shutil, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.normpath(os.path.join(HERE, "..", "..", ".."))           # proto8/
CTL = os.path.join(ROOT, "bin", "aos-daemon-ctl")
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(ROOT, "lib", "agent"))
import cli_session  # noqa: E402

PROG = "aos-eca"
WAIT_S = 30                                     # add／stop／rm／start 等 daemon 的上限（daemon 的 grace 是 10 秒）


def die(code, msg):
    print("%s: %s %s" % (PROG, code, str(msg).replace("\n", " ")), file=sys.stderr)
    sys.exit(1)


cli_session.PROG = PROG                         # cli_session 出錯時那一行用這支的名字


def parse(argv, flags=(), switches=()):
    opts, rest, it = {}, [], iter(argv)
    for a in it:
        name, eq, val = a.partition("=")
        if name in flags:
            v = val if eq else next(it, None)
            if v is None:
                die("ArgumentsBad", "%s 要一個值" % a)
            opts[name] = v
        elif a in switches:
            opts[a] = True
        elif a.startswith("-") and a != "-":
            die("FlagUnknown", a)
        else:
            rest.append(a)
    if len(rest) > 1:
        die("ArgumentsBad", "多給了 %s" % rest[1])
    return opts, (rest[0] if rest else None)


# ---------------------------------------------------------------- daemon（經 aos-daemon-ctl）

DAEMON = None                                   # main 裡從 --daemon-stack／$AOS_DAEMON_STACK 定


def daemon_dir():
    d = DAEMON or os.environ.get("AOS_DAEMON_STACK", "")
    if not d:
        hint = ("；AOS_DAEMON 11-02 起改名，請改設 AOS_DAEMON_STACK（或 --daemon-stack）"
                if os.environ.get("AOS_DAEMON") else "")
        die("DaemonMissing", "沒給 --daemon-stack、也沒設 AOS_DAEMON_STACK（要指到 aos-daemon 的 $AOS_STACK 資料夾）" + hint)
    if not os.path.isdir(d):
        die("DaemonMissing", "daemon 的資料夾不在：%s" % d)
    d = os.path.abspath(d)
    try:
        with open(os.path.join(d, "procs_state.json"), encoding="utf-8") as f:
            st = json.load(f)
        pid, ticks = int(st["pid"]), st["started_at_ticks"]
        with open("/proc/%d/stat" % pid, encoding="utf-8") as f:
            alive = int(f.read().rpartition(")")[2].split()[19]) == ticks
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        alive = False
    if not alive:
        die("DaemonMissing", "%s 的 aos-daemon 沒在跑（procs_state.json 不在或寫它的行程不在）" % d)
    return d


def ctl(*args):
    """叫 aos-daemon-ctl；錯＝把它那一行換成這支的名字、退 1。回 stdout。stderr 的提醒照轉。"""
    try:
        r = subprocess.run([sys.executable, CTL, "--daemon-stack", daemon_dir()] + list(args), capture_output=True, text=True)
    except OSError as e:
        die("CommandMissing", "叫不了 aos-daemon-ctl：%s" % e)
    if r.returncode != 0:
        line = (r.stderr.strip().splitlines() or ["aos-daemon-ctl: CtlFailed 退 %d" % r.returncode])[-1]
        code, _, why = line.partition(": ")[2].partition(" ")
        die(code or "CtlFailed", why or line)
    if r.stderr:
        sys.stderr.write(r.stderr)
    return r.stdout


def table():
    """daemon 的 procs 表（aos-daemon-ctl ls --json）：{名字: 列}。"""
    return json.loads(ctl("ls", "--json") or "{}").get("procs") or {}


def instances():
    """daemon 的 procs 表上、那一列的 stack 裡有 eca.json 的：[{name, cell, phase, code, pid, kind, ws, template}]（照表的順序）。
    cell＝列上的 stack（11-03 procs；不自己拼 <daemon>/procs/<名字>）。自己結束、下了表的就不在（procs 衝突 2「照舊拿掉」）。"""
    out = []
    for name, r in table().items():
        cell = r.get("stack") if isinstance(r, dict) else None
        if not isinstance(cell, str) or not cell:
            continue
        cell = cell.rstrip("/") or "/"
        try:
            with open(os.path.join(cell, "eca.json"), encoding="utf-8") as f:
                eca = json.load(f)
        except (OSError, ValueError):
            continue
        if not isinstance(eca, dict) or eca.get("kind") not in ("claude", "codex"):
            continue
        out.append(dict(name=name, cell=cell, phase=r.get("phase"), code=r.get("code"), pid=r.get("pid"),
                        kind=eca["kind"], ws=eca.get("ws") or r.get("ws") or "", template=eca.get("template") or ""))
    return out


def cli_cell(it):
    return os.path.join(it["cell"], it["kind"])


def has_screen(it):
    p = cli_cell(it)
    return os.path.exists(os.path.join(p, "tty.sock")) and cli_session.Cell(p).alive()


def session_of(it):
    try:
        with open(os.path.join(cli_cell(it), "session.txt"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def stopped(it):
    """daemon 停掉的（表上 phase stopped；aos-eca stop／aos-daemon-ctl stop）：行程不在、stack 留著，start 叫得回。"""
    return it["phase"] == "stopped"


def loop_paused(it):
    """子 loop 自己的 state.json（stack 裡 loop.json 的 state 那格，沒寫＝state.json）phase 是 paused（aos-daemon-ctl pause 寫的）；讀不到＝False。"""
    try:
        with open(os.path.join(it["cell"], "loop.json"), encoding="utf-8") as f:
            name = json.load(f).get("state")
    except (OSError, ValueError, AttributeError):
        name = None
    try:
        with open(os.path.join(it["cell"], name if isinstance(name, str) and name else "state.json"), encoding="utf-8") as f:
            return json.load(f).get("phase") == "paused"
    except (OSError, ValueError, AttributeError):
        return False


def label(it):
    """狀態（11-03 使用者「能不能改成用英文，就用我們先前的名詞表」＝procs § 0）：running／paused／stopping／stopped。
    paused＝表上 running、子 loop 的 state.json 是 paused（讀不到當 running）；其他 phase 照印。畫面是另一欄（screen_word）。"""
    if it["phase"] == "running":
        return "paused" if loop_paused(it) else "running"
    return it["phase"] or "-"


def screen_word(it):
    """畫面：open／closed（對應 aos-eca open／close；11-03 代定）。"""
    return "open" if has_screen(it) else "closed"


def find(arg, rows=None):
    """名字或資料夾 → 一隻；資料夾比對：工作區相同、或在它的小格裡面。找不到＝None。"""
    rows = instances() if rows is None else rows
    for r in rows:
        if arg and r["name"] == arg:
            return r
    d = os.path.abspath(arg or ".")
    hit = [r for r in rows if r["ws"] == d or d == r["cell"] or d.startswith(r["cell"] + os.sep)]
    if len(hit) > 1:
        die("ArgumentsBad", "%s 有 %d 隻掛著，用名字指定（aos-eca ls）" % (d, len(hit)))
    return hit[0] if hit else None


def resolve(arg):
    r = find(arg)
    if r is None:
        die("InstanceMissing", "%s 不是外部 agent（不在 daemon 表上：aos-eca add 或 open 建立；rm 過的、自己結束下了表的就沒了）" % (arg or os.getcwd()))
    return r


def is_eca(xxx):
    return bool(xxx) and os.path.isfile(os.path.join(xxx, "cli.json"))


def eca_dir(xxx):
    """add 的 XXX：eca 資料夾（頂層有 cli.json）→ 絕對路徑。不在＝PathMissing、沒有 cli.json＝EcaBad；
    cli.json 讀不懂、tools 指的登記檔不在＝cli_session 的 CfgBad／ToolsMissing（11-03 eca-tools：入口先檢查、不送信，
    免得要等 daemon 起子 loop、aos-eca-turn 退 1 才看得到）。登記檔的內容不在這裡查（aos-mcp 起來時的事）。"""
    if not os.path.isdir(xxx):
        die("PathMissing", "沒有 %s（add 要一個 eca 資料夾，例 proto8/demo/eca-claude）" % xxx)
    if not is_eca(xxx):
        die("EcaBad", "%s 沒有 cli.json（不是外部 coding agent）" % xxx)
    cli_session.load_cfg(xxx)
    return os.path.abspath(xxx)


def toolbox(template):
    """state 印的工具箱：eca 資料夾的登記檔絕對路徑；沒有＝（沒有）；cli.json 壞了＝括號裡寫 cli_session 的那一行（state 不因此退 1）。"""
    def soft(code, reason):
        raise RuntimeError("%s %s" % (code, str(reason).replace("\n", " ")))
    old, cli_session.die = cli_session.die, soft
    try:
        return cli_session.load_cfg(template).get("registry") or "（沒有）"
    except RuntimeError as e:
        return "（%s）" % e
    finally:
        cli_session.die = old


def wait_for(cond, what, secs=WAIT_S):
    end = time.time() + secs
    while time.time() < end:
        v = cond()
        if v:
            return v
        time.sleep(0.1)
    die("Timeout", "等了 %d 秒，%s" % (secs, what))


def row_named(name):
    """daemon 表上這個名字的那一列；沒有＝None。"""
    return table().get(name)


def stack_of(row):
    return row["stack"].rstrip("/") or "/"


def hang(ws, name, xxx, stack=None):
    """掛上（aos-daemon-ctl add [--stack S]），等 daemon 把它放上表（信是下一圈才套；對它說話要 aos-daemon-ctl where，只認表上的）。
    回它的 stack（列上的）。小格殘留的 {"cmd": "stop"} 不用清（11-03 ctl 改指令：子 loop 起來第一次讀的 ctl 當基準線、不執行）。"""
    ctl("add", "--ws", ws, "--name", name, *(["--stack", stack] if stack else []), xxx)
    row = wait_for(lambda: row_named(name), "daemon 還沒把 %s 放上表（或起來就結束、下了表；看 daemon 的 log）" % name)
    return stack_of(row)


def do_add(opts, xxx):
    """add：XXX＝eca 資料夾；--name 沒給＝XXX 的資料夾名，--ws 沒給＝cwd，--stack 沒給＝daemon 的預設小格（給了從 cwd 轉絕對）。
    撞名（daemon 表上已有這個名字，不論是不是 eca）＝InstanceExists、不送信。"""
    if not xxx:
        die("ArgumentsBad", "add 要一個 eca 資料夾 XXX（aos-eca add [--name N] [--ws WS] [--stack S] XXX）")
    xxx = eca_dir(xxx)
    ws = os.path.abspath(opts.get("--ws") or ".")
    if not os.path.isdir(ws):
        die("PathMissing", "--ws 不是資料夾：%s" % ws)
    stack = opts.get("--stack")
    if stack is not None:
        if not stack:
            die("ArgumentsBad", "--stack 不能是空的")
        stack = os.path.abspath(stack)                   # 從呼叫當下的 cwd 算（同 --ws）；在不在不驗，daemon 起它時建
    name = opts.get("--name") or os.path.basename(xxx.rstrip("/"))
    row = row_named(name)
    if row is not None:
        hint = "；它停著，要接著用就 aos-eca start %s" % name if isinstance(row, dict) and row.get("phase") == "stopped" else ""
        die("InstanceExists", "daemon 上已經有 %s 了；換個名字（--name），或先 aos-eca rm %s%s" % (name, name, hint))
    return name, hang(ws, name, xxx, stack)


# ---------------------------------------------------------------- 子命令

def cmd_add(argv):
    opts, arg = parse(argv, flags=("--name", "--ws", "--stack"))
    print(do_add(opts, arg)[1])


def cmd_ls(argv):
    opts, _ = parse(argv, switches=("--json",))
    rows = instances()
    if opts.get("--json"):
        print(json.dumps([dict(r, state=label(r), screen=screen_word(r), session=session_of(r)) for r in rows],
                         ensure_ascii=False))
        return
    for r in rows:
        print("%-12s %-8s %-6s %-6s %s  session %s" % (r["name"], label(r), screen_word(r), r["kind"], r["ws"],
                                                        session_of(r)[:8] or "-"))


def cmd_state(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    print("名字   %s\n狀態   %s（daemon phase %s）\n畫面   %s\n種類   %s（eca 資料夾 %s）\n工作區 %s\nstack  %s\n工具箱 %s\n對話   %s" % (
        r["name"], label(r), r["phase"], screen_word(r), r["kind"], r["template"], r["ws"], r["cell"], toolbox(r["template"]),
        session_of(r) or "（還沒有）"))


def cmd_open(argv):
    opts, arg = parse(argv, flags=("--name", "--ws", "--stack"), switches=("-d",))
    r = find(arg)
    if r is not None and ("--name" in opts or "--ws" in opts or "--stack" in opts):
        die("ArgumentsBad", "%s 已經有了；--name、--ws、--stack 只在 open 新建（給 eca 資料夾）時用" % r["name"])
    if r is None:                                        # 認不出：是 eca 資料夾就先 add，等子 loop 跑第一次（寫 eca.json）
        if not is_eca(arg):
            die("InstanceMissing", "%s 不是外部 agent 的名字或工作區，也不是 eca 資料夾（沒有 cli.json）" % (arg or os.getcwd()))
        name, _ = do_add(opts, arg)
        r = wait_for(lambda: next((x for x in instances() if x["name"] == name), None), "%s 的子 loop 還沒跑起來" % name)
    if stopped(r):                                       # 停著：只開畫面，不替人 start
        print("%s: 注意 %s 停著（%s），aos-say 的信不會有人答；要接著答用 aos-eca start" % (
            PROG, r["name"], label(r)), file=sys.stderr)
    cell = cli_session.Cell(cli_cell(r))
    cli_session.note_cell(cell, r["template"], r["ws"], r["cell"])   # open_cell 照 tool.txt（定義）、ws.txt、stack.txt（給 aos-mcp，11-03 eca-tools）開
    opened = cli_session.open_cell(cell)                 # 正在答題就等它答完（格的 lock）、等畫面穩
    if opts.get("-d"):
        print("畫面%s：%s" % ("開好了（有對話就是 --resume 叫回）" if opened else "本來就開著", cell.file("tty.sock")))
        return
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    print("接進 %s（Ctrl-] 跳出、實例不結束）" % r["ws"], file=sys.stderr)
    os.execvpe("tmux", ["tmux", "-S", cell.file("tty.sock"), "attach", "-t", cli_session.TMUX_SESSION], env)


def close_screen(it):
    """關畫面；正在答題（格的 lock 被拿著）＝SessionBad。回 True＝本來開著。"""
    cell = cli_session.Cell(cli_cell(it))
    f, ok = cell.lock()
    with f:
        if not ok:
            raise Busy(it)
        return cli_session.close(cell)


class Busy(Exception):
    def __init__(self, it):
        super().__init__("%s 正在答題，等它答完再收" % it["name"])


def cmd_close(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    try:
        closed = close_screen(r)
    except Busy as e:
        die("SessionBad", e)
    print("收起了" if closed else "本來就沒畫面（已收起）")
    if stopped(r):                                       # close 只管畫面（11-02 晚第二輪）；再起是 start 的事
        print("%s: 注意 %s 停著（%s）；要接著答用 aos-eca start" % (PROG, r["name"], label(r)), file=sys.stderr)


def queued(it):
    """queue 裡還沒答的信：new/ 加 cur/ 幾封。"""
    n = 0
    for sub in ("new", "cur"):
        try:
            n += len([x for x in os.listdir(os.path.join(it["cell"], "queue", sub)) if not x.startswith(".")])
        except OSError:
            pass
    return n


def shut_screen(it):
    """關畫面；正在答題（格的 lock 被拿著）＝SessionBad。"""
    try:
        close_screen(it)
    except Busy as e:
        die("SessionBad", e)


def cmd_start(argv):
    """start＝aos-daemon-ctl start（11-03 procs）：停了的用同一個 stack 再起（daemon 照原本 add 的設定，前文、queue 都在）。"""
    _, arg = parse(argv)
    r = resolve(arg)
    if r["phase"] == "stopping":                         # 還在停的途中：等它停好再起
        wait_for(lambda: (row_named(r["name"]) or {}).get("phase") != "stopping", "daemon 還沒把 %s 停好" % r["name"])
        r = resolve(r["name"])
    if not stopped(r):
        print("本來就在跑（%s）" % label(r))
        return
    n = queued(r)                                        # 起來之前數（等它起來時可能已經答起來了）
    ctl("start", r["name"])
    wait_for(lambda: (row_named(r["name"]) or {}).get("phase") != "stopped", "daemon 還沒把 %s 起來" % r["name"])
    print("起來了（同一個 stack），queue 裡 %d 封接著答" % n)


def cmd_stop(argv):
    """stop＝關畫面＋aos-daemon-ctl stop（11-03 procs）：答完手上這題就停，還在 daemon 表上（stopped），where 找得到、aos-say 照收。"""
    _, arg = parse(argv)
    r = resolve(arg)
    shut_screen(r)
    if stopped(r):
        print("本來就停著（%s）" % label(r))
        return
    if r["phase"] != "stopping":
        ctl("stop", r["name"])
    wait_for(lambda: (row_named(r["name"]) or {"phase": "stopped"}).get("phase") == "stopped", "daemon 還沒把 %s 停好" % r["name"])
    print("停了，stack 留著（%s）；這期間 aos-say --stack $(aos-daemon-ctl where --stack %s) 的信照收，aos-eca start 接著答" % (r["cell"], r["name"]))


def cmd_rm(argv):
    """rm＝關畫面＋aos-daemon-ctl rm（先停再拿掉）、等它下表，再刪它的 stack（列上的；不封存）。"""
    _, arg = parse(argv)
    r = resolve(arg)
    shut_screen(r)
    ctl("rm", r["name"])
    wait_for(lambda: row_named(r["name"]) is None, "daemon 還沒收掉 %s" % r["name"])
    shutil.rmtree(r["cell"])                             # 不封存（使用者 11-02 晚）；CLI 自己存的對話檔（~/.claude/projects…）不動
    print("刪了 %s（stack %s）" % (r["name"], r["cell"]))


def describe(ev):
    """live.jsonl 一行 → 給人看的短行（claude stream-json、codex --json）；不認得的＝None。"""
    t = ev.get("type")
    if t == "system" and ev.get("subtype") == "init":
        return "── 開始（對話 %s，模型 %s）" % ((ev.get("session_id") or "")[:8], ev.get("model"))
    if t == "assistant":
        out = []
        for c in (ev.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                out.append(c["text"].strip())
            elif c.get("type") == "tool_use":
                out.append("  ▶ %s %s" % (c.get("name"), json.dumps(c.get("input"), ensure_ascii=False)[:120]))
        return "\n".join(out) or None
    if t == "user":
        for c in (ev.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                body = c.get("content")
                body = body if isinstance(body, str) else json.dumps(body, ensure_ascii=False)
                return "  ◀ %s" % body.replace("\n", " ")[:120]
    if t == "result":
        return "── 結束（%s，%.4f 美元）" % ("出錯" if ev.get("is_error") else "完成", ev.get("total_cost_usd") or 0)
    if t in ("item.completed", "item.started") and isinstance(ev.get("item"), dict):
        item = ev["item"]
        return "  %s %s" % (item.get("type") or item.get("item_type"), (item.get("text") or item.get("command") or "")[:120])
    if t == "turn.completed":
        return "── 結束"
    return None


def cmd_watch(argv):
    _, arg = parse(argv)
    path = os.path.join(cli_cell(resolve(arg)), "live.jsonl")
    pos = os.path.getsize(path) if os.path.exists(path) else 0
    print("（跟著看 %s；Ctrl-C 離開）" % path, file=sys.stderr, flush=True)
    try:
        while True:
            try:
                with open(path, "rb") as f:
                    f.seek(pos)
                    data = f.read()
            except OSError:
                data = b""
            end = data.rfind(b"\n") + 1
            pos += end
            for line in data[:end].decode("utf-8", "replace").splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                s = describe(ev) if isinstance(ev, dict) else None
                if s:
                    print(s, flush=True)
                if isinstance(ev, dict) and ev.get("type") in ("result", "turn.completed"):
                    return
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass


CMDS = {"add": cmd_add, "rm": cmd_rm, "start": cmd_start, "stop": cmd_stop, "open": cmd_open, "close": cmd_close,
        "ls": cmd_ls, "state": cmd_state, "status": cmd_state, "watch": cmd_watch}   # status＝state 的別名（11-03）


def main():
    global DAEMON
    a = sys.argv[1:]
    while a and (a[0] == "--daemon-stack" or a[0].startswith("--daemon-stack=")):
        if a[0] == "--daemon-stack":
            if len(a) < 2:
                die("ArgumentsBad", "--daemon-stack 要一個值")
            DAEMON, a = a[1], a[2:]
        else:
            DAEMON, a = a[0][len("--daemon-stack="):], a[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    if a[0].startswith("-"):
        die("FlagUnknown", "不認得的旗標 %s（子命令前只認 --daemon-stack）" % a[0])
    if a[0] not in CMDS:
        die("CommandUnknown", "不認得的子命令 %s（%s）" % (a[0], "、".join(CMDS)))
    CMDS[a[0]](a[1:])


if __name__ == "__main__":
    main()
