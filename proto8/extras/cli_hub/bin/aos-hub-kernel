#!/usr/bin/env python3
"""aos-hub-kernel - aos-hub 的常駐 kernel：記著所有 claude／codex 實例、替它們回答 stack 裡 queue 的訊息（10-28；10-30 改走 queue）。

    AOS_HUB=資料夾 aos-hub-kernel

$AOS_HUB 沒設＝HubMissing、退 1（不給預設路徑，10-28 決定 10）；那裡已經有一個在跑＝KernelBusy、退 1。
開 $AOS_HUB/kernel.sock，一行 JSON 請求、一行 JSON 回覆（hub_ipc.py）；aos-hub 的指令都經它，它掛了指令就報錯（決定 3）。
狀態以它記的為準（決定 8）：只在記憶體裡，kernel 重開就清空（實際遇到問題再說，10-28）。SIGTERM／SIGINT 收乾淨就走。

實例＝一個小格（cli_session 的格，<資料夾>/.stack/<工具名>/）＋它代答的 queue。資料夾＝CLI 的 cwd（使用者 cd 過去的那個，
例如程式專案）；**對話放在 stack 裡**（使用者 10-28「放Stack比較好。」）：輸入是 <資料夾>/.stack/queue/（N-16 有順序信箱，
10-30 agent-lifecycle A-9），紀錄是 <資料夾>/.stack/history.jsonl（P-41 一行一則 OpenAI message），資料夾本身不長東西。兩種來路：
  aos-hub add／open 加的＝**代答**：add 時 aos-post init 那個 queue；kernel 一封封 aos-post claim（cur/ 有沒答完的先接，P-12）、
    aos-post check 讀信——body＝一則 {"role": "user", "content": 字串}（不是就算壞信：aos-post finish 丟掉、trace 記 letter_warning，
    衝突 5）——body 原樣接進 history（最後一行已是同一則就不接兩次：重試、kernel 重開），content 交給工具（lib/agent/claude 的
    _entry：stdin {"prompt"} → stdout 回答；畫面開著就打進畫面、沒開就 --resume 問一次，這是 cli_session 本來的兩條路），
    回答接成一則 {"role": "assistant", "content": 回答} 進 history，才 aos-post finish 那封信（刪掉）。回答就是 history 最新那則
    assistant，沒有 out/（A-6）。每封在 stack 的 trace.jsonl 接一行（question＝信號）；stack 放 server.txt（「<pid> aos-hub-kernel」），
    aos-listen 靠它知道有人在服務。一個實例同時只答一封；實例之間不限數量（決定 4）。aos-post 要在 PATH 上（叫的人放）。
  agent 叫 claude／codex 工具時 cli_session 送來的 register＝**只登記**：列得到、接得進去，不替它收題（那個工作區的題是 agent 的）。
答題失敗：信留在 queue/cur/、實例標「出錯」不再收題，等人 aos-hub close／open 一次才再收（P-20 停下等人）；
工具回 SessionBad（有人接在畫面上、畫面正在跑一輪）不算錯，5 秒後再試。
close＝關畫面、對話 id 留著（之後題目照樣用 --resume 答；10-30 由 pause 改名，paused 留給 N-07）；stop＝關畫面、把小格搬到
$stack/hub_archive/<工具名>-<UTC>/、小格 transcripts/ 裡指到 CLI 自己對話檔的 symlink 換成真的複製、從清單拿掉（決定 5、6；10-30 C-16）。"""
import datetime, json, os, signal, socket, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path[:0] = [HERE, os.path.join(HERE, "..", "..", "..", "lib", "agent")]
import hub_ipc  # noqa: E402
import cli_session  # noqa: E402

PROG = "aos-hub-kernel"
POLL, RETRY = 0.3, 5.0


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def _die(code, reason):                           # cli_session 出錯時本來 exit；在 kernel 裡改成丟例外回給叫的人
    raise Fail(code, str(reason).replace("\n", " "))


cli_session.die = _die


def now():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")


def post(*args):
    """叫 aos-post（N-16 投遞）；起不來＝PostMissing。回 CompletedProcess。"""
    try:
        return subprocess.run(["aos-post"] + list(args), stdin=subprocess.DEVNULL, capture_output=True, text=True)
    except OSError as e:
        raise Fail("PostMissing", "aos-post 起不來（要在 PATH 上）：%s" % e)


def first_line(r):
    return ((r.stderr or r.stdout).strip().splitlines() or ["退 %d、沒說原因" % r.returncode])[0]


def kind_of(tool):
    try:
        with open(os.path.join(tool, "cli.json"), encoding="utf-8") as f:
            return json.load(f).get("kind") or "?"
    except (OSError, ValueError):
        return "?"


class Kernel:
    def __init__(self, hub):
        self.hub, self.lock, self.items = hub, threading.Lock(), {}      # items：小格路徑 → 實例

    # ------------------------------------------------------------ 請求
    def handle(self, req):
        op = req.get("op")
        fn = getattr(self, "op_" + str(op), None)
        if fn is None:
            raise Fail("ArgumentsBad", "不認得的請求 %r" % op)
        return fn(req) or {}

    def find(self, req):
        cell = req.get("cell")
        with self.lock:
            if cell in self.items:
                return self.items[cell]
        raise Fail("InstanceMissing", "kernel 沒記這一格：%s" % cell)

    def op_register(self, req):
        with self.lock:
            it = self.items.get(req["cell"])
            if it is None:
                self.items[req["cell"]] = dict(cell=req["cell"], ws=req["ws"], tool=req["tool"], kind=kind_of(req["tool"]),
                                               serve=False, screen="closed", error=None, busy=None, retry_at=0, since=now())

    def op_add(self, req):
        ws, tool = os.path.abspath(req["ws"]), os.path.abspath(req["tool"])
        if not os.path.isdir(ws):
            raise Fail("WsMissing", ws)
        if not os.path.isfile(os.path.join(tool, "cli.json")):
            raise Fail("ToolUnknown", "%s 沒有 cli.json" % tool)
        stack = os.path.join(ws, ".stack")
        cell = os.path.join(stack, os.path.basename(tool))
        with self.lock:
            for it in self.items.values():
                if it["serve"] and it["ws"] == ws and it["cell"] != cell:
                    raise Fail("InstanceBusy", "這個資料夾已經有代答的實例（%s）；一個資料夾一個（P-18）" % it["cell"])
            it = self.items.get(cell)
            if it is None:
                it = self.items[cell] = dict(cell=cell, ws=ws, tool=tool, kind=kind_of(tool), serve=True, screen="closed",
                                             error=None, busy=None, retry_at=0, since=now())
            it["serve"] = True
        r = post("init", os.path.join(stack, "queue"))             # queue 放 stack 裡（10-28「放Stack比較好。」、10-30 A-2）
        if r.returncode != 0:
            raise Fail("PostFailed", "aos-post init：%s" % first_line(r))
        cli_session.register(cli_session.Cell(cell), tool, ws)     # 寫 tool.txt、ws.txt（open_cell 要）；送回自己的 register 無妨
        with open(os.path.join(stack, ".server.txt"), "w", encoding="utf-8") as f:
            f.write("%d %s\n" % (os.getpid(), PROG))
        os.replace(os.path.join(stack, ".server.txt"), os.path.join(stack, "server.txt"))
        return {"cell": cell}

    def op_ls(self, req):
        with self.lock:
            return {"items": [dict(it) for it in self.items.values()]}

    def op_open(self, req):
        it = self.find(req)
        cell = cli_session.Cell(it["cell"])
        opened = cli_session.open_cell(cell)            # 要等格的 lock（正在答題就等它答完）、等畫面穩
        with self.lock:
            it["screen"], it["error"] = "open", None
        return {"opened": opened, "sock": cell.file("tty.sock")}

    def op_close(self, req):
        it = self.find(req)
        with self.lock:
            if it["busy"]:
                raise Fail("SessionBad", "正在答 %s，等它答完再 close" % it["busy"])
        closed = cli_session.close(cli_session.Cell(it["cell"]))
        with self.lock:
            it["screen"], it["error"] = "closed", None
        return {"closed": closed}

    def op_stop(self, req):
        it = self.find(req)
        with self.lock:
            if it["busy"]:
                raise Fail("SessionBad", "正在答 %s，等它答完再 stop" % it["busy"])
            it["serve"] = False                          # 先不收新題
            del self.items[it["cell"]]
        cell = cli_session.Cell(it["cell"])
        cli_session.close(cell)
        stack = os.path.dirname(it["cell"])
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        dest = os.path.join(stack, "hub_archive", "%s-%s" % (os.path.basename(it["cell"]), stamp))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        os.rename(it["cell"], dest)                      # transcripts/ 的 symlink 指絕對路徑，跟著搬
        copied = cli_session.freeze_transcripts(cli_session.Cell(dest), it["kind"])   # symlink 換成真的複製（10-30 C-16）
        self.drop_marker(stack)
        return {"archive": dest, "transcripts": copied}

    def op_shutdown(self, req):
        threading.Thread(target=lambda: (time.sleep(0.1), os.kill(os.getpid(), signal.SIGTERM)), daemon=True).start()

    # ------------------------------------------------------------ 代答（agent 對話協議）
    def drop_marker(self, stack):
        with self.lock:
            if any(it["serve"] and os.path.dirname(it["cell"]) == stack for it in self.items.values()):
                return
        try:
            os.remove(os.path.join(stack, "server.txt"))
        except OSError:
            pass

    def pick(self, q):
        """queue/cur/ 有認領了沒答完的先接著做（P-12），否則 new/ 有信才 aos-post claim 一封。回信號或 None。"""
        cur = sorted(n for n in listdir(os.path.join(q, "cur")) if not n.startswith("."))
        if cur:
            return cur[0]
        if not any(not n.startswith(".") for n in listdir(os.path.join(q, "new"))):
            return None                                  # 沒信就不起 aos-post（每 0.3 秒一輪）
        r = post("claim", q)
        return (r.stdout.strip() or None) if r.returncode == 0 else None

    def serve_loop(self):
        while True:
            with self.lock:
                todo = [it for it in self.items.values()
                        if it["serve"] and not it["busy"] and not it["error"] and it["retry_at"] <= time.time()]
            for it in todo:
                try:
                    sig = self.pick(os.path.join(os.path.dirname(it["cell"]), "queue"))   # queue＝實例的 stack 裡
                except (OSError, Fail):
                    sig = None
                if sig:
                    with self.lock:
                        it["busy"] = sig
                    threading.Thread(target=self.answer, args=(it, sig), daemon=True).start()
            time.sleep(POLL)

    def answer(self, it, sig):
        ws, started, t0 = it["ws"], now(), time.monotonic()
        stack = os.path.dirname(it["cell"])              # queue、history、trace 在實例的 stack；ws＝CLI 的 cwd
        q = os.path.join(stack, "queue")
        try:
            r = post("check", q, sig)
            body = json.loads(r.stdout).get("body") if r.returncode == 0 else None
            why = first_line(r) if r.returncode != 0 else "body 要是 {\"role\": \"user\", \"content\": 非空字串}"
            if not (isinstance(body, dict) and body.get("role") == "user" and isinstance(body.get("content"), str)
                    and body["content"].strip()):
                post("finish", q, sig)                   # 壞信照 N-16 丟掉、不通知寄信人（決定 27）
                return self.done(it, sig, started, t0, 0, None, warning=why)
            append_history(stack, body)
        except Fail as e:
            return self.done(it, sig, started, t0, 1, "%s %s" % (e.code, e))
        except (OSError, ValueError, AttributeError) as e:
            return self.done(it, sig, started, t0, 1, "HistoryFailed %s" % e)
        env = dict(os.environ, AOS_WS=ws, AOS_STACK=it["cell"] + "/")
        env.pop("AOS_ENTRY", None)
        try:
            r = subprocess.run([os.path.join(it["tool"], "_entry")], input=json.dumps({"prompt": body["content"]}),
                               text=True, capture_output=True, cwd=ws, env=env)
        except OSError as e:
            return self.done(it, sig, started, t0, 1, "ToolFailed %s" % e)
        if r.returncode != 0:
            return self.done(it, sig, started, t0, r.returncode, (r.stdout or r.stderr).strip().splitlines()[0:1])
        text = r.stdout[:-1] if r.stdout.endswith("\n") else r.stdout     # 工具保證結尾一個換行；那個不算回答
        try:
            append_history(stack, {"role": "assistant", "content": text})
            f = post("finish", q, sig)                   # 回答已在 history 才收信（A-5）
        except (OSError, Fail) as e:
            return self.done(it, sig, started, t0, 1, "HistoryFailed %s" % e)
        if f.returncode != 0:
            return self.done(it, sig, started, t0, 1, "PostFailed aos-post finish：%s" % first_line(f))
        self.done(it, sig, started, t0, 0, None)

    def done(self, it, sig, started, t0, code, err, warning=None):
        if isinstance(err, list):
            err = err[0] if err else "退 %d、沒說原因" % code
        line = {"state": PROG, "question": sig, "code": code, "started_at": started,
                "elapsed_ms": int((time.monotonic() - t0) * 1000)}
        if err:
            line["error"] = err
        if warning:
            line["letter_warning"] = warning             # 壞信：丟掉了、記一筆（N-16）
        try:
            with open(os.path.join(os.path.dirname(it["cell"]), "trace.jsonl"), "a", encoding="utf-8") as f:
                f.write(json.dumps(line, ensure_ascii=False) + "\n")
        except OSError:
            pass
        with self.lock:
            it["busy"] = None
            if code == 0:
                return
            if err and err.split(":", 1)[-1].split()[:1] == ["SessionBad"]:
                it["retry_at"] = time.time() + RETRY       # 有人接著、畫面正在跑：等一下再試，不算錯
            else:
                it["error"] = err


def append_history(stack, msg):
    """接一行進 <stack>/history.jsonl（只附加，P-41）；最後一行已是同一則就不接（重試、kernel 重開後接著答同一封）。"""
    path = os.path.join(stack, "history.jsonl")
    try:
        with open(path, encoding="utf-8") as f:
            lines = [l for l in f.read().splitlines() if l.strip()]
        if lines and json.loads(lines[-1]) == msg:
            return
    except FileNotFoundError:
        pass
    except ValueError:
        pass                                             # 最後一行壞了：照樣接（history 是給人看的紀錄）
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps(msg, ensure_ascii=False) + "\n")


def listdir(p):
    try:
        return os.listdir(p)
    except (FileNotFoundError, NotADirectoryError):
        return []


def serve_conn(k, conn):
    with conn:
        data = b""
        try:
            while not data.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
            req = json.loads(data.decode())
            rep = dict(k.handle(req), ok=True)
        except Fail as e:
            rep = {"ok": False, "code": e.code, "error": str(e)}
        except (ValueError, KeyError, TypeError, AttributeError) as e:
            rep = {"ok": False, "code": "ArgumentsBad", "error": "請求壞了：%r" % e}
        except OSError as e:
            rep = {"ok": False, "code": "KernelFailed", "error": str(e)}
        try:
            conn.sendall((json.dumps(rep, ensure_ascii=False) + "\n").encode())
        except OSError:
            pass


def main():
    if len(sys.argv) > 1:
        print(__doc__ if sys.argv[1] in ("-h", "--help") else "%s: ArgumentsBad 不收參數（位置由 AOS_HUB 給）" % PROG,
              file=sys.stderr if sys.argv[1] not in ("-h", "--help") else sys.stdout)
        sys.exit(0 if sys.argv[1] in ("-h", "--help") else 1)
    try:
        hub = hub_ipc.hub_dir()
    except hub_ipc.Error as e:
        print("%s: %s %s" % (PROG, e.code, e), file=sys.stderr)
        sys.exit(1)
    os.makedirs(hub, exist_ok=True)
    path = os.path.join(hub, hub_ipc.SOCK)
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        probe.connect(path)
        print("%s: KernelBusy %s 已經有一個在跑" % (PROG, path), file=sys.stderr)
        sys.exit(1)
    except OSError:
        pass
    finally:
        probe.close()
    if os.path.lexists(path):
        os.remove(path)                               # 上次沒收乾淨留下的
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(path)
    srv.listen(16)
    k = Kernel(hub)

    def bye(signum, frame):
        with k.lock:
            stacks = {os.path.dirname(it["cell"]) for it in k.items.values() if it["serve"]}
            for it in k.items.values():
                it["serve"] = False
        for st in stacks:
            k.drop_marker(st)
        try:
            os.remove(path)
        except OSError:
            pass
        os._exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    threading.Thread(target=k.serve_loop, daemon=True).start()
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=serve_conn, args=(k, conn), daemon=True).start()


main()
