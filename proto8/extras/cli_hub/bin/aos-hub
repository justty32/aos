#!/usr/bin/env python3
"""aos-hub - 管所有 claude／codex 實例：列出、接進畫面、收起（pause）、結束歸檔（stop）、讓 aos-say／listen 對它說話（10-28 版）。

    aos-hub ls [--json]                              列出 kernel 記的全部實例
    aos-hub state [資料夾|編號]                      這裡是不是納管的實例（不是＝InstanceMissing、退 1）
    aos-hub add  [--kind claude|codex | --tool 工具資料夾] [資料夾]   納管：kernel 開始替它回答 資料夾/.stack/new/ 的題（不開畫面）
    aos-hub open [-d] [--kind …|--tool …] [資料夾|編號]  接進畫面（沒開就開、收起的用 --resume 叫回；還沒納管就先 add）；-d 只開不接
    aos-hub pause [資料夾|編號]                      收起：關畫面、對話留著（題目照樣用 --resume 答）；出錯的實例 pause 一次＝重新收題
    aos-hub pause --idle 分                          收起所有畫面開著、閒了這麼多分的（reap.json 每分鐘叫一次）
    aos-hub stop  [資料夾|編號]                      結束：關畫面、小格與 CLI 存的對話歸檔到 <stack>/hub_archive/、從清單拿掉
    aos-hub watch [資料夾|編號]                      跟著看非互動那次在做什麼（live.jsonl 新長的行），到一次回答結束就走

都要 $AOS_HUB 指向常駐的 aos-hub-kernel（沒設＝HubMissing、kernel 沒在跑＝KernelMissing，退 1；10-28 決定 3、10）。
資料夾沒給＝cwd；資料夾＝CLI 工作的地方（例如程式專案；或小格本身）。信箱（new/ cur/ out/ done/）放在 資料夾/.stack/ 裡，
資料夾本身不長信箱（使用者 10-28「放Stack比較好。」）。--kind 沒給＝claude，工具資料夾＝proto8/lib/agent/<kind>（旗標在它的 cli.json）。
畫面裡按 Ctrl-]（或 Ctrl-\\）＝跳出、實例不結束（決定 7）。對它說話：cd 到資料夾 aos-say 話、aos-listen 題名（認得 .stack/new/）。
錯：stderr 一行 `aos-hub: 代號 原因`、退 1。設計：proto8/thinking/2026-10-28-hub-adapter.md。"""
import json, os, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, HERE)
import hub_ipc  # noqa: E402

PROG = "aos-hub"
LIB = os.path.normpath(os.path.join(HERE, "..", "..", "..", "lib", "agent"))


def die(code, msg):
    print("%s: %s %s" % (PROG, code, msg), file=sys.stderr)
    sys.exit(1)


def ask(req, timeout=120):
    try:
        return hub_ipc.ask(req, timeout)
    except hub_ipc.Error as e:
        die(e.code, e)


def items():
    return ask({"op": "ls"})["items"]


def label(it):
    if it["error"]:
        return "出錯"
    if it["busy"]:
        return "在答題"
    s = "畫面開著" if it["screen"] == "open" else "收起了"
    return s if it["serve"] else s + "（只登記）"


def session_of(it):
    try:
        with open(os.path.join(it["cell"], "session.txt"), encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def resolve(arg):
    """編號（ls 的第幾個）或資料夾 → 一個實例。資料夾比對：工作區相同、或在小格裡面。代答的優先。"""
    rows = items()
    if arg and arg.isdigit():
        i = int(arg)
        if not 1 <= i <= len(rows):
            die("InstanceMissing", "沒有第 %d 個（共 %d 個）" % (i, len(rows)))
        return rows[i - 1]
    d = os.path.abspath(arg or ".")
    hit = [r for r in rows if r["ws"] == d or d == r["cell"] or d.startswith(r["cell"] + os.sep)]
    served = [r for r in hit if r["serve"]]
    if len(served) == 1:
        return served[0]
    if len(hit) == 1:
        return hit[0]
    if not hit:
        die("InstanceMissing", "%s 不是納管的實例（aos-hub add 或 aos-hub open 納管）" % d)
    die("ArgumentsBad", "%s 有 %d 個實例，用編號指定（aos-hub ls）" % (d, len(hit)))


def parse(argv, flags=(), switches=()):
    opts, rest, it = {}, [], iter(argv)
    for a in it:
        if a in flags:
            v = next(it, None)
            if v is None:
                die("ArgumentsBad", "%s 要一個值" % a)
            opts[a] = v
        elif a in switches:
            opts[a] = True
        elif a.startswith("-") and a != "-":
            die("FlagUnknown", a)
        else:
            rest.append(a)
    if len(rest) > 1:
        die("ArgumentsBad", "多給了 %s" % rest[1])
    return opts, (rest[0] if rest else None)


def tool_of(opts):
    if "--tool" in opts and "--kind" in opts:
        die("ArgumentsBad", "--tool 跟 --kind 只給一個")
    tool = opts.get("--tool") or os.path.join(LIB, opts.get("--kind", "claude"))
    if not os.path.isfile(os.path.join(tool, "cli.json")):
        die("ToolUnknown", "%s 沒有 cli.json" % tool)
    return os.path.abspath(tool)


def cmd_ls(argv):
    opts, _ = parse(argv, switches=("--json",))
    rows = items()
    if opts.get("--json"):
        print(json.dumps([dict(r, state=label(r), session=session_of(r)) for r in rows], ensure_ascii=False))
        return
    for i, r in enumerate(rows, 1):
        print("%2d  %-14s %-6s %s  對話 %s%s" % (i, label(r), r["kind"], r["ws"], session_of(r)[:8] or "-",
                                             "\n    %s" % r["error"] if r["error"] else ""))


def cmd_state(argv):
    _, arg = parse(argv)
    r = resolve(arg)
    print("實例   %s\n狀態   %s\n工具   %s（%s）\n工作區 %s\n對話   %s%s" % (
        r["cell"], label(r), r["kind"], r["tool"], r["ws"], session_of(r) or "（還沒有）",
        "\n錯     %s" % r["error"] if r["error"] else ""))


def cmd_add(argv):
    opts, arg = parse(argv, flags=("--kind", "--tool"))
    rep = ask({"op": "add", "ws": os.path.abspath(arg or "."), "tool": tool_of(opts)})
    print(rep["cell"])


def cmd_open(argv):
    opts, arg = parse(argv, flags=("--kind", "--tool"), switches=("-d",))
    if arg and arg.isdigit():
        r = resolve(arg)
    else:
        d = os.path.abspath(arg or ".")
        hit = [x for x in items() if x["ws"] == d or d == x["cell"] or d.startswith(x["cell"] + os.sep)]
        r = resolve(arg) if hit else None
        if r is None:                                    # 還沒納管：先 add
            cell = ask({"op": "add", "ws": d, "tool": tool_of(opts)})["cell"]
            r = next(x for x in items() if x["cell"] == cell)
    rep = ask({"op": "open", "cell": r["cell"]}, timeout=600)
    if opts.get("-d"):
        print("畫面%s：%s" % ("開好了（有對話就是 --resume 叫回）" if rep["opened"] else "本來就開著", rep["sock"]))
        return
    env = {k: v for k, v in os.environ.items() if k != "TMUX"}
    print("接進 %s（Ctrl-] 跳出、實例不結束）" % r["ws"], file=sys.stderr)
    os.execvpe("tmux", ["tmux", "-S", rep["sock"], "attach", "-t", "cli"], env)


def idle_min(cell):
    """閒了幾分：格裡檔案最後被動的時間（hook 寫 turns、非互動寫 live、開畫面寫 tmux.conf）。"""
    try:
        last = max(os.path.getmtime(os.path.join(cell, n)) for n in os.listdir(cell))
    except (OSError, ValueError):
        return 0
    return (time.time() - last) / 60


def cmd_pause(argv):
    opts, arg = parse(argv, flags=("--idle",))
    if "--idle" in opts:                                 # 自動收起（reap.json 用 aos-loop 每分鐘叫一次）
        if arg:
            die("ArgumentsBad", "--idle 不跟資料夾一起給")
        try:
            limit = float(opts["--idle"])
        except ValueError:
            die("ArgumentsBad", "--idle 要分鐘數：%s" % opts["--idle"])
        for r in items():
            if r["screen"] == "open" and not r["busy"] and idle_min(r["cell"]) >= limit:
                try:
                    hub_ipc.ask({"op": "pause", "cell": r["cell"]})
                    print("收起 %s（閒了 %d 分）" % (r["ws"], idle_min(r["cell"])))
                except hub_ipc.Error as e:
                    print("沒收 %s：%s %s" % (r["ws"], e.code, e))
        return
    rep = ask({"op": "pause", "cell": resolve(arg)["cell"]})
    print("收起了" if rep["closed"] else "本來就沒畫面（已收起）")


def cmd_stop(argv):
    _, arg = parse(argv)
    rep = ask({"op": "stop", "cell": resolve(arg)["cell"]})
    print("結束，歸檔在 %s%s" % (rep["archive"], "（含 CLI 的對話 %d 份）" % len(rep["transcripts"]) if rep["transcripts"] else ""))


def describe(ev):
    """live.jsonl 一行 → 給人看的短行（claude stream-json、codex --json）；不認得的＝None。"""
    t = ev.get("type")
    if t == "system" and ev.get("subtype") == "init":
        return "── 開始（對話 %s，模型 %s）" % ((ev.get("session_id") or "")[:8], ev.get("model"))
    if t == "assistant":
        out = []
        for c in (ev.get("message") or {}).get("content") or []:
            if c.get("type") == "text" and c.get("text", "").strip():
                out.append(c["text"].strip())
            elif c.get("type") == "tool_use":
                out.append("  ▶ %s %s" % (c.get("name"), json.dumps(c.get("input"), ensure_ascii=False)[:120]))
        return "\n".join(out) or None
    if t == "user":
        for c in (ev.get("message") or {}).get("content") or []:
            if isinstance(c, dict) and c.get("type") == "tool_result":
                body = c.get("content")
                body = body if isinstance(body, str) else json.dumps(body, ensure_ascii=False)
                return "  ◀ %s" % body.replace("\n", " ")[:120]
    if t == "result":
        return "── 結束（%s，%.4f 美元）" % ("出錯" if ev.get("is_error") else "完成", ev.get("total_cost_usd") or 0)
    if t in ("item.completed", "item.started") and isinstance(ev.get("item"), dict):
        item = ev["item"]
        return "  %s %s" % (item.get("type") or item.get("item_type"), (item.get("text") or item.get("command") or "")[:120])
    if t == "turn.completed":
        return "── 結束"
    return None


def cmd_watch(argv):
    _, arg = parse(argv)
    path = os.path.join(resolve(arg)["cell"], "live.jsonl")
    pos = os.path.getsize(path) if os.path.exists(path) else 0
    print("（跟著看 %s；Ctrl-C 離開）" % path, file=sys.stderr, flush=True)
    try:
        while True:
            try:
                with open(path, "rb") as f:
                    f.seek(pos)
                    data = f.read()
            except OSError:
                data = b""
            end = data.rfind(b"\n") + 1
            pos += end
            for line in data[:end].decode("utf-8", "replace").splitlines():
                try:
                    ev = json.loads(line)
                except ValueError:
                    continue
                s = describe(ev) if isinstance(ev, dict) else None
                if s:
                    print(s, flush=True)
                if isinstance(ev, dict) and ev.get("type") in ("result", "turn.completed"):
                    return
            time.sleep(0.2)
    except KeyboardInterrupt:
        pass


CMDS = {"ls": cmd_ls, "state": cmd_state, "add": cmd_add, "open": cmd_open, "pause": cmd_pause, "stop": cmd_stop,
        "watch": cmd_watch}


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__)
        return
    if a[0] not in CMDS:
        die("ArgumentsBad", "不認得的指令 %s（%s）" % (a[0], "、".join(CMDS)))
    CMDS[a[0]](a[1:])


main()
