#!/usr/bin/env python3
# aos-comm - the comm/1 protocol on the command line: boards (set, clear, wait, show, ls) and check (thin launcher; the body is aos_comm/, the library lib/aos/comm/).
from pathlib import Path
import sys

sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
for parent in HERE.parents:
    if (parent / 'py' / 'aos_flags.py').is_file():
        sys.path.insert(0, str(parent / 'py'))
        break
for parent in HERE.parents:                     # lib/aos/comm（comm/1 的共用庫；工具、hook 也用它）
    if (parent / 'lib' / 'aos' / 'comm' / '__init__.py').is_file():
        sys.path.insert(0, str(parent / 'lib' / 'aos'))
        break
import aos_flags  # noqa: E402
from aos_comm import main  # noqa: E402

aos_flags.run(main)
