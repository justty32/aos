import json
import math
import os
import re
import sys
import time
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "py"))
import aos_flags
import aos_sweep
import daemon_ctl as dc

Fail = dc.Fail
NAME = "aos-daemon-ctl"
def usage(cmd):
    """從子命令 help 取第一種 usage，續行接成一行。"""
    lines = HELPS[cmd].splitlines()
    parts = []
    for i, line in enumerate(lines):
        if line.startswith("usage:"):
            first = line.partition(":")[2].strip()
            if first:
                parts.append(first)
            for tail in lines[i + 1:]:
                if not tail.strip() or " | " in tail:
                    break
                parts.append(tail.strip())
            break
    return " ".join(" ".join(parts).split())


def name_arg(cmd, args, flags=None):
    o, rest = aos_flags.parse(args, flags or {}, help=HELPS[cmd])
    if len(rest) != 1:
        raise Fail("ArgumentsBad", "%s needs one name" % cmd)
    return (rest[0], o) if flags else rest[0]


TIMEOUT = {"--timeout-s": "timeout"}
REPLY = dict(TIMEOUT, **{"--reply-to": "reply_to"})   # 寄信的子命令（add／rm／stop／start／sleep／wake）都收（11-05 edge-agent 題 2）


def reply_arg(o):
    """--reply-to 的值轉絕對（從呼叫當下的 cwd 算）；沒給＝None。是不是信箱由 aos-post send 驗。"""
    v = o.get("reply_to")
    if v is None:
        return None
    if not v:
        raise Fail("ArgumentsBad", "--reply-to must not be empty")
    return os.path.abspath(v)


def timeout_arg(o, default):
    """寄信認領與控制套用的期限：只收有限正數；回信模式只寄、不等待。"""
    if "timeout" in o and "reply_to" in o:
        raise Fail("ArgumentsBad", "--timeout-s does not go with --reply-to (send only, nothing waits)")
    try:
        seconds = float(o.get("timeout", default))
    except ValueError:
        raise Fail("ArgumentsBad", "--timeout-s must be a finite positive number")
    if not math.isfinite(seconds) or seconds <= 0:
        raise Fail("ArgumentsBad", "--timeout-s must be a finite positive number")
    return seconds


def limits_arg(v):
    try:
        value = json.loads(v)
    except ValueError as exc:
        raise Fail("ArgumentsBad", "--limits is not JSON: %s" % exc)
    return dc.check_limits(value, "--limits", "ArgumentsBad")


def deliver(d, body, reply_to=None, timeout_s=3, *, print_letter=True):
    """人直接敲板子：一律寄這個 daemon 自己的 ctl 信箱，不看 AOS_KERNEL（使用者 11-07 選項框「aos-daemon-ctl 永遠直寄」）。
    沒給 --reply-to（11-12 kernel 小修）：帶共用回信信箱寄，被領走後在期限內（至少再 1 秒）看回信；daemon 回 applied false（壞信）＝報它的代號與原因。"""
    own = reply_to is None
    box = dc.reply_box(d) if own else reply_to
    letter = dc.send(d, body, box, direct=True)
    if print_letter:
        print(letter, flush=True)
    if not own:
        return
    end = time.monotonic() + timeout_s
    mailbox = dc.mailbox_of(d, direct=True)
    if not dc.wait_taken(mailbox, letter, timeout_s):
        aos_flags.warn(NAME, "the letter %s is still in %s after %g s (the daemon is busy, paused or not running); it is applied when taken" % (letter, mailbox, timeout_s))
        return
    end = max(end, time.monotonic() + 1)
    while True:
        got = dc.take_reply(box, letter)
        if got is not None or time.monotonic() >= end:
            break
        time.sleep(0.05)
    if isinstance(got, dict) and got.get("applied") is False:
        err = got.get("error") if isinstance(got.get("error"), dict) else {}
        raise Fail(err.get("code") or "CtlRejected", "the daemon refused letter %s: %s" % (letter, err.get("msg", "no reason given")))


def cmd_add(opts, args):
    o, rest = aos_flags.parse(args, dict(REPLY, **{"--name": "name", "--ws": "ws", "--stack": "stack", "--def": "def", "--limits": "limits",
                                                    "--ws-json": "ws_json", "--stack-json": "stack_json", "--path-json": "path_json"}),
                              switches={"--auto-restart": "auto_restart"}, help=HELPS["add"], short=("-n", "-w", "-s"))
    seconds = timeout_arg(o, 3)
    limits = limits_arg(o["limits"]) if o.get("limits") is not None else None
    written = None
    if o.get("path_json") is not None:                # 11-10 B01：XXX 寫成 JSON（指示詞原樣進表、每次起再解）
        if rest and rest[0] != "--":
            raise Fail("ArgumentsBad", "--path-json and XXX exclude each other")
        pj = dc.path_json(o["path_json"], "--path-json")
        target = dc.resolve_here(pj, "--path-json") if isinstance(pj, dict) else pj
        if isinstance(pj, dict):
            written = (pj, target.partition("#")[0] if os.path.isdir(target.partition("#")[0]) else os.path.dirname(target.partition("#")[0]))
        rest = [target] + rest
    if not rest:
        raise Fail("ArgumentsBad", "add needs one XXX")
    extra = rest[1:]
    if extra:
        if extra[0] != "--":
            raise Fail("ArgumentsBad", "add takes only one XXX; to pass arguments write XXX -- ARGS...")
        extra = extra[1:]
    for plain, js in (("ws", "ws_json"), ("stack", "stack_json")):   # 11-10 B01
        if o.get(js) is not None:
            if o.get(plain) is not None:
                raise Fail("ArgumentsBad", "--%s and --%s-json exclude each other" % (plain, plain))
            o[plain] = dc.path_json(o[js], "--%s-json" % plain)
    d = dc.find_daemon(opts.get("daemon"))
    kept = dc.typed_kept(None if written else rest[0], o.get("ws"), o.get("stack"), o.get("def"))   # 11-10 晚 B01：打成絕對路徑的格表上原樣存
    _, body = dc.add_letter(rest[0], extra, o.get("name"), o.get("ws"), o.get("stack"), o.get("def"), limits,
                            auto_restart=o.get("auto_restart", False), written=written, kept=kept)
    name = next(iter(body["procs_added"]))
    try:                                   # 11-10 cli-sweep 甲5：撞名＝報錯不寄（代號同 aos-agent ctl add 的 InstanceExists）
        taken = name in dc.rows(d)
    except Fail:                           # 表還沒有（daemon 沒起過）＝不查
        taken = False
    if taken:
        raise Fail("InstanceExists", "%s is already on the table of %s (rm it first, or add with --name another name)" % (name, d))
    deliver(d, body, reply_arg(o), seconds)


def cmd_rm(opts, args):
    name, o = name_arg("rm", args, REPLY)
    seconds = timeout_arg(o, 3)
    d = dc.find_daemon(opts.get("daemon"))
    try:                                   # 11-10 cli-sweep 甲5：表上沒有這個名字＝報錯不寄（原本印信名退 0）
        dc.row_of(d, name)
    except Fail as e:
        if e.code == "ProcMissing":
            raise
    remove(d, name, reply_arg(o), seconds)


def remove(d, name, reply_to=None, timeout_s=3, *, print_letter=True):
    """rm 與 prune --apply 共用同一條寄信、認領等待與錯誤路徑。"""
    deliver(d, {"procs_removed": [name]}, reply_to, timeout_s, print_letter=print_letter)


def cmd_prune(opts, args):
    o, rest = aos_flags.parse(args, dict(REPLY, **{"--older-than": "older_than"}),
                              {"--apply": "apply"}, help=HELPS["prune"])
    seconds = timeout_arg(o, 3)
    reply_to = reply_arg(o)
    if rest:
        raise Fail("ArgumentsBad", "prune takes no arguments")
    if o.get("apply") and "older_than" not in o:
        raise Fail("ArgumentsBad", "--apply requires --older-than")
    age = dc.duration(o["older_than"]) if "older_than" in o else None
    d = dc.find_daemon(opts.get("daemon"))
    procs = dc.rows(d)
    for name, row in procs.items():
        if not isinstance(row, dict):
            raise Fail("StateBad", "the row of %s is not an object" % name)
        problem = dc.inspect_row(d, name, row)
        if problem:
            print(CTRL.sub(" ", "%s: %s: %s" % (name, row.get("phase"), problem)), flush=True)
    if age is None:
        return
    for name, stamp in dc.prune_candidates(d, procs, age, time.time()):
        if o.get("apply"):
            # 前一封 rm 等待期間可能有人 start／wake；寄出下一封前重讀該列與 mtime。
            current = dc.rows(d).get(name)
            if not isinstance(current, dict) or not list(dc.prune_candidates(d, {name: current}, age, time.time())):
                continue
            remove(d, name, reply_to, seconds, print_letter=False)
            print(CTRL.sub(" ", "%s: removed" % name), flush=True)
        else:
            print(CTRL.sub(" ", "%s: would remove (last change %s)" % (name, stamp)))


def phase_cmd(cmd, key):
    """stop／start／sleep／wake：只照表檢查 phase（PhaseBad），然後寄 {key: [名字]}。"""
    def run(opts, args):
        name, o = name_arg(cmd, args, REPLY)
        seconds = timeout_arg(o, 3)
        d = dc.find_daemon(opts.get("daemon"))
        row = dc.row_of(d, name)
        dc.need_phase(cmd, name, row)
        deliver(d, {key: [name]}, reply_arg(o), seconds)
    return run


cmd_stop = phase_cmd("stop", "procs_stopped")
cmd_start = phase_cmd("start", "procs_started")
cmd_sleep = phase_cmd("sleep", "procs_slept")
cmd_wake = phase_cmd("wake", "procs_woken")


def cmd_pause(opts, args):
    name, o = name_arg("pause", args, TIMEOUT)
    seconds = timeout_arg(o, 5)
    print(dc.write_ctl(dc.find_daemon(opts.get("daemon")), name, "pause", seconds))


def cmd_resume(opts, args):
    name, o = name_arg("resume", args, TIMEOUT)
    seconds = timeout_arg(o, 5)
    print(dc.write_ctl(dc.find_daemon(opts.get("daemon")), name, "resume", seconds))


CTRL = re.compile("[\x00-\x1f\x7f]")


def cmd_ls(opts, args):
    o, rest = aos_flags.parse(args, {}, {"--json": "json"}, help=HELPS["ls"], short=("-j",))
    if rest:
        raise Fail("ArgumentsBad", "ls takes no arguments")
    d = dc.find_daemon(opts.get("daemon"))
    st = dc.state(d)
    procs = st["procs"]
    up, phase, detail = dc.supervisor(d, st)
    try:                                   # 11-10 cli-sweep 甲3：說出這台 daemon 自己活著沒（只看 state 窗＋/proc，不 ping）
        pid, _ = dc.check_alive(d, dc.read_state(d))
        alive, alive_line = True, "# daemon: running (pid %d)" % pid
    except Fail as e:
        alive, alive_line = False, "# daemon: not running (%s); the table above is what it left" % str(e).replace("no aos-daemon running at %s" % d, "").strip(" ;()") or "not running"
    if o.get("json"):
        sup = None if up is None else {"phase": phase, "reason": detail if phase is not None else None, "note": detail if phase is None else None}
        print(json.dumps({"procs": procs, "daemon": up, "supervisor": sup, "running": alive}, ensure_ascii=False))
        return
    for n, r in procs.items():
        reason = r.get("reason")
        print("\t".join([n, str(r.get("phase")), "-" if r.get("pid") is None else str(r["pid"]),
                         "-" if r.get("code") is None else str(r["code"]), r.get("ws") or "-",
                         "-" if reason is None else CTRL.sub(" ", str(reason))]))
    print(CTRL.sub(" ", alive_line))
    if up is None:
        line = "# root daemon (no supervisor)"
    elif phase is not None:
        line = "# supervisor %s: %s" % (up, phase)
        if detail is not None:
            line += " (%s)" % detail
    else:
        line = "# supervisor %s: %s" % (up, detail)
    print(CTRL.sub(" ", line))


def cmd_poke(opts, args):
    switches = {"--" + mode: mode for mode in dc.MODES}
    o, rest = aos_flags.parse(args, {}, switches, help=HELPS["poke"])
    if rest or sum(arg in switches for arg in args) > 1:
        raise Fail("ArgumentsBad", "poke takes at most one of --ctl, --mail, --all and no arguments")
    mode = next((mode for mode in dc.MODES if o.get(mode)), "ctl")
    d = dc.find_daemon(opts.get("daemon"))
    dc.poke(d, mode)


def cmd_ping(opts, args):
    o, rest = aos_flags.parse(args, {"--timeout-s": "timeout"}, help=HELPS["ping"])
    try:
        seconds = float(o.get("timeout", 3))
    except ValueError:
        seconds = 0
    if rest or not math.isfinite(seconds) or seconds <= 0:
        raise Fail("ArgumentsBad", "ping needs a positive --timeout-s value and no arguments")
    d = dc.find_daemon(opts.get("daemon"))
    started = time.monotonic()
    reply = dc.ping(d, seconds, direct=True)
    if reply is None:
        raise Fail("DaemonFailed", "no reply from the daemon at %s within %g s (busy, paused or not running; what its supervisor sees: aos-daemon-ctl ls, last line)" % (d, seconds))
    print("replied in %d ms" % round((time.monotonic() - started) * 1000))


def cmd_where(opts, args):
    """where --stack 名字（11-03）：表上的才印 stack；表上沒有＝ProcMissing（不看 proc 的 stack 資料夾在不在）。"""
    o, rest = aos_flags.parse(args, {"--stack": "stack"}, help=HELPS["where"])
    if rest or not o.get("stack"):
        raise Fail("ArgumentsBad", "where needs --stack NAME")
    print(dc.cell_of(dc.find_daemon(opts.get("daemon")), o["stack"]))


def cmd_shutdown(opts, args):
    """停 daemon 本身（open-11，11-10）：寫它自己 ctl 的 stop、poke、等退出；印 seq。"""
    o, rest = aos_flags.parse(args, TIMEOUT, help=HELPS["shutdown"])
    if rest:
        raise Fail("ArgumentsBad", "shutdown takes no arguments")
    seconds = timeout_arg(o, dc.SHUTDOWN_S)
    d = dc.find_daemon(opts.get("daemon"))
    seq = dc.shutdown(d, seconds)
    try:                                   # 11-10 cli-sweep 甲4：成功說一句人看得懂的話（原本只印 seq）
        asleep = sum(1 for r in dc.rows(d).values() if isinstance(r, dict) and r.get("phase") == "sleeping")
        tail = "; %d procs asleep, they wake when it starts again" % asleep
    except Fail:
        tail = ""
    print("daemon at %s stopped (ctl seq %d)%s" % (d, seq, tail), flush=True)


SWEEP_FLAGS = dict(TIMEOUT, **{"--retention-days": "retention", "--min-bytes": "min_bytes", "--stop-grace-s": "grace"})


def cmd_sweep(opts, args):
    """sweep（11-10 清道夫）：在這個行程裡跑一輪 py/aos_sweep（跟常駐 _sweeper 同一套、flock 錯開）；--purge 刪這台所有封存。
    保留期只有明帶 --retention-days 才刪（常駐列可能設了 none，人叫一次不照預設偷刪；thinking 11-10 sweeper 代定 3）。"""
    o, rest = aos_flags.parse(args, SWEEP_FLAGS, {"--purge": "purge", "--dry-run": "dry_run", "--yes": "yes", "--json": "json"},
                              help=HELPS["sweep"], short=("-y", "-j"))
    if rest:
        raise Fail("ArgumentsBad", "sweep takes no arguments")
    seconds = timeout_arg(o, 30)
    dry = bool(o.get("dry_run"))
    if o.get("purge"):
        given = [f for f, k in SWEEP_FLAGS.items() if k != "timeout" and k in o]
        if given:
            raise Fail("ArgumentsBad", "%s does not go with --purge (purge deletes every archive and does nothing else)" % given[0])
    elif o.get("yes"):
        raise Fail("ArgumentsBad", "--yes only goes with --purge")
    try:
        days = aos_sweep.parse_retention(o["retention"]) if "retention" in o else None
    except ValueError as e:
        raise Fail("ArgumentsBad", str(e))
    numbers = {}
    for key, flag, default in (("min_bytes", "--min-bytes", aos_sweep.MIN_BYTES), ("grace", "--stop-grace-s", aos_sweep.aos_sweep_proc.STOP_GRACE_S)):
        v = o.get(key, str(default))
        if not v.isdigit() or int(v) <= 0:
            raise Fail("ArgumentsBad", "%s takes a positive whole number, got %r" % (flag, v))
        numbers[key] = int(v)
    d = dc.find_daemon(opts.get("daemon"))
    try:
        if o.get("purge"):
            if not dry and not aos_flags.confirm(NAME, "delete every stderr archive of the daemon at %s?" % d, o.get("yes")):
                aos_flags.warn(NAME, "nothing done")
                return
            data = aos_sweep.purge(d, NAME, dry_run=dry, wait_s=seconds)
        else:
            data = aos_sweep.sweep(d, NAME, min_bytes=numbers["min_bytes"], retention_days=days,
                                   stop_grace_s=numbers["grace"], dry_run=dry, wait_s=seconds)
    except aos_sweep.Busy as e:
        raise Fail("SweepBusy", "%s; waited %g s (see --timeout-s)" % (e, seconds))
    if data["table"] != "ok":
        code, _, reason = data["table"].partition(" ")
        raise Fail(code if code in ("StateMissing", "StateBad") else "StateBad", reason)
    if o.get("json"):
        print(json.dumps(data, ensure_ascii=False))
        return
    for line in aos_sweep.lines(data):
        print(CTRL.sub(" ", line))


# 子命令表：一列一組，新子命令接在對應那組（或新開一組）後面。
COMMANDS = {"add": cmd_add, "rm": cmd_rm, "prune": cmd_prune, "stop": cmd_stop, "start": cmd_start, "sleep": cmd_sleep, "wake": cmd_wake,
            "pause": cmd_pause, "resume": cmd_resume,
            "ls": cmd_ls, "where": cmd_where, "ping": cmd_ping, "poke": cmd_poke,
            "shutdown": cmd_shutdown,
            "sweep": cmd_sweep}


def main():
    aos_flags.HELP = HELP
    cmd = None
    try:
        try:
            opts, rest = aos_flags.parse(sys.argv[1:], {"--daemon": "daemon"}, short=("-d",), sub="root")   # 11-10 Q1：-d 寫在子命令後也算
        except aos_flags.Error as e:
            hint = "" if e.code == "FlagUnknown" else " (see %s --help)" % NAME
            raise Fail(e.code, str(e) + hint)
        choices = ", ".join(COMMANDS)
        if not rest:
            raise Fail("ArgumentsBad", "missing subcommand (%s; see %s --help)" % (choices, NAME))
        if rest[0] not in COMMANDS:
            raise Fail("CommandUnknown", "unknown subcommand %s (%s; see %s --help)" %
                       (rest[0], choices, NAME))
        cmd = rest[0]
        try:
            COMMANDS[cmd](opts, rest[1:])
        except aos_flags.Error as e:
            hint = ("see %s %s --help" % (NAME, cmd) if e.code == "FlagUnknown" else
                    "usage: %s" % usage(cmd))
            raise Fail(e.code, "%s (%s)" % (e, hint))
    except dc.Already as e:          # 11-10 cli-sweep Q4＝A：已在那個狀態＝印一句、退 0
        print(e, flush=True)
    except Fail as e:
        reason = str(e)
        if cmd is not None and e.code == "ArgumentsBad" and "(usage:" not in reason:
            reason += " (usage: %s)" % usage(cmd)
        aos_flags.die(NAME, e.code, reason)


if __name__ == "__main__":
    aos_flags.run(main)
