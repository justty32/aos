#!/usr/bin/env python3
# aos-daemon-ctl - 把 proc 掛到一個 aos-daemon 上、起停、睡醒、暫停；說明在 cmd/docs/03、04（本體在 py/daemon_ctl/）。
HELP = """aos-daemon-ctl - attach procs to an aos-daemon and start / stop / sleep / wake / pause them

usage: aos-daemon-ctl [--daemon D] SUBCOMMAND [FLAGS...] [ARGS...]
       aos-daemon-ctl SUBCOMMAND --help

subcommands:
  add [FLAGS] XXX [-- ARGS...]   attach (register + start); prints the letter name
  rm NAME        detach (stop, then remove; stack kept, so it does not ask)
  stop NAME      stop after this run (row stays as stopped)
  start NAME     start a stopped one again on the same stack
  sleep NAME     SIGTERM now (row stays as sleeping; wakes when the daemon restarts)
  wake NAME      start a sleeping one again on the same stack
  pause NAME     write {"cmd": "pause", "seq": N} to its ctl window; prints N
  resume NAME    the same with "resume"
  ls [-j]        the table: NAME  PHASE  PID  CODE  WS  REASON; last line = the supervisor's view
  where --stack NAME   print its stack (one absolute path)
  ping [--timeout-s S]   wait for the daemon's ping reply; prints "replied in N ms"

Each subcommand drops one letter into the daemon's ctl mailbox (procs_added, procs_removed,
procs_stopped, ...) or writes the proc's own ctl window (pause / resume). A letter only
asks; the daemon applies it on its next round. See the result with ls.
Letters always go straight to this daemon's ctl mailbox; AOS_KERNEL is not read.
To go through the judge (AOS_KERNEL), use aos-agent ctl instead.
add / rm / stop / start / sleep / wake also take --reply-to BOX (send only, do not wait).

flags:
  -d, --daemon D   the daemon's stack folder (default: $AOS_DAEMON, else ./.stack)
  -h, --help       show this help
  short names: -n --name, -w --ws, -s --stack, -j --json

exit codes: 0 sent / printed; 1 error ("aos-daemon-ctl: error: CODE reason" on stderr).
more: proto8/cmd/docs/03-aos-daemon-ctl.md
"""

HELPS = {
    "add": """aos-daemon-ctl add - attach one proc (register + start)

usage: aos-daemon-ctl [--daemon D] add [--reply-to BOX] [--timeout-s S] [--name N] [--ws WS]
                      [--stack S] [--def DEF] [--limits JSON] XXX [-- ARGS...]

XXX is followed the way aos-exec follows it: ending at a loop config = loop type (no ARGS
allowed), anything else = exec type (runs once; ARGS after -- are appended). Prints the
letter name, then waits up to --timeout-s seconds for the letter to leave new/ (still there = a
warning line, exit 0; it is applied when taken).

A definition folder runs its _entry, as aos-exec would. An agent folder's _entry attaches the
agent itself, so this proc ends at once and is not left on the table; to attach an agent, use
aos-agent ctl add, or give its body: add -n bob --def bob bob/body.json.
"applied": true only means the letter was applied to the table, not that the proc still runs.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply ({"applied": true|false, ...}) goes to BOX
  -n, --name N         its name on the table (default: the folder name of XXX)
  -w, --ws WS          its workspace (default: the daemon's)
  -s, --stack S        its stack (default: <D>/procs/<name>/)
      --def DEF        the definition folder recorded on the table (default: XXX)
      --limits JSON    resource limits, the aos-sandbox keys ('{}' = none)
  -h, --help           show this help

exit codes: 0 sent; 1 error (ArgumentsBad, DaemonMissing, MailboxMissing, PathMissing,
  EntryBad, SendFailed...).
""",
    "rm": """aos-daemon-ctl rm - detach one proc and keep its stack

usage: aos-daemon-ctl [--daemon D] rm [--reply-to BOX] [--timeout-s S] NAME

Asks the daemon to stop and remove NAME from its table. The stack is kept.
Prints the letter name; without --reply-to, waits up to --timeout-s seconds for it to leave new/.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply goes to BOX
  -h, --help           show this help

exit codes: 0 sent; 1 error.
""",
    "stop": """aos-daemon-ctl stop - stop a running loop after its current run

usage: aos-daemon-ctl [--daemon D] stop [--reply-to BOX] [--timeout-s S] NAME

Asks a running loop to stop after this run. Its row stays stopped and its stack is kept;
use start to run it again. Prints the letter name; exec types have no stop (CtlMissing).
Without --reply-to, waits up to --timeout-s seconds for the letter to leave new/.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply goes to BOX
  -h, --help           show this help

exit codes: 0 sent; 1 error (including PhaseBad or CtlMissing).
""",
    "start": """aos-daemon-ctl start - start a stopped proc again on the same stack

usage: aos-daemon-ctl [--daemon D] start [--reply-to BOX] [--timeout-s S] NAME

Asks a stopped proc to start again on its recorded stack. A sleeping proc needs wake.
Prints the letter name; without --reply-to, waits up to --timeout-s seconds for it to leave new/.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply goes to BOX
  -h, --help           show this help

exit codes: 0 sent; 1 error (including PhaseBad).
""",
    "sleep": """aos-daemon-ctl sleep - put a running loop to sleep now

usage: aos-daemon-ctl [--daemon D] sleep [--reply-to BOX] [--timeout-s S] NAME

Asks the daemon to SIGTERM a running loop now. The row stays sleeping and the stack is
kept; wake or a daemon restart starts it again. Exec types have no sleep (CtlMissing).
Prints the letter name; without --reply-to, waits up to --timeout-s seconds for it to leave new/.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply goes to BOX
  -h, --help           show this help

exit codes: 0 sent; 1 error (including PhaseBad or CtlMissing).
""",
    "wake": """aos-daemon-ctl wake - start a sleeping proc again on the same stack

usage: aos-daemon-ctl [--daemon D] wake [--reply-to BOX] [--timeout-s S] NAME

Asks a sleeping proc to start again on its recorded stack. A stopped proc needs start.
Prints the letter name; without --reply-to, waits up to --timeout-s seconds for it to leave new/.

flags:
      --timeout-s S    positive claim timeout (default: 3); excludes --reply-to
      --reply-to BOX   send only; the reply goes to BOX
  -h, --help           show this help

exit codes: 0 sent; 1 error (including PhaseBad).
""",
    "pause": """aos-daemon-ctl pause - pause a loop through its own ctl window

usage: aos-daemon-ctl [--daemon D] pause [--timeout-s S] NAME

Writes {"cmd": "pause", "seq": N} directly to the loop's ctl window and prints N.
Waits up to --timeout-s seconds for its state ctl_seq to reach N; a timeout warns and exits 0.
No state window means no wait.

flags:
      --timeout-s S   positive apply timeout in seconds (default: 5)
  -h, --help          show this help

exit codes: 0 written; 1 error (including CtlMissing or WriteFailed).
""",
    "resume": """aos-daemon-ctl resume - resume a loop through its own ctl window

usage: aos-daemon-ctl [--daemon D] resume [--timeout-s S] NAME

Writes {"cmd": "resume", "seq": N} directly to the loop's ctl window and prints N.
Waits up to --timeout-s seconds for its state ctl_seq to reach N; a timeout warns and exits 0.
No state window means no wait.

flags:
      --timeout-s S   positive apply timeout in seconds (default: 5)
  -h, --help          show this help

exit codes: 0 written; 1 error (including CtlMissing or WriteFailed).
""",
    "ls": """aos-daemon-ctl ls - list the procs on the daemon table

usage: aos-daemon-ctl [--daemon D] ls [-j]

One line per proc: NAME TAB PHASE TAB PID TAB CODE TAB WS TAB REASON (none = -); paths are
absolute. The last line starts with "# " and says what the supervisor thinks of this daemon
("# root daemon (no supervisor)" for a root). Only reads files; it does not ping.

flags:
  -j, --json   one line {"procs": table, "daemon": UP or null, "supervisor": {...} or null}
  -h, --help   show this help

exit codes: 0 (an empty table prints only the last line); 1 error (DaemonMissing,
  StateMissing, StateBad).
""",
    "where": """aos-daemon-ctl where - print the recorded stack of one proc

usage: aos-daemon-ctl [--daemon D] where --stack NAME

Prints one absolute stack path for a proc on the daemon table. Reads files only;
not on the table means ProcMissing, even if its stack folder still exists.

flags:
      --stack NAME   the proc name to look up (required)
  -h, --help         show this help

exit codes: 0 printed; 1 error (including ProcMissing).
""",
    "ping": """aos-daemon-ctl ping - wait for the daemon's ping reply

usage: aos-daemon-ctl [--daemon D] ping [--timeout-s S]

Sends through the same mailbox as proc letters and waits for a correlated reply.
Prints "replied in N ms". No reply within the timeout means DaemonFailed.

flags:
      --timeout-s S   positive reply timeout in seconds (default: 3)
  -h, --help          show this help

exit codes: 0 replied; 1 error.
""",
}

import json
import math
import os
import re
import sys
import time
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "py"))
import aos_flags
import daemon_ctl as dc

Fail = dc.Fail
NAME = "aos-daemon-ctl"
def usage(cmd):
    """從子命令 help 取第一種 usage，續行接成一行。"""
    lines = HELPS[cmd].splitlines()
    parts = []
    for i, line in enumerate(lines):
        if line.startswith("usage:"):
            first = line.partition(":")[2].strip()
            if first:
                parts.append(first)
            for tail in lines[i + 1:]:
                if not tail.strip() or " | " in tail:
                    break
                parts.append(tail.strip())
            break
    return " ".join(" ".join(parts).split())


def name_arg(cmd, args, flags=None):
    o, rest = aos_flags.parse(args, flags or {}, help=HELPS[cmd])
    if len(rest) != 1:
        raise Fail("ArgumentsBad", "%s needs one name" % cmd)
    return (rest[0], o) if flags else rest[0]


TIMEOUT = {"--timeout-s": "timeout"}
REPLY = dict(TIMEOUT, **{"--reply-to": "reply_to"})   # 寄信的子命令（add／rm／stop／start／sleep／wake）都收（11-05 edge-agent 題 2）


def reply_arg(o):
    """--reply-to 的值轉絕對（從呼叫當下的 cwd 算）；沒給＝None。是不是信箱由 aos-post send 驗。"""
    v = o.get("reply_to")
    if v is None:
        return None
    if not v:
        raise Fail("ArgumentsBad", "--reply-to must not be empty")
    return os.path.abspath(v)


def timeout_arg(o, default):
    """寄信認領與控制套用的期限：只收有限正數；回信模式只寄、不等待。"""
    if "timeout" in o and "reply_to" in o:
        raise Fail("ArgumentsBad", "--timeout-s does not go with --reply-to (send only, nothing waits)")
    try:
        seconds = float(o.get("timeout", default))
    except ValueError:
        raise Fail("ArgumentsBad", "--timeout-s must be a finite positive number")
    if not math.isfinite(seconds) or seconds <= 0:
        raise Fail("ArgumentsBad", "--timeout-s must be a finite positive number")
    return seconds


def limits_arg(v):
    try:
        value = json.loads(v)
    except ValueError as exc:
        raise Fail("ArgumentsBad", "--limits is not JSON: %s" % exc)
    return dc.check_limits(value, "--limits", "ArgumentsBad")


def deliver(d, body, reply_to=None, timeout_s=3):
    """人直接敲板子：一律寄這個 daemon 自己的 ctl 信箱，不看 AOS_KERNEL（使用者 11-07 選項框「aos-daemon-ctl 永遠直寄」）。"""
    letter = dc.send(d, body, reply_to, direct=True)
    print(letter, flush=True)
    if reply_to is None:
        box = dc.mailbox_of(d, direct=True)
        if not dc.wait_taken(box, letter, timeout_s):
            aos_flags.warn(NAME, "the letter %s is still in %s after %g s (the daemon is busy, paused or not running); it is applied when taken" % (letter, box, timeout_s))


def cmd_add(opts, args):
    o, rest = aos_flags.parse(args, dict(REPLY, **{"--name": "name", "--ws": "ws", "--stack": "stack", "--def": "def", "--limits": "limits"}),
                              help=HELPS["add"], short=("-n", "-w", "-s"))
    seconds = timeout_arg(o, 3)
    limits = limits_arg(o["limits"]) if o.get("limits") is not None else None
    if not rest:
        raise Fail("ArgumentsBad", "add needs one XXX")
    extra = rest[1:]
    if extra:
        if extra[0] != "--":
            raise Fail("ArgumentsBad", "add takes only one XXX; to pass arguments write XXX -- ARGS...")
        extra = extra[1:]
    d = dc.find_daemon(opts.get("daemon"))
    _, body = dc.add_letter(rest[0], extra, o.get("name"), o.get("ws"), o.get("stack"), o.get("def"), limits)
    deliver(d, body, reply_arg(o), seconds)


def cmd_rm(opts, args):
    name, o = name_arg("rm", args, REPLY)
    seconds = timeout_arg(o, 3)
    deliver(dc.find_daemon(opts.get("daemon")), {"procs_removed": [name]}, reply_arg(o), seconds)


def phase_cmd(cmd, key):
    """stop／start／sleep／wake：照表檢查 phase（PhaseBad）；stop、sleep 另要 loop 型（CtlMissing），然後寄 {key: [名字]}。"""
    def run(opts, args):
        name, o = name_arg(cmd, args, REPLY)
        seconds = timeout_arg(o, 3)
        d = dc.find_daemon(opts.get("daemon"))
        row = dc.row_of(d, name)
        if cmd in ("stop", "sleep"):
            dc.need_stoppable(d, name, row)    # exec 型只有跑和拔：先報 CtlMissing（跟 11-05 前一樣）；寫了 auto_restart 的放行（11-06 no-pid P6）
        dc.need_phase(cmd, name, row)
        deliver(d, {key: [name]}, reply_arg(o), seconds)
    return run


cmd_stop = phase_cmd("stop", "procs_stopped")
cmd_start = phase_cmd("start", "procs_started")
cmd_sleep = phase_cmd("sleep", "procs_slept")
cmd_wake = phase_cmd("wake", "procs_woken")


def cmd_pause(opts, args):
    name, o = name_arg("pause", args, TIMEOUT)
    seconds = timeout_arg(o, 5)
    print(dc.write_ctl(dc.find_daemon(opts.get("daemon")), name, "pause", seconds))


def cmd_resume(opts, args):
    name, o = name_arg("resume", args, TIMEOUT)
    seconds = timeout_arg(o, 5)
    print(dc.write_ctl(dc.find_daemon(opts.get("daemon")), name, "resume", seconds))


CTRL = re.compile("[\x00-\x1f\x7f]")


def cmd_ls(opts, args):
    o, rest = aos_flags.parse(args, {}, {"--json": "json"}, help=HELPS["ls"], short=("-j",))
    if rest:
        raise Fail("ArgumentsBad", "ls takes no arguments")
    d = dc.find_daemon(opts.get("daemon"))
    st = dc.state(d)
    procs = st["procs"]
    up, phase, detail = dc.supervisor(d, st)
    if o.get("json"):
        sup = None if up is None else {"phase": phase, "reason": detail if phase is not None else None, "note": detail if phase is None else None}
        print(json.dumps({"procs": procs, "daemon": up, "supervisor": sup}, ensure_ascii=False))
        return
    for n, r in procs.items():
        reason = r.get("reason")
        print("\t".join([n, str(r.get("phase")), "-" if r.get("pid") is None else str(r["pid"]),
                         "-" if r.get("code") is None else str(r["code"]), r.get("ws") or "-",
                         "-" if reason is None else CTRL.sub(" ", str(reason))]))
    if up is None:
        line = "# root daemon (no supervisor)"
    elif phase is not None:
        line = "# supervisor %s: %s" % (up, phase)
        if detail is not None:
            line += " (%s)" % detail
    else:
        line = "# supervisor %s: %s" % (up, detail)
    print(CTRL.sub(" ", line))


def cmd_ping(opts, args):
    o, rest = aos_flags.parse(args, {"--timeout-s": "timeout"}, help=HELPS["ping"])
    try:
        seconds = float(o.get("timeout", 3))
    except ValueError:
        seconds = 0
    if rest or not math.isfinite(seconds) or seconds <= 0:
        raise Fail("ArgumentsBad", "ping needs a positive --timeout-s value and no arguments")
    d = dc.find_daemon(opts.get("daemon"))
    started = time.monotonic()
    reply = dc.ping(d, seconds, direct=True)
    if reply is None:
        raise Fail("DaemonFailed", "no reply from the daemon at %s within %g s (busy, paused or not running; what its supervisor sees: aos-daemon-ctl ls, last line)" % (d, seconds))
    print("replied in %d ms" % round((time.monotonic() - started) * 1000))


def cmd_where(opts, args):
    """where --stack 名字（11-03）：表上的才印 stack；表上沒有＝ProcMissing（不看 proc 的 stack 資料夾在不在）。"""
    o, rest = aos_flags.parse(args, {"--stack": "stack"}, help=HELPS["where"])
    if rest or not o.get("stack"):
        raise Fail("ArgumentsBad", "where needs --stack NAME")
    print(dc.cell_of(dc.find_daemon(opts.get("daemon")), o["stack"]))


COMMANDS = {"add": cmd_add, "rm": cmd_rm, "stop": cmd_stop, "start": cmd_start, "sleep": cmd_sleep, "wake": cmd_wake,
            "pause": cmd_pause, "resume": cmd_resume,
            "ls": cmd_ls, "where": cmd_where, "ping": cmd_ping}


def main():
    aos_flags.HELP = HELP
    cmd = None
    try:
        try:
            opts, rest = aos_flags.parse(sys.argv[1:], {"--daemon": "daemon"}, short=("-d",))
        except aos_flags.Error as e:
            hint = "" if e.code == "FlagUnknown" else " (see %s --help)" % NAME
            raise Fail(e.code, str(e) + hint)
        choices = ", ".join(HELPS)
        if not rest:
            raise Fail("ArgumentsBad", "missing subcommand (%s; see %s --help)" % (choices, NAME))
        if rest[0] not in COMMANDS:
            raise Fail("CommandUnknown", "unknown subcommand %s (%s; see %s --help)" %
                       (rest[0], choices, NAME))
        cmd = rest[0]
        try:
            COMMANDS[cmd](opts, rest[1:])
        except aos_flags.Error as e:
            hint = ("see %s %s --help" % (NAME, cmd) if e.code == "FlagUnknown" else
                    "usage: %s" % usage(cmd))
            raise Fail(e.code, "%s (%s)" % (e, hint))
    except Fail as e:
        reason = str(e)
        if cmd is not None and e.code == "ArgumentsBad" and "(usage:" not in reason:
            reason += " (usage: %s)" % usage(cmd)
        aos_flags.die(NAME, e.code, reason)


if __name__ == "__main__":
    aos_flags.run(main)
