#!/usr/bin/env python3
"""aos-grow - 把一個函數往上長一級（或縮回一級），呼叫方跟著改、行為不變。原型（10-24 嘗試，thinking/2026-10/24/fn-grow/README.md）。

函數＝aos-exec 跑得動的一個東西。這支只動一格：CALLER＝`設定檔#/指標`，指到「呼叫方寫著要跑什麼」的那一格（fsm 格的 exec、loop.json 的 exec…）。

  aos-grow [--dry-run] up --to file|dir [--name NAME] [--take PATH]... CALLER
  aos-grow [--dry-run] down CALLER

命令列形狀照 CONVENTION P-44（11-04）：旗標在位置參數前面（子命令的旗標接在子命令後、CALLER 前）、`--` 結束旗標、`--x V`／`--x=V`。

up：
  那格是內嵌單子（有 argv 的物件）→ --to file：寫成 設定檔旁的 NAME.json（就是那張單子）；--to dir：寫成 NAME/_entry（同一張單子）。
  那格是字串、指到旁邊的 NAME.json（單子）→ 只收 --to dir：NAME.json 變 NAME/_entry。
  那格改寫成字串 "NAME"（不帶 .json：aos-exec 找不到 NAME 會補 .json、NAME 是資料夾就進去，所以檔→資料夾時呼叫方不用再改）。
  --take PATH（只給 --to dir）：把只有它用的檔（相對設定檔的資料夾）搬進 NAME/，單子 argv 裡等於 PATH 的那一項改成 {"$env": "AOS_CD", "$path": "/檔名"}。
down：反過來縮一級：NAME/（裡面只剩 _entry）→ NAME.json；NAME.json → 內嵌回那格。設定檔資料夾底下還有別份 JSON 提到 NAME＝不縮。

搬的時候只動「位置相關」的東西，讓跑起來一樣：單子的 cwd（沒寫＝入口所在的資料夾）、相對的 $ref 檔名（"#/…" 指自己那份＝補上原檔名）、
{"$env": "AOS_CD", "$path": …}，一律換成相對新位置、指回原本那個地方。單子裡有 $env AOS_CF／AOS_CO＝不搬（搬了值就變了，TargetBad）。
--dry-run：只印會做什麼（新檔全文、改的檔 unified diff、搬／刪哪些），什麼都不寫。
假設（慣例下成立）：呼叫方跑字串目標時的 cwd＝設定檔的資料夾（aos-loop／aos-fsm 被 aos-exec 起來時就是）。
錯：stderr 一行「aos-grow: error: 代號 原因」、退 1，什麼都不寫（ArgumentsBad、FlagUnknown、CommandUnknown、CfgMissing、CfgBad、TargetBad、NameBad、WriteFailed；
11-05 stdio-unify R1、錯誤行的括號只指那一層（11-06 human-cli H10：缺子命令列子命令名、子命令層接那個子命令的 usage）；不給子命令＝ArgumentsBad、子命令不認得＝CommandUnknown）。--help＝英文說明到 stdout、退 0；Ctrl-C＝退 130。"""
import difflib, json, os, re, shutil, sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "py"))
import aos_flags  # noqa: E402  proto8/py/aos_flags.py：P-44 的解析

PROG = "aos-grow"
ENTRY = os.environ.get("AOS_ENTRY") or "_entry"
HELP = """aos-grow - grow or shrink a function one level, rewriting its caller

usage: aos-grow [--dry-run] SUBCOMMAND [FLAGS...] CALLER
       aos-grow SUBCOMMAND --help

subcommands:
  up     move an inline instruction to a file or folder
  down   shrink a folder to a file, or a file to an inline instruction

CALLER is CONFIG#/pointer, the slot where a caller says what to run. Location-dependent
parts are rewritten to point at the same places. Changes are written to the config and
nearby files; --dry-run prints the plan instead.

flags:
      --dry-run   print new files, diffs, moves and deletes; write nothing
  -h, --help      show this help

exit codes: 0 done / plan printed; 1 error; 130 interrupted.
more: proto8/cmd/aos-grow/README.md
"""
HELPS = {
    "up": """aos-grow up - move an instruction into a file or folder

usage: aos-grow [--dry-run] up --to file|dir [--name NAME] [--take PATH]... CALLER

CALLER is CONFIG#/pointer. An inline instruction becomes NAME.json or NAME/_entry;
a string pointing at NAME.json can only grow to a folder. The caller's slot becomes
"NAME". Relative paths are rewritten to keep pointing at the same places.

flags:
      --dry-run     print the plan without writing (before up)
      --to file|dir choose the next level (required)
  -n, --name NAME   name of the new file or folder (default: slot name or existing target)
      --take PATH   move a file from CONFIG's folder into NAME/ (repeatable; --to dir only)
  -h, --help        show this help

exit codes: 0 done / plan printed; 1 error; 130 interrupted.
""",
    "down": """aos-grow down - shrink a folder to a file, or a file to an inline instruction

usage: aos-grow [--dry-run] down CALLER

CALLER is CONFIG#/pointer. NAME/ containing only _entry becomes NAME.json; NAME.json
becomes inline in the caller. Shrinking to inline is refused when another config in
that folder or another slot in the caller also uses NAME. Relative paths are rewritten.

flags:
      --dry-run   print the plan without writing (before down)
  -h, --help      show this help

exit codes: 0 done / plan printed; 1 error; 130 interrupted.
""",
}
aos_flags.HELP = HELP


def usage(sub):
    """從子命令 help 取第一種 usage，續行合成一行。"""
    lines = HELPS[sub].split("usage:", 1)[1].split("\n\n", 1)[0].splitlines()
    first = []
    for line in lines:
        if line.lstrip().startswith("|"):
            break
        first.append(line)
    return " ".join(" ".join(first).split())


def sub_reason(sub, code, reason):
    if code == "ArgumentsBad" and "(usage:" not in str(reason):
        return "%s (usage: %s)" % (reason, usage(sub))
    return str(reason)



class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


# ---------- JSON：讀、寫、指標 ----------

def load(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        raise Fail("CfgMissing", "%s not found" % path)
    except (OSError, ValueError) as e:
        raise Fail("CfgBad", "cannot read %s: %s" % (path, e))


def dump(v, ind=0, width=100):
    """寫回 JSON：塞得進一行（含縮排）就一行，不然物件／陣列一項一行。"""
    flat = json.dumps(v, ensure_ascii=False, separators=(", ", ": "))
    if len(flat) + ind <= width or not isinstance(v, (dict, list)) or not v:
        return flat
    pad = " " * (ind + 1)
    if isinstance(v, dict):
        items = ["%s: %s" % (json.dumps(k, ensure_ascii=False), dump(x, ind + 2 + len(json.dumps(k, ensure_ascii=False)), width))
                 for k, x in v.items()]
        return "{" + (",\n" + pad).join(items) + "}"
    return "[" + (",\n" + pad).join(dump(x, ind + 1, width) for x in v) + "]"


def text(v):
    return dump(v) + "\n"


def split_ptr(ptr):
    if ptr == "":
        return []
    if not ptr.startswith("/"):
        raise Fail("ArgumentsBad", "the pointer must start with /: %r" % ptr)
    return [p.replace("~1", "/").replace("~0", "~") for p in ptr[1:].split("/")]


def walk(doc, parts, where):
    cur = doc
    for p in parts[:-1]:
        if isinstance(cur, dict) and p in cur:
            cur = cur[p]
        elif isinstance(cur, list) and p.isdigit() and int(p) < len(cur):
            cur = cur[int(p)]
        else:
            raise Fail("CfgMissing", "%s points at nothing" % where)
    last = parts[-1]
    if isinstance(cur, dict) and last in cur:
        return cur, last
    if isinstance(cur, list) and last.isdigit() and int(last) < len(cur):
        return cur, int(last)
    raise Fail("CfgMissing", "%s points at nothing" % where)


# ---------- 搬位置：把單子從 src 資料夾搬到 dst 資料夾，位置相關的值改成指回原處 ----------

def rel(p, start):
    r = os.path.relpath(p, start)
    return "." if r == "" else r


def rebase(inst, src, dst, src_file):
    """回傳新的單子（不改原物件）。src／dst 是絕對路徑資料夾；src_file＝單子原本所在的那份檔（"#/…" 的 $ref 要指回它）。"""
    out = json.loads(json.dumps(inst))
    cwd = out.get("cwd")
    if cwd is None or isinstance(cwd, str):
        base = src if cwd is None else (cwd if os.path.isabs(cwd) else os.path.normpath(os.path.join(src, cwd)))
        new = base if (cwd is not None and os.path.isabs(cwd)) else rel(base, dst)
        if new == ".":
            out.pop("cwd", None)
        else:
            out["cwd"] = new
    # cwd 是指示詞＝照原樣（跑的時候才解，下面 fix 會把裡面的 $ref／AOS_CD 一起改）

    def fix(v):
        if isinstance(v, list):
            return [fix(x) for x in v]
        if not isinstance(v, dict):
            return v
        if "$env" in v:
            if v["$env"] in ("AOS_CF", "AOS_CO"):
                raise Fail("TargetBad", "the instruction uses $env %s, whose value would change if moved; not moving it" % v["$env"])
            if v["$env"] == "AOS_CD":
                p = v.get("$path", "")
                if not isinstance(p, str) or (p and not p.startswith("/")):
                    raise Fail("TargetBad", "the $path of $env AOS_CD is not a string starting with /, cannot rewrite it: %r" % p)
                w = dict(v)
                np = "/" + rel(os.path.normpath(src + p) if p else src, dst)
                w["$path"] = "" if np == "/." else np
                return w
            return {k: fix(x) for k, x in v.items()}
        if "$ref" in v:
            w = {k: fix(x) for k, x in v.items()}
            refs = v["$ref"] if isinstance(v["$ref"], list) else [v["$ref"]]
            new = []
            for r in refs:
                if not isinstance(r, str):
                    raise Fail("TargetBad", "$ref is not a string, cannot rewrite it: %r" % r)
                f, sep, frag = r.partition("#")
                if f == "":
                    f = src_file
                if not os.path.isabs(f):
                    f = rel(os.path.normpath(os.path.join(src, f)), dst)
                new.append(f + sep + frag)
            w["$ref"] = new if isinstance(v["$ref"], list) else new[0]
            return w
        return {k: fix(x) for k, x in v.items()}

    return fix(out)


def is_inst(v):
    return isinstance(v, dict) and "argv" in v


# ---------- 計畫：先算好要做的事，--dry-run 只印，否則照做 ----------

class Plan:
    def __init__(self):
        self.writes, self.moves, self.removes, self.mkdirs = [], [], [], []   # (路徑, 新內容, 舊內容或 None)、(從, 到)、路徑、路徑

    def show(self, out):
        for d in self.mkdirs:
            out.write("mkdir %s\n" % d)
        for a, b in self.moves:
            out.write("move %s -> %s\n" % (a, b))
        for path, new, old in self.writes:
            if old is None:
                out.write("new file %s:\n%s" % (path, new))
            else:
                out.writelines(difflib.unified_diff(old.splitlines(True), new.splitlines(True), path, path))
        for p in self.removes:
            out.write("remove %s\n" % p)

    def apply(self):
        try:
            for d in self.mkdirs:
                os.mkdir(d)
            for a, b in self.moves:
                os.rename(a, b)
            new_first = sorted(self.writes, key=lambda w: w[2] is not None)   # 先寫新的檔，最後才改呼叫方（呼叫方改名那一刻才換過去）
            for path, new, _ in new_first:
                tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".grow")
                with open(tmp, "w", encoding="utf-8") as f:
                    f.write(new)
                os.replace(tmp, path)
            for p in self.removes:
                if os.path.isdir(p):
                    shutil.rmtree(p)
                else:
                    os.remove(p)
        except OSError as e:
            raise Fail("WriteFailed", str(e))


def name_ok(name):
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", name) or name.endswith(".json"):
        raise Fail("NameBad", "a name takes only letters, digits, underscore, dot and hyphen, without .json: %r" % name)


def mentions(root, name, skip):
    """root 底下（不進 . 開頭的資料夾）除了 skip 以外的 JSON 檔，有沒有字串值等於 NAME／NAME.json／NAME/… 的；回檔名清單。"""
    hits = []
    pat = re.compile(r'"(\./)?%s(\.json)?([/#][^"]*)?"' % re.escape(name))
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if not x.startswith(".")]
        for f in files:
            p = os.path.join(d, f)
            if os.path.abspath(p) in skip or not (f.endswith(".json") or f == ENTRY):
                continue
            try:
                with open(p, encoding="utf-8") as fh:
                    s = fh.read()
            except (OSError, UnicodeDecodeError):
                continue
            if pat.search(s):
                hits.append(p)
    return hits


def calls(v, name, key=None):
    """設定檔裡「叫 NAME」的格有幾個：key 是 exec／_entry 的字串值，或陣列（argv）裡的字串，等於 NAME、NAME.json、./NAME。"""
    if isinstance(v, dict):
        return sum(calls(x, name, k) for k, x in v.items())
    if isinstance(v, list):
        return sum(calls(x, name, "[]") for x in v)
    return int(isinstance(v, str) and key in ("exec", ENTRY, "[]") and v in (name, name + ".json", "./" + name))


def parse_caller(spec):
    f, sep, ptr = spec.partition("#")
    if not sep or not ptr.startswith("/"):
        raise Fail("ArgumentsBad", "CALLER must be written as FILE#/POINTER: %r" % spec)
    return os.path.abspath(f), split_ptr(ptr)


def up(caller, to, name, takes):
    cfg, parts = parse_caller(caller)
    doc = load(cfg)
    with open(cfg, encoding="utf-8") as fh:
        old_text = fh.read()
    box, key = walk(doc, parts, caller)
    val, cdir, plan = box[key], os.path.dirname(cfg), Plan()

    if is_inst(val):
        if not name:   # 預設＝那格的名字：…/states/think/exec → think；指標只有 /exec 一層就要自己給
            if parts[-1] == "exec" and len(parts) < 2:
                raise Fail("ArgumentsBad", "the slot is /exec; give --name")
            name = parts[-2] if parts[-1] == "exec" else parts[-1]
        name_ok(name)
        for p in (name, name + ".json"):
            if os.path.lexists(os.path.join(cdir, p)):
                raise Fail("NameBad", "%s already exists; pick another --name" % os.path.join(cdir, p))
        if to == "file":
            if takes:
                raise Fail("ArgumentsBad", "--take is only for --to dir")
            inst = rebase(val, cdir, cdir, os.path.basename(cfg))
            plan.writes.append((os.path.join(cdir, name + ".json"), text(inst), None))
        else:
            fdir = os.path.join(cdir, name)
            inst = rebase(val, cdir, fdir, os.path.basename(cfg))
            inst = take(inst, takes, cdir, fdir, plan)
            plan.mkdirs.append(fdir)
            plan.writes.append((os.path.join(fdir, ENTRY), text(inst), None))
    elif isinstance(val, str):
        if to != "dir":
            raise Fail("TargetBad", "the slot is already a string target %r; a string target only takes --to dir (NAME.json -> NAME/)" % val)
        name = name or val
        if name != val or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", val):
            raise Fail("TargetBad", "the slot must be exactly NAME (with NAME.json beside it), it is %r" % val)
        src = os.path.join(cdir, val + ".json")
        if os.path.lexists(os.path.join(cdir, val)) or not os.path.isfile(src):
            raise Fail("TargetBad", "%s is not a file stage with only %s.json" % (val, val))
        file_inst = load(src)
        if not is_inst(file_inst):
            raise Fail("TargetBad", "%s is not an instruction (no argv); only instructions are moved" % src)
        fdir = os.path.join(cdir, val)
        inst = rebase(file_inst, cdir, fdir, os.path.basename(src))
        inst = take(inst, takes, cdir, fdir, plan)
        plan.mkdirs.append(fdir)
        plan.writes.append((os.path.join(fdir, ENTRY), text(inst), None))
        plan.removes.append(src)
        return plan    # 呼叫方不用改：「NAME」本來就會走進資料夾
    else:
        raise Fail("TargetBad", "the slot is neither an inline instruction nor a string (%s)" % type(val).__name__)
    box[key] = name
    plan.writes.append((cfg, text(doc), old_text))
    return plan


def take(inst, takes, cdir, fdir, plan):
    for t in takes:
        src = os.path.normpath(os.path.join(cdir, t))
        if not os.path.isfile(src) or os.path.dirname(src) != cdir:
            raise Fail("TargetBad", "--take only takes files in the config file's folder: %r" % t)
        hit = [i for i, a in enumerate(inst["argv"]) if a in (t, "./" + t)]
        if not hit:
            raise Fail("TargetBad", "the instruction's argv has no %r, so nothing to rewrite" % t)
        for i in hit:
            inst["argv"][i] = {"$env": "AOS_CD", "$path": "/" + os.path.basename(src)}
        plan.moves.append((src, os.path.join(fdir, os.path.basename(src))))
    return inst


def down(caller):
    cfg, parts = parse_caller(caller)
    doc = load(cfg)
    with open(cfg, encoding="utf-8") as fh:
        old_text = fh.read()
    box, key = walk(doc, parts, caller)
    val, cdir, plan = box[key], os.path.dirname(cfg), Plan()
    if not isinstance(val, str) or not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", val):
        raise Fail("TargetBad", "the slot must be exactly NAME (a string), it is %r" % (val,))
    fdir, fjson = os.path.join(cdir, val), os.path.join(cdir, val + ".json")
    if os.path.isdir(fdir):
        rest = sorted(x for x in os.listdir(fdir) if x != ENTRY and x != "__pycache__")
        if rest or not os.path.isfile(os.path.join(fdir, ENTRY)):
            raise Fail("TargetBad", "%s/ holds more than %s (%s); cannot shrink it to one file" % (val, ENTRY, ", ".join(rest) or "no entry"))
        if os.access(os.path.join(fdir, ENTRY), os.X_OK):
            raise Fail("TargetBad", "%s/%s is an executable, not an instruction" % (val, ENTRY))
        inst = load(os.path.join(fdir, ENTRY))
        if not is_inst(inst):
            raise Fail("TargetBad", "%s/%s is not an instruction" % (val, ENTRY))
        if os.path.lexists(fjson):
            raise Fail("NameBad", "%s already exists" % fjson)
        plan.writes.append((fjson, text(rebase(inst, fdir, cdir, ENTRY)), None))
        plan.removes.append(fdir)
        return plan    # 呼叫方不用改
    if not os.path.isfile(fjson):
        raise Fail("TargetBad", "neither %s nor %s/ found" % (fjson, fdir))
    others = mentions(cdir, val, {cfg, os.path.abspath(fjson)})
    other_slots = calls(doc, val) - 1
    if others or other_slots > 0:
        raise Fail("NameBad", "%s is called elsewhere too (%s); not inlining it" % (val, ", ".join(others) or "other slots in the same config file"))
    inst = load(fjson)
    if not is_inst(inst):
        raise Fail("TargetBad", "%s is not an instruction" % fjson)
    box[key] = rebase(inst, cdir, cdir, os.path.basename(fjson))
    plan.writes.append((cfg, text(doc), old_text))
    plan.removes.append(fjson)
    return plan


def main(argv):
    try:
        top, rest = aos_flags.parse(argv, {}, {"--dry-run": "dry"})
    except aos_flags.Error as e:
        reason = str(e) if e.code == "FlagUnknown" else "%s (see %s --help)" % (e, PROG)
        raise Fail(e.code, reason)
    choices = "%s; see %s --help" % (", ".join(HELPS), PROG)
    if not rest:
        raise Fail("ArgumentsBad", "missing subcommand (%s)" % choices)
    sub = rest[0]
    if sub not in HELPS:
        raise Fail("CommandUnknown", "unknown subcommand %s (%s)" % (sub, choices))
    try:
        sub_opts, args = aos_flags.parse(
            rest[1:], {"--to": "to", "--name": "name"}, {}, {"--take": "take"},
            help=HELPS[sub], short=("-n",) if sub == "up" else ())
    except aos_flags.Error as e:
        reason = ("%s (see %s %s --help)" % (e, PROG, sub) if e.code == "FlagUnknown"
                  else sub_reason(sub, e.code, e))
        raise Fail(e.code, reason)
    try:
        dry = top.get("dry", False)
        opts = {"to": sub_opts.get("to"), "name": sub_opts.get("name"), "take": sub_opts.get("take", [])}
        if len(args) != 1:
            raise Fail("ArgumentsBad", "missing CALLER" if not args else
                       "only one CALLER allowed, extra: %s" % args[1])
        if sub == "up":
            if opts["to"] not in ("file", "dir"):
                raise Fail("ArgumentsBad", "up needs --to file or --to dir")
            plan = up(args[0], opts["to"], opts["name"], opts["take"])
        else:
            if opts["to"] or opts["name"] or opts["take"]:
                raise Fail("ArgumentsBad", "down takes no --to / --name / --take")
            plan = down(args[0])
        if dry:
            plan.show(sys.stdout)
        else:
            plan.apply()
    except Fail as e:
        raise Fail(e.code, sub_reason(sub, e.code, e))


def run():
    try:
        main(sys.argv[1:])
    except Fail as e:
        aos_flags.die("aos-grow", e.code, e)


if __name__ == "__main__":
    aos_flags.run(run)
