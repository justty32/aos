#!/usr/bin/env python3
"""aos-eca-turn - 外部 coding agent（claude／codex，eca）的一輪：把 stack 的 queue 裡的信照順序全部一起交給 CLI——交出去就收信——等它答完、回答接進 history。

10-31 改名、升成 bin 指令（使用者「aos eca turn」；C-54 R13 aos-<領域>-<功能>；前身 lib/eca/turn 格的 turn.py，叫法 aos-exec <turn 格>）：

    aos-eca-turn [--one] [--on-empty stop|idle] [--on-busy yield|answer] [--prompt FILE] <定義資料夾絕對路徑>

  旗標在位置參數前（aos_flags.parse）。定義的 loop.json 直接叫它：
    {"exec": {"argv": ["aos-eca-turn", "--on-empty", "idle", "--on-busy", "yield", {"$env": "AOS_CD"}], "timeout_ms": 900000}}
  --on-empty（10-31 取代環境變數 ECA_ON_EMPTY，不再讀它）：queue 空時 stop（沒給；退 10＝loop 收工＝射後不理）｜idle（退 0＝loop 隔 interval_ms 再來）。
  --on-busy（10-31，SessionBad 退讓的開關）：yield（沒給）＝有人佔著就這輪退讓（見下）｜answer＝照常答、不因畫面被佔而退讓
    （lock 拿不到就等、有人接在畫面上照樣貼進畫面答、busy.txt 在就等它消失再貼，期限照 cli.json 的 timeout_ms，逾時 ReplyMissing）。
  --prompt FILE（11-04，開場白檔；使用者「不該在json中指定檔案名稱，應該改成用旗標指定」，thinking 2026-10-30-eca/21）：
    相對路徑從定義資料夾算；給了但不是檔＝PromptMissing、空字串＝ArgumentsBad、跟 --one 一起給＝ArgumentsBad（工具形沒有 queue）；
    沒給＝沒有開場白（不找 prompt.txt）。例：["aos-eca-turn", "--on-empty", "stop", "--prompt", "prompt.txt", {"$env": "AOS_CD"}]。

定義資料夾＝eca 的定義（templates/eca-claude 那種）：頂層 cli.json（kind claude｜codex、flags、print_flags、timeout_ms；
  cli_session 讀的同一份；11-03 起選填 tools、tools_flags；寫了 prompt 不看，開場白走 --prompt）、選填 tools.json（aos-tools 的登記檔：cli.json 沒寫 tools
  就用它，接上 aos-mcp，工作區＝$AOS_WS、stack＝$AOS_STACK；11-03 eca-tools）。定義不被寫（P-15）；寫的都在 $AOS_STACK。

平級形（沒有 --one）——一次替它答一批（11-03 起：使用者 11-03「每次aos-eca-turn就是把所有信一起丟進去(當然，是有順序的)」「一批幾封無上限」，thinking 2026-10-30-eca/17-11-03-批次-status.md；原本一次一則）：
  ① 這一批＝queue 的 cur/ 全部（認領了、還沒交出去的：上次 --on-busy yield 退讓、或 CLI 沒起來）＋ new/ 全部（aos-post take-all），
     照處理順序（aos_ws.letter_key：有序在前照名字＝寄的順序、無序在後照名字；11-03 aos-post 改版，同 aos-post），幾封都行、沒有上限；CLI 跑的期間才寄來的信留在 new/，下一輪再答。
     history 空、queue 也空、--prompt 給的開場白檔非空＝先把它當一則 user 投進 queue（aos-post send --ordered）再認領。
  ② 讀信（aos-post see）：body 不是 {"role": "user", "content": 非空字串}＝壞信，aos-post done 丟掉、原因寫進
     $AOS_STACK/mailbox_warning.txt 一行（只留最後一封；N-16），跳過它、其他封照答（衝突 5、Q-4；11-03 前記在 trace、退 0）。
     名字不是有序的不再算壞信（11-03 aos-post 改版：有序、無序同箱，無序的排在最後、照樣答）。
     整批都是壞信＝不問 CLI、退 0。
  ③ 好信的 content 照順序用一個空行（"\n\n"）接成一段，交給 cli_session 問一次（小格＝$AOS_STACK/<kind>/）：畫面開著＝貼進畫面等 hook；
     沒開＝claude -p --resume／codex exec resume（第一次開新的）——兩條路照 10-24，跟工具形是同一段（cli_session.ask）。
  ④ 交出去就算完成（11-03，使用者「對於eca來說，他收到信後，丟給claude之類的，然後這封信就算是完成了」，thinking 2026-10-30-eca/20-11-03-交出去就收.md）：
     題目交給 CLI 的那一刻（非互動＝CLI 起來、題目寫進 stdin；畫面＝貼上按 Enter；cli_session.ask 的 handed）、等回答之前，
     好信 body 照順序各接一則 user 進 history，再 aos-post done 這批每一封（刪掉）。之後 CLI 的輸出就是結果（沒有「回信」，
     使用者 11-03「沒有回信。claude的輸出結果就是這樣」）：接成一則 {"role": "assistant", "content": 輸出} 進 history。
     CLI 中途掛掉（CliFailed、ReplyMissing、這支被殺）＝邊緣狀況：信已經收了、不自動重答，要重答由人再 say
     （使用者 11-03「中途掛掉就是邊緣狀況，不要讓邊緣狀況影響他的原本意思」；P-12 在 eca 的例外，見 P-43）。
  ⑤ queue 空（cur/、new/ 都沒信）：照 --on-empty——stop 退 10、idle 退 0（Q-9）。
  ⑥ 11-03 起不寫 $AOS_STACK/trace.jsonl（使用者「整個拿掉」，thinking 2026-11-03-trace）；要看狀態用 aos-agent ctl status。
  ⑦ 拿到 session id 就在小格建 transcripts/<kind>-<id>.jsonl symlink（cli_session.link_transcript，C-15～17）。
  --on-busy yield 時 SessionBad（拿不到格的 lock：另一次呼叫或 attach 正在開畫面；有人接在 tmux 畫面上；busy.txt 在＝畫面正在跑一輪）
    ＝還沒交出去：這次退 0 不動、整批信留在 cur/、history 不動，下一次再試（interval_ms）；--on-busy answer 不退讓（見上）。
  人在畫面上自己打的話不進 history（沒經 queue；eca 方向題 2）。
  11-04 起不寫 $AOS_STACK/eca.json（名片沒人讀了：aos-eca 刪了，aos-agent 從 daemon 表的 def 欄找定義；thinking 2026-11-04 aos-agent 05）。
--one（工具形，P-41 工具契約）：stdin {"prompt"} → stdout 回答，對話在 $AOS_STACK 這格本身（cli_session.call_main，需有效的 $AOS_WS）；
  lib 的 claude／codex 走 lib/agent/agent_tool.py 的 ask_cli，與這裡共用 cli_session.ask。
  --on-busy 照認（yield 時 SessionBad 照錯退 1）；跟 --on-empty 一起給＝ArgumentsBad（工具形沒有 queue）。
  錯照 lib 契約 stderr 與 stdout 各一行「<定義資料夾名>: 代號 原因」、退 1。
PATH 上要有 aos-post（平級形）。
錯（平級形與 argv）：stderr 一行「aos-eca-turn: error: 代號 原因」、退 1（P-20 停下等人；11-05 stdio-unify R1，usage 在原因後面）。
  aos-post 的 stderr 原樣透出（不攔、不拿它的第一行當原因；R10），這支只多寫自己那一行（PostFailed「aos-post X exited N」）。交出去之前的錯（CliMissing、ToolsMissing、
  畫面等 busy.txt 逾時的 ReplyMissing…）＝整批信留在 cur/（或還在 new/）、history 不動，修好重跑整批照問；交出去之後的錯＝信已收、user 已接、
  沒有 assistant，不重答（④）。
  代號：ArgumentsBad、FlagUnknown、AgentBad、StackMissing、PromptMissing（11-04：--prompt 給的開場白檔不在）、HistoryBad、PostFailed、WriteFailed，
  加 cli_session 的 CfgMissing、CfgBad、ToolsMissing（11-03 eca-tools：cli.json 的 tools 指的登記檔不在）、CliMissing（含 aos-mcp 不在 PATH 上）、
  CliFailed、ReplyMissing（yield 時的 SessionBad 不算錯，見上）。
`--help`＝印 HELP（英文）到 stdout、退 0（R3）；Ctrl-C＝退 130、不吐 traceback（R12）。"""
import json, os, sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
from pathlib import Path

_import_paths = [HERE]
for _parent in Path(__file__).resolve().parents:
    for _layer, _module in (("py", "aos_flags.py"), ("lib", "agent/__init__.py")):
        _root = _parent / _layer
        if (_root / _module).is_file() and str(_root) not in _import_paths:
            _import_paths.append(str(_root))
sys.path[:0] = _import_paths
try:
    import aos_flags, aos_ws  # noqa: E402
    if os.path.isfile(os.path.join(HERE, "cli_session.py")):
        import cli_session  # noqa: E402
    else:
        import agent.cli_session as cli_session  # noqa: E402
finally:
    for _path in _import_paths:
        sys.path.remove(_path)

NAME = "aos-eca-turn"
NOT_FOUND = 10
USAGE = "aos-eca-turn [--one] [--on-empty stop|idle] [--on-busy yield|answer] [--prompt FILE] DEF_DIR"
aos_flags.HELP = """aos-eca-turn - one turn of an external coding agent (claude / codex, an "eca"): hand every letter in the stack's queue,
in order, to the CLI as one prompt (handing it over = the letters are done), wait for the answer, append it to history.

    aos-eca-turn [--one] [--on-empty stop|idle] [--on-busy yield|answer] [--prompt FILE] DEF_DIR

DEF_DIR: the eca definition folder (absolute; cli.json at its top, optional tools.json). It is never written; everything goes to $AOS_STACK.
Loop form (no --one): the batch = all of queue/cur/ plus all of queue/new/; bad letters are dropped and noted in
  $AOS_STACK/mailbox_warning.txt; good contents are joined with a blank line and asked once (a pasted screen if one is open,
  otherwise claude -p --resume / codex exec resume). The user messages go into history.jsonl when the prompt is handed over, the
  answer goes in as one assistant message.
  --on-empty stop (default): empty queue = exit 10 | idle: exit 0.
  --on-busy yield (default): the session is busy (lock taken, someone attached, busy.txt) = leave the batch in cur/, exit 0 |
    answer: wait and answer anyway.
  --prompt FILE: opening message (relative to DEF_DIR) queued when history and queue are both empty.
--one (tool form): stdin {"prompt"} -> stdout the answer; the conversation lives in $AOS_STACK itself. --on-empty / --prompt not allowed.
Needs aos-post on PATH (loop form) and AOS_STACK.
Errors: one stderr line `aos-eca-turn: error: CODE reason`, exit 1 (tool form: the line also goes to stdout). aos-post's own stderr
  is passed through as it is. Codes: ArgumentsBad, FlagUnknown, AgentBad, StackMissing, PromptMissing, HistoryBad, PostFailed,
  WriteFailed, CfgMissing, CfgBad, ToolsMissing, CliMissing, CliFailed, ReplyMissing."""


class Fail(Exception):
    """自己這層或 cli_session 的錯：code＝代號。"""

    def __init__(self, code, reason):
        super().__init__(str(reason).replace("\n", " "))
        self.code = code


def die(code, reason):
    aos_flags.die(NAME, code, reason)


def names(box, stage):
    """某一格裡的信件名稱（. 開頭的不算，N-05），照處理順序（aos_ws.letter_key）排。"""
    try:
        return sorted((n for n in os.listdir(os.path.join(box, stage)) if not n.startswith(".")), key=aos_ws.letter_key)
    except (FileNotFoundError, NotADirectoryError):
        return []


def write_atomic(path, text):
    """N-05：先寫同資料夾 . 開頭的暫存檔再改名。"""
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError as e:
        raise Fail("WriteFailed", "cannot write %s: %s" % (path, e))


def post(args, stdin_text=""):
    """叫共用的 aos-post 介面，把錯誤換成這層的 Fail。"""
    try:
        return aos_ws.run_post(args, stdin_text)
    except aos_ws.Error as e:
        raise Fail(e.code, e)


def must_post(args, stdin_text="", ok=(0,)):
    code, out = post(args, stdin_text)
    if code not in ok:
        raise Fail("PostFailed", "aos-post %s exited %d" % (args[0], code))
    return code, out


# ---- history（$AOS_STACK/history.jsonl，一行一則 OpenAI message，只附加；P-41）----

def history_rows(stack):
    rows = []
    try:
        with open(os.path.join(stack, "history.jsonl"), encoding="utf-8") as f:
            for i, line in enumerate(f, 1):
                if not line.strip():
                    continue
                try:
                    m = json.loads(line)
                except ValueError:
                    m = None
                if not isinstance(m, dict):
                    raise Fail("HistoryBad", "history.jsonl line %d is not a JSON object" % i)
                rows.append(m)
    except FileNotFoundError:
        pass
    except OSError as e:
        raise Fail("HistoryBad", "cannot read history.jsonl: %s" % e)
    return rows


def append_history(stack, msg):
    try:
        with open(os.path.join(stack, "history.jsonl"), "a", encoding="utf-8") as f:   # 一次寫一整行
            f.write(json.dumps(msg, ensure_ascii=False) + "\n")
    except OSError as e:
        raise Fail("WriteFailed", "cannot append to history.jsonl: %s" % e)


# ---- mailbox_warning.txt ----

def warn(stack, sig, why):
    """N-16 壞信記 mailbox_warning：$AOS_STACK/mailbox_warning.txt 一行、只留最後一封（11-03 前記在 trace）。"""
    write_atomic(os.path.join(stack, "mailbox_warning.txt"), "letter %s rejected: %s\n" % (sig, why.replace("\n", " ")))


# ---- 一批 ----

def letter_body(box, sig):
    """好信回 (body, None)；壞信回 (None, 原因)。"""
    code, out = post(["see", box, sig])
    if code != 0:
        return None, "aos-post see exited %d" % code
    try:
        body = json.loads(out).get("body")
    except (ValueError, AttributeError):
        return None, "aos-post see did not print a JSON object"
    if not (isinstance(body, dict) and body.get("role") == "user" and isinstance(body.get("content"), str)
            and body["content"].strip()):
        return None, "body must be {\"role\": \"user\", \"content\": non-empty string}"
    return body, None


def opening(stack, box, path):
    """history 空、queue 也空、有開場白檔＝把開場白投進 queue（射後不理那種的第一則）。回 True＝投了。
    開場白檔＝--prompt 給的（main 已轉成絕對路徑）；沒給（None）＝沒有開場白，不找 prompt.txt（11-04 翻案）。"""
    if not path:
        return False
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:                                       # main 驗過之後才被刪掉；給了就要有
        raise Fail("PromptMissing", "prompt file not found: %s" % path)
    except OSError as e:
        raise Fail("AgentBad", "cannot read %s: %s" % (path, e))
    text = text[:-1] if text.endswith("\n") else text           # 結尾一個換行不算
    if not text.strip() or history_rows(stack):
        return False
    must_post(["send", "--ordered", box], json.dumps({"role": "user", "content": text}, ensure_ascii=False))
    return True


SEP = "\n\n"                                   # 一批好幾封時，各封 content 照順序用一個空行接起來（11-03 代定）


def take_all(stack, box, prompt):
    """new/ 裡的信全部認領到 cur/（aos-post take-all；沒信退 NOT_FOUND＝剛好被撤回，不算錯）；一批幾封沒有上限（11-03）。
    history 空、queue 也空、給了開場白檔（--prompt）＝先投開場白再認領。"""
    if not names(box, "new") and not names(box, "cur") and not opening(stack, box, prompt):
        return
    if names(box, "new"):
        must_post(["take-all", box], ok=(0, NOT_FOUND))            # new/ → cur/


def one_turn(template, stack, ws, empty_code, on_busy, prompt):
    box = os.path.join(stack, "queue")
    if not all(os.path.isdir(os.path.join(box, s)) for s in ("tmp", "new", "cur")):
        must_post(["init", box])                                   # 先建好，aos-agent say／listen 認得
    cfg = cli_session.load_cfg(template)
    cell = cli_session.Cell(os.path.join(stack, cfg["kind"]))
    take_all(stack, box, prompt)                                   # 這輪要答的＝cur/ 全部（上次沒交出去的＋剛認領的）
    batch = names(box, "cur")
    if not batch:
        return empty_code
    bodies, good = [], []
    for sig in batch:                                               # ② 照順序讀信
        body, why = letter_body(box, sig)
        if body is None:                                            # 壞信一律丟（N-16、決定 27 不通知寄信人）
            post(["done", box, sig])
            warn(stack, sig, why)
            continue
        bodies.append(body)
        good.append(sig)
    if not good:
        return 0
    late = []                                                       # 交出去那一刻收信時出的錯：CLI 已經在跑，等它答完再報

    def handed():                                                   # ④ 交出去就算完成（11-03）：user 接進 history、收信
        try:
            for body in bodies:
                append_history(stack, body)
            for sig in good:
                must_post(["done", box, sig])
        except Fail as e:
            late.append(e)
    try:
        text = cli_session.ask(cfg, cell, template, ws, stack, SEP.join(b["content"] for b in bodies), on_busy,
                               handed)                              # 一批一次（11-03）；跟工具形同一段；stack 給 aos-mcp（11-03 eca-tools）
    except Fail as e:
        if e.code == "SessionBad":                                  # 只有 --on-busy yield 會丟，一定在交出去之前
            return 0                                                # 整批留 cur/，下一次再試
        raise
    if late:
        raise late[0]
    append_history(stack, {"role": "assistant", "content": text[:-1] if text.endswith("\n") else text})
    return 0


def _cli_die(code, reason):                    # cli_session 出錯時本來 exit；平級形改成丟例外，這支自己說一行
    raise Fail(code, reason)


def main():
    try:
        opts, args = aos_flags.parse(sys.argv[1:], {"--on-empty": "on_empty", "--on-busy": "on_busy", "--prompt": "prompt"},
                                     {"--one": "one"})
    except aos_flags.Error as e:
        die(e.code, "%s (usage: %s)" % (e, USAGE))
    if len(args) != 1:
        die("ArgumentsBad", "%s (usage: %s)" % ("missing DEF_DIR" if not args else "only one DEF_DIR allowed, extra: %s" % args[1], USAGE))
    empty, busy = opts.get("on_empty", "stop"), opts.get("on_busy", "yield")
    if empty not in ("stop", "idle"):
        die("ArgumentsBad", "--on-empty must be stop or idle, got %r" % empty)
    if busy not in ("yield", "answer"):
        die("ArgumentsBad", "--on-busy must be yield or answer, got %r" % busy)
    if opts.get("one") and "on_empty" in opts:
        die("ArgumentsBad", "--one (tool form) has no queue; --on-empty not allowed")
    if opts.get("one") and "prompt" in opts:
        die("ArgumentsBad", "--one (tool form) has no queue; --prompt not allowed")
    if opts.get("prompt") == "":
        die("ArgumentsBad", "--prompt needs the path of a prompt file")
    template = args[0]
    if not os.path.isabs(template) or not os.path.isdir(template):
        die("AgentBad", "definition dir must be an existing absolute path, got %r" % template)
    template = os.path.normpath(template)
    prompt = None
    if "prompt" in opts:                                           # 相對路徑從定義資料夾算（11-04）
        prompt = os.path.normpath(os.path.join(template, opts["prompt"]))
        if not os.path.isfile(prompt):
            die("PromptMissing", "--prompt file not found: %s" % prompt)
    if opts.get("one"):
        cli_session.call_main(template, busy)                      # --one 專用入口；lib 的 ask_cli 與它共用 cli_session.ask
        return
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "AOS_STACK is not set")
    stack = os.path.abspath(stack)
    ws = os.path.abspath(os.environ.get("AOS_WS") or ".")
    cli_session.die = _cli_die
    try:
        code = one_turn(template, stack, ws, NOT_FOUND if empty == "stop" else 0, busy, prompt)
    except Fail as e:
        die(e.code, e)
    sys.exit(code)


aos_flags.run(main)
