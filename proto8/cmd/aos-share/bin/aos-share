#!/usr/bin/env python3
# aos-share：替共用夾與點名使用者的檔案套用六種 ACL 樣板，另有唯讀體檢 check 與退回 reset。
import errno
import fnmatch
import json
import os
import pwd
import re
import shutil
import stat
import struct
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "py"))
import aos_flags  # noqa: E402

PROG = "aos-share"
KINDS = ("team", "read", "key", "work", "drop", "stack")
USAGE = "(usage: aos-share [--dry-run] KIND PATH (--group G | --uid U)...)"
HELP = """aos-share - apply an ACL template to a shared folder or a named-user file

usage: aos-share [--dry-run] KIND PATH (--group G | --uid U)...
       aos-share check [-R] [--list-acl] PATH...
       aos-share reset [-R] [--dry-run] PATH...
       aos-share --help

kinds:
  team   create a shared writable folder; exactly one --group
  read   recursively share an existing path read-only; one or more --group
  key    share an existing regular file read-only; one or more --uid
  work   create a shared writable sticky folder; exactly one --group
  drop   create a sticky delivery box with tmp/new/cur; exactly one --group
  stack  create a private stack shared with one user; exactly one --uid

subcommands (must be the first word):
  check  read-only health check: one line per finding, last line "total: N";
         exit 1 if N > 0, else 0. Findings:
           secret-open PATH mode=0644
             a secret file readable by group or other (.env, *.env, token*,
             *token*.json, *.key, exec.json, *secret*, or a file named by
             env_file in a tools.json inside the checked paths)
           acl-masked PATH entry=u:ID:rwx effective=r--
             the mask cuts permissions of a named ACL entry (d: = default ACL)
           acl-missing PATH (parent has default ACL)
             no extended ACL although the parent folder has a default ACL
           acl-present PATH
             any extended or default ACL (only listed with --list-acl)
           unreadable PATH ERRNO
             the entry could not be inspected
  reset  undo the templates: setfacl [-R] -b PATH, then chmod g-s,-t on PATH
         if it is a folder (with -R: on every folder below it too); rwx bits
         and ownership stay (README: restoring ownership is a second step).
  -R, --recursive   check/reset: also every entry below PATH (symlinks skipped)
  --list-acl        check: also list acl-present lines

flags:
  --group G   numeric real gid, or sub:N from the current user's /etc/subgid
  --uid U     numeric real uid, or sub:N from the current user's /etc/subuid
  --dry-run   print each command without changing or checking the target path
  -h, --help  show this help
sub:N uses N from 1 to 65536 within the first matching subid range. Numbers
must not have leading zeroes, signs or whitespace. AOS_SHARE_SUBUID and
AOS_SHARE_SUBGID override the subid files for tests only.
After applying ACLs, warn about ancestors without search permission.
Drop senders must create files/folders with group bits (for example 0660/0777).
exit codes: 0 success; 1 error ("aos-share: error: CODE reason" on stderr):
ArgumentsBad, FlagUnknown, SubidMissing, PathMissing, CommandMissing, AclFailed.
more: proto8/cmd/aos-share/README.md
"""


def resolve_id(value, kind):
    if re.fullmatch(r"0|[1-9][0-9]*", value):
        return value
    match = re.fullmatch(r"sub:([1-9][0-9]{0,4})", value)
    if not match or int(match[1]) > 65536:
        aos_flags.die(PROG, "ArgumentsBad", "invalid %s id %r" % (kind, value))
    number = int(match[1])
    uid = os.getuid()
    user = pwd.getpwuid(uid).pw_name
    filename = os.environ.get("AOS_SHARE_SUB" + kind.upper(), "/etc/sub" + kind)
    try:
        with open(filename, encoding="utf-8") as source:
            for line in source:
                if not line.strip() or line.lstrip().startswith("#"):
                    continue
                fields = line.rstrip("\n").split(":")
                if fields[0] not in (user, str(uid)):
                    continue
                if len(fields) != 3 or not all(re.fullmatch(r"[0-9]+", x) for x in fields[1:]):
                    aos_flags.die(PROG, "SubidMissing", "invalid line for %s in %s" % (user, filename))
                numbers = [value.lstrip("0") or "0" for value in fields[1:]]
                if any(len(value) > 10 for value in numbers):
                    aos_flags.die(PROG, "SubidMissing", "range for %s in %s is out of bounds" % (user, filename))
                start, count = map(int, numbers)
                if start > 2**32 - 2 or count > 2**32 - 2 or start + count - 1 > 2**32 - 2:
                    aos_flags.die(PROG, "SubidMissing", "range for %s in %s is out of bounds" % (user, filename))
                if number > count:
                    aos_flags.die(PROG, "SubidMissing", "%s exceeds range for %s in %s" % (value, user, filename))
                return str(start + number - 1)
    except (OSError, UnicodeError) as exc:
        aos_flags.die(PROG, "SubidMissing", "cannot read %s: %s" % (filename, exc))
    aos_flags.die(PROG, "SubidMissing", "no line for %s in %s" % (user, filename))


def commands(kind, path, ids):
    me = os.getuid()
    target = ids[0]
    if kind in ("team", "work"):
        return [
            ["mkdir", "-p", path],
            ["chmod", "2770" if kind == "team" else "3770", path],
            ["setfacl", "-m", "g:%s:rwx,d:g:%s:rwx,d:u:%s:rwx,m::rwx,d:m::rwx" % (target, target, me), path],
        ]
    if kind == "read":
        result = []
        for target in ids:
            result.extend([
                ["setfacl", "-R", "-m", "g:%s:rX" % target, path],
                ["setfacl", "-R", "-d", "-m", "g:%s:rX" % target, path],
            ])
        return result + [["setfacl", "-R", "-m", "m::rwX", path]]
    if kind == "key":
        return [["chmod", "600", path]] + [
            ["setfacl", "-m", "u:%s:r" % target, path] for target in ids
        ] + [["setfacl", "-m", "m::r", path]]
    if kind == "drop":
        folders = [path] + [os.path.join(path, name) for name in ("tmp", "new", "cur")]
        result = [["mkdir", "-p", *folders]]
        for folder in folders[:3]:
            result.extend([
                ["chmod", "1730", folder],
                ["setfacl", "-m", "g:%s:wx,m::wx" % target, folder],
                ["setfacl", "-d", "-m", "u:%s:rwX,g::---,o::---,m::rwX" % me, folder],
            ])
        return result + [["chmod", "700", folders[3]]]
    return [
        ["mkdir", "-p", path],
        ["chmod", "700", path],
        ["setfacl", "-m", "u:%s:rwx,d:u:%s:rwx,d:u:%s:rwx,m::rwx,d:m::rwx" % (target, target, me), path],
    ]


def run_command(argv):
    try:
        result = subprocess.run(argv, capture_output=True, text=True)
    except FileNotFoundError:
        aos_flags.die(PROG, "CommandMissing", "%s not found on PATH" % argv[0])
    except OSError as exc:
        aos_flags.die(PROG, "AclFailed", "%s failed: %s" % (" ".join(argv), exc))
    if result.returncode:
        reason = result.stderr.splitlines()[0] if result.stderr else "exit status %s" % result.returncode
        aos_flags.die(PROG, "AclFailed", "%s failed: %s" % (" ".join(argv), reason))
    return result.stdout


def warn_ancestors(path, kind, ids):
    parent = os.path.dirname(os.path.realpath(path))
    ancestors = []
    while True:
        ancestors.append(parent)
        if parent == "/":
            break
        parent = os.path.dirname(parent)
    for parent in reversed(ancestors):
        try:
            if os.stat(parent).st_mode & 0o001:
                continue
            result = subprocess.run(["getfacl", "-n", "--omit-header", "--absolute-names", "-c", parent],
                                    capture_output=True, text=True)
            if result.returncode:
                reason = result.stderr.splitlines()[0] if result.stderr else "exit status %s" % result.returncode
                aos_flags.warn(PROG, "cannot check %s: %s" % (parent, reason))
                continue
            acl = result.stdout
        except OSError as exc:
            aos_flags.warn(PROG, "cannot check %s: %s" % (parent, exc.strerror or exc))
            continue
        accessible = set()
        for line in acl.splitlines():
            entry, marker, effective = line.partition("#effective:")
            fields = entry.strip().split(":")
            if len(fields) == 3 and fields[0] == kind:
                permissions = effective.strip() if marker else fields[2]
                if "x" in permissions:
                    accessible.add(fields[1])
        for target in dict.fromkeys(ids):
            if target not in accessible:
                aos_flags.warn(PROG, "%s gives no x to others: uid/gid %s cannot reach %s" % (parent, target, path))


SUBCOMMANDS = ("check", "reset")
CHECK_USAGE = "(usage: aos-share check [-R] [--list-acl] PATH...)"
RESET_USAGE = "(usage: aos-share reset [-R] [--dry-run] PATH...)"
SECRET_NAMES = (".env", "*.env", "token*", "*token*.json", "*.key", "exec.json", "*secret*")
ACL_ACCESS = "system.posix_acl_access"
ACL_DEFAULT = "system.posix_acl_default"
ACL_USER, ACL_GROUP, ACL_MASK = 0x02, 0x08, 0x10
ACL_EXTENDED = (ACL_USER, ACL_GROUP, ACL_MASK)


def read_acl(path, name, follow):
    """ACL entries [(tag, perm, id)] from the xattr (what getfacl reads); none = []."""
    try:
        data = os.getxattr(path, name, follow_symlinks=follow)
    except OSError as exc:
        if exc.errno in (errno.ENODATA, errno.ENOTSUP, errno.EOPNOTSUPP):
            return []
        raise
    return [struct.unpack_from("<HHI", data, offset) for offset in range(4, len(data) - 7, 8)]


def perm_text(perm):
    return "".join(letter if perm & bit else "-" for letter, bit in (("r", 4), ("w", 2), ("x", 1)))


def masked_lines(path, entries, prefix):
    masks = [perm for tag, perm, _ in entries if tag == ACL_MASK]
    if not masks:
        return []
    lines = []
    for tag, perm, number in entries:
        if tag in (ACL_USER, ACL_GROUP) and perm & masks[0] != perm:
            lines.append("acl-masked %s entry=%s%s:%s:%s effective=%s" % (
                path, prefix, "u" if tag == ACL_USER else "g", number, perm_text(perm), perm_text(perm & masks[0])))
    return lines


def errno_name(exc):
    return errno.errorcode.get(exc.errno, str(exc.errno))


def check_items(paths, recursive, problems):
    """[(path, is_argument)] in a stable order; folders that cannot be listed become unreadable lines."""
    items = []
    for path in paths:
        items.append((path, True))
        if not recursive or not os.path.isdir(path):
            continue

        def failed(exc):
            problems.append("unreadable %s %s" % (exc.filename, errno_name(exc)))
        for root, folders, files in os.walk(path, onerror=failed):
            folders.sort()
            for name in sorted(folders + files):
                items.append((os.path.join(root, name), False))
    return items


def env_file_targets(found, problems):
    """Real paths named by env_file in the tools.json files among the checked entries."""
    targets = set()
    for path in found:
        if os.path.basename(path) != "tools.json":
            continue
        try:
            with open(path, encoding="utf-8") as source:
                data = json.load(source)
        except OSError as exc:
            problems.append("unreadable %s %s" % (path, errno_name(exc)))
            continue
        except (ValueError, UnicodeError):
            continue
        tools = data.get("tools") if isinstance(data, dict) else None
        for entry in (tools.values() if isinstance(tools, dict) else ()):
            value = entry.get("env_file") if isinstance(entry, dict) else None
            if isinstance(value, str) and value and "\0" not in value:
                folder = os.path.dirname(os.path.abspath(path))
                targets.add(os.path.realpath(os.path.join(folder, value)))
    return targets


def is_secret(path, targets):
    name = os.path.basename(path)
    return any(fnmatch.fnmatchcase(name, pattern) for pattern in SECRET_NAMES) or os.path.realpath(path) in targets


def check(paths, recursive, list_acl):
    problems = []
    items = check_items(paths, recursive, problems)
    found = []
    for path, argument in items:
        try:
            info = os.stat(path) if argument else os.lstat(path)
        except OSError as exc:
            problems.append("unreadable %s %s" % (path, errno_name(exc)))
            continue
        if not stat.S_ISLNK(info.st_mode):
            found.append((path, argument, info))
    targets = env_file_targets([path for path, _, info in found if stat.S_ISREG(info.st_mode)], problems)
    for path, argument, info in found:
        mode = info.st_mode
        if stat.S_ISREG(mode) and mode & 0o044 and is_secret(path, targets):
            problems.append("secret-open %s mode=%04o" % (path, mode & 0o7777))
        try:
            access = read_acl(path, ACL_ACCESS, argument)
            default = read_acl(path, ACL_DEFAULT, argument) if stat.S_ISDIR(mode) else []
            parent = os.path.dirname(os.path.abspath(path))
            inherited = read_acl(parent, ACL_DEFAULT, True) if parent != os.path.abspath(path) else []
        except OSError as exc:
            problems.append("unreadable %s %s" % (path, errno_name(exc)))
            continue
        problems.extend(masked_lines(path, access, "") + masked_lines(path, default, "d:"))
        extended = any(tag in ACL_EXTENDED for tag, _, _ in access)
        if not extended and any(tag in ACL_EXTENDED for tag, _, _ in inherited):
            problems.append("acl-missing %s (parent has default ACL)" % path)
        if list_acl and (extended or default):
            problems.append("acl-present %s" % path)
    for line in problems:
        print(line)
    print("total: %d" % len(problems))
    if problems:
        sys.exit(1)


def reset_steps(paths, recursive):
    steps = []
    for path in paths:
        steps.append(["setfacl"] + (["-R"] if recursive else []) + ["-b", path])
        folders = [path] if os.path.isdir(path) else []
        if recursive and folders:
            for root, children, _ in os.walk(path):
                children.sort()
                if root != path:
                    folders.append(root)
        steps.extend(["chmod", "g-s,-t", folder] for folder in folders)
    return steps


def subcommand(name, argv):
    usage = CHECK_USAGE if name == "check" else RESET_USAGE
    switches = {"--recursive": "recursive"}
    switches["--list-acl" if name == "check" else "--dry-run"] = "list_acl" if name == "check" else "dry_run"
    try:
        opts, paths = aos_flags.parse(argv, {}, switches=switches, short={"-R": "--recursive"}, anywhere=True)
    except aos_flags.Error as exc:
        aos_flags.die(PROG, exc.code, "%s %s" % (exc, usage))
    if not paths:
        aos_flags.die(PROG, "ArgumentsBad", "expected at least one PATH " + usage)
    recursive = bool(opts.get("recursive"))
    if name == "check":
        check(paths, recursive, bool(opts.get("list_acl")))
        return
    if opts.get("dry_run"):
        for step in reset_steps(paths, recursive):
            print(" ".join(step))
        return
    for path in paths:
        if not os.path.exists(path):
            aos_flags.die(PROG, "PathMissing", "%s does not exist" % path)
    if not shutil.which("setfacl"):
        aos_flags.die(PROG, "CommandMissing", "setfacl not found on PATH")
    for step in reset_steps(paths, recursive):
        run_command(step)


def main():
    aos_flags.HELP = HELP
    if sys.argv[1:2] and sys.argv[1] in SUBCOMMANDS:
        subcommand(sys.argv[1], sys.argv[2:])
        return
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], {}, switches={"--dry-run": "dry_run"},
                                     multi={"--group": "groups", "--uid": "uids"}, anywhere=True)
    except aos_flags.Error as exc:
        aos_flags.die(PROG, exc.code, "%s %s" % (exc, USAGE))
    if not rest or rest[0] not in KINDS:
        aos_flags.die(PROG, "ArgumentsBad", "KIND must be one of %s %s" % (", ".join(KINDS), USAGE))
    if len(rest) != 2:
        aos_flags.die(PROG, "ArgumentsBad", "expected KIND and PATH " + USAGE)
    kind, path = rest
    use_uid = kind in ("key", "stack")
    values = opts.get("uids" if use_uid else "groups", [])
    wrong = opts.get("groups" if use_uid else "uids")
    if wrong or not values or (kind not in ("read", "key") and len(values) != 1):
        aos_flags.die(PROG, "ArgumentsBad", "flags do not match %s %s" % (kind, USAGE))
    ids = [resolve_id(value, "uid" if use_uid else "gid") for value in values]
    steps = commands(kind, path, ids)
    if opts.get("dry_run"):
        for step in steps:
            print(" ".join(step))
        return
    if kind in ("read", "key") and not os.path.exists(path):
        aos_flags.die(PROG, "PathMissing", "%s does not exist" % path)
    if kind == "key" and not os.path.isfile(path):
        aos_flags.die(PROG, "PathMissing", "%s is not a regular file" % path)
    for command in ("setfacl", "getfacl"):
        if not shutil.which(command):
            aos_flags.die(PROG, "CommandMissing", "%s not found on PATH" % command)
    for step in steps:
        run_command(step)
    warn_ancestors(path, "user" if use_uid else "group", ids)


if __name__ == "__main__":
    aos_flags.run(main)
