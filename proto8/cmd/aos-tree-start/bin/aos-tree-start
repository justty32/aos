#!/usr/bin/env python3
# aos-tree-start - 起一棵樹的根（aos-tree-start root＝aos-exec root）；殼裡帶著 AOS_HOME 以外的 AOS_*（從別棵樹或 agent 的殼繼承來的）就拒絕，除非 --force（11-13 線瑣，agents-feedback T07）。
# 為什麼要這支：11-13 15:24 在 eca_main 的殼起樹，AOS_STACK 沒清，根把那隻 agent 的 stack 當成自己的（gotchas/05）。aos-exec 本身分不出
#   「起樹」與「樹裡的巢狀呼叫」（子項本來就帶 AOS_STACK），所以擋在明說要起樹的這支。只看名字、不印值（值可能是祕密或長路徑）。
# 允許的只有 AOS_HOME（env.sh 清完會設它；範本 daemon-root 也要它）。檢查過了就 exec aos-exec（pid 不變，前景跑、Ctrl-C 照舊整棵停）。
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(HERE, "..", "..", "..", "py"))
import aos_flags  # noqa: E402

PROG = "aos-tree-start"
ALLOWED = ("AOS_HOME",)
USAGE = "(usage: aos-tree-start [--force] AOS_EXEC_ARG...)"
HELP = """aos-tree-start - start the root of an aos tree in the foreground, refusing an environment inherited from another tree

usage: aos-tree-start [--force] AOS_EXEC_ARG...

Runs `aos-exec AOS_EXEC_ARG...` in this folder, replacing itself (same pid; Ctrl-C stops the whole
tree as before); for the usual tree `aos-tree-start root` = `aos-exec root`. Before that it looks at the environment: any AOS_* variable
other than AOS_HOME (AOS_STACK, AOS_DAEMON, AOS_WS, AOS_CLOCK ...) means this shell was started by
another tree or an agent in one, and the new root would take that tree's stack or daemon as its own.
Then it refuses and names the variables (never their values).
Usual start:  cd ~/aos-home && source env.sh && aos-tree-start root
(env.sh clears every AOS_* and sets AOS_HOME; from an agent's shell source it with bash, not zsh).

flags:
  --force     start anyway with the inherited variables (one warning line naming them)
  -h, --help  show this help
Arguments for aos-exec that start with - go after --:  aos-tree-start -- --stack stacks/root defs
exit codes: whatever aos-exec returns; 1 error ("aos-tree-start: error: CODE reason" on stderr):
EnvBad (inherited AOS_* without --force), CommandMissing (aos-exec not on PATH), ArgumentsBad, FlagUnknown.
more: proto8/cmd/aos-tree-start/README.md"""


def inherited():
    """環境裡 AOS_HOME 以外的 AOS_* 名字（排序）。"""
    return sorted(k for k in os.environ if k.startswith("AOS_") and k not in ALLOWED)


def main():
    aos_flags.HELP = HELP
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], {}, switches={"--force": "force"})
    except aos_flags.Error as e:
        aos_flags.die(PROG, e.code, "%s %s" % (e, USAGE))
    if not rest:
        aos_flags.die(PROG, "ArgumentsBad", "missing AOS_EXEC_ARG (the usual tree: aos-tree-start root) " + USAGE)
    names = inherited()
    if names and not opts.get("force"):
        aos_flags.die(PROG, "EnvBad", "%s set in this shell (inherited from another tree or an agent's shell?): "
                      "the root would use them; clear every AOS_* except AOS_HOME first "
                      "(cd TREE && source env.sh, in bash), or pass --force" % ", ".join(names))
    if names:
        aos_flags.warn(PROG, "starting with inherited %s (--force)" % ", ".join(names))
    argv = ["aos-exec"] + rest
    try:
        os.execvp(argv[0], argv)
    except OSError as e:
        aos_flags.die(PROG, "CommandMissing", "cannot run aos-exec: %s (run proto8/install.sh once)" % e.strerror)


if __name__ == "__main__":
    aos_flags.run(main)
