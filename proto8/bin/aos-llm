#!/usr/bin/env python3
"""aos-llm - 看／改 agent 定義裡的腦設定（使用者 11-04 晚「aos-agent llm改正在跑著的，aos-llm改定義」；thinking 2026-11-04 aos-agent 03/02）。

    aos-llm XXX [show|set 鍵=值…]        XXX＝agent 定義資料夾；沒給動作＝show

它不懂任何格式：讀 <XXX>/interfaces.json 的 aos-agent.llm（宣告的 llm 資料夾程式）→ 那個資料夾的 interfaces.json 要宣告 aos-agent/llm →
`aos-exec --ws <XXX> --stack <暫存資料夾> <XXX>/<llm> def 動作 …`（stack 用完就刪；不給的話 aos-exec 會建 <XXX>/.stack、寫到定義），stdio 透傳、結束碼照傳。改了＝之後從它 add 的、
沒有副本的那幾隻下一題都變（有副本的不跟，要跟用 aos-agent llm --target 名字 reset）。跟 aos-tools 並列（工具箱改定義用 aos-tools）。
錯：stderr 一行 `aos-llm: 代號 原因`、退 1：ArgumentsBad、FlagUnknown、PathMissing（XXX 不是資料夾）、
InterfaceMissing（沒有 interfaces.json 或沒有 aos-agent key）、InterfaceBad（讀不懂）、LlmMissing（沒宣告 llm）、LlmBad（llm 資料夾不在或沒宣告 aos-agent/llm）；
入口自己的錯（KeyUnknown…）它自己 stderr 說、結束碼照傳。"""
import json, os, subprocess, sys, tempfile

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_flags  # noqa: E402

NAME = "aos-llm"
USAGE = "aos-llm XXX [show|set 鍵=值…]"


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def read_decl(path, missing_code, what):
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except FileNotFoundError:
        raise Fail(missing_code, "%s 沒有 interfaces.json（%s）" % (os.path.dirname(path), what))
    except (OSError, ValueError) as e:
        raise Fail("InterfaceBad", "%s 讀不懂：%s" % (path, e))
    if not isinstance(d, dict):
        raise Fail("InterfaceBad", "%s 要是 JSON 物件" % path)
    return d


def main():
    try:
        try:
            _, rest = aos_flags.parse(sys.argv[1:], {})
        except aos_flags.Error as e:
            raise Fail(e.code, "%s（usage: %s）" % (e, USAGE))
        if not rest:
            raise Fail("ArgumentsBad", "usage: %s" % USAGE)
        xxx, args = os.path.abspath(rest[0]), rest[1:] or ["show"]
        if args[0] not in ("show", "set"):
            raise Fail("ArgumentsBad", "動作只有 show、set（usage: %s）" % USAGE)
        if not os.path.isdir(xxx):
            raise Fail("PathMissing", "%s 不是資料夾" % rest[0])
        decl = read_decl(os.path.join(xxx, "interfaces.json"), "InterfaceMissing",
                         '宣告一行：{"aos-agent": {"llm": "llm"}}')
        if "aos-agent" not in decl:
            raise Fail("InterfaceMissing", "%s 沒宣告遵守 aos-agent 介面" % rest[0])
        agent = decl["aos-agent"]
        if not isinstance(agent, dict):
            raise Fail("InterfaceBad", "%s/interfaces.json 的 aos-agent 要是物件" % rest[0])
        if not isinstance(agent.get("llm"), str) or not agent["llm"]:
            raise Fail("LlmMissing", '%s 沒宣告子介面 llm（interfaces.json 的 aos-agent 加 "llm": "<資料夾>"）' % rest[0])
        entry = os.path.normpath(os.path.join(xxx, agent["llm"]))
        if not os.path.isdir(entry):
            raise Fail("LlmBad", "宣告的 llm 資料夾不在：%s" % entry)
        try:
            sub = read_decl(os.path.join(entry, "interfaces.json"), "LlmBad", "沒宣告 aos-agent/llm")
        except Fail as e:
            raise Fail("LlmBad", str(e))
        if "aos-agent/llm" not in sub:
            raise Fail("LlmBad", "%s 沒宣告遵守 aos-agent/llm" % entry)
        # stack 給一個用完就丟的暫存資料夾：aos-exec 一定建 stack，不給會建在 <XXX>/.stack（寫到定義，P-15）；入口的 def 對象不看它
        with tempfile.TemporaryDirectory(prefix="aos-llm-") as tmp:
            try:
                r = subprocess.run(["aos-exec", "--ws", xxx, "--stack", tmp, entry, "def"] + args)
            except OSError as e:
                raise Fail("LlmBad", "aos-exec 起不來：%s" % e)
        sys.exit(r.returncode)
    except Fail as e:
        print("%s: %s %s" % (NAME, e.code, e), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
