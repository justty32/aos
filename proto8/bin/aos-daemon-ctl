#!/usr/bin/env python3
"""aos-daemon-ctl [--daemon D] add|rm|ls … — 把東西掛到一個 aos-daemon 上（10-30，使用者「或許是aos-daemon-ctl add XXX這樣」）。

`aos-exec XXX`＝掛到 Linux 的 proc 管理；`aos-daemon-ctl add XXX`＝掛到 daemon 上。本質是 N-54 的管轄手把：
往 daemon 的信箱（信箱模式，N-28 的 10-29 補）投一封 `loops_added`／`execs_added` 的信。設計與代定見
proto8/thinking/2026-10-30-agent-lifecycle.md（實作第 7 步的補）與 bin/README.md。

    aos-daemon-ctl [--daemon D] add [--name N] [--kind loop|exec|max1] [--ws WS] XXX   掛上去；stdout 印信號（aos-post 給的）
    aos-daemon-ctl [--daemon D] rm 名字                                       拿下來（loops_removed＋execs_removed 都寫）；印信號
    aos-daemon-ctl [--daemon D] ls [--json]                                   列 loops_state.json 兩張表：一行「名字 TAB loop|exec TAB phase TAB pid TAB code TAB ws」

哪個 daemon（N-63 hub 型變數）：--daemon ＞ $AOS_DAEMON；值＝那個 daemon 的 $AOS_STACK 資料夾（它的窗都在這：
  loops_mailbox/、loops_state.json，用預設名字）。都沒有＝DaemonMissing；不是資料夾＝DaemonMissing。子 proc 照常繼承 AOS_DAEMON。
  信箱固定是 <D>/loops_mailbox/（daemon.json 要寫 "loops_mailbox": "loops_mailbox"）；沒有 new/＝MailboxMissing（daemon 不是信箱模式或還沒起）。
add 的自動識別（--kind 沒給時）：XXX 是資料夾、裡面有 loop.json＝loop 型（daemon 的子 loop 直接跑 XXX 的 loop.json）；其他＝exec 型（execs）。
  loop：子項設定＝XXX/loop.json 的內容（去掉 _entry），exec 的相對目標照 XXX 轉絕對、單子沒寫 cwd＝補 XXX、相對的 cwd 接在 XXX 後面；
        ctl／state 原樣（相對 $AOS_STACK，落在小格）。XXX 的 .env、loop.json 裡的 $ref／$env 不處理（照 daemon 的規則從它的 cwd 算）。
  exec：execs_added {名字: XXX 的絕對路徑}（`檔#/指標` 只轉 # 前面）。
  max1（使用者 10-30「包成max:1也是可以」，只在 --kind 指定時）：loops_added {名字: {"exec": XXX, "max": 1}}。
  名字：--name ＞ XXX 的資料夾名（# 前面那段的 basename）。名字合不合格、撞不撞名由 daemon 驗（壞信記在 loops_state.json 的 letter_warning）。
  信只說「要」，daemon 下一圈才套；結果看 ls。
--ws WS（10-30 eca 第 2 步，thinking 2026-10-30-eca 衝突 1、3）：這個子項的工作區。WS 從呼叫當下的 cwd 轉絕對（不是資料夾＝PathMissing），
  寫進子項物件的 ws（loop／max1＝子項設定多一個 ws；exec＝{"exec": XXX, "ws": WS}），daemon 起它時設 AOS_WS＝WS（沒給＝繼承 daemon 的）。
  另外：<WS>/.stack 不在（連壞掉的 symlink 都沒有）就建一個 symlink 指到這個子項在 daemon 的小格 <D>/<名字>（小格還沒建也先建），
  cd 到 WS 打 aos-say 等就接上這一隻；已經在＝不建、stderr 一句「aos-daemon-ctl: 注意 …」（要接小格請用 --stack），add 照樣送出、退 0。
  ls 多一欄 ws（列上沒有＝-；--json 照 loops_state 原樣，有給 ws 的列帶 ws）。
  rm：信送出之後，loops_state 那一列有 ws、而且 <ws>/.stack 是指到 <D>/<名字> 的 symlink＝順手拿掉（代定）；拿不到 ws、不是 symlink、指到別處＝不動。
錯：stderr 一行「aos-daemon-ctl: 代號 原因」、退 1。代號：ArgumentsBad、FlagUnknown、CommandUnknown、DaemonMissing、MailboxMissing、
  PathMissing、LoopBad（loop.json 讀不了或不是物件）、KindBad、StateMissing（ls：loops_state.json 不在）、StateBad、CommandMissing（PATH 沒 aos-post）、
  SendFailed（aos-post 退非 0，它的 stderr 照轉）。
要 PATH 上有 aos-post。
"""
import json, os, subprocess, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_flags

NAME = "aos-daemon-ctl"
USAGE = ("aos-daemon-ctl [--daemon D] add [--name N] [--kind loop|exec|max1] [--ws WS] XXX | rm 名字 | ls [--json]")
KINDS = ("loop", "exec", "max1")


class Fail(Exception):
    def __init__(self, code, reason):
        super().__init__(reason)
        self.code = code


def daemon_dir(opts):
    d = opts.get("daemon") or os.environ.get("AOS_DAEMON", "")
    if not d:
        raise Fail("DaemonMissing", "沒給 --daemon、也沒設 AOS_DAEMON（要指到 daemon 的 $AOS_STACK 資料夾）")
    if not os.path.isdir(d):
        raise Fail("DaemonMissing", "daemon 的資料夾不在：%s" % d)
    return os.path.abspath(d)


def abs_target(t, base):
    """相對的目標接在 base 後面（`檔#/指標` 只動 # 前面；絕對的、只有 #/… 的不動）。"""
    f, h, p = t.partition("#")
    if f and not f.startswith("/"):
        f = os.path.abspath(os.path.join(base, f))
    return f + h + p


def loop_spec(xxx):
    try:
        with open(os.path.join(xxx, "loop.json"), encoding="utf-8") as fh:
            text = fh.read()
        if text.startswith("#!"):
            text = text.split("\n", 1)[1] if "\n" in text else ""
        cfg = json.loads(text)
    except (OSError, ValueError) as e:
        raise Fail("LoopBad", "%s/loop.json 讀不了或不是 JSON：%s" % (xxx, e))
    if not isinstance(cfg, dict):
        raise Fail("LoopBad", "%s/loop.json 要是 JSON 物件" % xxx)
    cfg.pop("_entry", None)
    ex = cfg.get("exec")
    if isinstance(ex, str):
        cfg["exec"] = abs_target(ex, xxx)
    elif isinstance(ex, list) and ex and isinstance(ex[0], str):
        cfg["exec"] = [abs_target(ex[0], xxx)] + ex[1:]
    elif isinstance(ex, dict) and "$ref" not in ex and "$env" not in ex:   # 內嵌單子：cwd 定死在 XXX（aos-exec XXX 時本來就 cd 進去）
        c = ex.get("cwd")
        if c is None:
            ex["cwd"] = xxx
        elif isinstance(c, str):
            ex["cwd"] = os.path.join(xxx, c)
    return cfg


def send(d, body):
    box = os.path.join(d, "loops_mailbox")
    if not os.path.isdir(os.path.join(box, "new")):
        raise Fail("MailboxMissing", "%s 不是信箱（daemon.json 要寫 \"loops_mailbox\": \"loops_mailbox\"，或 daemon 還沒起）" % box)
    try:
        r = subprocess.run(["aos-post", "send", box], input=json.dumps(body, ensure_ascii=False), capture_output=True, text=True)
    except FileNotFoundError:
        raise Fail("CommandMissing", "PATH 上沒有 aos-post")
    if r.returncode != 0:
        sys.stderr.write(r.stderr)
        raise Fail("SendFailed", "aos-post send 退 %d" % r.returncode)
    sys.stdout.write(r.stdout)


def link_stack(ws, cell):
    """<ws>/.stack 不在就建 symlink 指到小格（衝突 3）；在（含壞掉的 symlink）＝不建、stderr 一句。"""
    link = os.path.join(ws, ".stack")
    if os.path.lexists(link):
        sys.stderr.write("%s: 注意 %s 已經在，沒建 symlink 到小格 %s（要接這個子項的 stack 請用 --stack %s）\n" % (NAME, link, cell, cell))
        return
    try:
        os.symlink(cell, link)
    except OSError as e:
        sys.stderr.write("%s: 注意 建不了 symlink %s → %s：%s\n" % (NAME, link, cell, e))


def cmd_add(opts, args):
    o, rest = aos_flags.parse(args, {"--name": "name", "--kind": "kind", "--ws": "ws"})
    if len(rest) != 1:
        raise Fail("ArgumentsBad", "add 要一個 XXX（usage: %s）" % USAGE)
    d = daemon_dir(opts)
    xxx = abs_target(rest[0], os.getcwd())
    path = xxx.partition("#")[0]
    if not os.path.exists(path):
        raise Fail("PathMissing", "沒有 %s" % path)
    kind = o.get("kind") or ("loop" if os.path.isdir(path) and os.path.isfile(os.path.join(path, "loop.json")) else "exec")
    if kind not in KINDS:
        raise Fail("KindBad", "--kind 要是 loop、exec、max1 之一：%s" % kind)
    if kind == "loop" and not os.path.isdir(path):
        raise Fail("KindBad", "--kind loop 要 XXX 是有 loop.json 的資料夾：%s" % path)
    ws = None
    if o.get("ws") is not None:
        if not o["ws"]:
            raise Fail("ArgumentsBad", "--ws 不能是空的（usage: %s）" % USAGE)
        ws = os.path.abspath(o["ws"])   # 從呼叫當下的 cwd 算（daemon 會從它自己的 cwd 算，所以這裡先轉）
        if not os.path.isdir(ws):
            raise Fail("PathMissing", "--ws 不是資料夾：%s" % ws)
    name = o.get("name") or os.path.basename(path.rstrip("/"))
    if kind == "loop":
        spec = loop_spec(path)
    elif kind == "max1":
        spec = {"exec": xxx, "max": 1}
    else:
        spec = {"exec": xxx} if ws else xxx
    if ws:
        spec["ws"] = ws
    send(d, {("execs_added" if kind == "exec" else "loops_added"): {name: spec}})
    if ws:
        link_stack(ws, os.path.join(d, name))


def cmd_rm(opts, args):
    o, rest = aos_flags.parse(args, {})
    if len(rest) != 1:
        raise Fail("ArgumentsBad", "rm 要一個名字（usage: %s）" % USAGE)
    d = daemon_dir(opts)
    send(d, {"loops_removed": [rest[0]], "execs_removed": [rest[0]]})
    unlink_stack(d, rest[0])


def unlink_stack(d, name):
    """rm 之後（代定）：loops_state 那一列的 ws/.stack 是指到 <D>/<名字> 的 symlink 就拿掉；拿不到、對不上＝不動、不報。"""
    try:
        with open(os.path.join(d, "loops_state.json"), encoding="utf-8") as fh:
            st = json.load(fh)
        rows = {}
        for k in ("loops", "execs"):
            rows.update(table(d, st.get(k, {})))
        ws = rows.get(name, {}).get("ws")
        if not isinstance(ws, str):
            return
        link = os.path.join(ws, ".stack")
        cell = os.path.join(d, name)
        if os.path.islink(link) and os.path.abspath(os.path.join(ws, os.readlink(link))) == cell:
            os.unlink(link)
    except (OSError, ValueError, AttributeError):
        pass


def table(d, v):
    """loops_state 的一張表：物件原樣；切檔（{"$ref": [分檔, …]}）照順序讀回來合起來。"""
    if isinstance(v, dict) and isinstance(v.get("$ref"), list):
        out = {}
        for ref in v["$ref"]:
            with open(os.path.join(d, ref), encoding="utf-8") as fh:
                out.update(json.load(fh))
        return out
    if not isinstance(v, dict):
        raise ValueError("表不是物件")
    return v


def cmd_ls(opts, args):
    o, rest = aos_flags.parse(args, {}, {"--json": "json"})
    if rest:
        raise Fail("ArgumentsBad", "ls 不收參數（usage: %s）" % USAGE)
    d = daemon_dir(opts)
    p = os.path.join(d, "loops_state.json")
    if not os.path.isfile(p):
        raise Fail("StateMissing", "沒有 %s（daemon 還沒起，或 loops_state 沒開）" % p)
    try:
        with open(p, encoding="utf-8") as fh:
            st = json.load(fh)
        loops, execs = table(d, st.get("loops", {})), table(d, st.get("execs", {}))
    except (OSError, ValueError, AttributeError) as e:
        raise Fail("StateBad", "%s 讀不懂：%s" % (p, e))
    if o.get("json"):
        print(json.dumps({"loops": loops, "execs": execs}, ensure_ascii=False))
        return
    for kind, rows in (("loop", loops), ("exec", execs)):
        for n, r in rows.items():
            print("\t".join([n, kind, str(r.get("phase")), str(r.get("pid")), "-" if r.get("code") is None else str(r["code"]),
                             r.get("ws") or "-"]))


COMMANDS = {"add": cmd_add, "rm": cmd_rm, "ls": cmd_ls}


def main():
    try:
        try:
            opts, rest = aos_flags.parse(sys.argv[1:], {"--daemon": "daemon"})
            if not rest:
                raise Fail("ArgumentsBad", "usage: %s" % USAGE)
            if rest[0] not in COMMANDS:
                raise Fail("CommandUnknown", "不認得的子命令 %s（usage: %s）" % (rest[0], USAGE))
            COMMANDS[rest[0]](opts, rest[1:])
        except aos_flags.Error as e:
            raise Fail(e.code, "%s（usage: %s）" % (e, USAGE))
    except Fail as e:
        print("%s: %s %s" % (NAME, e.code, e), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
