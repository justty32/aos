#!/usr/bin/env python3
"""aos-daemon [--cfg daemon.json] [--max N] [--interval-ms N] [--ctl 檔] [--state 檔] [XXX [args...]]
— 管一群長壽的子 loop（C-36、N-28）。命令列同 aos-loop（共用 aos_loop.cli；XXX＝daemon 自己的 run）。daemon.json＝loop.json 的超集：
    run, max, interval_ms, ctl, state   同 aos-loop（同名同義，N-28）；但 run 選填（純監工不需要）、interval_ms 沒寫＝200
    children   {名字: loop 設定}：字串＝aos-exec 的目標（包成 {"run": 它}）、物件＝一份 loop.json 的內容（不驗，原樣交給子 loop；
               要內嵌單子寫 {"run": "daemon.json#/children/<名字>/body", "body": 單子}，相對路徑從 daemon 的 cwd 算）
    adopt      布林，沒寫＝true：起來時讀自己上次的 state，把還活著的子 loop（pid＋啟動時間對得上）接回、不重起（N-17、N-28）
需要 $AOS_STACK（沒設＝退 1）。每個子項的小格是 $AOS_STACK/<名字>/（P-17）：daemon 把子項的 loop 設定補上
"ctl": "ctl.json"、"state": "state.json"（沒寫才補）寫成小格裡的 loop.json，以 AOS_STACK=小格 起 `aos-loop --cfg 小格/loop.json`
（cwd＝daemon 的 cwd；自成一個行程群組）。子 loop 的 stdout 丟掉、stderr 附加到小格的 stderr（N-28 方案 B）。
每圈（拍與拍之間）：讀 ctl（多認 children＝我要表上有誰，N-54）→ 收掉表上多出來的（SIGTERM，等 10 秒，再 SIGKILL 整群）、
看誰結束了（phase exited，記 code／signal）、起表上少掉的 → 跑 run（有寫才跑）→ 寫 state（children 表在裡面）。
子 loop 結束後不自動重起（使用者 10-20「照預設」）；要再起：從 children 拿掉再放回，或重起 daemon。
不論為什麼結束（拍滿 max、ctl stop、run 退 10 或失敗、收到訊號、自己的錯），都先收掉所有子 loop、寫好 state 再結束；
收到 SIGINT／SIGTERM／SIGHUP 以 128＋N 結束（非 0，P-36）。自己的錯退 1，stderr 一行 `aos-daemon: 原因`。PATH 不動：
aos-loop、aos-exec 由呼叫者放進 PATH。"""
import json, os, signal, subprocess, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_inst, aos_loop, aos_window

GRACE = 10.0   # 收子 loop：SIGTERM 後等幾秒才 SIGKILL（P-36 daemon 的 grace 慣例 10000 毫秒）


def check_children(v):
    if not isinstance(v, dict):
        return "children 要是 {名字: loop 設定}"
    for name, c in v.items():
        if not name or name in (".", "..") or "/" in name or name.startswith("."):
            return "children 的名字 %r 不能當資料夾名" % name
        if not isinstance(c, (str, dict)):
            return "children[%s] 要是子資料夾或 loop 設定" % name
    return None


class Child:
    def __init__(self, pid, started, proc=None):
        self.pid, self.started, self.proc = pid, started, proc
        self.phase, self.code, self.signal = "running", None, None

    def alive(self):
        if self.proc is not None:
            rc = self.proc.poll()
            if rc is None:
                return True
            self.code, self.signal = (rc, None) if rc >= 0 else (128 - rc, -rc)
            return False
        return aos_window.started(self.pid) == self.started   # 接回來的不是自己的子行程：看 pid＋啟動時間

    def row(self):
        return {"pid": self.pid, "started": self.started, "phase": self.phase, "code": self.code,
                "signal": self.signal}


class Daemon(aos_loop.Loop):
    prog = "aos-daemon"
    max_default = None
    interval_default = 200
    need_run = False
    ctl_extra = {"children": check_children}

    def __init__(self, opts, rest):
        super().__init__(opts, rest)
        if not self.stack:
            raise aos_loop.ConfigError("沒設定 AOS_STACK")
        self.children = self.cfg.get("children", {})
        bad = check_children(self.children)
        if bad:
            raise aos_loop.ConfigError(bad)
        adopt = self.cfg.get("adopt", True)
        if not isinstance(adopt, bool):
            raise aos_loop.ConfigError("adopt 要是 true／false")
        self.cwd = os.getcwd()
        self.table = {}
        if adopt:
            self.adopt()

    def adopt(self):
        try:
            with open(self.state_path, encoding="utf-8") as f:
                old = json.load(f)["children"]
            rows = [(n, r) for n, r in old.items() if r.get("phase") == "running"]
        except (TypeError, OSError, ValueError, KeyError, AttributeError):
            return   # 沒開 state、第一次起來、或舊的讀不了：沒東西可接
        for name, r in rows:
            pid, st = r.get("pid"), r.get("started")
            if isinstance(pid, int) and st is not None and aos_window.started(pid) == st:
                self.table[name] = Child(pid, st)

    def info(self):
        return {"children": {n: c.row() for n, c in self.table.items()}}

    def tend(self, ctl):
        want = ctl["children"] if "children" in ctl else self.children
        gone = [n for n in self.table if n not in want]
        self.stop(gone)
        for n in gone:
            del self.table[n]
        for c in self.table.values():
            if c.phase == "running" and not c.alive():
                c.phase = "exited"
        for n, spec in want.items():
            if n not in self.table:
                self.table[n] = self.spawn(n, spec)

    def spawn(self, name, spec):
        cell = os.path.join(self.stack, name)
        cfg = {"run": spec} if isinstance(spec, str) else dict(spec)
        cfg.setdefault("ctl", "ctl.json")
        cfg.setdefault("state", "state.json")
        try:
            os.makedirs(cell, exist_ok=True)
            aos_window.write(os.path.join(cell, "loop.json"), cfg)
            with open(os.path.join(cell, "stderr"), "ab") as err:
                p = subprocess.Popen(["aos-loop", "--cfg", os.path.join(cell, "loop.json")], cwd=self.cwd,
                                     env=dict(os.environ, AOS_STACK=cell + "/"), stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL, stderr=err, start_new_session=True)
        except OSError as e:
            raise aos_inst.InstError("起不了子項 %s：%s" % (name, e))
        return Child(p.pid, aos_window.started(p.pid), p)

    def stop(self, names):
        live = [self.table[n] for n in names if self.table[n].phase == "running" and self.table[n].alive()]
        for c in live:
            c.phase = "stopping"
            try:
                os.kill(c.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        deadline = time.monotonic() + GRACE
        while any(c.alive() for c in live):
            if time.monotonic() >= deadline:
                for c in live:
                    if c.alive():
                        try:
                            os.killpg(c.pid, signal.SIGKILL)
                        except (ProcessLookupError, PermissionError):
                            pass
                deadline = float("inf")
            time.sleep(0.05)
        for c in live:
            c.phase = "exited"

    def finish(self):
        self.stop(list(self.table))


sys.exit(aos_loop.cli(Daemon, sys.argv))
