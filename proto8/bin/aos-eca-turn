#!/usr/bin/env python3
"""aos-eca-turn - 外部 coding agent（claude／codex，eca）的一輪：把 stack 的 queue 裡的信照順序全部一起交給 CLI——交出去就收信——等它答完、回答接進 history。

10-31 改名、升成 bin 指令（使用者「aos eca turn」；C-54 R13 aos-<領域>-<功能>；前身 lib/eca/turn 格的 turn.py，叫法 aos-exec <turn 格>）：

    aos-eca-turn [--one] [--on-empty stop|idle] [--on-busy yield|answer] <定義資料夾絕對路徑>

  旗標在位置參數前（aos_flags.parse）。定義的 loop.json 直接叫它：
    {"exec": {"argv": ["aos-eca-turn", "--on-empty", "idle", "--on-busy", "yield", {"$env": "AOS_CD"}], "timeout_ms": 900000}}
  --on-empty（10-31 取代環境變數 ECA_ON_EMPTY，不再讀它）：queue 空時 stop（沒給；退 10＝loop 收工＝射後不理）｜idle（退 0＝loop 隔 interval_ms 再來）。
  --on-busy（10-31，SessionBad 退讓的開關）：yield（沒給）＝有人佔著就這輪退讓（見下）｜answer＝照常答、不因畫面被佔而退讓
    （lock 拿不到就等、有人接在畫面上照樣貼進畫面答、busy.txt 在就等它消失再貼，期限照 cli.json 的 timeout_ms，逾時 ReplyMissing）。

定義資料夾＝eca 的定義（demo/eca-claude 那種）：頂層 cli.json（kind claude｜codex、flags、print_flags、timeout_ms；
  cli_session 讀的同一份；11-03 起選填 tools、tools_flags；11-04 起選填 prompt）、選填 prompt.txt（開場白：cli.json 沒寫 prompt 就用它，
  寫了 "prompt": "別的.txt"＝用那份，相對路徑從 cli.json 的資料夾算；11-04 使用者「能改嗎？可以的話就改吧」）、選填 tools.json（aos-tools 的登記檔：cli.json 沒寫 tools
  就用它，接上 aos-mcp，工作區＝$AOS_WS、stack＝$AOS_STACK；11-03 eca-tools）。定義不被寫（P-15）；寫的都在 $AOS_STACK。

平級形（沒有 --one）——一次替它答一批（11-03 起：使用者 11-03「每次aos-eca-turn就是把所有信一起丟進去(當然，是有順序的)」「一批幾封無上限」，thinking 2026-10-30-eca/17-11-03-批次-status.md；原本一次一則）：
  ① 這一批＝queue 的 cur/ 全部（認領了、還沒交出去的：上次 --on-busy yield 退讓、或 CLI 沒起來）＋ new/ 全部（aos-post take-all），
     照處理順序（aos_ws.letter_key：有序在前照名字＝寄的順序、無序在後照名字；11-03 aos-post 改版，同 aos-post），幾封都行、沒有上限；CLI 跑的期間才寄來的信留在 new/，下一輪再答。
     history 空、queue 也空、定義有非空的開場白（prompt 指的檔、沒寫＝prompt.txt）＝先把它當一則 user 投進 queue（aos-post send --ordered）再認領。
  ② 讀信（aos-post see）：body 不是 {"role": "user", "content": 非空字串}＝壞信，aos-post done 丟掉、原因寫進
     $AOS_STACK/mailbox_warning.txt 一行（只留最後一封；N-16），跳過它、其他封照答（衝突 5、Q-4；11-03 前記在 trace、退 0）。
     名字不是有序的不再算壞信（11-03 aos-post 改版：有序、無序同箱，無序的排在最後、照樣答）。
     整批都是壞信＝不問 CLI、退 0。
  ③ 好信的 content 照順序用一個空行（"\n\n"）接成一段，交給 cli_session 問一次（小格＝$AOS_STACK/<kind>/）：畫面開著＝貼進畫面等 hook；
     沒開＝claude -p --resume／codex exec resume（第一次開新的）——兩條路照 10-24，跟工具形是同一段（cli_session.ask）。
  ④ 交出去就算完成（11-03，使用者「對於eca來說，他收到信後，丟給claude之類的，然後這封信就算是完成了」，thinking 2026-10-30-eca/20-11-03-交出去就收.md）：
     題目交給 CLI 的那一刻（非互動＝CLI 起來、題目寫進 stdin；畫面＝貼上按 Enter；cli_session.ask 的 handed）、等回答之前，
     好信 body 照順序各接一則 user 進 history，再 aos-post done 這批每一封（刪掉）。之後 CLI 的輸出就是結果（沒有「回信」，
     使用者 11-03「沒有回信。claude的輸出結果就是這樣」）：接成一則 {"role": "assistant", "content": 輸出} 進 history。
     CLI 中途掛掉（CliFailed、ReplyMissing、這支被殺）＝邊緣狀況：信已經收了、不自動重答，要重答由人再 say
     （使用者 11-03「中途掛掉就是邊緣狀況，不要讓邊緣狀況影響他的原本意思」；P-12 在 eca 的例外，見 P-43 的 11-03 註）。
  ⑤ queue 空（cur/、new/ 都沒信）：照 --on-empty——stop 退 10、idle 退 0（Q-9）。
  ⑥ 11-03 起不寫 $AOS_STACK/trace.jsonl（使用者「整個拿掉」，thinking 2026-11-03-trace）；要看狀態用 aos-eca status。
  ⑦ 拿到 session id 就在小格建 transcripts/<kind>-<id>.jsonl symlink（cli_session.link_transcript，C-15～17）。
  --on-busy yield 時 SessionBad（拿不到格的 lock：另一次呼叫或 attach 正在開畫面；有人接在 tmux 畫面上；busy.txt 在＝畫面正在跑一輪）
    ＝還沒交出去：這次退 0 不動、整批信留在 cur/、history 不動，下一次再試（interval_ms）；--on-busy answer 不退讓（見上）。
  人在畫面上自己打的話不進 history（沒經 queue；eca 方向題 2）。
  每次把 {"kind", "ws", "template"} 寫進 $AOS_STACK/eca.json（有變才寫；template＝定義資料夾）。
--one（工具形，P-41 工具契約）：stdin {"prompt"} → stdout 回答，對話在 $AOS_STACK 這格本身（cli_session.call_main，跟 lib/agent/claude 同一條路）；
  --on-busy 照認（yield 時 SessionBad 照錯退 1）；跟 --on-empty 一起給＝ArgumentsBad（工具形沒有 queue）。
  錯照 lib 契約 stderr 與 stdout 各一行「<定義資料夾名>: 代號 原因」、退 1。
PATH 上要有 aos-post（平級形）。
錯（平級形與 argv）：stderr 一行「aos-eca-turn: 代號 原因」、退 1（P-20 停下等人）。交出去之前的錯（CliMissing、ToolsMissing、
  畫面等 busy.txt 逾時的 ReplyMissing…）＝整批信留在 cur/（或還在 new/）、history 不動，修好重跑整批照問；交出去之後的錯＝信已收、user 已接、
  沒有 assistant，不重答（④）。
  代號：ArgumentsBad、FlagUnknown、AgentBad、StackMissing、HistoryBad、PostFailed、WriteFailed，
  加 cli_session 的 CfgMissing、CfgBad、ToolsMissing（11-03 eca-tools：cli.json 的 tools 指的登記檔不在）、
  PromptMissing（11-04：cli.json 的 prompt 指的開場白檔不在）、CliMissing（含 aos-mcp 不在 PATH 上）、
  CliFailed、ReplyMissing（yield 時的 SessionBad 不算錯，見上）。"""
import json, os, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path[:0] = [HERE, os.path.join(HERE, "..", "lib", "agent"), os.path.join(HERE, "..", "lib", "aos")]   # bin/aos_flags.py、lib/agent/cli_session.py、lib/aos/aos_ws.py
import aos_flags, aos_ws, cli_session  # noqa: E402

NAME = "aos-eca-turn"
NOT_FOUND = 10
USAGE = "usage: aos-eca-turn [--one] [--on-empty stop|idle] [--on-busy yield|answer] <定義資料夾絕對路徑>"


class Fail(Exception):
    """自己這層或 cli_session 的錯：code＝代號。"""

    def __init__(self, code, reason):
        super().__init__(str(reason).replace("\n", " "))
        self.code = code


def die(code, reason):
    print("%s: %s %s" % (NAME, code, str(reason).replace("\n", " ")), file=sys.stderr)
    sys.exit(1)


def names(box, stage):
    """某一格裡的信件名稱（. 開頭的不算，N-05），照處理順序（aos_ws.letter_key）排。"""
    try:
        return sorted((n for n in os.listdir(os.path.join(box, stage)) if not n.startswith(".")), key=aos_ws.letter_key)
    except (FileNotFoundError, NotADirectoryError):
        return []


def write_atomic(path, text):
    """N-05：先寫同資料夾 . 開頭的暫存檔再改名。"""
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError as e:
        raise Fail("WriteFailed", "寫不了 %s：%s" % (path, e))


def post(args, stdin_text=""):
    """叫 aos-post；回 (結束碼, stdout, stderr 第一行)。"""
    try:
        r = subprocess.run(["aos-post"] + args, input=stdin_text, capture_output=True, text=True)
    except OSError as e:
        raise Fail("PostFailed", "aos-post 起不來（要在 PATH 上）：%s" % e)
    return r.returncode, r.stdout, (r.stderr.strip().splitlines() or ["退 %d、沒說原因" % r.returncode])[0]


def must_post(args, stdin_text="", ok=(0,)):
    code, out, err = post(args, stdin_text)
    if code not in ok:
        raise Fail("PostFailed", "aos-post %s 退 %d：%s" % (args[0], code, err))
    return code, out


# ---- history（$AOS_STACK/history.jsonl，一行一則 OpenAI message，只附加；P-41）----

def history_rows(stack):
    rows = []
    try:
        with open(os.path.join(stack, "history.jsonl"), encoding="utf-8") as f:
            for i, line in enumerate(f, 1):
                if not line.strip():
                    continue
                try:
                    m = json.loads(line)
                except ValueError:
                    m = None
                if not isinstance(m, dict):
                    raise Fail("HistoryBad", "history.jsonl 第 %d 行不是 JSON 物件" % i)
                rows.append(m)
    except FileNotFoundError:
        pass
    except OSError as e:
        raise Fail("HistoryBad", "讀不了 history.jsonl：%s" % e)
    return rows


def append_history(stack, msg):
    try:
        with open(os.path.join(stack, "history.jsonl"), "a", encoding="utf-8") as f:   # 一次寫一整行
            f.write(json.dumps(msg, ensure_ascii=False) + "\n")
    except OSError as e:
        raise Fail("WriteFailed", "接不進 history.jsonl：%s" % e)


# ---- mailbox_warning.txt、eca.json ----

def warn(stack, sig, why):
    """N-16 壞信記 mailbox_warning：$AOS_STACK/mailbox_warning.txt 一行、只留最後一封（11-03 前記在 trace）。"""
    write_atomic(os.path.join(stack, "mailbox_warning.txt"), "信 %s 不採用：%s\n" % (sig, why.replace("\n", " ")))


def note_instance(stack, kind, ws, template):
    want = {"kind": kind, "ws": ws, "template": template}
    try:
        with open(os.path.join(stack, "eca.json"), encoding="utf-8") as f:
            if json.load(f) == want:
                return
    except (OSError, ValueError):
        pass
    write_atomic(os.path.join(stack, "eca.json"), json.dumps(want, ensure_ascii=False) + "\n")


# ---- 一批 ----

def letter_body(box, sig):
    """好信回 (body, None)；壞信回 (None, 原因)。"""
    code, out, err = post(["see", box, sig])
    if code != 0:
        return None, err
    try:
        body = json.loads(out).get("body")
    except (ValueError, AttributeError):
        return None, "aos-post see 印的不是 JSON 物件"
    if not (isinstance(body, dict) and body.get("role") == "user" and isinstance(body.get("content"), str)
            and body["content"].strip()):
        return None, "body 要是 {\"role\": \"user\", \"content\": 非空字串}"
    return body, None


def opening(stack, box, cfg):
    """history 空、queue 也空、有開場白檔＝把開場白投進 queue（射後不理那種的第一則）。回 True＝投了。
    開場白檔＝cli.json 的 prompt 指的、沒寫＝同層 prompt.txt（11-04；cli_session.load_cfg 算好放在 cfg["prompt_file"]）。"""
    path = cfg.get("prompt_file")
    if not path:
        return False
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        if "prompt" in cfg:                                         # load_cfg 之後才被刪掉；寫了就要有（同 ToolsMissing）
            raise Fail("PromptMissing", "開場白檔不在：%s" % path)
        return False
    except OSError as e:
        raise Fail("AgentBad", "讀不了 %s：%s" % (path, e))
    text = text[:-1] if text.endswith("\n") else text           # 同 aos-say：結尾一個換行不算
    if not text.strip() or history_rows(stack):
        return False
    must_post(["send", "--ordered", box], json.dumps({"role": "user", "content": text}, ensure_ascii=False))
    return True


SEP = "\n\n"                                   # 一批好幾封時，各封 content 照順序用一個空行接起來（11-03 代定）


def take_all(stack, box, cfg):
    """new/ 裡的信全部認領到 cur/（aos-post take-all；沒信退 NOT_FOUND＝剛好被撤回，不算錯）；一批幾封沒有上限（11-03）。
    history 空、queue 也空、定義有開場白檔＝先投開場白再認領。"""
    if not names(box, "new") and not names(box, "cur") and not opening(stack, box, cfg):
        return
    if names(box, "new"):
        must_post(["take-all", box], ok=(0, NOT_FOUND))            # new/ → cur/


def one_turn(template, stack, ws, empty_code, on_busy):
    box = os.path.join(stack, "queue")
    if not all(os.path.isdir(os.path.join(box, s)) for s in ("tmp", "new", "cur")):
        must_post(["init", box])                                   # 先建好，aos-say／listen 認得
    cfg = cli_session.load_cfg(template)
    cell = cli_session.Cell(os.path.join(stack, cfg["kind"]))
    note_instance(stack, cfg["kind"], ws, template)
    take_all(stack, box, cfg)                                      # 這輪要答的＝cur/ 全部（上次沒交出去的＋剛認領的）
    batch = names(box, "cur")
    if not batch:
        return empty_code
    bodies, good = [], []
    for sig in batch:                                               # ② 照順序讀信
        body, why = letter_body(box, sig)
        if body is None:                                            # 壞信一律丟（N-16、決定 27 不通知寄信人）
            post(["done", box, sig])
            warn(stack, sig, why)
            continue
        bodies.append(body)
        good.append(sig)
    if not good:
        return 0
    late = []                                                       # 交出去那一刻收信時出的錯：CLI 已經在跑，等它答完再報

    def handed():                                                   # ④ 交出去就算完成（11-03）：user 接進 history、收信
        try:
            for body in bodies:
                append_history(stack, body)
            for sig in good:
                must_post(["done", box, sig])
        except Fail as e:
            late.append(e)
    try:
        text = cli_session.ask(cfg, cell, template, ws, stack, SEP.join(b["content"] for b in bodies), on_busy,
                               handed)                              # 一批一次（11-03）；跟工具形同一段；stack 給 aos-mcp（11-03 eca-tools）
    except Fail as e:
        if e.code == "SessionBad":                                  # 只有 --on-busy yield 會丟，一定在交出去之前
            return 0                                                # 整批留 cur/，下一次再試
        raise
    if late:
        raise late[0]
    append_history(stack, {"role": "assistant", "content": text[:-1] if text.endswith("\n") else text})
    return 0


def _cli_die(code, reason):                    # cli_session 出錯時本來 exit；平級形改成丟例外，這支自己說一行
    raise Fail(code, reason)


def main():
    try:
        opts, args = aos_flags.parse(sys.argv[1:], {"--on-empty": "on_empty", "--on-busy": "on_busy"}, {"--one": "one"})
    except aos_flags.Error as e:
        die(e.code, "%s（%s）" % (USAGE, e))
    if len(args) != 1:
        die("ArgumentsBad", USAGE)
    empty, busy = opts.get("on_empty", "stop"), opts.get("on_busy", "yield")
    if empty not in ("stop", "idle"):
        die("ArgumentsBad", "--on-empty 要是 stop 或 idle，收到 %r" % empty)
    if busy not in ("yield", "answer"):
        die("ArgumentsBad", "--on-busy 要是 yield 或 answer，收到 %r" % busy)
    if opts.get("one") and "on_empty" in opts:
        die("ArgumentsBad", "--one（工具形）沒有 queue，不收 --on-empty")
    template = args[0]
    if not os.path.isabs(template) or not os.path.isdir(template):
        die("AgentBad", "定義資料夾要是存在的絕對路徑，收到 %r" % template)
    template = os.path.normpath(template)
    if opts.get("one"):
        cli_session.call_main(template, busy)                      # 工具形：跟 lib/agent/claude、codex 同一條路
        return
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "沒設定 AOS_STACK")
    stack = os.path.abspath(stack)
    ws = os.path.abspath(os.environ.get("AOS_WS") or ".")
    cli_session.die = _cli_die
    try:
        code = one_turn(template, stack, ws, NOT_FOUND if empty == "stop" else 0, busy)
    except Fail as e:
        die(e.code, e)
    sys.exit(code)


main()
