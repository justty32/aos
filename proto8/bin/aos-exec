#!/usr/bin/env python3
"""aos-exec [旗標...] XXX [args...] — 在工作區執行 XXX 這個程式（N-57～N-62）。純標準庫。

命令列（10-21 ideas）：XXX 前面是 aos-exec 自己的旗標（表在 FLAGS），第一個不是旗標的參數就是 XXX，之後原樣傳給入口；
`--` 結束旗標（XXX 可以 - 開頭）。目前只有 `--ws WS`（或 `--ws=WS`）：工作區；沒給、`-`、空＝沿用 $AOS_WS，沒設用 .。
旗標蓋過對應的環境變數。不認得的旗標、旗標缺值、沒有 XXX＝usage 錯。
XXX：資料夾、檔、或 `檔#/指標`；相對路徑照呼叫當下的 cwd。
找入口（N-61）：資料夾 → XXX/$AOS_ENTRY（預設 _exec），沒有再找 XXX/$AOS_ENTRY.json；不在、basename 沒有 `.`
→ 補找 XXX.json。解開捷徑後：有 +x＝可執行檔（exec，不讀內容；沒 #! 改用 /bin/sh 跑）；沒 +x 當 JSON 讀（第一行 #! 跳過、照 #/ 取值）：
非空陣列＝argv（元素可放 $env／$ref，開跑前解、解完要全是字串，10-20 ideas D2、D8；exec，同 execvp：沒 #! 改用 /bin/sh 跑；
argv[0] 帶 / 又 exec 不了＝前面插 aos-exec、照 PATH 找，D3）、有 argv 的物件＝inst 單子（行程內 aos_inst.run，以子程式的碼結束）、
沒 argv 的物件＝取 [$AOS_ENTRY] 再判一次（只往下一層）、字串＝路徑轉向（從寫著它的檔所在的資料夾算，繞圈＝入口壞）。
開跑前 export AOS_WS、AOS_STACK（沒設＝$AOS_WS/.aos/，建好）、AOS_CF（實際的檔）、AOS_CD（它的資料夾），
cd 到 AOS_CD；PATH 不動、原樣傳下去（ideas § 24；入口裡要叫 aos-exec、aos-loop… 由呼叫者事先放進 PATH）。args 接在入口後面，stdin 原樣給入口。
自己的錯退 1，stderr 一行「aos-exec: 原因」（N-60）。
"""
import errno
import json
import os
import signal
import sys

BIN = os.path.dirname(os.path.realpath(__file__))


class Fail(Exception):
    """aos-exec 自己的錯（N-60）。"""


def die(msg):
    print("aos-exec: %s" % msg, file=sys.stderr)
    sys.exit(1)


def entry_name():
    return os.environ.get("AOS_ENTRY") or "_exec"


def pointer(doc, ptr, where):
    """RFC 6901：ptr 是 `/a/b`（`~1`＝`/`、`~0`＝`~`）。指不到＝入口不存在。"""
    for tok in ptr[1:].split("/"):
        tok = tok.replace("~1", "/").replace("~0", "~")
        if isinstance(doc, dict) and tok in doc:
            doc = doc[tok]
        elif isinstance(doc, list) and tok.isdigit() and (tok == "0" or not tok.startswith("0")) \
                and int(tok) < len(doc):
            doc = doc[int(tok)]
        else:
            raise Fail("入口不存在：%s#%s 指不到" % (where, ptr))
    return doc


def locate(spec, base):
    """XXX → (實際的檔, 指標或 None)。base＝相對路徑的起點。"""
    path, hashed, ptr = spec.partition("#")
    if hashed and not ptr.startswith("/"):
        raise Fail("入口壞：%s 的 # 後面要接 /" % spec)
    ptr = ptr if hashed else None
    p = os.path.join(base, path)
    name = entry_name()
    if os.path.isdir(p):
        if ptr is not None:
            raise Fail("入口壞：資料夾不能帶 #/：%s" % spec)
        f = os.path.join(p, name)
        if not os.path.lexists(f):
            f = os.path.join(p, name + ".json")
        if not os.path.isfile(f):
            raise Fail("入口不存在：%s（也沒有 %s.json，或它是資料夾）" % (os.path.join(p, name), name))
    elif os.path.isfile(p):
        f = p
    elif not os.path.lexists(p) and "." not in os.path.basename(path) and os.path.isfile(p + ".json"):
        f = p + ".json"
    else:
        raise Fail("入口不存在：%s" % spec)
    return os.path.realpath(f), ptr


def find(spec, base, seen=()):
    """回 (種類, 值, 實際的檔)。種類：exe（值＝None）、argv（字串陣列）、inst（單子 dict）。"""
    f, ptr = locate(spec, base)
    if os.access(f, os.X_OK):
        if ptr is not None:
            raise Fail("入口壞：可執行檔不能帶 #/：%s" % spec)
        return "exe", None, f
    where = (f, ptr or "")
    if where in seen:
        chain = [a + b for a, b in seen + (where,)]
        raise Fail("入口壞：字串轉向繞圈：%s" % " → ".join(chain))
    seen = seen + (where,)
    try:
        with open(f, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        raise Fail("入口讀不到：%s（%s）" % (f, e.strerror))
    if text.startswith("#!"):
        text = text.partition("\n")[2]
    try:
        doc = json.loads(text)
    except ValueError:
        raise Fail("入口壞：沒有 +x、也不是 JSON：%s" % f)
    if ptr is not None:
        doc = pointer(doc, ptr, f)
    if isinstance(doc, dict) and "argv" not in doc:
        if entry_name() not in doc:
            raise Fail("入口壞：%s 不是單子、也沒有 %s" % (f, entry_name()))
        doc = doc[entry_name()]
        if isinstance(doc, dict) and "argv" not in doc:
            raise Fail("入口壞：%s 的 %s 不是單子、argv 陣列或路徑" % (f, entry_name()))
    if isinstance(doc, str):
        return find(doc, os.path.dirname(f), seen)
    if isinstance(doc, dict):
        return "inst", doc, f
    if isinstance(doc, list) and doc:   # 元素可以是字串或指示詞（10-20 ideas D2、D8），開跑前才解
        return "argv", doc, f
    raise Fail("入口壞：%s 不是單子、argv 陣列或路徑" % f)


def execv(prog, argv):
    """exec prog；+x 沒 #! 的檔（ENOEXEC）同 glibc execvp 改用 `/bin/sh prog argv[1:]` 跑（ideas § 22）。回錯誤。"""
    try:
        os.execv(prog, argv)
    except OSError as e:
        if e.errno != errno.ENOEXEC:
            return e
    try:
        os.execv("/bin/sh", ["/bin/sh", prog] + argv[1:])
    except OSError as e:
        return e


def launch(kind, val, f, args):
    """cd 已做完。exe／argv＝exec（不留行程）；inst＝行程內跑、以子程式的碼結束。"""
    if kind == "inst":
        import aos_inst
        try:
            return aos_inst.run(val, args)["code"]
        except aos_inst.InstError as e:
            raise Fail("單子跑不起來：%s" % e)
    if kind == "argv":   # 指示詞在五個環境變數設好之後解；$ref 從入口檔所在的資料夾（＝cwd）算
        import aos_inst
        try:
            val = aos_inst.resolve(val, os.getcwd())
        except aos_inst.InstError as e:
            raise Fail("入口壞：argv 陣列的指示詞解不開：%s" % e)
        if not all(isinstance(a, str) for a in val):
            raise Fail("入口壞：argv 陣列解完要全是字串：%s" % json.dumps(val, ensure_ascii=False))
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # Python 預設忽略 SIGPIPE，exec 會繼承；還原
    if kind == "exe":
        err = execv(f, [f] + args)
        raise Fail("起不來：%s（%s）" % (f, err.strerror))
    argv = aos_inst.argv0(val + args, ".")   # 帶 / 又 exec 不了＝前面插 aos-exec（D3、D5）
    if "/" in argv[0]:
        err = execv(argv[0], argv)
    else:   # 同 execvp：照 PATH 一段段 execv；找不到換下一段，別的錯（沒 +x…）記第一個、也換下一段
        last = first = None
        for d in (os.environ.get("PATH") or "/bin:/usr/bin").split(":"):   # 沒設＝/bin:/usr/bin（只拿來找，不 export）
            last = execv(os.path.join(d, argv[0]), argv)
            if first is None and not isinstance(last, (FileNotFoundError, NotADirectoryError)):
                first = last
        err = first or last
    raise Fail("起不來：%s（%s）" % (argv[0], err.strerror))


USAGE = "aos-exec [--ws WS] XXX [args...]"
# 旗標表：旗標名 → 存進 opts 的名字。都帶一個值（`--x V` 或 `--x=V`），重複給＝最後一個算。以後加旗標就在這裡加一列。
FLAGS = {"--ws": "ws"}


def parse(argv):
    """[旗標...] XXX [args...] → (opts, XXX, args)。第一個不是旗標的參數（不以 - 開頭，或就是 -）就是 XXX。"""
    opts, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if not a.startswith("-") or a == "-":
            break
        name, eq, val = a.partition("=")
        if name not in FLAGS:
            die("usage: %s（不認得的旗標 %s）" % (USAGE, name))
        if not eq:
            i += 1
            if i == len(argv):
                die("usage: %s（%s 缺值）" % (USAGE, name))
            val = argv[i]
        opts[FLAGS[name]] = val
        i += 1
    if i == len(argv):
        die("usage: %s（沒有 XXX）" % USAGE)
    return opts, argv[i], argv[i + 1:]


def main(argv):
    opts, spec, args = parse(argv)
    ws = opts.get("ws", "-")   # 旗標蓋過 $AOS_WS；沒給／-／空才沿用
    if ws in ("-", ""):
        ws = os.environ.get("AOS_WS") or "."
    if not os.path.isdir(ws):
        die("工作區不存在：%s" % ws)
    try:
        kind, val, f = find(spec, os.getcwd())
        ws = os.path.abspath(ws)
        stack = os.environ.get("AOS_STACK") or os.path.join(ws, ".aos")
        try:
            os.makedirs(stack, exist_ok=True)
        except OSError as e:
            raise Fail("建不了 AOS_STACK：%s（%s）" % (stack, e.strerror))
        cd = os.path.dirname(f)
        os.environ.update(AOS_WS=ws, AOS_STACK=os.path.join(os.path.abspath(stack), ""),
                          AOS_CF=f, AOS_CD=cd)
        os.chdir(cd)
        return launch(kind, val, f, args)
    except Fail as e:
        die(e)


if __name__ == "__main__":
    sys.path.insert(0, BIN)
    sys.exit(main(sys.argv[1:]))
