#!/usr/bin/env python3
"""aos-exec [旗標...] XXX [args...] — 在工作區執行 XXX 這個程式（N-57～N-62）。純標準庫。

命令列（10-21 ideas）：XXX 前面是 aos-exec 自己的旗標（表在 FLAGS，解析在 aos_flags.py），第一個不是旗標的參數就是 XXX，之後原樣傳給入口；
`--` 結束旗標（XXX 可以 - 開頭）。`--ws WS`（或 `--ws=WS`）：工作區；沒給、`-`、空＝沿用 $AOS_WS，沒設用 .。
`--dotenv-override`（不帶值，10-22）：這一次 aos-exec 讀的每份 .env 蓋掉環境裡已有的名字；沒給＝已有的不蓋（同 python-dotenv）。
旗標蓋過對應的環境變數。不認得的旗標、旗標缺值、沒有 XXX＝usage 錯。
XXX：資料夾、檔、或 `檔#/指標`；相對路徑照呼叫當下的 cwd；不在、basename 沒有 `.` → 補找 XXX.json。
一跳（hop；10-21 ideas § 4～§ 6）：export AOS_WS、AOS_STACK（沒設＝$AOS_WS/.aos/，建好）→ 走進資料夾或檔所在的資料夾
（AOS_CD＝它、AOS_CF＝它或那個檔、AOS_CO＝空；cd；讀那裡的 .env；旗標蓋回；沒 --dotenv-override＝旗標 ＞ 原本的環境變數 ＞ .env ＞ 預設，
有＝旗標 ＞ .env ＞ 原本的 ＞ 預設；.env 設的 AOS_* 照字面，不驗、不建）→
照「當下的」$AOS_ENTRY（預設 _exec）挑入口：資料夾 → $AOS_ENTRY 一段段走、沿路資料夾都走進去，挑到資料夾就再走進去、
一路往下，挑到檔（或補 .json）為止。解開捷徑後：有 +x＝可執行檔（exec，不讀內容；沒 #! 改用 /bin/sh 跑）；沒 +x 當 JSON 讀
（第一行 #! 跳過、照 #/ 取值）：非空陣列＝argv（元素可放 $env／$ref，開跑前解、解完要全是字串，10-20 ideas D2、D8；exec，
同 execvp：沒 #! 改用 /bin/sh 跑；argv[0] 帶 / 又 exec 不了＝前面插 aos-exec、照 PATH 找，D3）、有 argv 的物件＝inst 單子
（行程內 aos_inst.run，以子程式的碼結束）、沒 argv 的物件＝當資料夾：套它的 `.env` key、旗標蓋回、取 [$AOS_ENTRY]，一路往下、
字串＝路徑轉向（全新的一跳；從寫著它的檔所在的資料夾算，繞圈＝入口壞）。AOS_CF＝實際的檔，AOS_CO＝入口在檔裡的 JSON 指標
（不帶 #，不是 JSON 或整份檔＝空）。PATH 不動、原樣傳下去（ideas § 24；入口裡要叫 aos-exec、aos-loop… 由呼叫者事先放進 PATH）。
args 接在入口後面，stdin 原樣給入口。自己的錯退 1，stderr 一行「aos-exec: 原因」（N-60）。
"""
import errno
import json
import os
import re
import signal
import sys

BIN = os.path.dirname(os.path.realpath(__file__))


class Fail(Exception):
    """aos-exec 自己的錯（N-60）。"""


def die(msg):
    print("aos-exec: %s" % msg, file=sys.stderr)
    sys.exit(1)


def entry_name():
    return os.environ.get("AOS_ENTRY") or "_exec"


def pointer(doc, ptr, where):
    """RFC 6901：ptr 是 `/a/b`（`~1`＝`/`、`~0`＝`~`）。指不到＝入口不存在。"""
    for tok in ptr[1:].split("/"):
        tok = tok.replace("~1", "/").replace("~0", "~")
        if isinstance(doc, dict) and tok in doc:
            doc = doc[tok]
        elif isinstance(doc, list) and tok.isdigit() and (tok == "0" or not tok.startswith("0")) \
                and int(tok) < len(doc):
            doc = doc[int(tok)]
        else:
            raise Fail("入口不存在：%s#%s 指不到" % (where, ptr))
    return doc


def locate(spec, base):
    """XXX → (資料夾或 None, 實際的檔或 None, 指標或 None)。base＝相對路徑的起點。
    XXX 是資料夾時只回資料夾（實際的資料夾），入口檔等走進去、讀完那裡的 .env 才照 $AOS_ENTRY 挑（10-21 ideas § 5、§ 6）。"""
    path, hashed, ptr = spec.partition("#")
    if hashed and not ptr.startswith("/"):
        raise Fail("入口壞：%s 的 # 後面要接 /" % spec)
    ptr = ptr if hashed else None
    p = os.path.join(base, path)
    if os.path.isdir(p):
        if ptr is not None:
            raise Fail("入口壞：資料夾不能帶 #/：%s" % spec)
        return os.path.realpath(p), None, None
    if os.path.isfile(p):
        f = p
    elif not os.path.lexists(p) and "." not in os.path.basename(path) and os.path.isfile(p + ".json"):
        f = p + ".json"
    else:
        raise Fail("入口不存在：%s" % spec)
    return None, os.path.realpath(f), ptr


def find(f, ptr, seen, layer, override):
    """實際的檔＋指標 → (種類, 值, 入口在檔裡的指標, 最後讀的那份 JSON .env key 設過的名字；一份都沒讀＝None)。
    種類：exe（值＝None）、argv（陣列）、inst（單子 dict）、redir（值＝轉向的路徑）。
    沒 argv 的物件＝資料夾（10-21 ideas § 6）：進去那一刻 $AOS_ENTRY 若是 `.env`＝照做、把 `.env` 那格當入口、不當環境設定；
    否則先套它的 `.env` key、旗標蓋回（layer），再照當下的 $AOS_ENTRY 取那格，又是沒 argv 的物件就一路往下
    （挑的時候不解 $ref，走的是 JSON 那棵樹、不會無限）。seen＝這條轉向鏈走過的 (檔, 指標)，就地加上這一個；走回去＝繞圈。"""
    spec = f + ("#" + ptr if ptr is not None else "")
    if os.access(f, os.X_OK):
        if ptr is not None:
            raise Fail("入口壞：可執行檔不能帶 #/：%s" % spec)
        return "exe", None, "", None
    where = (f, ptr or "")
    if where in seen:
        chain = [a + b for a, b in seen + [where]]
        raise Fail("入口壞：字串轉向繞圈：%s" % " → ".join(chain))
    seen.append(where)
    try:
        with open(f, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        raise Fail("入口讀不到：%s（%s）" % (f, e.strerror))
    if text.startswith("#!"):
        text = text.partition("\n")[2]
    try:
        doc = json.loads(text)
    except ValueError:
        raise Fail("入口壞：沒有 +x、也不是 JSON：%s" % f)
    at, names = ptr or "", None
    if ptr is not None:
        doc = pointer(doc, ptr, f)
    while isinstance(doc, dict) and "argv" not in doc:
        here = "%s#%s" % (f, at) if at else f
        if entry_name() != ".env" and ".env" in doc:
            names = json_env(doc[".env"], here, os.path.dirname(f), override)   # 只留最後讀的那一份（10-21 ideas § 7）
            layer()
        name = entry_name()
        if name not in doc:
            raise Fail("入口壞：%s 不是單子、也沒有 %s" % (here, name))
        doc, at = doc[name], at + "/" + name.replace("~", "~0").replace("/", "~1")
    if isinstance(doc, str):   # 字串轉向＝交給下一層、全新的一次 aos-exec（main 的迴圈做；10-21 .env）
        return "redir", doc, at, names
    if isinstance(doc, dict):
        return "inst", doc, at, names
    if isinstance(doc, list) and doc:   # 元素可以是字串或指示詞（10-20 ideas D2、D8），開跑前才解
        return "argv", doc, at, names
    raise Fail("入口壞：%s 不是單子、argv 陣列或路徑" % f)


def execv(prog, argv):
    """exec prog；+x 沒 #! 的檔（ENOEXEC）同 glibc execvp 改用 `/bin/sh prog argv[1:]` 跑（ideas § 22）。回錯誤。"""
    try:
        os.execv(prog, argv)
    except OSError as e:
        if e.errno != errno.ENOEXEC:
            return e
    try:
        os.execv("/bin/sh", ["/bin/sh", prog] + argv[1:])
    except OSError as e:
        return e


def launch(kind, val, f, args):
    """cd 已做完。exe／argv＝exec（不留行程）；inst＝行程內跑、以子程式的碼結束。"""
    if kind == "inst":
        import aos_inst
        try:
            return aos_inst.run(val, args)["code"]
        except aos_inst.InstError as e:
            raise Fail("單子跑不起來：%s" % e)
    if kind == "argv":   # 指示詞在六個 AOS_* 設好、.env 讀完之後解；$ref 從入口檔所在的資料夾（＝cwd）算
        import aos_inst
        try:
            val = aos_inst.resolve(val, os.getcwd())
        except aos_inst.InstError as e:
            raise Fail("入口壞：argv 陣列的指示詞解不開：%s" % e)
        if not all(isinstance(a, str) for a in val):
            raise Fail("入口壞：argv 陣列解完要全是字串：%s" % json.dumps(val, ensure_ascii=False))
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)      # Python 預設忽略 SIGPIPE，exec 會繼承；還原
    if kind == "exe":
        err = execv(f, [f] + args)
        raise Fail("起不來：%s（%s）" % (f, err.strerror))
    argv = aos_inst.argv0(val + args, ".")   # 帶 / 又 exec 不了＝前面插 aos-exec（D3、D5）
    if "/" in argv[0]:
        err = execv(argv[0], argv)
    else:   # 同 execvp：照 PATH 一段段 execv；找不到換下一段，別的錯（沒 +x…）記第一個、也換下一段
        last = first = None
        for d in (os.environ.get("PATH") or "/bin:/usr/bin").split(":"):   # 沒設＝/bin:/usr/bin（只拿來找，不 export）
            last = execv(os.path.join(d, argv[0]), argv)
            if first is None and not isinstance(last, (FileNotFoundError, NotADirectoryError)):
                first = last
        err = first or last
    raise Fail("起不來：%s（%s）" % (argv[0], err.strerror))


USAGE = "aos-exec [--ws WS] [--dotenv-override] XXX [args...]"
# 旗標表：旗標名 → 存進 opts 的名字。FLAGS 帶一個值（`--x V` 或 `--x=V`），重複給＝最後一個算；SWITCHES 不帶值（給了＝True）。
# 以後加旗標就在這裡加一列。
FLAGS = {"--ws": "ws"}
SWITCHES = {"--dotenv-override": "dotenv_override"}   # 10-22：.env 蓋掉已有的（只管這一次 aos-exec，不往下傳）


def parse(argv):
    """[旗標...] XXX [args...] → (opts, XXX, args)。解析規則在 aos_flags（aos-loop、aos-daemon 共用，10-21 plan L1）。"""
    import aos_flags
    try:
        opts, rest = aos_flags.parse(argv, FLAGS, SWITCHES)
    except aos_flags.Error as e:
        die("usage: %s（%s）" % (USAGE, e))
    if not rest:
        die("usage: %s（沒有 XXX）" % USAGE)
    return opts, rest[0], rest[1:]



NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
REF = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
EXPORT = re.compile(r"export[ \t]+(?=[^=\s])")   # `export X=1` 的前綴（10-22 B1）；`export=1`、`export =1` 是名字 export


def set_env(name, val, bad, keep, expand=True):
    """一個 `名字=值` 套進 os.environ：名字要合規則；expand＝展開 ${名字}（沒設＝錯），孤零零的 $ 原樣留。錯呼叫 bad(原因)。
    名字在 keep 裡（不蓋時＝開始讀這份 .env 那一刻環境裡已有的名字，10-22）＝驗過、不設，回 False；設了回 True。"""
    if not NAME.match(name):
        bad("名字要是英數字和底線、不以數字開頭")
    out, i = [], 0
    while expand:
        j = val.find("${", i)
        if j < 0:
            break
        m = REF.match(val, j)
        if not m:
            bad("${ 後面要接 名字}")
        if m.group(1) not in os.environ:
            bad("${…} 引用的環境變數沒設")
        out += [val[i:j], os.environ[m.group(1)]]
        i = m.end()
    out.append(val[i:])
    val = "".join(out)
    if "\0" in val:
        bad("值不能有 NUL")
    if name in keep:
        return False
    os.environ[name] = val
    return True


def env_value(rest, bad):
    """`=` 後面那段 → (值, 要不要展開 ${})。基礎子集（10-22 ideas，計畫 B2～B8）：收下的寫法給的值同 python-dotenv，
    各家給的值不一樣的寫法＝錯。"""
    v = rest.lstrip(" \t")
    if v[:1] in ("'", '"'):   # 引號只剝一對：不跳脫、不跨行；單引號照字面，雙引號展開 ${}
        q = v[0]
        j = v.find(q, 1)
        if j < 0:
            bad("引號沒收尾（不支援多行）")
        inner, tail = v[1:j], v[j + 1:].lstrip(" \t")
        if "\\" in inner:
            bad("引號裡不能有 \（不支援跳脫）")
        if q == "'" and "${" in inner:
            bad("單引號裡不能有 ${")
        if tail and not tail.startswith("#"):
            bad("引號後面只能接空白或 # 註解")
        return inner, q == '"'
    if v.startswith("#") and v != rest:
        bad("= 後面空白再接 #（要空值寫 X=，要 # 開頭的值加引號）")
    m = re.search(r"[ \t]#", v)   # 沒引號：第一個「空格／tab＋#」起是註解；a#b、#fff 照字面
    if m:
        v = v[:m.start()]
    return v.rstrip(" \t"), True


def load_env(d, override):
    """讀 d/.env、逐行套進 os.environ（10-21 ideas § 4；10-22 格式基礎子集、預設不蓋）。沒有＝什麼都不做。回 .env 設過的名字。
    一行 `[export ]名字=值`：去行尾 \\r、去前導空白（只認 ASCII 空白，同 C++ 版，10-22）後空的或 # 開頭跳過；= 只切第一個、兩邊空白忽略；
    值見 env_value；展開 ${名字}（逐行，後面看得到前面設的）。override 假＝開始讀這份檔時環境裡已有的名字整行跳過（格式照驗），
    同一份檔裡同名照樣後者贏。錯（讀不到、格式不合、${名字} 沒設）只印檔名和行號，絕不印值。"""
    p, names = os.path.join(d, ".env"), set()
    if not os.path.lexists(p):
        return names
    try:
        with open(p, encoding="utf-8", newline="") as fh:
            lines = fh.read().split("\n")
    except OSError as e:
        raise Fail(".env 讀不到：%s（%s）" % (p, e.strerror))
    except ValueError:
        raise Fail(".env 壞：%s 不是 UTF-8" % p)
    keep = set() if override else set(os.environ)
    for n, line in enumerate(lines, 1):
        def bad(why):
            raise Fail(".env 壞：%s 第 %d 行（%s）" % (p, n, why))
        line = line.lstrip(" \t\n\v\f\r")   # 只認 ASCII 空白（同 C++ isspace；10-22 使用者要 Python 照 C++ 的寬鬆）
        if line.endswith("\r"):
            line = line[:-1]
        if not line or line.startswith("#"):
            continue
        m = EXPORT.match(line)
        if m:
            line = line[m.end():]
        name, eq, rest = line.partition("=")
        if not eq:
            bad("沒有 =")
        val, expand = env_value(rest, bad)
        if set_env(name.rstrip(" \t"), val, bad, keep, expand):
            names.add(name.rstrip(" \t"))
    return names


def json_env(env, where, ref_base, override):
    """沒 argv 的 JSON 物件裡的 `.env` key（10-21 ideas § 6）：{"名字": 值}，照順序套。值可以放指示詞（$env、$ref…，
    同單子那套；$ref 從那份檔的資料夾算），解完不是字串的那一項靜默跳過；字串照 .env 檔的規則（名字、${名字}；
    引號、註解那些 JSON 自己有，不套）。蓋不蓋同 .env 檔（10-22）。
    `.env` 解完不是物件＝整個跳過。指示詞解不開、名字不合、${名字} 沒設＝.env 壞，只印位置、不印名字和值。回設過的名字。"""
    import aos_inst

    def bad(why):
        raise Fail(".env 壞：%s 的 .env（%s）" % (where, why))
    try:
        env = aos_inst.resolve(env, ref_base)
    except aos_inst.InstError:
        bad("指示詞解不開")
    names = set()
    if not isinstance(env, dict):
        return names
    keep = set() if override else set(os.environ)
    for name, val in env.items():
        if isinstance(val, str) and set_env(name, val, bad, keep):
            names.add(name)
    return names


def hop(spec, base, opts, seen):
    """一次 aos-exec（N-59；10-21 ideas § 4～§ 6）：定工作區 → 找 XXX → export AOS_WS、AOS_STACK → 走進資料夾
    （AOS_CD／AOS_CF＝它、AOS_CO＝空、cd、讀那裡的 .env、旗標蓋回）→ 照當下的 $AOS_ENTRY 挑入口。
    資料夾：$AOS_ENTRY 一段段走，沿路每個資料夾都走進去（由外到內）；最後一段又是資料夾＝走進去、照當下的 $AOS_ENTRY 再挑，
    一路往下（走回走過的資料夾＝入口壞，多段路徑中間經過的也算；空的段不算一段，`_exec/`＝`_exec`，10-21 ideas § 7）。走進資料夾那一刻 $AOS_ENTRY 是 `.env`＝那份 .env 是入口、不讀成環境。
    挑到檔後 AOS_CF＝檔、AOS_CD＝它的資料夾、AOS_CO＝入口在檔裡的指標；最後讀的那一份 .env（或 JSON 的 .env key）自己設了就不蓋。
    回 (種類, 值, 實際的檔)。"""
    override = opts.get("dotenv_override", False)   # 這一跳讀的每份 .env 都吃（10-22）
    ws = opts.get("ws", "-")   # 旗標蓋過 $AOS_WS；沒給／-／空才沿用
    flag_ws = ws not in ("-", "")
    if not flag_ws:
        ws = os.environ.get("AOS_WS") or "."
    if not os.path.isdir(ws):
        raise Fail("工作區不存在：%s" % ws)
    d, f, ptr = locate(spec, base)
    ws = os.path.abspath(ws)
    stack = os.environ.get("AOS_STACK") or os.path.join(ws, ".aos")
    try:
        os.makedirs(stack, exist_ok=True)
    except OSError as e:
        raise Fail("建不了 AOS_STACK：%s（%s）" % (stack, e.strerror))
    os.environ.update(AOS_WS=ws, AOS_STACK=os.path.join(os.path.abspath(stack), ""))

    def layer():   # 每讀完一份 .env（檔或 JSON 的 .env key）旗標蓋回去
        if flag_ws:
            os.environ["AOS_WS"] = ws

    def enter(x, cf):   # 走進一層：設 AOS_CF／AOS_CD／AOS_CO、cd、讀 .env（什麼都能設、含 AOS_*；已經 cd 過，改 AOS_CD 不會再 cd）
        os.environ.update(AOS_CF=cf, AOS_CD=x, AOS_CO="")
        os.chdir(x)
        names = load_env(x, override) if entry_name() != ".env" else set()
        layer()
        return names

    if d is None:
        names = enter(os.path.dirname(f), f)
    else:
        names, visited = enter(d, d), {d}
        while f is None:
            name = entry_name()
            parts = [x for x in name.split("/") if x] or ["."]   # 空的段不算（尾巴的 /、//）；全是 /＝.
            for part in parts[:-1]:   # 多段的 $AOS_ENTRY（例 sub/run）：沿路的資料夾都走進去（由外到內）
                nxt = os.path.realpath(os.path.join(d, part))
                if not os.path.isdir(nxt):
                    raise Fail("入口不存在：%s（%s 不是資料夾）" % (os.path.join(d, name), os.path.join(d, part)))
                if nxt != d:   # . 不算走進新資料夾；走回走過的（例 sub/../sub/run）＝繞圈
                    if nxt in visited:
                        raise Fail("入口壞：資料夾繞圈：%s" % nxt)
                    visited.add(nxt)
                    d, names = nxt, enter(nxt, nxt)
            last = os.path.join(d, parts[-1])
            if os.path.isdir(last):   # 挑到資料夾＝走進去，照當下的 $AOS_ENTRY 再挑
                nxt = os.path.realpath(last)
                if nxt in visited:
                    raise Fail("入口壞：資料夾繞圈：%s" % nxt)
                visited.add(nxt)
                d, names = nxt, enter(nxt, nxt)
                continue
            if not os.path.lexists(last):
                last += ".json"
            if not os.path.isfile(last):
                raise Fail("入口不存在：%s（也沒有 %s.json）" % (os.path.join(d, parts[-1]), parts[-1]))
            f = os.path.realpath(last)
        if "AOS_CF" not in names:
            os.environ["AOS_CF"] = f
        if os.path.dirname(f) != d:   # 入口檔是指到別處的捷徑：cd 到實際的資料夾，那邊的 .env 不讀
            os.chdir(os.path.dirname(f))
            if "AOS_CD" not in names:
                os.environ["AOS_CD"] = os.path.dirname(f)
    kind, val, at, more = find(f, ptr, seen, layer, override)
    last = names if more is None else more   # 只看最後讀的那一份（檔或 JSON .env key）自己設了沒（10-21 ideas § 7）
    for k, v in (("AOS_CF", f), ("AOS_CD", os.path.dirname(f)), ("AOS_CO", at)):
        if k not in last:
            os.environ[k] = v
    return kind, val, f


def main(argv):
    opts, spec, args = parse(argv)
    base, seen = os.getcwd(), []
    try:
        while True:
            kind, val, f = hop(spec, base, opts, seen)
            if kind != "redir":
                return launch(kind, val, f, args)
            # 字串轉向＝交給下一層、全新的一次 aos-exec（C-52）：旗標（含 --dotenv-override，10-22）不帶過去、args 原樣接過去，
            # 下一層自己定工作區、cd、讀它那裡的 .env（疊在這層設好的環境上）。繞圈偵測沿用同一條鏈。
            spec, base, opts = val, os.path.dirname(f), {}
    except Fail as e:
        die(e)


if __name__ == "__main__":
    sys.path.insert(0, BIN)
    sys.exit(main(sys.argv[1:]))
