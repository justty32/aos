#!/bin/sh
# proto8 的 aos 入口（原型，薄入口）：放進 PATH 就能在 inst 的 argv 寫指令名（C-50），不寫相對腳本路徑。
#   aos inst|loop|daemon|fsm|gate|seq|par|if|tick ...          → python3 lib/aos_<名>.py ...（seq／par／if＝tasks、tick＝時鐘）
#   aos kernel llm|general ...                                  → python3 lib/aos_kernel_<名>.py ...（兩種 kernel，N-42）
#   aos agent think|tool|route|intake|done|fsm ...             → python3 lib/aos_agent_lib.py ...
#   aos brain openai ...                                       → python3 lib/aos_brain_openai.py ...（只有 OpenAI 相容一顆）
# 跟 C++ 的 aos 執行檔同名但不相干；誰先在 PATH 上就用誰（proto8 的測試與 demo 把本資料夾排最前面）。
lib="$(dirname "$(readlink -f "$0")")/../lib"
cmd="$1"
[ $# -gt 0 ] && shift
case "$cmd" in
  inst|loop|daemon|fsm|gate|seq|par|if|tick) exec python3 "$lib/aos_$cmd.py" "$@" ;;
  kernel)
    case "$1" in
      llm|general) k="$1"; shift; exec python3 "$lib/aos_kernel_$k.py" "$@" ;;
    esac ;;
  agent) exec python3 "$lib/aos_agent_lib.py" "$@" ;;
  brain)
    case "$1" in
      openai) shift; exec python3 "$lib/aos_brain_openai.py" "$@" ;;
    esac ;;
esac
printf '{"error": {"code": "Usage", "msg": "aos inst|loop|daemon|fsm|gate|seq|par|if|tick|kernel llm|general|agent|brain openai ...（proto8 入口），不認得 %s"}}\n' "$cmd $1" >&2
exit 1
