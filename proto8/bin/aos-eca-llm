#!/usr/bin/env python3
"""aos-eca-llm - eca 的腦設定（介面 aos-agent/llm 的身體；demo/eca-claude/llm/_entry 叫它，thinking 2026-11-04 aos-agent 03/02）。

    aos-eca-llm <eca 資料夾> def|stack show
    aos-eca-llm <eca 資料夾> def|stack set 鍵=值…
    aos-eca-llm <eca 資料夾> stack reset

對象 def＝定義裡的 cli.json（`flags` 裡 `--model` 後面那格；沒有就加在 flags 尾）；stack＝正在跑那隻的副本 $AOS_STACK/llm.json
（只放改過的鍵；cli_session 每題起 CLI 前讀它換掉 --model＝下一題生效）。鍵：kind（claude／codex，只印、不給改）、model。
show＝一行一個 `鍵=值`；stack show＝定義被副本蓋過後的，哪些鍵來自副本印在 stderr 一行「副本：model」。set 做完再 show 一次；reset 刪副本。
人不直接打它：`aos-agent llm --target 名字 …`（stack）、`aos-llm <定義> …`（def）。
錯：stderr 一行 `aos-eca-llm: 代號 原因`、退 1：ArgumentsBad、KeyUnknown、StackMissing、CfgBad、WriteFailed。"""
import json, os, re, sys

PROG = "aos-eca-llm"
USAGE = "用法：aos-eca-llm <eca 資料夾> def|stack show|set 鍵=值…|reset"
KEYS = ("kind", "model")                              # show 的順序；kind 只印
SETTABLE = ("model",)


def die(code, msg):
    print("%s: %s %s" % (PROG, code, msg), file=sys.stderr)
    sys.exit(1)


def write(path, text):                               # N-05：先寫暫存再改名
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError as e:
        die("WriteFailed", "%s：%s" % (path, e))


def read_json(path, missing_ok):
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
    except FileNotFoundError:
        if missing_ok:
            return {}
        die("CfgBad", "%s 不在" % path)
    except (OSError, ValueError) as e:
        die("CfgBad", "%s：%s" % (path, e))
    if not isinstance(d, dict):
        die("CfgBad", "%s：要是物件" % path)
    return d


def def_values(cli):
    cfg = read_json(cli, False)
    flags = cfg.get("flags", [])
    if not isinstance(flags, list):
        die("CfgBad", "%s：flags 要是字串陣列" % cli)
    model = flags[flags.index("--model") + 1] if "--model" in flags[:-1] else ""
    return {"kind": cfg.get("kind", ""), "model": model}


def set_def_model(cli, model):
    """只改 --model 後面那格（保留 cli.json 原本的排版）；沒有 --model＝加在 flags 尾（整份重寫）。"""
    with open(cli, encoding="utf-8") as f:
        text = f.read()
    pat = re.compile(r'("--model"\s*,\s*)"(?:[^"\\]|\\.)*"')
    if len(pat.findall(text)) == 1:
        write(cli, pat.sub(lambda m: m.group(1) + json.dumps(model, ensure_ascii=False), text))
        return
    cfg = read_json(cli, False)
    flags = list(cfg.get("flags", []))
    if "--model" in flags[:-1]:
        flags[flags.index("--model") + 1] = model
    else:
        flags += ["--model", model]
    cfg["flags"] = flags
    write(cli, json.dumps(cfg, ensure_ascii=False) + "\n")


def copy_path():
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "沒設定 AOS_STACK（對象 stack 要它）")
    return os.path.join(stack, "llm.json")


def show(cli, target):
    vals = def_values(cli)
    if target == "stack":
        copy = read_json(copy_path(), True)
        over = [k for k in SETTABLE if isinstance(copy.get(k), str)]
        vals.update({k: copy[k] for k in over})
        if over:
            print("副本：%s" % " ".join(over), file=sys.stderr)
    for k in KEYS:
        print("%s=%s" % (k, vals.get(k, "")))


def main():
    argv = sys.argv[1:]
    if len(argv) < 3 or argv[1] not in ("def", "stack") or argv[2] not in ("show", "set", "reset"):
        die("ArgumentsBad", USAGE)
    cli = os.path.join(os.path.realpath(argv[0]), "cli.json")
    target, act, rest = argv[1], argv[2], argv[3:]
    if act == "show":
        if rest:
            die("ArgumentsBad", "show 不帶參數")
    elif act == "reset":
        if target != "stack" or rest:
            die("ArgumentsBad", "reset 只有 stack、不帶參數")
        try:
            os.remove(copy_path())
        except FileNotFoundError:
            pass
        except OSError as e:
            die("WriteFailed", str(e))
    else:
        changes = {}
        for a in rest:
            k, eq, v = a.partition("=")
            if not eq or not k:
                die("ArgumentsBad", "要寫成 鍵=值：%s" % a)
            if k not in SETTABLE:
                die("KeyUnknown", "%s（能改的只有 %s；kind 只印）" % (k, "、".join(SETTABLE)))
            if not v:
                die("ArgumentsBad", "%s 不能是空的" % k)
            changes[k] = v
        if not changes:
            die("ArgumentsBad", "set 至少一個 鍵=值")
        if target == "def":
            def_values(cli)                          # 先確認讀得懂
            set_def_model(cli, changes["model"])
        else:
            path = copy_path()
            copy = read_json(path, True)
            copy.update(changes)
            write(path, json.dumps(copy, ensure_ascii=False) + "\n")
    show(cli, target)


if __name__ == "__main__":
    main()
