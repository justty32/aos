#!/usr/bin/env python3
"""aos-loop LOOP.json — 每圈跑一次 run。loop.json: {"run": 子資料夾 或 一張單子, "max": 圈數}
run 是字串＝每圈 `aos-exec <run>`；是物件＝單子，行程內 aos_inst.run() 跑（取它的 code）。
子程式結束碼：0 繼續下一圈；10 要求停（loop 以 0 結束）；其他非 0 失敗（loop 原碼結束）。跑滿 max 圈：結束碼 0，stderr 不寫（N-43 正常退出；有沒有跑滿看 trace.jsonl 行數）。
收到 SIGINT／SIGTERM／SIGHUP：轉給正在跑的那拍（字串＝那個子行程；單子＝aos_inst 轉整群），等它結束、不起下一拍，
以 128＋N 結束、stderr 不寫；拍與拍之間收到就直接 128＋N（P-36；對齊 impls 的 aos-loop，ideas § 24）。PATH 不動。
自己的錯（檔讀不到、不是 JSON、run 不對、單子壞）退 1，stderr 一行 `aos-loop: 原因`。"""
import json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_beat, aos_inst

STOP = 10


def die(msg):
    print(f"aos-loop: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    aos_beat.block()
    if len(sys.argv) < 2:
        die("usage: aos-loop LOOP.json")
    try:
        cfg = json.load(open(sys.argv[1], encoding="utf-8"))
    except (OSError, ValueError) as e:
        die(f"讀不到或不是 JSON：{sys.argv[1]}（{e}）")
    if not isinstance(cfg, dict) or not isinstance(cfg.get("run"), (str, dict)):
        die('loop.json 要是 {"run": 子資料夾或單子, "max": 圈數}')
    run, mx = cfg["run"], cfg.get("max", 10)
    if isinstance(mx, bool) or not isinstance(mx, int):
        die("max 要是整數")
    name = run if isinstance(run, str) else " ".join(map(str, run.get("argv", ["?"])))
    for i in range(mx):
        if aos_beat.take():
            sys.exit(128 + aos_beat.take())
        try:
            b = aos_beat.run(run)
        except aos_inst.InstError as e:
            die(str(e))
        if b["received"]:
            sys.exit(128 + b["received"])
        rc = b["code"]
        if rc == STOP:
            sys.exit(0)
        if rc:
            print(f"aos-loop: 第 {i+1} 圈 {name} 失敗，結束碼 {rc}", file=sys.stderr)
            sys.exit(rc)


main()
