#!/usr/bin/env python3
"""aos-loop LOOP.json — 每拍跑一次 run。loop.json: {"run": 子資料夾 或 一張單子, "max": 圈數}，選填 interval_ms、ctl、state。
run 是字串＝每拍 `aos-exec <run>`；是物件＝單子，行程內 aos_inst.run() 跑（取它的 code）。
子程式結束碼：0 繼續下一拍；10 要求停（loop 以 0 結束）；其他非 0 失敗（loop 原碼結束）。跑滿 max 拍：結束碼 0，stderr 不寫。
interval_ms＝拍與拍之間至少隔幾毫秒（沒寫＝0）。ctl／state＝窗的檔名，在 $AOS_STACK 底下（沒寫＝不開）：
ctl 認 paused、stop、max、interval_ms、seq（N-06～N-08）；state 每圈寫一次（心跳只在拍與拍之間，N-17、N-32）。
收到 SIGINT／SIGTERM／SIGHUP：轉給正在跑的那拍，等它結束、不起下一拍，以 128＋N 結束、stderr 不寫（P-36）。PATH 不動。
自己的錯（檔讀不到、不是 JSON、run 不對、單子壞、寫了窗卻沒設 AOS_STACK）退 1，stderr 一行 `aos-loop: 原因`。
骨架在 aos_loop.py（aos-daemon 共用）。"""
import os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_loop

sys.exit(aos_loop.cli(aos_loop.Loop, sys.argv))
