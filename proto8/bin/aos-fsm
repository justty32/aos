#!/usr/bin/env python3
"""aos-fsm FSM.json — fsm 一拍只跑一格。
FSM.json: {"start": "idle", "states": {"idle": {"val": "idle", "next": "think"},
                                         "think": {"val": {"argv": [...], ...}, "next": "act"}, ...}}
讀 $AOS_STACK/state（純文字一行狀態名；沒有＝start，格式與 shell 版相同；寫的時候先寫 .state 再改名，N-05）；查格；
val 是字串＝`aos-exec <它>`（相對路徑從 cwd 算）、是物件＝單子，行程內 aos_inst.run()。
每拍在 $AOS_STACK/trace.jsonl 追加一行 {"at","state","code","signal","timed_out","ms"}（at＝這拍開始的 UTC 時間）。
結束碼 0 才把 next 寫進 state；以那格的碼退出（10 與其他非 0 原樣往上，狀態都不動）。
只看格的結束碼，不讀格的 stdout、不轉述格的 stderr。PATH 不動。
收到 SIGINT／SIGTERM／SIGHUP：轉給那格（字串＝那個子行程；單子＝aos_inst 轉整群），等格結束，trace 與 state 照常寫完，
再以 128＋N 結束；跑格之前就收到＝不跑、直接 128＋N（P-36；對齊 impls 的 aos-fsm，ideas § 24）。自己的錯（沒設 AOS_STACK、表壞、查不到格、單子壞）
退 1，stderr 一行 `aos-fsm: 原因`。"""
import datetime, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_beat, aos_inst


def die(msg):
    print(f"aos-fsm: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    aos_beat.block()
    if len(sys.argv) < 2:
        die("usage: aos-fsm FSM.json")
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("沒設定 AOS_STACK")
    try:
        cfg = json.load(open(sys.argv[1], encoding="utf-8"))
    except (OSError, ValueError) as e:
        die(f"讀不到或不是 JSON：{sys.argv[1]}（{e}）")
    states = cfg.get("states") if isinstance(cfg, dict) else None
    if not isinstance(states, dict) or not isinstance(cfg.get("start"), str):
        die('fsm.json 要是 {"start": 狀態名, "states": {名: {"val", "next"}}}')
    sfile = os.path.join(stack, "state")
    try:
        state = open(sfile, encoding="utf-8").read().strip() or cfg["start"]
    except OSError:
        state = cfg["start"]
    cell = states.get(state)
    if not (isinstance(cell, dict) and "val" in cell and isinstance(cell.get("next"), str)):
        die(f"查不到狀態 {state}（或它不是 {{\"val\", \"next\"}}）")
    val = cell["val"]
    if not isinstance(val, (str, dict)):
        die(f"狀態 {state} 的 val 要是子資料夾名或單子")
    if aos_beat.take():
        sys.exit(128 + aos_beat.take())
    at = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    try:
        res = aos_beat.run(val)
    except aos_inst.InstError as e:
        die(f"狀態 {state}：{e}")
    with open(os.path.join(stack, "trace.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"at": at, "state": state, "code": res["code"], "signal": res["signal"],
                            "timed_out": res["timed_out"], "ms": res["ms"]}, ensure_ascii=False) + "\n")
    if res["code"] == 0:
        tmp = os.path.join(stack, ".state")   # N-05：先寫 . 開頭的暫存檔再改名蓋過去，讀的人不會讀到半份
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(cell["next"] + "\n")
        os.replace(tmp, sfile)
    if res["received"]:
        sys.exit(128 + res["received"])
    sys.exit(res["code"])


main()
