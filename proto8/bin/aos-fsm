#!/usr/bin/env python3
"""aos-fsm FSM.json — fsm 一拍只跑一格（10-21 plan § 4；命令列 10-21 傍晚 ideas § 9 改）。
命令列 `aos-fsm [旗標] 設定檔`：唯一的位置參數＝設定檔（必給、只能一個；可寫 `檔#/指標`＝那份檔裡那個位置的物件）；
目前沒有旗標（旗標表是空的，規則同 aos-exec，aos_flags；`--` 結束旗標）。沒給、多給、不認得的旗標＝usage 錯（原 `--cfg` 拿掉）。
FSM.json: {"start": "idle", "states": {"idle": {"val": "idle", "next": "think"},
                                         "think": {"val": "fsm.json#/states/think/body", "body": {"argv": [...], ...}, "next": "act"}, ...}}
val＝字串（aos-exec 的目標，每拍 `aos-exec -- <val>`）或陣列 [目標, 參數...]（每拍 `aos-exec -- 目標 參數...`，元素都要是字串；
比照 loop 的 run，10-21 傍晚）；相對路徑從 cwd 算，fsm 不轉（F2）；要內嵌單子就寫
`fsm.json#/states/<名>/body`、單子放在同一格的 body，由 aos-exec 在它自己的行程裡跑（逾時與訊號打整群，N-59）。
val 是物件或別的＝表壞。表裡其他 key（body、_exec…）忽略（C-48），所以 fsm.json 可以帶 `"_exec": ["aos-fsm", {"$env": "AOS_CF"}]`
當 aos-exec 的入口（F6）。
開跑時（讀表後、跑格前）先查整張表（10-22）：start 要在表上；每一格要是 {"val", "next"}、val 合法、next 要是表上的狀態名、
不能是空字串、頭尾不能有空白、不能有換行——哪一格不合都＝表壞、不跑格（原本只查這拍那一格：next 不在表上要到下一拍才擋，
next 是空字串則下一拍靜靜回 start）。
讀 $AOS_STACK/state（純文字一行狀態名、去頭尾空白；沒有檔或內容是空的＝start，格式與 shell 版相同；10-22 起在但讀不了
〔沒權限、是資料夾、不是 UTF-8…〕＝自己的錯，原本沒權限、是資料夾當沒有檔、從 start 起，不是 UTF-8 吐 traceback；
裡面的狀態不在表上＝自己的錯；寫的時候先寫 .state 再改名，N-05）；查格；跑格。
每拍在 $AOS_STACK/trace.jsonl 追加一行 {"at","state","code","signal","ms"}（at＝這拍開始的 UTC 時間；沒有 timed_out：
fsm 看不到格裡有沒有逾時，C-52；被逾時收掉的格是 code 143（128＋15）、signal null——
格是 aos-exec 子行程，它收掉單子後以子程式的碼正常結束，不是自己被訊號殺掉；F4；10-22 實測更正，原寫 signal 15）。
結束碼 0 才把 next 寫進 state；以那格的碼退出（10 與其他非 0 原樣往上，狀態都不動）。
只看格的結束碼，不讀格的 stdout、不轉述格的 stderr。PATH 不動。
收到 SIGINT／SIGTERM／SIGHUP：轉給那格（那個 aos-exec 子行程），等格結束，trace 與 state 照常寫完，
再以 128＋N 結束；跑格之前就收到＝不跑、直接 128＋N（P-36；對齊 impls 的 aos-fsm，ideas § 24）。自己的錯（usage、沒設 AOS_STACK、
表壞、state 讀不了、查不到格、起不了 aos-exec）退 1，stderr 一行 `aos-fsm: 代號 原因`（代號 10-23 照 impls：Usage、StackMissing、
設定檔 ReadFailed／JsonSyntax／FieldType、表壞 FieldType、state 讀不了 ReadFailed、state 不在表上 StateUnknown、起不了 aos-exec LaunchFailed）。"""
import datetime, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_beat, aos_flags

USAGE = "aos-fsm [旗標] 設定檔.json"   # 旗標表是空的也寫 [旗標]，跟 aos-loop、aos-tick 同一個寫法（10-22）
FLAGS = {}   # 目前沒有旗標；以後加旗標就在這裡加一列


def die(code, msg):
    print(f"aos-fsm: {code} {msg}", file=sys.stderr)
    sys.exit(1)


def check(start, states):
    """10-22：開跑時（讀表後、跑格前）查整張表，回 {狀態名: (目標, [參數...])}；哪裡不合＝表壞、die。
    start 要在表上；每一格要是 {"val", "next"}、val 要是 aos-exec 的目標（字串或字串陣列）、
    next 要是表上的狀態名、不能是空字串、頭尾不能有空白、不能有換行（state 檔是純文字一行、讀回來會去頭尾空白，
    寫進去要讀得回同一個名字）。"""
    if start not in states:
        die("FieldType", f"start 的 {start} 不在表上")
    targets = {}
    for name, cell in states.items():
        if not (isinstance(cell, dict) and "val" in cell and isinstance(cell.get("next"), str)):
            die("FieldType", f"狀態 {name} 要是 {{\"val\", \"next\"}}（next 是狀態名字串）")
        nxt = cell["next"]
        if not nxt or nxt != nxt.strip() or "\n" in nxt:
            die("FieldType", f"狀態 {name} 的 next {json.dumps(nxt, ensure_ascii=False)} 不能是空字串、頭尾不能有空白、不能有換行")
        if nxt not in states:
            die("FieldType", f"狀態 {name} 的 next {nxt} 不在表上")
        if isinstance(cell["val"], dict):
            die("FieldType", f"狀態 {name} 的 val 要是 aos-exec 的目標（字串或字串陣列）；要內嵌單子寫 fsm.json#/states/{name}/body")
        try:
            targets[name] = aos_flags.target(cell["val"], f"狀態 {name} 的 val")
        except aos_flags.Error as e:
            die(e.code, str(e))
    return targets


def main():
    aos_beat.block()
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], FLAGS)
    except aos_flags.Error as e:
        die("Usage", f"usage: {USAGE}（{e}）")
    if len(rest) != 1:
        die("Usage", f"usage: {USAGE}（%s）" % ("沒有設定檔" if not rest else f"設定檔只能一個，多給了 {rest[1]}"))
    path = rest[0]
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "沒設定 AOS_STACK")
    try:
        cfg = aos_flags.load_cfg(path)
    except aos_flags.Error as e:
        die(e.code, str(e))
    states = cfg.get("states") if isinstance(cfg, dict) else None
    if not isinstance(states, dict) or not isinstance(cfg.get("start"), str):
        die("FieldType", 'fsm.json 要是 {"start": 狀態名, "states": {名: {"val", "next"}}}')
    targets = check(cfg["start"], states)   # 10-22：開跑時查整張表，哪一格壞都不跑
    sfile = os.path.join(stack, "state")
    try:
        with open(sfile, encoding="utf-8") as f:
            state = f.read().strip() or cfg["start"]
    except FileNotFoundError:   # 沒有檔＝從 start 起
        state = cfg["start"]
    except UnicodeDecodeError:   # 10-22：在但讀不了＝自己的錯
        die("ReadFailed", f"讀不了 {sfile}：不是 UTF-8")
    except OSError as e:
        die("ReadFailed", f"讀不了 {sfile}：{e.strerror or e}")
    if state not in states:
        die("StateUnknown", f"查不到狀態 {state}（{sfile} 裡的狀態不在表上）")
    cell = states[state]
    val, args = targets[state]
    if aos_beat.take():
        sys.exit(128 + aos_beat.take())
    at = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    try:
        res = aos_beat.run(val, args)
    except aos_beat.StartError as e:
        die(e.code, f"狀態 {state}：{e}")
    with open(os.path.join(stack, "trace.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"at": at, "state": state, "code": res["code"], "signal": res["signal"],
                            "ms": res["ms"]}, ensure_ascii=False) + "\n")
    if res["code"] == 0:
        tmp = os.path.join(stack, ".state")   # N-05：先寫 . 開頭的暫存檔再改名蓋過去，讀的人不會讀到半份
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(cell["next"] + "\n")
        os.replace(tmp, sfile)
    if res["received"]:
        sys.exit(128 + res["received"])
    sys.exit(res["code"])


main()
