#!/usr/bin/env python3
"""aos-fsm --cfg FSM.json — fsm 一拍只跑一格（10-21 plan § 4）。
命令列只有 `--cfg 檔`（或 `--cfg=檔`；規則同 aos-exec，aos_flags）：沒給、多給位置參數、不認得的旗標＝usage 錯（F1）。
FSM.json: {"start": "idle", "states": {"idle": {"val": "idle", "next": "think"},
                                         "think": {"val": "fsm.json#/states/think/body", "body": {"argv": [...], ...}, "next": "act"}, ...}}
val 只收字串＝aos-exec 的目標（每拍 `aos-exec -- <val>`，相對路徑從 cwd 算，fsm 不轉；F2）；要內嵌單子就寫
`fsm.json#/states/<名>/body`、單子放在同一格的 body，由 aos-exec 在它自己的行程裡跑（逾時與訊號打整群，N-59）。
val 是物件＝表壞。表裡其他 key（body、_exec…）忽略（C-48），所以 fsm.json 可以帶 `"_exec": ["aos-fsm", "--cfg", "fsm.json"]`
當 aos-exec 的入口（F6）。
讀 $AOS_STACK/state（純文字一行狀態名；沒有＝start，格式與 shell 版相同；寫的時候先寫 .state 再改名，N-05）；查格；跑格。
每拍在 $AOS_STACK/trace.jsonl 追加一行 {"at","state","code","signal","ms"}（at＝這拍開始的 UTC 時間；沒有 timed_out：
fsm 看不到格裡有沒有逾時，C-52，被逾時收掉的格是 code 128＋15、signal 15；F4）。
結束碼 0 才把 next 寫進 state；以那格的碼退出（10 與其他非 0 原樣往上，狀態都不動）。
只看格的結束碼，不讀格的 stdout、不轉述格的 stderr。PATH 不動。
收到 SIGINT／SIGTERM／SIGHUP：轉給那格（那個 aos-exec 子行程），等格結束，trace 與 state 照常寫完，
再以 128＋N 結束；跑格之前就收到＝不跑、直接 128＋N（P-36；對齊 impls 的 aos-fsm，ideas § 24）。自己的錯（usage、沒設 AOS_STACK、
表壞、查不到格、起不了 aos-exec）退 1，stderr 一行 `aos-fsm: 原因`。"""
import datetime, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_beat, aos_flags

USAGE = "aos-fsm --cfg fsm.json"


def die(msg):
    print(f"aos-fsm: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    aos_beat.block()
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], {"--cfg": "cfg"})
    except aos_flags.Error as e:
        die(f"usage: {USAGE}（{e}）")
    if rest:
        die(f"usage: {USAGE}（不收位置參數：{rest[0]}）")
    path = opts.get("cfg")
    if path is None:
        die(f"usage: {USAGE}（沒有 --cfg）")
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("沒設定 AOS_STACK")
    try:
        cfg = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError) as e:
        die(f"讀不到或不是 JSON：{path}（{e}）")
    states = cfg.get("states") if isinstance(cfg, dict) else None
    if not isinstance(states, dict) or not isinstance(cfg.get("start"), str):
        die('fsm.json 要是 {"start": 狀態名, "states": {名: {"val", "next"}}}')
    sfile = os.path.join(stack, "state")
    try:
        state = open(sfile, encoding="utf-8").read().strip() or cfg["start"]
    except OSError:
        state = cfg["start"]
    cell = states.get(state)
    if not (isinstance(cell, dict) and "val" in cell and isinstance(cell.get("next"), str)):
        die(f"查不到狀態 {state}（或它不是 {{\"val\", \"next\"}}）")
    val = cell["val"]
    if not isinstance(val, str):
        die(f"狀態 {state} 的 val 要是 aos-exec 的目標（字串）；要內嵌單子寫 {path}#/states/{state}/body")
    if aos_beat.take():
        sys.exit(128 + aos_beat.take())
    at = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
    try:
        res = aos_beat.run(val)
    except aos_beat.StartError as e:
        die(f"狀態 {state}：{e}")
    with open(os.path.join(stack, "trace.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps({"at": at, "state": state, "code": res["code"], "signal": res["signal"],
                            "ms": res["ms"]}, ensure_ascii=False) + "\n")
    if res["code"] == 0:
        tmp = os.path.join(stack, ".state")   # N-05：先寫 . 開頭的暫存檔再改名蓋過去，讀的人不會讀到半份
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(cell["next"] + "\n")
        os.replace(tmp, sfile)
    if res["received"]:
        sys.exit(128 + res["received"])
    sys.exit(res["code"])


main()
