{"summary": "黏合格：check 定稿後把 brief、定稿、benchmarks/<id>.json 正解交給 tools/critic 打語意分，和 check 的 Tier 0／1 合成 score.json（0～6）；沒定稿或已打分就什麼都不做",
 "time_ms": {"val": 7500, "max": 300000},
 "resource": ["llm", "cpu"],
 "llm_calls": {"val": 1, "max": 1},
 "llm_tokens": {"val": 2200, "max": 4500},
 "llm_endpoint": "http://localhost:4000/v1",
 "llm_model": "chatgpt-gpt-6-luna-low",
 "side_effect": true,
 "idempotent": false,
 "deterministic": false,
 "interrupt": "resumable",
 "parallel": false,
 "reads": ["$AOS_STACK/check.json", "$AOS_STACK/brief.json", "$AOS_STACK/draft.json", "benchmarks/<id>.json"],
 "writes": ["$AOS_STACK/score.json", "$AOS_STACK/critic/（critic 的小格與工作區，每次清掉重來；含 llm.jsonl）"],
 "grow_level": 4,
 "calls": ["tools/critic（單發腦函數，grow_level 4：_entry 單子＋ask.py）"],
 "tier": "評分級聯 Tier 2（LLM judge，受治理：程式算的語域分與它給的對照、不合就是訊號）",
 "note": "llm_* 等於 tools/critic 的（M6 外層贏）"}
