{"summary": "自我優化 host（agent-dan 形：loop→fsm idle→think→act）：工作區＝訓練場，new/<n>.json 是 {node, goal, evidence, 預算}；agent 節點就用它自己的 system.txt／模型＋優化模式說明，非 agent 節點臨時配這個腦；掛 selfopt 工具包讓它自己改自己（只在訓練場的 tree/ 複本），收工寫 selfopt/<n>/report.json",
 "time_ms": {"val": 60000, "max": 3600000},
 "resource": ["llm", "cpu"],
 "llm_calls": {"val": 6, "max": 20},
 "llm_tokens": {"val": 15000, "max": 60000},
 "llm_endpoint": "http://localhost:4000/v1",
 "llm_model": "chatgpt-gpt-6-luna-low（agent 節點時用該節點 .env 的模型）",
 "side_effect": true,
 "idempotent": false,
 "deterministic": false,
 "interrupt": "resumable",
 "parallel": false,
 "lock": [{"$env": "AOS_STACK", "$prefix": "stack:"}],
 "reads": ["$AOS_WS/new/*.json", "$AOS_WS/cur/*.json", "$AOS_WS/tree/<node>/{system.txt,.env,_metainfo,fsm.json}", "system.txt", "tools/*/_tooldef.json"],
 "writes": ["$AOS_WS/selfopt/<n>/{session.json,report.json,tests/}", "$AOS_WS/out/<n>.txt", "$AOS_WS/done/", "$AOS_WS/tree/<node>/（經工具包，白名單）", "$AOS_STACK/{history.jsonl,current.txt,state.txt,trace.jsonl,llm.jsonl}"],
 "grow_level": 5,
 "shape": "demo/agent-dan（idle→think→act）",
 "calls": ["tools/read_self", "tools/read_runs", "tools/edit_self", "tools/extract_tool", "tools/run_self_test", "tools/note"],
 "subtrees": [{"path": "tools/read_self", "via": "link"}, {"path": "tools/read_runs", "via": "link"}, {"path": "tools/edit_self", "via": "link"},
              {"path": "tools/extract_tool", "via": "link"}, {"path": "tools/run_self_test", "via": "link"}, {"path": "tools/note", "via": "link"}],
 "uses_llm": true,
 "lifecycle": {"stage": "agent", "counter_steps_tooled": 0, "counter_steps_total": 1, "brain_decides": ["改什麼、怎麼改、要不要自測、何時收工"]}}
