#!/usr/bin/env python3
# extract_tool - 抽工具（plan/round6.md §1b，impl pure）：在自己的 tools/<name>/ 建一個純函數殼（rules_shell.py＝照 rules.json 做正規式替換）＋你給的規則表
# 介面：stdin {"name": 工具名（小寫英數底線）, "step": 交給它的那個環節（一句）, "why": 為什麼抽, "rules": [{"pattern", "replace", "max_count"?, "note"?}]}
#   → stdout 一行 JSON {tool, files, system_txt_line?, lifecycle}。
# 做的事（照 §1b ①～④）：① tools/<name>/{_entry（殼）, rules.json, _tooldef.json, _metainfo（宣告由程式生成）}；② tools/ 沒有就建（帶 _metainfo）；登記進自己的 tools.json（相對路徑 tools/<name>，沒有就建）；
#   ③ 自己有 system.txt 就加一句「<step>：交給工具 <name>（text＝整段稿子），不要自己做。」；④ _metainfo.lifecycle 的 tools[<name>]、counter_steps_tooled +1。
#   改 system.txt 與 _metainfo 前先存 versions/selfopt_<session>/（同 edit_self）。impl agent 這版不做（ArgumentsBad）。
# 邊界同 edit_self（ScopeBad、FrozenBad；tools/<name>/ 是新建、不經白名單）。已有同名工具＝ToolBad（不蓋）。
# 錯：SessionMissing／SessionBad、WsMissing、TreeMissing、NodeMissing、BudgetBad、ArgumentsBad、ScopeBad、FrozenBad、ToolBad、RulesBad。
import json, os, re, shutil, sys

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(HERE))
import guard  # noqa: E402


def main(args, ctx):
    name, step, why, rules = args.get("name"), args.get("step"), args.get("why"), args.get("rules")
    if args.get("impl", "pure") != "pure":
        raise guard.Fail("ArgumentsBad", "這版只抽 impl pure（規則表殼）")
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9_]{1,30}", name):
        raise guard.Fail("ArgumentsBad", "name 要是小寫英數底線、2～31 字")
    if not isinstance(step, str) or not step.strip() or not isinstance(why, str) or not why.strip():
        raise guard.Fail("ArgumentsBad", "step、why 要是非空字串")
    if not isinstance(rules, list) or not rules:
        raise guard.Fail("RulesBad", "rules 要是非空陣列")
    for i, r in enumerate(rules, 1):
        try:
            re.compile(r["pattern"])
            if not isinstance(r["replace"], str) or not isinstance(r.get("max_count", 0), int):
                raise TypeError("replace 要字串、max_count 要整數")
        except (KeyError, TypeError, re.error) as e:
            raise guard.Fail("RulesBad", "第 %d 條規則壞：%s" % (i, e))
    tdir, tnorm = ctx.resolve_write(os.path.join("tools", name), whitelist=False)
    if os.path.lexists(tdir):
        raise guard.Fail("ToolBad", "tools/%s 已經有了（不蓋；要改規則用 edit_self 改 tools/%s/rules.json）" % (name, name))
    home = os.path.realpath(ctx.node_dir)
    files = []
    tj = os.path.join(home, "tools.json")
    reg = guard.jload(tj, None) if os.path.isfile(tj) else {"tools": {}}
    if not isinstance(reg, dict) or not isinstance(reg.get("tools"), dict):
        raise guard.Fail("ToolBad", "tools.json 讀不了或不是 {\"tools\": {…}}")
    if name in reg["tools"]:
        raise guard.Fail("ToolBad", "tools.json 已經登記了 %s（不蓋）" % name)
    tools_dir = os.path.join(home, "tools")
    if not os.path.isdir(tools_dir):
        os.makedirs(tools_dir)
        guard.write_json(os.path.join(tools_dir, "_metainfo"), {"summary": "這個節點的工具（selfopt extract_tool 建的）", "kind": "dir"})
        files.append("tools/_metainfo")
    ctx.save_version(tdir, tnorm)                 # 記 created
    os.makedirs(tdir)
    shutil.copy(os.path.join(HERE, "rules_shell.py"), os.path.join(tdir, "_entry"))
    with open(os.path.join(tdir, "_entry"), encoding="utf-8") as f:
        src = f.read().replace("# NAME - ", "# %s - " % name, 1)
    guard.write_text(os.path.join(tdir, "_entry"), src)
    os.chmod(os.path.join(tdir, "_entry"), 0o755)
    guard.write_json(os.path.join(tdir, "rules.json"), rules)
    guard.write_json(os.path.join(tdir, "_tooldef.json"), {
        "description": "%s（純函數，照規則表做；回 {text: 改後的稿, changes}，交稿時原樣交出 text）" % step.strip(),
        "parameters": {"type": "object", "properties": {"text": {"type": "string", "description": "整段原文"}}, "required": ["text"]}})
    guard.write_meta(tdir, {"summary": "純函數（selfopt extract_tool 抽的）：%s" % step.strip(),
                            "time_ms": {"val": 40, "max": 2000}, "resource": "cpu", "side_effect": False, "idempotent": True,
                            "deterministic": True, "interrupt": "safe", "parallel": True,
                            "reads": ["stdin {text}", "rules.json"], "writes": [], "grow_level": 3, "uses_llm": False,
                            "lifecycle": {"stage": "pure", "counter_steps_tooled": 1, "counter_steps_total": 1, "brain_decides": []},
                            "extracted": {"by": "selfopt", "session": ctx.session["session"], "why": why.strip()}})
    files += ["tools/%s/%s" % (name, n) for n in ("_entry", "rules.json", "_tooldef.json", "_metainfo")]
    ctx.save_version(tj, "tools.json")       # 登記進自己的 tools.json（10-28 aos-tools：腦只看得到登記的）；相對路徑＝搬家不斷；改前存版本（回滾一起回）
    reg["tools"][name] = {"path": "tools/" + name}
    guard.write_json(tj, reg)
    files.append("tools.json")
    out = {"tool": "tools/" + name, "files": files}
    sp = os.path.join(home, "system.txt")
    if os.path.isfile(sp):
        ctx.save_version(sp, "system.txt")
        with open(sp, encoding="utf-8") as f:
            text = f.read()
        line = "%s：交給工具 %s（text＝整段稿子），不要自己做。" % (step.strip().rstrip("。"), name)
        guard.write_text(sp, text.rstrip("\n") + "\n" + line + "\n")
        out["system_txt_line"] = line
    ctx.save_version(os.path.join(home, "_metainfo"), "_metainfo")
    meta = guard.read_meta(home)
    lc = meta.setdefault("lifecycle", {"stage": "agent", "counter_steps_tooled": 0, "counter_steps_total": 1, "brain_decides": []})
    lc.setdefault("tools", {})[name] = {"since_round": ctx.session.get("round"), "why": why.strip(), "stage": "pure", "by": "selfopt"}
    lc["counter_steps_tooled"] = lc.get("counter_steps_tooled", 0) + 1
    lc["counter_steps_total"] = max(lc.get("counter_steps_total", 0), lc["counter_steps_tooled"])
    if lc.get("stage") == "agent":
        lc["stage"] = "tools"
    guard.write_meta(home, meta)
    out["lifecycle"] = {k: lc.get(k) for k in ("stage", "counter_steps_tooled", "counter_steps_total")}
    ctx.record_edit("tools/" + name, "extract_tool", step=step.strip())
    return out


guard.tool_main("extract_tool", main)
