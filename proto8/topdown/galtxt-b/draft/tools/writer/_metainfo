{"summary": "寫稿的 agent：工作區 new/<n>.json 是稿紙＋beat 表（第 2 稿起附打回理由），問腦寫一稿，可叫 lint 自檢（最多兩次），答案寫 out/<n>.txt；同一個 stack 再叫＝接著上一稿聊",
 "time_ms": {"val": 10000, "max": 400000},
 "resource": ["llm", "cpu"],
 "llm_calls": {"val": 1, "max": 3},
 "llm_tokens": {"val": 3000, "max": 11000},
 "llm_endpoint": "http://localhost:4000/v1",
 "llm_model": "chatgpt-gpt-6-luna-low",
 "side_effect": true,
 "idempotent": false,
 "deterministic": false,
 "interrupt": "resumable",
 "parallel": true,
 "lock": [{"$env": "AOS_STACK", "$prefix": "stack:"}],
 "reads": ["$AOS_WS/new/*.json", "$AOS_WS/cur/*.json", "$AOS_WS/cur/<n>.json#/brief（經 lint）", "$AOS_STACK/history.jsonl", "system.txt"],
 "writes": ["$AOS_WS/out/<n>.txt", "$AOS_WS/done/", "$AOS_STACK/{history.jsonl,current.txt,state.txt,trace.jsonl,llm.jsonl}", "$AOS_STACK/lint/（lint 的小格，空的）"],
 "grow_level": 5,
 "shape": "demo/agent-dan（idle→think→act）",
 "calls": ["tools/lint"]}
