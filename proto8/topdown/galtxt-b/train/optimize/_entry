#!/usr/bin/env python3
# optimize - 優化器一步（plan/round6.md §4、§7-6）：提 2 條候選改動（白名單內）→ 叫判斷器挑一條 → 把它選的寫成 changes/<n>.json 交給 train/apply。
# 這一版的提案是程式（最便宜可行的那條路）：從訓練場 tree/ 的 _metainfo 推，不問腦。兩個提案器：
#   freeze_order：lifecycle.stage 是 tools 的節點，rollup.measured.tools.<工具> 腦叫的比率 ≥ 90%、工具是純程式、tool.json 宣告 returns: text
#     （回的 text 能直接當稿交；lint 這種回意見的不行）、還沒固化 → 交稿前一律由 act 叫、不再給腦。
#   patch_act（default_args）：rollup.measured.tools.<工具>.counter_argbad > 0、tool.json 有 brief_path、還沒補 → act 補 brief_path＝cur/{name}.json#/brief。
#   $AOS_WS/proposals/<n>.json {"candidates": [{"move", "stats"?, "evidence"?}]} 在＝用它（外面給的候選，例：隊長照量測給的兩條），不跑提案器；
#   stats（{counter_runs, counter_runs_called, counter_calls, counter_argbad, counter_noop, tokens_saved}）蓋過 _metainfo 量到的數字。
# 預期梯度（形狀同 changes.gradient，交給判斷器）：
#   每次省的 token：stats.tokens_saved 有給用它；freeze_order 看 lifecycle.history 裡抽這個工具那步的 before／after writer_tokens_mean（多花的＝固化後省回的）；
#   都沒有＝每次問腦的平均 token（rollup.measured.llm_tokens ÷ llm_calls）× 這個工具每次跑多出的來回（freeze：叫它的次數÷跑數；patch：ArgumentsBad 次數÷跑數）。
#   節點與根的 rollup.measured.llm_tokens／llm_calls 各一條 delta；freeze 另列 lifecycle.tools.<工具>.frozen_order（from null）、patch 列 counter_argbad → 0；
#   根的 ratings.<風格>.counter_violations 預期不變（delta 0，freeze 後工具照跑）。
# 只有 1 條＝不問判斷器、直接交；0 條＝什麼都不寫。changes/<n>.json 已在＝這輪提過了，退 0（idempotent）。
# 判斷器：$AOS_WS/arbiter（train/init 複製的那份；record 在那份記 ratings.judgments、固化 priority_rules.json），小格 $AOS_STACK/arbiter/<n>/（每次清掉、單發）。
#   腦照呼叫者的 AOS_BRAIN_URL（沒給＝假腦固定選 a）。
# 寫 changes/<n>.json：{"round", "moves": [被選的那條], "candidates": [{"label", "move", "expected", "evidence"}], "arbiter": {better, why, weights_used, by, counter_tokens, asked_at}, "proposed_by"}。
# 自己的錯一行 stderr「optimize: 代號 原因」退 1：StackMissing、RoundMissing／RoundBad、TreeMissing、ArbiterMissing、ArbiterFailed。
import json, os, shutil, subprocess, sys
from datetime import datetime, timezone

MIN_ORDER_RATIO = 0.9


def die(code, reason):
    print("optimize: %s %s" % (code, reason), file=sys.stderr)
    sys.exit(1)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def jload(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, obj):                      # N-05
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def all_metas(tree):
    out = {}
    for d, dirs, files in os.walk(tree):
        dirs[:] = sorted(x for x in dirs if x not in ("versions", "__pycache__") and not os.path.islink(os.path.join(d, x)))
        if "_metainfo" in files:
            m = jload(os.path.join(d, "_metainfo"))
            if isinstance(m, dict):
                rel = os.path.relpath(d, tree)
                out["." if rel == "." else rel.replace(os.sep, "/")] = m
    return out


def num(x, default=0):
    return x if isinstance(x, (int, float)) and not isinstance(x, bool) else default


def measured(meta):
    return ((meta.get("rollup") or {}).get("measured") or {}) if isinstance(meta.get("rollup"), dict) else {}


# ── 提案器（純函數，測試直接叫）────────────────────────────────

def propose(tree, metas):
    out = []
    for node, meta in sorted(metas.items()):
        tools = measured(meta).get("tools") or {}
        if not isinstance(tools, dict) or meta.get("frozen"):
            continue
        rules = jload(os.path.join(tree, node, "act_rules.json"), {}) or {}
        for t, s in sorted(tools.items()):
            tmeta = metas.get("%s/tools/%s" % (node, t)) or jload(os.path.join(tree, node, "tools", t, "_metainfo"), {}) or {}
            runs, called = num(s.get("counter_runs")), num(s.get("counter_runs_called"))
            spec = jload(os.path.join(tree, node, "tools", t, "tool.json"), {}) or {}
            if ((meta.get("lifecycle") or {}).get("stage") == "tools" and runs and called / runs >= MIN_ORDER_RATIO
                    and tmeta.get("uses_llm") is False and spec.get("returns") == "text" and t not in (rules.get("after_answer") or [])):
                out.append({"move": {"kind": "freeze_order", "node": node, "tool": t,
                                     "why": "腦叫 %s %d/%d 次（≥ 90%%）%s" % (t, called, runs, "、其中 %d 次沒改字" % s["counter_noop"] if s.get("counter_noop") else "")},
                            "stats": s})
            if (num(s.get("counter_argbad")) > 0 and "brief_path" in ((spec.get("parameters") or {}).get("properties") or {})
                    and t not in (rules.get("default_args") or {})):
                out.append({"move": {"kind": "patch_act", "node": node, "tool": t, "patch": "default_args",
                                     "args": {"brief_path": "cur/{name}.json#/brief"},
                                     "why": "腦叫 %s 漏參數 %d 次／%d 次跑（ArgumentsBad 白跑一趟）" % (t, s["counter_argbad"], runs)},
                            "stats": s})
    return out


def tokens_saved(move, meta, stats):
    if num(stats.get("tokens_saved"), None) is not None:
        return float(stats["tokens_saved"]), "量測給的每次差"
    m = measured(meta)
    per_call = num(m.get("llm_tokens")) / num(m.get("llm_calls"), 1) if num(m.get("llm_calls")) else num((meta.get("llm_tokens") or {}).get("val"))
    runs = num(stats.get("counter_runs"), 1) or 1
    if move["kind"] == "freeze_order":
        for h in reversed((meta.get("lifecycle") or {}).get("history") or []):
            if h.get("move") == "extract_tool:%s" % move["tool"]:
                b, a = (h.get("before") or {}).get("writer_tokens_mean"), (h.get("after") or {}).get("writer_tokens_mean")
                if num(b, None) is not None and num(a, None) is not None and a > b:
                    return float(a - b), "lifecycle.history extract_tool:%s 前後 writer_tokens_mean %s→%s" % (move["tool"], b, a)
        return per_call * num(stats.get("counter_calls"), runs) / runs, "每次問腦平均 %.0f × 叫它的次數÷跑數" % per_call
    return per_call * num(stats.get("counter_argbad")) / runs, "每次問腦平均 %.0f × ArgumentsBad 次數÷跑數" % per_call


def expected(move, metas, stats):
    """一條候選的預期梯度（形狀同 changes.gradient）＋根據（字串列）。"""
    node = move["node"]
    meta, root = metas.get(node) or {}, metas.get(".") or {}
    saved, how = tokens_saved(move, meta, stats)
    runs = num(stats.get("counter_runs"), 1) or 1
    m, rm = measured(meta), measured(root)
    dcalls = -(num(stats.get("counter_calls"), runs) / runs if move["kind"] == "freeze_order" else num(stats.get("counter_argbad")) / runs)

    def line(frm, delta):
        return {"from": frm, "to": round(frm + delta, 3) if num(frm, None) is not None else None, "delta": round(delta, 3)}

    g = {node: {"rollup.measured.llm_tokens": line(num(m.get("llm_tokens"), None), -saved),
                "rollup.measured.llm_calls": line(num(m.get("llm_calls"), None), dcalls)},
         ".": {"rollup.measured.llm_tokens": line(num(rm.get("llm_tokens"), None), -saved)}}
    if move["kind"] == "freeze_order":
        g[node]["lifecycle.tools.%s.frozen_order" % move["tool"]] = {"from": None, "to": "act 交稿前一律叫"}
    else:
        g[node]["rollup.measured.tools.%s.counter_argbad" % move["tool"]] = line(num(stats.get("counter_argbad")), -num(stats.get("counter_argbad")))
    for style, r in sorted((root.get("ratings") or {}).items()):
        if isinstance(r, dict) and num(r.get("counter_violations"), None) is not None:
            g["."]["ratings.%s.counter_violations" % style] = line(r["counter_violations"], 0)
    ev = ["每次省 %.0f token（%s）" % (saved, how)]
    ev += ["%s＝%s" % (k, v) for k, v in sorted(stats.items()) if k != "tokens_saved"]
    return g, ev


# ── 判斷器 ─────────────────────────────────────────────────────

def ask_arbiter(ws, stack, n, question, env):
    adir = os.path.join(ws, "arbiter")
    if not os.path.isfile(os.path.join(adir, "_entry")):
        die("ArbiterMissing", "%s 沒有判斷器（先跑 train/init）" % adir)
    sub = os.path.join(stack, "arbiter", str(n)) + "/"
    shutil.rmtree(sub, ignore_errors=True)
    aws = os.path.join(sub, "ws")
    write_json(os.path.join(aws, "new", "1.json"), question)
    r = subprocess.run(["aos-exec", "--ws", aws, adir], env=dict(env, AOS_STACK=sub), stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        die("ArbiterFailed", "判斷器結束碼 %d" % r.returncode)
    verdict = jload(os.path.join(aws, "out", "1.txt"))
    if not isinstance(verdict, dict) or verdict.get("better") not in ("a", "b"):
        die("ArbiterFailed", "判斷器的答案不是 {better: a|b}")
    tokens = 0
    try:
        with open(os.path.join(sub, "llm.jsonl"), encoding="utf-8") as f:
            tokens = sum(int(json.loads(l).get("counter_tokens") or 0) for l in f if l.strip())
    except (OSError, ValueError):
        pass
    return dict(verdict, counter_tokens=tokens, asked_at=now())


def optimize(ws, stack, n, env):
    tree = os.path.join(ws, "tree")
    if not os.path.isfile(os.path.join(tree, "_metainfo")):
        die("TreeMissing", "%s 沒有 _metainfo（先跑 train/init）" % tree)
    cpath = os.path.join(ws, "changes", "%d.json" % n)
    if os.path.exists(cpath):
        return jload(cpath)
    metas = all_metas(tree)
    given = jload(os.path.join(ws, "proposals", "%d.json" % n))
    if isinstance(given, dict) and isinstance(given.get("candidates"), list):
        raw, by = [c for c in given["candidates"] if isinstance(c, dict) and isinstance(c.get("move"), dict)], "proposals/%d.json" % n
    else:
        raw, by = propose(tree, metas), "提案器（_metainfo）"
    cands = []
    for label, c in zip("ab", raw[:2]):
        stats = dict(measured(metas.get(c["move"].get("node")) or {}).get("tools", {}).get(c["move"].get("tool")) or {}, **(c.get("stats") or {}))
        g, ev = expected(c["move"], metas, stats)
        mv = dict(c["move"])
        if mv["kind"] == "freeze_order":
            mv.setdefault("evidence", {k: stats[k] for k in ("counter_runs", "counter_runs_called") if k in stats})
        cands.append({"label": label, "move": mv, "expected": g, "evidence": (c.get("evidence") or []) + ev})
    if not cands:
        return None
    change = {"round": n, "candidates": cands, "proposed_by": by, "proposed_at": now()}
    if len(cands) == 1:
        change.update(moves=[cands[0]["move"]], arbiter=None)
    else:
        node = cands[0]["move"].get("node")
        q = {"node": node if all(c["move"].get("node") == node for c in cands) else "、".join(c["move"].get("node", "") for c in cands),
             "a": {k: cands[0][k] for k in ("move", "expected", "evidence")}, "b": {k: cands[1][k] for k in ("move", "expected", "evidence")},
             "context": {"root_tokens_mean": measured(metas.get(".") or {}).get("llm_tokens"),
                         "ratings": {s: {k: r.get(k) for k in ("total_mean", "反差", "承接", "counter_violations")}
                                     for s, r in ((metas.get(".") or {}).get("ratings") or {}).items() if isinstance(r, dict)},
                         "noise_sigma_total": 0.58}}
        verdict = ask_arbiter(ws, stack, n, q, env)
        change.update(moves=[next(c["move"] for c in cands if c["label"] == verdict["better"])], arbiter=verdict)
    write_json(cpath, change)
    return change


if __name__ == "__main__":
    stack, ws = os.environ.get("AOS_STACK"), os.environ.get("AOS_WS", ".")
    if not stack:
        die("StackMissing", "沒設定 AOS_STACK")
    rj = jload(os.path.join(stack, "round.json"))
    if rj is None:
        die("RoundMissing", "$AOS_STACK/round.json 不在或不是 JSON")
    if not isinstance(rj, dict) or not isinstance(rj.get("round"), int):
        die("RoundBad", "round.json 要有整數 round")
    got = optimize(os.path.abspath(ws), os.path.abspath(stack), rj["round"], dict(os.environ))
    print(json.dumps({"moves": (got or {}).get("moves", []), "better": ((got or {}).get("arbiter") or {}).get("better")}, ensure_ascii=False))
