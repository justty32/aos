{"summary": "認領一題場景 JSON，查 tables/ 編成稿紙 brief.json（風格 style、人物卡、稱謂階、地點硬設定、禁語、開場收尾、few-shot 樣本（只給在場女角的）、beat 文法）；已有 brief.json 就什麼都不做",
 "time_ms": {"val": 60, "max": 2000},
 "resource": ["cpu", "disk"],
 "side_effect": true,
 "idempotent": true,
 "deterministic": true,
 "interrupt": "safe",
 "parallel": false,
 "reads": ["$AOS_WS/new/*.json", "$AOS_WS/cur/*.json", "tables/*.json"],
 "writes": ["$AOS_WS/cur/<題名>.json（從 new/ 搬來）", "$AOS_STACK/current.txt", "$AOS_STACK/brief.json"],
 "grow_level": 4,
 "tier": "固化階梯 1～3 級（查表、規則分支、模板），執行期零 LLM",
 "subtrees": [{"path": "tables", "kind": "data"}],
 "uses_llm": false,
 "responsible_for": ["語域", "護欄", "文筆"],
 "ablation": {"env": "GALTXT_OFF_SAMPLES", "off": "skip", "scope": "tables/samples.json", "note": "關掉＝brief.samples 空（不給語料錨）"}}
