#!/usr/bin/env python3
# opt_read - stdin {"path"}，stdout 檔內容（上限 50 KB，同 lib/read）；路徑從拷貝樹根算（例 writer/tools/voice/_entry）
# 拒讀 deny.json 的 read_deny（data/bench/ 正解、train/、proto8/tests）＝PathDenied；出了拷貝樹（../、絕對路徑、捷徑解開在外）＝PathBad。只讀；round4-selfopt.md § 1。
# 錯：stderr 與 stdout 各一行「opt_read: 代號 原因」、退 1——ArgumentsBad、EnvMissing、PathBad、PathDenied、FileMissing、TooBig。
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_read"
a = oc.args_in(NAME)
e = oc.env(NAME)
p, rel = oc.resolve(NAME, e["tree"], a.get("path"))
if os.path.isdir(p):
    print("\n".join(sorted(n + ("/" if os.path.isdir(os.path.join(p, n)) else "") for n in os.listdir(p) if n != "__pycache__")))
    sys.exit(0)
try:
    with open(p, "rb") as f:
        data = f.read(oc.MAX_BYTES + 1)
except FileNotFoundError:
    oc.die(NAME, "FileMissing", "%s 不存在" % rel)
except OSError as x:
    oc.die(NAME, "FileMissing", "%s 讀不了：%s" % (rel, x))
if len(data) > oc.MAX_BYTES:
    oc.die(NAME, "TooBig", "%s 超過 %d KB" % (rel, oc.MAX_BYTES // 1024))
sys.stdout.write(data.decode("utf-8", "replace"))
