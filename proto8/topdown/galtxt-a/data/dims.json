                      "洩底":   {"by": "tools/lint", "weight": 1, "modes": ["scene"], "moved_by": ["writer"], "cells": ["cast.yuzu.gesture.*[reveal]", "style.tsun.reveal.*"]}}},
 "question_dims": {"多樣性": {"by": "pick", "moved_by": ["."]}, "一致": {"by": "pick", "only": "hints_fixed", "moved_by": ["writer"]}},
