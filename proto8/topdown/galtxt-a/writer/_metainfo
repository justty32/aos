{"summary": "寫手：照 brief 寫一份台詞（整場 5～10 行，或挖空的那一行），交稿前用 lint 自檢；照 stage.json 分三階——agent／semi 跑 aos-loop（腦，semi 多看得到 beat／voice）、program 跑 compose.py（模板＋工具、腦 0 次，接不住記 hard.jsonl）",
 "kind": "agent", "grow_level": 5,
 "time_ms": {"val": 15000, "max": 720000},
 "resource": ["llm", "cpu"],
 "llm_calls": {"val": 2, "max": 4}, "llm_tokens": {"val": 6000, "max": 50000},
 "llm_model": "chatgpt-gpt-6-luna-low（.env）", "llm_endpoint": "AOS_BRAIN_URL；沒設＝假腦（模板填槽；假腦技能表：傲嬌弱）",
 "side_effect": true, "idempotent": false, "deterministic": false, "interrupt": "resumable", "parallel": true,
 "lock": [{"$env": "AOS_WS", "$prefix": "ws:"}],
 "reads": ["ws:new/*.json", "ws:rules.json（經 lint）", "data:templates.json（program 階）", "data:templates.distilled.json（program 階）", "data:hints.json（program 階）", "data:cast/yuzu.json（program 階，口癖格）", "data:scene/closeup.json（program 階，道具格）"],
 "writes": ["ws:out/<題名>", "ws:done/<題名>.json", "stack:history.jsonl", "stack:usage.jsonl", "stack:state.txt", "stack:current.txt", "stack:trace.jsonl", "cell:lint/", "cell:beat/", "cell:voice/", "tree:writer/hard.jsonl（program 階）"],
 "fs_needs": ["own_stack", "mount"], "callers": 1,
 "steps": ["開場旁白", "反差節拍", "口癖句尾", "遮掩句", "收尾旁白", "自檢"],
 "children": {"tools/beat/": "反差節拍（反差節拍、遮掩句）", "tools/voice/": "口癖句尾", "tools/lint": "捷徑 → ../../tools/lint（自檢）"},
 "opt_writes": ["system.txt", "stage.json#/tools", "tools/*/", "compose.py", "../data/templates.distilled.json#append"],
 "ratings": {"$ref": "ratings.json"},
 "brain": {"$ref": "stage.json"},
 "human_ratings": {"$ref": "human.json"},
 "grad": {"$ref": "grad.json"},
 "rollup": {"$ref": "rollup.json"}}
