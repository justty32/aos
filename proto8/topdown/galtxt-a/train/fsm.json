{"_entry": ["aos-fsm", {"$env": "AOS_CF"}],
 "start": "verify",
 "states": {"verify": {"exec": {"argv": ["python3", "verify.py"],
                              "timeout_ms": 600000,
                              "_metainfo": {"summary": "驗證題各一題照路由跑根（aos-exec --ws 小格/ws ..）、算分、跟上一個 epoch 比、把差值記進 optimize/ratings.json；退步＝回滾 data/route.json 退 10；到 max_epochs 退 10；預算到頂退 2",
                                           "kind": "program", "grow_level": 0,
                                           "time_ms": {"val": 60000, "max": 600000},
                                           "resource": ["llm", "cpu"],
                                           "llm_calls": {"val": 18, "max": 36},
                                           "side_effect": true, "idempotent": true, "deterministic": false,
                                           "interrupt": "resumable", "parallel": false,
                                           "reads": ["tree:set.json", "tree:budget.json", "tree:../plan/examples/*.json", "tree:../data/route.json",
                                                    "stack:epoch.txt", "stack:epochs/NNN-1/verify.json", "stack:epochs/NNN/params/"],
                                           "writes": ["stack:epochs/NNN/verify/", "stack:epochs/NNN/verify.json", "stack:verify.jsonl",
                                                     "stack:epoch.txt", "stack:started_at.json", "tree:optimize/ratings.json", "tree:../data/route.json（只在回滾時）",
                                                     "tree:../ratings.json", "tree:../rollup.json（meta/rollup）"],
                                           "state_key": "stack:epochs/NNN/verify.json",
                                           "fs_needs": [], "callers": 1}},
                     "next": "train"},
            "train": {"exec": {"argv": ["python3", "train.py"],
                             "timeout_ms": 1200000,
                             "_metainfo": {"summary": "set.json 的訓練題 × writers 每個強制跑一次（題目 JSON 加 writer）；每題之前看預算",
                                          "kind": "program", "grow_level": 0,
                                          "time_ms": {"val": 120000, "max": 1200000},
                                          "resource": ["llm", "cpu"],
                                          "llm_calls": {"val": 36, "max": 72},
                                          "side_effect": false, "idempotent": true, "deterministic": false,
                                          "interrupt": "resumable", "parallel": false,
                                          "reads": ["tree:set.json", "tree:budget.json", "tree:../plan/examples/*.json", "stack:epoch.txt", "stack:epochs/"],
                                          "writes": ["stack:epochs/NNN/runs/<題名>-<寫手>/{ws,stack}", "stack:epochs/NNN/usage.json"],
                                          "fs_needs": [], "callers": 1}},
                    "next": "rate"},
            "rate": {"exec": {"argv": ["python3", "rate.py"],
                            "timeout_ms": 10000,
                            "_metainfo": {"summary": "收 stack 的訓練題 score.json → 各寫手 ratings.json（含 dims）；human/samples.json 不在時挑人評樣本",
                                         "kind": "program", "grow_level": 0,
                                         "time_ms": {"val": 100, "max": 10000},
                                         "resource": ["cpu", "disk"],
                                         "side_effect": true, "idempotent": true, "deterministic": true,
                                         "interrupt": "safe", "parallel": false,
                                         "reads": ["stack:epochs/*/runs/*/ws/out/*/score.json", "stack:epochs/NNN/runs/*/stack/{brief.json,drafts/}",
                                                  "stack:epochs/NNN-1/verify/", "tree:../writer*/ratings.json"],
                                         "writes": ["tree:../writer*/ratings.json", "tree:../grader/ratings.json", "tree:../human/samples.json（不在時）",
                                                   "tree:../{writer*,grader,.}/rollup.json（meta/rollup --up）"],
                                         "fs_needs": [], "callers": 1}},
                   "next": "optimize"},
            "optimize": {"exec": "optimize", "next": "verify"}}}
