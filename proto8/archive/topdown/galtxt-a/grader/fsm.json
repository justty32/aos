{"_entry": ["aos-fsm", {"$env": "AOS_CF"}],
 "start": "idle",
 "states": {
   "idle":  {"exec": "idle", "next": "think"},
   "think": {"exec": {"argv": ["python3", "brain.py"], "timeout_ms": 90000,
                      "_metainfo": {"summary": "問腦一次：讀題目（前後文或場景條件＋一份草稿），回「分數：N」「理由：標籤」",
                                    "time_ms": {"val": 5000, "max": 90000},
                                    "resource": "llm", "llm_calls": 1,
                                    "llm_tokens": {"val": 2000, "max": 10000},
                                    "side_effect": false, "idempotent": false, "deterministic": false,
                                    "interrupt": "safe"}},
             "next": "act"},
   "act":   {"exec": {"argv": ["python3", "act.py"], "timeout_ms": 60000}, "next": "idle"}}}
