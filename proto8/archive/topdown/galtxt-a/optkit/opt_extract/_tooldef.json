{
 "description": "把一個環節抽成新工具：在自己的 tools/<name>/ 建 _tooldef.json、_entry（code）、_metainfo，並把 name 加進 stage.json 的 tools。code 是 python 程式：stdin 收 JSON、stdout 印結果、錯時 stderr 與 stdout 各一行「<name>: 代號 原因」退 1。",
 "parameters": {
  "type": "object",
  "properties": {
   "name": {
    "type": "string",
    "description": "工具名（小寫英數底線）"
   },
   "description": {
    "type": "string",
    "description": "給腦看的說明"
   },
   "parameters": {
    "type": "object",
    "description": "JSON Schema（type object）"
   },
   "code": {
    "type": "string",
    "description": "_entry 的 python 程式"
   },
   "summary": {
    "type": "string",
    "description": "一句話說它做什麼（_metainfo.summary）"
   },
   "covers": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "選填：這支工具接手自己 _metainfo.steps 的哪幾個環節（例 [\"收尾旁白\"]）；優化器照它算 tools_share"
   }
  },
  "required": [
   "name",
   "description",
   "parameters",
   "code",
   "summary"
  ]
 }
}
