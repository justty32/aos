#!/usr/bin/env python3
# opt_history - stdin {"max_runs"?: 6}，stdout 一份 JSON：先前執行結果——最近幾題的 score.json 摘要（total、dims、lint 違規代號、評審理由）、grad.json.steps 最近 3 筆、opt_log.jsonl 最近 3 筆（自己上次改了什麼）
# score.json 從 OPTKIT_RUNS（訓練 stack 的 epochs/*/runs 或 verify 小格；沒設＝沒有）底下找；grad／opt_log 讀拷貝的子樹。只讀；round4-selfopt.md § 1。
# 錯：stderr 與 stdout 各一行「opt_history: 代號 原因」、退 1——ArgumentsBad、EnvMissing。
import glob, json, os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_history"
a = oc.args_in(NAME)
n = a.get("max_runs", 6)
if not isinstance(n, int) or isinstance(n, bool) or n < 0:
    oc.die(NAME, "ArgumentsBad", "max_runs 要是非負整數")
e = oc.env(NAME)
runs = []
if e["runs"] and os.path.isdir(e["runs"]):
    found = glob.glob(os.path.join(e["runs"], "**", "out", "*", "score.json"), recursive=True)
    for p in sorted(found, key=lambda p: (os.path.getmtime(p), p), reverse=True)[:n]:
        try:
            with open(p, encoding="utf-8") as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        drafts = s.get("drafts") or []
        best = next((x for x in drafts if x.get("n") == s.get("picked")), {})
        runs.append({"question": s.get("name"), "where": os.path.relpath(p, e["runs"]), "total": best.get("total"),
                     "dims": best.get("dims"), "question_dims": s.get("dims"),
                     "lint": sorted({c for x in drafts for c in x.get("tier0") or []}),
                     "reasons": [x.get("reason") for x in drafts if x.get("reason")]})


def tail(path, k):
    try:
        with open(path, encoding="utf-8") as f:
            return [json.loads(l) for l in f if l.strip()][-k:]
    except (OSError, ValueError):
        return []


d = os.path.join(e["tree"], e["sub"])
try:
    with open(os.path.join(d, "grad.json"), encoding="utf-8") as f:
        steps = (json.load(f).get("steps") or [])[-3:]
except (OSError, ValueError, AttributeError):
    steps = []
print(json.dumps({"subtree": e["sub"], "runs": runs, "grad_steps": steps,
                  "opt_log": tail(os.path.join(d, "opt_log.jsonl"), 3)}, ensure_ascii=False))
