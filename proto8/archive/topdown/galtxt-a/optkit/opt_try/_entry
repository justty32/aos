#!/usr/bin/env python3
# opt_try - stdin {"question": "cls-ribbon.json", "drafts"?: 1, "judge"?: false, "stage"?: "agent"}：在拷貝上跑根一題（aos-exec --ws <暫存> <拷貝根>），stdout 一份 JSON：
# {question, exit, answer, total, dims, lint（違規代號）, stderr（尾巴）}。題目只能挑 OPTKIT_QUESTIONS 裡的（optkit/run 從 set.json 的 train／measure 拷來；驗證題不在裡面）。
# stage＝這一題暫時照哪階跑（GALTXT_STAGE；distill 拿自己的 agent 階當老師，round4 § 6）。judge 沒給或 false＝GALTXT_JUDGE=off（judge.py 寫空 judge.json、省腦）；子行程拿掉 GALTXT_OPT／OPTKIT_*（拷貝裡的寫手照平常跑）。
# 暫存小格在 OPTKIT_CELL/try/NNN/；不寫拷貝樹以外的東西（拷貝裡的 hard.jsonl 照 compose 平常的規矩長，accept 不搬）。round4-selfopt.md § 1。
# 錯：stderr 與 stdout 各一行「opt_try: 代號 原因」、退 1——ArgumentsBad、EnvMissing、QuestionMissing。題目本身跑壞不算這支的錯：exit 非 0 照回。
import json, os, subprocess, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_try"
a = oc.args_in(NAME)
e = oc.env(NAME)
q = a.get("question")
qdir = e["questions"]
if not isinstance(q, str) or "/" in q or not q.endswith(".json"):
    oc.die(NAME, "ArgumentsBad", "question 要是題目檔名（例 cls-ribbon.json）")
if not qdir or not os.path.isfile(os.path.join(qdir, q)):
    oc.die(NAME, "QuestionMissing", "%s 不在能試的題目裡（%s）" % (q, "、".join(sorted(os.listdir(qdir))) if qdir and os.path.isdir(qdir) else "沒有"))
with open(os.path.join(qdir, q), encoding="utf-8") as f:
    task = json.load(f)
if a.get("drafts") is not None:
    if not isinstance(a["drafts"], int) or not 1 <= a["drafts"] <= 3:
        oc.die(NAME, "ArgumentsBad", "drafts 要是 1～3")
    task["drafts"] = a["drafts"]
cell = oc.fresh(os.path.join(e["cell"] or os.path.join(e["tree"], "..", ".opt_try"), "try"))
ws = os.path.join(cell, "ws")
os.makedirs(os.path.join(ws, "new"))
with open(os.path.join(ws, "new", q), "w", encoding="utf-8") as f:
    json.dump(task, f, ensure_ascii=False)
extra = {} if a.get("judge") else {"GALTXT_JUDGE": "off"}
if a.get("stage") is not None:                       # 6b：distill 的老師＝自己的 agent 階（GALTXT_STAGE 蓋過 stage.json，writer/_entry 照它分流）
    if a["stage"] not in ("agent", "semi", "program"):
        oc.die(NAME, "ArgumentsBad", "stage 要是 agent／semi／program")
    extra["GALTXT_STAGE"] = a["stage"]
try:
    r = subprocess.run(["aos-exec", "--ws", ws, e["tree"]], capture_output=True, text=True, cwd=cell, timeout=900, stdin=subprocess.DEVNULL,
                       env=oc.clean_env(extra))
    code, err = r.returncode, r.stderr
except subprocess.TimeoutExpired:
    code, err = None, "超過 900 秒"
stem = q[:-5]
out = {"question": q, "exit": code, "where": cell}
try:
    with open(os.path.join(ws, "out", stem, "answer.txt"), encoding="utf-8") as f:
        out["answer"] = f.read()
    with open(os.path.join(ws, "out", stem, "score.json"), encoding="utf-8") as f:
        s = json.load(f)
    drafts = s.get("drafts") or []
    best = next((x for x in drafts if x.get("n") == s.get("picked")), {})
    out.update(total=best.get("total"), dims=best.get("dims"), question_dims=s.get("dims"),
               lint=sorted({c for x in drafts for c in x.get("tier0") or []}))
except (OSError, ValueError):
    out["answer"] = None
out["stderr"] = (err or "")[-600:]
print(json.dumps(out, ensure_ascii=False))
