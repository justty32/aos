#!/usr/bin/env python3
# opt_edit - stdin {"path", "edits": [{"old_text", "new_text"}]}，在拷貝裡照順序換字（每個 old_text 要剛好出現一次，同 lib/edit），stdout 一行「換了 N 處：<path>」
# 路徑從拷貝樹根算；改完的內容先過白名單（optkit_common.check_change：原樹的 opt_writes ∩ 不在 deny.json；JSON 指標檔只准改那個位置）才落檔，不過＝WriteDenied、檔不動。round4-selfopt.md § 1、§ 1.1。
# 錯：stderr 與 stdout 各一行「opt_edit: 代號 原因」、退 1——ArgumentsBad、EnvMissing、PathBad、PathDenied、FileMissing、TextMissing、TextAmbiguous、WriteDenied。
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_edit"
a = oc.args_in(NAME)
e = oc.env(NAME)
edits = a.get("edits")
if not isinstance(edits, list) or not edits or not all(
        isinstance(x, dict) and isinstance(x.get("old_text"), str) and x["old_text"] and isinstance(x.get("new_text"), str) for x in edits):
    oc.die(NAME, "ArgumentsBad", "edits 要是 [{old_text（非空）, new_text}] 的非空陣列")
p, rel = oc.resolve(NAME, e["tree"], a.get("path"))
old = oc.read_bytes(p)
if old is None or os.path.isdir(p):
    oc.die(NAME, "FileMissing", "%s 不存在（新檔用 opt_write）" % rel)
text = old.decode("utf-8", "replace")
for i, x in enumerate(edits, 1):
    k = text.count(x["old_text"])
    if k == 0:
        oc.die(NAME, "TextMissing", "第 %d 個 old_text 在 %s 裡找不到" % (i, rel))
    if k > 1:
        oc.die(NAME, "TextAmbiguous", "第 %d 個 old_text 在 %s 裡出現 %d 次（要剛好一次）" % (i, rel, k))
    text = text.replace(x["old_text"], x["new_text"], 1)
oc.guarded_write(NAME, e, p, rel, text.encode("utf-8"))
print("換了 %d 處：%s" % (len(edits), rel))
