#!/usr/bin/env python3
# opt_write - stdin {"path", "content"}，在拷貝裡寫整個檔，stdout 一行「寫了 N bytes：<path>」
# 只准新建的工具資料夾裡的檔、或白名單點名的檔（optkit_common.check_change）；不過＝WriteDenied、檔不動。路徑從拷貝樹根算。round4-selfopt.md § 1。
# 錯：stderr 與 stdout 各一行「opt_write: 代號 原因」、退 1——ArgumentsBad、EnvMissing、PathBad、PathDenied、WriteDenied。
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_write"
a = oc.args_in(NAME)
e = oc.env(NAME)
if not isinstance(a.get("content"), str):
    oc.die(NAME, "ArgumentsBad", "content 要是字串")
p, rel = oc.resolve(NAME, e["tree"], a.get("path"))
if os.path.isdir(p):
    oc.die(NAME, "ArgumentsBad", "%s 是資料夾" % rel)
data = a["content"].encode("utf-8")
oc.guarded_write(NAME, e, p, rel, data)
print("寫了 %d bytes：%s" % (len(data), rel))
