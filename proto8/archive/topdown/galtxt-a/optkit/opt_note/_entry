#!/usr/bin/env python3
# opt_note - stdin {"what", "why", "metainfo_suggest"?}：在拷貝的 <子樹>/opt_log.jsonl 追加一行 {at, epoch, subtree, what, why, files, metainfo_suggest}，stdout 一行「記了：<what>」
# files＝這次到目前為止拷貝 vs 原樹變了的檔與新的 sha256（給之後判「改回上一次」的震盪，round4-selfopt.md § 5.7）。
# M7：節點不能改自己的 _metainfo；想改宣告（children、steps 變了）寫 metainfo_suggest，人看了再改。只寫這一檔；round4-selfopt.md § 1。
# 錯：stderr 與 stdout 各一行「opt_note: 代號 原因」、退 1——ArgumentsBad、EnvMissing。
import os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
import optkit_common as oc  # noqa: E402

NAME = "opt_note"
a = oc.args_in(NAME)
e = oc.env(NAME)
for k in ("what", "why"):
    if not isinstance(a.get(k), str) or not a[k].strip():
        oc.die(NAME, "ArgumentsBad", "%s 要是非空字串" % k)
log_rel = e["sub"] + "/opt_log.jsonl"
files = []
if e["orig"]:
    files = [{"path": r, "sha256": oc.sha(new)} for r, old, new in oc.diff(e["orig"], e["tree"], oc.load_deny()) if r != log_rel]
row = {"at": oc.now(), "epoch": e["epoch"], "subtree": e["sub"], "what": a["what"], "why": a["why"], "files": files}
if a.get("metainfo_suggest") is not None:
    row["metainfo_suggest"] = a["metainfo_suggest"]
oc.append_line(os.path.join(e["tree"], log_rel), row)
print("記了：%s" % a["what"].replace("\n", " "))
