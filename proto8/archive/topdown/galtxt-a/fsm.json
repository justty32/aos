{"_entry": ["aos-fsm", {"$env": "AOS_CF"}],
 "start": "idle",
 "states": {"idle": {"exec": "idle", "next": "brief"},
           "brief": {"exec": {"argv": ["python3", "brief.py"],
                            "timeout_ms": 10000,
                            "_metainfo": {"summary": "認領一題，從 data/ 的人物卡、地點卡、固化表組出給寫手看的 brief.json 與給 lint 用的 rules.json",
                                         "kind": "program",
                                         "grow_level": 0,
                                         "time_ms": {"val": 50, "max": 10000},
                                         "resource": ["cpu", "disk"],
                                         "side_effect": true,
                                         "idempotent": true,
                                         "deterministic": true,
                                         "interrupt": "safe",
                                         "parallel": false,
                                         "reads": ["ws:new/*.json",
                                                  "ws:cur/*.json",
                                                  "data:cast.json",
                                                  "data:places.json",
                                                  "data:address.json",
                                                  "data:forbidden.json",
                                                  "data:styles.json",
                                                  "data:samples.json",
                                                  "data:lint_switches.json",
                                                  "data:bench/<編號>.json（不讀 answer）",
                                                  "data:cast/yuzu.json（cast.json 的 $ref）",
                                                  "data:style/tsun.json（styles.json 的 $ref）",
                                                  "data:place/classroom.json（places.json 的 $ref）",
                                                  "data:scene/closeup.json（題目的 scene）"],
                                         "writes": ["ws:cur/<題名>.json",
                                                   "stack:current.txt",
                                                   "stack:route.json（換題時清掉）",
                                                   "stack:brief.json",
                                                   "stack:rules.json"],
                                         "fs_needs": [],
                                         "callers": 1}},
                    "next": "write"},
           "write": {"exec": {"argv": ["python3", "write.py"],
                            "timeout_ms": 2400000,
                            "_metainfo": {"summary": "照 data/route.json（或題目的 writer）選寫手，把 brief 交給它跑 N 次（預設 3），每次一個新小格，答案收成 drafts/N.txt；已有的草稿不重寫、已選的寫手不重選",
                                         "kind": "glue",
                                         "grow_level": 0,
                                         "time_ms": {"val": 45000, "max": 2400000},
                                         "resource": ["llm", "cpu"],
                                         "llm_calls": {"val": 6, "max": 36},
                                         "llm_tokens": {"val": 18000, "max": 150000},
                                         "side_effect": false,
                                         "idempotent": true,
                                         "deterministic": false,
                                         "interrupt": "resumable",
                                         "parallel": true,
                                         "reads": ["stack:brief.json",
                                                  "stack:rules.json",
                                                  "stack:current.txt",
                                                  "stack:drafts/",
                                                  "stack:route.json",
                                                  "data:route.json",
                                                  "data:hints.json"],
                                         "writes": ["stack:drafts/N.txt",
                                                   "stack:route.json",
                                                   "cell:<寫手>/runs/NNN/{ws,stack}"],
                                         "state_key": "stack:route.json",
                                         "fs_needs": ["mount"],
                                         "callers": 1}},
                    "next": "check"},
           "check": {"exec": {"argv": ["python3", "check.py"],
                            "timeout_ms": 30000,
                            "_metainfo": {"summary": "每份草稿用 tools/lint 過一次 Tier 0 護欄與 Tier 1 語域，收成 checks.json",
                                         "kind": "program",
                                         "grow_level": 0,
                                         "time_ms": {"val": 300, "max": 30000},
                                         "resource": "cpu",
                                         "side_effect": false,
                                         "idempotent": true,
                                         "deterministic": true,
                                         "interrupt": "safe",
                                         "parallel": true,
                                         "reads": ["stack:drafts/*.txt",
                                                  "stack:rules.json（給 lint 當工作區）"],
                                         "writes": ["stack:checks.json", "cell:lint/"],
                                         "fs_needs": ["mount"],
                                         "callers": 1}},
                    "next": "judge"},
           "judge": {"exec": {"argv": ["python3", "judge.py"],
                            "timeout_ms": 960000,
                            "_metainfo": {"summary": "過了護欄的草稿逐份交給評審 agent 打 0～3 的語意分，每份一個新小格，收成 judge.json",
                                         "kind": "glue",
                                         "grow_level": 0,
                                         "time_ms": {"val": 25000, "max": 960000},
                                         "resource": ["llm", "cpu"],
                                         "llm_calls": {"val": 3, "max": 12},
                                         "llm_tokens": {"val": 6000, "max": 60000},
                                         "side_effect": false,
                                         "idempotent": true,
                                         "deterministic": false,
                                         "interrupt": "resumable",
                                         "parallel": true,
                                         "reads": ["stack:checks.json",
                                                  "stack:drafts/*.txt",
                                                  "stack:brief.json",
                                                  "data:dims.json（cells）",
                                                  "data:cast/yuzu.json（像柚葉的格）"],
                                         "writes": ["stack:judge.json",
                                                   "cell:judge/runs/NNN/{ws,stack}"],
                                         "fs_needs": ["mount"],
                                         "callers": 1}},
                    "next": "pick"},
           "pick": {"exec": {"argv": ["python3", "pick.py"],
                           "timeout_ms": 10000,
                           "_metainfo": {"summary": "合 Tier 1＋Tier 2 分、嚴格比大小、平手編號小的贏；寫 out/<題名>/{answer.txt,score.json}（含寫手、風格、每份 dims、整題多樣性），題目 cur/ → done/；挖空模式再跟正解比",
                                        "kind": "program",
                                        "grow_level": 0,
                                        "time_ms": {"val": 30, "max": 10000},
                                        "resource": ["cpu", "disk"],
                                        "side_effect": true,
                                        "idempotent": true,
                                        "deterministic": true,
                                        "interrupt": "safe",
                                        "parallel": false,
                                        "reads": ["stack:brief.json",
                                                 "stack:checks.json",
                                                 "stack:judge.json",
                                                 "stack:drafts/*.txt",
                                                 "stack:current.txt",
                                                 "stack:route.json",
                                                 "data:dims.json",
                                                 "data:bench/<編號>.json#/answer"],
                                        "writes": ["ws:out/<題名>/answer.txt",
                                                  "ws:out/<題名>/score.json",
                                                  "ws:done/<題名>.json"],
                                        "fs_needs": [],
                                        "callers": 1}},
                   "next": "idle"}}}
