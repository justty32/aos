{"summary": "自我優化的主要工具（工具包不成熟時由 Claude Code 代勞，使用者 10-25）：claude -p 在訓練場的節點複本裡自己讀結果、改檔；事後比對整棵 tree/，節點外／凍結／記帳檔的改動還原並記 attempted_violation；記花費進 session 與 lifecycle.history",
 "time_ms": {"val": 120000, "max": 900000},
 "resource": ["llm", "cpu", "disk"],
 "llm_calls": {"val": 15, "max": 30},
 "llm_tokens": {"val": 300000, "max": 2000000},
 "llm_endpoint": "claude CLI（Anthropic；「腦只用 gpt」的例外，只當優化工具，台詞樹的腦仍是 gpt）",
 "llm_model": "sonnet（cli.json）",
 "cost_usd": {"val": 0.5, "max": 2.0},
 "side_effect": true,
 "idempotent": false,
 "deterministic": false,
 "interrupt": "safe",
 "parallel": false,
 "reads": ["$SELFOPT_SESSION", "cli.json", "$AOS_WS/tree/", "$AOS_WS/runs/", "$AOS_WS/rounds/"],
 "writes": ["$AOS_WS/tree/<node>/（claude 改；越界還原）", "$AOS_WS/tree/<node>/versions/selfopt_<session>/", "$AOS_WS/selfopt/<session>/cc_before_<k>/（改前整棵 tree 的複本，還原用）", "$AOS_WS/tree/<node>/_metainfo#/lifecycle/history", "$SELFOPT_SESSION（claude_code 用量、edits、attempted_violations）"],
 "calls": ["claude -p --output-format json --tools Read,Glob,Grep,Edit,Write --permission-mode acceptEdits（cwd＝節點複本）"],
 "grow_level": 3,
 "uses_llm": true,
 "measured": {"note": "實跑數字見 plan/runs/round6/selfopt.md"}}
