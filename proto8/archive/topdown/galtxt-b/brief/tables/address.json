   },
   "forbidden": {
    "surname_bare": "(?<![一-龥]){surname}(?=[」，。、？…\\s]|$)",
    "given_any": "{given}(?=君|同學|[」，。、？…\\s]|$)",
    "a_given": "阿{given}"
   }
  },
  "2": {
   "allowed": {
    "surname": "{surname}",
    "surname_classmate": "{surname}同學"
   },
   "forbidden": {
    "given_any": "{given}(?=君|同學|[」，。、？…\\s]|$)",
    "a_given": "阿{given}"
   }
  },
  "3": {
   "allowed": {
    "given_kun": "{given}君",
    "given_classmate": "{given}同學",
    "surname": "{surname}"
   },
   "forbidden": {
    "given_bare": "(?<![一-龥]){given}(?=[」，。、？…\\s]|$)",
    "a_given": "阿{given}"
   }
  },
  "4": {
   "allowed": {
    "given": "{given}"
   },
   "forbidden": {
    "a_given": "阿{given}",
    "darling": "親愛的"
   }
  },
  "5": {
   "allowed": {
    "reserved": "（專屬叫法，留白）"
   },
   "forbidden": {
    "darling": "親愛的"
   }
  }
 },
