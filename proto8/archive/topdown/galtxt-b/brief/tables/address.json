{
 "_note": "從 corpus/固化/02_敬語與稱謝階 蒸餾的稱謂階（0～5）。allowed＝這一階能用的叫法（給 writer 看）；forbidden＝這一階不該出現的叫法，寫成 regex（給 check 用，{surname}／{given}／{display} 代入對方的名字；lookahead 擋掉「悠閒」這種誤中）。只能一階一階升、吵架可暫退半階——本輪一場戲固定一階、不跳階。 10-25 結構化：每一階的 allowed／forbidden 從陣列改成 {鍵: 叫法}（一條稱呼規則一格；brief 依序組回陣列，lint 違規帶格 id），rules 三條各一格；格 id＝address/<方向>/<階>/<allowed|forbidden>/<鍵>、address/rules/<鍵>。",
 "heroine_to_hero": {
  "0": {
   "allowed": {
    "classmate": "同學",
    "um": "那個……"
   },
   "forbidden": {
    "surname_any": "{surname}(?=君|同學|[」，。、？…\\s]|$)",
    "given_any": "{given}(?=君|同學|[」，。、？…\\s]|$)"
   }
  },
  "1": {
   "allowed": {
    "display_classmate": "{display}同學",
