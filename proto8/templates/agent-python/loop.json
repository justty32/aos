{
  "description": "Run the state machine in fsm.json every tick and expose public control, state and state flux files. on_start / on_stop fire the after_start / after_stop hooks and on_before_run / on_after_run fire before_run / after_run around each state, all through aos-hook; the last two only while their flag file is in the stack (hook_before_run.flag, hook_after_run.flag), which after_start sets from the hooks lists.",
  "exec": "fsm.json",
  "interval_ms": 300,
  "ctl": "ctl.json",
  "state": "state.json",
  "state_flux": "state_flux.json",
  "on_start": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--agent",
      {
        "$env": "AOS_CD"
      },
      "after_start"
    ]
  },
  "on_stop": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--agent",
      {
        "$env": "AOS_CD"
      },
      "after_stop"
    ]
  },
  "on_before_run": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--agent",
      {
        "$env": "AOS_CD"
      },
      "--field-file",
      {
        "$env": "AOS_STACK",
        "$path": "/stage.txt",
        "$prefix": "stage="
      },
      "--field-default",
      {
        "$ref": "fsm.json#/start",
        "$prefix": "stage="
      },
      "before_run"
    ]
  },
  "on_before_run_if": {
    "$env": "AOS_STACK",
    "$path": "/hook_before_run.flag"
  },
  "on_after_run": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--agent",
      {
        "$env": "AOS_CD"
      },
      "--field-file",
      {
        "$env": "AOS_STACK",
        "$path": "/stage.txt",
        "$prefix": "next_stage="
      },
      "after_run"
    ]
  },
  "on_after_run_if": {
    "$env": "AOS_STACK",
    "$path": "/hook_after_run.flag"
  }
}
