# .env - defaults for this root (a value already exported in the shell wins); every agent and child daemon inherits them.
AOS_CLOCK=${AOS_STACK}/clock
# llm kernel stack: llm/ in this tree, mounted on this root as the row "llm" (aos-daemon-ctl -d .stack add --auto-restart llm), so its stack is procs/llm under this root's stack.
# Do not set AOS_KERNEL here: the llm kernel would inherit it and mount its brain calls through that station onto this root (set it per agent, see agents/ann/.env).
AOS_LLM_KERNEL=${AOS_STACK}/procs/llm
# AOS_HOME is the proto8 folder these files point into; export it, or uncomment the next line and set it here.
# AOS_HOME=${HOME}/repo/aos/proto8
AOS_HOME=${AOS_HOME}
