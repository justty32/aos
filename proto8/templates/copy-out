#!/usr/bin/env python3
# copy-out - 把範本（templates/<名> 或 kernel/<名>）抄到 repo 外，指回 repo 的路徑照 --proto8 寫法改寫（預設 env：{"$env":"AOS_PROTO8",…}）；--relink 重指錨點。
# 放在 templates/ 底下、不在範本裡：範本資料夾整份會被抄進每隻 agent，腳本放裡面就會跟著被抄走。
# repo 的位置從自己的 realpath 往上推（不靠環境變數）：範本＝<本檔所在資料夾>/<範本名> 或 proto8/kernel/<名>，proto8＝本檔所在資料夾的上一層。
# 寫法（11-10 TC，使用者「使用者自己準備。要用相對位置、絕對位置、環境變數指定都可」「兩台各自設一次...不要限制只設一次」）：
#   env（預設）＝{"$env": "AOS_PROTO8", "$path": "/<proto8 底下>"}，每台設一次 AOS_PROTO8；anchor＝經 DEST/.aos-proto8 的相對路徑（11-10 坑-73，
#   錨點只是可選的一種）；absolute＝這台 proto8 的絕對路徑；relative＝從那個檔的資料夾到 proto8 的相對路徑。改哪些地方、捷徑怎麼辦
#   都在共用模組 lib/agent/copy_def.py（agents new 也用它）。抄完多印一行這隻需要本機備好什麼。
# 不抄 __pycache__。目的已存在（含斷掉的捷徑）＝DestExists、不蓋；半路失敗＝刪掉這次建的目的資料夾再報錯。
# --relink ROOT…：只建或重指錨點，不寫別的檔（冪等）。錨點位置從 ROOT 底下遞迴找：JSON 檔與 _entry 裡經過 .aos-proto8 的相對字串
#   （相對那個檔的資料夾）、目標經過 .aos-proto8 的相對捷徑，加上已經在的 .aos-proto8 捷徑；不跟捷徑往下走，不出 ROOT。
#   已經指得到一份 proto8 的錨點、使用者自己放的相對錨點都不改寫（11-10 TC）；只重指「指不到 proto8 的絕對捷徑」與建沒有的。
#   stdout：新建／重指的每個一行，已對的只計數；最後一行 summary。一個壞了提醒一行、其餘照做，最後錯誤行退 1；一個錨都沒有＝退 0。
# 錯（stderr 一行 `copy-out: error: 代號 原因`、退 1）：ArgumentsBad、FlagUnknown、TemplateMissing、TemplateBad、DestExists、WriteFailed、
#   PathMissing（--relink 的 ROOT 不是資料夾）、AnchorBad（該放錨點的地方已有別的東西，不蓋）。
import json, os, shutil, sys
from pathlib import Path

_import_paths = []
for _parent in Path(__file__).resolve().parents:
    if (_parent / "py" / "aos_flags.py").is_file():
        _import_paths += [str(_parent / "py"), str(_parent / "lib")]
        break
sys.path[:0] = _import_paths
try:
    import aos_flags  # noqa: E402
    from agent import copy_def  # noqa: E402
except ModuleNotFoundError as _error:
    if _error.name not in ("aos_flags", "tool_io", "agent", "agent.copy_def"):
        raise
    print("copy-out: error: ModuleMissing required Python module %s is unavailable" % _error.name, file=sys.stderr)
    sys.exit(1)
finally:
    for _path in _import_paths:
        sys.path.remove(_path)

PROG = "copy-out"
HERE = Path(__file__).resolve().parent             # proto8/templates
PROTO = str(HERE.parent)                           # proto8（這台）
ANCHOR = copy_def.ANCHOR
DEFAULT = "agent-fsm"
USAGE = "(usage: copy-out [--proto8 MODE] [TEMPLATE] DEST | copy-out --relink ROOT...)"
HELP = """\
copy-out - copy an agent or kernel template out of the repo

usage: copy-out [--proto8 MODE] [TEMPLATE] DEST
       copy-out --relink ROOT...

TEMPLATE is a folder name under proto8/templates/ (default: agent-fsm) or kernel/NAME
for a folder under proto8/kernel/ (e.g. kernel/llm-kernel); DEST is the new folder
(relative to cwd) and must not exist yet. Copies the whole template (without
__pycache__). Paths that point from the template into the repo's proto8/ are rewritten
in the form MODE picks; paths that stay inside the template stay as they were.

--proto8 MODE (how files point at proto8; nothing resolved is ever written back):
  env       {"$env": "AOS_PROTO8", "$path": "/<path in proto8>"} (default). Set
            AOS_PROTO8 once per machine to that machine's proto8 folder; files are
            identical on every machine and no link is needed.
  anchor    a relative path through DEST/.aos-proto8, a symlink to this machine's
            proto8/ that copy-out creates (DEST/.gitignore gets /.aos-proto8; after a
            move run copy-out --relink, or make the link yourself).
  absolute  this machine's proto8 path (every machine keeps proto8 there).
  relative  a path from each file's folder to proto8 (same relative layout everywhere).
Rewritten: relative path strings in any JSON file (and JSON _entry) that reach into
proto8 (tools.*.path, one-shot argv, _memory.json base, kernel.json exec and
endpoints...), {"$env": "AOS_CD", "$path": "../x"}, and relative symlinks. A symlink
cannot hold an environment variable, so in env mode a symlinked _entry becomes the
equivalent JSON one-shot, a symlink to a file becomes a copy of that file, and a
symlink to a folder falls back to an absolute symlink (one warning each).
Prints: copied TEMPLATE -> DEST (N paths written as MODE), then one line saying what
this copy needs on the machine (e.g. needs AOS_PROTO8 set to this machine's proto8
folder).

--relink: create or re-point every .aos-proto8 anchor under each ROOT (recursively) at
this machine's proto8/. Anchors are found from JSON / _entry strings and symlinks under
ROOT that go through .aos-proto8, plus existing anchors; symlinks are not followed.
Anchors that already reach a proto8 folder, and relative anchors you made yourself,
are left alone. Writes nothing else (idempotent). Prints one line per anchor it creates
or re-points ("linked PATH -> PROTO8", "relinked PATH -> PROTO8"); the last line is
  done: N anchors (linked A, relinked B, already C), F failed, under R root(s)
Exit 0 when nothing failed, including when no anchor was found (N = 0). Exit 1 when a
ROOT is not a folder (PathMissing) or an anchor could not be made (AnchorBad: something
else is there; WriteFailed): one warning per failure, the others are still done, and a
final error line names the first one.

The repo is found from this script's own real path (no environment variable).
On error: one line "copy-out: error: CODE reason" on stderr, exit 1.
Error codes: ArgumentsBad, FlagUnknown, TemplateMissing, TemplateBad, DestExists,
WriteFailed, PathMissing, AnchorBad.
"""


class Fail(Exception):
    def __init__(self, code, reason):
        super().__init__(reason)
        self.code = code


def inside(path, root):
    return os.path.commonpath([path, root]) == root


def make_anchor(folder):
    """folder/.aos-proto8 → PROTO；回 'linked'／'relinked'／'already'。已指得到一份 proto8、或使用者自己放的相對捷徑＝already（不改寫，
    相對但指不到的提醒一行）；別的東西佔著＝AnchorBad。"""
    link = os.path.join(folder, ANCHOR)
    if os.path.islink(link):
        if copy_def.is_proto8(link):
            return "already"
        if not os.path.isabs(os.readlink(link)):
            aos_flags.warn(PROG, "%s is your relative anchor (-> %s) and reaches no proto8 folder; left as is" % (link, os.readlink(link)))
            return "already"
        state = "relinked"
    elif os.path.lexists(link):
        raise Fail("AnchorBad", "%s exists and is not a symlink (not overwritten; move it away and rerun)" % link)
    else:
        state = "linked"
    tmp = os.path.join(folder, ".%s.%d.tmp" % (ANCHOR, os.getpid()))
    try:
        os.symlink(PROTO, tmp)
        os.replace(tmp, link)
    except OSError as e:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise Fail("WriteFailed", "cannot link %s: %s" % (link, e))
    return state


# ---- 抄出 ----

def copy_template(src, dest, mode):
    """src 已整份抄到 dest；照 mode 改寫指進 proto8 的路徑。回改了幾個。"""
    try:
        n = copy_def.Rewriter(src, dest, dest, mode, warn=lambda s: aos_flags.warn(PROG, s), proto=PROTO).run()
    except copy_def.CopyFail as e:
        raise Fail(e.code, str(e))
    if mode == "anchor":
        make_anchor(str(dest))
        ignore = Path(dest) / ".gitignore"
        line = "/%s\n" % ANCHOR
        try:
            old = ignore.read_text(encoding="utf-8") if ignore.exists() else ""
            if line.strip() not in old.splitlines():
                ignore.write_text(old + ("" if not old or old.endswith("\n") else "\n") + line, encoding="utf-8")
        except OSError as e:
            raise Fail("WriteFailed", "cannot write %s: %s" % (ignore, e))
    return n


# ---- 重指錨點 ----

def through_anchor(base_dir, rel):
    """rel 是經過 .aos-proto8 的相對路徑＝回錨點所在資料夾（normpath），否則 None。"""
    if not isinstance(rel, str) or not rel or os.path.isabs(rel):
        return None
    parts = rel.split("/")
    if ANCHOR not in parts:
        return None
    return os.path.normpath(os.path.join(base_dir, *parts[:parts.index(ANCHOR)]))


def strings(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, list):
        for v in value:
            yield from strings(v)
    elif isinstance(value, dict):
        for v in value.values():
            yield from strings(v)


def relink(root, tally):
    """ROOT 底下所有錨點建好或重指；壞的記進 tally["bad"]、不停（其他錨點照做）。"""
    root = os.path.abspath(root)
    if not os.path.isdir(root):
        aos_flags.warn(PROG, "%s is not a folder; skipped" % root)
        tally["bad"].append(("PathMissing", root))
        return
    found = set()
    for directory, dirs, files in os.walk(root):          # 不跟捷徑往下走：錨點指的 repo 不會被掃
        links = [d for d in dirs if os.path.islink(os.path.join(directory, d))]
        dirs[:] = [d for d in dirs if d not in links and d not in ("__pycache__", ".git")]
        for name in files + links:
            path = os.path.join(directory, name)
            if os.path.islink(path):
                if name == ANCHOR:
                    found.add(directory)
                else:
                    found.add(through_anchor(directory, os.readlink(path)))
                continue
            if not (name.endswith(".json") or name == "_entry"):
                continue
            try:
                if os.path.getsize(path) > 1 << 20:
                    continue
                with open(path, encoding="utf-8") as f:
                    text = f.read()
                if ANCHOR not in text:
                    continue
                data = json.loads(text)
            except (OSError, ValueError, UnicodeError):
                continue
            for s in strings(data):
                found.add(through_anchor(directory, s))
    found.discard(None)
    for folder in sorted(found):
        if not inside(folder, root):
            aos_flags.warn(PROG, "anchor %s is outside %s; skipped" % (os.path.join(folder, ANCHOR), root))
            continue
        if not os.path.isdir(folder):
            aos_flags.warn(PROG, "%s is referenced but %s is not a folder; skipped" % (ANCHOR, folder))
            continue
        try:
            state = make_anchor(folder)
        except Fail as e:
            aos_flags.warn(PROG, str(e))
            tally["bad"].append((e.code, os.path.join(folder, ANCHOR)))
            continue
        tally[state] += 1
        if state != "already":
            print("%s %s -> %s" % (state, os.path.join(folder, ANCHOR), PROTO))


def template_dir(template):
    """TEMPLATE → 範本資料夾：templates/<名>，或 kernel/<名>（proto8/kernel 底下）；範本＝有 _entry 的資料夾（docs/ 不算）。"""
    parts = template.split("/")
    if len(parts) == 2 and parts[0] == "kernel":
        base, name = HERE.parent / "kernel", parts[1]
    elif len(parts) == 1:
        base, name = HERE, parts[0]
    else:
        base, name = None, ""
    if base is None or name in ("", ".", "..") or not (base / name / "_entry").is_file():
        aos_flags.die(PROG, "TemplateMissing", "no template folder %s under %s (or kernel/NAME under %s)"
                      % (template, HERE, HERE.parent / "kernel"))
    return (base / name).resolve()


def main():
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], {"--proto8": "proto8"}, {"--relink": "relink"}, help=HELP)
    except aos_flags.Error as e:
        aos_flags.die(PROG, e.code, "%s %s" % (e, USAGE))
    if opts.get("relink"):
        if "proto8" in opts:
            aos_flags.die(PROG, "ArgumentsBad", "--relink takes no --proto8 %s" % USAGE)
        if not rest:
            aos_flags.die(PROG, "ArgumentsBad", "--relink needs at least one ROOT %s" % USAGE)
        tally = {"linked": 0, "relinked": 0, "already": 0, "bad": []}
        for root in rest:
            relink(root, tally)
        bad = tally["bad"]
        print("done: %d anchors (linked %d, relinked %d, already %d), %d failed, under %d root(s)"
              % (tally["linked"] + tally["relinked"] + tally["already"], tally["linked"],
                 tally["relinked"], tally["already"], len(bad), len(rest)))
        if bad:
            aos_flags.die(PROG, bad[0][0], "%d not fixed, first: %s (see the warnings above)" % (len(bad), bad[0][1]))
        return
    mode = opts.get("proto8", "env")
    if mode not in copy_def.MODES:
        aos_flags.die(PROG, "ArgumentsBad", "--proto8 must be one of %s (got %r) %s" % (", ".join(copy_def.MODES), mode, USAGE))
    if not rest or len(rest) > 2:
        aos_flags.die(PROG, "ArgumentsBad", "%s %s" % ("missing DEST" if not rest else "too many arguments", USAGE))
    template, dest = (DEFAULT, rest[0]) if len(rest) == 1 else rest
    src = template_dir(template)
    dest = Path(os.path.abspath(dest))
    if os.path.lexists(dest):
        aos_flags.die(PROG, "DestExists", "%s already exists; pick a new folder (nothing is overwritten)" % dest)
    try:
        shutil.copytree(src, dest, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
    except (OSError, shutil.Error) as e:
        shutil.rmtree(dest, ignore_errors=True)
        aos_flags.die(PROG, "WriteFailed", "cannot copy %s to %s: %s" % (src, dest, e))
    try:
        n = copy_template(src, dest, mode)
    except Fail as e:
        shutil.rmtree(dest, ignore_errors=True)
        aos_flags.die(PROG, e.code, e)
    print("copied %s -> %s (%d paths written as %s)" % (template, dest, n, mode))
    print(copy_def.needs(mode, str(dest), PROTO))


aos_flags.run(main)
