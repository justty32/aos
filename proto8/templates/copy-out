#!/usr/bin/env python3
# copy-out - 把範本（templates/<名> 或 kernel/<名>）整夾抄到 repo 外開新 agent／新根／新 kernel；--template 必給（--list 列可用的），指回 repo 的路徑照 --proto8 寫法改寫（預設 env）。
# 放在 templates/ 底下、不在範本裡：範本資料夾整份會被抄進每隻 agent，腳本放裡面就會跟著被抄走。
# repo 的位置從自己的 realpath 往上推（不靠環境變數）：範本＝<本檔所在資料夾>/<範本名> 或 proto8/kernel/<名>，proto8＝本檔所在資料夾的上一層。
# 寫法（11-10 TC，使用者「使用者自己準備。要用相對位置、絕對位置、環境變數指定都可」「兩台各自設一次...不要限制只設一次」）：
#   env（預設）＝{"$env": "AOS_PROTO8", "$path": "/<proto8 底下>"}，每台設一次 AOS_PROTO8；absolute＝這台 proto8 的絕對路徑；
#   relative＝從那個檔的資料夾到 proto8 的相對路徑。改哪些地方、捷徑怎麼辦都在共用模組 lib/agent/copy_def.py（agents new 也用它）。抄完多印一行這隻需要本機備好什麼。
# 不抄 __pycache__。目的已存在（含斷掉的捷徑）＝DestExists、不蓋；半路失敗＝刪掉這次建的目的資料夾再報錯。
# 錯（stderr 一行 `copy-out: error: 代號 原因`、退 1）：ArgumentsBad、FlagUnknown、TemplateMissing、TemplateBad、DestExists、WriteFailed。
import os, shutil, sys
from pathlib import Path

_import_paths = []
for _parent in Path(__file__).resolve().parents:
    if (_parent / "py" / "aos_flags.py").is_file():
        _import_paths += [str(_parent / "py"), str(_parent / "lib")]
        break
sys.path[:0] = _import_paths
try:
    import aos_flags  # noqa: E402
    from agent import copy_def  # noqa: E402
except ModuleNotFoundError as _error:
    if _error.name not in ("aos_flags", "tool_io", "agent", "agent.copy_def"):
        raise
    print("copy-out: error: ModuleMissing required Python module %s is unavailable" % _error.name, file=sys.stderr)
    sys.exit(1)
finally:
    for _path in _import_paths:
        sys.path.remove(_path)

PROG = "copy-out"
HERE = Path(__file__).resolve().parent             # proto8/templates
PROTO = str(HERE.parent)                           # proto8（這台）
USAGE = "(usage: copy-out --template NAME [--proto8 MODE] DEST)"
HELP = """\
copy-out - copy a whole template folder out of the repo to start a new agent, root
or kernel of your own

usage: copy-out --template NAME [--proto8 MODE] DEST
       copy-out --list

--template NAME (required; there is no default) is a folder name under
proto8/templates/ (e.g. agent-fsm, eca-claude, daemon-root) or kernel/NAME for a
folder under proto8/kernel/ (e.g. kernel/llm-kernel); --list prints the names you can
use, one per line. DEST is the new folder (relative to cwd) and must not exist yet. Copies the whole template (without
__pycache__). Paths that point from the template into the repo's proto8/ are rewritten
in the form MODE picks; paths that stay inside the template stay as they were.

--proto8 MODE (how files point at proto8; nothing resolved is ever written back):
  env       {"$env": "AOS_PROTO8", "$path": "/<path in proto8>"} (default). Set
            AOS_PROTO8 once per machine to that machine's proto8 folder; files are
            identical on every machine and no link is needed.
  absolute  this machine's proto8 path (every machine keeps proto8 there).
  relative  a path from each file's folder to proto8 (same relative layout everywhere).
Rewritten: relative path strings in any JSON file (and JSON _entry) that reach into
proto8 (tools.*.path, one-shot argv, _memory.json base, kernel.json exec and
endpoints...), {"$env": "AOS_CD", "$path": "../x"}, and relative symlinks. A symlink
cannot hold an environment variable, so in env mode a symlinked _entry becomes the
equivalent JSON one-shot, a symlink to a file becomes a copy of that file, and a
symlink to a folder falls back to an absolute symlink (one warning each).
Prints: copied NAME -> DEST (N paths written as MODE), then one line saying what
this copy needs on the machine (e.g. needs AOS_PROTO8 set to this machine's proto8
folder).

The repo is found from this script's own real path (no environment variable).
On error: one line "copy-out: error: CODE reason" on stderr, exit 1.
Error codes: ArgumentsBad, FlagUnknown, TemplateMissing, TemplateBad, DestExists,
WriteFailed.
"""


class Fail(Exception):
    def __init__(self, code, reason):
        super().__init__(reason)
        self.code = code


# ---- 抄出 ----

def copy_template(src, dest, mode):
    """src 已整份抄到 dest；照 mode 改寫指進 proto8 的路徑。回改了幾個。"""
    try:
        n = copy_def.Rewriter(src, dest, dest, mode, warn=lambda s: aos_flags.warn(PROG, s), proto=PROTO).run()
    except copy_def.CopyFail as e:
        raise Fail(e.code, str(e))
    return n


def template_dir(template):
    """TEMPLATE → 範本資料夾：templates/<名>，或 kernel/<名>（proto8/kernel 底下）；範本＝有 _entry 的資料夾（docs/ 不算）。"""
    parts = template.split("/")
    if len(parts) == 2 and parts[0] == "kernel":
        base, name = HERE.parent / "kernel", parts[1]
    elif len(parts) == 1:
        base, name = HERE, parts[0]
    else:
        base, name = None, ""
    if base is None or name in ("", ".", "..") or not (base / name / "_entry").is_file():
        aos_flags.die(PROG, "TemplateMissing", "no template folder %s under %s (or kernel/NAME under %s)"
                      % (template, HERE, HERE.parent / "kernel"))
    return (base / name).resolve()


def templates():
    """可用的範本名：templates/ 底下有 _entry 的資料夾，與 kernel/ 底下的（寫成 kernel/<名>）。"""
    out = sorted(d.name for d in HERE.iterdir() if (d / "_entry").is_file())
    kernel = HERE.parent / "kernel"
    if kernel.is_dir():
        out += sorted("kernel/" + d.name for d in kernel.iterdir() if (d / "_entry").is_file())
    return out


def main():
    try:
        opts, rest = aos_flags.parse(sys.argv[1:], {"--proto8": "proto8", "--template": "template"}, {"--list": "list"}, help=HELP)
    except aos_flags.Error as e:
        aos_flags.die(PROG, e.code, "%s %s" % (e, USAGE))
    if opts.get("list"):                              # 11-10 cli-sweep Q7：列可用的範本
        if rest or "template" in opts or "proto8" in opts:
            aos_flags.die(PROG, "ArgumentsBad", "--list takes nothing else %s" % USAGE)
        print("\n".join(templates()))
        return
    mode = opts.get("proto8", "env")
    if mode not in copy_def.MODES:
        aos_flags.die(PROG, "ArgumentsBad", "--proto8 must be one of %s (got %r) %s" % (", ".join(copy_def.MODES), mode, USAGE))
    template = opts.get("template")                   # 11-10 cli-sweep Q7「範本改成必給的旗標」：沒有預設
    if not template:
        aos_flags.die(PROG, "ArgumentsBad", "missing --template NAME (copy-out --list shows the names) %s" % USAGE)
    if len(rest) != 1:
        if len(rest) > 1 and rest[1].startswith("-"):
            aos_flags.die(PROG, "ArgumentsBad", "flags go before DEST: %s %s" % (rest[1], USAGE))
        aos_flags.die(PROG, "ArgumentsBad", "%s %s" % ("missing DEST" if not rest else "too many arguments", USAGE))
    dest = rest[0]
    src = template_dir(template)
    dest = Path(os.path.abspath(dest))
    if os.path.lexists(dest):
        aos_flags.die(PROG, "DestExists", "%s already exists; pick a new folder (nothing is overwritten)" % dest)
    try:
        shutil.copytree(src, dest, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
    except (OSError, shutil.Error) as e:
        shutil.rmtree(dest, ignore_errors=True)
        aos_flags.die(PROG, "WriteFailed", "cannot copy %s to %s: %s" % (src, dest, e))
    try:
        n = copy_template(src, dest, mode)
    except Fail as e:
        shutil.rmtree(dest, ignore_errors=True)
        aos_flags.die(PROG, e.code, e)
    print("copied %s -> %s (%d paths written as %s)" % (template, dest, n, mode))
    print(copy_def.needs(mode, str(dest), PROTO))


aos_flags.run(main)
