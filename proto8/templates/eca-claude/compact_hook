#!/usr/bin/env python3
# compact_hook - Claude Code 自己的 hook（cli.json 的 settings 掛）：PreCompact 印摘要要留什麼並發 aos 的 before_compact；PostCompact 發 after_compact；SessionStart（matcher compact）壓完後提醒讀回交接、附 handoff.md 與 before_compact 的 hook 交的補回字。
# 使用者 11-15 裁定「我們做通用的aos判斷，eca的話可以在這個基礎上接上claude hook」：通用那段是 py/tools/agent/context_wrap（過門檻先叫它收尾、再寄 /compact），
#   這支只管 Claude Code 壓縮那一刻的前後；自動壓縮（不經 aos）也會跑到它。參考 repo 的 wf/tools/compact_reload.sh（壓完重讀偏好與交接）。
# 11-21 線 top-1121-ecaeffort（使用者「compact的機制不管，但可以試試看提供相應的hook點」）：壓縮本身還是 Claude Code 的，這支只把它給的三個時刻接成 aos 的 hook 點
#   （宣告在 py/aos/apps/eca/hook_points.json，經 $AOS_HOME/bin/aos-hook fire --agent $AOS_CLI_DEF 發）：
#   pre   ＝before_compact：欄位 trigger（manual／auto）、asked（/compact 後面的字，沒有＝""）、instructions（這支要給 CLI 的摘要指示，起始＝PRE）、
#           restore（null）；hook 可改 instructions（""＝不給）、可交 restore（一段字，壓完接進對話）、可攔（退 10）＝這支退 2、stderr 寫誰攔的，
#           Claude Code 就不壓（手動 /compact 會看到那句；自動的照它的規則跳過或失敗）。restore 寫進 $AOS_STACK/claude/compact_restore.txt
#           （沒交或被攔＝刪掉上次留下的），等 start 印出來（SessionStart 的 stdout 會進壓縮後的 context）。
#   post  ＝after_compact：欄位 trigger、summary（Claude Code 寫好的摘要）；只是告知，什麼都改不了（PostCompact 沒有決定權）。
#   start ＝不發 hook：印提醒、handoff.md、compact_restore.txt（印完刪掉）。
#   補回的字放在 before_compact 而不是 after_compact：11-21 實測 claude 2.1.330 -p 的 /compact，SessionStart（compact）比 PostCompact 早跑
#   （transcript 裡 SessionStart 03:11:15.057、PostCompact 那次 hook 的檔 15.111），PostCompact 才交的字要等下一次壓縮才印得出來。
# 用法：python3 "$AOS_CLI_DEF/compact_hook" pre|post|start（stdin＝Claude Code 給的 hook JSON）。stdout：PreCompact＝摘要的指示、SessionStart＝注入壓縮後的上下文。
# 什麼錯都不擋 Claude：讀不到檔、aos-hook 叫不起來或報錯＝stderr 一行 warning、照沒有 hook 的樣子做，一律退 0；只有 hook 攔下 before_compact 才退 2。
import json
import os
import subprocess
import sys

LIMIT = 8000                                       # handoff.md 最多附這麼多字（太長只留尾巴，最新的通常在後面）
RESTORE = "compact_restore.txt"                    # before_compact 的 hook 交的補回字，放在 $AOS_STACK/claude/ 等 SessionStart 印
BLOCKED = 10                                       # aos-hook fire：被 hook 攔下

PRE = """When you write the summary, keep:
- the task you are working on and who asked for it (quote their words when they decided something);
- what is done, and every item still open, with the next step for each;
- the paths of files you wrote or changed, and of your handoff notes;
- letters you still owe an answer to (who, about what).
Leave out long tool output and file contents that can be read again."""

START = """[aos] compact: this conversation was just compacted. Before you go on, read your handoff notes again \
(the handoff file or session log your workspace's rules name%s) and carry on from the open items there."""


def warn(line):
    print("compact_hook: warning: %s" % line, file=sys.stderr)


def fire(event, data):
    """經 aos-hook 發 aos 的 hook 點；回 (退出碼, 結果物件或 None)。沒有定義夾、stack 或 aos-hook＝(None, None)，不發。"""
    home, cli_def, stack = (os.environ.get(k, "") for k in ("AOS_HOME", "AOS_CLI_DEF", "AOS_STACK"))
    if not (home and cli_def and stack):
        return None, None
    argv = [os.path.join(home, "bin", "aos-hook"), "fire", "--agent", cli_def, "--stack", stack, event]
    try:
        r = subprocess.run(argv, input=json.dumps(data, ensure_ascii=False), stdout=subprocess.PIPE, text=True)
    except OSError as e:
        warn("cannot run aos-hook for %s: %s" % (event, e))
        return None, None
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1]) if r.stdout.strip() else None
    except ValueError:
        out = None
    if r.returncode not in (0, BLOCKED) or not isinstance(out, dict):
        warn("aos-hook fire %s exited %d; going on as if no hook listened" % (event, r.returncode))
        return None, None
    return r.returncode, out


def keep_restore(restore):
    """before_compact 交的補回字寫進小格等 start 印；沒有（或被攔）＝刪掉上次留下的，免得下一次壓縮印出舊的。"""
    stack = os.environ.get("AOS_STACK", "")
    if not stack:
        return
    path = os.path.join(stack, "claude", RESTORE)
    try:
        if isinstance(restore, str) and restore.strip():
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(restore)
            os.replace(tmp, path)
        elif os.path.exists(path):
            os.unlink(path)
    except OSError as e:
        warn("cannot keep the restore text of before_compact in %s: %s" % (path, e))


def pre(given):
    asked = given.get("custom_instructions")
    code, out = fire("before_compact", {"trigger": given.get("trigger"), "asked": asked if isinstance(asked, str) else "",
                                        "instructions": PRE, "restore": None})
    if code == BLOCKED:
        keep_restore(None)
        text = (out.get("text") or "").strip()
        print("compact blocked by hook %s%s" % (out.get("hook"), (": " + text) if text else ""), file=sys.stderr)
        return 2
    keep_restore(out["data"].get("restore") if out else None)
    text = PRE if out is None else out["data"].get("instructions")
    if isinstance(text, str) and text.strip():
        print(text)
    return 0


def post(given):
    summary = given.get("compact_summary")
    fire("after_compact", {"trigger": given.get("trigger"), "summary": summary if isinstance(summary, str) else None})
    return 0


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return ""


def start():
    stack = os.environ.get("AOS_STACK", "")
    path = os.path.join(stack, "handoff.md") if stack else ""
    text = read(path) if path else ""
    print(START % ((", or %s" % path) if path else ""))
    if text.strip():
        if len(text) > LIMIT:
            text = "[... %d earlier characters left out ...]\n" % (len(text) - LIMIT) + text[-LIMIT:]
        print("\n===== %s =====\n%s" % (path, text.rstrip("\n")))
    restore_path = os.path.join(stack, "claude", RESTORE) if stack else ""
    restore = read(restore_path) if restore_path else ""
    if restore.strip():
        print("\n[aos] restored after compact:\n%s" % restore.rstrip("\n"))
    if restore_path and os.path.exists(restore_path):
        try:
            os.unlink(restore_path)                # 印過就不再印（下一次壓縮由那次的 hook 再交）
        except OSError as e:
            warn("cannot remove %s: %s" % (restore_path, e))
    return 0


def main():
    what = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        given = json.loads(sys.stdin.read() or "{}")
    except (OSError, ValueError):
        given = {}
    if not isinstance(given, dict):
        given = {}
    if what == "pre":
        return pre(given)
    if what == "post":
        return post(given)
    if what == "start":
        return start()
    return 0


sys.exit(main())
