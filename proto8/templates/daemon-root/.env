# .env - defaults for this root (a value already exported in the shell wins); every agent and child daemon inherits them.
AOS_CLOCK=${AOS_STACK}/clock
# llm kernel stack: the llms project next to this one, started with --stack stacks/llm; export AOS_LLM_KERNEL to point elsewhere.
AOS_LLM_KERNEL=${AOS_WS}/../llms/stacks/llm
# AOS_HOME is the proto8 folder these files point into; export it, or uncomment the next line and set it here.
# AOS_HOME=${HOME}/repo/aos/proto8
AOS_HOME=${AOS_HOME}
