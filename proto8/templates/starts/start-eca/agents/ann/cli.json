{"kind": "claude",
 "flags": ["--tools", "Read,Write,Edit,Glob,Grep,Bash,Agent,Skill", "--permission-mode", "dontAsk", "--allowedTools", "Read,Glob,Grep,Write,Edit,Bash", "--strict-mcp-config", "--no-chrome", "--setting-sources", "project,local"],
 "claude_mcp": ["user", "project", "local"],
 "tools_sub": "tools_sub.json",
 "timeout_ms": 0,
 "settings": {"hooks": {"PreCompact": [{"hooks": [{"type": "command", "command": "f=\"$AOS_HOME/templates/agents/eca-claude/compact_hook\"; [ -f \"$f\" ] && exec python3 \"$f\" pre; echo \"compact_hook: warning: $f is not a file\" >&2", "timeout": 60}]}],
                        "PostCompact": [{"hooks": [{"type": "command", "command": "f=\"$AOS_HOME/templates/agents/eca-claude/compact_hook\"; [ -f \"$f\" ] && exec python3 \"$f\" post; echo \"compact_hook: warning: $f is not a file\" >&2", "timeout": 60}]}],
                        "SessionStart": [{"matcher": "compact", "hooks": [{"type": "command", "command": "f=\"$AOS_HOME/templates/agents/eca-claude/compact_hook\"; [ -f \"$f\" ] && exec python3 \"$f\" start; echo \"compact_hook: warning: $f is not a file\" >&2", "timeout": 60}]}]},
              "skillOverrides": {"anthropic-skills:built-in-browser": "off",
                                 "anthropic-skills:chrome-browser": "off",
                                 "anthropic-skills:computer-use": "off",
                                 "anthropic-skills:deep-research": "off",
                                 "anthropic-skills:docs": "off",
                                 "anthropic-skills:docx": "off",
                                 "anthropic-skills:google-workspace": "off",
                                 "anthropic-skills:import-memory": "off",
                                 "anthropic-skills:morning": "off",
                                 "anthropic-skills:pdf": "off",
                                 "anthropic-skills:pptx": "off",
                                 "anthropic-skills:skill-creator": "off",
                                 "anthropic-skills:xlsx": "off",
                                 "cowork-plugin-management:cowork-plugin-customizer": "off",
                                 "cowork-plugin-management:create-cowork-plugin": "off"},
              "enabledPlugins": {"cc-plugin-easel@builtin": false,
                                 "claude-md-management@claude-plugins-official": false,
                                 "code-review@claude-plugins-official": false,
                                 "code-simplifier@claude-plugins-official": false,
                                 "commit-commands@claude-plugins-official": false,
                                 "context7@claude-plugins-official": false,
                                 "feature-dev@claude-plugins-official": false,
                                 "github@claude-plugins-official": false,
                                 "skill-creator@claude-plugins-official": false},
              "tui": "fullscreen"}}
