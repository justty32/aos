{
  "description": "Run the kernel once every 300 ms over kernel.json. The four aos-loop hook points (after_start, after_stop, before_run = before each round, after_run = after it) fire through aos-hook with the hooks of loop_hooks.json next to this file (no such file = no hooks); before_run / after_run only while their flag file is in the stack (hook_before_run.flag, hook_after_run.flag, set at start and by aos-hook check).",
  "exec": {
    "argv": [
      "aos-exec",
      {
        "$env": "AOS_HOME",
        "$path": "/lib/tools/aos/kernel"
      },
      {
        "$env": "AOS_CD",
        "$path": "kernel.json"
      }
    ]
  },
  "interval_ms": 300,
  "on_start": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--points",
      {
        "$env": "AOS_HOME",
        "$path": "/lib/aos/apps/hook/loop_points.json"
      },
      "--list",
      {
        "$env": "AOS_CD",
        "$path": "/loop_hooks.json"
      },
      "after_start"
    ]
  },
  "on_stop": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--points",
      {
        "$env": "AOS_HOME",
        "$path": "/lib/aos/apps/hook/loop_points.json"
      },
      "--list",
      {
        "$env": "AOS_CD",
        "$path": "/loop_hooks.json"
      },
      "after_stop"
    ]
  },
  "on_before_run": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--points",
      {
        "$env": "AOS_HOME",
        "$path": "/lib/aos/apps/hook/loop_points.json"
      },
      "--list",
      {
        "$env": "AOS_CD",
        "$path": "/loop_hooks.json"
      },
      "before_run"
    ]
  },
  "on_before_run_if": {
    "$env": "AOS_STACK",
    "$path": "/hook_before_run.flag"
  },
  "on_after_run": {
    "argv": [
      "aos-hook",
      "fire",
      "-q",
      "--points",
      {
        "$env": "AOS_HOME",
        "$path": "/lib/aos/apps/hook/loop_points.json"
      },
      "--list",
      {
        "$env": "AOS_CD",
        "$path": "/loop_hooks.json"
      },
      "after_run"
    ]
  },
  "on_after_run_if": {
    "$env": "AOS_STACK",
    "$path": "/hook_after_run.flag"
  }
}
