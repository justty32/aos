#!/usr/bin/env python3
"""aos-fsm（測試用的旁觀者，11-03）：proto8/tests 把這個資料夾放在 PATH 最前面，叫 aos-fsm 就先到這裡。

11-03 起真的 aos-fsm 不寫 trace.jsonl（使用者「整個拿掉」，thinking 2026-11-03-trace）；測試要看「跑了哪幾格、換到哪」，
就由這支在外面看：跑之前記 $AOS_STACK/stage.txt（沒有＝表的 start），fork＋exec 真的 aos-fsm（impls/aos-fsm/bin/），
跑完再看 stage.txt 有沒有被寫（inode、mtime、內容任一變了＝寫了），往 $FSM_SPY_LOG 接一行
{"stack": stack 的實際路徑, "state": 跑的那格, "code": aos-fsm 的結束碼, "next": 寫進 state 的名字、沒寫＝null}。
沒設 FSM_SPY_LOG＝不記，只轉交。訊號（SIGINT／SIGTERM／SIGHUP）轉給真的 aos-fsm；它被訊號停掉，這支也用同一個訊號結束。
只給測試用，不是 aos 的程式（fsm 自己不知道有人在看，C-52）。"""
import json, os, signal, sys

REAL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "impls", "aos-fsm", "bin", "aos-fsm")


def snap(path):
    try:
        st = os.stat(path)
        with open(path, encoding="utf-8", errors="replace") as f:
            return (st.st_ino, st.st_mtime_ns), f.read().strip()
    except OSError:
        return None, ""


def start_of(args):
    """表的 start（stage.txt 沒有或空的時候 fsm 從它起）；讀不出來＝"?"。"""
    try:
        cfg = args[-1].split("#", 1)[0]
        with open(cfg, encoding="utf-8") as f:
            s = json.load(f).get("start")
        return s if isinstance(s, str) else "?"
    except (OSError, ValueError, AttributeError, IndexError):
        return "?"


def main():
    args = sys.argv[1:]
    log = os.environ.get("FSM_SPY_LOG")
    stack = os.environ.get("AOS_STACK") or ""
    path = os.path.join(stack, "stage.txt")
    key0, s0 = snap(path)
    child = []                                  # fork 之前就接好訊號：fork 到接好之間收到也轉得到（exec 會把子行程的接法還原）
    got = []
    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, lambda n, _f: os.kill(child[0], n) if child else got.append(n))
    pid = os.fork()
    if pid == 0:
        os.execv(REAL, ["aos-fsm"] + args)
    child.append(pid)
    for n in got:
        os.kill(pid, n)
    while True:
        try:
            _, status = os.waitpid(pid, 0)
            break
        except InterruptedError:
            continue
    key1, s1 = snap(path)
    code = os.waitstatus_to_exitcode(status)
    if log and stack:
        line = {"stack": os.path.realpath(stack), "state": s0 or start_of(args), "code": code if code >= 0 else 128 - code,
                "next": s1 if key1 is not None and key1 != key0 else None}
        with open(log, "a", encoding="utf-8") as f:
            f.write(json.dumps(line, ensure_ascii=False) + "\n")
    if code < 0:
        signal.signal(-code, signal.SIG_DFL)
        os.kill(os.getpid(), -code)
    sys.exit(code)


main()
