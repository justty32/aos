import time
import urllib.parse
from datetime import datetime, timezone

sys.dont_write_bytecode = True  # never leave a __pycache__ next to zone.py in ~/aos-home

TOOLS = os.environ.get("VIEW_TOOLS") or os.path.expanduser("~/aos-home/ws/tools")   # VIEW_TOOLS: tests / demos with stub tools
AOS_USER = os.path.join(TOOLS, "aos-user", "aos-user")
ZONE_PY = os.path.join(TOOLS, "aos-user", "zone.py")
SAY_PREFIX = "[使用者經全景頁]"
SAY_FROM = "user-via-view"
# The page's own name, kept in one place (the user 11-15: it will be renamed). New code reads APP_NAME, never the
# literal; the frontend gets it from /api/version. PAGE_FROM is the neutral sender for new kinds of sends (compact).
APP_NAME = os.path.basename(os.path.realpath(__file__))    # follows the file name: rename the file, the name follows
# Path rule one (11-17): find the neighbours from this file's own place. The executable is <view>/bin/aos-frontend;
# ui/, aide-def/ and the rest live in <view>, one level up. SELF is the absolute path agents are told to run.
SELF = os.path.realpath(__file__)
