JS = """
let dirty=false;
document.addEventListener('input',()=>{dirty=true});
setInterval(()=>{const a=document.activeElement;
 if(!dirty && !(a && (a.tagName==='INPUT'||a.tagName==='TEXTAREA'))) location.replace(location.pathname+location.search.replace(/[?&]msg=[^&]*/,''));},30000);
"""


def page(title, body, token, refresh=True):
    return ("<!doctype html><html lang='zh-Hant'><head><meta charset='utf-8'>"
            "<meta name='viewport' content='width=device-width,initial-scale=1'>"
            "<title>%s</title><style>%s</style></head><body>%s%s</body></html>"
            % (esc(title), CSS, body, ("<script>%s</script>" % JS) if refresh else ""))


def hidden(token):
    return "<input type='hidden' name='token' value='%s'>" % esc(token)


def render_asks(zone, token):
    if not zone:
        return "<div class='card mut'>沒有在等你的信。</div>"
    out = []
    for z in zone:
        try:
            out.append(render_ask(z, token))
        except Exception as e:
            out.append("<div class='card ask'>這封信讀不懂（%s）：%s，請用 aos-user show 看</div>"
                       % (esc(type(e).__name__), esc(z.get("title"))))
    return "".join(out)


def render_ask(z, token):
    if True:
        cls = "card ask urgent" if z.get("urgent") else "card ask"
        h = ["<div class='%s'><div><b>%s</b> %s <span class='mut'>from %s · %s · %s%s</span></div>"
             % (cls, "❗" if z.get("urgent") else "", esc(z.get("title")), esc(z.get("from")), esc(z.get("kind")),
                ago(z.get("sent_at")), (" · deadline %s" % esc(z["deadline"])) if z.get("deadline") else "")]
        if z.get("risk") == "irreversible":
            h.append("<div class='why'>⚠️ 不可逆：每題都要親手選</div>")
        h.append("<details><summary class='mut'>內容</summary><pre>%s</pre>%s</details>"
                 % (esc(z.get("what")), ("<pre>%s</pre>" % esc(z["decide"])) if z.get("decide") else ""))
        if z.get("error"):
            return "".join(h) + "</div>"
        h.append("<form method='post' action='/answer'>%s<input type='hidden' name='letter' value='%s'>"
                 % (hidden(token), esc(z["letter"])))
        qs = z.get("questions") or []
        if qs:
            for q in qs:
                qid = q.get("id")
                h.append("<div class='q'><div><b>%s</b> %s</div><div class='eli5'>%s</div>"
                         % (esc(qid), esc(q.get("question")), esc(q.get("eli5"))))
                for o in q.get("options") or []:
                    k = o.get("key")
                    rec = k == q.get("recommend")
                    chk = " checked" if rec and z.get("risk") != "irreversible" else ""
                    h.append("<label class='opt'><input type='radio' name='q_%s' value='%s'%s> <b>%s</b> %s%s %s</label>"
                             % (esc(qid), esc(k), chk, esc(k), esc(o.get("label")),
                                " <span class='rec'>推薦</span>" if rec else "",
                                ("<span class='mut'>→ %s</span>" % esc(o.get("consequence"))) if o.get("consequence") else ""))
                if q.get("why"):
                    h.append("<div class='mut'>為什麼推薦：%s</div>" % esc(q.get("why")))
                h.append("</div>")
            h.append("<div>備註（可空）：<input type='text' name='note' style='width:70%'></div>"
                     "<button name='do' value='answer'>送出答案</button>")
        elif z.get("kind") == "fyi":
            h.append("<button name='do' value='ok'>知道了，收起來</button>")
        else:
            h.append("<div><textarea name='text' rows='2' style='width:95%' placeholder='用你的話回'></textarea></div>"
                     "<button name='do' value='reply'>回覆</button>")
        h.append("</form></div>")
        return "".join(h)


def render_node(k, nodes, token, depth=0):
    n = nodes[k]
    r = n["rollup"]
    icon = LIGHT_ICON[n["light"]]
    sub = ""
    if n["children"]:
        sub = " <span class='mut'>（底下 %d 個，最差 %s）</span>" % (r["nodes"] - 1, LIGHT_ICON[r["worst"]])
    reports = n.get("reports") or []
    last = reports[0] if reports else None
    head = ("%s <span class='nm'>%s</span>%s <span class='mut'>%s · %s · queue %s · 動靜 %s</span> "
            "<span class='why'>%s</span>"
            % (icon, esc(k), sub, esc(n["kind"]), esc(n.get("busy") or n.get("state")),
               esc(n.get("queued") if n.get("queued") is not None else "-"), ago(n.get("active_at")), esc(n["why"])))
    lines = []
    if n.get("note"):
        lines.append("<div class='line'>📝 隊長留話：<b>%s</b> %s <span class='mut'>%s</span></div>"
                     % (esc(n["note"].get("status")), esc(short(n["note"].get("text") or "", 200)),
                        ago(n["note"].get("at"))))
    if n.get("team_light"):
        lines.append("<div class='line why'>%s %s</div>" % (LIGHT_ICON[n["team_light"]["light"]],
                                                           esc(n["team_light"]["why"])))
    if last:
        lines.append("<div class='line'>📮 最近回報：<b>%s</b> <span class='mut'>%s</span></div>"
                     % (esc(last["title"]), ago(last["sent_at"])))
    if n.get("last_answer"):
        lines.append("<div class='line mut'>💬 最後一句：%s</div>" % esc(short(n["last_answer"], 200)))
    body = "".join(lines)
    tools = ""
    if n["kind"] == "agent":
        tools = ("<div class='body'><a href='/agent?name=%s'>看紀錄 →</a>"
                 "<form class='say' method='post' action='/say'>%s<input type='hidden' name='name' value='%s'>"
                 "<input type='text' name='text' placeholder='對 %s 說一句話（會加前綴「%s」）'>"
                 "<button>說</button></form></div>"
                 % (urllib.parse.quote(k), hidden(token), esc(k), esc(k), esc(SAY_PREFIX)))
    kids = "".join(render_node(c, nodes, token, depth + 1) for c in n["children"])
    open_ = " open" if (depth == 0 or r["worst"] in ("red", "blue")) else ""
    return ("<details class='node'%s><summary>%s</summary>%s%s%s</details>" % (open_, head, body, tools, kids))


def render_main(tree, err, token, msg=""):
    h = ["<header><h1>全景</h1>"]
    if tree:
        nodes = tree["nodes"]
        agents = [n for n in nodes.values() if n["kind"] == "agent"]
        red = [n for n in nodes.values() if n["light"] == "red"]
        yel = [n for n in nodes.values() if n["light"] == "yellow"]
        h.append("<div class='big'>%d<small>要你決定</small></div>" % len(tree["zone"]))
        h.append("<div class='big'>%d<small>🔴 出事</small></div>" % len(red))
        h.append("<div class='big'>%d<small>🟡 要留意</small></div>" % len(yel))
        h.append("<div class='big'>%d<small>agent 在跑（另有 proc %d、llm 工作 %d）</small></div>"
                 % (len([a for a in agents if (a.get("state") or "").lower() == "running"]),
                    len(nodes) - len(agents), tree["llm_workers"]))
        h.append("<div class='mut'>更新於 %s（每 20 秒；頁面 30 秒自動重整）</div>" % ago(tree["generated_at"]))
    h.append("</header>")
    if err:
        h.append("<div class='banner'>讀 daemon 表失敗：%s</div>" % esc(err))
    if msg:
        h.append("<div class='%s'>%s</div>" % ("banner" if msg.startswith("!") else "ok", esc(msg.lstrip("!"))))
    h.append("<main>")
    if not tree:
        h.append("<p>第一次讀取中，幾秒後重整。</p></main>")
        return page("全景", "".join(h), token)
    h.append("<h2>🔵 要你決定（%d）</h2>" % len(tree["zone"]))
    h.append(render_asks(tree["zone"], token))
    h.append("<h2>🏢 部門與員工</h2><div class='mut'>🔴 出事 🔵 等你 🟡 留意 🟢 正常 ⚪ 停了。"
             "有出事或等你的部門會自動展開。</div>")
    nodes = tree["nodes"]
    h.append("".join(render_node(k, nodes, token) for k in tree["roots"] if nodes[k]["kind"] == "agent"))
    procs = [k for k in tree["roots"] if nodes[k]["kind"] != "agent"]
    h.append("<h2>⚙️ 機房（普通 proc）</h2>")
    h.append("".join(render_node(k, nodes, token) for k in procs))
    h.append("<div class='leaf mut'>llm 單次工作 llm_* 現在 %d 個</div>" % tree["llm_workers"])
    h.append("<h2>📮 隊伍回覆（中轉信箱）</h2>")
    rel = tree["relay"][:15]
    if not rel:
        h.append("<div class='card mut'>還沒有。隊伍用 mailbox_send 寄到 box <code>%s</code> 就會出現在這裡。</div>"
                 % esc(os.path.expanduser("~/.aos/view/mailbox")))
    for x in rel:
        h.append("<div class='card'><b>%s</b> %s <span class='mut'>from %s · %s</span>"
                 "<details><summary class='mut'>內容</summary><pre>%s</pre></details></div>"
                 % (esc(x["status"] or ""), esc(x["title"]), esc(x["from"]), ago(x["sent_at"]), esc(x["what"])))
    h.append("</main>")
    return page("全景", "".join(h), token)


def render_agent(name, token, msg=""):
    st = run_json(["aos-agent", "ctl", "state", "-t", name, "all", "-j"], timeout=20)
    if st is None:
        return page(name, "<main><p>讀不到 %s。<a href='/classic'>← 回全景</a></p></main>" % esc(name), token, False)
    hist = run_json(["aos-agent", "history", "-t", name, "ls", "-j"], timeout=20) or []
    s = st.get("state") or {}
    res = st.get("resources") or {}
    who = st.get("who") or {}
    mb = st.get("mailbox") or {}
    h = ["<header><h1><a href='/classic'>← 全景</a>　%s</h1></header>" % esc(name)]
    if msg:
        h.append("<div class='%s'>%s</div>" % ("banner" if msg.startswith("!") else "ok", esc(msg.lstrip("!"))))
    h.append("<main>")
    h.append("<h2>現在</h2><div class='card'>狀態 <b>%s</b> · phase %s · queue %s · pid %s · 記憶體 %s MB · 上線 %s"
             "<div class='mut'>workspace %s</div><div class='line'>💬 最後一句：%s</div></div>"
             % (esc(s.get("state")), esc(s.get("phase")), esc(s.get("queued")), esc(res.get("pid")),
                esc(round((res.get("memory_bytes") or 0) / 1048576)),
                esc(((st.get("time") or {}).get("up_seconds") or 0) // 60) + " 分",
                esc(who.get("workspace") or who.get("ws")), esc(short(s.get("last_answer") or "", 400))))
    h.append("<form class='say' method='post' action='/say'>%s<input type='hidden' name='name' value='%s'>"
             "<input type='hidden' name='back' value='agent'>"
             "<input type='text' name='text' placeholder='對 %s 說一句話'><button>說</button></form>"
             % (hidden(token), esc(name), esc(name)))
    letters = mb.get("letters") or []
    h.append("<h2>信箱裡等著的（%d）</h2>" % (mb.get("waiting") or 0))
    for x in letters[:10]:
        h.append("<div class='card'><b>%s</b> %s <span class='mut'>from %s</span></div>"
                 % (esc(x.get("status")), esc(x.get("title")), esc(x.get("from"))))
    h.append("<h2>最近的紀錄（新的在上，最多 30 則）</h2>")
    for item in list(reversed(hist))[:30]:
        m = item.get("message") or {}
        role = m.get("role")
        content = m.get("content")
        if isinstance(content, list):
            content = " ".join(c.get("text", "") if isinstance(c, dict) else str(c) for c in content)
        tc = m.get("tool_calls") or []
        tools = ", ".join(((t.get("function") or {}).get("name") or t.get("name") or "?") for t in tc if isinstance(t, dict))
        extra = (" 🔧 " + esc(tools)) if tools else ""
        h.append("<div class='msg'><span class='role'>#%s %s</span>%s<div>%s</div></div>"
                 % (esc(item.get("line")), esc(role), extra, esc(short(content or "", 600))))
    h.append("</main>")
    return page(name, "".join(h), token, False)


# ---- actions -------------------------------------------------------------------------

def do_answer(form, tree, home):
    letter = form.get("letter", "")
    what = form.get("do", "")
    z = next((x for x in (tree or {}).get("zone", []) if x["letter"] == letter), None)
    if not z:
        return "!找不到這封信（可能已經回過了）"
    if re.match(r"^[0-9]{1,5}$", letter):
        return "!信名不對"
    for k in ("note", "text"):
        if form.get(k, "").strip().startswith("-"):
            return "!備註或回覆不能用「-」開頭（會被當成指令選項），請在前面加個字"
    if what == "answer":
        toks = []
        for q in z.get("questions") or []:
            v = form.get("q_" + str(q.get("id")))
            if not v:
                return "!第 %s 題還沒選" % q.get("id")
            toks.append("%s:%s%s" % (q.get("id"), v, "" if v == q.get("recommend") else "*"))
        args = [AOS_USER, "answer", letter] + toks
        if form.get("note", "").strip():
            args += ["--note", form["note"].strip()]
    elif what == "reply":
        if not form.get("text", "").strip():
            return "!回覆是空的"
        args = [AOS_USER, "reply", letter, form["text"].strip()]
    elif what == "ok":
        args = [AOS_USER, "ok", letter]
    else:
        return "!不認得的操作"
    code, out, err = run(args, timeout=30)
    log_sent(home, {"at": datetime.now().astimezone().isoformat(timespec="seconds"), "kind": "answer", "letter": letter,
                    "do": what, "args": args[2:], "ok": code == 0, "out": short(out or err, 300),
                    "title": z.get("title"), "from": z.get("from"), "kind_zone": z.get("kind")})
    if code != 0:
        return "!送出失敗：%s" % short(err or out, 300)
    if not re.match(r"^(answered|replied|put away|ok)", out.strip(), re.I):
        return "!不確定有沒有送出（aos-user 回：%s），請用 aos-user ls 確認" % short(out or err, 200)
    return "已送出：%s" % short(z.get("title"), 80)


def link_fields(form):
    """B5: optional batch / correction_of on say, mail, order (kept as given in sent.jsonl when well-formed)."""
    out = {}
    for k in ("batch", "correction_of"):
        v = form.get(k)
        if isinstance(v, str) and re.match(r"^[A-Za-z0-9._:-]{1,120}$", v):
            out[k] = v
    return out


def do_say(form, tree, home, ret=None):
    name = form.get("name", "")
    text = form.get("text", "").strip()
    nodes = (tree or {}).get("nodes", {})
    if name not in nodes or nodes[name]["kind"] != "agent":
        return "!不是表上的 agent：%s" % name
    if not text:
        return "!沒有內容"
    if len(text) > 4000:
        return "!太長了（上限 4000 字）"
    msg = "%s %s\n\n（要回覆請用 mailbox_send 寄到 box %s，title 開頭寫 [view-reply]；使用者久沒回時，先跑 %s board 看他的布告欄；這句是全景頁自動附的）" % (
        SAY_PREFIX, text, home.mailbox, SELF)
    code, out, err = run(["aos-agent", "say", "-t", name, "--from", SAY_FROM, "-"], timeout=20, stdin=msg)
    rec = {"at": datetime.now().astimezone().isoformat(timespec="seconds"), "kind": "say", "to": name, "text": text,
           "ok": code == 0, "letter": out.strip() if code == 0 else None, "error": None if code == 0 else short(err, 300)}
    rec.update(link_fields(form))
    log_sent(home, rec)
    DELIVERY_CACHE.pop(name, None)
    if ret is not None:
        ret["letter"] = rec["letter"]
    if code != 0:
        return "!說不出去：%s" % short(err or out, 300)
    return "已對 %s 說了（%s）" % (name, short(text, 60))


SLASH_CMDS = [
    {"name": name, "args": args, "confirm": confirm, "how": how, "cli": ["claude", "codex"]}
    for name, args, confirm, how in (("compact", "optional", False, "turn"), ("status", "none", False, "peek"),
                                     ("usage", "none", False, "peek"), ("goal", "optional", False, "turn"),
                                     ("clear", "none", True, "turn"), ("exit", "none", True, "turn"))
]
# how "peek" (11-16 ok-small): answered at once by `aos-agent peek` (the definition's screen entry), not through the queue:
# no letter, nothing in history, nothing typed into the screen, so it also answers while the agent is in a turn.
SLASH_CMDS.append({"name": "context", "args": "none", "confirm": False, "how": "screen", "cli": ["claude"]})   # aos-eca screen_slash.SCREEN_ONLY


def slash_commands():
    """Read the optional demo/test command list on every request, never cache it."""
    fx = os.environ.get("VIEW_SLASH_FIXTURE")
    return load_json(fx, []) if fx else SLASH_CMDS


def do_slash(form, tree, home, ret=None):
    return _send_slash(form, tree, home, "slash", ret)


def do_compact(form, tree, home):
    return _send_slash({"name": form.get("name", ""), "text": "/compact"}, tree, home, "compact")


def _send_slash(form, tree, home, kind, ret=None):
    """Validate once and send a bare command; compact keeps its original audit and UI contract."""
    name = form.get("name", "")
    nodes = (tree or {}).get("nodes", {})
    n = nodes.get(name)
    if not n or n["kind"] != "agent":
        return "!不是表上的 agent：%s" % name
    text = form.get("text", "").strip()
    if not text.startswith("/") or len(text.splitlines()) != 1 or len(text) > 1000:
        return "!指令要以 / 開頭、只有一行，上限 1000 字"
    words = text.split(maxsplit=1)
    command = words[0]
    spec = next((c for c in slash_commands() if c["name"] == command[1:]), None)
    if spec is None:
        return "!%s 目前送不進去" % command
    has_args = len(words) > 1
    if spec["args"] == "none" and has_args:
        return "!%s 後面不能有字" % command
    if spec["args"] == "required" and not has_args:
        return "!%s 後面要有內容" % command
    if (n.get("state") or "").lower() != "running":
        return "!%s 沒在跑（%s），送不進去" % (name, n.get("state") or "?")
    cli = (n.get("live") or {}).get("cli") or cli_kind(n.get("stack"))
    if not cli or cli not in spec["cli"]:
        return "!%s 不是這個指令支援的 CLI agent，%s 對它沒用" % (name, command)
    if kind == "slash" and spec.get("how") == "peek":
        return _peek_slash(name, text, home, ret)
    if kind == "compact" and n.get("queued"):
        return "!%s 信箱還排著 %d 封：%s 會跟它們併成一批而失效，等它讀完再按" % (name, n["queued"], command)
    with SLASH_LOCK if kind == "slash" else nullcontext():
        if kind == "slash":
            if ret is not None:
                ret["dup"] = False
            previous = next((r for r in slash_sent(home, name, 1800) if r["text"].strip() == text), None)
            if previous:
                # Sending must check fresh history, not the polling cache or the tree snapshot.
                SLASH_CACHE.pop(name, None)
                if slash_state(slash_rows(name), previous["letter"])[0] != "answered":
                    if ret is not None:
                        ret.update(dup=True, letter=previous["letter"])
                    return "%s 已在排隊（還沒回），不重送" % command
        code, out, err = run(["aos-agent", "say", "-t", name, "--from", PAGE_FROM, "-"], timeout=20, stdin=text)
        rec = {"at": now_local(), "kind": kind, "to": name, "text": text, "ok": code == 0,
               "letter": out.strip() if code == 0 else None, "error": None if code == 0 else short(err, 300)}
        log_sent(home, rec)
    DELIVERY_CACHE.pop(name, None)
    SLASH_CACHE.pop(name, None)
    if ret is not None:
        ret["letter"] = rec["letter"]
    if code != 0:
        return "!送不出去：%s" % short(err or out, 300)
    verb = "壓" if kind == "compact" else "做"
    later = "；它正在一輪裡，這一輪結束才會%s，這段時間別再對它說話" % verb if (n.get("live") or {}).get("in_turn") else ""
    if kind == "compact":
        return "已叫 %s 壓縮對話（/compact）%s" % (name, later)
    return "已把 %s 送進 %s 的畫面%s" % (command, name, later)


SLASH_LOCK = threading.Lock()
SLASH_CACHE = {}
PEEK_LOCK = threading.Lock()
PEEK = {}                     # letter -> {"state": "doing" | "answered" | "failed", "text": str}; finished ones also in state/peek.jsonl
PEEK_TIMEOUT = 300            # seconds; /usage is a separate claude -p run


def start_peek(fn):
    threading.Thread(target=fn, daemon=True).start()


def peek_file(home):
    return os.path.join(home.state, "peek.jsonl")


def _peek_slash(name, text, home, ret=None):
    """Answer /status or /usage with `aos-agent peek` in the background; the result shows in slash_results, not in history."""
    with PEEK_LOCK:
        for r in slash_sent(home, name, 1800):
            if r.get("how") == "peek" and r["text"].strip() == text and PEEK.get(r["letter"], {}).get("state") == "doing":
                if ret is not None:
                    ret.update(dup=True, letter=r["letter"])
                return "%s 還在做（還沒回），不重送" % text
        letter = "peek-%s-%s" % (datetime.now().strftime("%Y%m%d%H%M%S"), secrets.token_hex(4))
        PEEK[letter] = {"state": "doing", "text": ""}
        log_sent(home, {"at": now_local(), "kind": "slash", "how": "peek", "to": name, "text": text, "ok": True,
                        "letter": letter, "error": None})
    if ret is not None:
        ret.update(dup=False, letter=letter)

    def work():
        # Not run(): it holds CLI_LOCK for the whole call, and /usage can take many seconds.
        # Own process group: on timeout the whole chain (aos-agent, the screen entry, claude -p) goes, not only aos-agent.
        try:
            p = subprocess.Popen(["aos-agent", "peek", "-t", name, text], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 stdin=subprocess.DEVNULL, text=True, errors="replace", env=cli_env(), cwd="/",
                                 start_new_session=True)
            try:
                out, err = p.communicate(timeout=PEEK_TIMEOUT)
                code = p.returncode
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(p.pid, signal.SIGKILL)       # the group this call started (pgid = its pid)
                except OSError:
                    pass
                p.communicate()
                code, out, err = 124, "", "timeout after %ss" % PEEK_TIMEOUT
        except OSError as e:
            code, out, err = 127, "", str(e)
        except Exception as e:                            # never leave the request "doing" (it would block a resend)
            code, out, err = 1, "", "%s: %s" % (type(e).__name__, e)
        try:
            body = mask((out if code == 0 else (err or out)).strip() or "(no output)")
        except Exception as e:
            code, body = 1, "%s: %s" % (type(e).__name__, e)
        row = {"letter": letter, "state": "answered" if code == 0 else "failed",
               "text": body if len(body) <= 4000 else body[:3999] + "…"}
        with PEEK_LOCK:
            PEEK[letter] = row
            try:
                with open(peek_file(home), "a", encoding="utf-8") as f:
                    f.write(json.dumps(dict(row, at=now_local()), ensure_ascii=False) + "\n")
            except OSError:
                pass
    start_peek(work)
    return "%s 不用排隊，已在做；結果會出現在『指令結果』" % text


def peek_state(home, letter):
    """A peek request's state: in memory while this page runs, else the line in state/peek.jsonl, else unknown (page restarted mid-way)."""
    with PEEK_LOCK:
        row = PEEK.get(letter)
    if row is None:
        row = {"state": "unknown", "text": ""}
        try:
            with open(peek_file(home), encoding="utf-8") as f:
                for line in f:
                    try:
                        r = json.loads(line)
                    except ValueError:
                        continue
                    if isinstance(r, dict) and r.get("letter") == letter:
                        row = r
        except OSError:
            pass
        with PEEK_LOCK:
            row = PEEK.setdefault(letter, row)            # read the file once per letter, then from memory
    state = row.get("state")
    text = row.get("text") if isinstance(row.get("text"), str) else ""
    if state == "failed":
        return "answered", "（沒做成）" + text
    return (state if state in ("doing", "answered") else "unknown"), text


def slash_rows(name):
    """Read at most the last 300 history messages; cache each agent for two seconds."""
    t = time.time()
    c = SLASH_CACHE.get(name)
    if c and t - c["at"] < 2:
        return c["rows"]
    st = run_json(["aos-agent", "ctl", "state", "-t", name, "history", "-j"], timeout=8) or {}
    count = (st.get("history") or {}).get("messages")
    rows = None
    if isinstance(count, int) and not isinstance(count, bool) and count >= 0:
        rows = [] if count == 0 else run_json(
            ["aos-agent", "history", "-t", name, "ls", "-j", "%d-" % max(1, count - 299)], timeout=8)
        rows = rows[-300:] if isinstance(rows, list) else None
    SLASH_CACHE[name] = {"at": t, "rows": rows}
    return rows


def slash_state(rows, letter):
    """Match the official history letter metadata to a slash request and its answer."""
    if rows is None:
        return "unknown", ""
    doing = False
    for item in reversed(rows):
        m = item.get("message") or {}
        aos = m.get("aos") or {}
        if m.get("role") == "assistant" and letter in (aos.get("answer_to") or []):
            content = m.get("content")
            if isinstance(content, list):
                content = " ".join(c.get("text", "") if isinstance(c, dict) else str(c) for c in content)
            text = mask(content or "")
            return "answered", text if len(text) <= 4000 else text[:3999] + "…"
        if m.get("role") == "user" and aos.get("letter") == letter:
            doing = True
    return ("doing" if doing else "waiting"), ""


def slash_sent(home, name, seconds):
    """Successful page slash requests in the time window, newest first."""
    out, since = [], time.time() - seconds
    try:
        with open(os.path.join(home.state, "sent.jsonl"), encoding="utf-8") as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if (isinstance(r, dict) and r.get("kind") == "slash" and r.get("to") == name
                        and r.get("ok") and r.get("letter") and isinstance(r.get("text"), str)
                        and (parse_time(r.get("at")) or 0) >= since):
                    out.append(r)
    except OSError:
        pass
    return sorted(reversed(out), key=lambda r: parse_time(r["at"]), reverse=True)


def slash_results(home, name, node):
    """The ten most recent slash requests, with their current history reply state."""
    sent, peeked = [], set()
    for r in slash_sent(home, name, 86400):             # only the newest /status and /usage: they must not push queued ones out
        if r.get("how") == "peek":
            if r["text"].strip() in peeked:
                continue
            peeked.add(r["text"].strip())
        sent.append(r)
    sent = sent[:10]
    rows = slash_rows(name) if any(r.get("how") != "peek" for r in sent) else None
    items = []
    for r in sent:
        state, text = peek_state(home, r["letter"]) if r.get("how") == "peek" else slash_state(rows, r["letter"])
        items.append({"letter": r["letter"], "command": r["text"], "at": parse_time(r["at"]), "state": state, "text": text})
    return {"items": items, "in_turn": bool((node.get("live") or {}).get("in_turn"))}


def history_item(item):
    m = item.get("message") or {}
    content = m.get("content")
    if isinstance(content, list):
        content = " ".join(c.get("text", "") if isinstance(c, dict) else str(c) for c in content)
    content = mask(content or "")
    tc = m.get("tool_calls") or []
    tools = [((t.get("function") or {}).get("name") or t.get("name") or "?") for t in tc if isinstance(t, dict)]
    result = {"line": item.get("line"), "role": m.get("role"), "text": short(content, 600), "tools": tools}
    if m.get("role") == "assistant" and content.startswith("[aos] slash: /"):
        result["slash"] = content[len("[aos] slash: "):].split()[0].rstrip(":")
        result["text"] = content if len(content) <= 4000 else content[:3999] + "…"
    return result


def last_full(rows):
    """The most recent assistant text before the normal 600-character history preview."""
    for item in reversed(rows):
        m = item.get("message") or {}
        if m.get("role") == "assistant":
            content = m.get("content")
            if isinstance(content, list):
                content = " ".join(c.get("text", "") if isinstance(c, dict) else str(c) for c in content)
            text = mask(content or "")
            cut = len(text) > 4000
            return (text[:3999] + "…" if cut else text), cut
    return None, False


def cli_kind(stack):
    """claude / codex when the agent's stack has that CLI's cell folder (aos-eca keeps it at <stack>/<kind>)."""
    for k in ("claude", "codex"):
        if stack and os.path.isdir(os.path.join(stack, k)):
            return k
    return None


def quiet_of(stack):
    """<stack>/quiet.json, the shared "long quiet, not dead" mark (timeout-1115; writer and format: proto8/py/quiet.py).
    No file = nothing. Counts only while its pid is alive (pid null = not checked); a stale file from a killed writer is
    ignored. Read here, not imported, because this tool is deployed apart from the repo."""
    if not stack:
        return None
    try:
        with open(os.path.join(stack, "quiet.json"), encoding="utf-8") as f:
            rec = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(rec, dict) or rec.get("quiet") is not True:
        return None
    pid = rec.get("pid")
    if pid is not None:
        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
            return None
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return None
        except PermissionError:
            pass
    qs = rec.get("quiet_s")
    return {"what": str(rec.get("what") or ""), "since": rec.get("since"), "at": rec.get("at"),
            "quiet_s": qs if isinstance(qs, int) and not isinstance(qs, bool) else None}


def live_of(stack):
    """The CLI's live stream (<stack>/<kind>/live.jsonl, one stream-json event per line): when it last grew, and
    whether its last event leaves a turn open (anything but a "result"). Only a stat and the last 8 KB are read."""
    kind = cli_kind(stack)
    if not kind:
        return None
    p = os.path.join(stack, kind, "live.jsonl")
    try:
        stt = os.stat(p)
        with open(p, "rb") as f:
            f.seek(max(0, stt.st_size - 8192))
            tail = f.read().decode("utf-8", "replace")
    except OSError:
        return {"cli": kind, "at": None, "in_turn": False}
    typ = None
    for ln in reversed(tail.splitlines()):
        ln = ln.strip()
        if not ln:
            continue
        try:
            typ = (json.loads(ln) or {}).get("type")
        except (ValueError, AttributeError):
            continue
        break
    return {"cli": kind, "at": stt.st_mtime, "in_turn": typ is not None and typ != "result"}


def log_sent(home, rec):
    """One line per thing the user sent: state/sent.jsonl (for threads) and the say log (audit)."""
    line = json.dumps(rec, ensure_ascii=False) + "\n"
    for path in {os.path.join(home.state, "sent.jsonl"), home.say_log()}:
        try:
            with open(path, "a", encoding="utf-8") as f:
                f.write(line)
        except OSError:
            pass


def read_sent(home, name=None, limit=200):
    out = []
    try:
        with open(os.path.join(home.state, "sent.jsonl"), encoding="utf-8") as f:
            lines = f.readlines()[-2000:]
    except OSError:
        return out
    for ln in lines:
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        if r.get("kind") not in ("say", "mail", "order") or not r.get("ok"):
            continue
        if name and r.get("to") != name:
            continue
        out.append({"dir": "out", "kind": r.get("kind"), "order": r.get("order"), "letter": r.get("letter"), "from": "user", "to": r.get("to"),
                    "status": r.get("status"), "title": r.get("title") or "(說話)", "what": r.get("text") or "",
                    "sent_at": parse_time(r.get("at")), "in_reply_to": None,
                    "batch": r.get("batch"), "correction_of": r.get("correction_of")})
    return out[-limit:]


DELIVERY_CACHE = {}


def msg_text(m):
    c = (m or {}).get("content")
    return c if isinstance(c, str) else json.dumps(c, ensure_ascii=False)


def delivery(name, outs, ins, now=None):
    """Delivery state of what the user sent to NAME (last 7 days), from official commands only:
    replied = a relay letter answers it (in_reply_to), or for a say, NAME wrote to the relay after it;
    queued / read = a mail still in / gone from `ctl state mailbox`; a say not yet / already in `history ls`.
    Cached 15 s per agent. Sets x["delivery"] to queued|read|replied|unknown (null for older items)."""
    now = now or time.time()
    recent = [o for o in outs if o.get("letter") and (o.get("sent_at") or 0) > now - 7 * 86400]
    if not recent:
        return None
    replied = {x.get("in_reply_to") for x in ins if x.get("in_reply_to")}
    from_times = sorted(x.get("sent_at") or 0 for x in ins if x.get("from") == name)
    need = [o for o in recent if o["letter"] not in replied and not (o["kind"] == "say" and any(t > (o.get("sent_at") or 0) for t in from_times))]
    c = DELIVERY_CACHE.get(name)
    if need and (not c or now - c["at"] > 15):
        st = run_json(["aos-agent", "ctl", "state", "-t", name, "state", "mailbox", "history", "-j"], timeout=8) or {}
        mb = st.get("mailbox") or {}
        waiting = [r.get("letter") for r in mb.get("letters") or []] if "waiting" in mb else None
        queued = (st.get("state") or {}).get("queued")
        texts = None
        count = (st.get("history") or {}).get("messages")
        if isinstance(count, int) and any(o["kind"] == "say" for o in need):
            h = run_json(["aos-agent", "history", "-t", name, "ls", "-j", "%d-" % max(1, count - 300)], timeout=8)
            if isinstance(h, list):
                texts = [msg_text(r.get("message")) for r in h if (r.get("message") or {}).get("role") == "user"]
        c = DELIVERY_CACHE[name] = {"at": now, "waiting": waiting, "texts": texts, "queued": queued}
    c = c or {"waiting": None, "texts": None, "queued": None}
    for o in recent:
        if o not in need:
            o["delivery"] = "replied"
        elif o["kind"] == "say":
            key = (o.get("what") or "")[:80]
            o["delivery"] = "unknown" if c["texts"] is None else (
                "read" if any(SAY_PREFIX in t and key in t for t in c["texts"]) else "queued")
        else:
            o["delivery"] = "unknown" if c["waiting"] is None else ("queued" if o["letter"] in c["waiting"] else "read")
    # queue position (approximate for a say: the queue is FIFO, so what I said later and is still queued is behind it)
    q = c.get("queued")
    later = 0
    for o in sorted(recent, key=lambda x: x.get("sent_at") or 0, reverse=True):
        if o.get("delivery") != "queued":
            continue
        if o["kind"] == "say" and isinstance(q, int):
            o["queue_ahead"] = max(0, q - later - 1)
            later += 1
        elif o["kind"] != "say" and c["waiting"] is not None:
            o["queue_ahead"] = c["waiting"].index(o["letter"])
    return {"queued": q}


def read_answered(home, hours=24):
    """What the user answered on the page in the last HOURS (state/sent.jsonl, kind answer, ok), newest first."""
    out, since = [], time.time() - hours * 3600
    try:
        with open(os.path.join(home.state, "sent.jsonl"), encoding="utf-8") as f:
            lines = f.readlines()[-2000:]
    except OSError:
        return out
    for ln in lines:
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        at = parse_time(r.get("at"))
        if r.get("kind") != "answer" or not r.get("ok") or not at or at < since:
            continue
        out.append({"letter": r.get("letter"), "at": at, "do": r.get("do"), "title": r.get("title"), "from": r.get("from"),
                    "answers": [a for a in (r.get("args") or []) if a not in ("--note", r.get("letter"))], "out": r.get("out")})
    fix = {}
    for o in read_sent(home, None, 2000):
        if o.get("correction_of") and o.get("letter"):
            fix.setdefault(o["correction_of"], []).append(o["letter"])
    for a in out:
        a["corrections"] = fix.get(a["letter"], [])
    return out[::-1][:50]


MAIL_STATUS = ("REQUEST", "DONE", "BLOCKED", "NEEDS-USER", "FAILED", "PROGRESS")


def do_mail(form, tree, home, extra=None, kind="mail"):
    name = form.get("name", "")
    nodes = (tree or {}).get("nodes", {})
    n = nodes.get(name)
    if not n or n["kind"] != "agent" or not n.get("stack"):
        return False, "!不是表上的 agent：%s" % name, None
    status = form.get("status") or "REQUEST"
    title = (form.get("title") or "").strip()
    what = (form.get("what") or "").strip()
    if status not in MAIL_STATUS:
        return False, "!status 不對", None
    if not title or not what:
        return False, "!title 和內容都要填", None
    if len(title) > 300 or len(what) > 20000:
        return False, "!太長了", None
    box = os.path.join(n["stack"], "mailbox")
    body = {"from": "user", "to": name, "status": status, "title": title, "what": what,
            "outputs": "none", "not_done": "none", "decide": "none", "via": "aos-frontend",
            "note": "sent by the user from the panorama page; reply with mailbox_send to box %s. "
                    "If the user does not answer for long, read the user's board: %s board" % (home.mailbox, SELF)}
    if extra:
        body.update(extra)
    # an agent's mailbox is made on first use (aos-mailbox send --to does the same); aos-post send never makes one
    if not os.path.isdir(os.path.join(box, "new")):
        code, out, err = run(["aos-post", "init", box])
        if code != 0:
            return False, "!寄不出去：%s" % short(err or out or "aos-post init failed", 300), None
    env = cli_env()
    env["AOS_STACK"] = home.dir
    with CLI_LOCK:
        try:
            p = subprocess.run(["aos-post", "send", "--reply-to", home.mailbox, box], input=json.dumps(body, ensure_ascii=False),
                               capture_output=True, text=True, timeout=20, env=env, cwd="/")
            code, out, err = p.returncode, p.stdout, p.stderr
        except (subprocess.TimeoutExpired, OSError) as e:
            code, out, err = 1, "", str(e)
    rec = {"at": datetime.now().astimezone().isoformat(timespec="seconds"), "kind": kind, "to": name,
           "order": (extra or {}).get("order"), "status": status, "title": title, "text": what, "ok": code == 0,
           "letter": out.strip() if code == 0 else None, "error": None if code == 0 else short(err, 300)}
    rec.update(link_fields(form))
    log_sent(home, rec)
    DELIVERY_CACHE.pop(name, None)
    if code != 0:
        return False, "!寄不出去：%s" % short(err or out, 300), None
    return True, "已寄給 %s：%s" % (name, short(title, 60)), out.strip()


ORDER_KINDS = {
    # kind: (default receiver; None = the target department itself, label)
    "expand": (None, "擴充部門"),
    "hire": ("repo-aos", "HR：增派人員"),
    "power": ("repo-aos", "電力：llm 額度"),
}
ORDER_FIELDS = {"expand": ("budget",), "hire": ("role", "model", "count"), "power": ("priority", "quota")}


def do_order(form, tree, home):
    """A chairman's order = one REQUEST letter to whoever takes that kind of order (config orders.<kind>.to).
    The page itself never changes the tree; the receiver does the work through its own rules (gate)."""
    kind = form.get("kind", "")
    target = form.get("target", "")
    nodes = (tree or {}).get("nodes", {})
    if kind not in ORDER_KINDS:
        return False, "!不認得的指令種類：%s" % kind, None
    if target not in nodes:
        return False, "!表上沒有這個部門：%s" % target, None
    what = (form.get("what") or "").strip()
    if not what:
        return False, "!要寫清楚要什麼", None
    conf = ((home.config().get("orders") or {}).get(kind) or {})
    to = conf.get("to") or ORDER_KINDS[kind][0] or target
    order = {"kind": kind, "target": target}
    for k in ORDER_FIELDS[kind]:
        v = form.get(k)
        if v not in (None, ""):
            order[k] = str(v)[:200]
    detail = "".join("\n- %s: %s" % (k, v) for k, v in order.items())
    f = {"name": to, "status": "REQUEST", **link_fields(form),
         "title": "[董事長指令:%s] %s：%s" % (kind, target, short(what, 80)),
         "what": "使用者從全景頁下的指令（%s）。%s\n\n%s\n\n要掛新 agent 或動樹的，照你自己的規矩走 gate；做完或卡住請回信。"
                 % (ORDER_KINDS[kind][1], detail, what)}
    return do_mail(f, tree, home, extra={"order": order}, kind="order")


def agent_json(name):
    st = run_json(["aos-agent", "ctl", "state", "-t", name, "all", "-j"], timeout=20)
    if st is None:
        return None
    hist = run_json(["aos-agent", "history", "-t", name, "ls", "-j"], timeout=20) or []
    s = st.get("state") or {}
    res = st.get("resources") or {}
    who = st.get("who") or {}
    mb = st.get("mailbox") or {}
    items = [history_item(item) for item in list(reversed(hist))[:30]]
    full, cut = last_full(hist)
    return {"name": name,
            "now": {"state": s.get("state"), "phase": s.get("phase"), "queued": s.get("queued"), "busy": None,
                    "pid": res.get("pid"), "memory_mb": round((res.get("memory_bytes") or 0) / 1048576),
                    "up_min": ((st.get("time") or {}).get("up_seconds") or 0) // 60,
                    "workspace": who.get("workspace") or who.get("ws"),
                    "last_answer": mask(s.get("last_answer")) if s.get("last_answer") else None,
                    "last_answer_full": full, "last_answer_cut": cut},
            "mailbox": {"waiting": mb.get("waiting") or 0,
                        "letters": [{"status": x.get("status"), "title": mask(x.get("title")), "from": x.get("from"),
                                     "sent_at": parse_time(x.get("sent_at"))} for x in (mb.get("letters") or [])[:20]]},
            "history": items}


# ---- server --------------------------------------------------------------------------

HERE_DIR = VIEW_DIR   # the frontend folder (bin/ is one level below it)
# the frontend served: ui/v1 (frozen 11-14, "清單版"); --ui DIR serves another one (the old web/ is kept, not served)
WEB_DIR = os.path.join(HERE_DIR, "ui", "v1") if os.path.isdir(os.path.join(HERE_DIR, "ui", "v1")) else os.path.join(HERE_DIR, "web")
STATIC = {"/": ("index.html", "text/html; charset=utf-8"), "/index.html": ("index.html", "text/html; charset=utf-8"),
          "/app.js": ("app.js", "text/javascript; charset=utf-8"), "/map.js": ("map.js", "text/javascript; charset=utf-8"), "/style.css": ("style.css", "text/css; charset=utf-8")}
CSP = ("default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; "
       "form-action 'self'; frame-ancestors 'none'; base-uri 'none'")


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = APP_NAME + "/0"

    def log_message(self, fmt, *a):
        pass

    def host_ok(self):
        port = self.server.server_address[1]
        return self.headers.get("Host", "") in ("127.0.0.1:%d" % port, "localhost:%d" % port)

    def common_headers(self, ctype, length, cookie=False, csp=None):
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(length))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "same-origin")
        if csp:
            self.send_header("Content-Security-Policy", csp)
        if cookie:
            self.send_header("Set-Cookie", "aosview=%s; Path=/; HttpOnly; SameSite=Strict" % self.server.token)

    def send_html(self, s, code=200, cookie=False):
        b = s.encode("utf-8")
        self.send_response(code)
        self.common_headers("text/html; charset=utf-8", len(b), cookie,
                            "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(b)

    def send_json(self, obj, code=200, cookie=False, etag=None):
        tick = getattr(self.server.collector, "tick", {}).get("at")
        if etag:
            etag = '"%s"' % etag
            if self.headers.get("If-None-Match") == etag:
                self.send_response(304)
                self.send_header("ETag", etag)
                self.send_header("Cache-Control", "no-cache")
                if tick:
                    self.send_header("X-Last-Tick", "%.3f" % tick)
                self.end_headers()
                return
        b = json.dumps(obj, ensure_ascii=False, default=str).encode("utf-8")
        self.send_response(code)
        self.common_headers("application/json; charset=utf-8", len(b), cookie)
        if etag:
            self.send_header("ETag", etag)
        if tick:
            self.send_header("X-Last-Tick", "%.3f" % tick)
        self.end_headers()
        self.wfile.write(b)

    def fail(self, code, err, message):
        return self.send_json({"ok": False, "error": err, "message": message}, code)

    def redirect(self, where):
        self.send_response(303)
        self.send_header("Location", where)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def static(self, path):
        fn, ctype = STATIC[path]
        try:
            with open(os.path.join(WEB_DIR, fn), "rb") as f:
                b = f.read()
        except OSError:
            if path in ("/", "/index.html"):
                return self.redirect("/classic")
            return self.fail(404, "NotFound", "no such file")
        self.send_response(200)
        self.common_headers(ctype, len(b), cookie=(fn == "index.html"), csp=CSP)
        self.end_headers()
        self.wfile.write(b)

    def do_GET(self):
        if not self.host_ok():
            return self.send_html("bad host", 403)
        u = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(u.query)
        arg = lambda k: (q.get(k) or [""])[0]
        tree, err = self.server.collector.get()
        nodes = (tree or {}).get("nodes", {})
        ui = getattr(self.server, "ui", None)
        if ui and not u.path.startswith("/api/"):
            return self.static_v2(ui, u.path)
        if u.path in STATIC and not ui:
            return self.static(u.path)
        revs = revs_of(self.server, tree)
        if u.path == "/api/session":
            return self.send_json({"token": self.server.token, "version": "view-api/0"}, cookie=True)
        if u.path == "/api/tree":
            if tree:
                t = {k: v for k, v in tree.items() if k not in ("zone", "relay")}
                t["nodes"] = {k: public_node(v) for k, v in nodes.items()}
            else:
                t = None
            return self.send_json({"tree": t, "error": err}, etag=None if err else revs["tree"])
        if u.path == "/api/version":
            d = ui["dir"] if ui else WEB_DIR
            vdir = os.path.dirname(d) if os.path.basename(d) == "dist" else d
            try:
                with open(os.path.join(vdir, "VERSION"), encoding="utf-8") as f:
                    uiv = f.read().strip()
            except OSError:
                uiv = None
            return self.send_json({"api": "view-api/0", "ui": uiv, "ui_dir": os.path.basename(vdir), "app": APP_NAME})
        if u.path == "/api/pulse":
            ob = self.server.ob()
            ob.pulse_at = time.time()
            ob.kick_if_old()
            return self.send_json({"now": time.time(), "tick": self.server.collector.tick, "rev": revs,
                                   "ext_checked_at": ext_checked_at(tree), "error": err})
        if u.path == "/api/outbox":
            ob = self.server.ob()
            ob.kick_if_old()
            try:
                days = max(1, min(7, int(arg("days") or 7)))
            except ValueError:
                days = 7
            items = ob.items(tree, days)
            return self.send_json({"items": items, "checked_at": ob.checked_at}, etag=revs["outbox"] if days == 7 else None)
        if u.path == "/api/ui-state":
            key = arg("key")
            if key not in UI_KEYS:
                return self.fail(400, "KeyBad", "key must be one of %s" % ", ".join(UI_KEYS))
            return self.send_json(ui_get(self.server.home, key))
        if u.path == "/api/answered":
            return self.send_json({"answered": read_answered(self.server.home)}, etag=revs["answered"])
        if u.path == "/api/board":
            return self.send_json({"user": board_get(self.server.home)}, etag=revs["board"])
        if u.path == "/api/asks":
            return self.send_json({"asks": (tree or {}).get("zone", [])}, etag=revs["asks"])
        if u.path == "/api/slash":
            return self.send_json({"commands": slash_commands()})
        if u.path == "/api/slash_results":
            name = arg("name")
            node = nodes.get(name)
            if not node or node.get("kind") != "agent":
                return self.fail(400, "NodeMissing", "不是表上的 agent：%s" % name)
            return self.send_json(slash_results(self.server.home, name, node))
        if u.path == "/api/orders":
            conf = self.server.home.config().get("orders") or {}
            return self.send_json({"kinds": [{"kind": k, "label": v[1], "to": (conf.get(k) or {}).get("to") or v[0],
                                              "fields": list(ORDER_FIELDS[k])} for k, v in ORDER_KINDS.items()]})
        if u.path == "/api/relay":
            return self.send_json({"letters": (tree or {}).get("relay", [])}, etag=revs["relay"])
        if u.path == "/api/thread":
            name = arg("name")
            if name not in nodes:
                # B5: a department that left the tree still has its history; answers still go to its mailbox
                if not NAME_RE.match(name or ""):
                    return self.fail(404, "NodeMissing", "表上沒有 %s" % name)
                ins = [x for x in self.server.collector.relay_letters() if x["from"] == name]
                outs = read_sent(self.server.home, name)
                if not ins and not outs:
                    return self.fail(404, "NodeMissing", "表上沒有 %s" % name)
                items = sorted(ins + outs, key=lambda x: x.get("sent_at") or 0, reverse=True)[:50]
                return self.send_json({"name": name, "letters": items, "turn": None, "gone": True})
            ins = [x for x in self.server.collector.relay_letters() if x["from"] == name]
            outs = read_sent(self.server.home, name)
            out_ids = {o["letter"] for o in outs if o.get("letter")}
            ins += [x for x in self.server.collector.relay_letters()
                    if x["from"] != name and x.get("in_reply_to") in out_ids]
            n = nodes[name]
            if n["kind"] == "agent":
                delivery(name, outs, ins)
            items = sorted(ins + outs, key=lambda x: x.get("sent_at") or 0, reverse=True)[:50]
            turn = None
            if n["kind"] == "agent" and (n.get("state") or "").lower() == "running" and (n.get("queued") or n.get("busy")):
                turn = {"queued": n.get("queued") or 0, "busy": n.get("busy"), "active_at": n.get("active_at"), "why": n.get("why")}
            return self.send_json({"name": name, "letters": items, "turn": turn})
        if u.path == "/api/agent":
            name = arg("name")
            if name not in nodes or nodes[name]["kind"] != "agent":
                return self.fail(404, "NodeMissing", "不是表上的 agent：%s" % name)
            a = agent_json(name)
            if a is None:
                return self.fail(502, "StateFailed", "讀不到 %s 的狀態" % name)
            a["now"]["busy"] = nodes[name].get("busy")
            return self.send_json(a)
        # classic server-rendered page (fallback)
        if u.path == "/classic":
            return self.send_html(render_main(tree, err, self.server.token, arg("msg")), cookie=True)
        if u.path == "/agent":
            name = arg("name")
            if name not in nodes or nodes[name]["kind"] != "agent":
                return self.send_html(page("?", "<main>不是表上的 agent。<a href='/classic'>← 回全景</a></main>",
                                           self.server.token, False), 404)
            return self.send_html(render_agent(name, self.server.token, arg("msg")), cookie=True)
        self.fail(404, "NotFound", "no such path")

    def static_v2(self, ui, path):
        """B1: the v2 build (ui/v2/dist): index.html at / (no-store), hashed /assets/<name> (immutable)."""
        if path in ("/", "/index.html"):
            fn, cache, cookie = os.path.join(ui["dir"], "index.html"), "no-store", True
        elif path.startswith("/assets/") and V2_ASSET_RE.match(path[8:]) and ".." not in path:
            fn, cache, cookie = os.path.join(ui["dir"], "assets", path[8:]), "max-age=31536000, immutable", False
        elif V2_ASSET_RE.match(path[1:] or "-") and ".." not in path and os.path.splitext(path)[1] in (".svg", ".png"):
            fn, cache, cookie = os.path.join(ui["dir"], path[1:]), "no-cache", False
        else:
            return self.fail(404, "NotFound", "no such path")
        ext = ".html" if fn.endswith("index.html") else os.path.splitext(fn)[1]
        ctype = "text/html; charset=utf-8" if ext == ".html" else V2_MIME.get(ext)
        if not ctype:
            return self.fail(404, "NotFound", "no such file type")
        try:
            with open(fn, "rb") as f:
                b = f.read()
        except OSError:
            return self.fail(404, "NotFound", "no such file")
        self.send_response(200)
        self.common_headers(ctype, len(b), cookie=cookie, csp=CSP)
        self.send_header("Cache-Control", cache)
        self.end_headers()
        self.wfile.write(b)

    def checked_body(self):
        """Host, Origin, size, JSON content type, token header + cookie (same rules as POST /api/*).
        Returns the parsed JSON object, or None after sending the error."""
        if not self.host_ok():
            self.send_html("bad host", 403)
            return None
        origin = self.headers.get("Origin")
        port = self.server.server_address[1]
        if origin and origin not in ("http://127.0.0.1:%d" % port, "http://localhost:%d" % port):
            self.fail(403, "OriginBad", "bad origin")
            return None
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > UI_MAX:
            self.fail(413, "TooBig", "too big")
            return None
        raw = self.rfile.read(n).decode("utf-8", "replace")
        if not (self.headers.get("Content-Type") or "").startswith("application/json"):
            self.fail(415, "JsonRequired", "Content-Type must be application/json")
            return None
        cookie = self.headers.get("Cookie", "")
        ck = dict(p.strip().split("=", 1) for p in cookie.split(";") if "=" in p).get("aosview") or ""
        tb = self.server.token.encode()
        given = self.headers.get("X-View-Token", "")
        if not (secrets.compare_digest(str(given).encode(), tb) and ck and secrets.compare_digest(ck.encode(), tb)):
            self.fail(403, "TokenBad", "頁面太舊了，重新整理一次")
            return None
        try:
            body = json.loads(raw or "null")
        except ValueError:
            self.fail(400, "JsonBad", "body is not JSON")
            return None
        return {"body": body}

    def do_PUT(self):
        """B4: PUT /api/ui-state?key=K. seen / dismissed: body = a diff {id: epoch | null}, merged (12.8 #10);
        seats / prefs: body = the whole value (last write wins)."""
        u = urllib.parse.urlparse(self.path)
        if u.path != "/api/ui-state":
            if not self.host_ok():
                return self.send_html("bad host", 403)
            return self.fail(404, "NotFound", "no such path")
        got = self.checked_body()
        if got is None:
            return
        key = (urllib.parse.parse_qs(u.query).get("key") or [""])[0]
        if key not in UI_KEYS:
            return self.fail(400, "KeyBad", "key must be one of %s" % ", ".join(UI_KEYS))
        ok, res = ui_put(self.server.home, key, got["body"])
        if not ok:
            return self.fail(400, "ValueBad", res)
        return self.send_json(res)

    def do_POST(self):
        if not self.host_ok():
            return self.send_html("bad host", 403)
        origin = self.headers.get("Origin")
        port = self.server.server_address[1]
        if origin and origin not in ("http://127.0.0.1:%d" % port, "http://localhost:%d" % port):
            return self.fail(403, "OriginBad", "bad origin")
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > 65536:
            return self.fail(413, "TooBig", "too big")
        raw = self.rfile.read(n).decode("utf-8", "replace")
        cookie = self.headers.get("Cookie", "")
        ck = dict(p.strip().split("=", 1) for p in cookie.split(";") if "=" in p).get("aosview") or ""
        tb = self.server.token.encode()
        u = urllib.parse.urlparse(self.path).path
        is_api = u.startswith("/api/")
        if is_api:
            if not (self.headers.get("Content-Type") or "").startswith("application/json"):
                return self.fail(415, "JsonRequired", "Content-Type must be application/json")
            try:
                form = json.loads(raw or "{}")
                assert isinstance(form, dict)
            except (ValueError, AssertionError):
                return self.fail(400, "JsonBad", "body is not a JSON object")
            given = self.headers.get("X-View-Token", "")
        else:
            form = {k: v[0] for k, v in urllib.parse.parse_qs(raw).items()}
            given = form.get("token", "")
        if not (secrets.compare_digest(str(given).encode(), tb) and ck and secrets.compare_digest(ck.encode(), tb)):
            return self.fail(403, "TokenBad", "頁面太舊了，重新整理一次") if is_api else self.send_html("bad token (reload the page)", 403)
        tree, _ = self.server.collector.get()
        home = self.server.home
        if is_api:
            for k in ("letter", "do", "note", "text", "name", "status", "title", "what"):
                if k in form and not isinstance(form[k], str):
                    return self.fail(400, "ArgumentsBad", "%s must be a string" % k)
        if u == "/api/answer":
            f = {"letter": form.get("letter", ""), "do": form.get("do", ""), "note": form.get("note", ""),
                 "text": form.get("text", "")}
            ans = form.get("answers") or {}
            if not isinstance(ans, dict):
                return self.fail(400, "ArgumentsBad", "answers must be an object")
            for k, v in ans.items():
                f["q_" + str(k)] = str(v)
            msg = do_answer(f, tree, home)
            if not msg.startswith("!"):
                self.server.collector.drop_ask(f["letter"])
            threading.Thread(target=self.server.refresh, daemon=True).start()
            return self.send_json({"ok": not msg.startswith("!"), "message": msg.lstrip("!")},
                                  200 if not msg.startswith("!") else 400)
        if u == "/api/say":
            ret = {}
            msg = do_say(form, tree, home, ret)
            self.server.ob().sent(form.get("name"))
            return self.send_json({"ok": not msg.startswith("!"), "message": msg.lstrip("!"), "letter": ret.get("letter")},
                                  200 if not msg.startswith("!") else 400)
        if u == "/api/slash":
            ret = {}
            msg = do_slash(form, tree, home, ret)
            self.server.ob().sent(form.get("name"))
            return self.send_json({"ok": not msg.startswith("!"), "message": msg.lstrip("!"), "letter": ret.get("letter"),
                                   "dup": ret.get("dup", False)},
                                  200 if not msg.startswith("!") else 400)
        if u == "/api/compact":
            msg = do_compact(form, tree, home)
            self.server.ob().sent(form.get("name"))
            return self.send_json({"ok": not msg.startswith("!"), "message": msg.lstrip("!")},
                                  200 if not msg.startswith("!") else 400)
        if u == "/api/board":
            if "back" in form and not isinstance(form["back"], str):
                return self.fail(400, "ArgumentsBad", "back must be a string")
            ok, msg = do_board(form, home)
            log_sent(home, {"at": now_local(), "kind": "board", "to": "board", "text": form.get("text", ""),
                            "back": form.get("back"), "ok": ok, "letter": None, "error": None if ok else msg})
            return self.send_json({"ok": ok, "message": msg.lstrip("!"), "user": board_get(home)}, 200 if ok else 400)
        if u == "/api/mail":
            ok, msg, letter = do_mail(form, tree, home)
            self.server.ob().sent(form.get("name"))
            return self.send_json({"ok": ok, "message": msg.lstrip("!"), "letter": letter}, 200 if ok else 400)
        if u == "/api/order":
            for k in ("kind", "target", "role", "model", "count", "priority", "quota", "budget"):
                if k in form and not isinstance(form[k], (str, int)):
                    return self.fail(400, "ArgumentsBad", "%s must be a string" % k)
            ok, msg, letter = do_order(form, tree, home)
            self.server.ob().sent(None)
            return self.send_json({"ok": ok, "message": msg.lstrip("!"), "letter": letter}, 200 if ok else 400)
        if u == "/answer":
            msg = do_answer(form, tree, home)
            threading.Thread(target=self.server.refresh, daemon=True).start()
            return self.redirect("/classic?msg=" + urllib.parse.quote(msg))
        if u == "/say":
            msg = do_say(form, tree, home)
            if form.get("back") == "agent":
                return self.redirect("/agent?name=%s&msg=%s" % (urllib.parse.quote(form.get("name", "")),
                                                                urllib.parse.quote(msg)))
            return self.redirect("/classic?msg=" + urllib.parse.quote(msg))
        self.fail(404, "NotFound", "no such path")


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    ui = None
    outbox = None

    def ob(self):
        if self.outbox is None:
            self.outbox = Outbox(self.home, self.collector)
        return self.outbox

    def refresh(self):
        self.collector.run_once()


# ---- v2 (11-14, 03 §12 / §12.8) ----
V2_ASSET_RE = re.compile(r"^[A-Za-z0-9._-]+$")
V2_MIME = {".js": "text/javascript; charset=utf-8", ".css": "text/css; charset=utf-8", ".svg": "image/svg+xml",
           ".woff2": "font/woff2", ".png": "image/png", ".map": "application/json; charset=utf-8"}
UI_KEYS = ("seen", "dismissed", "seats", "prefs")
UI_MERGE = ("seen", "dismissed")
UI_MAX = 256 * 1024
UI_PRUNE_S = 14 * 86400
BOARD1_KEYS = ("format", "seq", "updated_at", "by", "mode", "text", "doing", "waiting_on", "back_at", "back_text",
               "expires_at", "accept", "deputy")


def read_board1(path):
    """An agent's own board (ok-board board/1, board-1114/06 §7). No file = not posted (None); a wrong format = None.
    Only the known keys are passed on, strings masked; the four reading steps (§7.3) are done by the page."""
    b = load_json(path, None)
    if not isinstance(b, dict) or b.get("format") != "board/1":
        return None
    out = {}
    for k in BOARD1_KEYS:
        v = b.get(k)
        if v is None:
            continue
        if isinstance(v, str):
            v = mask(v)[:1000]
        elif k == "waiting_on":
            v = [{kk: (mask(vv)[:200] if isinstance(vv, str) else vv) for kk, vv in w.items()
                  if kk in ("who", "what", "since_at", "ref", "level", "notified_at")}
                 for w in v[:20] if isinstance(w, dict)] if isinstance(v, list) else None
        elif not isinstance(v, (int, float, bool)):
            continue
        out[k] = v
    return out


def public_node(v):
    n = {k: vv for k, vv in v.items() if k not in ("stack", "subagents")}
    if isinstance(n.get("rollup"), dict):
        n["rollup"] = {k: vv for k, vv in n["rollup"].items() if not k.startswith("_")}
    return n


def rev_hash(obj):
    return hashlib.sha1(json.dumps(obj, sort_keys=True, ensure_ascii=False, default=str).encode("utf-8")).hexdigest()[:16]


def file_sig(*paths):
    out = []
    for p in paths:
        try:
            st = os.stat(p)
            out.append("%d.%d" % (st.st_mtime_ns, st.st_size))
        except OSError:
            out.append("-")
    return rev_hash(out)


def tree_rev(tree):
    """rev.tree: the tree minus what changes every round without meaning anything (12.1 #4): generated_at,
    llm_workers, every why, an external's checked time. The page counts "N min ago" itself from active_at."""
    if not tree:
        return "none"
    nodes = {}
    for k, v in (tree.get("nodes") or {}).items():
        n = {kk: vv for kk, vv in v.items() if kk not in ("why", "stack", "subagents", "fixed_light")}
        if isinstance(n.get("rollup"), dict):
            n["rollup"] = {kk: vv for kk, vv in n["rollup"].items() if kk not in ("why",) and not kk.startswith("_")}
        if isinstance(n.get("team_light"), dict):
            n["team_light"] = {"light": n["team_light"].get("light")}
        if v.get("kind") == "external":
            n.pop("active_at", None)
            n["ext"] = {kk: vv for kk, vv in (v.get("ext") or {}).items() if kk != "ss_at"}
            n["light"] = (v.get("fixed_light") or [None])[0]
        nodes[k] = n
    return rev_hash({"nodes": nodes, "roots": tree.get("roots")})


REV_CACHE = {"key": None, "val": None}


def revs_of(server, tree):
    """rev for the seven kinds (B2 + 12.8 #10). Tree / asks / relay are hashed once per tree object."""
    home = server.home
    key = id(tree)
    if REV_CACHE["key"] != key:
        REV_CACHE["key"], REV_CACHE["val"] = key, {
            "tree": tree_rev(tree), "asks": rev_hash((tree or {}).get("zone")), "relay": rev_hash((tree or {}).get("relay"))}
    r = dict(REV_CACHE["val"])
    sent = os.path.join(home.state, "sent.jsonl")
    r["board"] = file_sig(os.path.join(board_dir(home), "user.json"))
    r["answered"] = file_sig(sent)
    r["outbox"] = server.ob().rev(tree)
    r["ui_state"] = file_sig(*[os.path.join(home.state, "ui", k + ".json") for k in UI_KEYS])
    return r


def ext_checked_at(tree):
    """12.8 #7: the last health check time of the outside services (kept out of rev.tree; the page shows it)."""
    ts = [v.get("active_at") for v in ((tree or {}).get("nodes") or {}).values() if v.get("kind") == "external"]
    ts = [t for t in ts if t]
    return max(ts) if ts else None


class Outbox:
    """B3 + 12.8 #9: what the user sent (sent.jsonl say / mail / order) with its delivery state.
    Replies are matched every time (cheap, from the relay letters in memory). queued / read needs `ctl state`,
    so that runs in a background thread: on a pulse or outbox read when older than 30 s, after every collector
    round while a v2 page polled in the last 120 s, and at once for an agent that just wrote to the relay.
    At most 6 agents per run: under 24 h every run, 1-7 days every 6th run, older not at all ("too old to follow")."""
    PER_RUN = 6
    OLD_EVERY = 6

    def __init__(self, home, collector):
        self.home, self.collector = home, collector
        self.status = {}          # letter -> {"delivery", "queue_ahead", "at"}
        self.checked_at = None
        self.pulse_at = 0
        self.runs = 0
        self.rr = 0
        self.urgent = set()
        self.lock = threading.Lock()
        self.relay_seen = None
        self.ver = 0
        collector.on_tree.append(self.after_tree)

    def sent(self, name):
        if name:
            DELIVERY_CACHE.pop(name, None)
            self.urgent.add(name)
        self.ver += 1
        self.kick()

    def after_tree(self, tree):
        ids = {x.get("letter") for x in (tree or {}).get("relay") or []}
        if self.relay_seen is not None:
            for x in (tree or {}).get("relay") or []:
                if x.get("letter") not in self.relay_seen:
                    self.urgent.add(x.get("from"))
        self.relay_seen = ids
        if time.time() - self.pulse_at < 120 or self.urgent:
            self.kick()

    def kick_if_old(self):
        if not self.checked_at or time.time() - self.checked_at > 30:
            self.kick()

    def kick(self):
        if self.lock.locked():
            return
        threading.Thread(target=self.run, daemon=True).start()

    def raw(self, tree, days=7):
        since = time.time() - days * 86400
        outs = [o for o in read_sent(self.home, None, 2000) if (o.get("sent_at") or 0) >= since and o.get("letter")]
        return outs, self.collector.relay_letters()

    def run(self):
        if not self.lock.acquire(blocking=False):
            return
        try:
            tree, _ = self.collector.get()
            nodes = (tree or {}).get("nodes") or {}
            outs, ins = self.raw(tree)
            self.match(outs, ins)
            t = time.time()
            self.runs += 1
            want = {}
            for o in outs:
                if o.get("reply") or o.get("to") not in nodes or nodes[o["to"]].get("kind") != "agent":
                    continue
                age = t - (o.get("sent_at") or 0)
                if age < 86400 or self.runs % self.OLD_EVERY == 0:
                    want.setdefault(o["to"], []).append(o)
            names = sorted(want)
            pick = [n for n in names if n in self.urgent]
            rest = [n for n in names if n not in pick]
            if rest:
                k = self.rr % len(rest)
                rest = rest[k:] + rest[:k]
                self.rr += 1
            for name in (pick + rest)[:self.PER_RUN]:
                self.urgent.discard(name)
                mine = [o for o in outs if o.get("to") == name]
                delivery(name, mine, ins, t)
                for o in mine:
                    if o.get("delivery"):
                        old = self.status.get(o["letter"]) or {}
                        new = {"delivery": o["delivery"], "queue_ahead": o.get("queue_ahead"), "at": t}
                        if (old.get("delivery"), old.get("queue_ahead")) != (new["delivery"], new["queue_ahead"]):
                            self.ver += 1
                        self.status[o["letter"]] = new
            self.checked_at = t
        except Exception as e:
            log_ev(self.home, "outbox_failed", error="%s: %s" % (type(e).__name__, e))
        finally:
            self.lock.release()

    @staticmethod
    def match(outs, ins):
        by_reply = {}
        for x in ins:
            if x.get("in_reply_to"):
                by_reply.setdefault(x["in_reply_to"], x)
        for o in outs:
            r = by_reply.get(o.get("letter"))
            if not r and o.get("kind") == "say":
                later = [x for x in ins if x.get("from") == o.get("to") and (x.get("sent_at") or 0) > (o.get("sent_at") or 0)]
                r = min(later, key=lambda x: x.get("sent_at") or 0) if later else None
            o["reply"] = {"letter": r.get("letter"), "status": r.get("status"), "title": r.get("title"),
                          "at": r.get("sent_at")} if r else None

    def items(self, tree, days=7):
        nodes = (tree or {}).get("nodes") or {}
        outs, ins = self.raw(tree, days)
        self.match(outs, ins)
        t = time.time()
        res = []
        for o in sorted(outs, key=lambda x: x.get("sent_at") or 0, reverse=True)[:300]:
            st = self.status.get(o["letter"]) or {}
            n = nodes.get(o.get("to"))
            if o["reply"]:
                d, qa = "replied", None
            elif t - (o.get("sent_at") or 0) > 7 * 86400:
                d, qa = "unknown", None
            else:
                d, qa = st.get("delivery") or "unknown", st.get("queue_ahead")
                if d == "replied":
                    d = "read"      # a reply seen once but not matched now: do not claim it
            turn = None
            if n and n.get("kind") == "agent" and (n.get("state") or "").lower() == "running" and (n.get("queued") or n.get("busy")):
                turn = {"queued": n.get("queued") or 0, "busy": n.get("busy"), "active_at": n.get("active_at")}
            order = o.get("order") if isinstance(o.get("order"), dict) else None
            res.append({"letter": o["letter"], "batch": o.get("batch"), "kind": o.get("kind"), "to": o.get("to"),
                        "target": (order or {}).get("target"), "title": o.get("title"), "what": short(o.get("what") or "", 300),
                        "status": o.get("status"), "sent_at": o.get("sent_at"), "delivery": d, "queue_ahead": qa,
                        "checked_at": st.get("at"), "turn": turn, "reply": o["reply"], "order": order,
                        "correction_of": o.get("correction_of"), "gone": o.get("to") not in nodes,
                        "followed": t - (o.get("sent_at") or 0) <= 7 * 86400})
        return res

    def rev(self, tree):
        return rev_hash([self.ver, file_sig(os.path.join(self.home.state, "sent.jsonl")),
                         rev_hash((tree or {}).get("relay"))])


def ui_path(home, key):
    return os.path.join(home.state, "ui", key + ".json")


def ui_get(home, key):
    d = load_json(ui_path(home, key), None)
    if not isinstance(d, dict):
        return {"key": key, "value": None, "at": None, "rev": 0}
    return {"key": key, "value": d.get("value"), "at": d.get("at"), "rev": d.get("rev", 0)}


UI_LOCK = threading.Lock()


def ui_put(home, key, body):
    """B4. seen / dismissed: body {id: epoch | null} merged into the stored {id: epoch} (newer time wins, null
    removes), entries older than 14 days dropped. seats / prefs: body replaces the value. Returns (ok, state)."""
    if key in UI_MERGE:
        if not isinstance(body, dict) or not all(isinstance(k, str) and len(k) <= 200 for k in body) or \
                not all(v is None or isinstance(v, (int, float)) for v in body.values()):
            return False, "%s takes {id: epoch | null}" % key
    elif not isinstance(body, dict):
        return False, "%s takes a JSON object" % key
    with UI_LOCK:
        cur = ui_get(home, key)
        t = time.time()
        if key in UI_MERGE:
            val = dict(cur["value"]) if isinstance(cur["value"], dict) else {}
            for k, v in body.items():
                if v is None:
                    val.pop(k, None)
                else:
                    val[k] = max(v, val.get(k) or 0)
            val = {k: v for k, v in val.items() if isinstance(v, (int, float)) and v > t - UI_PRUNE_S}
        else:
            val = body
        rec = {"value": val, "at": t, "rev": int(cur.get("rev") or 0) + 1}
        if len(json.dumps(rec, ensure_ascii=False)) > UI_MAX:
            return False, "too big (limit 256 KB)"
        os.makedirs(os.path.dirname(ui_path(home, key)), exist_ok=True)
        write_json(ui_path(home, key), rec)
    return True, {"key": key, "value": val, "at": rec["at"], "rev": rec["rev"]}


def ui_ports(home):
    """B1: extra listeners. config "ui_ports": [{"port": 8768, "dir": "ui/v2/dist"}] (dir relative to the frontend folder, VIEW_DIR);
    default: 8768 for ui/v2/dist. A dir without index.html is not served (the port is not opened).
    -> (served [{port, dir}], missing [{port, dir}]); serve prints one warning per missing dir (ui/v2/dist is not in git:
    it has to be built locally, ui/v2/README.md)."""
    conf = home.config().get("ui_ports")
    if conf is None:
        conf = [{"port": 8768, "dir": "ui/v2/dist"}]
    out, missing = [], []
    for e in conf if isinstance(conf, list) else []:
        if not isinstance(e, dict) or not isinstance(e.get("port"), int):
            continue
        d = e.get("dir") or ""
        d = d if os.path.isabs(d) else os.path.join(HERE_DIR, d)
        (out if os.path.isfile(os.path.join(d, "index.html")) else missing).append({"port": e["port"], "dir": d})
    return out, missing


def ui_missing_line(e):
    """The warning for a ui dir without index.html (the v2 page is not built here)."""
    hint = ("build it first: see %s" % os.path.join(os.path.dirname(e["dir"]), "README.md")
            if os.path.basename(os.path.normpath(e["dir"])) == "dist" else "point ui_ports at a built page")
    return ("aos-frontend: warning: port %d not opened: %s has no index.html (the page is not built; %s)"
            % (e["port"], e["dir"], hint))


# ---- the user's board (布告欄): one line the user leaves before going away; agents read it with `aos-frontend board` ----

def board_dir(home):
    return os.path.join(home.dir, "board")


def board_get(home):
    b = load_json(os.path.join(board_dir(home), "user.json"), None)
    if not isinstance(b, dict) or not b.get("text"):
        return None
    return {"at": b.get("at"), "text": mask(b.get("text") or ""), "back": mask(b.get("back") or "") or None}


def do_board(form, home):
    text = (form.get("text") or "").strip()
    back = (form.get("back") or "").strip()
    if len(text) > 1000 or len(back) > 100:
        return False, "!太長了（布告上限 1000 字，回來時間 100 字）"
    os.makedirs(board_dir(home), exist_ok=True)
    rec = {"at": now_local(), "text": text, "back": back or None, "by": "user"}
    write_json(os.path.join(board_dir(home), "user.json"), rec)
    append_line(os.path.join(board_dir(home), "user.jsonl"), rec)
    return True, "布告欄已更新" if text else "布告欄已清空"


def board_text(home, all_teams=False):
    b = board_get(home)
    if b:
        out = ["使用者布告欄（%s 留）：%s" % (b["at"], b["text"])]
        if b["back"]:
            out.append("預計回來：%s" % b["back"])
    else:
        out = ["使用者布告欄是空的（沒有留話）。"]
    if all_teams:
        root = os.path.join(home.dir, "teams")
        for t in sorted(os.listdir(root)) if os.path.isdir(root) else []:
            try:
                with open(os.path.join(root, t, "notes.jsonl"), encoding="utf-8") as f:
                    last = json.loads(f.readlines()[-1])
            except (OSError, ValueError, IndexError):
                continue
            out.append("隊 %s（%s，%s）：%s" % (t, last.get("at"), last.get("status"), mask(last.get("text") or "")))
    return "\n".join(out)


def cmd_board(home, args):
    if args and args[0] in ("-h", "--help"):
        print("usage: aos-frontend board [--all] [--json]   read the user's board (the user writes it on the page); "
              "--all adds every team's latest note (aos-frontend note)")
        return
    if "--json" in args:
        print(json.dumps({"user": board_get(home)}, ensure_ascii=False))
        return
    print(board_text(home, "--all" in args))


# ---- phase 1 commands: note, decide, match (captains), aide-tick (the aide's hook), ingest ----

def take_opt(args, name):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            raise Fail("ArgumentsBad", "%s needs a value" % name)
        v = args[i + 1]
        del args[i:i + 2]
        return v
    return None


def resolve_team(given):
    if given:
        return given
    st = os.environ.get("AOS_STACK", "").rstrip("/")
    name = os.path.basename(st) if st else ""
    if name:
        rows = table_rows()
        if isinstance(rows, list) and any(isinstance(r, dict) and r.get("name") == name for r in rows):
            return name
    raise Fail("TeamMissing", "give --team T ($AOS_STACK %s is not a name on the daemon table)" % (name or "is not set"))


def cmd_note(home, args):
    team = take_opt(args, "--team")
    on = take_opt(args, "--on")
    if len(args) < 2:
        raise Fail("ArgumentsBad", "usage: aos-frontend note [--team T] [--on NAME] STATUS TEXT")
    status, text = args[0], " ".join(args[1:]).strip()
    if status not in NOTE_STATUSES:
        raise Fail("StatusBad", "STATUS must be one of %s" % " ".join(NOTE_STATUSES))
    if not text:
        raise Fail("ArgumentsBad", "TEXT is empty")
    if len(text) > 2000:
        raise Fail("ArgumentsBad", "TEXT is longer than 2000 characters")
    if on is not None and not NAME_RE.match(on):
        raise Fail("ArgumentsBad", "--on NAME: letters, digits, _ . - only")
    tm = Team(home, resolve_team(team)).ensure()
    append_line(tm.notes_path, {"at": now_local(), "status": status, "text": text, "on": on})
    print("ok: note %s %s" % (tm.name, status))


def cmd_decide(home, args):
    team = take_opt(args, "--team")
    if len(args) != 1:
        raise Fail("ArgumentsBad", "usage: aos-frontend decide [--team T] FILE")
    try:
        with open(args[0], "rb") as f:
            raw = f.read()
        text = raw.decode("utf-8")
    except OSError as e:
        raise Fail("FileMissing", "cannot read %s: %s" % (args[0], e))
    except UnicodeDecodeError:
        raise Fail("SchemaBad", "%s is not UTF-8" % args[0])
    hit = secret_hit(text)
    if hit:
        raise Fail("SecretInPayload", "%s looks like it holds a secret (%s); take it out and try again" % (args[0], hit))
    try:
        data = json.loads(text)
    except ValueError as e:
        raise Fail("SchemaBad", "%s is not JSON: %s" % (args[0], e))
    if not isinstance(data, dict):
        raise Fail("SchemaBad", "the letter must be a JSON object")
    zmod = need_zone_mod()
    try:
        zmod.check_letter(zmod.build_letter(dict(data), None))
    except zmod.Fail as e:
        raise Fail(e.code, str(e))
    sha = canonical_sha(data, zmod)
    tm = Team(home, resolve_team(team)).ensure()
    while True:
        rid = "%s-%s-%s" % (tm.name, time.strftime("%Y%m%d-%H%M%S"), secrets.token_hex(2))
        dst = os.path.join(tm.outbox, rid + ".json")
        if not os.path.exists(dst) and not os.path.exists(os.path.join(tm.sent_dir, rid + ".json")):
            break
    append_line(tm.sent_log, {"id": rid, "at": now_local(), "sha256": sha, "kind": data.get("kind"),
                              "title": data.get("title")})
    tmp = dst + ".tmp"
    with open(tmp, "wb") as f:
        f.write(raw)
    os.replace(tmp, dst)
    print(rid)


def cmd_match(home, args):
    if len(args) != 1:
        raise Fail("ArgumentsBad", "usage: aos-frontend match REPLY_FOLDER")
    p = os.path.abspath(args[0])
    if p.endswith("/letter.json"):
        p = p[:-len("/letter.json")]
    code, out, err = run([AOS_USER, "verify", p], timeout=30)
    if code != 0:
        line = ((err or out).strip().splitlines() or ["aos-user verify failed"])[-1]
        raise Fail("VerifyBad", line)
    lt = load_json(os.path.join(p, "letter.json"), None)
    irt = lt.get("in_reply_to") if isinstance(lt, dict) else None
    if not irt:
        raise Fail("LetterBad", "%s has no in_reply_to" % p)
    zmod = need_zone_mod()
    zd = zmod.zone_dir(None)
    orig = None
    droot = os.path.join(zd, "done")
    for m in sorted(os.listdir(droot)) if os.path.isdir(droot) else []:
        q = os.path.join(droot, m, irt, "letter.json")
        if os.path.exists(q):
            orig = q
    ob = (load_json(orig, {}) or {}).get("body") if orig else None
    if not isinstance(ob, dict):
        raise Fail("PayloadMismatch", "the zone has no letter %s in done/" % irt)
    mo = re.match(r"^([^/\s]+)/(\S+) sha256:([0-9a-f]{64})\b", ob.get("origin") or "")
    if not mo:
        raise Fail("PayloadMismatch", "letter %s was not passed by aos-frontend (no origin)" % irt)
    team, rid = mo.group(1), mo.group(2)
    sha = canonical_sha(ob, zmod)
    rec = next((r for r in read_lines(Team(home, team).sent_log) if r.get("id") == rid), None)
    if not rec:
        raise Fail("PayloadMismatch", "%s/%s is not in the team's sent.jsonl" % (team, rid))
    if rec.get("sha256") != sha:
        raise Fail("PayloadMismatch", "%s/%s: the zone's letter hashes to %s, the captain's file to %s"
                   % (team, rid, sha, rec.get("sha256")))
    print("ok: match %s/%s sha256:%s" % (team, rid, sha))


def cmd_aide_tick(home, args):
    team = take_opt(args, "--team")
    ev = {}
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
        if raw.strip():
            try:
                ev = json.loads(raw)
            except ValueError:
                raise Fail("ArgumentsBad", "stdin is not the hook's event JSON")
    r = aide_tick(home, team, ev)
    print("aide-tick %s: passed %d, report %s, beat %s%s" % (
        r["team"], len(r["passed"]), "sent" if r["report"] else "-", "sent" if r["beat"] else "-",
        ("; errors: " + " | ".join(r["errors"])) if r["errors"] else ""))
    if r["errors"]:
        sys.stderr.write("aos-frontend: warning: %s\n" % " | ".join(r["errors"]))


def cmd_ingest(home, args):
    print(json.dumps(ingest(home), ensure_ascii=False))


AIDE_DEF = os.path.join(VIEW_DIR, "aide-def")   # only the aide's own files (Q3 11-17)
AIDE_SKIP = ("_index.json",)                     # generated listing of aide-def itself, not part of a definition


def cmd_aide_def(home, args):
    """A team's aide definition = a fresh copy of the agent-fsm template with the files in aide-def/ laid over it."""
    tpl = take_opt(args, "--template")
    if len(args) != 1:
        raise Fail("ArgumentsBad", "usage: aos-frontend aide-def [--template DIR] PATH")
    if tpl is None:
        ah = os.environ.get("AOS_HOME")
        if not ah:
            raise Fail("TemplateMissing", "AOS_HOME is not set; give --template DIR (the agent-fsm template folder)")
        tpl = os.path.join(ah, "templates", "agent-fsm")
    tpl = os.path.abspath(tpl)
    if not os.path.isfile(os.path.join(tpl, "interfaces.json")):
        raise Fail("TemplateMissing", "%s is not an agent definition (no interfaces.json)" % tpl)
    if not os.path.isdir(AIDE_DEF):
        raise Fail("TemplateMissing", "%s is not a folder" % AIDE_DEF)
    ws = os.environ.get("AOS_WS")
    dest = os.path.abspath(os.path.join(ws, args[0]) if ws and not os.path.isabs(args[0]) else args[0])
    if os.path.lexists(dest):
        raise Fail("DefExists", "%s already exists (pick a new folder)" % dest)
    parent = os.path.dirname(dest)
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    import shutil
    try:
        shutil.copytree(tpl, tmp, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
        laid = []
        for name in sorted(os.listdir(AIDE_DEF)):
            src = os.path.join(AIDE_DEF, name)
            if name in AIDE_SKIP or not os.path.isfile(src):
                continue
            if os.path.lexists(os.path.join(tmp, name)):
                os.remove(os.path.join(tmp, name))
            shutil.copy2(src, os.path.join(tmp, name))
            laid.append(name)
        os.rename(tmp, dest)
    except OSError as e:
        shutil.rmtree(tmp, ignore_errors=True)
        raise Fail("WriteFailed", "cannot make %s: %s" % (dest, e))
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    print("wrote aide definition %s (template %s, laid over: %s)" % (dest, tpl, " ".join(laid)))


PHASE1 = {"board": cmd_board, "note": cmd_note, "decide": cmd_decide, "match": cmd_match, "aide-tick": cmd_aide_tick, "ingest": cmd_ingest,
          "aide-def": cmd_aide_def}


def main(argv):
    port, home_dir, args = 8767, None, []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--port":
            port = int(argv[i + 1]); i += 2; continue
        if a == "--ui":
            global WEB_DIR
            WEB_DIR = os.path.abspath(argv[i + 1]); i += 2; continue
        if a == "--home":
            home_dir = argv[i + 1]; i += 2; continue
        if a in ("-h", "--help"):
            print(__doc__); return 0
        args.append(a); i += 1
    home = Home(home_dir or os.environ.get("AOS_VIEW_HOME") or os.path.expanduser("~/.aos/view"))
    cmd = args[0] if args else "serve"
    if cmd in PHASE1:
        try:
            PHASE1[cmd](home, args[1:])
            return 0
        except Fail as e:
            print("aos-frontend: error: %s %s" % (e.code, e), file=sys.stderr)
            return 1
    home.init()
    if cmd == "init":
        print(home.dir); return 0
    c = Collector(home)
    if cmd == "snapshot":
        print(json.dumps(c.collect(), ensure_ascii=False, indent=1, default=str)); return 0
    if cmd == "serve":
        srv = Server(("127.0.0.1", port), Handler)
        ob = Outbox(home, c)
        srv.collector, srv.home, srv.token, srv.outbox, srv.ui = c, home, home.token(), ob, None
        served, missing = ui_ports(home)
        for e in missing:
            print(ui_missing_line(e), file=sys.stderr, flush=True)
        for e in served:
            if e["port"] == port:
                continue
            try:
                s2 = Server(("127.0.0.1", e["port"]), Handler)
            except OSError as ex:
                print("aos-frontend: warning: port %d not opened: %s" % (e["port"], ex), file=sys.stderr, flush=True)
                continue
            s2.collector, s2.home, s2.token, s2.outbox, s2.ui = c, home, srv.token, ob, e
            threading.Thread(target=s2.serve_forever, daemon=True).start()
            print("aos-frontend: http://127.0.0.1:%d/  (ui %s)" % (e["port"], e["dir"]), flush=True)
        threading.Thread(target=c.loop, daemon=True).start()
        print("aos-frontend: http://127.0.0.1:%d/  (home %s, pid %d)" % (port, home.dir, os.getpid()), flush=True)
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            pass
        return 0
    print("aos-frontend: error: CommandUnknown %s" % cmd, file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
