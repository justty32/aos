TIMEOUT_RE = re.compile(r"time ?out|timed out|TimeoutExpired|code 124\b", re.I)
QUIET_MIN = 15           # in a turn with no new line in the CLI's live stream for this long = yellow "quiet", never red
CLI_LOCK = threading.Semaphore(3)

# ---- small helpers -------------------------------------------------------------------

SECRET_RES = [
    re.compile(r"\b(sk-[A-Za-z0-9_\-]{12,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|AIza[A-Za-z0-9_\-]{20,}"
               r"|xox[baprs]-[A-Za-z0-9\-]{10,})"),
    re.compile(r"(Bearer\s+)[A-Za-z0-9._\-]{12,}"),
    re.compile(r"\b([A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)[A-Z0-9_]*\s*=\s*)\S+"),
]


def mask(s):
    if not isinstance(s, str):
        s = json.dumps(s, ensure_ascii=False) if s is not None else ""
    s = SECRET_RES[0].sub("[secret hidden]", s)
    s = SECRET_RES[1].sub(r"\1[secret hidden]", s)
    s = SECRET_RES[2].sub(r"\1[secret hidden]", s)
    return s


def esc(s):
    return html.escape(mask(s), quote=True)


def short(s, n=160):
    s = mask(s).replace("\n", " ").strip()
    return s if len(s) <= n else s[: n - 1] + "…"


def now():
    return time.time()


def iso(t):
    return datetime.fromtimestamp(t, timezone.utc).astimezone().strftime("%Y-%m-%d %H:%M:%S")


def ago(t):
    if not t:
        return "unknown"
    d = int(now() - t)
    if d < 60:
        return "%ds ago" % d
    if d < 3600:
        return "%dm ago" % (d // 60)
    if d < 86400:
        return "%dh %dm ago" % (d // 3600, d % 3600 // 60)
    return "%dd ago" % (d // 86400)


def parse_time(s):
    if not isinstance(s, str) or not s:
        return None
    try:
        s2 = s.replace("Z", "+00:00")
        if re.search(r"[+-]\d{4}$", s2):
            s2 = s2[:-2] + ":" + s2[-2:]
        return datetime.fromisoformat(s2).timestamp()
    except ValueError:
        return None


def cli_env():
    """Environment for the aos CLIs: keep the daemon, drop who-am-I (the page is not an agent)."""
    e = dict(os.environ)
    for k in ("AOS_STACK", "AOS_WS", "AOS_CF", "AOS_CD", "AOS_CO", "AOS_CLOCK", "AOS_AGENT", "AOS_KERNEL"):
        e.pop(k, None)
    return e


def run(args, timeout=15, stdin=None):
    with CLI_LOCK:
        try:
            p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=cli_env(),
                               input=stdin, cwd="/")
        except subprocess.TimeoutExpired:
            return 124, "", "timeout after %ss" % timeout
        except OSError as e:
            return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr


def run_json(args, timeout=15):
    code, out, err = run(args, timeout)
    if code != 0:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def write_json(path, data):
    tmp = "%s.%d.%d.tmp" % (path, os.getpid(), threading.get_ident())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def load_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


# ---- home ----------------------------------------------------------------------------

class Home:
    def __init__(self, d):
        self.dir = d
        self.mailbox = os.path.join(d, "mailbox")
        self.state = os.path.join(d, "state")

    def init(self):
        os.makedirs(self.state, exist_ok=True)
        for sub in ("teams", "done", "rejected"):
            os.makedirs(os.path.join(self.dir, sub), exist_ok=True)
        if not os.path.isdir(os.path.join(self.mailbox, "new")):
            code, out, err = run(["aos-post", "init", self.mailbox])
            if code != 0:
                for sub in ("tmp", "new", "cur"):
                    os.makedirs(os.path.join(self.mailbox, sub), exist_ok=True)
        cfg = os.path.join(self.dir, "config.json")
        if not os.path.exists(cfg):
            write_json(cfg, {"parents": {}, "parent_rules": [["ok-*", "repo-aos"], ["xiaosi", "repo-aos"]],
                             "poll_s": 20})

    def config(self):
        return load_json(os.path.join(self.dir, "config.json"), {})

    def token(self):
        p = os.path.join(self.dir, "token")
        try:
            with open(p) as f:
                t = f.read().strip()
            if t:
                return t
        except OSError:
            pass
        t = secrets.token_hex(24)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(t)
        return t

    def say_log(self):
        return self.config().get("say_log") or os.path.join(self.state, "say.jsonl")


# ---- the tree ------------------------------------------------------------------------

LIGHT_ORDER = {"red": 0, "blue": 1, "yellow": 2, "green": 3, "gray": 4}
LIGHT_ICON = {"red": "🔴", "blue": "🔵", "yellow": "🟡", "green": "🟢", "gray": "⚪"}


class Collector:
    """Polls the daemon table in a thread; keeps the last tree in memory."""

    def __init__(self, home):
        self.home = home
        self.lock = threading.Lock()
        self.tree = None
        self.err = None
        self.act_path = os.path.join(home.state, "activity.json")
        self.activity = load_json(self.act_path, {})
        self.kinds = {}
        self.zone = None if os.environ.get("VIEW_ASKS_FIXTURE") else load_zone()
        self.collect_lock = threading.Lock()
        self.tick = {"at": None, "took_ms": None, "ok": None, "error": None}
        self.on_tree = []        # v2: callbacks after each new tree (outbox wake-up on new relay letters)

    def collect(self):
        with self.collect_lock:
            return self._collect()

    # one pass
    def _collect(self):
        rows = table_rows()
        fixture = bool(os.environ.get("VIEW_LS_FIXTURE"))
        if not isinstance(rows, list):
            raise RuntimeError("aos-agent ctl ls --json failed")
        t = now()
        nodes, workers = {}, 0
        for r in rows:
            name = r.get("name")
            if not name:
                continue
            if name.startswith("llm_"):
                workers += 1
                continue
            n = {"id": name, "state": r.get("state"), "phase": r.get("phase"), "queued": r.get("queued"),
                 "busy": r.get("busy"), "reason": r.get("reason"), "cooldown": r.get("cooldown"),
                 "ws": r.get("ws"), "stack": r.get("stack"), "children": [], "parent": None, "parent_by": None,
                 "tags": list((self.home.config().get("tags") or {}).get(name) or [])}
            st = {} if fixture else (run_json(["aos-agent", "ctl", "state", "-t", name, "state", "history",
                                                 "subagents", "-j"]) or {})
            hist = st.get("history") or {}
            if st:
                n["kind"] = "agent" if hist.get("available", True) and "messages" in hist else "proc"
                self.kinds[name] = n["kind"]
            else:
                n["kind"] = self.kinds.get(name, "agent")
            s = st.get("state") or {}
            n["last_answer"] = mask(s.get("last_answer")) if s.get("last_answer") else None
            n["subagents"] = [x.get("name") if isinstance(x, dict) else x
                              for x in ((st.get("subagents") or {}).get("subagents") or [])]
            # activity: when history size last changed (seen by this page)
            sig = "%s/%s" % (hist.get("messages"), hist.get("bytes"))
            a = self.activity.get(name)
            if not a or a.get("sig") != sig:
                self.activity[name] = {"sig": sig, "at": t if a else None}
            n["active_at"] = self.activity[name].get("at")
            n["messages"] = hist.get("messages")
            n["board"] = read_board1(os.path.join(n["stack"], "board.json")) if n.get("stack") else None
            n["live"] = live_of(n.get("stack"))
            n["quiet"] = quiet_of(n.get("stack"))
            nodes[name] = n
        write_json(self.act_path, self.activity)
        self.externals(nodes, t)
        try:
            self.ingested = ingest(self.home, self.zone, t)
        except Exception as e:  # never let the relay break the tree
            log_ev(self.home, "ingest_failed", error="%s: %s" % (type(e).__name__, e))
        teams = team_info(self.home)
        aides = {}
        for leader, info in teams.items():
            a = (info.get("aide") or {}).get("aide")
            if a:
                aides[a] = leader
        self.parents(nodes, aides)
        relay = self.relay_letters()
        zone = self.zone_letters()
        for n in nodes.values():
            info = teams.get(n["id"])
            n["team"] = info["team"] if info else None
            n["note"] = info["note"] if info else None
            n["passed"] = info["passed"] if info else 0
            aname = ((info or {}).get("aide") or {}).get("aide") or ((info or {}).get("state") or {}).get("aide")
            n["aide"] = {"name": aname, "last_beat": info["state"].get("last_beat"),
                         "state": nodes[aname]["state"] if aname in nodes else None} if aname else None
            n["reports"] = [x for x in relay if x["from"] == n["id"]][:3]
            n["asks"] = len([z for z in zone if z.get("from") == n["id"]])
            n["light"], n["why"] = self.light(n, nodes)
            n["why_full"] = self.why_full(n, nodes)
        for n in nodes.values():
            info = teams.get(n["id"])
            asks_team = len([z for z in zone if z.get("from") in (n["id"], n.get("team"))])
            tl = team_light(info, n, nodes, asks_team, t)
            n["team_light"] = {"light": tl[0], "why": tl[1]} if tl else None
        roots = [n["id"] for n in nodes.values() if not n["parent"]]
        order = lambda k: (nodes[k]["kind"] != "agent", k)
        for n in nodes.values():
            n["children"].sort(key=order)
        roots.sort(key=order)
        for k in roots:
            self.rollup(k, nodes)
        return {"format": "view-tree/0", "generated_at": t, "nodes": nodes, "roots": roots,
                "llm_workers": workers, "zone": zone, "relay": relay}

    EXT_DEFAULT = [{"id": "LiteLLM", "url": "http://127.0.0.1:4000/health/liveliness", "port": 4000}]

    def externals(self, nodes, t):
        """Phase 2: things outside the daemon table (config "externals"): a health GET every poll (local URLs only),
        and once a day `ss` to see which address the port listens on. Cached in state/externals.json."""
        import urllib.request
        path = os.path.join(self.home.state, "externals.json")
        cache = load_json(path, {})
        for e in self.home.config().get("externals", self.EXT_DEFAULT):
            if not isinstance(e, dict) or not e.get("id") or e["id"] in nodes:
                continue
            eid, c = e["id"], cache.get(e["id"], {})
            ok, why = None, "no health url"
            url = e.get("url") or ""
            if url.startswith("http://127.0.0.1") or url.startswith("http://localhost"):
                try:
                    with urllib.request.urlopen(url, timeout=2) as r:
                        ok, why = 200 <= r.status < 300, "health %d" % r.status
                except Exception as ex:
                    ok, why = False, "health check failed: %s" % short(str(ex), 80)
            if e.get("port") and t - (c.get("ss_at") or 0) > 86400:
                code, out, err = run(["ss", "-ltnH", "sport = :%d" % int(e["port"])], timeout=5)
                addrs = sorted({ln.split()[3].rsplit(":", 1)[0] for ln in out.splitlines() if len(ln.split()) > 3})
                c.update({"ss_at": t, "listen": addrs})
            open_all = any(a in ("0.0.0.0", "*", "[::]") for a in c.get("listen") or [])
            light = "red" if ok is False else ("yellow" if open_all else ("green" if ok else "gray"))
            if open_all and ok is not False:
                why = "%s; listens on all interfaces (%s): other machines on the LAN can reach it" % (
                    why, ", ".join(c["listen"]))
            c.update({"checked_at": t, "ok": ok, "why": why})
            cache[eid] = c
            nodes[eid] = {"id": eid, "kind": "external", "state": "up" if ok else ("down" if ok is False else "?"),
                          "phase": None, "queued": None, "busy": None, "reason": None, "cooldown": None, "ws": None,
                          "stack": None, "children": [], "parent": None, "parent_by": None, "tags": [],
                          "subagents": [], "last_answer": None, "active_at": c.get("checked_at"), "messages": None,
                          "ext": {"url": url, "listen": c.get("listen"), "ss_at": c.get("ss_at")},
                          "fixed_light": [light, why]}
        write_json(path, cache)

    def parents(self, nodes, aides=None):
        aides = aides or {}
        cfg = self.home.config()
        explicit = cfg.get("parents") or {}
        rules = cfg.get("parent_rules") or []
        names = sorted(nodes, key=len, reverse=True)
        for n in nodes.values():
            p, by = None, None
            if aides.get(n["id"]) in nodes and aides[n["id"]] != n["id"]:
                n["parent"], n["parent_by"] = aides[n["id"]], "aide"  # §10: only in the leader's aide field
                continue
            if explicit.get(n["id"]) in nodes:
                p, by = explicit[n["id"]], "config"
            if not p:
                for other in nodes.values():
                    if n["id"] in other["subagents"] and other["id"] != n["id"]:
                        p, by = other["id"], "subagent"
                        break
            if not p:
                for other in names:
                    if other != n["id"] and n["id"].startswith(other + "-"):
                        p, by = other, "prefix"
                        break
            if not p:
                for rule in rules:
                    if not (isinstance(rule, list) and len(rule) == 2 and all(isinstance(x, str) for x in rule)):
                        continue
                    pat, par = rule
                    if par in nodes and par != n["id"] and fnmatch.fnmatch(n["id"], pat):
                        p, by = par, "rule"
                        break
            n["parent"], n["parent_by"] = p, by
        # break loops: walk up; if we come back, cut the edge
        for n in nodes.values():
            seen, cur = set(), n["id"]
            while cur and cur not in seen:
                seen.add(cur)
                cur = nodes[cur]["parent"]
            if cur:
                nodes[cur]["parent"], nodes[cur]["parent_by"] = None, "loop-cut"
        for n in nodes.values():
            if n["parent"] and n["parent_by"] != "aide":
                nodes[n["parent"]]["children"].append(n["id"])

    def why_full(self, n, nodes):
        text = mask(self.light(n, nodes, full=True)[1])
        return text if len(text) <= 2000 else text[:1999] + "…"

    def light(self, n, nodes, full=False):
        reason_text = lambda value: mask(value) if full else short(value, 80)
        if n.get("fixed_light"):
            return tuple(n["fixed_light"])
        st = (n.get("state") or "").lower()
        cd = n.get("cooldown")
        # rules from the temp-tree fixtures (~/code/view-1114/fixtures/README.md): a crash or kill leaves a
        # non-null reason ("exited with code 143", "... signal 9", "RunFailed ..."); a normal stop or sleep leaves none
        if st == "sleeping":
            return "gray", "asleep"
        if st == "stuck" or (n.get("phase") or "").lower() == "stuck":
            # 11-15: the daemon's "stuck" = slow, not dead (the user: long quiet is yellow, never killed)
            return "yellow", "long quiet, not dead (daemon says stuck)"
        if st not in ("running", "paused"):
            kids_up = [c for c in n["children"] if (nodes[c].get("state") or "").lower() == "running"]
            tail = ", %d below still running" % len(kids_up) if kids_up else ""
            why = n.get("reason") or (cd.get("reason") if isinstance(cd, dict) else None)
            if why and TIMEOUT_RE.search(str(why)):
                # 11-15: a turn cut for taking long is not a crash (the user: slow is not dead)
                return "yellow", "stopped: a turn ran long and was cut by a timeout, not a crash (%s)%s" % (reason_text(why), tail)
            if n.get("reason") or (isinstance(cd, dict) and cd.get("failures")):
                return "red", "crashed: %s%s" % (reason_text(n.get("reason") or (cd or {}).get("reason") or st), tail)
            if kids_up:
                return "yellow", "stopped normally%s" % tail
            return "gray", "stopped normally"
        if n.get("asks"):
            return "blue", "%d letter(s) waiting for you" % n["asks"]
        if isinstance(cd, dict) and cd.get("failures"):
            return "yellow", "brain failed %sx: %s" % (cd.get("failures"), reason_text(cd.get("reason") or cd.get("code")))
        if st == "paused":
            return "yellow", "paused by hand"
        q = n.get("queued") or 0
        act = n.get("active_at")
        mins = int((time.time() - act) // 60) if act else None
        seen = "last activity %d min ago" % mins if mins is not None else "last activity not recorded"
        qt = n.get("quiet")
        if qt:
            # the shared mark (quiet.json): the authoritative source; the live.jsonl guess below is the fallback
            mq = qt["quiet_s"] // 60 if qt.get("quiet_s") is not None else None
            what = {"cli_turn": "a CLI turn", "brain_reply": "the brain's reply"}.get(qt["what"], qt["what"] or "something")
            return "yellow", "long quiet, not dead: waiting on %s%s%s" % (
                what, ", quiet for %d min" % mq if mq is not None else "", ", %d queued" % q if q else "")
        lv = n.get("live") or {}
        if lv.get("in_turn"):
            # the CLI's live stream says a turn is open: how long since its last line (or the history grew)
            last = max([x for x in (lv.get("at"), act) if x] or [0])
            qm = int((time.time() - last) // 60) if last else None
            tail = ", %d queued (read when the turn ends)" % q if q else ""
            if qm is not None and qm >= QUIET_MIN:
                return "yellow", "still in a turn, quiet for %d min (not crashed)%s" % (qm, tail)
            return "green", "in a turn, last output %s%s" % ("%d min ago" % qm if qm is not None else "not recorded", tail)
        if n.get("busy"):
            return "green", "working (%s), %s" % (n["busy"], seen) + (", %d queued" % q if q else "")
        if q:
            # running with letters waiting = it is inside a turn (letters go in when the turn ends);
            # a long turn is not a crash: only a long silence gives yellow, never red
            if mins is not None and mins >= 60:
                return "yellow", "in a long turn, quiet for %d min; %d queued (read when the turn ends)" % (mins, q)
            return "green", "in a turn; %d queued (read when the turn ends), %s" % (q, seen)
        # an eca (claude/codex) body reports no busy, so "nothing queued" may still be inside a turn: say only what is known
        return "green", "running, nothing queued, %s" % seen

    def rollup(self, k, nodes):
        n = nodes[k]
        worst, why, cnt, path = n["light"], n["why"], 1, [k]
        tl = n.get("team_light")
        if tl and LIGHT_ORDER[tl["light"]] < LIGHT_ORDER[worst]:
            worst, why = tl["light"], tl["why"]
        for c in n["children"]:
            self.rollup(c, nodes)
            cr = nodes[c]["rollup"]
            cnt += cr["nodes"]
            if LIGHT_ORDER[cr["worst"]] < LIGHT_ORDER[worst]:
                worst, why, path = cr["worst"], cr["why"], [k] + cr["path"]
        # v2 (12.8 #3): how many red / yellow / blue anywhere below (self included), and the worst 3 ids
        bad = [(LIGHT_ORDER[n["light"]], k)] if n["light"] in ("red", "yellow", "blue") else []
        counts = {"red": 0, "yellow": 0, "blue": 0}
        if n["light"] in counts:
            counts[n["light"]] += 1
        for c in n["children"]:
            cr = nodes[c]["rollup"]
            for col in counts:
                counts[col] += cr["counts"][col]
            bad += cr["_bad"]
        bad.sort()
        n["rollup"] = {"worst": worst, "why": why, "nodes": cnt, "path": path, "counts": counts,
                       "worst_ids": [b[1] for b in bad[:3]], "_bad": bad[:3]}

    def relay_letters(self):
        out = []
        for sub in ("new", "cur"):
            d = os.path.join(self.home.mailbox, sub)
            try:
                names = os.listdir(d)
            except OSError:
                continue
            for name in names:
                lt = load_json(os.path.join(d, name, "letter.json"), None)
                if not isinstance(lt, dict):
                    continue
                b = lt.get("body") if isinstance(lt.get("body"), dict) else {"what": lt.get("body")}
                if b.get("zone") == VIEW_ZONE:
                    continue  # aide letters are ingested, not shown as replies
                frm = b.get("from") or os.path.basename(str(lt.get("sender") or "").rstrip("/")) or "?"
                out.append({"dir": "in", "kind": "mail", "letter": name, "from": frm, "to": b.get("to") or "user",
                            "title": mask(b.get("title") or ""), "status": b.get("status"),
                            "what": mask(b.get("what") or ""), "sent_at": parse_time(lt.get("sent_at")),
                            "in_reply_to": lt.get("in_reply_to") or b.get("in_reply_to")})
        out.sort(key=lambda x: x["sent_at"] or 0, reverse=True)
        return out[:100]

    def zone_letters(self):
        fx = os.environ.get("VIEW_ASKS_FIXTURE")      # tests / demos: recorded letters instead of the user zone
        if fx:
            return load_json(fx, [])
        z = self.zone
        if not z:
            return []
        out = []
        try:
            zd = z.zone_dir(None)
            for main, same in z.waiting(zd):
                b = main.body
                qs = []
                for q in main.questions():
                    if isinstance(q, dict):
                        q = dict(q)
                        q["options"] = [o for o in (q.get("options") or []) if isinstance(o, dict)] \
                            if isinstance(q.get("options"), list) else []
                        qs.append(q)
                out.append({"letter": main.name, "kind": main.kind, "from": b.get("from"), "title": mask(b.get("title")),
                            "what": mask(b.get("what")), "questions": qs, "urgent": main.urgent,
                            "risk": b.get("risk", "normal"), "deadline": b.get("deadline"),
                            "decide": mask(b.get("decide")) if b.get("decide") else None, "sent_at": parse_time(main.sent_at), "same": len(same),
                            "fmt": main.fmt, "unseen": main.new})
        except Exception as e:  # zone broken: show it, do not crash the page
            out.append({"letter": "?", "kind": "fyi", "from": "aos-frontend", "title": "user zone unreadable: %s" % e,
                        "what": "", "questions": [], "error": True})
        return out

    def loop(self):
        while True:
            self.run_once()
            time.sleep(max(5, int(self.home.config().get("poll_s", 20))))

    def run_once(self):
        t0 = time.time()
        try:
            tr = self.collect()
            with self.lock:
                self.tree, self.err = tr, None
            self.tick = {"at": time.time(), "took_ms": int((time.time() - t0) * 1000), "ok": True, "error": None}
        except Exception as e:
            with self.lock:
                self.err = "%s: %s" % (type(e).__name__, e)
            self.tick = {"at": time.time(), "took_ms": int((time.time() - t0) * 1000), "ok": False, "error": self.err}
            return
        for f in self.on_tree:
            try:
                f(tr)
            except Exception as e:
                log_ev(self.home, "on_tree_failed", error="%s: %s" % (type(e).__name__, e))

    def get(self):
        with self.lock:
            return self.tree, self.err

    def drop_ask(self, letter):
        with self.lock:
            if self.tree and isinstance(self.tree.get("zone"), list):
                self.tree = dict(self.tree)
                self.tree["zone"] = [z for z in self.tree["zone"] if z.get("letter") != letter]


def load_zone():
    try:
        spec = importlib.util.spec_from_file_location("aos_user_zone", ZONE_PY)
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        return m
    except Exception:
        return None


# ---- phase 1: team folders, relay letters (view/1), the aide's tick ---------------------
# Plan: proto8/thinking/2026-11/14/view-1114/03-計劃.md §4 phase 1 + §8 + §10. No model calls anywhere.

VIEW_ZONE = "view/1"
VIEW_KINDS = ("report", "beat", "pass", "post")
VIEW_STATUS = {"report": ("PROGRESS", "BLOCKED", "DONE"), "beat": ("PROGRESS",), "pass": ("NEEDS-USER",),
               "post": ("DONE",)}
NOTE_STATUSES = ("start", "progress", "done", "blocked", "decision", "handoff", "ask")
CANON_KEYS = ("kind", "title", "what", "questions", "done_when", "risk", "urgent", "deadline",
              "default_if_silent", "dedupe_key")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$")
AIDE_SILENT_S = 35 * 60
NO_PROGRESS_S = 60 * 60
BEAT_S = 15 * 60
REPORT_GAP_S = 5 * 60
PASS_PER_HOUR = 8
PASS_PER_HOUR_NEAR = 10          # §8: a pass whose deadline is < 30 min away may use the zone's last 2 per hour
NEAR_DEADLINE_S = 30 * 60
SECRET_SCAN = [  # §8: explicit prefixes and *KEY= / *TOKEN= / *SECRET= / *PASSWORD= assignments
    ("sk- key", re.compile(r"\bsk-[A-Za-z0-9_\-]{12,}")),
    ("ghp_ token", re.compile(r"\bgh[po]_[A-Za-z0-9]{20,}")),
    ("AIza key", re.compile(r"\bAIza[A-Za-z0-9_\-]{20,}")),
    ("xox?- token", re.compile(r"\bxox[a-z]-[A-Za-z0-9\-]{10,}")),
    ("Bearer token", re.compile(r"Bearer\s+[A-Za-z0-9._\-]{12,}")),
    ("*KEY=/*TOKEN=/*SECRET=/*PASSWORD= assignment",
     re.compile(r"\b[A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)\s*=\s*\S+", re.I)),
]


class Fail(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def secret_hit(text):
    """Name of the first secret-looking pattern in text (never the value), or None."""
    for label, rx in SECRET_SCAN:
        if rx.search(text or ""):
            return label
    return None


def need_zone_mod():
    z = load_zone()
    if z is None:
        raise Fail("ToolMissing", "cannot load the user zone library %s" % ZONE_PY)
    return z


def canonical_sha(body, zmod):
    """sha256 hex over the question fields (§8) of the letter as the zone will hold it.
    zone.build_letter fills the same defaults aos-user send fills (what for decide), so the captain's file,
    the pass letter and the zone's copy all hash the same."""
    b = zmod.build_letter(dict(body), None)
    c = {k: b[k] for k in CANON_KEYS if k in b}
    s = json.dumps(c, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def facts_sha(facts):
    s = json.dumps(facts, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def now_local():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def table_rows():
    """The daemon table (aos-agent ctl ls --json). VIEW_LS_FIXTURE=FILE reads a recorded table instead (tests)."""
    fx = os.environ.get("VIEW_LS_FIXTURE")
    if fx:
        return load_json(fx, None)
    return run_json(["aos-agent", "ctl", "ls", "--json"])


def leader_subagents(name):
    if os.environ.get("VIEW_LS_FIXTURE"):
        return []
    st = run_json(["aos-agent", "ctl", "state", "-t", name, "subagents", "-j"]) or {}
    return [x.get("name") if isinstance(x, dict) else x for x in ((st.get("subagents") or {}).get("subagents") or [])]


def append_line(path, rec):
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, (json.dumps(rec, ensure_ascii=False) + "\n").encode("utf-8"))
    finally:
        os.close(fd)


def read_lines(path, limit=None):
    out = []
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return out
    for ln in lines[-limit:] if limit else lines:
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        if isinstance(r, dict):
            out.append(r)
    return out


class Team:
    """~/.aos/view/teams/<team>/: aide.json, notes.jsonl, outbox/<id>.json, outbox/sent/, sent.jsonl,
    send_failed (json), seq (+ seq.lock), aide_state.json. The team's workspace gets no files."""

    def __init__(self, home, name):
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise Fail("TeamBad", "team name %r: letters, digits, _ . - only" % (name,))
        self.name = name
        self.dir = os.path.join(home.dir, "teams", name)
        self.outbox = os.path.join(self.dir, "outbox")
        self.sent_dir = os.path.join(self.outbox, "sent")
        self.notes_path = os.path.join(self.dir, "notes.jsonl")
        self.sent_log = os.path.join(self.dir, "sent.jsonl")
        self.aide_path = os.path.join(self.dir, "aide.json")
        self.state_path = os.path.join(self.dir, "aide_state.json")
        self.failed_path = os.path.join(self.dir, "send_failed")

    def ensure(self):
        os.makedirs(self.sent_dir, exist_ok=True)
        return self

    def aide(self):
        a = load_json(self.aide_path, None)
        return a if isinstance(a, dict) else None

    def latest_note(self):
        ns = read_lines(self.notes_path, 50)
        return ns[-1] if ns else None

    def pending(self):
        try:
            return sorted(f for f in os.listdir(self.outbox) if f.endswith(".json") and not f.startswith("."))
        except OSError:
            return []

    def next_seq(self):
        """One number per letter this team sends, 1, 2, 3 ... (flock on seq.lock; shared by every sender)."""
        os.makedirs(self.dir, exist_ok=True)
        fd = os.open(os.path.join(self.dir, "seq.lock"), os.O_RDWR | os.O_CREAT, 0o644)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            p = os.path.join(self.dir, "seq")
            try:
                with open(p) as f:
                    n = int(f.read().strip() or 0)
            except (OSError, ValueError):
                n = 0
            n += 1
            with open(p + ".tmp", "w") as f:
                f.write("%d\n" % n)
            os.replace(p + ".tmp", p)
            return n
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)


def all_teams(home):
    d = os.path.join(home.dir, "teams")
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    out = []
    for n in names:
        if NAME_RE.match(n) and os.path.isdir(os.path.join(d, n)):
            out.append(Team(home, n))
    return out


def log_ev(home, ev, **kw):
    try:
        append_line(os.path.join(home.dir, "log.jsonl"), dict({"at": now_local(), "ev": ev}, **kw))
    except OSError:
        pass


# ---- relay ingestion (the backend side) ----

def _move(src, dst_dir, name):
    os.makedirs(dst_dir, exist_ok=True)
    dst = os.path.join(dst_dir, name)
    if os.path.exists(dst):
        dst = dst + "." + secrets.token_hex(3)
    os.rename(src, dst)
    return dst


def relay_finish(home, name):
    """A processed view/1 letter: mailbox/cur/<name> -> done/<YYYY-MM>/<name> (never deleted)."""
    return _move(os.path.join(home.mailbox, "cur", name), os.path.join(home.dir, "done", time.strftime("%Y-%m")), name)


def relay_reject(home, name, code, reason):
    dst = _move(os.path.join(home.mailbox, "cur", name), os.path.join(home.dir, "rejected"), name)
    with open(os.path.join(dst, "reason.txt"), "w", encoding="utf-8") as f:
        f.write("%s %s\n" % (code, reason))
    log_ev(home, "rejected", letter=name, code=code, reason=reason)
    return dst


def team_state_path(home, team):
    return os.path.join(home.state, "teams", team + ".json")


def passed_dir(home, team):
    return os.path.join(home.state, "passed", team)


def passes_last_hour(home, t):
    n = 0
    root = os.path.join(home.state, "passed")
    try:
        teams = os.listdir(root)
    except OSError:
        return 0
    for tm in teams:
        try:
            files = os.listdir(os.path.join(root, tm))
        except OSError:
            continue
        for f in files:
            if f.endswith(".json"):
                r = load_json(os.path.join(root, tm, f), {})
                if isinstance(r, dict) and isinstance(r.get("sent_at_s"), (int, float)) and t - r["sent_at_s"] < 3600:
                    n += 1
    return n


def _deadline_s(zmod, s):
    d = zmod.parse_deadline(s) if s else None
    return d.timestamp() if d else None


def ingest(home, zmod=None, t=None):
    """One pass over the relay mailbox. Only letters whose body.zone is view/1 are touched; plain replies stay
    where they are. Returns counts by outcome."""
    t = t or now()
    zmod = zmod or load_zone()
    out = {"stored": 0, "passed": 0, "duplicate": 0, "rejected": 0, "waiting": 0, "failed": 0}
    new_d, cur_d = os.path.join(home.mailbox, "new"), os.path.join(home.mailbox, "cur")
    for sub in ("new",):
        try:
            names = sorted(os.listdir(new_d))
        except OSError:
            return out
        for name in names:
            lt = load_json(os.path.join(new_d, name, "letter.json"), None)
            b = lt.get("body") if isinstance(lt, dict) else None
            if isinstance(b, dict) and b.get("zone") == VIEW_ZONE:
                try:
                    os.rename(os.path.join(new_d, name), os.path.join(cur_d, name))  # take (own rename)
                except OSError:
                    pass
    try:
        names = sorted(os.listdir(cur_d))
    except OSError:
        names = []
    passes = []
    for name in names:
        lt = load_json(os.path.join(cur_d, name, "letter.json"), None)
        b = lt.get("body") if isinstance(lt, dict) else None
        if not (isinstance(b, dict) and b.get("zone") == VIEW_ZONE):
            continue
        kind, team = b.get("kind"), b.get("team")
        if kind not in VIEW_KINDS:
            relay_reject(home, name, "KindBad", "kind must be one of %s" % ", ".join(VIEW_KINDS)); out["rejected"] += 1
            continue
        if not isinstance(team, str) or not NAME_RE.match(team):
            relay_reject(home, name, "TeamBad", "team must be a daemon-table name"); out["rejected"] += 1
            continue
        if b.get("status") not in VIEW_STATUS[kind]:
            relay_reject(home, name, "StatusBad", "%s letters have status %s" % (kind, "/".join(VIEW_STATUS[kind])))
            out["rejected"] += 1
            continue
        aide = Team(home, team).aide()
        sender = os.path.basename(str(lt.get("sender") or "").rstrip("/"))
        if aide and aide.get("aide") and kind != "post" and sender != aide.get("aide"):
            relay_reject(home, name, "SenderBad", "sent by %s, but the team's aide is %s" % (sender or "?", aide["aide"]))
            out["rejected"] += 1
            continue
        if kind == "pass":
            passes.append((name, lt, b))
            continue
        p = team_state_path(home, team)
        os.makedirs(os.path.dirname(p), exist_ok=True)
        st = load_json(p, {}) or {}
        at = parse_time(lt.get("sent_at")) or t
        st.update({"team": team, "aide": sender or st.get("aide"), "parent": b.get("parent"), "updated_at": t,
                   "last_seq": b.get("seq")})
        if kind == "beat":
            st["last_beat"] = at
        elif kind == "report":
            st["report"] = {"at": at, "seq": b.get("seq"), "status": b.get("status"), "title": mask(b.get("title") or ""),
                            "what": mask(b.get("what") or ""), "summary_by": b.get("summary_by"),
                            "snapshot_sha256": b.get("snapshot_sha256"),
                            "facts": json.loads(mask(json.dumps(b.get("facts"), ensure_ascii=False)))
                            if b.get("facts") is not None else None}
        else:
            st["post"] = {"at": at, "seq": b.get("seq"), "title": mask(b.get("title") or ""), "what": mask(b.get("what") or "")}
        write_json(p, st)
        relay_finish(home, name)
        out["stored"] += 1
    if not passes:
        return out
    if zmod is None:
        out["waiting"] += len(passes)
        log_ev(home, "pass_waiting", reason="the user zone library cannot be loaded")
        return out
    ready = []
    for name, lt, b in passes:
        team = b["team"]
        text = b.get("payload_text")
        try:
            data = json.loads(text) if isinstance(text, str) else None
        except ValueError:
            data = None
        if not isinstance(data, dict):
            relay_reject(home, name, "PayloadBad", "payload_text is not a JSON object"); out["rejected"] += 1
            continue
        sha = canonical_sha(data, zmod)
        if b.get("payload_sha256") != sha:
            relay_reject(home, name, "PayloadHashBad", "payload_sha256 %s, recomputed %s" % (b.get("payload_sha256"), sha))
            out["rejected"] += 1
            continue
        pid = b.get("payload_id")
        m = re.match(r"^([^/]+)/([^/]+)$", pid) if isinstance(pid, str) else None
        if not m or m.group(1) != team or not NAME_RE.match(m.group(2)):
            relay_reject(home, name, "PayloadIdBad", "payload_id must be <team>/<id>"); out["rejected"] += 1
            continue
        rid = m.group(2)
        rp = os.path.join(passed_dir(home, team), rid + ".json")
        old = load_json(rp, None)
        if isinstance(old, dict):
            if old.get("sha256") == sha:
                relay_finish(home, name); out["duplicate"] += 1
                log_ev(home, "pass_duplicate", letter=name, payload_id=pid)
            else:
                relay_reject(home, name, "PayloadIdReused", "%s was already passed with another hash" % pid)
                out["rejected"] += 1
            continue
        hit = secret_hit(text)
        if hit:
            relay_reject(home, name, "SecretInPayload", "payload looks like it holds a secret (%s)" % hit)
            out["rejected"] += 1
            continue
        zb = dict(data)
        zb["from"] = team
        zb["origin"] = "%s sha256:%s via %s" % (pid, sha, b.get("from") or os.path.basename(str(lt.get("sender") or "")))
        try:
            zmod.check_letter(zmod.build_letter(dict(zb), None))
        except zmod.Fail as e:
            relay_reject(home, name, "SchemaBad", str(e)); out["rejected"] += 1
            continue
        rt = b.get("reply_to_team")
        if not (isinstance(rt, str) and os.path.isabs(rt) and os.path.isdir(rt)):
            relay_reject(home, name, "ReplyToBad", "reply_to_team must be an existing absolute mailbox path")
            out["rejected"] += 1
            continue
        dl = _deadline_s(zmod, data.get("deadline"))
        ready.append(((data.get("urgent") is not True, dl if dl is not None else float("inf"),
                       parse_time(lt.get("sent_at")) or 0, name), name, lt, b, zb, sha, rid, rt, dl))
    ready.sort(key=lambda x: x[0])
    used = passes_last_hour(home, t)
    for _, name, lt, b, zb, sha, rid, rt, dl in ready:
        cap = PASS_PER_HOUR_NEAR if (dl is not None and dl - t < NEAR_DEADLINE_S) else PASS_PER_HOUR
        if used >= cap:
            out["waiting"] += 1
            continue
        env = cli_env()
        env["AOS_STACK"] = home.dir
        args = [AOS_USER, "send", "--kind", zb.get("kind"), "--reply-to", rt]
        try:
            p = subprocess.run(args, input=json.dumps(zb, ensure_ascii=False), capture_output=True, text=True,
                               timeout=30, env=env, cwd="/")
            code, so, se = p.returncode, p.stdout, p.stderr
        except (subprocess.TimeoutExpired, OSError) as e:
            code, so, se = 1, "", str(e)
        if code != 0:
            line = (se.strip().splitlines() or ["aos-user send failed"])[-1]
            if "SchemaBad" in line:
                relay_reject(home, name, "SchemaBad", line); out["rejected"] += 1
            else:
                log_ev(home, "pass_failed", letter=name, error=short(line, 300)); out["failed"] += 1
            continue
        zl = so.strip().splitlines()[-1] if so.strip() else None
        os.makedirs(passed_dir(home, b["team"]), exist_ok=True)
        write_json(os.path.join(passed_dir(home, b["team"]), rid + ".json"),
                   {"team": b["team"], "id": rid, "payload_id": b["payload_id"], "sha256": sha, "zone_letter": zl,
                    "kind": zb.get("kind"), "title": mask(zb.get("title") or ""), "reply_to": rt,
                    "aide": b.get("from"), "relay_letter": name, "sent_at": now_local(), "sent_at_s": t})
        relay_finish(home, name)
        log_ev(home, "passed", letter=name, payload_id=b["payload_id"], zone_letter=zl)
        used += 1
        out["passed"] += 1
    return out


def team_info(home):
    """{leader name: {...}} for the tree: latest note, aide, last beat, passed count."""
    out = {}
    for tm in all_teams(home):
        aide = tm.aide()
        st = load_json(team_state_path(home, tm.name), {}) or {}
        try:
            passed = len([f for f in os.listdir(passed_dir(home, tm.name)) if f.endswith(".json")])
        except OSError:
            passed = 0
        note = tm.latest_note()
        try:
            aide_mtime = os.path.getmtime(tm.aide_path) if aide else None
        except OSError:
            aide_mtime = None
        leader = (aide or {}).get("leader") or tm.name
        out[leader] = {"team": tm.name, "aide": aide, "aide_mtime": aide_mtime, "state": st, "passed": passed,
                       "note": {"at": parse_time(note.get("at")), "status": note.get("status"),
                                "text": mask(note.get("text") or ""), "on": note.get("on")} if note else None}
    return out


def team_light(info, n, nodes, asks_from_team, t):
    """(light, why) from phase-1 facts, or None. Goes into rollup (§10), not into the node's own light."""
    if not info:
        return None
    up = [c for c in n["children"] if (nodes[c].get("state") or "").lower() == "running"]
    if (n.get("state") or "").lower() != "running" and not up:
        return None  # §8: everyone stopped -> no heartbeat lights
    if info.get("aide"):
        lb = info["state"].get("last_beat")
        if lb is None:
            if info.get("aide_mtime") and t - info["aide_mtime"] >= AIDE_SILENT_S:
                return "red", "aide silent (no beat yet)"
        elif t - lb >= AIDE_SILENT_S:
            return "red", "aide silent %d min" % ((t - lb) // 60)
    note = info.get("note")
    if note and note.get("status") != "done" and note.get("at") and t - note["at"] >= NO_PROGRESS_S \
            and not asks_from_team:
        return "yellow", "no progress 60 min"
    return None


# ---- the aide's side (aos-frontend aide-tick, an on_clock hook) ----

def beat_offset(team):
    return int(hashlib.sha256(team.encode("utf-8")).hexdigest()[:8], 16) % 181


def relay_send(home, body, sender_stack):
    if not os.path.isdir(os.path.join(home.mailbox, "new")):
        raise Fail("RelayMissing", "no relay mailbox at %s (aos-frontend init)" % home.mailbox)
    env = dict(os.environ)
    env["AOS_STACK"] = sender_stack  # sender = the aide's own stack (the hook's AOS_STACK is its hook cell)
    env.pop("AOS_WS", None)  # aos-post takes $AOS_WS before $AOS_STACK; the hook has the aide's workspace there
    try:
        p = subprocess.run(["aos-post", "send", "--reply-to", home.mailbox, home.mailbox],
                           input=json.dumps(body, ensure_ascii=False), capture_output=True, text=True,
                           timeout=20, env=env, cwd="/")
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, str(e)
    if p.returncode != 0:
        return None, (p.stderr.strip().splitlines() or ["aos-post send failed"])[-1]
    return p.stdout.strip(), None


def aide_tick(home, team_name=None, event=None, t=None):
    """One run of the aide: carry outbox files as pass letters, a report when facts changed, a beat every 15 min."""
    t = t or now()
    event = event if isinstance(event, dict) else {}
    stack = event.get("stack") or ""
    if not stack:
        hs = os.environ.get("AOS_STACK", "").rstrip("/")
        stack = hs.split("/hookeds/")[0] if "/hookeds/" in hs else hs
    stack = stack.rstrip("/")
    if not stack:
        raise Fail("StackMissing", "no stack: run as an on_clock hook (event field stack) or set AOS_STACK")
    me = os.path.basename(stack)
    if not team_name:
        team_name = re.sub(r"-aide-\d+$", "", me)
    tm = Team(home, team_name)
    aide = tm.aide()
    if not aide:
        raise Fail("AideMissing", "no %s (the captain writes it: team, parent, leader, aide, tags)" % tm.aide_path)
    tm.ensure()
    leader = aide.get("leader") or tm.name
    aide_name = aide.get("aide") or me
    parent = aide.get("parent")
    rows = table_rows()
    if not isinstance(rows, list):
        raise Fail("TableMissing", "aos-agent ctl ls --json failed; nothing sent")
    by = {r.get("name"): r for r in rows if isinstance(r, dict)}
    lrow = by.get(leader)
    reply_to_team = os.path.join(lrow["stack"], "mailbox") if lrow and lrow.get("stack") else None
    st = load_json(tm.state_path, {}) or {}
    failed = load_json(tm.failed_path, {}) or {}
    res = {"team": tm.name, "passed": [], "report": False, "beat": False, "errors": []}

    def base(kind, status, title, what):
        return {"zone": VIEW_ZONE, "kind": kind, "team": tm.name, "parent": parent, "seq": tm.next_seq(),
                "from": aide_name, "to": "view", "status": status, "title": title, "what": what}

    # (a) pass every outbox file not carried yet
    for fn in tm.pending():
        path = os.path.join(tm.outbox, fn)
        pid = fn[:-len(".json")]
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
            data = json.loads(text)
            if not isinstance(data, dict):
                raise ValueError("not an object")
        except (OSError, ValueError) as e:
            res["errors"].append("%s: %s" % (fn, e))
            failed[pid] = {"count": (failed.get(pid) or {}).get("count", 0) + 1, "error": "unreadable: %s" % e}
            continue
        if not reply_to_team:
            res["errors"].append("%s: leader %s is not on the daemon table" % (fn, leader))
            failed[pid] = {"count": (failed.get(pid) or {}).get("count", 0) + 1, "error": "leader not on the table"}
            continue
        body = base("pass", "NEEDS-USER", "pass: %s" % short(data.get("title") or pid, 200),
                    "a %s letter from %s for the user zone" % (data.get("kind"), tm.name))
        body.update({"payload_id": "%s/%s" % (tm.name, pid), "payload_text": text,
                     "payload_sha256": canonical_sha(data, need_zone_mod()), "written_by": leader,
                     "reply_to_team": reply_to_team})
        name, err = relay_send(home, body, stack)
        if err:
            res["errors"].append("%s: %s" % (fn, err))
            failed[pid] = {"count": (failed.get(pid) or {}).get("count", 0) + 1, "error": short(err, 300)}
            continue
        os.replace(path, os.path.join(tm.sent_dir, fn))
        failed.pop(pid, None)
        res["passed"].append(pid)
    if failed or os.path.exists(tm.failed_path):
        write_json(tm.failed_path, failed)
    # (b) report when the facts changed (at most one per REPORT_GAP_S)
    def row_facts(r):
        return {"state": r.get("state"), "busy": r.get("busy"), "queued": r.get("queued")}
    member_names = set(leader_subagents(leader)) if lrow else set()
    for nm in by:
        if nm and (nm.startswith(leader + "-") or nm.startswith(tm.name + "-")):
            member_names.add(nm)
    member_names.discard(aide_name)
    member_names.discard(leader)
    members = [dict({"name": nm}, **row_facts(by[nm])) for nm in sorted(member_names)
               if nm in by and not nm.startswith("llm_")]
    note = tm.latest_note()
    facts = {"leader": dict({"name": leader}, **(row_facts(lrow) if lrow else {"state": "missing", "busy": None,
                                                                              "queued": None})),
             "members": members, "note": note, "pending_pass": len(tm.pending())}
    snap = facts_sha(facts)
    if snap != st.get("snapshot_sha256") and t - (st.get("last_report_at") or 0) >= REPORT_GAP_S:
        status = {"blocked": "BLOCKED", "done": "DONE"}.get((note or {}).get("status"), "PROGRESS")
        what = "leader %s %s; %d member(s) running; latest note: %s" % (
            leader, facts["leader"]["state"], len([m for m in members if m.get("state") == "running"]),
            ("%s %s" % (note.get("status"), short(note.get("text") or "", 200))) if note else "none")
        body = base("report", status, "%s: %s" % (tm.name, short(what, 120)), what)
        body.update({"said": {"now": "", "next": "", "blocked": ""}, "summary_by": "none",
                     "snapshot_sha256": snap, "facts": facts})
        name, err = relay_send(home, body, stack)
        if err:
            res["errors"].append("report: %s" % err)
        else:
            st.update({"snapshot_sha256": snap, "last_report_at": t})
            res["report"] = True
    # (c) a beat every 15 min, shifted by a fixed per-team offset (0-180 s)
    slot = int((t - beat_offset(tm.name)) // BEAT_S)
    if st.get("beat_slot") != slot:
        name, err = relay_send(home, base("beat", "PROGRESS", "%s: aide alive" % tm.name, "beat"), stack)
        if err:
            res["errors"].append("beat: %s" % err)
        else:
            st.update({"beat_slot": slot, "last_beat_at": t})
            res["beat"] = True
    write_json(tm.state_path, st)
    return res


# ---- page ----------------------------------------------------------------------------

