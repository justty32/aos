# Example user unit for the aos-frontend page. Path rule one (11-17): AOS_HOME is the proto8 folder; here it is
# %h/repo/aos/proto8 and the tree is %h/aos-home (proto8/thinking/2026-11/17/重建步驟單.md). Change both to yours.
# env.sh sets AOS_HOME and puts every cmd/*/bin, impls/*/bin and frontend/bin of that proto8 on PATH (aos-frontend, aos-agent, aos-post);
# it also clears every AOS_*, so AOS_DAEMON is set after it, not with Environment=.
# aos-user is not in proto8: aos-frontend looks for it in $VIEW_TOOLS, else ~/aos-home/ws/tools (add VIEW_TOOLS=... before exec).
[Unit]
Description=aos-frontend panorama page (127.0.0.1:8767)
After=default.target

[Service]
Type=simple
WorkingDirectory=/
ExecStart=/bin/bash -c '. %h/repo/aos/proto8/env.sh && AOS_DAEMON=%h/aos-home/.stack/ exec aos-frontend serve'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
