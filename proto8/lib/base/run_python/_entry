#!/usr/bin/env python3
# run_python - 用 python3 跑一段程式，回結束碼與輸出（stdout＋stderr 合在一起）
# 介面（lib/README 的契約）：stdin 收 {"code", "timeout_s"?}；stdout 是輸出、最後一行 [exit code N]（太長留頭 3000 字＋尾 3000 字）。
# 程式寫進這個工具的小格（$AOS_STACK/main.py，P-17）再跑、cwd 也是那裡（-I：不看使用者的 site、PYTHON* 環境變數）；不用 $AOS_WS。
# 不是沙盒：能碰到的跟這台機器的使用者一樣多。程式本身退非 0 是結果、不是錯（最後一行寫結束碼）。
# 逾時（預設 60 秒、上限 300）＝整群先 TERM、2 秒後 KILL、算 CommandFailed（已經印出來的照樣給）；這個工具被外面 TERM 時也先停掉那一群。
# 錯：stderr 與 stdout 各一行「run_python: error: 代號 原因」、退 1。來源：demo/agent-gus/tools/run_python（10-24；遷移時錯誤照 lib 契約：
# 以前「模型的錯、逾時」印「錯誤：…」退 0，現在一律退 1，回不回給腦由叫它的 agent 決定——agent-gus 回給腦；demo/agent-gus 11-04 刪了）。
import json, os, shutil, signal, subprocess, sys
HELP = """\
usage: run_python < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Run a piece of Python with python3 -I in this tool's stack cell; print its
stdout+stderr combined. The last line is always [exit code N]; the program exiting
non-zero is a result, not an error of this tool. Over timeout_s: CommandFailed.
Result on stdout. On error: one line "run_python: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "run_python"
tool_io.start(NAME, HELP)
TIMEOUT_DEFAULT, TIMEOUT_MAX = 60, 300      # 秒
GRACE = 2                                   # TERM 之後等幾秒再 KILL
OUT_MAX, OUT_HEAD = 8000, 3000


die = tool_io.die
arguments = tool_io.arguments


def clip(out):
    if len(out) > OUT_MAX:
        return out[:OUT_HEAD] + "\n... (%d chars omitted) ...\n" % (len(out) - 2 * OUT_HEAD) + out[-OUT_HEAD:]
    return out


stack = os.environ.get("AOS_STACK")
if not stack:
    die("StackMissing", "AOS_STACK is not set")
args = arguments()
code, limit = args.get("code"), args.get("timeout_s", TIMEOUT_DEFAULT)
if not isinstance(code, str) or not code.strip():
    die("ArgumentsBad", "missing code (a string of Python code)")
if type(limit) not in (int, float) or not 0 < limit <= TIMEOUT_MAX:
    die("ArgumentsBad", "timeout_s must be seconds between 0 and %d" % TIMEOUT_MAX)
os.makedirs(stack, exist_ok=True)
with open(os.path.join(stack, "main.py"), "w", encoding="utf-8") as f:
    f.write(code)
try:
    p = subprocess.Popen(["python3", "-I", "main.py"], cwd=stack, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                         stderr=subprocess.STDOUT, text=True, errors="replace", start_new_session=True)
except OSError as e:
    die("LaunchFailed", "python3 failed to start: %s" % e.strerror)


def stop():
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, None)):
        try:
            os.killpg(p.pid, sig)
        except ProcessLookupError:
            return
        try:
            p.wait(wait)
            return
        except subprocess.TimeoutExpired:
            pass


def on_term(signum, frame):                     # 外面（act 格逾時）停我時，程式那群不能留下來
    stop()
    sys.exit(128 + signum)


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)
try:
    out, _ = p.communicate(timeout=limit)
except subprocess.TimeoutExpired:
    stop()
    out, _ = p.communicate()
    die("CommandFailed", "ran over %g s; stopped the whole process group" % limit, clip(out) + ("\n" if out and not out.endswith("\n") else ""))
code = 128 - p.returncode if p.returncode < 0 else p.returncode   # 被訊號殺＝128＋N（R12）
text = clip(out)
print(text + ("" if not text or text.endswith("\n") else "\n") + "[exit code %d]" % code)   # 結束碼一律最後一行（stdio-unify R2，同 bash）
