#!/usr/bin/env python3
# ls - 列一個資料夾的子項，一次一頁、回 JSON
# 介面（lib/README 的契約）：stdin 收 {"path"?: ".", "offset"?: 0, "max_items"?: 100, "hidden"?: false}；
# stdout 一份 JSON {"path", "counter_items", "items": [{"name", "type"(file／dir／link), "size"?, "mtime", "link_to"?, …}], "next_offset"?, "counter_hidden"?}
# 資料夾多 counter_children（子項數）與 aos（裡面有哪些 _entry、.env、_tooldef.json…）；檔多 exec（可執行）；.json 檔多 keys（頂層 key，最多 12 個；多的個數放 counter_keys_more）。
# 資料夾在前、照名字排；. 開頭的預設不列（數目放 counter_hidden）；還有就給 next_offset。路徑：相對從 $AOS_WS 算、絕對照用（11-10 tool-packs 不限工作區）。
# 計數的 key 一律 counter_*（10-25，原 total、children、hidden、keys_more）。
# 錯：stderr 與 stdout 各一行「ls: error: 代號 原因」、退 1。（10-24 遷移：併進 demo/file-tools/ls 的加料——aos 記號、children、exec、JSON 頂層 key）
import json, os, sys, time
HELP = """\
usage: ls < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
List the entries of a folder (relative paths start at $AOS_WS), one page at a time, as JSON.
Result on stdout. On error: one line "ls: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "ls"
tool_io.start(NAME, HELP)
LIMIT_DEFAULT, LIMIT_MAX = 100, 500
AOS_MARKS = ("_entry", "_entry.json", "_metainfo.json", ".env", "_tooldef.json", "tools.json", "loop.json", "fsm.json")
JSON_KEYS_MAX = 12                  # JSON 檔最多給幾個頂層 key
JSON_PEEK_MAX = 1024 * 1024         # 這麼大以下的 .json 才打開看頂層


die = tool_io.die
arguments = tool_io.arguments


def iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + ".%03d+00:00" % int((t % 1) * 1000)


args = arguments()
rel = args.get("path", ".")
offset, max_items, hidden = args.get("offset", 0), args.get("max_items", LIMIT_DEFAULT), args.get("hidden", False)   # 上限一律 max_*（10-25 前叫 limit）
if not isinstance(rel, str) or not rel:
    die("ArgumentsBad", "path must be a string")
if type(offset) is not int or offset < 0:
    die("ArgumentsBad", "offset must be an integer >= 0")
if type(max_items) is not int or not 0 < max_items <= LIMIT_MAX:
    die("ArgumentsBad", "max_items must be an integer from 1 to %d" % LIMIT_MAX)
if not isinstance(hidden, bool):
    die("ArgumentsBad", "hidden must be a boolean")

d = tool_io.ws_path(rel)
if not os.path.exists(d):
    die("FileMissing", rel)
if not os.path.isdir(d):
    die("FileBad", "%s is not a directory; use read for files" % rel)
try:
    names = os.listdir(d)
except OSError as e:
    die("ReadFailed", "%s: %s" % (rel, e.strerror))
dots = [n for n in names if n.startswith(".")]
if not hidden:
    names = [n for n in names if not n.startswith(".")]
names.sort(key=lambda n: (not os.path.isdir(os.path.join(d, n)), n))


def aos_marks(p):
    try:
        have = set(os.listdir(p))
    except OSError:
        return []
    return [m for m in AOS_MARKS if m in have]


def json_top(p, it):
    try:
        with open(p, encoding="utf-8") as f:
            v = json.load(f)
    except (OSError, ValueError):
        it["json"] = "broken"
        return
    if isinstance(v, dict):
        it["keys"] = list(v)[:JSON_KEYS_MAX]
        if len(v) > JSON_KEYS_MAX:
            it["counter_keys_more"] = len(v) - JSON_KEYS_MAX
    else:
        it["json"] = "array" if isinstance(v, list) else "value"


def item(n):
    p = os.path.join(d, n)
    it = {"name": n}
    try:
        st = os.lstat(p)
    except OSError:
        it["type"] = "missing"
        return it
    if os.path.islink(p):
        it["type"] = "link"
        it["link_to"] = tool_io.shown_path(os.path.realpath(p))
    elif os.path.isdir(p):
        it["type"] = "dir"
        try:
            it["counter_children"] = len(os.listdir(p))
        except OSError:
            pass
        marks = aos_marks(p)
        if marks:
            it["aos"] = marks
    else:
        it["type"] = "file"
        it["size"] = st.st_size
        if st.st_mode & 0o111:
            it["exec"] = True
        if n.endswith(".json") and st.st_size <= JSON_PEEK_MAX:
            json_top(p, it)
    it["mtime"] = iso(st.st_mtime)
    return it


page = names[offset:offset + max_items]
shown = tool_io.shown_path(d)
res = {"path": shown, "counter_items": len(names), "items": [item(n) for n in page]}
if offset + max_items < len(names):
    res["next_offset"] = offset + max_items
if not hidden and dots:
    res["counter_hidden"] = len(dots)
print(json.dumps(res, ensure_ascii=False))
