#!/usr/bin/env python3
# json_write - 照 JSON 指標改一份 JSON 檔的幾個位置：先全部試過、一處不合就整份不寫
# 介面（lib/README 的契約）：stdin 收 {"path", "set"?: {指標: 新值}, "del"?: [指標]}；先照順序做 set、再做 del；
# set 的指標中間缺的物件層自動建，陣列用 "-" 接在尾巴、數字要是既有的那一項；del 的指標一定要指得到。
# stdout 一份 JSON {"path", "counter_set": 幾個, "counter_del": 幾個, "top": 改完頂層的 key（或 {"type": "array", "counter_items"}）}（計數 10-25 改 counter_*，原 set、del、len）。錯：stderr 與 stdout 各一行「json_write: error: 代號 原因」、退 1。
# 做法（10-24 遷移，代定 14「換實作不換介面」）：先在記憶體裡照上面的規則全部做一遍（錯誤代號在這裡定），都合了才交給 C++ 的 aos-json 寫：
#   連續的 set 一次 `aos-json batch --parents 檔`、接陣列尾巴的 `aos-json append 檔#指標`、del 每個一次 `aos-json del 檔#指標`——
#   aos-json 原子寫入、只重寫有變的那一塊（排版不換）。aos-json 照 PATH 找；它的 stderr 原樣往上、這裡不讀（C-53），失敗只說結束碼。
#   不穿 $ref：路上經過 {"$ref"}／{"$env"} 物件時 aos-json 會拒絕（WriteFailed），要穿過去用 aos-json 本身。
import json, os, subprocess, sys
HELP = """\
usage: json_write < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Change a JSON file (relative paths start at $AOS_WS) at JSON pointers: set first, then del; if any
place does not fit, the file is not written. Prints a one-line JSON summary.
Result on stdout. On error: one line "json_edit: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "json_write"
tool_io.start(NAME, HELP)
SIZE_MAX = 4 * 1024 * 1024


die = tool_io.die
arguments = tool_io.arguments


def parts(pointer):
    if pointer == "":
        die("PointerBad", "cannot edit the whole document (pointer is empty); use write to rewrite it")
    if not pointer.startswith("/"):
        die("PointerBad", "pointer must start with /: %s" % pointer)
    return [raw.replace("~1", "/").replace("~0", "~") for raw in pointer[1:].split("/")]


def step(here, key, pointer, make):
    """走一層；make＝缺的物件層自動建（set 用）。回 (容器, 正規化後的 key) 給最後一層用，中途回下一層。"""
    if isinstance(here, dict):
        if key not in here:
            if not make:
                die("PointerMissing", "%s: no key %s" % (pointer, key))
            here[key] = {}
        return here[key]
    if isinstance(here, list):
        if not key.isdigit() or int(key) >= len(here):
            die("PointerMissing", "%s: array has no item %s (%d items)" % (pointer, key, len(here)))
        return here[int(key)]
    die("PointerMissing", "%s: %s is neither an object nor an array" % (pointer, key))


def do_set(doc, pointer, value):
    keys = parts(pointer)
    here = doc
    for key in keys[:-1]:
        here = step(here, key, pointer, make=True)
    last = keys[-1]
    if isinstance(here, dict):
        here[last] = value
    elif isinstance(here, list):
        if last == "-":
            here.append(value)
            return "append"
        elif last.isdigit() and int(last) < len(here):
            here[int(last)] = value
        else:
            die("PointerMissing", "%s: array has no item %s (%d items; use - to append)" % (pointer, last, len(here)))
    else:
        die("PointerMissing", "%s: parent is neither an object nor an array" % pointer)
    return "set"


def do_del(doc, pointer):
    keys = parts(pointer)
    here = doc
    for key in keys[:-1]:
        here = step(here, key, pointer, make=False)
    last = keys[-1]
    if isinstance(here, dict) and last in here:
        del here[last]
    elif isinstance(here, list) and last.isdigit() and int(last) < len(here):
        del here[int(last)]
    else:
        die("PointerMissing", "%s: not found" % pointer)


args = arguments("path")
sets, dels = args.get("set", {}), args.get("del", [])
if not isinstance(sets, dict) or not all(isinstance(k, str) for k in sets):
    die("ArgumentsBad", "set must be an object of {pointer: new value}")
if not isinstance(dels, list) or not all(isinstance(k, str) for k in dels):
    die("ArgumentsBad", "del must be an array of pointers")


def unquote(pointer):
    """小模型把鍵包上引號（11-11 晚 gemma 寫 "'/n'"、"\\"/tags\\""，給了提示還連錯十幾次）：不以 / 開頭的鍵本來就不合法，
    剝掉引號後以 / 開頭＝只有一種讀法，直接照剝掉的用；其他照原樣交給 parts 報錯。"""
    bare = pointer.strip("'\"\\ ")
    return bare if not pointer.startswith("/") and bare.startswith("/") else pointer


sets, dels = {unquote(k): v for k, v in sets.items()}, [unquote(k) for k in dels]
if not sets and not dels:
    die("ArgumentsBad", "need at least one of set and del")

path = tool_io.ws_path(args["path"])
if not os.path.exists(path):
    die("FileMissing", "%s (use write for a new file)" % args["path"])
if os.path.isdir(path):
    die("FileBad", "%s is a directory" % args["path"])
if os.path.getsize(path) > SIZE_MAX:
    die("FileBad", "%s is over %dMB" % (args["path"], SIZE_MAX // (1024 * 1024)))
try:
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
except OSError as e:
    die("ReadFailed", "%s: %s" % (args["path"], e.strerror))
except (ValueError, UnicodeDecodeError) as e:
    die("FileBad", "%s is not JSON: %s" % (args["path"], e))
if not isinstance(doc, (dict, list)):
    die("FileBad", "%s: top level is neither an object nor an array; cannot edit inside" % args["path"])

steps = []                                   # 全部先在記憶體裡做完，哪一處錯都不寫檔
for pointer, value in sets.items():
    kind = do_set(doc, pointer, value)
    if kind == "set" and steps and steps[-1][0] == "batch":
        steps[-1][1][pointer] = value
    elif kind == "set":
        steps.append(("batch", {pointer: value}))
    else:
        steps.append(("append", pointer[:-2], value))
for pointer in dels:
    do_del(doc, pointer)
    steps.append(("del", pointer))


def aos_json(argv, stdin=None):
    try:
        r = subprocess.run(["aos-json"] + argv, input=stdin, text=True, stdout=subprocess.DEVNULL)   # stderr 不吞
    except OSError as e:
        die("LaunchFailed", "aos-json failed to start (aos-json must be on PATH): %s" % e.strerror)
    if r.returncode != 0:
        die("WriteFailed", "aos-json %s exited %d (reason on stderr)" % (argv[0], r.returncode))


for op in steps:                             # 值一律從 stdin 給（負數放參數會被當旗標）
    if op[0] == "batch":
        aos_json(["batch", "--parents", path], json.dumps(op[1], ensure_ascii=False))
    elif op[0] == "append":
        aos_json(["append", path + ("#" + op[1] if op[1] else "")], json.dumps(op[2], ensure_ascii=False))
    else:
        aos_json(["del", "%s#%s" % (path, op[1])])
top = list(doc)[:20] if isinstance(doc, dict) else {"type": "array", "counter_items": len(doc)}
print(json.dumps({"path": args["path"], "counter_set": len(sets), "counter_del": len(dels), "top": top}, ensure_ascii=False))
