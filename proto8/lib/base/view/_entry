#!/usr/bin/env python3
# view - 漸進看工作區裡一個檔：JSON 一次看一層、大的文字檔先給大綱
# 介面（lib/README 的契約）：stdin 收 {"path", "pointer"?} 或 {"path", "start"?, "end"?}；stdout 一份 JSON。
# JSON 檔（內容解得開就算，含沒副檔名的 _entry）：照 pointer（RFC 6901，"" 或沒給＝整份）看一層——小的（≤ 1000 字）直接給 value，
#   大的給 children（每個子項一句摘要），要看哪個子項就把它接到 pointer 後面再叫一次。
# 文字檔：給了 start／end（行號，第一行是 1）＝那幾行原文；沒給時小檔（≤ 200 行且 ≤ 8KB）整份給，大檔先給大綱
#   （Python：class／def 與行號範圍；Markdown：標題與行號；其他：前 40 行），再用 start／end 看要的那段。一次最多 2000 行或 50KB。
# 要把 JSON 當文字看（看原始排版），給 start／end 就好。路徑從 $AOS_WS 算、不能跑出去。
# 計數的 key 一律 counter_*（10-25，原 total_lines、children_more，摘要裡的 keys、items、chars）。
# 錯：stderr 與 stdout 各一行「view: error: 代號 原因」、退 1。來源：demo/file-tools/view（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import ast, json, os, re, signal, sys
HELP = """\
usage: view < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
View a file in the workspace step by step: JSON one level at a time, big text files
as an outline first, or the lines start..end.
Arguments: one JSON object on stdin (empty stdin = {}):
  path     string, required
  pointer  string
  start    integer
  end      integer
Result on stdout. On error: one line "view: error: CODE reason" on stderr and stdout, exit 1.
"""
if "--help" in sys.argv[1:]:                    # --help：英文說明印 stdout、退 0（stdio-unify R3）
    sys.stdout.write(HELP)
    sys.exit(0)
signal.signal(signal.SIGINT, lambda signum, frame: sys.exit(130))   # Ctrl-C：不吐 traceback、退 130（R12）

NAME = "view"


def die(code, reason):
    line = "%s: error: %s %s" % (NAME, code, reason)
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


def workspace():
    ws = os.environ.get("AOS_WS")
    if not ws or not os.path.isdir(ws):
        die("WsMissing", "AOS_WS is not set or not a directory")
    return os.path.realpath(ws)


def arguments(*required):
    try:
        a = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        die("ArgumentsBad", "stdin is not JSON")
    if not isinstance(a, dict):
        die("ArgumentsBad", "arguments must be an object")
    for k in required:
        if not isinstance(a.get(k), str) or not a[k]:
            die("ArgumentsBad", "missing %s (a string)" % k)
    return a


def inside(rel, root_ok=True):
    """工作區裡的真實路徑；解開 .. 與捷徑後跑出去＝PathBad。回 (絕對路徑, 給人看的相對路徑)。"""
    p = os.path.realpath(os.path.join(ROOT, rel))
    if os.path.commonpath([ROOT, p]) != ROOT or (p == ROOT and not root_ok):
        die("PathBad", "%s is outside the workspace" % rel)
    return p, (os.path.relpath(p, ROOT) if p != ROOT else ".")


def json_summary(v):
    """一個 JSON 值的一句摘要：型別＋大小（物件幾個 key、陣列幾項、字串幾字），純值短的直接給。"""
    if isinstance(v, dict):
        return {"type": "object", "counter_keys": len(v)}
    if isinstance(v, list):
        return {"type": "array", "counter_items": len(v)}
    if isinstance(v, str) and len(v) > 80:
        return {"type": "string", "counter_chars": len(v), "head": v[:60]}
    names = {type(None): "null", bool: "boolean", int: "number", float: "number", str: "string"}
    return {"type": names[type(v)], "value": v}


SMALL_JSON = 1000                       # 序列化後幾個字以內直接給 value
SMALL_TEXT_LINES, SMALL_TEXT_BYTES = 200, 8 * 1024
MAX_LINES, MAX_BYTES = 2000, 50 * 1024  # 同 read
CHILDREN_MAX = 200

ROOT = workspace()
a = arguments("path")
p, shown = inside(a["path"])
pointer, start, end = a.get("pointer"), a.get("start"), a.get("end")
if pointer is not None and not isinstance(pointer, str):
    die("ArgumentsBad", "pointer must be a string (e.g. /states/think)")
for k, v in (("start", start), ("end", end)):
    if v is not None and (type(v) is not int or v < 1):
        die("ArgumentsBad", "%s must be a positive integer" % k)
if not os.path.exists(p):
    die("FileMissing", a["path"])
if os.path.isdir(p):
    die("FileBad", "%s is a directory; use ls for directories" % a["path"])
try:
    with open(p, "rb") as f:
        data = f.read()
except OSError as e:
    die("ReadFailed", "%s: %s" % (a["path"], e.strerror))
if b"\0" in data[:8192]:
    die("FileBad", "%s looks like a binary file; not reading it" % a["path"])
text = data.decode("utf-8", "replace")

doc = None
if start is None and end is None:
    try:
        doc = json.loads(text)
    except ValueError:
        if pointer:
            die("FileBad", "%s is not JSON, so pointer does not apply; use start/end for lines" % a["path"])

if doc is not None:                     # ---- JSON：照 pointer 看一層
    v = doc
    pointer = pointer or ""
    if pointer and not pointer.startswith("/"):
        die("ArgumentsBad", "pointer must start with / (\"\" = whole document)")
    for raw in pointer.split("/")[1:] if pointer else []:
        key = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(v, dict) and key in v:
            v = v[key]
        elif isinstance(v, list) and key.isdigit() and int(key) < len(v):
            v = v[int(key)]
        else:
            die("PointerMissing", "%s#%s not found (%s is missing)" % (shown, pointer, key))
    res = {"path": shown, "format": "json", "pointer": pointer}
    res.update(json_summary(v))
    if isinstance(v, (dict, list)):
        if len(json.dumps(v, ensure_ascii=False)) <= SMALL_JSON:
            res["value"] = v
        else:
            items = list(v.items()) if isinstance(v, dict) else list(enumerate(v))
            res["children"] = [dict({"key": k}, **json_summary(c)) for k, c in items[:CHILDREN_MAX]]
            if len(items) > CHILDREN_MAX:
                res["counter_children_more"] = len(items) - CHILDREN_MAX
            res["hint"] = "append a child key to pointer to look inside (e.g. %s/%s)" % (pointer, items[0][0]) if items else ""
    out(res)
    sys.exit(0)

lines = text.split("\n")                # ---- 文字檔
if text.endswith("\n"):
    lines.pop()
total = len(lines)
res = {"path": shown, "format": "text", "counter_lines": total}


def segment(s, e):
    s0 = s - 1
    if total and s0 >= total:
        die("ArgumentsBad", "start %d is past the end of the file (%d lines)" % (s, total))
    e = min(e, total)
    picked, size = [], 0
    for line in lines[s0:e]:
        n = len(line.encode("utf-8")) + 1
        if len(picked) >= MAX_LINES or size + n > MAX_BYTES:
            break
        picked.append(line)
        size += n
    res.update({"start": s, "end": s0 + len(picked), "text": "\n".join(picked) + ("\n" if picked else "")})
    if s0 + len(picked) < e:
        res["hint"] = "over %d lines or %dKB; use start=%d to continue" % (MAX_LINES, MAX_BYTES // 1024, s0 + len(picked) + 1)


if start is not None or end is not None:
    segment(start or 1, end or total)
elif total <= SMALL_TEXT_LINES and len(data) <= SMALL_TEXT_BYTES:
    segment(1, total)
else:
    outline = []
    if p.endswith(".py") or lines[0].startswith("#!") and "python" in lines[0]:
        res["format"] = "python"
        try:
            tree = ast.parse(text)
            for node in tree.body:
                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                    outline.append({"line": node.lineno, "end": node.end_lineno, "name": node.name,
                                    "kind": "class" if isinstance(node, ast.ClassDef) else "def"})
                    if isinstance(node, ast.ClassDef):
                        outline += [{"line": m.lineno, "end": m.end_lineno, "name": node.name + "." + m.name, "kind": "def"}
                                    for m in node.body if isinstance(m, (ast.FunctionDef, ast.AsyncFunctionDef))]
        except SyntaxError as e:
            res["syntax_error"] = "line %s: %s" % (e.lineno, e.msg)
    elif p.endswith(".md"):
        res["format"] = "markdown"
        fence = False
        for i, line in enumerate(lines, 1):
            if line.startswith("```"):
                fence = not fence
            m = None if fence else re.match(r"(#{1,6}) (.*)", line)
            if m:
                outline.append({"line": i, "level": len(m.group(1)), "name": m.group(2).strip()})
    if outline:
        res["outline"] = outline
    else:
        res["head"] = "\n".join(lines[:40]) + "\n"
    res["hint"] = "use start/end (line numbers) to view the part you need"
out(res)
