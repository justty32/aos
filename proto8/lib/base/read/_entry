#!/usr/bin/env python3
# read - 讀工作區裡一個文字檔，太長從頭截、告訴你從第幾行接著讀
# 介面（lib/README 的契約）：stdin 收 {"path", "offset"?, "max_lines"?}；stdout 印內容（不加行號）；
# 路徑從 $AOS_WS 算、解開 .. 與捷徑後不能跑出去；錯：stderr 與 stdout 各一行「read: error: 代號 原因」、退 1。
# 來源：demo/pi-tools/read（10-24，照 pi 的 read：2000 行或 50KB 先到先算）。
import json, os, shutil, sys
HELP = """\
usage: read < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Read a text file in the workspace (at most 2000 lines or 50KB per call; the end
of the output says which offset to continue from).
Arguments: one JSON object on stdin (empty stdin = {}):
  path       string, required
  offset     integer
  max_lines  integer
Result on stdout. On error: one line "read: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "read"
tool_io.start(NAME, HELP)
MAX_LINES, MAX_BYTES = 2000, 50 * 1024


die = tool_io.die
workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(root, rel):
    """工作區裡的真實路徑；解開 .. 與捷徑後跑出去＝PathBad。"""
    p = os.path.realpath(os.path.join(root, rel))
    if os.path.commonpath([root, p]) != root:
        die("PathBad", "%s is outside the workspace" % rel)
    return p


root = workspace()
args = arguments()
if not isinstance(args.get("path"), str) or not args["path"]:
    die("ArgumentsBad", "missing path (a string)")
offset, max_lines = args.get("offset"), args.get("max_lines")   # 上限一律 max_*（10-25 前叫 limit）
for k, v in (("offset", offset), ("max_lines", max_lines)):
    if v is not None and (type(v) is not int or v < 1):
        die("ArgumentsBad", "%s must be a positive integer" % k)

path = inside(root, args["path"])
if not os.path.exists(path):
    die("FileMissing", args["path"])
if os.path.isdir(path):
    die("FileBad", "%s is a directory; use ls for directories" % args["path"])
try:
    with open(path, "rb") as f:
        data = f.read()
except OSError as e:
    die("ReadFailed", "%s: %s" % (args["path"], e.strerror))
if b"\0" in data[:8192]:
    die("FileBad", "%s looks like a binary file; not reading it" % args["path"])
text = data.decode("utf-8", "replace")

lines = text.split("\n")
if text.endswith("\n"):
    lines.pop()                                 # 檔尾換行不算一行
total = len(lines)
if total == 0:
    print("(empty file)")
    sys.exit(0)
start = (offset or 1) - 1
if start >= total:
    die("ArgumentsBad", "offset %d is past the end of the file (%d lines)" % (offset, total))
end = total if max_lines is None else min(start + max_lines, total)
out, size = [], 0
for line in lines[start:end]:
    n = len(line.encode("utf-8")) + 1
    if len(out) >= MAX_LINES or size + n > MAX_BYTES:
        break
    out.append(line)
    size += n
first = start + 1
if not out:                                     # 第一行就超過 50KB
    die("FileBad", "line %d is over %dKB; use bash: sed -n '%dp' %s | head -c %d"
        % (first, MAX_BYTES // 1024, first, args["path"], MAX_BYTES))
print("\n".join(out))
shown_end = start + len(out)
if shown_end < end:                             # 被 2000 行／50KB 截掉
    print("\n[lines %d-%d of %d. Use offset=%d to continue.]" % (first, shown_end, total, shown_end + 1))
elif end < total:                               # max_lines 停在檔尾之前
    print("\n[%d more lines in the file. Use offset=%d to continue.]" % (total - end, end + 1))
