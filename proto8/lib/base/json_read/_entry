#!/usr/bin/env python3
# json_read - 看工作區裡一份 JSON 檔的某個位置，一次只展開幾層、大的摺起來，讓腦一層層往下找
# 介面（lib/README 的契約）：stdin 收 {"path", "pointer"?: "", "depth"?: 1}；stdout 一份 JSON {"path", "pointer", "value"}：
# value 超過 depth 層的物件摺成 {"type": "object", "keys": [最多 20 個], "counter_keys_more"?: 沒列的個數}、陣列摺成 {"type": "array", "counter_items": N}、
# 長字串摺成 {"type": "string", "counter_chars": N, "head": 前 100 字}（計數 10-25 改 counter_*，原 len、keys_more）；其餘照原樣。pointer 照 RFC 6901（整份是空字串）。
# 錯：stderr 與 stdout 各一行「json_read: error: 代號 原因」、退 1。（impls/aos-json 的 peek 是同一件事的 C++ 版，做好後可換）
import json, os, sys
HELP = """\
usage: json_read < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Look at one place in a JSON file in the workspace, unfolding only depth levels
(bigger values are folded into summaries). Prints {"path", "pointer", "value"}.
Result on stdout. On error: one line "json_read: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "json_read"
tool_io.start(NAME, HELP)
DEPTH_MAX, KEYS_MAX, STR_MAX, HEAD = 10, 20, 500, 100
SIZE_MAX = 4 * 1024 * 1024


die = tool_io.die
workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(root, rel):
    p = os.path.realpath(os.path.join(root, rel))
    if os.path.commonpath([root, p]) != root:
        die("PathBad", "%s is outside the workspace" % rel)
    return p


def walk(doc, pointer):
    """照 RFC 6901 走到 pointer 指的值；格式錯＝PointerBad、指不到＝PointerMissing。"""
    if pointer == "":
        return doc
    if not pointer.startswith("/"):
        die("PointerBad", "pointer must start with / (empty string = whole document): %s" % pointer)
    here = doc
    for raw in pointer[1:].split("/"):
        key = raw.replace("~1", "/").replace("~0", "~")
        if isinstance(here, dict):
            if key not in here:
                die("PointerMissing", "%s: no key %s" % (pointer, key))
            here = here[key]
        elif isinstance(here, list):
            if not key.isdigit() or int(key) >= len(here):
                die("PointerMissing", "%s: array has no item %s (%d items)" % (pointer, key, len(here)))
            here = here[int(key)]
        else:
            die("PointerMissing", "%s: %s is neither an object nor an array" % (pointer, key))
    return here


def fold(v, depth):
    if isinstance(v, dict):
        if depth <= 0:
            keys = list(v)
            res = {"type": "object", "keys": keys[:KEYS_MAX]}
            if len(keys) > KEYS_MAX:
                res["counter_keys_more"] = len(keys) - KEYS_MAX
            return res
        return {k: fold(x, depth - 1) for k, x in v.items()}
    if isinstance(v, list):
        if depth <= 0:
            return {"type": "array", "counter_items": len(v)}
        return [fold(x, depth - 1) for x in v]
    if isinstance(v, str) and len(v) > STR_MAX:
        return {"type": "string", "counter_chars": len(v), "head": v[:HEAD]}
    return v


root = workspace()
args = arguments("path")
pointer, depth = args.get("pointer", ""), args.get("depth", 1)
if not isinstance(pointer, str):
    die("ArgumentsBad", "pointer must be a string")
if type(depth) is not int or not 1 <= depth <= DEPTH_MAX:
    die("ArgumentsBad", "depth must be an integer from 1 to %d" % DEPTH_MAX)

path = inside(root, args["path"])
if not os.path.exists(path):
    die("FileMissing", args["path"])
if os.path.isdir(path):
    die("FileBad", "%s is a directory" % args["path"])
if os.path.getsize(path) > SIZE_MAX:
    die("FileBad", "%s is over %dMB" % (args["path"], SIZE_MAX // (1024 * 1024)))
try:
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
except OSError as e:
    die("ReadFailed", "%s: %s" % (args["path"], e.strerror))
except (ValueError, UnicodeDecodeError) as e:
    die("FileBad", "%s is not JSON: %s" % (args["path"], e))
value = walk(doc, pointer)
print(json.dumps({"path": args["path"], "pointer": pointer, "value": fold(value, depth)}, ensure_ascii=False))
