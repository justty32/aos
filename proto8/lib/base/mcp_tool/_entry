#!/usr/bin/env python3
# mcp_tool - 叫外部 MCP server 的一支工具：讀包檔（server 檔）裡的 mcp_server，起 server、tools/call 一次、顯示限量文字並保存媒體、收掉 server
# 介面（external-mcp 07 步 2）：mcp_tool --pack FILE --tool NAME；stdin＝那支外部工具的 arguments 原樣（一個 JSON 物件，空＝{}；不照 _tooldef 驗）。
#   包檔是 aos-mcp-import 寫的（或手寫）：mcp_server（怎麼連，mcp_server_file.load 驗）、mcp_tools（鍵＝外部原名，每格 _entry／_tooldef／_metainfo）、tools（登記）。
#   aos-exec 跑包檔裡那格的 _entry 時 cwd＝包檔的資料夾，所以 --pack 只寫檔名；server 的 cwd＝server 檔（包檔）的資料夾，command 與 args 的相對路徑都從那裡算（11-12 Q2 代定 G13，mcp_server_file.stdio_launch 決定）。
#   逾時＝那格 _metainfo.timeout_ms（0＝不限；沒寫或不是非負數＝60 秒，壞值另印一行提醒）。
# 輸出：文字／資源依序印，image／audio 解碼存 $AOS_STACK、提示行的路徑走 tool_io.place（經 aos-tools 叫＝從叫方的 stack 算，AOS_STACK_IN_CALLER）；最多前 2000 行或 50KB，未知種類保留 placeholder。
# 錯：stderr 與 stdout 各一行「mcp_tool: error: 代號 原因」、退 1：ArgumentsBad、FlagUnknown、PackMissing、PackBad、PathMissing、DotenvBad、
#   ToolUnknown（包檔的 mcp_tools 沒有 NAME）、CommandMissing（server 起不來）、ServerFailed、ServerBad、CommandFailed（逾時）、
#   CallFailed（server 回 isError：內容照印，最後一行是錯誤行）；mcp_server_file／mcp_client 丟的代號照轉。
import base64, binascii, json, mimetypes, os, signal, sys, tempfile
HELP = """\
usage: mcp_tool --pack FILE --tool NAME < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Call one tool on an external MCP server once. FILE is the pack (server file) with
mcp_server (how to start the server) and mcp_tools (the frozen tools; NAME is a key there).
A relative FILE is from the current folder (aos-exec runs a pack entry from the pack's folder).
A stdio server starts in FILE's folder: relative paths in its command and args are from there.
stdin is the external tool's arguments as one JSON object, passed as is (empty = {});
--pack and --tool are flags only, not keys on stdin. Timeout: the tool's _metainfo.timeout_ms (default 60000; 0 = no limit; invalid values = a warning and the default).
Result on stdout: text/resources in order; image/audio saved in $AOS_STACK (created only on write),
shown as [image saved: PATH (MIME, N bytes)]. Run through aos-tools, PATH is written from the caller's
stack: $AOS_STACK/tools/NAME/FILE (this tool's own $AOS_STACK is that tools/NAME/ folder; aos-tools
says so in AOS_STACK_IN_CALLER). Run directly, PATH is $AOS_STACK/FILE.
Only the first 2000 lines or 50KB are shown, followed by a truncation note.
Unknown content types print [TYPE content not shown]. TERM/INT close the server before exit (128 + signal).
If the server reports isError, the content is printed and then the error line (CallFailed), exit 1.
On error: one line "mcp_tool: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "mcp_tool"
tool_io.start(NAME, HELP)
import mcp_client, mcp_server_file  # noqa: E402

die = tool_io.die
DEFAULT_TIMEOUT_MS = 60000


def flags():
    """--pack FILE --tool NAME，兩個都要；其他旗標＝FlagUnknown、位置參數＝ArgumentsBad。"""
    def kind(flag):
        return "value" if flag in ("--pack", "--tool") else None
    try:
        pairs, rest = tool_io.tokenize_flags(sys.argv[1:], kind)
    except tool_io.Error as e:
        die(e.code, "%s (see %s --help)" % (e, NAME))
    if rest:
        die("ArgumentsBad", "unexpected argument %r (see %s --help)" % (rest[0], NAME))
    got = dict(pairs)
    for flag in ("--pack", "--tool"):
        if not got.get(flag):
            die("ArgumentsBad", "missing %s (see %s --help)" % (flag, NAME))
    return got["--pack"], got["--tool"]


def stdin_arguments():
    """stdin 原樣當 arguments：空或終端＝{}；不是 JSON 物件＝ArgumentsBad。"""
    raw = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        a = json.loads(raw)
    except ValueError:
        die("ArgumentsBad", "stdin is not JSON")
    if not isinstance(a, dict):
        die("ArgumentsBad", "arguments must be an object")
    return a


def frozen_cell(pack, tool):
    """包檔裡 mcp_tools 的那一格；沒有＝ToolUnknown。timeout_ms 為 0＝不限；寫了但不是非負數＝當沒寫（預設 60 秒、提醒一行）。回 (格, 逾時秒)。"""
    try:
        with open(pack, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError) as e:                 # load 剛讀過；這裡壞＝檔在兩次讀之間變了
        raise tool_io.Error("PackBad", "%s: %s" % (pack, tool_io.os_reason(e))) from None
    tools = doc.get("mcp_tools")
    if not isinstance(tools, dict) or not isinstance(tools.get(tool), dict):
        raise tool_io.Error("ToolUnknown", "%s has no mcp_tools entry %s" % (pack, json.dumps(tool, ensure_ascii=False)))
    meta = tools[tool].get("_metainfo")
    ms = meta.get("timeout_ms", DEFAULT_TIMEOUT_MS) if isinstance(meta, dict) else DEFAULT_TIMEOUT_MS
    if isinstance(ms, bool) or not isinstance(ms, (int, float)) or not 0 <= ms < float("inf"):
        tool_io.warn("tool %s: timeout_ms in %s is not a finite non-negative number, skipped; using %d ms" % (tool, pack, DEFAULT_TIMEOUT_MS))
        ms = DEFAULT_TIMEOUT_MS
    return tools[tool], None if ms == 0 else ms / 1000.0


def saved_media(content):
    """驗媒體後寫自己的小格；唯一檔名讓平行呼叫互不覆蓋。"""
    kind, mime, encoded = content["type"], content.get("mimeType"), content.get("data")
    if not isinstance(mime, str) or not mime or not isinstance(encoded, str):
        raise tool_io.Error("ServerBad", "MCP %s content has invalid data or mimeType" % kind)
    try:
        data = base64.b64decode(encoded, validate=True)
    except (ValueError, binascii.Error):
        raise tool_io.Error("ServerBad", "MCP %s content data is not valid base64" % kind) from None
    stack = os.environ.get("AOS_STACK")
    if not stack:
        raise tool_io.Error("StackMissing", "AOS_STACK is not set")
    try:
        os.makedirs(stack, exist_ok=True)
        fd, path = tempfile.mkstemp(prefix=kind + "-", suffix=mimetypes.guess_extension(mime) or ".bin", dir=stack)
        with os.fdopen(fd, "wb") as f:
            f.write(data)
    except OSError as e:
        raise tool_io.Error("WriteFailed", "cannot save MCP %s in %s: %s" %
                            (kind, tool_io.place(stack), tool_io.os_reason(e))) from None
    return "[%s saved: %s (%s, %d bytes)]" % (kind, tool_io.place(path), mime, len(data))


def limited_text(text):
    """從頭取完整行；首行太長時保留 UTF-8 完整前綴，尾句明列省略 bytes。"""
    max_lines, max_bytes = 2000, 50 * 1024
    split = text.split("\n")
    lines = [line + "\n" for line in split[:-1]]
    if split[-1]:
        lines.append(split[-1])
    picked, size = [], 0
    for line in lines[:max_lines]:
        width = len(line.encode("utf-8"))
        if size + width > max_bytes:
            if not picked:
                picked.append(line.encode("utf-8")[:max_bytes].decode("utf-8", "ignore"))
            break
        picked.append(line)
        size += width
    shown = "".join(picked)
    omitted = len(text.encode("utf-8")) - len(shown.encode("utf-8"))
    if omitted:
        shown += ("\n" if shown.endswith("\n") else "\n\n") + "[lines 1-%d of %d; omitted %d bytes (limit 2000 lines or 50KB).]\n" % (
            len(picked), len(lines), omitted)
    return shown


def show(result):
    """依序顯示 content；沒有 content 才退回單行 structuredContent JSON。"""
    content = result.get("content", [])
    if not isinstance(content, list) or not all(isinstance(c, dict) for c in content):
        raise tool_io.Error("ServerBad", "MCP tools/call result content must be an array of objects")
    parts = []
    for c in content:
        kind = c.get("type")
        if kind == "text" and isinstance(c.get("text"), str):
            parts.append(c["text"])
        elif kind in ("image", "audio"):
            parts.append(saved_media(c))
        elif kind == "resource_link" and isinstance(c.get("uri"), str):
            parts.append(c["uri"])
        elif (kind == "resource" and isinstance(c.get("resource"), dict) and
              isinstance(c["resource"].get("text"), str)):
            parts.append(c["resource"]["text"])
        else:
            parts.append("[%s content not shown]" % c.get("type", "unknown"))
    if not content and "structuredContent" in result:
        parts.append(json.dumps(result["structuredContent"], ensure_ascii=False, separators=(",", ":")))
    if parts:
        text = "\n".join(parts)
        shown = limited_text(text)
        sys.stdout.write(shown if shown.endswith("\n") else shown + "\n")
        sys.stdout.flush()
    return result.get("isError") is True


class Interrupted(BaseException):
    pass


_pending_signal = None


def interrupted(signum, frame):
    """第一次打斷工作；清理中只記訊號，避免 close 已標 closed 後被打斷。"""
    global _pending_signal
    if _pending_signal is not None:
        return
    _pending_signal = signum
    # 已在處理例外時讓那條路徑完成清理；open_session 自己也會收初始化失敗的 session。
    if sys.exc_info()[0] is None:
        raise Interrupted()


def record_signal(signum, frame):
    global _pending_signal
    if _pending_signal is None:
        _pending_signal = signum


signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGINT, interrupted)
try:
    pack, tool = flags()
    arguments = stdin_arguments()
    mcp_server_file.load(pack)
    _cell, timeout_s = frozen_cell(pack, tool)
    session = None
    try:
        session = mcp_client.open_session(pack)
        if _pending_signal is not None:
            raise Interrupted()
        result = session.call_tool(tool, arguments, timeout_s)
    finally:
        signal.signal(signal.SIGTERM, record_signal)
        signal.signal(signal.SIGINT, record_signal)
        if session is not None:
            session.close()
    if _pending_signal is None:
        failed = show(result)
        if failed:
            die("CallFailed", "the server reported an error")
except Interrupted:
    pass
except tool_io.Error as e:
    if _pending_signal is None:
        die(e.code, str(e))
finally:
    if _pending_signal is not None:
        sys.exit(128 + _pending_signal)
