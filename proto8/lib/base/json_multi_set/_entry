#!/usr/bin/env python3
# json_multi_set - 一次改多格：逐格照 json_set 做（照順序、不回滾），一格一行「路徑 TAB 結果」；有格失敗＝最後一行 PlacesFailed、退 1
# 殼：邏輯全在 lib/aos_json.py（json 工具一族，thinking 2026-11/12/json-tools）；介面看 _tooldef.json。
import os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import aos_json  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name not in ("aos_json", "tool_io"):
        raise
    _line = "%s: error: ModuleMissing %s.py not in the tool folder, not in lib/, not on the Python path\n" % (os.path.basename(HERE), error.name)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

aos_json.main("multi_set")
