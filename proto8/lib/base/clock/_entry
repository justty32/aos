#!/usr/bin/env python3
# clock - 在 stdout 印現在的 UTC 時間（ISO 8601 到秒，例：2026-10-23T08:00:00Z）
# 介面（lib/README 的契約）：stdin 收 {}（沒有參數；空 stdin 也算）；不碰檔案、不用 $AOS_WS。
# 錯：stdin 不是 JSON 物件＝stderr 與 stdout 各一行「clock: error: ArgumentsBad 原因」、退 1。
# 來源：demo/agent-dan/tools/clock（10-23，原本是一行 sh `date -u`、不讀 stdin；10-24 遷移改 python3 才能照契約檢查 stdin，印的一樣）。
import os, shutil, sys, time
HELP = """\
usage: clock < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Print the current UTC time (ISO 8601 to the second, e.g. 2026-10-23T08:00:00Z).
Result on stdout. On error: one line "clock: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "clock"
tool_io.start(NAME, HELP)


die = tool_io.die


args = tool_io.arguments()
print(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
