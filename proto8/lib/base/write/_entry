#!/usr/bin/env python3
# write - 把整份內容寫進工作區裡一個檔：沒有就建、有就整份蓋掉，上層資料夾自動建
# 介面（lib/README 的契約）：stdin 收 {"path", "content"}；stdout 一行說寫了幾 bytes；
# 路徑從 $AOS_WS 算、不能跑出去；先寫 . 開頭的暫存檔再改名（N-05）、蓋舊檔時留住它的權限；
# 錯：stderr 與 stdout 各一行「write: 代號 原因」、退 1。來源：demo/pi-tools/write（10-24）。
import json, os, sys

NAME = "write"


def die(code, reason):
    line = "%s: %s %s" % (NAME, code, reason)
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def workspace():
    ws = os.environ.get("AOS_WS")
    if not ws or not os.path.isdir(ws):
        die("WsMissing", "沒設定 AOS_WS 或不是資料夾")
    return os.path.realpath(ws)


def arguments():
    try:
        a = json.loads(sys.stdin.read() or "{}")
    except ValueError as e:
        die("ArgumentsBad", "stdin 不是 JSON：%s" % e)
    if not isinstance(a, dict):
        die("ArgumentsBad", "arguments 要是物件")
    return a


def inside(root, rel):
    p = os.path.realpath(os.path.join(root, rel))
    if os.path.commonpath([root, p]) != root or p == root:
        die("PathBad", "%s 在工作區外面、或就是工作區本身" % rel)
    return p


root = workspace()
args = arguments()
if not isinstance(args.get("path"), str) or not args["path"]:
    die("ArgumentsBad", "缺 path（要一個字串）")
if not isinstance(args.get("content"), str):
    die("ArgumentsBad", "缺 content（要一個字串）")

path = inside(root, args["path"])
if os.path.isdir(path):
    die("FileBad", "%s 是資料夾" % args["path"])
try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
except OSError as e:
    die("MkdirFailed", "%s：%s" % (os.path.dirname(args["path"]) or ".", e.strerror))
data = args["content"].encode("utf-8")
tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
try:
    with open(tmp, "wb") as f:
        f.write(data)
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)    # 蓋舊檔時留住它的權限（例如 +x）
    os.replace(tmp, path)
except OSError as e:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    die("WriteFailed", "%s：%s" % (args["path"], e.strerror))
print("已寫入 %s（%d bytes）" % (args["path"], len(data)))
