#!/usr/bin/env python3
# write - 把整份內容寫進工作區裡一個檔：沒有就建、有就整份蓋掉，上層資料夾自動建
# 介面（lib/README 的契約）：stdin 收 {"path", "content"}；stdout 一行說寫了幾 bytes；
# 路徑從 $AOS_WS 算、不能跑出去；先寫 . 開頭的暫存檔再改名（N-05）、蓋舊檔時留住它的權限；
# 錯：stderr 與 stdout 各一行「write: error: 代號 原因」、退 1。來源：demo/pi-tools/write（10-24）。
import json, os, sys
HELP = """\
usage: write < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Write the whole content into a file in the workspace (created or replaced; parent
folders are created).
Result on stdout. On error: one line "write: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "write"
tool_io.start(NAME, HELP)


die = tool_io.die
workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(root, rel):
    p = os.path.realpath(os.path.join(root, rel))
    if os.path.commonpath([root, p]) != root or p == root:
        die("PathBad", "%s is outside the workspace or is the workspace itself" % rel)
    return p


root = workspace()
args = arguments("path")

path = inside(root, args["path"])
if os.path.isdir(path):
    die("FileBad", "%s is a directory" % args["path"])
try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
except OSError as e:
    die("MkdirFailed", "%s: %s" % (os.path.dirname(args["path"]) or ".", e.strerror))
data = args["content"].encode("utf-8")
tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
try:
    with open(tmp, "wb") as f:
        f.write(data)
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)    # 蓋舊檔時留住它的權限（例如 +x）
    os.replace(tmp, path)
except OSError as e:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    die("WriteFailed", "%s: %s" % (args["path"], e.strerror))
print("Wrote %s (%d bytes)" % (args["path"], len(data)))
