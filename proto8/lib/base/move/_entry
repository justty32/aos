#!/usr/bin/env python3
# move - 搬移或改名一個檔、資料夾或捷徑本身（to 的上層自動建）
# 介面（lib/README 的契約）：stdin 收 {"from", "to"}；stdout 一份 JSON {"from", "to"}。
# to 已經有東西＝不搬（FileBad），要蓋先 trash；to 不能在 from 裡面。從垃圾桶救回來也用它。跨檔案系統照 mv 用複製再刪。路徑：相對從 $AOS_WS 算、絕對照用（11-10 tool-packs 不限工作區）。
# 錯：stderr 與 stdout 各一行「move: error: 代號 原因」、退 1。來源：demo/file-tools/move（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, shutil, sys
HELP = """\
usage: move < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Move or rename a file, folder or symlink (relative paths start at $AOS_WS; parents
of to are created; to must not exist).
Result on stdout. On error: one line "move: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "move"
tool_io.start(NAME, HELP)


die = tool_io.die


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


arguments = tool_io.arguments


def target(rel):
    """路徑參數 → (絕對路徑, 給腦看的路徑)；最後一節是捷徑時不解開它（搬、複製、丟的是捷徑本身，同 mv／cp -P）。"""
    p = tool_io.ws_path(rel).rstrip(os.sep) or os.sep
    return p, tool_io.shown_path(p)


a = arguments("from", "to")
src, s_rel = target(a["from"])
dst, d_rel = target(a["to"])
if not os.path.lexists(src):
    die("FileMissing", a["from"])
if os.path.lexists(dst):
    die("FileBad", "%s already exists; trash it first to replace it" % a["to"])
if dst == src or os.path.realpath(dst).startswith(os.path.realpath(src) + os.sep):
    die("PathBad", "%s is inside %s" % (a["to"], a["from"]))
try:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.move(src, dst)                       # 同一個檔案系統＝rename；跨的＝複製再刪（同 mv）
except (OSError, shutil.Error) as e:
    die("MoveFailed", "%s → %s: %s" % (a["from"], a["to"], getattr(e, "strerror", None) or e))
out({"from": s_rel, "to": d_rel})
