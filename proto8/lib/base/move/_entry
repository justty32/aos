#!/usr/bin/env python3
# move - 在工作區裡搬移或改名一個檔、資料夾或捷徑本身（to 的上層自動建）
# 介面（lib/README 的契約）：stdin 收 {"from", "to"}；stdout 一份 JSON {"from", "to"}。
# to 已經有東西＝不搬（FileBad），要蓋先 trash；to 不能在 from 裡面。從垃圾桶救回來也用它。路徑從 $AOS_WS 算、不能跑出去。
# 錯：stderr 與 stdout 各一行「move: error: 代號 原因」、退 1。來源：demo/file-tools/move（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, shutil, sys
HELP = """\
usage: move < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Move or rename a file, folder or symlink inside the workspace (parents of to are
created; to must not exist).
Result on stdout. On error: one line "move: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "move"
tool_io.start(NAME, HELP)


die = tool_io.die


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(rel, root_ok=True):
    """工作區裡的真實路徑；解開 .. 與捷徑後跑出去＝PathBad。回 (絕對路徑, 給人看的相對路徑)。"""
    p = os.path.realpath(os.path.join(ROOT, rel))
    if os.path.commonpath([ROOT, p]) != ROOT or (p == ROOT and not root_ok):
        die("PathBad", "%s is outside the workspace" % rel)
    return p, (os.path.relpath(p, ROOT) if p != ROOT else ".")


def inside_link(rel):
    """同 inside，但最後一節是捷徑時不解開它（搬、複製、丟的是捷徑本身）。"""
    head, tail = os.path.split(os.path.normpath(rel))
    parent, _ = inside(head or ".")
    p = os.path.join(parent, tail)
    if tail in ("", ".", "..") or p == ROOT:
        die("PathBad", "%s cannot be the workspace itself" % rel)
    return p, os.path.relpath(p, ROOT)


ROOT = workspace()
a = arguments("from", "to")
src, s_rel = inside_link(a["from"])
dst, d_rel = inside_link(a["to"])
if not os.path.lexists(src):
    die("FileMissing", a["from"])
if os.path.lexists(dst):
    die("FileBad", "%s already exists; trash it first to replace it" % a["to"])
if dst == src or dst.startswith(src + os.sep):
    die("PathBad", "%s is inside %s" % (a["to"], a["from"]))
try:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    os.rename(src, dst)
except OSError as e:
    die("MoveFailed", "%s → %s: %s" % (a["from"], a["to"], e.strerror))
out({"from": s_rel, "to": d_rel})
