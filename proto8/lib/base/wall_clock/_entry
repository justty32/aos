#!/usr/bin/env python3
# wall_clock - 在 stdout 印現在的 UTC 時間（ISO 8601 到秒，例：2026-10-23T08:00:00Z）
# 介面（lib/README 的契約）：stdin 收 {}（沒有參數；空 stdin 也算）；不碰檔案、不用 $AOS_WS。
# 錯：stdin 不是 JSON 物件＝stderr 與 stdout 各一行「wall_clock: error: ArgumentsBad 原因」、退 1。
# 來源：demo/agent-dan/tools/clock（10-23，原本是一行 sh `date -u`、不讀 stdin；10-24 遷移改 python3 才能照契約檢查 stdin，印的一樣）。
import os, sys, time
HELP = """\
usage: wall_clock < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Print the current UTC time (ISO 8601 to the second, e.g. 2026-10-23T08:00:00Z).
Result on stdout. On error: one line "wall_clock: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "wall_clock"
tool_io.start(NAME, HELP)


die = tool_io.die


args = tool_io.arguments()
print(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
