#!/usr/bin/env python3
# mkdir - 在工作區裡建資料夾（上層一起建；已經有＝沒事）
# 介面（lib/README 的契約）：stdin 收 {"path"}；stdout 一份 JSON {"path", "created"}。路徑從 $AOS_WS 算、不能跑出去、不能是工作區本身。
# 錯：stderr 與 stdout 各一行「mkdir: error: 代號 原因」、退 1。來源：demo/file-tools/mkdir（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, shutil, sys
HELP = """\
usage: mkdir < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Create a folder in the workspace (parents too; already there is fine).
Arguments: one JSON object on stdin (empty stdin = {}):
  path  string, required
Result on stdout. On error: one line "mkdir: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "mkdir"
tool_io.start(NAME, HELP)


die = tool_io.die


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(rel, root_ok=True):
    """工作區裡的真實路徑；解開 .. 與捷徑後跑出去＝PathBad。回 (絕對路徑, 給人看的相對路徑)。"""
    p = os.path.realpath(os.path.join(ROOT, rel))
    if os.path.commonpath([ROOT, p]) != ROOT or (p == ROOT and not root_ok):
        die("PathBad", "%s is outside the workspace" % rel)
    return p, (os.path.relpath(p, ROOT) if p != ROOT else ".")


ROOT = workspace()
a = arguments("path")
p, shown = inside(a["path"], root_ok=False)
if os.path.isdir(p):
    out({"path": shown, "created": False})
    sys.exit(0)
if os.path.lexists(p):
    die("FileBad", "%s is already a file" % a["path"])
try:
    os.makedirs(p)
except OSError as e:
    die("MkdirFailed", "%s: %s" % (a["path"], e.strerror))
out({"path": shown, "created": True})
