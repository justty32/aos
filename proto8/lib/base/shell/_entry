#!/usr/bin/env python3
# shell - 在工作區裡用 bash 跑一行指令，回 stdout＋stderr 合在一起的輸出
# 介面（lib/README 的契約）：stdin 收 {"command", "timeout_s"?}；stdout 印輸出（太長留最後 2000 行或 50KB）；
# 指令退非 0 不算這個工具的錯（最後一行一律寫 [exit code N]，退 0 也寫、被訊號殺＝128＋N；腦自己看）；逾時（預設 30 秒、上限 300）＝整群先 TERM、2 秒後 KILL、算錯。
# 這個工具被外面 TERM 時也先停掉指令那一群再走。cwd 是工作區；指令碰得到這台機器上這個使用者碰得到的一切（不是沙盒）。
# 錯：stderr 與 stdout 各一行「shell: error: 代號 原因」、退 1。來源：demo/pi-tools/bash（10-24；參數 timeout 改名 timeout_s，C-54 單位放字尾；11-10 tool-packs 由 bash 改名 shell）。
import os, signal, subprocess, sys, tempfile, time
HELP = """\
usage: shell < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Run one bash command in the workspace ($AOS_WS); print its stdout+stderr combined
(last 2000 lines or 50KB). The last line is always [exit code N]; the command exiting
non-zero is a result, not an error of this tool. Over timeout_s the whole process group
is stopped (CommandFailed).
Result on stdout. On error: one line "shell: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

import shell_observed

NAME = "shell"
tool_io.start(NAME, HELP)
MAX_LINES, MAX_BYTES = 2000, 50 * 1024
TIMEOUT_DEFAULT, TIMEOUT_MAX = 30, 300      # 秒
GRACE = 2                                   # TERM 之後等幾秒才 KILL


die = tool_io.die
workspace = tool_io.workspace
arguments = tool_io.arguments


root = workspace()
args = arguments()
if not isinstance(args.get("command"), str) or not args["command"].strip():
    die("ArgumentsBad", "missing command (a string)")
timeout = args.get("timeout_s", TIMEOUT_DEFAULT)
if type(timeout) not in (int, float) or not 0 < timeout <= TIMEOUT_MAX:
    die("ArgumentsBad", "timeout_s must be seconds between 0 and %d" % TIMEOUT_MAX)


def tail(f):
    """從暫存檔讀出最後 2000 行／50KB；回 (文字, 截掉的說明或 None)。"""
    size = f.seek(0, os.SEEK_END)
    f.seek(max(0, size - MAX_BYTES))
    data = f.read()
    cut = size > MAX_BYTES
    text = data.decode("utf-8", "replace")
    if cut and "\n" in text:
        text = text[text.index("\n") + 1:]      # 去掉被切一半的那行
    lines = text.split("\n")
    if text.endswith("\n"):
        lines.pop()
    if len(lines) > MAX_LINES:
        lines = lines[-MAX_LINES:]
        cut = True
    note = "[output too long; kept the last %d lines (limit %d lines or %dKB)]" % (len(lines), MAX_LINES, MAX_BYTES // 1024) if cut else None
    return "\n".join(lines), note


def stop(p):
    # 跟 lib/process_group.stop 同一件事，但先不改用：cmd/aos-sandbox/examples/shell-boxed 只唯讀掛 tool_io、shell_observed、observed 三支（11-12 線 F）
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, None)):
        try:
            os.killpg(p.pid, sig)
        except ProcessLookupError:
            return
        try:
            p.wait(wait)
            return
        except subprocess.TimeoutExpired:
            pass


ledger = shell_observed.prepare()
with tempfile.TemporaryFile() as out:
    started = time.monotonic()
    try:
        p = subprocess.Popen(["bash", "-c", args["command"]], cwd=root, stdin=subprocess.DEVNULL, stdout=out,
                             stderr=subprocess.STDOUT, start_new_session=True)   # 自己一群：逾時整群停
    except OSError as e:
        die("LaunchFailed", "bash failed to start: %s" % e.strerror)

    class Interrupted(BaseException):
        def __init__(self, signum):
            self.signum = signum

    def on_term(signum, frame):
        raise Interrupted(signum)

    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    interrupted = None
    timed_out = False
    try:
        code = p.wait(timeout)
    except (subprocess.TimeoutExpired, Interrupted) as error:
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        interrupted = error.signum if isinstance(error, Interrupted) else None
        timed_out = interrupted is None
        stop(p)
    shell_observed.finish(ledger, args["command"], timeout, p.returncode,
                          started, out.seek(0, os.SEEK_END))
    if interrupted is not None:
        sys.exit(128 + interrupted)
    text, note = tail(out)

parts = [text] if text else []
if note:
    parts.append(note)
if timed_out:
    die("CommandFailed", "ran over %g s; stopped the whole process group" % timeout, "\n\n".join(parts) + "\n\n" if parts else "")
if not parts:
    parts.append("(no output)")
parts.append("[exit code %d]" % (128 - code if code < 0 else code))   # 一律寫在最後一行（stdio-unify R2）；被訊號殺＝128＋N（R12）
print("\n\n".join(parts))
