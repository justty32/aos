#!/usr/bin/env python3
# copy - 在工作區裡複製一個檔或整個資料夾（捷徑照捷徑複製、不跟進去；to 的上層自動建）
# 介面（lib/README 的契約）：stdin 收 {"from", "to"}；stdout 一份 JSON {"from", "to", "counter_files"}（複製了幾個檔；10-25 原 files）。
# to 已經有東西＝不複製（FileBad）。先複製到 . 開頭的暫存（檔或資料夾）再改名（N-05）。路徑從 $AOS_WS 算、不能跑出去。
# 錯：stderr 與 stdout 各一行「copy: error: 代號 原因」、退 1。來源：demo/file-tools/copy（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, shutil, sys
HELP = """\
usage: copy < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Copy a file or folder inside the workspace (symlinks are copied as links; parent
folders of to are created). Prints {"from", "to", "counter_files"}.
Arguments: one JSON object on stdin (empty stdin = {}):
  from  string, required
  to    string, required
Result on stdout. On error: one line "copy: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
import tool_io  # noqa: E402

NAME = "copy"
tool_io.start(NAME, HELP)


die = tool_io.die


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


workspace = tool_io.workspace
arguments = tool_io.arguments


def inside(rel, root_ok=True):
    """工作區裡的真實路徑；解開 .. 與捷徑後跑出去＝PathBad。回 (絕對路徑, 給人看的相對路徑)。"""
    p = os.path.realpath(os.path.join(ROOT, rel))
    if os.path.commonpath([ROOT, p]) != ROOT or (p == ROOT and not root_ok):
        die("PathBad", "%s is outside the workspace" % rel)
    return p, (os.path.relpath(p, ROOT) if p != ROOT else ".")


def inside_link(rel):
    """同 inside，但最後一節是捷徑時不解開它（搬、複製、丟的是捷徑本身）。"""
    head, tail = os.path.split(os.path.normpath(rel))
    parent, _ = inside(head or ".")
    p = os.path.join(parent, tail)
    if tail in ("", ".", "..") or p == ROOT:
        die("PathBad", "%s cannot be the workspace itself" % rel)
    return p, os.path.relpath(p, ROOT)


ROOT = workspace()
a = arguments("from", "to")
src, s_rel = inside_link(a["from"])
dst, d_rel = inside_link(a["to"])
if not os.path.lexists(src):
    die("FileMissing", a["from"])
if os.path.lexists(dst):
    die("FileBad", "%s already exists" % a["to"])
if dst.startswith(src + os.sep):
    die("PathBad", "%s is inside %s" % (a["to"], a["from"]))
tmp = os.path.join(os.path.dirname(dst), "." + os.path.basename(dst) + ".tmp")
try:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.isdir(src) and not os.path.islink(src):
        shutil.copytree(src, tmp, symlinks=True)
        files = sum(len(fs) for _, _, fs in os.walk(tmp))
    else:
        shutil.copy2(src, tmp, follow_symlinks=False)
        files = 1
    os.rename(tmp, dst)
except OSError as e:
    if os.path.isdir(tmp) and not os.path.islink(tmp):
        shutil.rmtree(tmp, ignore_errors=True)
    elif os.path.lexists(tmp):
        os.unlink(tmp)
    die("CopyFailed", "%s → %s: %s" % (a["from"], a["to"], e.strerror or e))
out({"from": s_rel, "to": d_rel, "counter_files": files})
