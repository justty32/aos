#!/usr/bin/env python3
# stat - 看單一個檔或資料夾的屬性，回 JSON
# 介面（lib/README 的契約）：stdin 收 {"path"}；stdout 一份 JSON：path、type、mtime、mode、（捷徑）link_to。
# 檔：size、exec、text（是不是 UTF-8 文字）、counter_lines、format（json／python／markdown／shell／text）、JSON 檔的 top（頂層摘要）。
# 資料夾：counter_children、aos（_entry、.env、_tooldef.json… 有哪些）。路徑：相對從 $AOS_WS 算、絕對照用（11-10 tool-packs 不限工作區）。
# 計數的 key 一律 counter_*（10-25，原 lines、children，top 摘要裡的 keys、items、chars）。
# 錯：stderr 與 stdout 各一行「stat: error: 代號 原因」、退 1。來源：demo/file-tools/stat（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, sys
HELP = """\
usage: stat < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Show the attributes of one file or folder (relative paths start at $AOS_WS), as JSON.
Result on stdout. On error: one line "stat: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "stat"
tool_io.start(NAME, HELP)


die = tool_io.die
try:
    from file_summary import aos_marks, iso, json_summary  # noqa: E402
except ModuleNotFoundError as error:
    if error.name != "file_summary":
        raise
    die("ModuleMissing", "file_summary.py not in the tool folder, not in lib/, not on the Python path")


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


arguments = tool_io.arguments


a = arguments("path")
lp = tool_io.ws_path(a["path"]).rstrip(os.sep) or os.sep   # 捷徑本身（同 stat，不跟進去）
p = os.path.realpath(lp)
shown = tool_io.shown_path(lp)
if not os.path.lexists(lp):
    die("FileMissing", a["path"])
res = {"path": shown, "type": "link" if os.path.islink(lp) else ("dir" if os.path.isdir(lp) else "file")}
if res["type"] == "link":
    res["link_to"] = tool_io.shown_path(p)
    if not os.path.exists(p):
        res["broken"] = True
        out(res)
        sys.exit(0)
st = os.stat(p)
res["mtime"] = iso(st.st_mtime)
res["mode"] = "%04o" % (st.st_mode & 0o7777)
if os.path.isdir(p):
    res["counter_children"] = len(os.listdir(p))
    res["aos"] = aos_marks(p)
    out(res)
    sys.exit(0)
res["size"] = st.st_size
res["exec"] = bool(st.st_mode & 0o111)
try:
    with open(p, "rb") as f:
        data = f.read(4 * 1024 * 1024)
except OSError as e:
    die("ReadFailed", "%s: %s" % (a["path"], e.strerror))
try:
    text = data.decode("utf-8")
    res["text"] = b"\0" not in data
except UnicodeDecodeError:
    res["text"] = False
if res["text"]:
    res["counter_lines"] = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
    first = text.split("\n", 1)[0]
    fmt = "text"
    try:
        v = json.loads(text)
        fmt = "json"
        res["top"] = json_summary(v)
    except ValueError:
        if p.endswith(".py") or ("python" in first and first.startswith("#!")):
            fmt = "python"
        elif p.endswith(".md"):
            fmt = "markdown"
        elif first.startswith("#!") or p.endswith(".sh"):
            fmt = "shell"
    res["format"] = fmt
out(res)
