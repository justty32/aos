#!/usr/bin/env python3
# trash - 刪除一個檔或資料夾：不真的刪，搬進 $AOS_WS/.trash/<時間>/<原路徑>（真的刪用 remove）
# 介面（lib/README 的契約）：stdin 收 {"path"}；stdout 一份 JSON {"path", "to"}。要救就用 move 搬回來。
# 垃圾桶裡的東西不再丟（.trash 本身與裡面都不收）；真的要清垃圾桶用 remove。路徑：相對從 $AOS_WS 算、絕對照用（11-10 tool-packs 不限工作區）；
# 工作區外的東西放進 .trash/<時間>/ 底下它的絕對路徑（去掉開頭 /），跨檔案系統照 mv 用複製再刪。
# 錯：stderr 與 stdout 各一行「trash: error: 代號 原因」、退 1。來源：demo/file-tools/trash（10-24；遷移時 common.py 攤回這裡、錯誤行照 lib 契約）。
import json, os, shutil, sys, time
HELP = """\
usage: trash < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Delete a file or folder by moving it into $AOS_WS/.trash/<time>/ (relative paths
start at $AOS_WS; use move to get it back, remove to delete for real).
Result on stdout. On error: one line "trash: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "trash"
tool_io.start(NAME, HELP)


die = tool_io.die


def out(obj):
    print(json.dumps(obj, ensure_ascii=False, separators=(",", ":")))


arguments = tool_io.arguments


TRASH = ".trash"
ROOT = tool_io.workspace()                      # 垃圾桶一律在工作區裡
a = arguments("path")
p = tool_io.ws_path(a["path"]).rstrip(os.sep) or os.sep     # 捷徑本身，不跟進去
shown = tool_io.shown_path(p)
if not os.path.lexists(p):
    die("FileMissing", a["path"])
rel = shown if not os.path.isabs(shown) else shown.lstrip(os.sep)
if shown == "." or not rel:
    die("PathBad", "%s is the workspace itself; cannot move it into its own trash" % a["path"])
if rel.split(os.sep)[0] == TRASH and not os.path.isabs(shown):
    die("PathBad", "%s is already in the trash" % a["path"])
if os.path.realpath(os.path.join(ROOT, TRASH)).startswith(os.path.realpath(p) + os.sep):
    die("PathBad", "%s contains the trash; cannot move it into the trash" % a["path"])
stamp = time.strftime("%Y%m%d-%H%M%S")
n = 0
while True:
    box = os.path.join(ROOT, TRASH, stamp + ("" if n == 0 else "-%d" % n))
    if not os.path.lexists(os.path.join(box, rel)):
        break
    n += 1
to = os.path.join(box, rel)
try:
    os.makedirs(os.path.dirname(to), exist_ok=True)
    shutil.move(p, to)                          # 跨檔案系統＝複製再刪（同 mv）
except (OSError, shutil.Error) as e:
    die("MoveFailed", "%s → trash: %s" % (a["path"], getattr(e, "strerror", None) or e))
out({"path": shown, "to": os.path.relpath(to, ROOT)})
