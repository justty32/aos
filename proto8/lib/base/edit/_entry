#!/usr/bin/env python3
# edit - 在一個檔做一處或幾處「整段原文照字面換掉」，一處不合就整個不改
# 介面（lib/README 的契約）：stdin 收 {"path", "edits": [{"old_text", "new_text"}]}；stdout 一行說換了幾處；
# 規則同 pi：每個 old_text 都拿改之前的原檔比、要剛好出現一次、彼此不重疊、不能空；改完跟原本一樣也算錯；
# 全有或全無；CRLF 的檔照 LF 比、寫回時還原；不做模糊比對。路徑：相對從 $AOS_WS 算、絕對照用（11-10 tool-packs 不限工作區）；
# 錯：stderr 與 stdout 各一行「edit: error: 代號 原因」、退 1。來源：demo/pi-tools/edit（10-24）。
import os, sys
HELP = """\
usage: edit < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Replace exact text in one file (relative paths start at $AOS_WS), at one or more places; every
old_text must appear exactly once, otherwise nothing is changed.
Result on stdout. On error: one line "edit: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "edit"
tool_io.start(NAME, HELP)


die = tool_io.die
arguments = tool_io.arguments


args = arguments("path")
edits = args.get("edits")
if not isinstance(edits, list) or not edits:
    die("ArgumentsBad", "edits must be an array with at least one item")
for i, e in enumerate(edits):
    if not isinstance(e, dict) or not isinstance(e.get("old_text"), str) or not isinstance(e.get("new_text"), str):
        die("ArgumentsBad", "edits[%d] needs two strings: old_text and new_text" % i)
    if not e["old_text"]:
        die("TextBad", "edits[%d].old_text is empty" % i)

name = args["path"]
path = os.path.realpath(tool_io.ws_path(name))   # 改捷徑指的那個檔
if not os.path.isfile(path):
    die("FileMissing", "%s (use write for a new file)" % name)
try:
    with open(path, "rb") as f:
        raw = f.read()
except OSError as e:
    die("ReadFailed", "%s: %s" % (name, e.strerror))
try:
    text = raw.decode("utf-8")
except UnicodeDecodeError:
    die("FileBad", "%s is not a UTF-8 text file" % name)
crlf = "\r\n" in text
base = text.replace("\r\n", "\n")

spans = []                                      # (起點, 終點, 第幾項, new_text)
for i, e in enumerate(edits):
    old = e["old_text"].replace("\r\n", "\n")
    count = base.count(old)
    which = "old_text" if len(edits) == 1 else "edits[%d].old_text" % i
    if count == 0:
        die("TextMissing", "%s not found in %s (must match the file exactly, including whitespace and newlines)" % (which, name))
    if count > 1:
        die("TextBad", "%s occurs in %s %d times; it must occur exactly once - include more surrounding lines to make it unique" % (which, name, count))
    at = base.index(old)
    spans.append((at, at + len(old), i, e["new_text"].replace("\r\n", "\n")))
spans.sort()
for a, b in zip(spans, spans[1:]):
    if a[1] > b[0]:
        die("TextBad", "edits[%d] and edits[%d] overlap; merge them into one" % (a[2], b[2]))

out, pos = [], 0
for start, end, _, new in spans:
    out.append(base[pos:start])
    out.append(new)
    pos = end
out.append(base[pos:])
result = "".join(out)
if result == base:
    die("TextBad", "%s is unchanged after the edits" % name)
if crlf:
    result = result.replace("\n", "\r\n")

tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")   # N-05
try:
    with open(tmp, "wb") as f:
        f.write(result.encode("utf-8"))
    os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    os.replace(tmp, path)
except OSError as e:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    die("WriteFailed", "%s: %s" % (name, e.strerror))
first = base[:spans[0][0]].count("\n") + 1
print("In %s, replaced %d places (first at line %d)" % (name, len(spans), first))
