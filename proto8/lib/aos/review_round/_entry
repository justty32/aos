#!/usr/bin/env python3
# review_round - Measure a case, try cheaper endpoints, and record one review round.
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE.parents[1])]
import tool_io
from round_runner import run

tool_io.start('review_round')
args = tool_io.arguments('case', 'defs', 'ladder')
try:
    print(json.dumps(run(args)))
except tool_io.Error as error:
    tool_io.die(error.code, str(error))
except (OSError, ValueError, KeyError, TypeError) as error:
    tool_io.die('ReviewFailed', str(error))
