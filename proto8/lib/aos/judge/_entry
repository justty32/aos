#!/usr/bin/env python3
# judge - 判官：收 $AOS_STACK/requests/ 的 procs_* 信，照 judge.json 判「掛不掛」；掛＝轉寄進 $AOS_DAEMON 的 ctl 信箱，不掛＝回 applied: false；選填排隊窗 queue.json 先來先掛、keep_ordered 對照代回有序信
# 用法：aos-exec <這個資料夾> <judge.json 的絕對路徑>（每跑一次＝一輪；定義裡寫 {"$env": "AOS_CD", "$path": "judge.json"}，因為 aos-exec 會 cd 進這裡）。
#   模式 1（繼承式）：daemon.json 的 exec 身體＝它，AOS_STACK＝daemon 自己的 stack；模式 2（0 號 proc 式）：daemon 底下一個 loop 型 proc 每次跑它，AOS_STACK＝它的 proc 的 stack。
#   兩種都靠 AOS_DAEMON 找 daemon（11-05 起 daemon 的身體也拿得到）。設計：proto8/thinking/2026-11/05/kernel-daemon/02-兩種模式.md § 1、§ 2；說明 proto8/kernel/docs/02-kernel-modes.md。
# 一輪：aos-post init＋take-all $AOS_STACK/requests（對外收件箱，沒有就建）→ requests/cur/ 照處理順序逐封（含上次認領了沒收完的）：
#   body 有 procs_added（物件）才判，其他 procs_*、不認的 key 原樣轉（C-48）：
#   {"ping": true}（問 daemon 在不在，11-06 no-pid P3）不判、原樣轉寄，daemon 直接回給原寄件人；判官不在＝沒人轉＝呼叫者逾時。
#   - judge.json 的 allowed（名字的陣列；null 或沒寫＝不限）：procs_added 每個名字都要在裡面，不然 NameUnknown；
#   - max_running（非負整數；null 或沒寫＝不限）：$AOS_DAEMON/procs_state.json 裡 phase running 的列＋這一輪已放行的新名字＋這封的新名字（表上已 running 的不算新）超過就 SlotMissing；
#     procs_started、procs_woken（start／wake：讓 stopped／sleeping 的回來跑）的名字也算新名字、照樣判 max_running（allowed 不再判：add 時判過了）
#     （11-05 edge-agent：原本照原樣轉，cap 2 時 sleep 一隻、add 一隻、再 wake＝3 個 running）；
#   - body 不是物件、procs_added 不是物件、procs_started／procs_woken 不是字串陣列＝BodyBad。
#   keep_ordered missing/null/false：有序信以尾名一般轉寄，原 reply_to 保留；true：--ordered 轉寄，
#   有 reply_to 者由 judge_replies 收回信、judge_ordered.json 記新名→原名與原回信箱，每輪先代回再判新信。
#   掛＝body 原樣轉寄；keep_ordered 關時防重看 ctl/new/尾名，開時看對照表的原信名；送不出回 ForwardFailed。
#   不掛＝aos-post done --reply '{"applied": false, "error": {"code", "msg"}}'（沒 reply_to＝只收掉）；回信寄不出去＝stderr 一行、照樣收掉。壞信＝stderr 一行、丟掉。
#     不掛的每封一律 stderr 一行提醒「judge: warning: letter <名> refused: 代號 原因」（11-05 edge-agent；stdio-unify R1 起是提醒行：拒信是判官的答案、不是它的錯）；
#     回信的 code、msg 與這行的代號、原因同一句（英文）。回信寄不出去、壞信也是提醒行。
#     aos-agent ctl（11-05 edge-agent 題 2；11-07 起 aos-daemon-ctl 一律直寄 daemon、不寄判官）帶 reply_to：aos-agent ctl 收這封 applied: false 立刻報錯，不等逾時。
#   只判斷＋轉寄，不自己跑任何東西。一輪做完退 0（沒信也是 0：身體退 10 會讓 loop／daemon 收工）。
# 選填 queue: true：滿格信留 requests/cur/、queue.json 的 queued 陣列先來先掛；既有隊序優先，新信照 aos-post 處理順序（有序先、再名字）。
#   queue.json 讀不懂＝提醒行、當空窗，隊序從 requests/cur/ 重排（11-07 sol 審查 #2、#5）。
#   隊首所需新格不足時後方要新格者不能插隊；stop／ping 等不加新格的信照轉。窗 names 是新名字陣列、queued_at／expires_at 是 ISO UTC 毫秒。
#   queued_at_ticks 透過 tool_io.now_tick 讀，有 AOS_TICK 才加。只有進隊時讀；每輪重用原時間。預設 queue: false＝滿格立即拒信。
#   每輪所有 cur（含首次、關排隊）先驗 queue_wait_ms：非負整數；正數由 sent_at 起算、到期不轉；0 有格照轉、沒格不排。
#   壞 sent_at＝BodyBad；到期＝SlotMissing。極大期限用 ISO 擴展年份表示。排隊不寄中間回信，轉寄保留原 body。
# ctl 信箱＝$AOS_DAEMON/<procs_state.json 頂層的 procs_ctl_mailbox>；procs_state.json 還沒寫（daemon 第一圈）＝預設 procs_ctl_mailbox、running 0 列（同 aos-daemon-ctl）。
#   procs_state.json 經 aos-directive 解（procs 超過 100 列會切檔）。在飛的（轉了、daemon 還沒套）不算 running：模式 2 判得比 daemon 快時可能多放幾個（已知限制）。
# 錯（自己這層的，退 1；一般 loop 會停，daemon 的身體則記一行提醒、下一圈再跑，11-05 起；P-20）：ArgumentsBad、CfgMissing、CfgBad（judge.json）、StackMissing、DaemonMissing（沒設 AOS_DAEMON 或不是資料夾）、
#   StateBad（procs_state.json 讀不懂）、MailboxMissing（daemon 沒開 ctl 信箱）、CommandMissing（PATH 沒 aos-post／aos-directive）、PostFailed（收件箱 init／take-all／see 失敗）。
#   stderr 一行「judge: error: 代號 原因」。--help＝英文用法印 stdout、退 0。Ctrl-C＝退 130、不吐 traceback。
import datetime, json, os, re, subprocess, sys

HELP = """\
usage: judge JUDGE.json   (run it with aos-exec as a daemon body or a loop proc; needs $AOS_STACK and $AOS_DAEMON)
One round of the judge: take the procs_* letters in $AOS_STACK/requests/, decide each by
JUDGE.json ({"allowed": [names] | null, "max_running": N | null, "queue": false, "keep_ordered": false}); forward the admitted ones
to the daemon's ctl mailbox, answer the others {"applied": false, "error": {code, msg}}.
A {"ping": true} body asks whether the daemon is there: forward it without judging.
Replies go directly to the original sender, or through the ordered reply relay when enabled.
If the judge is absent, nobody forwards it and the caller times out.
With queue=true, slot requests wait FIFO in requests/cur/; queue.json lists their positions.
queue_wait_ms is a non-negative integer wall-clock limit from sent_at; 0 means do not queue.
With keep_ordered=true, preserve ordered forwarding and relay replies using judge_ordered.json.
Missing/null keep_ordered means false: ordered requests become ordinary letters using their suffix.
With --on-queued ok no limit is attached: a request may remain queued forever.
Wall-clock limits expire during freezing; use --on-queued ok to queue across a freeze.
Each refused letter: one line "judge: warning: letter NAME refused: CODE reason" on stderr.
Exit 0 after a round (also with no letters). On error: "judge: error: CODE reason" on stderr, exit 1.
"""

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.exit(1)

NAME = "judge"
tool_io.start(NAME, HELP, echo=False)            # 不是給腦用的：錯誤行只到 stderr
NOT_FOUND = 10                                   # aos-post take-all／see 沒信
ORDERED = re.compile(r"^[0-9]{12}\.")            # 有序信的名字（N-16）


die = tool_io.die
warn = tool_io.warn


def run(argv, stdin_text="", cwd=None):
    """叫一支程式；回 (結束碼, stdout)。stderr 不接（照轉到我們的 stderr，不偷讀，C-52）。"""
    try:
        r = subprocess.run(argv, input=stdin_text, stdout=subprocess.PIPE, text=True, cwd=cwd)
    except OSError as e:
        die("CommandMissing", "%s failed to start (must be on PATH): %s" % (argv[0], e))
    return r.returncode, r.stdout


def post(args, stdin_text=""):
    return run(["aos-post"] + args, stdin_text)


def load_policy(path):
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        die("CfgMissing", "judge.json not found: %s" % path)
    except OSError as e:
        die("CfgBad", "cannot read judge.json: %s" % e)
    try:
        cfg = json.loads(text)
    except ValueError as e:
        die("CfgBad", "judge.json is not JSON: %s" % e)
    if not isinstance(cfg, dict):
        die("CfgBad", "judge.json must be an object")
    allowed, cap = cfg.get("allowed"), cfg.get("max_running")
    if allowed is not None and not (isinstance(allowed, list) and all(isinstance(n, str) for n in allowed)):
        die("CfgBad", "allowed must be an array of names or null")
    if cap is not None and not (isinstance(cap, int) and not isinstance(cap, bool) and cap >= 0):
        die("CfgBad", "max_running must be a non-negative integer or null")
    queue = cfg.get("queue", False)
    if not isinstance(queue, bool):
        die("CfgBad", "queue must be a boolean")
    keep_ordered = cfg.get("keep_ordered")
    if keep_ordered is None:
        keep_ordered = False
    if not isinstance(keep_ordered, bool):
        die("CfgBad", "keep_ordered must be a boolean or null")
    return (set(allowed) if allowed is not None else None), cap, queue, keep_ordered


def daemon_view(daemon):
    """回 (ctl 信箱的絕對路徑, 正在 running 的名字集合)。"""
    state = os.path.join(daemon, "procs_state.json")
    if not os.path.exists(state):
        return os.path.join(daemon, "procs_ctl_mailbox"), set()
    try:
        with open(state, encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        die("StateBad", "cannot read procs_state.json: %s" % e)
    code, out = run(["aos-directive"], text, cwd=daemon)
    try:
        if code != 0:
            raise ValueError("aos-directive exited %d" % code)
        st = json.loads(out)
        procs = st.get("procs") or {}
        running = {n for n, row in procs.items() if isinstance(row, dict) and row.get("phase") in {"running", "stuck"}}
    except (ValueError, AttributeError) as e:
        die("StateBad", "cannot parse procs_state.json: %s" % e)
    if "procs_ctl_mailbox" in st and st["procs_ctl_mailbox"] is None:
        die("MailboxMissing", "daemon has no ctl mailbox (procs_ctl_mailbox in procs_state.json is null)")
    box = st.get("procs_ctl_mailbox") or "procs_ctl_mailbox"
    return os.path.join(daemon, box), running


def letter_key(name):
    """處理順序：有序在前照名字、無序在後照名字（同 aos-post）。"""
    return (0 if ORDERED.match(name) else 1, name)


def verdict(body, allowed, cap, running, admitted):
    """回 (None, 新名字們)＝掛；(代號, 原因)＝不掛。"""
    if not isinstance(body, dict):
        return "BodyBad", "the letter body must be an object"
    names = []
    if "procs_added" in body:
        added = body["procs_added"]
        if not isinstance(added, dict):
            return "BodyBad", "procs_added must be an object"
        if allowed is not None:
            bad = [n for n in added if n not in allowed]
            if bad:
                return "NameUnknown", "%s not in allowed" % ", ".join(bad)
        names += list(added)
    for key in ("procs_started", "procs_woken"):       # start／wake 也是「多一個 running」（11-05 edge-agent）
        if key in body:
            v = body[key]
            if not isinstance(v, list) or not all(isinstance(n, str) for n in v):
                return "BodyBad", "%s must be an array of names" % key
            names += v
    if not names:
        return None, []
    fresh = []
    for n in names:
        if n not in running and n not in admitted and n not in fresh:
            fresh.append(n)
    if cap is not None and len(running) + len(admitted) + len(fresh) > cap:
        return "SlotMissing", "max_running is %d, %d running now (counting ones let through this round), this letter adds %d" % (
            cap, len(running) + len(admitted), len(fresh))
    return None, fresh


def write_ordered(path, rows):
    """原子寫入有序轉寄對照表。"""
    try:
        with open(path + ".tmp", "w", encoding="utf-8") as f:
            json.dump(rows, f, ensure_ascii=False)
            f.write("\n")
        os.replace(path + ".tmp", path)
    except OSError as e:
        die("StateBad", "cannot write judge_ordered.json: %s" % e)


def relay_replies(box, path, rows):
    """每輪先代回 daemon 的回信；轉回成功才移除對照與收信。"""
    if post(["init", box])[0] != 0 or post(["take-all", box])[0] not in (0, NOT_FOUND):
        die("PostFailed", "cannot take judge replies from %s" % box)
    for name in sorted(os.listdir(os.path.join(box, "cur")), key=letter_key):
        if name.startswith("."):
            continue
        code, out = post(["see", box, name])
        if code != 0:
            die("PostFailed", "cannot read judge reply %s" % name)
        letter = json.loads(out)
        original = rows.get(letter.get("in_reply_to"))
        if original is None:
            warn("reply %s has no ordered forwarding record; dropped" % name)
        else:
            if original["reply_to"]:
                code, _ = post(["send", "--in-reply-to", original["letter"], original["reply_to"]],
                               json.dumps(letter["body"], ensure_ascii=False))
                if code != 0:
                    warn("reply %s could not be relayed; retained for the next round" % name)
                    continue
            del rows[letter["in_reply_to"]]
            write_ordered(path, rows)
        if post(["done", box, name])[0] != 0:
            die("PostFailed", "cannot finish judge reply %s" % name)


def forward(name, letter, requests, ctl_box, keep_ordered, replies, ordered_path, ordered):
    """轉寄；選填保有序與代回，關閉時用尾名一般寄出。"""
    is_ordered = bool(ORDERED.match(name))
    tail = name.split(".", 1)[1] if is_ordered else name
    preserve = is_ordered and keep_ordered
    if preserve and any(row["letter"] == name for row in ordered.values()):
        return None
    if not preserve and os.path.exists(os.path.join(ctl_box, "new", tail)):
        return None
    args = ["send"]
    reply_to = letter.get("reply_to")
    original_reply = os.path.abspath(os.path.join(requests, reply_to)) if reply_to else None
    if reply_to:
        args += ["--reply-to", replies if preserve else original_reply]
    if preserve:
        args += ["--ordered"]
    args += [ctl_box, tail]
    code, out = post(args, json.dumps(letter["body"], ensure_ascii=False))
    if code != 0:
        return "aos-post send to the daemon's ctl mailbox exited %d (reason in its stderr)" % code
    if preserve and reply_to:
        ordered[out.strip()] = {"letter": name, "reply_to": original_reply}
        write_ordered(ordered_path, ordered)
    return None


def refuse(requests, name, code, msg):
    warn("letter %s refused: %s %s" % (name, code, msg))
    reply = {"applied": False, "error": {"code": code, "msg": msg}}
    rc, _ = post(["done", "--reply", requests, name], json.dumps(reply, ensure_ascii=False))
    if rc != 0:
        warn("letter %s: could not send the reply, letter dropped" % name)
        post(["done", requests, name])


def utc_ms(text):
    """信封 UTC 時間轉成整數毫秒，不用浮點數比較期限。"""
    value = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    if value.tzinfo is None:
        raise ValueError("sent_at must include a timezone")
    delta = value - datetime.datetime(1970, 1, 1, tzinfo=datetime.timezone.utc)
    return (delta.days * 86400 + delta.seconds) * 1000 + delta.microseconds // 1000


def utc_text(milliseconds):
    """Gregorian 每 400 年重複；極大期限用 ISO 擴展年份，不限制合法整數。"""
    cycles, remainder = divmod(milliseconds, 146097 * 86400000)
    value = datetime.datetime(1970, 1, 1, tzinfo=datetime.timezone.utc) + datetime.timedelta(milliseconds=remainder)
    year = value.year + cycles * 400
    prefix = "%04d" % year if year <= 9999 else "+%06d" % year
    return prefix + value.isoformat(timespec="milliseconds")[4:].replace("+00:00", "Z")


def queue_view(path):
    try:
        with open(path, encoding="utf-8") as f:
            rows = json.load(f)["queued"]
        if not isinstance(rows, list) or any(
                not isinstance(row, dict) or not isinstance(row.get("letter"), str)
                or not isinstance(row.get("queued_at"), str) for row in rows):
            raise ValueError("queued must contain letter and queued_at objects")
        return {row["letter"]: row for row in rows}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError, KeyError, TypeError) as e:
        # 11-07 sol 審查 #5：壞窗不整輪退 1（模式 1 會每拍退、隊列卡死），當空窗、隊序從 cur/ 照處理順序重排。
        warn("cannot read queue.json (%s); starting with an empty queue rebuilt from requests/cur/" % e)
        return {}


def write_queue(path, rows):
    """原子換窗；空隊也寫出，移掉已撤信或已放行的舊列。"""
    try:
        temporary = path + ".tmp"
        with open(temporary, "w", encoding="utf-8") as f:
            json.dump({"queued": rows}, f, ensure_ascii=False)
            f.write("\n")
        os.replace(temporary, path)
    except OSError as e:
        die("StateBad", "cannot write queue.json: %s" % e)


def expiry_message(letter, was_queued):
    body = letter.get("body")
    wait = body.get("queue_wait_ms") if isinstance(body, dict) else None
    if not wait:
        return None
    elapsed = tool_io.utc_now_epoch_ms() - utc_ms(letter["sent_at"])
    if elapsed < wait:
        return None
    return ("queued %d ms, no slot freed (queue_wait_ms %d)" % (elapsed, wait)
            if was_queued else
            "already expired when the judge received it (queue_wait_ms %d)" % wait)


def main():
    if len(sys.argv) != 2 or not sys.argv[1]:
        die("ArgumentsBad", "need exactly one argument, the path of judge.json (usage: judge JUDGE.json)")
    allowed, cap, queue, keep_ordered = load_policy(sys.argv[1])
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "AOS_STACK is not set")
    daemon = os.environ.get("AOS_DAEMON")
    if not daemon or not os.path.isdir(daemon):
        die("DaemonMissing", "AOS_DAEMON is not set or not a directory: %s" % (daemon or "(empty)"))
    requests = os.path.abspath(os.path.join(stack, "requests"))
    ordered_path = os.path.join(stack, "judge_ordered.json")
    replies = os.path.abspath(os.path.join(stack, "judge_replies"))
    try:
        with open(ordered_path, encoding="utf-8") as f:
            ordered = json.load(f)
        if not isinstance(ordered, dict) or any(
                not isinstance(row, dict) or not isinstance(row.get("letter"), str)
                or "reply_to" not in row
                or (row.get("reply_to") is not None and not isinstance(row["reply_to"], str))
                for row in ordered.values()):
            raise ValueError("invalid ordered forwarding records")
    except FileNotFoundError:
        ordered = {}
    except (OSError, ValueError) as e:
        die("StateBad", "cannot read judge_ordered.json: %s" % e)
    if keep_ordered or ordered or os.path.isdir(replies):
        relay_replies(replies, ordered_path, ordered)
    window = os.path.join(stack, "queue.json")
    previous = queue_view(window) if queue else {}
    if post(["init", requests])[0] != 0:
        die("PostFailed", "cannot create mailbox %s" % requests)
    if post(["take-all", requests])[0] not in (0, NOT_FOUND):
        die("PostFailed", "cannot take letters from mailbox %s" % requests)
    names = sorted((n for n in os.listdir(os.path.join(requests, "cur")) if not n.startswith(".")), key=letter_key)
    letters = {}
    # 先驗所有 cur 的期限，首次看見、關排隊、格仍滿時都不能漏掉。
    for name in names:
        code, out = post(["see", requests, name])
        if code == 1:
            warn("letter %s is broken; dropped" % name)
            post(["done", requests, name])
            continue
        if code != 0:
            die("PostFailed", "aos-post see %s exited %d" % (name, code))
        letter = json.loads(out)
        body = letter.get("body")
        if isinstance(body, dict) and "queue_wait_ms" in body:
            wait = body["queue_wait_ms"]
            if not isinstance(wait, int) or isinstance(wait, bool) or wait < 0:
                refuse(requests, name, "BodyBad", "queue_wait_ms must be a non-negative integer")
                continue
            try:
                utc_ms(letter["sent_at"])
            except (ValueError, TypeError, KeyError, OverflowError):
                refuse(requests, name, "BodyBad", "sent_at must be an ISO 8601 timestamp with a timezone")
                continue
            message = expiry_message(letter, name in previous)
            if message:
                refuse(requests, name, "SlotMissing", message)
                continue
        letters[name] = letter
    if queue:
        # 已進隊的優先；同輪新信照 aos-post 處理順序（有序先、再名字；11-07 sol 審查 #2，原本照 sent_at）。
        old_order = {name: i for i, name in enumerate(previous)}
        names = sorted(letters, key=lambda n: (0, old_order[n]) if n in old_order else (1, letter_key(n)))
    else:
        names = [name for name in names if name in letters]
    if not names:
        if queue or os.path.exists(window):
            write_queue(window, [])
        return
    ctl_box, running = daemon_view(daemon)
    admitted, queued = set(), []
    for name in names:
        letter = letters[name]
        body = letter.get("body")
        bad, detail = verdict(body, allowed, cap, running, admitted)
        # 不夠格的隊首阻擋後方要新格的信；stop/ping 與不增加格者照轉。
        if queue and queued and bad is None and detail:
            bad, detail = "SlotMissing", "an earlier letter is waiting for a slot"
        if bad == "SlotMissing" and queue and body.get("queue_wait_ms") != 0:
            _, fresh = verdict(body, allowed, None, running, admitted)
            row = {"letter": name, "names": fresh,
                   "queued_at": previous.get(name, {}).get("queued_at") or
                   datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")}
            if name in previous and "queued_at_ticks" in previous[name]:
                row["queued_at_ticks"] = previous[name]["queued_at_ticks"]
            elif name not in previous:
                try:
                    tick = tool_io.now_tick()
                except tool_io.Error as e:
                    die(e.code, str(e))
                if tick is not None:
                    row["queued_at_ticks"] = tick
            if "queue_wait_ms" in body:
                row["expires_at"] = utc_text(utc_ms(letter["sent_at"]) + body["queue_wait_ms"])
            queued.append(row)
            continue
        if bad:
            refuse(requests, name, bad, detail)
            continue
        # 讀信和前面的轉寄也花時間；臨轉寄再驗，避免本輪中途到期仍被掛上。
        message = expiry_message(letter, name in previous)
        if message:
            refuse(requests, name, "SlotMissing", message)
            continue
        failed = forward(name, letter, requests, ctl_box, keep_ordered, replies, ordered_path, ordered)
        if failed:
            refuse(requests, name, "ForwardFailed", failed)
            continue
        admitted.update(detail)
        post(["done", requests, name])
    if queue or os.path.exists(window):
        write_queue(window, queued)


main()
