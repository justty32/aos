#!/usr/bin/env python3
# llm_forward - Forward one endpoint request to the kernel named by its pack.
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.exit(1)



def forward_env(kernel):
    """轉寄時的環境：AOS_LLM_KERNEL 換成下層 kernel；拿掉 AOS_STACK（那是這封請求自己的小格），
    aos-llm 就照 identity() 算寄件人＝這台 kernel（$AOS_WS）：下層 kernel 把整台上層看成一個寄件人
    （11-13 線修：aos-llm 改成 $AOS_STACK 優先之後，不拿掉會變成每封一個寄件人）。"""
    env = {k: v for k, v in os.environ.items() if k != 'AOS_STACK'}
    env['AOS_LLM_KERNEL'] = kernel
    return env

def main():
    tool_io.start('llm_forward', echo=False, help_text='''llm_forward - Forward one request to another llm kernel.
usage: llm_forward [FLAGS] < REQUEST.json   (run with aos-exec)
Input: {"endpoint":{"to":"PACK","kernel":"STACK"},"request":{...},"priority"?:...}
Success: replace letter with child {kernel, letter}; keep all other fields.
Downstream failure: preserve stdout, stderr, and exit status.
Own failure: one error line on stderr, exit 1.
''')
    try:
        args = json.loads(sys.stdin.read())
        if not isinstance(args, dict):
            raise ValueError('stdin must be an object')
        flags = tool_io.argv_to_json(sys.argv[1:], tool_io.load_tooldef(HERE)['parameters'])
        args.update(flags)
        pack = args.get('endpoint')
        if not isinstance(pack, dict):
            raise ValueError('endpoint pack must be an object')
        for key in ('to', 'kernel'):
            if key not in pack:
                raise ValueError('endpoint pack has no "' + key + '"')
            if not isinstance(pack[key], str) or not pack[key]:
                raise ValueError('endpoint pack "' + key + '" must be a non-empty string')
        if not isinstance(args.get('request'), dict):
            raise ValueError('request must be an object')
    except tool_io.Error as error:
        tool_io.die(error.code, str(error))
    except (ValueError, TypeError) as error:
        tool_io.die('CfgBad', str(error))
    body = {'endpoint': pack['to'], 'request': args['request']}
    if 'priority' in args:
        body['priority'] = args['priority']
    try:
        result = subprocess.run(['aos-llm', 'ask', '--full'], input=json.dumps(body).encode(),
                                capture_output=True,
                                env=forward_env(pack['kernel']))
    except OSError as error:
        tool_io.die('LaunchFailed', str(error))
    if result.returncode:
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        return result.returncode if result.returncode > 0 else 128 - result.returncode
    try:
        reply = json.loads(result.stdout)
        if (len(result.stdout.splitlines()) != 1 or not isinstance(reply, dict) or
                not isinstance(reply.get('letter'), str) or not reply['letter']):
            raise ValueError('expected one reply object with a letter string')
        letter = reply.pop('letter')
        reply['child'] = {'kernel': pack['kernel'], 'letter': letter}
    except (ValueError, UnicodeError) as error:
        tool_io.die('ReplyBad', str(error))
    print(json.dumps(reply, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
