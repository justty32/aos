#!/usr/bin/env python3
# feedback - Submit command usability feedback through aos-feedback without guessing the caller.
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)


def main():
    tool_io.start('feedback')
    args = tool_io.arguments()
    argv = ['aos-feedback', 'add', '--by=' + args.get('by', 'aos-agent')]
    for key in ('kind', 'score'):
        if key in args:
            argv.append('--' + key + '=' + str(args[key]))
    argv += ['--', args['command'], args['pain']]
    if 'suggest' in args:
        argv.append(args['suggest'])
    try:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    except OSError as error:
        tool_io.die('LaunchFailed', 'aos-feedback failed to start (aos-feedback must be on PATH): %s' % error)
    except ValueError:
        tool_io.die('ArgumentsBad', 'Arguments must not contain null characters')
    if result.returncode != 0:
        tool_io.die('CommandFailed', 'aos-feedback add exited %d' % result.returncode)
    sys.stdout.write(result.stdout)


if __name__ == '__main__':
    main()
