#!/usr/bin/env python3
# aos_json - 腦用的 JSON 工具：stdin 收 {"cmd", "target", "value"?, "depth"?}，在 $AOS_WS 底下叫 aos-json，stdout 是結果。
# 讀＝peek 一層層往下（省 token）；寫＝直接收腦生成的 JSON 值，一律加 --check（改完 aos 設定形狀不對就不寫；del 例外，aos-json del 不收 --check）與 --follow（拆成 $ref 的檔也改得到）。
# target 的檔名只收工作區裡的相對路徑（不收絕對路徑、不收 ..）。
# 錯照 lib 契約（stdio-unify R2，11-05 起；之前 aos-json 的錯印 stdout 退 0）：stderr 與 stdout 各一行「aos_json: error: 代號 原因」、退 1；
#   要不要把錯回給腦是叫它的 agent 的事。aos-json 的 stderr 原樣透到 stderr；它退 1 時這行接它錯誤行的代號與原因
#   （`aos-json: error: 代號 原因` → `aos_json: error: 代號 原因`，腦才知道指標哪裡錯；代定，見 stdio-unify），沒那行＝CommandFailed。
#   check 有問題（aos-json 退 10，D1）是答案不是錯：stdout「problems:」加一行一條、退 0。
# --help＝英文說明印 stdout、退 0；Ctrl-C＝退 130、不吐 traceback。
import json, os, re, subprocess, sys, tempfile

HELP = """\
usage: aos_json [FLAGS] < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Look at or change a JSON file in the workspace through aos-json, one command at a time.
Writes use --check --follow (del only --follow); target must name a relative file inside the workspace.
Result on stdout ("ok" for writes; check with problems: "problems:" and one line each).
On error: one line "aos_json: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "aos_json"
tool_io.start(NAME, HELP)
die = tool_io.die

READ = {"peek": ["--follow"], "get": ["--follow"], "where": [], "check": []}
WRITE = {"set": ["--check", "--follow"], "batch": ["--check", "--follow"], "append": ["--check", "--follow"],
         "merge": ["--check", "--follow"], "del": ["--follow"]}   # aos-json del 不收 --check（照搬來前的行為；要驗形狀得先改 C++）
PROBLEMS = 10                                    # aos-json check：查完了、有問題（D1）
ERR_RE = re.compile(r"aos-json: error: ([A-Z][A-Za-z]+) (.*)\Z")


args = tool_io.arguments("cmd", "target")
WS = tool_io.workspace()
if args["cmd"] not in {**READ, **WRITE}:
    die("OpUnknown", "unknown command: %s" % args["cmd"])
cmd, target = args["cmd"], args["target"]
path = target.split("#", 1)[0]
if not path or os.path.isabs(path) or ".." in path.split("/"):
    die("PathBad", "the file in target must be a relative path inside the workspace (no absolute path, no ..): %s" % target)

if os.path.commonpath([WS, os.path.realpath(os.path.join(WS, path))]) != WS:
    die("PathBad", "the file in target is outside the workspace: %s" % target)

argv = ["aos-json", cmd] + READ.get(cmd, WRITE.get(cmd))
if cmd == "peek" and isinstance(args.get("depth"), int) and not isinstance(args.get("depth"), bool):
    argv += ["--depth", str(max(0, min(args["depth"], 5)))]
stdin = None
if cmd in ("set", "append", "merge", "batch"):
    if "value" not in args:
        die("ArgumentsBad", "%s needs value" % cmd)
    stdin = json.dumps(args["value"], ensure_ascii=False)
argv.append(target)
try:
    # 下層提早退掉時不向已關閉的 pipe 寫入，保留原本的錯誤轉接。
    with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as command_input:
        command_input.write(stdin or "")
        command_input.seek(0)
        r = subprocess.run(argv, cwd=WS, stdin=command_input, capture_output=True, text=True)
except OSError as e:
    die("LaunchFailed", "aos-json failed to start (aos-json must be on PATH): %s" % e)
if r.stderr:                                     # aos-json 自己的話原樣透出
    sys.stderr.write(r.stderr if r.stderr.endswith("\n") else r.stderr + "\n")
if r.returncode == 0:
    print(r.stdout if r.stdout else "ok", end="" if r.stdout else "\n")
elif cmd == "check" and r.returncode == PROBLEMS:
    print("problems:\n" + r.stdout, end="" if r.stdout.endswith("\n") else "\n")
else:
    m = [x for x in map(ERR_RE.match, r.stderr.strip().splitlines()) if x] if r.returncode == 1 else []
    if m:
        die(m[-1].group(1), m[-1].group(2))
    die("CommandFailed", "aos-json %s exited %d" % (cmd, r.returncode))
