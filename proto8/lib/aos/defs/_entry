#!/usr/bin/env python3
# defs - List, group, trace references and check public definition declarations.
import json
import os
import sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.exit(1)
from catalog import run

tool_io.start('defs', echo=False)
args = tool_io.arguments('op', 'root')
try:
    result = run(args)
    print(json.dumps(result, ensure_ascii=False), flush=True)
    if result.get('problems'):
        tool_io.die('DefBad', '%d definition problems found' % len(result['problems']))
except tool_io.Error as error:
    tool_io.die(error.code, str(error))
except (OSError, ValueError, KeyError, TypeError) as error:
    tool_io.die('DefBad', str(error))
