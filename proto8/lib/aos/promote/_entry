#!/usr/bin/env python3
# promote - Replace an idle definition with a candidate and retain its previous version.
import json
from pathlib import Path
import sys

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
LIB = next((p for p in HERE.parents if p.name == 'lib' and (p / 'tool_io.py').is_file()), None)
sys.path[:0] = [str(HERE)] + ([str(LIB)] if LIB else [])
import tool_io
from swap import promote

tool_io.start('promote')
args = tool_io.arguments('defs', 'target', 'from')
try:
    print(json.dumps(promote(args)))
except tool_io.Error as error:
    tool_io.die(error.code, str(error))
except (OSError, ValueError, RuntimeError) as error:
    tool_io.die('SwapFailed', str(error))
