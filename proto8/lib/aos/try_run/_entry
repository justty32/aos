#!/usr/bin/env python3
# try_run - 在工作區 target/（或 target.json）的暫時複本上 aos-exec 跑一次，回結束碼、stdout、stderr
# 介面（lib/README 的契約）：stdin 收 {"args"?: [...], "stdin"?: "...", "timeout_s"?: 10}；stdout「結束碼 N」＋兩段輸出（各留最後 8000 字）。
# 不動 target/ 本身（每次複製一份、跑完刪）；函數的工作區也是一個空的暫時資料夾；被跑的函數退非 0 是結果、不是錯。
# 逾時（預設 10 秒、上限 60）＝整群先 TERM、2 秒後 KILL，已經有的輸出照給、再接錯誤行 CommandFailed；這個工具被外面 TERM 時也先停掉那一群。
# 有 $IMPROVE_SANDBOX 就把函數關進 aos-sandbox（self-improve 的沙箱接線，10-24）。
# 錯：stderr 與 stdout 各一行「try_run: 代號 原因」、退 1。來源：demo/self-improve/improver/tools/try_run（10-24；遷移時參數 timeout 改名
# timeout_s（C-54 單位放字尾）、逾時從「印出來退 0」改成照 lib 契約算 CommandFailed；self-improve 的改進者照舊把錯回給腦）。
import json, os, shutil, signal, subprocess, sys, tempfile

TAIL = 8000                                   # stdout、stderr 各留最後幾個字
GRACE = 2                                     # TERM 之後等幾秒再 KILL


def die(code, reason):
    line = "try_run: %s %s" % (code, reason)
    print(line, file=sys.stderr)
    print(line)                               # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def tail(text):
    return text if len(text) <= TAIL else "…（前面截掉 %d 字）\n" % (len(text) - TAIL) + text[-TAIL:]


ws = os.environ.get("AOS_WS")
if not ws or not os.path.isdir(ws):
    die("WsMissing", "沒設定 AOS_WS 或不是資料夾")
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    die("ArgumentsBad", "stdin 不是 JSON：%s" % e)
if not isinstance(args, dict):
    die("ArgumentsBad", "要一個 JSON 物件")
argv, stdin, timeout = args.get("args", []), args.get("stdin", ""), args.get("timeout_s", 10)
if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
    die("ArgumentsBad", "args 要是字串陣列")
if not isinstance(stdin, str):
    die("ArgumentsBad", "stdin 要是字串")
if type(timeout) not in (int, float) or not 0 < timeout <= 60:
    die("ArgumentsBad", "timeout_s 要是 0～60 之間的秒數")
src = next((p for p in ("target", "target.json") if os.path.lexists(os.path.join(ws, p))), None)
if src is None:
    die("TargetMissing", "工作資料夾裡沒有 target/ 也沒有 target.json")

with tempfile.TemporaryDirectory(prefix="try_run.") as tmp:
    dst = os.path.join(tmp, src)
    try:
        (shutil.copytree if os.path.isdir(os.path.join(ws, src)) else shutil.copy2)(os.path.join(ws, src), dst)
    except OSError as e:
        die("ReadFailed", "複製 %s 失敗：%s" % (src, e))
    os.mkdir(os.path.join(tmp, "ws"))
    env = {k: v for k, v in os.environ.items() if not k.startswith("AOS_")}    # 函數拿到的是乾淨的 aos 環境
    cmd = ["aos-exec", "--ws", os.path.join(tmp, "ws"), dst] + argv
    if env.get("IMPROVE_SANDBOX"):            # 10-24 沙箱接線：self-improve 給了設定就關進 aos-sandbox（同 run 格）
        cmd = ["aos-sandbox", env["IMPROVE_SANDBOX"]] + cmd
        env["IMPROVE_RUN"] = tmp
    p = subprocess.Popen(cmd, stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, start_new_session=True)

    def stop():
        for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, None)):
            try:
                os.killpg(p.pid, sig)
            except ProcessLookupError:
                return
            try:
                p.wait(wait)
                return
            except subprocess.TimeoutExpired:
                pass

    def on_term(signum, frame):               # 外面（act 格逾時）停我時，函數那群不能留下來
        stop()
        sys.exit(128 + signum)
    signal.signal(signal.SIGTERM, on_term)
    signal.signal(signal.SIGINT, on_term)
    timed_out = False
    try:
        out, err = p.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        stop()
        out, err = p.communicate()
        timed_out = True
block = "--- stdout ---\n%s\n--- stderr ---\n%s" % (tail(out), tail(err))
if timed_out:
    print(block)
    die("CommandFailed", "跑超過 %g 秒，整群停掉了" % timeout)
print("結束碼 %d\n%s" % (p.returncode, block))
