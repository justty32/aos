#!/usr/bin/env python3
# knowledge_check - 檢查出廠知識庫：指標解析得到、_index 與內容一致沒孤兒、工具與指令各有節點、錯誤代號、開發殘留、大小；只讀不寫。
# 介面（lib 契約）：stdin 或旗標 {"root"?, "home"?, "only"?: [check...], "json"?: bool, "max_file_bytes"?: N, "max_text_bytes"?: N}。
#   home＝proto8（工具、指令、impls 從這裡找）：home ＞ $AOS_HOME ＞ 這支所在的 proto8；root＝庫根：root ＞ home/knowledge（相對從 $AOS_WS，沒設＝cwd）。
#   輸出（stdout）：一個問題一行「knowledge_check: error: 代號 位置: 原因」／「knowledge_check: warning: 檢查 位置: 原因」；
#   最後一行總數：沒有錯誤＝「knowledge_check: total: 0 errors, M warnings」退 0；有錯誤＝錯誤行 CheckFailed（stderr 與 stdout 同一行）退 1。
#   json＝stdout 改印一份 JSON（problems、errors、warnings），有錯誤時錯誤行只到 stderr。
import json
import os
import sys

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib) and not (os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py"))):
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
import tool_io  # noqa: E402

HELP = """\
usage: knowledge_check [--root DIR] [--home DIR] [--only CHECK]... [--json] < ARGUMENTS.json
Check the stock knowledge base without changing it. Checks (default: all):
  refs     aos/... paths in knowledge text, {"$ref": ...}, and in program strings
           (lib, cmd, templates, kernel; Details: lines in _tooldef.json) resolve
  index    every _index entry exists; every file, folder and key is listed (orphans)
  tools    every tool in lib/packs/*.json has a tooldef with a Details: path that resolves
  cmds     every cmd/*/bin/aos-* is named by some index entry's _description
  impls    the same for impls executables (warnings only)
  codes    tooldef error codes not found in the knowledge base, or with an ending
           outside C-54's (warnings)
  residue  dated notes (11-06 note), paths into thinking/, XXX placeholders
  size     files over max_file_bytes, text values over max_text_bytes (warnings)
One problem per line: "knowledge_check: error: CODE WHERE: reason" or
"knowledge_check: warning: CHECK WHERE: reason". The last line is the total.
home: the proto8 folder (default: $AOS_HOME, else the one this tool is in).
root: the knowledge base (default: HOME/knowledge).
Exit 0 with no errors (warnings allowed); 1 with errors (code CheckFailed) or on bad arguments.
"""
tool_io.start("knowledge_check", HELP)
args = tool_io.arguments()
try:
    import knowledge_fs  # noqa: F401,E402
except ModuleNotFoundError as error:
    if error.name != "knowledge_fs":
        raise
    tool_io.die("ModuleMissing", "knowledge_fs.py not in lib/agent/ or on the Python path")
import checks  # noqa: E402
import cover  # noqa: E402


def folder(value, base, code, what):
    real = os.path.realpath(os.path.join(base, value))
    if not os.path.isdir(real):
        tool_io.die(code, "%s %s resolves to %s, which is not a directory" % (what, value, real))
    return real


def run(args):
    base = os.environ.get("AOS_WS") or os.getcwd()
    home = args.get("home") or os.environ.get("AOS_HOME") or os.path.dirname(_lib)
    home = folder(home, base, "HomeBad", "home")
    root = folder(args.get("root") or os.path.join(home, "knowledge"), base, "KnowledgeBad", "root")
    only = args.get("only") or list(checks.CHECKS)
    bad = [c for c in only if c not in checks.CHECKS]
    if bad:
        tool_io.die("ArgumentsBad", "unknown check %s; use %s" % (", ".join(bad), ", ".join(checks.CHECKS)))
    limits = [args.get("max_file_bytes", 8192), args.get("max_text_bytes", 1024)]
    if any(isinstance(n, bool) or not isinstance(n, int) or n <= 0 for n in limits):
        tool_io.die("ArgumentsBad", "max_file_bytes and max_text_bytes must be positive integers")
    tree = checks.Tree(root, home)
    table = {"refs": lambda: checks.check_refs(tree), "index": lambda: checks.check_index(tree),
             "tools": lambda: cover.check_tools(tree), "cmds": lambda: cover.check_cmds(tree, "cmds"),
             "impls": lambda: cover.check_cmds(tree, "impls"), "codes": lambda: cover.check_codes(tree),
             "residue": lambda: checks.check_residue(tree), "size": lambda: checks.check_size(tree, *limits)}
    problems = [p for c in checks.CHECKS if c in only for p in table[c]()]
    return root, home, only, problems


root, home, only, problems = run(args)
errors = sum(p.level == "error" for p in problems)
warnings = len(problems) - errors
if args.get("json"):
    print(json.dumps({"root": root, "home": home, "checks": only, "errors": errors, "warnings": warnings,
                      "problems": [p._asdict() for p in problems]}, ensure_ascii=False, indent=1))
else:
    for p in problems:
        if p.level == "error":
            print(tool_io.error_line(p.code, "%s: %s" % (p.where, p.reason)))
        else:
            print("knowledge_check: warning: %s %s: %s" % (p.check, p.where, p.reason))
    sys.stdout.flush()
if errors:
    tool_io.die("CheckFailed", "%d errors, %d warnings" % (errors, warnings), echo=not args.get("json"))
if not args.get("json"):
    print("knowledge_check: total: 0 errors, %d warnings" % warnings)
