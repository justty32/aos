#!/usr/bin/env python3
# Read public shell accounts and report execution stages and command shapes.
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE.parents[1])]
import tool_io
from report import report

tool_io.start('shell_report')
args = tool_io.arguments()
try:
    stacks = args.get('stacks')
    if not isinstance(stacks, list) or not all(isinstance(path, str) and path for path in stacks):
        raise ValueError('stacks must be an array of absolute paths')
    print(json.dumps(report(stacks, args.get('defs')), ensure_ascii=False))
except (OSError, ValueError, KeyError, TypeError, AttributeError) as error:
    tool_io.die('ReportFailed', str(error))
