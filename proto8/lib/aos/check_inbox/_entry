#!/usr/bin/env python3
# check_inbox - 看自己信箱裡還沒處理的信（$AOS_WS/new/），只看不認領；stdout 一封一行摘要。
# 介面（lib/README 的契約）：stdin 收 {}（沒有參數；空 stdin 也算）；錯：stdin 不是 JSON 物件＝stderr 與 stdout 各一行「check_inbox: error: ArgumentsBad 原因」、退 1。
# 來源：demo/talk/member/tools/check_inbox（10-24；遷移時加上驗 stdin，原本不讀 stdin；demo/talk 11-04 刪了）。
import json, os, sys
HELP = """\
usage: check_inbox < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
List the unprocessed letters in $AOS_WS/new/, one line each (looks only, does not take).
Arguments: none (stdin is {} or empty).
Result on stdout. On error: one line "check_inbox: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
import tool_io  # noqa: E402

tool_io.start("check_inbox", HELP)
die = tool_io.die

args = tool_io.arguments()

new = os.path.join(os.environ.get("AOS_WS", "."), "new")
names = sorted(n for n in os.listdir(new) if not n.startswith(".")) if os.path.isdir(new) else []
if not names:
    print("Inbox is empty: no unprocessed letters.")
    sys.exit(0)
print("%d unprocessed (in arrival order; each becomes your task in turn):" % len(names))
for n in names:
    try:
        with open(os.path.join(new, n), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        continue
    try:
        l = json.loads(text) if n.endswith(".json") else None
    except ValueError:
        l = None
    if isinstance(l, dict) and l.get("kind") == "letter":
        body = " ".join(str(l.get("body", "")).split())
        print("- from %s | subject: %s | reply expected: %s | %s" % (l.get("from"), l.get("subject") or "(none)",
                                             "yes" if l.get("expect_reply") else "no", body[:200]))
    else:
        print("- task %s | %s" % (n, " ".join(text.split())[:200]))
