#!/usr/bin/env python3
# measure - Measure isolated cases, costs and repeat consistency as JSON.
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE.parents[1])]
import tool_io
from runner import measure

tool_io.start('measure', echo=False)
args = tool_io.arguments('case', 'defs')
try:
    stack = os.environ.get('AOS_STACK')
    if not stack:
        tool_io.die('StackMissing', 'AOS_STACK is not set')
    import json
    print(json.dumps(measure(args, stack), ensure_ascii=False))
except (OSError, ValueError, KeyError, TypeError) as error:
    tool_io.die('MeasureFailed', str(error))
