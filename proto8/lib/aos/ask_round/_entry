#!/usr/bin/env python3
# ask_round - 同步問一隻格組起來的 agent 一題：放進它的 queue、照它的 loop.json 一格一格跑到答完、印答案（agent 不必常駐）
# 介面（lib/README 的契約）：stdin 收 {"question", "agent"?, "timeout_s"?}；stdout＝答案原文（history 最新那則沒有 tool_calls 的 assistant 的 content）。
#   ask_round [--agent 路徑] [--max-steps N] [--ws 路徑]（11-01 起旗標取代原本的三個環境變數，環境變數不再讀；
#   旗標解析照 bin/aos_flags，不收位置參數）。
# 設計：thinking 2026-10-28-agent-round § 6「round 當外部接口」、§ 7 第 11 步、文末實作時代定 43～；
#   10-30 改走 queue（thinking 2026-10-30-agent-lifecycle 第 5 步）：題目＝一則 user message、放進 <工作區>/.stack/queue/，答案看 history。
#   agent＝參數 agent（絕對路徑）＞ --agent（「問 agent-xxx」固定一隻：工具小資料夾的 _entry 是不加 +x 的 JSON argv 陣列
#     ["<lib>/aos/ask_round", "--agent", "<agent 絕對路徑>"]，aos-exec 在前面插 aos-exec、stdin 照接）。
#   被問的 agent 的工作區＝--ws（有給）＞ $AOS_STACK/<agent 資料夾名>/（這個工具自己的小格，P-17）；它的 stack＝<工作區>/.stack/。
#   做法：queue 格照 lib/agent/parts.py 的 find 找（parts.json 有＝<agent>/parts.json#/queue、沒寫＝固定名字 <agent>/queue；11-01 起不經 aos-parts）；
#         aos-exec <queue> <agent> push（stdin 一則 {"role": "user", "content": 題文}，拿信號）
#         → aos-exec <agent>/loop.json#/exec 反覆叫（＝照那隻 agent 自己的 loop.json 走一格；nia 的單子是 aos-fsm 一張表，
#           每叫一次＝fsm 走一格）；每叫完一次就
#           aos-exec <queue> <agent> pop --timeout-s 0 <信號>（A-8 的規則交給 queue：信還在＝退 10、再叫一格；
#           信不見了＝finish 格已經 queue finish 完、整格跑完（state 回到 idle）＝印 history 最新那則 assistant＝答案）；
#         「答完就停手」看的是信不見了、不是那格的 10（被問的 agent 的表是 fsm-idle.json 時 queue 空也退 0，靠 10 會一直叫到次數用完）。
#         最多叫 --max-steps 格（預設 200，一題大約 4～8 格），總時間 timeout_s（預設 120、最多 600）。
#   搶信箱不加保護（決定 15）：同一個工作區另有 aos-loop 在收信，round 可能先答別題、這題被別人答——呼叫者自己避開（給各自的 --ws）。
# 錯：stderr 與 stdout 各一行「ask_round: 代號 原因」、退 1——ArgumentsBad（含旗標缺值、--max-steps 不是 ≥1 的整數、多給位置參數）、AgentBad（不是存在的絕對路徑）、AgentMissing（參數與 --agent 都沒給）、
#   FlagUnknown（不認得的旗標）、StackMissing（沒 --ws 也沒 AOS_STACK）、PartsBad（parts.json 讀不了、不是物件）、PartMissing（沒掛 queue 格）、
#   MkdirFailed、LaunchFailed（aos-exec 起不來）、QueueFailed（push 退非 0）、
#   RoundFailed（那一格退 0／10 以外，含 agent 沒有 loop.json＝aos-exec 退 1；那格自己那行照樣在 stderr）、AnswerMissing（信不見了 history 卻沒有答案〔queue pop 自己那行在 stderr〕、
#   那格退 10 queue 空了信卻還在、格數用完或逾時，答案還沒出來）。
# 逾時或自己被 TERM：先 TERM 正在跑的那一群、2 秒後 KILL，不留孤兒（契約 5）。
import json, os, signal, subprocess, sys, time

NAME = "ask_round"
USAGE = "ask_round [--agent 路徑] [--max-steps N] [--ws 路徑]（stdin＝arguments）"
TIMEOUT_DEFAULT, TIMEOUT_MAX = 120, 600
CHILD = None


def die(code, reason):
    line = "%s: %s %s" % (NAME, code, str(reason).replace("\n", " "))
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def stop_child():
    if CHILD and CHILD.poll() is None:
        try:
            os.killpg(CHILD.pid, signal.SIGTERM)
            CHILD.wait(timeout=2)
        except subprocess.TimeoutExpired:
            os.killpg(CHILD.pid, signal.SIGKILL)
            CHILD.wait()
        except ProcessLookupError:
            pass


def on_term(signum, frame):
    stop_child()
    sys.exit(128 + signum)


signal.signal(signal.SIGTERM, on_term)


def run(argv, stdin, env, deadline):
    """起一群、等它；回 (結束碼, stdout)；到 deadline＝收掉那群、回 None。"""
    global CHILD
    try:
        CHILD = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, env=env,
                                 start_new_session=True)   # stderr 不吞：下層自己說哪裡壞（C-52）
    except OSError as e:
        die("LaunchFailed", "%s 起不來：%s" % (argv[0], e))
    try:
        out, _ = CHILD.communicate(stdin, timeout=max(0.1, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        stop_child()
        return None, ""
    return CHILD.returncode, out


sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))), "bin"))
try:
    import aos_flags                                   # proto8/bin/aos_flags.py：同 parts，要從原處跑
except ImportError as e:
    die("LaunchFailed", "找不到 bin/aos_flags.py（ask_round 要從 proto8/lib/aos/ask_round 原處跑）：%s" % e)
try:
    opts, rest = aos_flags.parse(sys.argv[1:], {"--agent": "agent", "--max-steps": "max_steps", "--ws": "ws"})
except aos_flags.Error as e:
    die(e.code, "%s（usage: %s）" % (e, USAGE))
if rest:
    die("ArgumentsBad", "不收位置參數（usage: %s）" % USAGE)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    die("ArgumentsBad", "stdin 不是 JSON：%s" % e)
if not isinstance(args, dict):
    die("ArgumentsBad", "arguments 要是物件")
question = args.get("question")
if not isinstance(question, str) or not question.strip():
    die("ArgumentsBad", "要 question（非空字串）")
timeout_s = args.get("timeout_s", TIMEOUT_DEFAULT)
if isinstance(timeout_s, bool) or not isinstance(timeout_s, (int, float)) or not 0 < timeout_s <= TIMEOUT_MAX:
    die("ArgumentsBad", "timeout_s 要是 0～%d 的數字，收到 %r" % (TIMEOUT_MAX, timeout_s))
agent = args.get("agent", opts.get("agent"))
if agent in (None, ""):
    die("AgentMissing", "沒給 agent，也沒給 --agent")
if not isinstance(agent, str) or not os.path.isabs(agent) or not os.path.isdir(agent):
    die("AgentBad", "agent 要是存在的資料夾絕對路徑，收到 %r" % (agent,))
agent = os.path.normpath(agent)
try:
    max_steps = int(opts.get("max_steps", "200"))
    if max_steps < 1:
        raise ValueError
except ValueError:
    die("ArgumentsBad", "--max-steps 要是 ≥1 的整數，收到 %r（usage: %s）" % (opts.get("max_steps"), USAGE))
ws = opts.get("ws")
if not ws:
    if not os.environ.get("AOS_STACK"):
        die("StackMissing", "沒給 --ws，也沒有 AOS_STACK（工具的小格）可以放被問的 agent 的工作區")
    ws = os.path.join(os.environ["AOS_STACK"], os.path.basename(agent))
ws = os.path.abspath(ws)
stack = os.path.join(ws, ".stack")
try:
    os.makedirs(stack, exist_ok=True)                  # 工作區只放成品；queue 由 queue push 建在 stack 裡
except OSError as e:
    die("MkdirFailed", "建不了工作區 %s：%s" % (ws, e))

env = dict(os.environ)
env.update({"AOS_WS": ws, "AOS_STACK": stack + "/"})   # 明寫：外面的 AOS_STACK 是這個工具的小格，不是被問的 agent 的
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))), "agent"))
try:
    import parts                                       # lib/agent/parts.py：照實際位置找（_entry 捷徑可以、整份複製出 lib 就找不到）
except ImportError as e:
    die("LaunchFailed", "找不到 lib/agent/parts.py（ask_round 要從 proto8/lib/aos/ask_round 原處跑）：%s" % e)
try:
    queue = parts.find(agent, "queue")
except parts.Bad as e:
    die("PartsBad", e)
if queue is None:
    die("PartMissing", "沒掛 queue 格（%s/parts.json 沒登記、也沒有 %s/queue）" % (agent, agent))
queue = ["aos-exec", queue, agent]
deadline = time.monotonic() + timeout_s

message = json.dumps({"role": "user", "content": question}, ensure_ascii=False)
code, out = run(queue + ["push"], message, env, deadline)
if code is None:
    die("AnswerMissing", "放題就逾時了（timeout_s=%s）" % timeout_s)
if code != 0 or not out.strip():
    die("QueueFailed", "queue push 退 %d" % code)
qid = out.strip().splitlines()[0]
for n in range(1, max_steps + 1):
    code, _ = run(["aos-exec", os.path.join(agent, "loop.json") + "#/exec"], "", env, deadline)
    if code is None:
        die("AnswerMissing", "%s 逾時（timeout_s=%s），叫了 %d 格還沒答（工作區 %s）" % (qid, timeout_s, n, ws))
    if code not in (0, 10):
        die("RoundFailed", "%s/loop.json#/exec 退 %d（題目留在 %s，修好再叫一次會接著做）" % (agent, code, ws))
    got, answer = run(queue + ["pop", "--timeout-s", "0", qid], "", env, deadline)
    if got is None:
        die("AnswerMissing", "%s 逾時（timeout_s=%s），叫了 %d 格還沒答（工作區 %s）" % (qid, timeout_s, n, ws))
    if got == 0:
        sys.stdout.write(answer)
        sys.exit(0)
    if got != 10:
        die("AnswerMissing", "%s 已經不在 queue，卻拿不到答案（queue pop 退 %s；工作區 %s）" % (qid, got, ws))
    if code == 10:
        die("AnswerMissing", "那格說 queue 空了，%s 卻還在（被別人收走？工作區 %s）" % (qid, ws))
die("AnswerMissing", "叫了 %d 格（--max-steps）%s 還沒答（工作區 %s）" % (max_steps, qid, ws))
