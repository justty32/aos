#!/usr/bin/env python3
# send_message - 寄信給名冊上的成員或群組。stdin 收 {"to", "body", "subject"?, "expect_reply"?}，stdout 說寄了什麼。
#
# 名冊＝$AOS_ROSTER（roster.json）；我是誰＝名冊上信箱跟 $AOS_WS 是同一個資料夾的那位。
# 信＝收件人信箱的 new/<id>.json：先寫 tmp/<id>.json 再改名進 new/（N-05、N-16 Maildir）；自己留一份在 sent/<id>.json。
# 對話串：正在處理的那封信（$AOS_WS/cur/ 裡那一份）決定——thread 照抄、counter_hops（10-25 原 hops）＝它的＋1、reply_to＝它的 id；
#   cur/ 是人放的純文字題目＝這個題目開一串（thread＝<我>:<題名>）；cur/ 是空的（人從終端寄）＝新的一串。
# 擋迴圈：counter_hops 超過名冊的 max_hops、或這一層已經寄了 max_sends 封，就不寄。
# 錯（lib/README 的契約）：stderr 與 stdout 各一行「send_message: 代號 原因」、退 1——參數不對 ArgumentsBad、收件人不認得 RecipientUnknown、
#   沒有收件人 RecipientMissing、信太大 BodyBad、到手數上限 HopsBad、到寄信數上限 SendsBad、一封都送不到 MailboxMissing（送到一部分＝結果、退 0）；
#   環境沒設好：RosterMissing、RosterBad、SelfUnknown。回不回給腦由叫它的 agent 決定（talk 的 member 回給腦）。
# 來源：demo/talk/member/tools/send_message（10-24；遷移前「模型的錯」印「錯誤：…」退 0，現在照 lib 契約一律退 1）。
import json, os, secrets, sys
from datetime import datetime, timezone


def die(code, reason):
    line = "send_message: %s %s" % (code, reason)
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def write_atomic(dir_, name, data):
    os.makedirs(dir_, exist_ok=True)
    tmp = os.path.join(dir_, "." + name)
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(data)
    os.replace(tmp, os.path.join(dir_, name))


try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    die("ArgumentsBad", "參數不是 JSON：%s" % e)
if not isinstance(args, dict):
    die("ArgumentsBad", "參數要是物件")
roster_path = os.environ.get("AOS_ROSTER")
if not roster_path:
    die("RosterMissing", "沒設定 AOS_ROSTER（名冊 roster.json 的路徑）")
try:
    with open(roster_path, encoding="utf-8") as f:
        roster = json.load(f)
except (OSError, ValueError) as e:
    die("RosterBad", "%s 讀不了：%s" % (roster_path, e))
members = roster.get("members") if isinstance(roster, dict) else None
if not isinstance(members, dict):
    die("RosterBad", "名冊沒有 members 物件")
groups = roster.get("groups") or {}
base = os.path.dirname(os.path.abspath(roster_path))


def mailbox(name):
    m = members.get(name)
    return os.path.realpath(os.path.join(base, m["mailbox"])) if isinstance(m, dict) and isinstance(m.get("mailbox"), str) else None


ws = os.path.realpath(os.environ.get("AOS_WS", "."))
me = next((n for n in members if mailbox(n) == ws), None)
if me is None:
    die("SelfUnknown", "名冊上沒有哪個成員的信箱是 %s" % ws)

to, body = args.get("to"), args.get("body")
subject = args.get("subject") or ""
expect_reply = args.get("expect_reply", False)
if not isinstance(body, str) or not body.strip():
    die("ArgumentsBad", "body 要是非空字串")
if not isinstance(subject, str) or not isinstance(expect_reply, bool):
    die("ArgumentsBad", "subject 要是字串、expect_reply 要是 true／false")

# 收件人：名字、群組名、或名字的陣列；去掉自己、去重
names = to if isinstance(to, list) else [to]
recipients, group = [], None
for n in names:
    if not isinstance(n, str):
        die("ArgumentsBad", "to 要是名字、群組名或名字的陣列")
    if n in groups and n not in members:
        group = n if not isinstance(to, list) else None
        expand = groups[n] if isinstance(groups[n], list) else []
    elif n in members:
        expand = [n]
    else:
        die("RecipientUnknown", "不認得「%s」。名冊上有：%s；群組：%s" % (n, "、".join(members), "、".join(groups) or "無"))
    for x in expand:
        if x != me and x not in recipients:
            recipients.append(x)
if not recipients:
    die("RecipientMissing", "沒有收件人（不能寄給自己）")

max_body = roster.get("max_body_bytes", 16000)
if len(body.encode("utf-8")) > max_body:
    die("BodyBad", "信太大（%d 位元組，上限 %d）。請寫短一點，或把長內容放進檔案、信裡只寫路徑" % (len(body.encode("utf-8")), max_body))

# 對話串：看正在處理的那一份
cur_dir = os.path.join(ws, "cur")
cur = sorted(n for n in os.listdir(cur_dir) if not n.startswith(".")) if os.path.isdir(cur_dir) else []
now = datetime.now(timezone.utc)
reply_to, hops, thread = None, 1, None
if cur:
    parent = None
    if cur[0].endswith(".json"):
        try:
            with open(os.path.join(cur_dir, cur[0]), encoding="utf-8") as f:
                parent = json.load(f)
        except (OSError, ValueError):
            parent = None
    if isinstance(parent, dict) and parent.get("kind") == "letter":
        reply_to, hops, thread = parent.get("id"), int(parent.get("counter_hops") or 0) + 1, parent.get("thread")
    else:
        thread = "%s:%s" % (me, cur[0])

max_hops, max_sends = roster.get("max_hops", 8), roster.get("max_sends", 4)
if hops > max_hops:
    die("HopsBad", "這個對話串已經傳了 %d 手，到上限 %d，不能再寄。請直接用純文字給出你的結論。" % (hops - 1, max_hops))
sent_dir = os.path.join(ws, "sent")
already = 0
if thread is not None and os.path.isdir(sent_dir):
    for n in os.listdir(sent_dir):
        if n.endswith(".json") and not n.startswith("."):
            try:
                with open(os.path.join(sent_dir, n), encoding="utf-8") as f:
                    s = json.load(f)
            except (OSError, ValueError):
                continue
            if s.get("thread") == thread and s.get("counter_hops") == hops:
                already += 1
if already + len(recipients) > max_sends:
    die("SendsBad", "處理這一封時已經寄了 %d 封，再寄 %d 封會超過上限 %d。請直接用純文字給出你的結論。" % (already, len(recipients), max_sends))

def new_id():
    return "%s.%06dZ-%s-%s" % (now.strftime("%Y%m%dT%H%M%S"), now.microsecond, me, secrets.token_hex(3))


ids = [new_id() for _ in recipients]
thread = thread or ids[0]            # 新的一串：thread＝第一封的 id（群發時大家同一串）
done, failed = [], []
for r, lid in zip(recipients, ids):
    box = mailbox(r)
    if box is None or not os.path.isdir(box):
        failed.append("%s（信箱 %s 不在）" % (r, box))
        continue
    letter = {"kind": "letter", "id": lid, "from": me, "to": r, "group": group, "thread": thread,
              "reply_to": reply_to, "counter_hops": hops, "expect_reply": expect_reply,
              "sent_at": now.isoformat(timespec="milliseconds"), "subject": subject, "body": body}
    data = json.dumps(letter, ensure_ascii=False, indent=1) + "\n"
    os.makedirs(os.path.join(box, "tmp"), exist_ok=True)
    os.makedirs(os.path.join(box, "new"), exist_ok=True)
    tmp = os.path.join(box, "tmp", lid + ".json")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(data)
    os.replace(tmp, os.path.join(box, "new", lid + ".json"))       # 投遞：改名那一刻才算寄到
    write_atomic(sent_dir, lid + ".json", data)                      # 自己的寄件備份（也拿來數上限）
    done.append("%s（%s）" % (r, lid))

if not done:
    die("MailboxMissing", "送不到 %s" % "、".join(failed))
out = []
if done:
    out.append("已寄出 %d 封：%s。對話串 %s，第 %d 手%s。" % (len(done), "、".join(done), thread, hops,
                                                      "，等對方回信（回信會變成你之後的新題目）" if expect_reply else ""))
if failed:
    out.append("錯誤：送不到 %s" % "、".join(failed))
print("\n".join(out))
