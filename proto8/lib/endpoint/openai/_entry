#!/usr/bin/env python3
# openai - endpoint 格：吃一份 OpenAI chat completions 請求體（去掉認證），問 OpenAI 相容的 {AOS_BRAIN_URL}/chat/completions，吐那一則 assistant message
# 叫法：aos-exec <這格> <agent 資料夾>（agent 資料夾收下不用，同一叫法才收；設計：proto8/thinking/2026-10-28-agent-round.md § 4 endpoint）。
# stdin：一個 JSON 物件 {"messages": [...], "tools"?: [...], "model"?: ...}，其他 key（temperature 之類）原樣送；tools 是空陣列就不送。
# stdout：一行 JSON＝assistant message，只留 role、content、tool_calls（模型想的內容不收，P-23）。
# usage：每次問完追加一行進 $AOS_STACK/usage.jsonl：{"answered_at", "endpoint", "model", "usage"}（usage＝API 回的原樣，沒回＝null）；
#   有 AOS_KERNEL_REPORT 就把 usage 寫成那份檔（照 agent-dan 的 brain.py，P-23 註）。usage 不進 stdout。
# 設定（環境變數；註冊檔 parts.json 的 env 或固定名字那格的 .env 給）：
#   AOS_BRAIN_URL（必給，例 http://localhost:4000/v1）、AOS_BRAIN_MODEL（stdin 沒給 model 時用；兩邊都沒有＝ModelUnknown）、
#   AOS_BRAIN_KEY（有才帶 Authorization: Bearer）、TIMEOUT_MS（這一次請求的逾時，預設 120000）、
#   ENDPOINT_NAME（寫進 usage.jsonl 的名字；沒設＝這支 _entry 實際所在的資料夾名，例 openai）。
# 錯：stderr 一行「endpoint: 代號 原因」、退 1（N-43，分類靠代號）：
#   BrainFailed（連不上、逾時、5xx、429；原因帶 HTTP 碼）、KeyBad（401／403）、ModelUnknown（404，或沒給 model）、
#   RequestBad（其他 4xx；stdin 不是請求體也算——我們要送的東西不對）、ReplyBad（2xx 但不是 OpenAI 的形狀）、
#   UrlMissing（沒設 AOS_BRAIN_URL）、TimeoutBad（TIMEOUT_MS 不是正整數）、StackMissing、ArgumentsBad（參數多於一個）。
# 失敗時 stdout 不吐、usage.jsonl 不寫。
import datetime, json, os, sys, urllib.error, urllib.request

NAME = "endpoint"


def die(code, reason):
    print("%s: %s %s" % (NAME, code, str(reason).replace("\n", " ")), file=sys.stderr)
    sys.exit(1)


if len(sys.argv) > 2:
    die("ArgumentsBad", "usage: aos-exec <endpoint 格> [<agent 資料夾>]（收到 %d 個參數）" % (len(sys.argv) - 1))
stack = os.environ.get("AOS_STACK")
if not stack:
    die("StackMissing", "沒設定 AOS_STACK")
url = os.environ.get("AOS_BRAIN_URL")
if not url:
    die("UrlMissing", "沒設定 AOS_BRAIN_URL")
try:
    timeout_ms = int(os.environ.get("TIMEOUT_MS") or "120000")
    if timeout_ms <= 0:
        raise ValueError
except ValueError:
    die("TimeoutBad", "TIMEOUT_MS 要是正整數（毫秒），收到 %r" % os.environ.get("TIMEOUT_MS"))
endpoint = os.environ.get("ENDPOINT_NAME") or os.path.basename(os.path.dirname(os.path.realpath(__file__)))

try:
    body = json.loads(sys.stdin.read())
except ValueError as e:
    die("RequestBad", "stdin 不是 JSON：%s" % e)
if not isinstance(body, dict) or not isinstance(body.get("messages"), list):
    die("RequestBad", "stdin 要是 {\"messages\": [...], \"tools\"?: [...]}")
if "tools" in body and not isinstance(body["tools"], list):
    die("RequestBad", "tools 要是陣列")
if not body.get("tools"):
    body.pop("tools", None)                          # 空的不送：有些 server 收到空 tools 會報錯
model = body.get("model") or os.environ.get("AOS_BRAIN_MODEL")
if not model:
    die("ModelUnknown", "stdin 沒給 model、也沒設定 AOS_BRAIN_MODEL")
body["model"] = model

headers = {"Content-Type": "application/json"}
if os.environ.get("AOS_BRAIN_KEY"):
    headers["Authorization"] = "Bearer " + os.environ["AOS_BRAIN_KEY"]
req = urllib.request.Request(url.rstrip("/") + "/chat/completions",
                             json.dumps(body, ensure_ascii=False).encode("utf-8"), headers)
try:
    with urllib.request.urlopen(req, timeout=timeout_ms / 1000) as r:
        raw = r.read()
except urllib.error.HTTPError as e:
    detail = e.read()[:200].decode("utf-8", "replace")
    if e.code in (401, 403):
        code = "KeyBad"
    elif e.code == 404:
        code = "ModelUnknown"
    elif e.code == 429 or e.code >= 500:
        code = "BrainFailed"
    elif 400 <= e.code < 500:
        code = "RequestBad"
    else:
        code = "BrainFailed"
    die(code, "HTTP %d：%s" % (e.code, detail))
except (urllib.error.URLError, OSError) as e:     # 連不上、逾時（TimeoutError 是 OSError）
    die("BrainFailed", "%s 連不上或逾時：%s" % (url, getattr(e, "reason", e)))

try:
    reply = json.loads(raw)
    message = reply["choices"][0]["message"]
except (ValueError, KeyError, IndexError, TypeError) as e:
    die("ReplyBad", "回覆不是 OpenAI 的形狀（%s: %s）" % (type(e).__name__, e))
if not isinstance(message, dict):
    die("ReplyBad", "choices[0].message 不是物件")
out = {"role": message.get("role") or "assistant", "content": message.get("content")}
calls = message.get("tool_calls")
if calls:
    if not isinstance(calls, list) or not all(isinstance(c, dict) for c in calls):
        die("ReplyBad", "tool_calls 不是物件的陣列")
    out["tool_calls"] = [{k: c[k] for k in ("id", "type", "function") if k in c} for c in calls]

usage = reply.get("usage") if isinstance(reply, dict) else None
line = {"answered_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z",
        "endpoint": endpoint, "model": model, "usage": usage if isinstance(usage, dict) else None}
os.makedirs(stack, exist_ok=True)
with open(os.path.join(stack, "usage.jsonl"), "a", encoding="utf-8") as f:   # 只追加、一次寫一整行
    f.write(json.dumps(line, ensure_ascii=False) + "\n")
report = os.environ.get("AOS_KERNEL_REPORT")
if report and isinstance(usage, dict):           # 經 LLM kernel 跑時把 API 回的 usage 交給它（P-23 註）
    tmp = os.path.join(os.path.dirname(report), "." + os.path.basename(report))   # N-05：先寫暫存再改名
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(usage, f)
    os.replace(tmp, report)
print(json.dumps(out, ensure_ascii=False))
