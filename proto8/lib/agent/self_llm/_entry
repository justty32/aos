#!/usr/bin/env python3
# self_llm - aos-agent llm 的包裝，目標改成叫我的那隻自己：ls、set、rm、reset；改的是那隻 stack 裡自己那份 llm 設定，定義不動
# 使用者 11-10 晚：頂層提議 self_brain（包裝 aos-agent llm、目標是自己），使用者「self_brain來做吧，但改名self_llm」；原則同 self_tools（純包裝、不多給、不多擋：
#   腦把自己設成不通的腦而停住屬自行承擔）。**對應關係**：aos-agent llm 加了動作或旗標，這支要跟著加（參數一對一）。
# 11-10 晚使用者「換」：show 換成 ls（比照 tools，可要長版）、加 rm（只拿掉自己改的某幾鍵）。
# 介面（lib/README 的契約）：stdin 收 {"op": "ls"|"set"|"rm"|"reset", …}；別的鍵＝ArgumentsBad：
#   ls {long?}                   ＝llm ls（印 KEY=VALUE 一行一個，定義疊這隻改過的）；long: true＝llm ls -l（多一欄 definition｜agent）
#   set {settings: {KEY: VALUE}} ＝llm set KEY=VALUE…（值是字串；認哪些鍵由身體決定，例 model；身體不讀的鍵照存、warning 那行也印進 stdout 給腦看；
#     鍵 system＝ArgumentsBad、指到 self_system、不叫下層，11-11 使用者翻案「報錯並指路」）
#   rm {keys: [KEY…]}            ＝llm rm KEY…（回到定義的值）
#   reset {}                     ＝llm reset -y（腦叫了就算確認過）
#   先 aos-agent ctl who（$AOS_STACK＝<agent stack>/tools/self_llm/ 查 daemon 表）認出是哪隻；aos-agent 在 $AOS_WS 跑。
#   結果：下層 stdout 原樣（set／reset 多一句「下一題起生效」）。錯：同 self_tools（stderr 與 stdout 各一行「self_llm: error: 代號 原因」、退 1；
#   下層最後一行錯誤行的代號與原因接上，C-52 例外 ⑤；沒那行才是 CommandFailed）。只在 daemon 下跑的 agent 能用。
# 需要 PATH 上有 aos-agent（proto8/install.sh）。每次叫 aos-agent 最多 60 秒；被外面 TERM 時先收掉它再走（lib 契約規則 5）。
import os, sys
HELP = """\
usage: self_llm < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
List or change the brain settings of the agent that calls me (its own copy, not its definition):
op ls | set | rm | reset (aos-agent llm with the target = me). Changes apply from your next brain call.
Result on stdout. On error: one line "self_llm: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、旁邊的 lib/agent（cmd_call）、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE, os.path.dirname(HERE)] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
    import cmd_call  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name not in ("tool_io", "cmd_call"):
        raise
    _line = "%s: error: ModuleMissing %s.py not in the tool folder, not in lib/, not on the Python path\n" % (os.path.basename(HERE), error.name)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "self_llm"
tool_io.start(NAME, HELP)
notes = []


die = tool_io.die


arguments = tool_io.arguments


def agent(*args):
    """aos-agent args…：stderr 原樣往上；退非 0＝它最後一行錯誤行的代號與原因當自己的錯（沒有＝CommandFailed）。回 stdout。"""
    _, out, err = cmd_call.call("aos-agent", args, shown=2)
    notes.extend(l for l in err.splitlines() if l.endswith("stored anyway"))   # 身體不讀的鍵：腦只看 stdout，這句也給它
    return out


cmd_call.catch_signals()                       # TERM 與 Ctrl-C：先收掉正在跑的那一群，退 128＋N（Ctrl-C 130、不吐 traceback，R12）
args = arguments()
OPS = {"ls": ("long",), "set": ("settings",), "rm": ("keys",), "reset": ()}
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (%s)" % ", ".join(OPS))
if op not in OPS:
    die("OpUnknown", "op must be one of %s (got %r)" % (", ".join(OPS), op))
extra = sorted(k for k in args if k != "op" and k not in OPS[op])
if extra:
    die("ArgumentsBad", "op %s does not take %s (it takes %s)" % (op, ", ".join(extra), ", ".join(OPS[op]) or "nothing else"))

cmd = ["llm", "--target", None, op]
if op == "set":
    s = args.get("settings")
    if not isinstance(s, dict) or not s or not all(isinstance(k, str) and k and "=" not in k and isinstance(v, str) for k, v in s.items()):
        die("ArgumentsBad", "set needs settings: an object of strings, like {\"model\": \"smart-high\"}")
    if "system" in s:                           # 11-11 使用者翻案「報錯並指路」：不叫下層、不存（thinking/2026-11/11/backlog-rulings.md）
        die("ArgumentsBad", "system is not a brain setting: change your system text with self_system "
            "({\"op\": \"set\", \"text\": \"...\"}); nothing stored")
    cmd += ["%s=%s" % (k, s[k]) for k in s]
elif op == "ls":
    if args.get("long"):
        cmd += ["-l"]
elif op == "rm":
    keys = args.get("keys")
    if not isinstance(keys, list) or not keys or not all(isinstance(k, str) and k for k in keys):
        die("ArgumentsBad", "rm needs keys: a list of key names, like [\"temperature\"]")
    cmd += keys
elif op == "reset":
    cmd += ["-y"]

cmd[2] = agent("ctl", "who").strip()
out = agent(*cmd)
for line in notes:
    print(line)
if out.strip():
    sys.stdout.write(out if out.endswith("\n") else out + "\n")
else:
    print("(no settings: your body uses its defaults)")
if op in ("set", "rm", "reset"):
    print("(takes effect from your next brain call)")      # 驗收：brain 每格重讀，同一題的下一拍就換
