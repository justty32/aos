#!/usr/bin/env python3
# thought - 小念頭：派一件事給一隻用完即走的子 agent（呼叫方指定或工具設定預設定義），只拿回短結論；子的工具來回不進叫我的那隻的 history
# 使用者 11-05 傍晚：「fork出去，做完之後回報，主線這邊對於這個任務的描述就會只剩短短幾句……我更推薦將其作為工具」「記憶這項，他本身也算是任務」；
#   三題裁：子的腦「預設同父 (Recommended)」、子 stack「可選。默認刪掉。」、名字「thought (Recommended)」。
#   規劃：proto8/thinking/2026-11/05/small-thought/（README、02-代定、03-實作步驟草稿；實作結果段在 README）。
# 介面（lib/docs/01 的契約）：stdin 一份 {"from"?, "goal", "context"?, "tools"?, "endpoint"?, "max_chars"?, "timeout_s"?, "timeout_ticks"?, "keep"?}，沒有 op：
#   from 沒給＝工具登記格 env.AOS_THOUGHT_FROM；兩邊都沒給＝FromMissing，兩種來源都相對 $AOS_WS 解析。
#   goal 必要（要做什麼、要帶回什麼）；context＝字串或字串陣列（前幾步的結論）；tools＝[{name, path?}]（path 相對從 $AOS_WS、絕對照用；
#   沒給 path＝照抄我自己工具箱裡同名那支〔aos-agent tools ls --json〕，沒有＝ToolMissing），沒給 tools＝保留定義的工具組；[]＝清空；endpoint＝子的腦，沒給＝同父（aos-agent llm show 父的 endpoint；父沒寫或沒宣告 llm＝範本預設；llm show 其他錯〔看不到父的定義等〕＝接它的代號報錯，不默默換腦）；
#   max_chars 預設 600（結論超過就截、尾加 [truncated]）；timeout_s 預設 600、只要求有限正數；keep 預設 false。
# 一次叫＝aos-agent --daemon $AOS_DAEMON 的五步：ctl who（我是誰、我的深度）→ ctl add 範本（--name t-<父名前32字>-<UTC毫秒>-<4位hex>、--ws 我的 $AOS_WS）→
#   子的覆蓋層 llm set endpoint／tools rm／tools add --override → say 開場文（固定英文段＋goal＋context）＋listen --timeout-s／--timeout-ticks →
#   預設 ctl rm 子（stack 刪掉、不印 details）；keep: true＝留著但 ctl stop（不佔 loop；要追問 ctl start 再 say）、結論後多一行 details: <子的 stack，相對 $AOS_DAEMON>/。
#   ctl add 之後到 say 之前任一步失敗（tools ls、設定那幾步）＝當下 ctl rm 收回再報錯（不算子的失敗）；收不回＝紀錄留 running 租約，過期後下一次叫的對帳收。
# 子名每次唯一：mkdir $AOS_STACK/children/<子名>/，撞表或資料夾最多重試五次。
#   state＝running <UTC到秒Z租約>／kept／failed；每步呼叫前續租至逾時＋5秒，TERM 收回租約。
#   對帳先保護未到期租約與剛建資料夾；表上沒有就忘掉，過期 running 先 stop 再記 failed；kept 不動，failed 照 FAILED_KEEP gc。
# 深度：讀 AOS_THOUGHT_DEPTH（沒有＝0），ctl add --envs 在啟動時傳父+1，子 stack 不寫深度檔；
#   深度已是 MAX_DEPTH（2）＝DepthExceeded、不生（子能再開孫、孫不行）。
# 錯：stderr 與 stdout 各一行「thought: error: 代號 原因」、退 1（規則 3，tool_io.die）——自己的：ArgumentsBad、FromMissing、DepthExceeded、
#   DaemonMissing（AOS_DAEMON 沒設或目錄不存在）、DaemonFailed（目錄存在但逾時沒回信：忙、暫停、掛了）、StackMissing、WsMissing、DefMissing（範本不在）、ToolMissing、MkdirFailed、WriteFailed、LaunchFailed（aos-agent 不在 PATH）、
#   CommandFailed（逾時）；aos-agent 退非 0＝取它 stderr 最後一行錯誤行的代號與原因接成自己的（AddRejected、AnswerMissing…；同 agents）。
#   子答不出（listen 錯、逾時）＝錯誤行尾附 (details: <子的 stack>/)，子先 ctl stop、stack 一律留（不管 keep）。
#   aos-agent 的 stderr 原樣透到 stderr（R10）。--help＝英文說明印 stdout、退 0；Ctrl-C 同 TERM（先收掉那一群，退 130）。
import json, math, os, re, secrets, signal, subprocess, sys, time
from datetime import datetime, timedelta, timezone
HELP = """\
usage: thought < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Hand one task to a throw-away child agent from your chosen definition on your daemon ($AOS_DAEMON)
and print only its short conclusion; the child's tool calls stay out of your history.
The "from" definition and tool paths may be relative to your workspace or absolute.
Omit "from" to use AOS_THOUGHT_FROM, set in this tool's registry entry env (or add --envs).
Its relative path also starts at your workspace. Neither given: FromMissing.
Omit tools to keep the definition's tools; tools: [] gives the child no tools.
timeout_s is any finite positive number of seconds (default 600).
Use timeout_ticks (a positive integer) instead to count ticks; giving both is ArgumentsBad.
Without AOS_TICK, one tick is AOS_TICK_INTERVAL milliseconds (default 1000).
Without endpoint the child uses your brain; if your brain settings cannot be read (e.g. your
definition is not visible in a sandbox), the call fails with that error instead of guessing.
To ask a kept child more later, use aos-agent ctl start --target <child>, then say / listen.
Result on stdout: the conclusion. The child is removed afterwards unless keep is true; if it fails, its stack
is kept and the error line ends with (details: <stack>/). A child may start one more level of thoughts
(depth 2 at most: DepthExceeded).
Each child has a unique name; running records use renewable UTC leases. Interrupted leases expire,
and the next call stops expired children and keeps their stacks as failed thoughts.
DaemonMissing means AOS_DAEMON is unset or its directory does not exist.
DaemonFailed means its directory exists but no reply arrived within the timeout (busy, paused, or down).
On error: one line "thought: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "thought"
tool_io.start(NAME, HELP)
die = tool_io.die
ERR_RE = re.compile(r"aos-[a-z-]+: error: ([A-Z][A-Za-z]+) (.*)\Z")
MAX_CHARS_DEFAULT, TIMEOUT_DEFAULT_S = 600, 600
MAX_DEPTH = 2                  # 父 0 → 子 1 → 孫 2；孫再叫＝DepthExceeded（代定）
FAILED_KEEP = 3                # 失敗留下的子 stack 最多留幾隻（gc，代定）
STEP_S = 90                    # 其他每一步的逾時（ctl add 自己最多等 30 秒）
OPENING = """You are a small thought: a helper started for this one task only.
Do the task below (use your tools if you need them). When you are done, reply with the conclusion only:
what the task asks you to bring back, not the steps you took. At most {n} characters.

Task: {goal}"""
child = None
running_kid = None


def kill_group(p):
    for sig, wait_s in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        try:
            os.killpg(p.pid, sig)
        except OSError:
            return
        try:
            p.wait(wait_s)
            return
        except subprocess.TimeoutExpired:
            pass


def on_term(signum, frame):
    if running_kid is not None:
        try:
            renew(0)
        except SystemExit:
            pass                                # 寫租約失敗也要收自己的子行程、照訊號退碼
    if child is not None:
        kill_group(child)
    sys.exit(128 + signum)


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)          # Ctrl-C：同 TERM，退 130、不吐 traceback（R12）


def agent(argv, text=None, timeout_s=STEP_S, timeout_ticks=None):
    """叫 aos-agent --daemon <AOS_DAEMON> argv…；退 0 回 (stdout, None)，退非 0 或逾時回 (stdout, (代號, 原因))。"""
    global child
    if running_kid is not None:
        renew(timeout_s + 5)
    try:
        deadline = tool_io.deadline_after(timeout_ticks) if timeout_ticks is not None else None
    except tool_io.Error as e:
        return "", (e.code, str(e))
    cmd = ["aos-agent", "--daemon", daemon] + argv
    try:
        child = subprocess.Popen(cmd, stdin=subprocess.PIPE if text is not None else subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        die("LaunchFailed", "cannot start aos-agent (is it on PATH?): %s" % e)
    end = time.monotonic() + timeout_s
    payload = None if text is None else text.encode("utf-8")
    while True:
        try:
            out, err = child.communicate(payload, timeout=0.2 if deadline is not None else min(86400, max(0, end - time.monotonic())))
            break
        except subprocess.TimeoutExpired:
            payload = None
            try:
                waiting = not tool_io.expired(deadline) if deadline is not None else time.monotonic() < end
            except tool_io.Error as e:
                kill_group(child)
                child = None
                return "", (e.code, str(e))
            if waiting:
                if deadline is not None and running_kid is not None:
                    try:
                        renew(STEP_S + 5)
                    except SystemExit:
                        kill_group(child)
                        child = None
                        raise
                continue
            kill_group(child)
            child = None
            return "", ("CommandFailed", "aos-agent %s did not finish in %s (killed)" % (" ".join(argv[:2]), "%d ticks" % timeout_ticks if deadline is not None else "%g s" % timeout_s))
    p, child = child, None
    out, err = out.decode("utf-8", "replace"), err.decode("utf-8", "replace")
    if err:                                     # 下層的 stderr 原樣透出（R10）
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    if p.returncode == 0:
        return out, None
    lines = [x for x in err.splitlines() if x.strip()]
    mine = [m for m in map(ERR_RE.match, lines) if m]
    if mine:
        return out, (mine[-1].group(1), mine[-1].group(2))
    return out, ("CommandFailed", "aos-agent %s exited %d: %s" % (" ".join(argv[:2]), p.returncode, lines[-1] if lines else "(no message)"))


def must(argv, text=None, timeout_s=STEP_S):
    out, err = agent(argv, text, timeout_s)
    if err:
        die(*err)
    return out


def write_text(path, text):
    tmp = os.path.join(os.path.dirname(path), ".%s.%d" % (os.path.basename(path), os.getpid()))
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (path, e))


# ---- 入口檢查（參數先、環境後）----
args = tool_io.arguments()
if "from" in args:
    source = args["from"]
    if not isinstance(source, str) or not source.strip():
        die("ArgumentsBad", "from must be a non-empty agent definition path")
else:
    source = os.environ.get("AOS_THOUGHT_FROM")
    if not source or not source.strip():
        die("FromMissing", "give from or set AOS_THOUGHT_FROM in this tool's registry entry env")
goal = args.get("goal")
if not isinstance(goal, str) or not goal.strip():
    die("ArgumentsBad", "goal must be a non-empty string: what to do and what to bring back")
context = args.get("context", [])
if isinstance(context, str):
    context = [context]
if not isinstance(context, list) or not all(isinstance(c, str) for c in context):
    die("ArgumentsBad", "context must be a string or an array of strings")
tools = args.get("tools")
if tools is not None and (not isinstance(tools, list) or not all(
        isinstance(t, dict) and isinstance(t.get("name"), str) and t["name"]
        and (t.get("path") is None or isinstance(t["path"], str) and t["path"]) for t in tools)):
    die("ArgumentsBad", "tools must be an array of {name, path?} (non-empty strings; no path = the same tool as yours)")
endpoint = args.get("endpoint")
if endpoint is not None and (not isinstance(endpoint, str) or not endpoint):
    die("ArgumentsBad", "endpoint must be a non-empty string (a brain pack name of the llm kernel)")
max_chars = args.get("max_chars", MAX_CHARS_DEFAULT)
if isinstance(max_chars, bool) or not isinstance(max_chars, int) or max_chars < 1:
    die("ArgumentsBad", "max_chars must be a positive integer")
if "timeout_s" in args and "timeout_ticks" in args:
    die("ArgumentsBad", "timeout_s and timeout_ticks are mutually exclusive")
timeout_ticks = args.get("timeout_ticks")
if "timeout_ticks" in args and (isinstance(timeout_ticks, bool) or not isinstance(timeout_ticks, int) or timeout_ticks <= 0):
    die("ArgumentsBad", "timeout_ticks must be a positive integer")
timeout_s = args.get("timeout_s", TIMEOUT_DEFAULT_S)
try:
    valid_timeout = not isinstance(timeout_s, bool) and isinstance(timeout_s, (int, float)) and math.isfinite(timeout_s) and timeout_s > 0
except OverflowError:
    valid_timeout = False
if not valid_timeout:
    die("ArgumentsBad", "timeout_s must be a finite positive number")
keep = args.get("keep", False)
if not isinstance(keep, bool):
    die("ArgumentsBad", "keep must be true or false")
daemon = os.environ.get("AOS_DAEMON")
if not daemon:
    die("DaemonMissing", "AOS_DAEMON is not set (this tool starts its child on the daemon that runs you)")
daemon = os.path.realpath(daemon)
stack = os.environ.get("AOS_STACK")
if not stack:
    die("StackMissing", "AOS_STACK is not set")
ws = tool_io.workspace()
definition = os.path.realpath(source if os.path.isabs(source) else os.path.join(ws, source))
if not os.path.isdir(definition):
    die("DefMissing", "the child definition %s is missing" % definition)
kids_dir = os.path.join(stack, "children")


def rel(p):
    """子的 stack 相對管我的 daemon（portable-flow 的相對路徑規矩）。"""
    r = os.path.relpath(p, daemon)
    return (p if r.startswith("..") else r).rstrip("/") + "/"


def forget(name):
    global running_kid
    try:
        for f in os.listdir(os.path.join(kids_dir, name)):
            os.remove(os.path.join(kids_dir, name, f))
        os.rmdir(os.path.join(kids_dir, name))
        if name == running_kid:
            running_kid = None
    except OSError:
        pass


def mark(name, state):
    global running_kid
    write_text(os.path.join(kids_dir, name, "state"), state + "\n")
    if name == running_kid and state in ("kept", "failed"):
        running_kid = None


def renew(seconds):
    now = datetime.now(timezone.utc)
    ceiling = datetime.max.replace(tzinfo=timezone.utc, microsecond=0)
    until = now + timedelta(seconds=min(seconds, (ceiling - now).total_seconds() - 1))
    mark(running_kid, "running " + until.strftime("%Y-%m-%dT%H:%M:%SZ"))


def lease_active(state):
    if len(state) != 2 or state[0] != "running":
        return False
    try:
        until = datetime.strptime(state[1], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return until > datetime.now(timezone.utc)
    except ValueError:
        return False


def mtime(name):
    """紀錄資料夾的修改時間；別的 thought 剛刪掉＝0。"""
    try:
        return os.path.getmtime(os.path.join(kids_dir, name))
    except OSError:
        return 0


def reconcile(table):
    """children/ 對 daemon 表：未到期租約不碰；不在表上的忘掉；過期 running 先停，failed 超過 FAILED_KEEP 隻＝最舊的 ctl rm。"""
    try:
        names = sorted(os.listdir(kids_dir))
    except FileNotFoundError:
        return
    failed = []
    for n in names:
        state_missing = False
        age = mtime(n)
        try:
            with open(os.path.join(kids_dir, n, "state"), encoding="utf-8") as f:
                st = f.read().split()
        except OSError:
            st = []
            state_missing = not os.path.exists(os.path.join(kids_dir, n, "state"))
        if lease_active(st):
            continue                            # 另一個 thought 正在用，可能還沒上表
        if state_missing and time.time() - age < STEP_S:
            continue                            # 剛 mkdir、state 還沒寫的那一瞬
        if n not in table:
            forget(n)
            continue
        if st[:1] == ["kept"]:
            continue
        if st[:1] in (["running"], ["failed"]) and table.get(n) != "stopped":   # 已停的不再寄 stop
            _, err = agent(["ctl", "stop", "--target", n])
            if err:
                tool_io.warn("could not stop the abandoned thought %s: %s %s" % ((n,) + err))
        if st[:1] == ["running"]:                # 租約過了＝主人死在半路
            mark(n, "failed")
        failed.append((age, n))
    for _, n in sorted(failed)[:max(0, len(failed) - FAILED_KEEP + 1)]:   # 留 FAILED_KEEP-1 隻，加上這次最多 FAILED_KEEP
        _, err = agent(["ctl", "rm", n])
        if err is None:
            forget(n)
        else:
            tool_io.warn("could not remove the old failed thought %s: %s %s" % ((n,) + err))


# ---- 我是誰、深度 ----
me = json.loads(must(["ctl", "who", "--json"]))
try:
    depth = int(os.environ.get("AOS_THOUGHT_DEPTH", "0"))
except ValueError:
    die("ArgumentsBad", "AOS_THOUGHT_DEPTH must be a non-negative integer")
if depth < 0:
    die("ArgumentsBad", "AOS_THOUGHT_DEPTH must be a non-negative integer")
if depth >= MAX_DEPTH:
    die("DepthExceeded", "you are a thought at depth %d; at most %d levels of thoughts (do this step yourself)" % (depth, MAX_DEPTH))
if endpoint is None:                            # 預設同父：只抄 endpoint 這一鍵；父沒宣告 llm 或沒寫＝範本自己的預設
    out, err = agent(["llm", "--target", me["name"], "show"])
    if err is not None and err[0] != "LlmMissing":   # 讀不到父的腦（沙箱裡看不到父的定義等）＝報錯，不默默換成範本預設（11-06，no-pid 13 邊緣 2）
        die(err[0], "%s (cannot read your brain settings, so the helper cannot use the same brain; give endpoint to choose one)" % err[1])
    if err is None:
        for line in out.splitlines():
            if line.startswith("endpoint="):
                endpoint = line[len("endpoint="):].strip() or None

mine = None                                     # tools 沒給 path＝照抄我自己工具箱裡同名那支（aos-agent tools ls --json）
if any(t.get("path") is None for t in (tools or [])):
    mine = {t.get("name"): t.get("path") for t in json.loads(must(["tools", "--target", me["name"], "ls", "--json"]) or "[]")
            if isinstance(t, dict)}
tool_list = []
for t in tools or []:
    if t.get("path") is None:
        if not mine.get(t["name"]):
            die("ToolMissing", "tools: %s has no path and you have no tool of that name (yours: %s)" % (t["name"], ", ".join(sorted(mine)) or "-"))
        tool_list.append((t["name"], mine[t["name"]]))
    else:
        tool_list.append((t["name"], os.path.realpath(t["path"] if os.path.isabs(t["path"]) else os.path.join(ws, t["path"]))))

# ---- 唯一子名、掛上 ----
rows = json.loads(must(["ctl", "ls", "--json"]) or "[]")
table = {r.get("name"): r.get("phase") for r in rows if isinstance(r, dict)} if isinstance(rows, list) else {}   # 名字 → phase
reconcile(table)
try:
    os.makedirs(kids_dir, exist_ok=True)
except OSError as e:
    die("MkdirFailed", "cannot create %s: %s" % (kids_dir, e))
for attempt in range(5):
    now = datetime.now(timezone.utc)
    stamp = now.strftime("%Y%m%dT%H%M%S") + "%03d" % (now.microsecond // 1000)
    kid = "t-%s-%s-%s" % (me["name"][:32], stamp, secrets.token_hex(2))
    if kid in table:
        continue
    try:
        os.mkdir(os.path.join(kids_dir, kid))
        running_kid = kid
        renew(STEP_S + 5)
        break
    except FileExistsError:
        continue
    except OSError as e:
        die("MkdirFailed", "cannot create %s: %s" % (os.path.join(kids_dir, kid), e))
else:
    die("MkdirFailed", "could not create a unique child record after 5 attempts")
out, err = agent(["ctl", "add", "--name", kid, "--ws", ws, "--envs", "AOS_THOUGHT_DEPTH=%d" % (depth + 1), definition])
if err:
    if err[0] in ("DaemonMissing", "DaemonFailed"):
        mark(kid, "failed")
    else:
        forget(kid)
        running_kid = None
    die(*err)
kid_stack = out.strip().splitlines()[-1] if out.strip() else ""


def undo(err, what):
    """設定沒上：收回子再報錯（不是子的失敗，不留 stack）。"""
    _, err2 = agent(["ctl", "rm", kid])
    if err2 is None:
        forget(kid)
    die(err[0], "%s (during %s; %s)" % (err[1], what, "rolled back: removed %s" % kid if err2 is None
                                         else "rollback failed too: %s %s" % err2))


if not os.path.isdir(kid_stack):
    undo(("CommandFailed", "aos-agent ctl add printed no stack folder: %r" % kid_stack), "ctl add")
steps = [("llm set endpoint", ["llm", "--target", kid, "set", "endpoint=%s" % endpoint])] if endpoint else []
if tools is not None:                          # 沒給＝保留定義的工具；明給才改宣告過的覆蓋層
    out, err = agent(["tools", "--target", kid, "ls", "--json"])
    if err:
        undo(err, "tools ls")
    try:
        listed = json.loads(out or "[]")
    except ValueError:
        undo(("CommandFailed", "aos-agent tools ls --json did not print JSON"), "tools ls")
    wanted = {t for t, _ in tool_list}
    steps += [("tools rm " + t["name"], ["tools", "--target", kid, "rm", t["name"]])
              for t in listed if isinstance(t, dict) and t.get("name") not in wanted]
    steps += [("tools add " + t, ["tools", "--target", kid, "add", "--override", t, p]) for t, p in tool_list]
for what, argv in steps:
    _, err = agent(argv)
    if err:
        undo(err, what)

# ---- 問、收 ----
text = OPENING.format(n=max_chars, goal=goal.strip())
if context:
    text += "\n\nContext:\n" + "\n".join("- " + c.strip() for c in context)
_, err = agent(["say", "--target", kid], text=text)
answer = None
if err is None:
    if timeout_ticks is not None:
        answer, err = agent(["listen", "--target", kid, "--timeout-ticks", str(timeout_ticks)], timeout_ticks=timeout_ticks + 30)
    else:
        answer, err = agent(["listen", "--target", kid, "--timeout-s", "%g" % timeout_s], timeout_s=timeout_s + 30)
if err:                                         # 子答不出：先停、stack 一律留（不管 keep）
    agent(["ctl", "stop", "--target", kid])
    mark(kid, "failed")
    die(err[0], "%s (details: %s)" % (err[1], rel(kid_stack)))
answer = answer.strip()
if len(answer) > max_chars:
    answer = answer[:max_chars].rstrip() + " [truncated]"
if keep:                                        # 留著也不佔 loop：答完就 ctl stop（stack 在；要追問＝ctl start＋say，11-05 夜第二輪邊緣）
    _, err = agent(["ctl", "stop", "--target", kid])
    mark(kid, "kept")
    if err:
        tool_io.warn("could not stop the kept thought %s: %s %s" % ((kid,) + err))
    sys.stdout.write("%s\ndetails: %s\n" % (answer, rel(kid_stack)))
    sys.exit(0)
_, err = agent(["ctl", "rm", kid])
if err is None:
    forget(kid)
else:
    mark(kid, "failed")
    tool_io.warn("could not remove the finished thought %s: %s %s" % ((kid,) + err))
sys.stdout.write(answer + "\n")
sys.exit(0)
