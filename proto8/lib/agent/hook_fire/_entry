#!/usr/bin/env python3
# hook_fire - 發 after_start／after_stop 事件：agent 範本 loop.json 的 on_start／on_stop 叫它（hook_fire EVENT DEF_DIR，$AOS_STACK＝agent 的 stack）。
# 使用者 11-11：hook 要加的事件選「起來與停下」、掛哪層選「aos-loop 自己加」——aos-loop 只跑被指定的東西（C-52），這支才認得 hook（lib/agent/hooks.py）。
# after_stop 的事件 JSON 多 code（$AOS_LOOP_CODE，aos-loop 給的要退的碼）、signal（$AOS_LOOP_SIGNAL，沒有＝null）。沒有這個事件的 hook＝什麼都不做、退 0。
# 錯：stderr 一行「hook_fire: error: 代號 原因」、退 1（HookFailed＝on_error stop 的 hook 失敗、HooksBad、ArgumentsBad、StackMissing）；
# aos-loop 只把它當一行 warning，不擋 agent 起停。on_error continue 的 hook 失敗＝一行 warning。--help 印英文用法。
import os, signal, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path[:0] = [os.path.dirname(HERE)]          # lib/agent：hooks.py、agent_files.py
import hooks  # noqa: E402

NAME = "hook_fire"
HELP = """usage: hook_fire EVENT DEF_DIR   (EVENT: after_start | after_stop; $AOS_STACK = the agent's stack)
Fire the hooks of an agent for EVENT (the agent definition DEF_DIR, its stack copy on top).
Meant for the on_start / on_stop keys of an agent's loop.json. after_stop also gets code
($AOS_LOOP_CODE) and signal ($AOS_LOOP_SIGNAL, null when none) in the event JSON.
exit codes: 0 done (also when no hook listens); 1 error ("hook_fire: error: CODE reason").
"""
EVENTS = ("after_start", "after_stop")


def die(code, why):
    sys.stderr.write("%s: error: %s %s\n" % (NAME, code, why))
    sys.exit(1)


def number(key):
    v = os.environ.get(key, "")
    return int(v) if v.lstrip("-").isdigit() else None


def main():
    signal.signal(signal.SIGINT, lambda s, f: sys.exit(130))
    args = sys.argv[1:]
    if args[:1] in (["-h"], ["--help"]):
        sys.stdout.write(HELP)
        return 0
    if len(args) != 2 or args[0] not in EVENTS:
        die("ArgumentsBad", "give EVENT (%s) and DEF_DIR (usage: hook_fire EVENT DEF_DIR)" % " or ".join(EVENTS))
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "AOS_STACK is not set")
    data = {} if args[0] == "after_start" else {"code": number("AOS_LOOP_CODE"), "signal": number("AOS_LOOP_SIGNAL")}
    try:
        hooks.fire(args[0], data, args[1], stack, warn=lambda line: sys.stderr.write("%s: warning: %s\n" % (NAME, line)))
    except (hooks.HookFailed, hooks.HooksBad) as e:
        die(type(e).__name__, str(e))
    return 0


sys.exit(main())
