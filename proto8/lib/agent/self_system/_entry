#!/usr/bin/env python3
# self_system - aos-agent system 的包裝，目標改成叫我的那隻自己：get、set、reset；改的是那隻 stack 裡自己那份 system 文字，定義不動
# 使用者 11-11：「然後我們現在的工具沒辦法讓agent修改自身的system prompt，幫我看看是不是要添加一個self_settings工具，或是整合進self_history。……」
#   選項框裁：單獨一支工具、名字 self_system、「fsm 取代、eca 附加」、「只給 reset、不擋」（thinking 2026-11/11/self-system）。
#   原則同 self_llm（純包裝、不多給、不多擋：腦把自己的 system 改壞屬自行承擔）。**對應關係**：aos-agent system 加了動作或旗標，這支要跟著加（參數一對一）。
# 介面（lib/README 的契約）：stdin 收 {"op": "get"|"set"|"reset", …}；別的鍵＝ArgumentsBad：
#   get {long?}   ＝system get（印目前生效的全文）；long: true＝system get -l（第一行 FROM TAB FILE）
#   set {text}    ＝system set（text 從 stdin 交給它；空字串也收）
#   reset {}      ＝system reset -y（腦叫了就算確認過）
#   先 aos-agent ctl who（$AOS_STACK＝<agent stack>/tools/self_system/ 查 daemon 表）認出是哪隻；aos-agent 在 $AOS_WS 跑。
#   結果：下層 stdout 原樣；下層的提醒行（畫面開著、空文字）也印進 stdout 給腦看；set／reset 多一句何時生效。
#   錯：同 self_llm（stderr 與 stdout 各一行「self_system: error: 代號 原因」、退 1；下層最後一行錯誤行的代號與原因接上，C-52 例外 ⑤；
#   沒那行才是 CommandFailed）。只在 daemon 下跑的 agent 能用。
# 需要 PATH 上有 aos-agent（proto8/install.sh）。每次叫 aos-agent 最多 60 秒；被外面 TERM 時先收掉它再走（lib 契約規則 5）。
import json, os, re, signal, subprocess, sys
HELP = """\
usage: self_system < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
See or change the system text of the agent that calls me (its own copy, not its definition):
op get | set | reset (aos-agent system with the target = me). Changes apply from your next brain call.
Result on stdout. On error: one line "self_system: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "self_system"
tool_io.start(NAME, HELP)
TIMEOUT_S = 60
ERR_RE = re.compile(r"aos-[a-z-]+: error: ([A-Z][A-Za-z]+) (.*)\Z")
WARN_RE = re.compile(r"aos-agent: warning: (.*)\Z")
child = None
notes = []


die = tool_io.die


def on_term(signum, frame):
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            pass
    sys.exit(128 + signum)


workspace = tool_io.workspace
arguments = tool_io.arguments


def agent(*args, text=None):
    """aos-agent args…（text＝給它的 stdin）：stderr 原樣往上；退非 0＝它最後一行錯誤行的代號與原因當自己的錯（沒有＝CommandFailed）。回 stdout。"""
    global child
    try:
        child = subprocess.Popen(["aos-agent"] + list(args), stdin=subprocess.DEVNULL if text is None else subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True,
                                 cwd=workspace())
    except OSError as e:
        die("LaunchFailed", "cannot run aos-agent (put it on PATH with proto8/install.sh): %s" % e)
    try:
        out, err = child.communicate(text, timeout=TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        child.communicate()
        die("CommandFailed", "aos-agent %s took over %d s and was killed" % (" ".join(args[:2]), TIMEOUT_S))
    if err:                                     # 下層的 stderr 原樣透出（R10）
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
        notes.extend(m.group(1) for m in map(WARN_RE.match, err.splitlines()) if m)   # 腦只看 stdout：提醒也給它
    if child.returncode != 0:                   # 給腦用的工具把下層錯翻成自己的錯（同 self_llm）
        mine = [m for m in map(ERR_RE.match, err.splitlines()) if m]
        if mine:
            die(mine[-1].group(1), mine[-1].group(2))
        die("CommandFailed", "aos-agent %s exited %d" % (" ".join(args[:2]), child.returncode))
    return out


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)          # Ctrl-C：同 TERM，退 130、不吐 traceback（R12）
args = arguments()
OPS = {"get": ("long",), "set": ("text",), "reset": ()}
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (%s)" % ", ".join(OPS))
if op not in OPS:
    die("OpUnknown", "op must be one of %s (got %r)" % (", ".join(OPS), op))
extra = sorted(k for k in args if k != "op" and k not in OPS[op])
if extra:
    die("ArgumentsBad", "op %s does not take %s (it takes %s)" % (op, ", ".join(extra), ", ".join(OPS[op]) or "nothing else"))

cmd, given = ["system", "--target", None, op], None
if op == "set":
    given = args.get("text")
    if not isinstance(given, str):
        die("ArgumentsBad", "set needs text: the whole new system text as a string (\"\" = none)")
    cmd += ["-"]
elif op == "get":
    if args.get("long"):
        cmd += ["-l"]
elif op == "reset":
    cmd += ["-y"]

cmd[2] = agent("ctl", "who").strip()
notes.clear()                                   # ctl who 的提醒不算這次的
out = agent(*cmd, text=given)
if out:
    sys.stdout.write(out if out.endswith("\n") else out + "\n")
for line in notes:
    print("(%s)" % line)
if op in ("set", "reset"):
    print("(takes effect from your next brain call; the prompt cache misses once)")
