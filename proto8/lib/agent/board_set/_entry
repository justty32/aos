#!/usr/bin/env python3
# board_set - aos-comm board set 的包裝，目標＝叫我的那隻 agent 的根（05 A2：工具小格 <root>/tools/board_set 認回 <root>，aos-comm 照 $AOS_STACK 認）：整張換掉自己的布告欄。
# 圖紙：proto8/thinking/2026-11/14/board-1114/ 02 §5.1（整張換掉、waiting_on 保留；dnd 沒給到期 2h、away 12h）；純包裝（同 mailbox_*）。
# 介面：stdin {mode, text?, doing?, back_in? | back_at?, back_text?, expires_in? | expires_at?, accept?, allow_from?, wake_on_urgent?, deputy?, clear_on_start?}。結果：寫好的整張（一行 JSON）。
import json, os, signal, sys
NAME = "board_set"
HELP = """\
usage: board_set < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Replace my whole board (aos-comm board set; the board is <my stack>/board.json): fields not given are cleared,
waiting_on is kept. dnd without an expiry expires in 2h, away in 12h.
Result on stdout. On error: one line "board_set: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib（含 lib/agent 的 cmd_call），再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

tool_io.start(NAME, HELP)
signal.signal(signal.SIGINT, lambda s, f: sys.exit(130))
import cmd_call  # noqa: E402

cmd_call.catch_signals((signal.SIGTERM,))
args = tool_io.arguments("mode")
for a, b in (("back_in", "back_at"), ("expires_in", "expires_at")):
    if args.get(a) and args.get(b):
        tool_io.die("ArgumentsBad", "give %s or %s, not both" % (a, b))
more = ["board", "set", "-j"]
for key, flag in (("doing", "--doing"), ("back_in", "--back"), ("back_at", "--back"), ("back_text", "--back-text"),
                  ("expires_in", "--for"), ("expires_at", "--for"), ("accept", "--accept"), ("deputy", "--deputy")):
    if args.get(key):
        more += [flag, args[key]]
if args.get("allow_from"):
    more += ["--allow-from", ",".join(args["allow_from"])]
if args.get("wake_on_urgent"):
    more.append("--wake")
if args.get("clear_on_start"):
    more.append("--clear-on-start")
more += ["--", args["mode"]] + ([args["text"]] if args.get("text") else [])   # -- 在位置參數前：text 開頭是 - 也照字面
_, out, _ = cmd_call.call("aos-comm", more)
print("board written (others read it with board_read; take it down with board_clear):")
print(json.dumps(json.loads(out), ensure_ascii=False))
