#!/usr/bin/env python3
# claude - 透過 tool_io 收 JSON／旗標，再把 prompt 交給 claude CLI；對話續在工具小格（$AOS_STACK）
# 介面（lib/README 的契約）：stdin 收 {"prompt"}；錯：stderr 與 stdout 各一行「claude: error: 代號 原因」、退 1（ArgumentsBad、CliMissing、CliFailed、SessionBad…）。
# 怎麼叫 CLI（旗標、逾時 timeout_ms）在同資料夾的 cli.json；做法在 proto8/lib/agent/cli_session.py 與同層 cli_*.py（claude、codex 共用）。
# 工具形開頭走 agent_tool.ask_cli 的 tool_io；aos-eca-turn --one 照舊用 cli_ask.call_main，兩者共用 cli_ask.ask。
# 共用模組先找工具自己，再找 lib/agent（標準 Python 路徑也可提供 lib）。
import os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
    try:
        import agent_tool
    except ModuleNotFoundError as error:
        if error.name != "agent_tool":
            raise
        import agent.agent_tool as agent_tool
except ModuleNotFoundError as error:   # 共用模組找不到：照此工具的錯誤通道退 1
    _shared = ("agent_tool", "agent_files", "cli_base", "cli_cfg", "cli_mcp", "cli_cell", "cli_print", "cli_ask", "cli_hook", "cli_screen")
    if error.name not in {"tool_io", "agent", *_shared, *("agent." + n for n in _shared)}:
        raise
    _module = "agent_tool" if error.name == "agent" else (error.name or "shared module").rsplit(".", 1)[-1]
    _line = "%s: error: ModuleMissing %s.py not in the tool folder, not in lib/, not on the Python path\n" % (os.path.basename(HERE), _module)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "claude"
HELP = """\
usage: %(name)s < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_STACK is its cell)
Hand the prompt to the %(name)s CLI and print its answer; the conversation goes on in this
tool's cell (session.txt), and a person can attach to its screen (aos-agent attach).
How the CLI is called (flags, timeout_ms, tools) is in cli.json next to _entry.
Result on stdout. On error: one line "%(name)s: error: CODE reason" on stderr and stdout, exit 1
(the CLI's own stderr is passed through to stderr).
""" % {"name": NAME}
agent_tool.ask_cli(HERE, NAME, HELP)
