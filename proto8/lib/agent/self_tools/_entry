#!/usr/bin/env python3
# self_tools - 讓叫我的 agent 改自己的工具箱：加（add）、拿掉（rm）、列（ls）；改的是那隻的覆蓋層，定義不動
# 使用者 11-05 午：「讓agent給自己改tool」。規劃：proto8/thinking/2026-11/05/feat-proto/01-self-tools.md。
# 介面（lib/README 的契約）：stdin 收 {"op": "add"|"rm"|"ls", "name"?, "path"?, "override"?}；
#   先 aos-agent ctl who（拿 $AOS_STACK＝<agent stack>/tools/self_tools/ 查 daemon 表，C-52 經機制看上層、不爬路徑）認出是哪隻，
#   再 aos-agent tools --target <那隻> add [--override] <name> <絕對路徑>／rm <name>／ls --json。下一格 brain 重讀就看到新清單。
#   path：相對路徑從 $AOS_WS 算、解開 .. 與捷徑後要在工作區或 lib/ 裡（工作區裡指到庫的捷徑也收）；絕對路徑要在 lib/（這個工具所在的庫）底下；其他＝PathBad。
#   結果：add／rm 印一句（下一題起生效）、ls 印 aos-tools ls --json 那一行。
#   錯：stderr 與 stdout 各一行「self_tools: error: 代號 原因」、退 1；aos-agent（與它轉的 aos-tools）的 stderr 原樣透到 stderr；
#   它退非 0＝把它 stderr 裡最後一行錯誤行 `aos-…: error: 代號 原因` 的代號與原因接在 `self_tools: error: ` 後面給腦（給腦用的工具把下層錯
#   翻成自己的錯，同 agents；例 ToolExists、ToolMissing、PathMissing），沒那行才是 CommandFailed＋結束碼。op 沒給＝ArgumentsBad、不認得＝OpUnknown（R11）。
#   沒掛在 daemon 下跑的 agent（aos-exec body.json）不支援：ctl who 失敗＝aos-agent 的 DaemonMissing／InstanceMissing。
#   --help＝英文說明印 stdout、退 0；Ctrl-C 同 TERM（先收掉 aos-agent，退 130）。
# 需要 PATH 上有 aos-agent（proto8/install.sh）。每次叫 aos-agent 最多 60 秒；被外面 TERM 時先收掉它再走（lib 契約規則 5）。
import json, os, re, shutil, signal, subprocess, sys
HELP = """\
usage: self_tools < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Change the tool box of the agent that calls me (its overlay, not its definition):
op add | rm | ls. Changes apply from the next turn.
Arguments: one JSON object on stdin (empty stdin = {}):
  op        string (add | rm | ls), required
  name      string
  path      string
  override  boolean
Result on stdout. On error: one line "self_tools: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(os.path.dirname(HERE))]   # tool_io.py：先找自己資料夾、再找 lib/（lib/docs/01 規則 9）
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "lib"))   # 複製出 repo 的：從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/lib/
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError:   # 規則 9 三處都找不到（11-05 晚）：照錯誤行格式印一行、退 1，不吐 traceback
    _line = "%s: error: ModuleMissing tool_io.py not found (not in the tool folder, not in lib/, no aos-tools on PATH)\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "self_tools"
tool_io.start(NAME, HELP)
TIMEOUT_S = 60
ERR_RE = re.compile(r"aos-[a-z-]+: error: ([A-Z][A-Za-z]+) (.*)\Z")
LIB = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))   # proto8/lib
child = None


die = tool_io.die


def on_term(signum, frame):
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            pass
    sys.exit(128 + signum)


workspace = tool_io.workspace
arguments = tool_io.arguments


def tool_path(p):
    """相對＝從工作區算、不能出工作區；絕對＝要在 lib/ 底下（照抄庫的工具）。回解開後的絕對路徑。"""
    if os.path.isabs(p):
        real = os.path.realpath(p)
        if os.path.commonpath([LIB, real]) != LIB:
            die("PathBad", "%s is an absolute path outside the tool library %s; give a path relative to the workspace, or one under %s" % (p, LIB, LIB))
        return real
    root = workspace()
    real = os.path.realpath(os.path.join(root, p))
    if os.path.commonpath([root, real]) != root and os.path.commonpath([LIB, real]) != LIB:   # 工作區裡指向 lib/ 的捷徑也收（11-05 晚）
        die("PathBad", "%s resolves to %s, outside the workspace and the tool library %s" % (p, real, LIB))
    return real


def agent(*args):
    """aos-agent args…：stderr 原樣往上；退非 0＝它最後一行錯誤行的代號與原因當自己的錯（沒有＝CommandFailed）。回 stdout。"""
    global child
    try:
        child = subprocess.Popen(["aos-agent"] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE, text=True, start_new_session=True)
    except OSError as e:
        die("LaunchFailed", "cannot run aos-agent (put it on PATH with proto8/install.sh): %s" % e)
    try:
        out, err = child.communicate(timeout=TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        child.communicate()
        die("CommandFailed", "aos-agent %s took over %d s and was killed" % (" ".join(args[:2]), TIMEOUT_S))
    if err:                                     # 下層的 stderr 原樣透出（R10）
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    if child.returncode != 0:                   # 給腦用的工具把下層錯翻成自己的錯（同 agents）
        mine = [m for m in map(ERR_RE.match, err.splitlines()) if m]
        if mine:
            die(mine[-1].group(1), mine[-1].group(2))
        die("CommandFailed", "aos-agent %s exited %d" % (" ".join(args[:2]), child.returncode))
    return out


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)          # Ctrl-C：同 TERM，退 130、不吐 traceback（R12）
args = arguments()
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (add, rm or ls)")
if op not in ("add", "rm", "ls"):
    die("OpUnknown", "op must be one of add, rm, ls (got %r)" % (op,))
name = args.get("name")
if op in ("add", "rm") and (not isinstance(name, str) or not name):
    die("ArgumentsBad", "%s needs name (a string)" % op)
override = args.get("override", False)
if not isinstance(override, bool):
    die("ArgumentsBad", "override must be true or false")
if op == "add":
    if not isinstance(args.get("path"), str) or not args["path"]:
        die("ArgumentsBad", "add needs path (a string: relative to the workspace, or absolute under %s)" % LIB)
    path = tool_path(args["path"])

me = agent("ctl", "who").strip()
if op == "ls":
    sys.stdout.write(agent("tools", "--target", me, "ls", "--json"))
elif op == "add":
    agent("tools", "--target", me, "add", *(["--override"] if override else []), name, path)
    print("added %s (%s) to your tools; available from your next turn" % (name, path))
else:
    agent("tools", "--target", me, "rm", name)
    print("removed %s from your tools; gone from your next turn" % name)
