def line(kind, text):
    report.append("%-5s %s" % (kind, text))


def from_ws(p):
    return os.path.normpath(p if os.path.isabs(p) else os.path.join(tool_io.workspace(), p))


def text(key):
    v = args.get(key)
    if not isinstance(v, str) or not v:
        die("ArgumentsBad", "%s %s a non-empty string" % (key, "needs" if v is None else "must be"))
    return v


def run(argv, cwd, stdin="", timeout=RUN_S):
    """跑一次、整群逾時收掉；回 (結束碼, stdout, stderr)，起不來＝(None, "", 原因)。"""
    try:
        p = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, start_new_session=True, env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"))
    except OSError as e:
        return None, "", "cannot run %s: %s" % (argv[0], e)
    try:
        out, err = p.communicate(stdin, timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        return None, "", "%s did not finish within %d s" % (" ".join(argv[:2]), timeout)
    return p.returncode, out, err


def last_line(*texts):
    """最後一行有字的；Python traceback 另補它在腳本的哪一行。"""
    for t in texts:
        if "Traceback (most recent call last)" in (t or ""):
            spots = re.findall(r'File "([^"]+)", line (\d+)', t)
            mine = [x for x in spots if "/lib/" not in x[0] and "/python3" not in x[0]] or spots
            tail = [x for x in t.strip().splitlines() if x.strip()][-1]
            return "%s (%s line %s)" % (tail, os.path.basename(mine[-1][0]), mine[-1][1]) if mine else tail
        lines = [x for x in (t or "").strip().splitlines() if x.strip()]
        if lines:
            return lines[-1]
    return "no output"


# ---- 位置 ----
def locate(location):
    """位置字串 → dict：kind（dir／obj）、path（資料夾或 JSON 檔，絕對）、ptr、full（給 aos-exec／tool_spec 的整串）、
    base（腳本相對的資料夾＝aos-exec 的 cwd）、name（資料夾名；物件＝指標最後一段或檔名去 .json）。"""
    try:
        path, ptr = tool_spec.split_location(location)
    except tool_spec.SpecBad as e:
        die("ArgumentsBad", str(e))
    path = from_ws(path)
    obj = ptr is not None or (path.endswith(".json") and not os.path.isdir(path))
    if not obj:
        return {"kind": "dir", "path": path, "ptr": None, "full": path, "base": path, "name": os.path.basename(path.rstrip("/"))}
    name = ptr.rstrip("/").rsplit("/", 1)[-1].replace("~1", "/").replace("~0", "~") if ptr else \
        os.path.splitext(os.path.basename(path))[0]
    return {"kind": "obj", "path": path, "ptr": ptr, "full": path + ("#" + ptr if ptr is not None else ""),
            "base": os.path.dirname(path), "name": name}


def key_at(loc, key):
    return "%s#%s/%s" % (loc["path"], (loc["ptr"] or "").rstrip("/"), key)


def aos_json(argv, what):
    code, out, err = run(["aos-json"] + argv, None)
    if code != 0:
        die("WriteFailed", "cannot write %s: %s" % (what, last_line(err, out) if code is not None else err))


def object_exists(loc):
    if not os.path.isfile(loc["path"]):
        return False
    if loc["ptr"] is None:
        return True
    return run(["aos-json", "get", loc["full"]], None)[0] == 0


def ensure_json_file(loc):
    """JSON 檔不在＝建一份 {}（資料夾一起建）。"""
    if os.path.exists(loc["path"]):
        return
    try:
        os.makedirs(loc["base"], exist_ok=True)
        with open(loc["path"], "w", encoding="utf-8") as f:
            f.write("{}\n")
    except OSError as e:
        die("MkdirFailed", "cannot create %s: %s" % (tool_io.place(loc["path"]), tool_io.os_reason(e)))


def copy_script(dest, desc=None):
    """骨架的 tool.py 抄到 dest（description＝先填進 DESCRIPTION）。"""
    with open(os.path.join(SKELETON, "tool.py"), encoding="utf-8") as f:
        src = f.read().splitlines(keepends=True)
    if desc is not None:
        src = ["DESCRIPTION = %r\n" % desc.strip() if x.startswith("DESCRIPTION = ") else x for x in src]
    try:
        with open(dest, "w", encoding="utf-8") as f:
            f.write("".join(src))
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (tool_io.place(dest), tool_io.os_reason(e)))


def part_to_change(script):
    with open(script, encoding="utf-8") as f:
        return f.read().split(MARK, 1)[-1].strip("\n")


def new_object(loc, desc):
    """new 進 JSON 物件：物件寫 _entry 鍵（["python3", "<名>.py"]），腳本放 JSON 檔旁邊，再 --write-defs 進物件。"""
    script = os.path.join(loc["base"], loc["name"] + ".py")
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", loc["name"]):
        die("ArgumentsBad", "tool name %r (the last part of the pointer, or the file name) may use only A-Z a-z 0-9 _ -" % loc["name"])
    if loc["ptr"] is None and os.path.exists(loc["path"]):
        die("PathExists", "%s already exists (give a new JSON file, or FILE.json#/POINTER to a new key)" % args["path"])
    if loc["ptr"] is not None and object_exists(loc):
        die("PathExists", "%s already exists (pick a new key)" % args["path"])
    if os.path.lexists(script):
        die("PathExists", "%s already exists (the script would go there; pick another name)" % script)
    ensure_json_file(loc)
    copy_script(script, desc)
    aos_json(["set", "--parents", key_at(loc, "_entry"), json.dumps(["python3", loc["name"] + ".py"])], key_at(loc, "_entry"))
    code, out, err = run([sys.executable, script, "--write-defs", loc["full"]], loc["base"])
    if code != 0:
        die("WriteFailed", "made, but %s --write-defs failed: %s" % (os.path.basename(script), last_line(err, out)))
    shown = os.path.relpath(script, tool_io.workspace()) if not os.path.isabs(args["path"]) else script
    print("made tool %s: the object has _entry, _tooldef, _metainfo keys, and %s next to the JSON file runs it\n"
          "(a copy of the tool-python skeleton: a working tool that adds two numbers).\n"
          "Next: in %s change only the part shown below (use edit; keep every line above it, they load tool_spec),\n"
          "then tools_def {\"op\": \"check\", \"path\": %s, \"sample\": {...}}.\n"
          "---- %s, the part to change ----\n%s" % (loc["full"], os.path.basename(script), shown, json.dumps(args["path"]),
                                                    shown, part_to_change(script)))


# ---- new ----
def op_new():
    desc = args.get("description")
    if desc is not None and (not isinstance(desc, str) or not desc.strip()):
        die("ArgumentsBad", "description must be a non-empty string")
    loc = locate(text("path"))
    if loc["kind"] == "obj":
        return new_object(loc, desc)
    literal = loc["path"]
    if os.path.lexists(literal):
        die("PathExists", "path %r already exists (pick a new folder)" % args["path"])
    dest = os.path.realpath(literal)
    parent = os.path.dirname(dest)
    try:
        os.makedirs(parent, exist_ok=True)
    except OSError as e:
        die("MkdirFailed", "cannot create %s: %s" % (tool_io.place(parent), tool_io.os_reason(e)))
    tmp = os.path.join(parent, ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    try:
        try:
            shutil.copytree(SKELETON, tmp, ignore=shutil.ignore_patterns("__pycache__"))
            if desc is not None:
                script = os.path.join(tmp, "tool.py")
                with open(script, encoding="utf-8") as f:
                    src = f.read().splitlines(keepends=True)
                src = ["DESCRIPTION = %r\n" % desc.strip() if x.startswith("DESCRIPTION = ") else x for x in src]
                with open(script, "w", encoding="utf-8") as f:
                    f.write("".join(src))
            os.rename(tmp, dest)
        except OSError as e:
            die("WriteFailed", "cannot copy the skeleton to %s: %s" % (tool_io.place(dest), tool_io.os_reason(e)))
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    code, out, err = run([sys.executable, "tool.py", "--write-defs"], dest)
    if code != 0:
        die("WriteFailed", "copied, but tool.py --write-defs failed: %s" % last_line(err, out))
    shown = args["path"]
    with open(os.path.join(dest, "tool.py"), encoding="utf-8") as f:
        part = f.read().split(MARK, 1)[-1].strip("\n")
    print("made tool folder %s (a copy of the tool-python skeleton: a working tool that adds two numbers; more in %s/README.md).\n"
          "Next: in %s/tool.py change only the part shown below (use edit; keep every line above it, they load tool_spec),\n"
          "then tools_def {\"op\": \"check\", \"path\": %s, \"sample\": {...}}.\n"
          "---- %s/tool.py, the part to change ----\n%s" % (dest, shown, shown, json.dumps(shown), shown, part))


# ---- check ----
def read_location(path, ptr):
    """位置 → (物件或 None, 基準資料夾)。資料夾＝None；JSON 檔／指標＝那個物件（指標經 aos-json get，不跟 $ref）。"""
    if ptr is None and os.path.isdir(path):
        return None, path
    base = os.path.dirname(path)
    if not os.path.isfile(path):
        die("PathMissing", "%s does not exist (give a tool folder, a JSON file or FILE.json#/POINTER)" % args["path"])
    if ptr is None:
        try:
            with open(path, encoding="utf-8") as f:
                obj = json.load(f)
        except (OSError, ValueError, UnicodeError) as e:
            die("FileBad", "cannot read %s as JSON: %s" % (args["path"], e))
    else:
        code, out, err = run(["aos-json", "get", "%s#%s" % (path, ptr)], base)
        if code != 0:
            die("PointerMissing" if code == 10 else "FileBad", "%s: %s" % (args["path"], last_line(err, out)))
        obj = json.loads(out)
    if not isinstance(obj, dict):
        die("FileBad", "%s is not a JSON object (a tool there is an object with _entry, _tooldef, _metainfo keys)" % args["path"])
    return obj, base


def script_of(argv, base):
    """argv 裡第一個 .py → 絕對路徑（相對從基準資料夾算＝aos-exec 跑它時的 cwd）。"""
    for a in argv:
        if isinstance(a, str) and a.endswith(".py"):
            return a if os.path.isabs(a) else os.path.join(base, a)
    return None


def check_entry(obj, base):
    """回 (能跑嗎, 腳本路徑或 None)。"""
    if obj is None:
        e1, e2 = os.path.join(base, "_entry"), os.path.join(base, "_entry.json")
        if os.path.isdir(e1):
            line("ok", "entry: _entry is a folder (aos-exec walks into it; not checked further)")
            return True, None
        if os.path.isfile(e1):
            with open(e1, "rb") as f:
                head = f.read(256)
            if head.startswith(b"#!") and os.access(e1, os.X_OK):
                line("ok", "entry: _entry is a program (%s)" % head.split(b"\n", 1)[0].decode("utf-8", "replace"))
                return True, (e1 if b"python" in head.split(b"\n", 1)[0] else None)
            if head.startswith(b"#!"):
                line("bad", "entry: _entry starts with #! but is not executable (fix: use _entry.json + tool.py like the skeleton)")
                return False, None
            where, f = "_entry", e1
        elif os.path.isfile(e2):
            where, f = "_entry.json", e2
        else:
            line("bad", "entry: no _entry or _entry.json in the folder (fix: start from tools_def op new)")
            return False, None
        try:
            with open(f, encoding="utf-8") as fh:
                value = json.load(fh)
        except (OSError, ValueError, UnicodeError) as e:
            line("bad", "entry: %s is not JSON: %s" % (where, e))
            return False, None
    else:
        if "_entry" in obj:
            where, value = "_entry key", obj["_entry"]
        elif "argv" in obj:
            where, value = "the object itself (it has argv)", obj
        else:
            line("bad", "entry: no _entry key (fix: add \"_entry\": [\"python3\", \"tool.py\"] with tool.py next to the JSON file)")
            return False, None
    argv = value.get("argv") if isinstance(value, dict) else value
    if isinstance(value, str):
        line("ok", "entry: %s points to %s (not followed)" % (where, value))
        return True, None
    if isinstance(value, dict) and "argv" not in value:
        line("ok", "entry: %s is an object without argv (aos-exec walks into it; not checked further)" % where)
        return True, None
    if not isinstance(argv, list) or not argv:
        line("bad", "entry: %s must be a non-empty argv list like [\"python3\", \"tool.py\"]" % where)
        return False, None
    script = script_of(argv, base)
    if script is None:
        line("ok", "entry: %s runs %s" % (where, json.dumps(argv)))
        return True, None
    if not os.path.isfile(script):
        line("bad", "entry: %s runs %s, but %s is missing" % (where, json.dumps(argv), script))
        return False, None
    try:
        with open(script, encoding="utf-8") as fh:
            compile(fh.read(), script, "exec")
    except SyntaxError as e:
        line("bad", "entry: %s line %s: %s (fix the Python syntax)" % (os.path.basename(script), e.lineno, e.msg))
        return False, None
    except (OSError, UnicodeError, ValueError) as e:
        line("bad", "entry: cannot read %s: %s" % (tool_io.place(script), tool_io.os_reason(e)))
        return False, None
    line("ok", "entry: %s runs %s (Python compiles)" % (where, json.dumps(argv)))
    return True, script


def regenerate(script, location, base):
    try:
        with open(script, encoding="utf-8") as fh:
            uses = "tool_spec" in fh.read()
    except (OSError, UnicodeError):
        uses = False
    if not uses:
        if os.path.isfile(os.path.join(os.path.dirname(script), "_entry.json")) and os.path.basename(script) == "tool.py":
            line("bad", "defs: tool.py does not use tool_spec any more, so nothing describes it (fix: keep the setup lines "
                 "of the skeleton and write DESCRIPTION, PARAMS, META, def run(args) and the last line ts.main(...); see README.md)")
            return False
        line("note", "defs: %s does not use tool_spec; _tooldef and _metainfo are kept by hand" % os.path.basename(script))
        return True
    code, out, err = run([sys.executable, script, "--write-defs", location], base)
    if code != 0:
        line("bad", "made: %s --write-defs failed: %s" % (os.path.basename(script), last_line(err, out) if code is not None else err))
        return False
    line("made", "_tooldef and _metainfo from %s" % os.path.basename(script))
    return True


EXAMPLE_RE = re.compile(r"Example:\s*(\{[^\n]*?\})\s*->\s*([^\n]+)")


def same(got, want):
    """結果與說明裡的例子一樣嗎：字面相同，或兩邊都是數字且相等（42 與 42.0）。"""
    if got == want or got == want.strip("`'\""):
        return True
    try:
        return float(got) == float(want.strip("`'\""))
    except ValueError:
        return False


def skeleton_description():
    try:
        with open(os.path.join(SKELETON, "_tooldef.json"), encoding="utf-8") as f:
            return json.load(f).get("description")
    except (OSError, ValueError):
        return None


def load_part(obj, base, key):
    """資料夾的 key.json 或物件的 key；回 (在不在, 值)；讀不了＝bad 一行、(True, None)。"""
    if obj is not None:
        return (key in obj), obj.get(key)
    f = os.path.join(base, key + ".json")
    if not os.path.isfile(f):
        return False, None
    try:
        with open(f, encoding="utf-8") as fh:
            return True, json.load(fh)
    except (OSError, ValueError, UnicodeError) as e:
        line("bad", "%s: cannot read %s.json: %s" % (key[1:], key, e))
        return True, None


def load_tooldef(obj, base, mi):
    """tooldef 兩處（11-12 metainfo，N-69 推薦讀法、11-12 M20）：_metainfo 裡的 tooldef 或獨立的 _tooldef 任一處有＝有；
    值＝頂層鍵淺合併（外面贏）。回 (在不在, 值, 兩處都有)。"""
    has_out, out = load_part(obj, base, "_tooldef")
    if not (isinstance(mi, dict) and "tooldef" in mi):
        return has_out, out, False
    inside = mi["tooldef"]
    if not has_out:
        return True, inside, False
    if isinstance(inside, dict) and isinstance(out, dict):
        return True, {**inside, **out}, True
    if not isinstance(inside, dict) and isinstance(out, dict):    # 壞的裡面不擋好的外面（比照使用者 11-12 對 index_view 的裁定）
        line("note", "tooldef: %s is not an object, skipped; using %s" % (
            ("_metainfo.json#/tooldef", "_tooldef.json") if obj is None else ("_metainfo.tooldef", "_tooldef")))
        return True, out, False
    return True, out, True                                        # 外面壞了：照舊交給後面的檢查報


def aos_tools_check(target):
    """資料夾或 JSON 檔：在暫存資料夾開一份登記檔，aos-tools add＋get（包現成的檢查）；回 bad 句子或 None。"""
    with tempfile.TemporaryDirectory(prefix="tools-def-") as tmp:
        reg = os.path.join(tmp, "tools.json")
        for argv in (["aos-tools", "--file", reg, "add", "--name", "probe", target], ["aos-tools", "--file", reg, "get", "probe"]):
            code, out, err = run(argv, tmp)
            if code != 0:
                return "aos-tools %s: %s" % (argv[3], last_line(err, out) if code is not None else err)
    return None


def op_check():
    location = text("path")
    try:
        path, ptr = tool_spec.split_location(location)
    except tool_spec.SpecBad as e:
        die("ArgumentsBad", str(e))
    path = from_ws(path)
    full = path + ("#" + ptr if ptr is not None else "")
    sample = args.get("sample")
    obj, base = read_location(path, ptr)
    runnable, script = check_entry(obj, base)
    made = True
    if runnable and script:
        made = regenerate(script, full, base)
        if made and obj is not None:
            obj, base = read_location(path, ptr)          # 重產進物件之後重讀
    has_mi, mi = load_part(obj, base, "_metainfo")
    if has_mi and mi is not None:
        probs = tool_spec.metainfo_problems(mi)
        line("bad" if probs else "ok", "metainfo: " + ("; ".join(probs) if probs else "valid (%s)" % mi.get("summary", "no summary")))
        has_mi = not probs
    elif not has_mi:
        line("note", "metainfo: none (optional; a tool_spec script makes it, or tools_def add_metainfo)")
    has_td, td, both = load_tooldef(obj, base, mi)
    if both:
        line("note", "tooldef: both %s; %s wins on the same key" % (
            ("_metainfo.json#/tooldef and _tooldef.json", "_tooldef.json") if obj is None else ("_metainfo.tooldef and _tooldef keys", "_tooldef")))
    if has_td and td is not None:
        probs = tool_spec.tooldef_problems(td)
        if isinstance(td, dict) and td.get("description") == skeleton_description() and not os.path.samefile(base, SKELETON):
            probs.append("description is still the skeleton's (\"Add two numbers ...\"): change DESCRIPTION in tool.py")
        if not probs:
            bad = aos_tools_check(full)
            probs = [bad] if bad else []
        line("bad" if probs else "ok", "tooldef: " + ("; ".join(probs) if probs else "valid, parameters: %s" % (", ".join(td["parameters"].get("properties", {})) or "none")))
        has_td = not probs
    elif not has_td:
        line("bad", "tooldef: none (fix: describe the tool in a tool_spec script, or tools_def add_tooldef, or write %s)" % ("_tooldef.json" if obj is None else "a _tooldef key"))
    example = EXAMPLE_RE.search(td.get("description", "")) if has_td and isinstance(td, dict) and runnable and made else None
    if example:
        try:
            ex_args = json.loads(example.group(1))
        except ValueError:
            ex_args = None
        if isinstance(ex_args, dict):
            code, out, err = run(["aos-exec", "--ws", tool_io.workspace(), full], tool_io.workspace(), json.dumps(ex_args), RUN_S)
            want, got = example.group(2).strip().rstrip("."), out.strip()
            if code == 0 and same(got, want):
                line("ok", "example: %s -> %s (as the description says)" % (example.group(1), got))
            else:
                line("bad", "example: the description says %s -> %s, but the tool gave %s (fix run(args), or the example in DESCRIPTION)"
                     % (example.group(1), want, got if code == 0 else "exit %s: %s" % (code, last_line(out, err))))
    if sample is not None:
        if not runnable or not made:
            line("skip", "try: not tried (fix the lines marked bad first)")
        else:
            limit = min(int(mi.get("timeout_ms", RUN_S * 1000)) // 1000 + 1, 120) if isinstance(mi, dict) and isinstance(mi.get("timeout_ms"), int) else RUN_S
            code, out, err = run(["aos-exec", "--ws", tool_io.workspace(), full], tool_io.workspace(), json.dumps(sample), limit)
            shown = " | ".join(out.strip().splitlines()[:3])[:300] if out.strip() else last_line(err)
            if code == 0 and not out.strip():
                code, shown = "0 but", "no output (run(args) must return the result)"
            line("ok" if code == 0 else "bad", "try: %s -> %s %s" % (json.dumps(sample, ensure_ascii=False), "exit %s:" % code if code is not None else "", shown if code is not None else err))
    missing = [n for n, ok in (("entry", runnable), ("_metainfo", has_mi), ("_tooldef", has_td)) if not ok]
    n = 3 - len(missing)
    bad = sum(1 for r in report if r.startswith("bad"))
    if bad:
        what = "fix the lines marked bad, then check again"
    elif runnable and has_td:
        call = "%s %s" % (locate(location)["name"], json.dumps(sample, ensure_ascii=False) if sample is not None else "{...}")
        what = ("a tool: add it with self_tools {\"op\": \"add\", \"path\": %s}; it works at once: in your next reply "
                "(this turn) call it directly by its name, like any other tool: %s" % (json.dumps(location), call))
    else:
        what = ("a runnable function (next: tools_def add_metainfo, then add_tooldef)" if runnable
                else "not runnable yet (tools_def add_entry writes an entry)")
    line("stage", "%d of 3 (entry, _metainfo, _tooldef)%s - %s" % (n, "; missing: " + ", ".join(missing) if missing else "", what))
    out = "\n".join(report) + "\n"
    if bad:
        die("ToolBad", "%d problem(s) above; fix the lines marked bad and check again" % bad, before=out)
    sys.stdout.write(out)


# ---- 分階段：add_entry → add_metainfo → add_tooldef ----
def staged(loc):
    """位置現況（不印報告）：(物件或 None, 有入口, 入口腳本, 有 metainfo, 有 tooldef)。"""
    obj, base = read_location(loc["path"], loc["ptr"])
    n = len(report)
    runnable, script = check_entry(obj, base)
    del report[n:]
    has_entry = runnable or (obj is not None and "_entry" in obj) or \
        (obj is None and any(os.path.exists(os.path.join(base, x)) for x in ("_entry", "_entry.json")))
    n = len(report)
    has_mi, mi = load_part(obj, base, "_metainfo")
    has_td = load_tooldef(obj, base, mi)[0]
    del report[n:]
    return obj, has_entry, script, has_mi, has_td


def stage_line(loc):
    _, e, _, m, t = staged(loc)
    missing = [n for n, ok in (("entry", e), ("_metainfo", m), ("_tooldef", t)) if not ok]
    return "stage %d of 3 (entry, _metainfo, _tooldef)%s" % (3 - len(missing), "; missing: " + ", ".join(missing) if missing else "")


def uses_tool_spec(script):
    try:
        with open(script, encoding="utf-8") as f:
            return "tool_spec" in f.read()
    except (OSError, UnicodeError, TypeError):
        return False


def op_add_entry():
    loc = locate(text("path"))
    script_name = args.get("script")
    if script_name is not None and (not isinstance(script_name, str) or not script_name.endswith(".py") or "/" in script_name):
        die("ArgumentsBad", "script must be a file name ending in .py, next to the entry (like \"tool.py\")")
    if loc["kind"] == "dir":
        if os.path.isfile(loc["path"]):
            die("ArgumentsBad", "%s is a file, not a folder (give a folder, a JSON file or FILE.json#/POINTER)" % args["path"])
        try:
            os.makedirs(loc["path"], exist_ok=True)
        except OSError as e:
            die("MkdirFailed", "cannot create %s: %s" % (tool_io.place(loc["path"]), tool_io.os_reason(e)))
        if any(os.path.lexists(os.path.join(loc["path"], x)) for x in ("_entry", "_entry.json")):
            die("PathExists", "%s already has an entry (_entry or _entry.json); change it with edit" % args["path"])
        script_name = script_name or "tool.py"
    else:
        ensure_json_file(loc)
        if object_exists(loc):
            obj = read_location(loc["path"], loc["ptr"])[0]
            if "_entry" in obj:
                die("PathExists", "%s already has an _entry key; change it with edit or json_set" % args["path"])
        script_name = script_name or loc["name"] + ".py"
    script = os.path.join(loc["base"], script_name)
    if os.path.exists(script):
        how = "kept the script %s that is already there" % script_name
    else:
        copy_script(script)
        how = "copied the skeleton script to %s (a working tool that adds two numbers; change the part under %r)" % (script_name, MARK)
    argv = ["python3", script_name]
    if loc["kind"] == "dir":
        try:
            tool_spec._write_file(os.path.join(loc["path"], "_entry.json"), {"argv": argv})
        except OSError as e:
            die("WriteFailed", "cannot write _entry.json: %s" % e)
        where = "%s/_entry.json" % loc["path"]
    else:
        where = key_at(loc, "_entry")
        aos_json(["set", "--parents", where, json.dumps(argv)], where)
    print("wrote %s: %s; %s.\n%s - a runnable function (aos-exec %s). Next: tools_def {\"op\": \"add_metainfo\", \"path\": %s}"
          % (where, json.dumps(argv), how, stage_line(loc), loc["full"], json.dumps(args["path"])))


def from_args_or_script(loc, key):
    """add_metainfo／add_tooldef 共用：已有＝PathExists；腳本用 tool_spec 又沒給 description＝照腳本產，否則照參數產。"""
    obj, _e, script, has_mi, has_td = staged(loc)
    if (has_mi if key == "_metainfo" else has_td):
        die("PathExists", "%s already has %s; change it with edit (or, for a tool_spec script, change the script and run check)" % (args["path"], key))
    desc = args.get("description")
    if desc is None and uses_tool_spec(script):
        code, out, err = run([sys.executable, script, "--metainfo" if key == "_metainfo" else "--tooldef"], loc["base"])
        if code != 0:
            die("ArgumentsBad", "%s --%s failed: %s" % (os.path.basename(script), key[1:], last_line(err, out)))
        return json.loads(out), "from %s" % os.path.basename(script)
    if not isinstance(desc, str) or not desc.strip():
        die("ArgumentsBad", "description is needed (what the tool does, one example call); the entry script does not use tool_spec")
    try:
        if key == "_metainfo":
            meta = args.get("meta")
            if meta is not None and not isinstance(meta, dict):
                die("ArgumentsBad", "meta must be an object like {\"side_effect\": true}")
            return tool_spec.metainfo(desc, meta), "from description"
        params = args.get("params", [])
        if not isinstance(params, list) or not all(isinstance(p, dict) and isinstance(p.get("name"), str) for p in params):
            die("ArgumentsBad", "params must be a list of objects like {\"name\": \"a\", \"type\": \"number\", \"description\": \"the first number\"}")
        for p in params:
            extra = sorted(set(p) - set(PARAM_KEYS))
            if extra:
                die("ArgumentsBad", "param %s: unknown key %s (known: %s)" % (p["name"], ", ".join(extra), ", ".join(PARAM_KEYS)))
        return tool_spec.tooldef(desc, [tool_spec.param(**p) for p in params]), "from description and params"
    except tool_spec.SpecBad as e:
        die("ArgumentsBad", str(e))


def write_part(key):
    loc = locate(text("path"))
    value, how = from_args_or_script(loc, key)
    probs = (tool_spec.metainfo_problems if key == "_metainfo" else tool_spec.tooldef_problems)(value)
    if probs:
        die("ArgumentsBad", "; ".join(probs))
    try:
        where = tool_spec.write_defs(loc["full"], value if key == "_tooldef" else None, value if key == "_metainfo" else None)
    except (OSError, tool_spec.SpecBad) as e:
        die("WriteFailed", str(e))
    return loc, where[0], how


def op_add_metainfo():
    loc, where, how = write_part("_metainfo")
    print("wrote %s (%s).\n%s. Next: tools_def {\"op\": \"add_tooldef\", \"path\": %s}"
          % (where, how, stage_line(loc), json.dumps(args["path"])))


def op_add_tooldef():
    loc, where, how = write_part("_tooldef")
    print("wrote %s (%s).\n%s. Next: tools_def {\"op\": \"check\", \"path\": %s, \"sample\": {...}}, then self_tools add"
          % (where, how, stage_line(loc), json.dumps(args["path"])))


