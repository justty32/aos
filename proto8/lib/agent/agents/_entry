def stack_rel(p):
    """表上的（絕對）stack → 存進 children.json 的：相對 $AOS_DAEMON 的真實路徑（daemon_ctl 拼表也是從那裡）。"""
    return os.path.relpath(os.path.normpath(p), daemon_base)


def stack_abs(rel):
    """children.json 的 stack → 拼回絕對，跟 ctl ls --json 表上的比。"""
    return os.path.normpath(os.path.join(daemon_base, rel))


def reconcile():
    """對帳：children.json 裡名字與 stack 都對得上表上那列的才算還在；不在的忘掉（寫回）。回 (還在的, 忘掉的名字, 表)。"""
    kids = load_json(children_path, [])
    if not isinstance(kids, list) or not all(isinstance(k, dict) and isinstance(k.get("name"), str) for k in kids):
        die("ReadFailed", "%s is not a JSON array of {name, stack}" % children_path)
    rows = table()
    on_table = {(r.get("name"), os.path.normpath(r["stack"])) for r in rows if isinstance(r, dict) and isinstance(r.get("stack"), str)}
    alive = [k for k in kids if isinstance(k.get("stack"), str) and (k["name"], stack_abs(k["stack"])) in on_table]
    gone = [k["name"] for k in kids if k not in alive]
    if gone:
        write_children(alive)
    return alive, gone, rows


def max_children():
    """agents.json：我的定義那份疊我的 stack 那份（只放改過的鍵）；都沒有＝4。"""
    me = json.loads(must(["ctl", "who", "--json"]))
    cfg = {}
    for d in (me.get("def"), me.get("stack")):
        if d:
            v = load_json(os.path.join(d, "agents.json"), {})
            if not isinstance(v, dict):
                die("CfgBad", "%s is not a JSON object" % os.path.join(d, "agents.json"))
            cfg.update(v)
    n = cfg.get("max_children", MAX_CHILDREN_DEFAULT)
    if isinstance(n, bool) or not isinstance(n, int) or n < 0:
        die("CfgBad", "max_children in agents.json must be a non-negative integer, not %s" % json.dumps(n))
    return n


def quota():
    alive, _, _ = reconcile()
    n = max_children()
    if len(alive) >= n:
        die("ChildSlotMissing", "you already have %d of max %d children (%s); remove one with op rm first "
            "(max_children is set in agents.json of your definition or your stack)" % (len(alive), n, ", ".join(k["name"] for k in alive) or "-"))
    return alive, n


def my_child(args):
    name = need_name(args.get("name"))
    alive, gone, _ = reconcile()
    if name in gone:
        die("ChildMissing", "%s is no longer on the daemon table (removed elsewhere); forgotten" % name)
    if name not in [k["name"] for k in alive]:
        die("ChildUnknown", "%s was not added by you (say / ask / rm only reach your own children; op ls lists the whole table)" % name)
    return name


