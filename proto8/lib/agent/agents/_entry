def kill_group(p):
    for sig, wait_s in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        try:
            os.killpg(p.pid, sig)
        except OSError:
            return
        try:
            p.wait(wait_s)
            return
        except subprocess.TimeoutExpired:
            pass


def on_term(signum, frame):
    if child is not None:
        kill_group(child)
    sys.exit(128 + signum)


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)          # Ctrl-C：同 TERM，退 130、不吐 traceback（R12）


def agent(argv, text=None, timeout_s=STEP_S):
    """叫 aos-agent --daemon <AOS_DAEMON> argv…；退 0 回 (stdout, None)，退非 0 回 (stdout, (代號, 原因))。"""
    global child, last_err
    cmd = ["aos-agent", "--daemon", daemon] + argv
    try:
        child = subprocess.Popen(cmd, stdin=subprocess.PIPE if text is not None else subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    except OSError as e:
        die("LaunchFailed", "cannot start aos-agent (is it on PATH?): %s" % e)
    try:
        out, err = child.communicate(None if text is None else text.encode("utf-8"), timeout=timeout_s)
    except subprocess.TimeoutExpired:
        kill_group(child)
        die("CommandFailed", "aos-agent %s did not finish in %d s (killed)" % (" ".join(argv[:2]), timeout_s))
    p, child = child, None
    out, err = out.decode("utf-8", "replace"), err.decode("utf-8", "replace")
    last_err = err
    if err:                                     # 下層的 stderr 原樣透出（R10）
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    if p.returncode == 0:
        return out, None
    lines = [x for x in err.splitlines() if x.strip()]
    mine = [m for m in map(ERR_RE.match, lines) if m]       # aos-agent 自己的、或它原樣轉的 aos-tools／aos-json 的那行
    if mine:
        return out, (mine[-1].group(1), mine[-1].group(2))
    return out, ("CommandFailed", "aos-agent %s exited %d: %s" % (" ".join(argv[:2]), p.returncode, lines[-1] if lines else "(no message)"))


def must(argv, text=None, timeout_s=STEP_S):
    out, err = agent(argv, text, timeout_s)
    if err:
        die(*err)
    return out


def need_str(args, key):
    v = args.get(key)
    if not isinstance(v, str) or not v.strip():
        die("ArgumentsBad", "%s must be a non-empty string" % key)
    return v


def need_name(v, what="name"):
    if not isinstance(v, str) or not NAME_RE.match(v):
        die("NameBad", "%s %r must be 1-64 of A-Z a-z 0-9 _ - (not starting with -)" % (what, v))
    return v


def inside(p, root):
    return p == root or p.startswith(root.rstrip(os.sep) + os.sep)


def workspace():
    w = os.environ.get("AOS_WS")
    if not w or not os.path.isdir(w):
        die("WsMissing", "AOS_WS is not set or not a folder")
    return os.path.realpath(w)


def read_path(p, what):
    """讀的路徑（def、from、tools 的 path、ws）：相對從工作區算、絕對照用。"""
    if not isinstance(p, str) or not p:
        die("ArgumentsBad", "%s must be a non-empty string" % what)
    return os.path.realpath(p if os.path.isabs(p) else os.path.join(workspace(), p))


def lex_path(p, what):
    """tools 的 path：相對從工作區算、絕對照用；只字串拼（不解開捷徑，之後要換算成相對）。"""
    if not isinstance(p, str) or not p:
        die("ArgumentsBad", "%s must be a non-empty string" % what)
    return os.path.normpath(p if os.path.isabs(p) else os.path.join(workspace(), p))


def write_path(p, what):
    """寫的路徑（new 的 path）：相對從工作區算，解開後要在工作區裡。"""
    real = read_path(p, what)
    if not inside(real, workspace()):
        die("PathBad", "%s %r is outside the workspace %s" % (what, p, workspace()))
    return real


def load_json(path, missing):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return missing
    except (OSError, ValueError) as e:
        die("ReadFailed", "cannot read %s: %s" % (path, e))


def write_json(path, v):
    tmp = os.path.join(os.path.dirname(path), ".%s.%d" % (os.path.basename(path), os.getpid()))
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(json.dumps(v, ensure_ascii=False) + "\n")
        os.replace(tmp, path)
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (path, e))


