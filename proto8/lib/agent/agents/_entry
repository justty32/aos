def spawn_args(args):
    """回 (llm 鍵值, tools [(名, 絕對路徑；只字串拼、不解開捷徑)], tools_rm [名], 子的 ws, limits)。"""
    llm = args.get("llm", {})
    if not isinstance(llm, dict) or not all(isinstance(v, str) for v in llm.values()):
        die("ArgumentsBad", "llm must be an object of string values, e.g. {\"endpoint\": \"fake\"}")
    tools = args.get("tools", [])
    if not isinstance(tools, list) or not all(isinstance(t, dict) for t in tools):
        die("ArgumentsBad", "tools must be an array of {name, path}")
    tool_list = [(need_name(t.get("name"), "tool name"), lex_path(t.get("path"), "tool path")) for t in tools]
    tools_rm = args.get("tools_rm", [])
    if not isinstance(tools_rm, list):
        die("ArgumentsBad", "tools_rm must be an array of tool names")
    tools_rm = [need_name(n, "tools_rm name") for n in tools_rm]
    child_ws = workspace() if args.get("ws") is None else read_path(args.get("ws"), "ws")
    return llm, tool_list, tools_rm, child_ws, args.get("limits")


def mount(name, definition, child_ws, limits):
    """aos-agent ctl add；回 (子的 stack, 提醒行) 或 (None, 錯)。"""
    if not os.path.isdir(child_ws):
        try:
            os.makedirs(child_ws)
        except OSError as e:
            die("MkdirFailed", "cannot create ws %s: %s" % (child_ws, e))
    out, err = agent(["ctl", "add", "--name", name, "--ws", child_ws,
                      *(["--limits", json.dumps(limits, ensure_ascii=False)] if limits is not None else []), definition])
    if err:
        return None, err
    notes = [x.strip() for x in last_err.splitlines() if WARN_RE.match(x.strip())]
    return (out.strip().splitlines()[-1] if out.strip() else "?"), notes


def report(name, child_stack, notes, alive, n, head=""):
    write_children(alive + [{"name": name, "stack": stack_rel(child_stack)}])
    sys.stdout.write("%sadded %s (stack %s); children %d/%d\n" % (head, name, child_stack, len(alive) + 1, n)
                     + "".join(x + "\n" for x in notes))
    sys.exit(0)


def decl_file(defdir, key):
    """定義 interfaces.json 的 aos-agent 宣告裡 key（tools／llm）指的檔；沒宣告＝None。"""
    decl = load_json(os.path.join(defdir, "interfaces.json"), None)
    if not isinstance(decl, dict) or not isinstance(decl.get("aos-agent"), dict):
        die("DefBad", "%s has no interfaces.json declaring aos-agent" % defdir)
    p = decl["aos-agent"].get(key)
    if p is None:
        return None
    if not isinstance(p, str) or os.path.isabs(p) or ".." in p.split("/"):
        die("DefBad", "interfaces.json aos-agent %s must be a relative path inside the definition" % key)
    return os.path.join(defdir, p)


def rebase_tools(tools_file, src, dest, tmp):
    """複製來的 tools 檔：相對 path 原本從範本那份的資料夾算，改成從新定義裡那份（最終位置 dest）的資料夾走回同一個目標。
    指範本裡的也指回範本那份（範本的 tools/memory 裡是相對捷徑，複本深度不同會斷）；絕對的照抄。只做字串換算、不 realpath。"""
    reg = load_json(tools_file, None)
    if not isinstance(reg, dict) or not isinstance(reg.get("tools"), dict):
        return
    sub = os.path.relpath(os.path.dirname(tools_file), tmp)          # tools 檔在定義裡的哪一層
    src_dir, dest_dir = os.path.normpath(os.path.join(src, sub)), os.path.normpath(os.path.join(dest, sub))
    for entry in reg["tools"].values():
        if isinstance(entry, dict) and isinstance(entry.get("path"), str) and not os.path.isabs(entry["path"]):
            entry["path"] = os.path.relpath(os.path.normpath(os.path.join(src_dir, entry["path"])), dest_dir)
    write_json(tools_file, reg)


def build_def(tmp, dest, src, files, llm, tool_list, tools_rm):
    """在 tmp 寫好新定義（之後改名成 dest）：複製 from → 寫 files → 改 llm 檔、tools 檔；tools 檔的 path 對 dest 算相對。"""
    try:
        if src:
            shutil.copytree(src, tmp, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
        else:
            os.makedirs(tmp)
    except OSError as e:
        die("WriteFailed", "cannot copy %s to %s: %s" % (src, tmp, e))
    if src:
        tf = decl_file(tmp, "tools")
        if tf and os.path.isfile(tf):
            rebase_tools(tf, src, dest, tmp)
    for rel, text in files.items():
        dst = os.path.realpath(os.path.join(tmp, rel))
        if os.path.isabs(rel) or not inside(dst, os.path.realpath(tmp)) or dst == os.path.realpath(tmp):
            die("PathBad", "files key %r must be a relative path inside the new definition" % rel)
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "w", encoding="utf-8") as f:
                f.write(text)
        except OSError as e:
            die("WriteFailed", "cannot write %s: %s" % (rel, e))
    if llm:
        lf = decl_file(tmp, "llm")
        if not lf:
            die("DefBad", "llm given but the definition declares no llm file in interfaces.json")
        cur = load_json(lf, {})
        if not isinstance(cur, dict):
            die("DefBad", "%s is not a JSON object" % os.path.relpath(lf, tmp))
        cur.update(llm)
        write_json(lf, cur)
    if tool_list or tools_rm:
        tf = decl_file(tmp, "tools")
        if not tf:
            die("DefBad", "tools / tools_rm given but the definition declares no tools file in interfaces.json")
        reg = load_json(tf, {"tools": {}})
        if not isinstance(reg, dict) or not isinstance(reg.setdefault("tools", {}), dict):
            die("DefBad", "%s is not {\"tools\": {...}}" % os.path.relpath(tf, tmp))
        for n in tools_rm:
            if n not in reg["tools"]:
                die("ToolMissing", "tools_rm: %s is not in the definition's %s" % (n, os.path.relpath(tf, tmp)))
            del reg["tools"][n]
        tf_dir = os.path.normpath(os.path.join(dest, os.path.relpath(os.path.dirname(tf), tmp)))
        for n, p in tool_list:
            reg["tools"][n] = {"path": os.path.relpath(p, tf_dir)}
        write_json(tf, reg)


# ---- 入口檢查 ----
args = tool_io.arguments()
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (%s)" % ", ".join(OPS))
if op not in OPS:
    die("OpUnknown", "op must be one of %s (got %r)" % (", ".join(OPS), op))
daemon = os.environ.get("AOS_DAEMON")
if not daemon:
    die("DaemonMissing", "AOS_DAEMON is not set (this tool attaches agents to the daemon that runs you)")
stack = os.environ.get("AOS_STACK")
if not stack:
    die("StackMissing", "AOS_STACK is not set")
children_path = os.path.join(stack, "children.json")
daemon_base = os.path.realpath(daemon)          # children.json 的 stack 相對這裡（同 daemon_ctl 找 daemon：轉絕對、解開捷徑）

if op == "ls":
    alive, _, rows = reconcile()
    print(json.dumps({"agents": rows, "children": [k["name"] for k in alive], "max_children": max_children()}, ensure_ascii=False))
    sys.exit(0)

if op in ("say", "ask"):
    name = my_child(args)
    text = need_str(args, "text")
    timeout_s = args.get("timeout_s", ASK_DEFAULT_S)
    if op == "ask" and (isinstance(timeout_s, bool) or not isinstance(timeout_s, (int, float)) or not 0 < timeout_s <= ASK_MAX_S):
        die("ArgumentsBad", "timeout_s must be a number in (0, %d]" % ASK_MAX_S)
    out = must(["say", "--target", name], text=text)
    if op == "ask":
        out = must(["listen", "--target", name, "--timeout-s", "%g" % timeout_s], timeout_s=timeout_s + 30)
    sys.stdout.write(out)
    sys.exit(0)

if op == "rm":
    name = my_child(args)
    out = must(["ctl", "rm", name])
    write_children([k for k in load_json(children_path, []) if k.get("name") != name])
    sys.stdout.write(out)
    sys.exit(0)

name = need_name(args.get("name"))
llm, tool_list, tools_rm, child_ws, limits = spawn_args(args)

if op == "new":                                 # 生法 (a)：產出新定義再掛
    dest = write_path(args.get("path"), "path")
    if os.path.lexists(dest):
        die("DefExists", "path %r already exists (pick a new folder; use op add to start an existing definition)" % args.get("path"))
    src = None
    if args.get("from") is not None:
        src = read_path(args.get("from"), "from")
        if not os.path.isdir(src):
            die("DefMissing", "from %r is not a folder" % args.get("from"))
    files = args.get("files", {})
    if not isinstance(files, dict) or not all(isinstance(v, str) for v in files.values()):
        die("ArgumentsBad", "files must be an object {relative path: full text}")
    if src is None and not files:
        die("ArgumentsBad", "new needs from (a template folder to copy) or files (the whole definition), or both")
    alive, n = quota()
    tmp = os.path.join(os.path.dirname(dest), ".%s.new-%d" % (os.path.basename(dest), os.getpid()))
    try:
        os.makedirs(os.path.dirname(dest), exist_ok=True)
    except OSError as e:
        die("MkdirFailed", "cannot create %s: %s" % (os.path.dirname(dest), e))
    try:
        build_def(tmp, dest, src, files, llm, tool_list, tools_rm)
        os.rename(tmp, dest)
    except SystemExit:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    except OSError as e:
        shutil.rmtree(tmp, ignore_errors=True)
        die("WriteFailed", "cannot move the new definition into %s: %s" % (dest, e))
    child_stack, notes = mount(name, dest, child_ws, limits)
    if child_stack is None:                     # 全有或全無：掛不上就把剛寫的定義刪掉
        shutil.rmtree(dest, ignore_errors=True)
        die(notes[0], notes[1] + " (the new definition %s was removed again)" % dest)
    report(name, child_stack, notes, alive, n, "wrote definition %s%s\n" % (dest, " (copied from %s)" % src if src else ""))

# 生法 (b)：用現有定義掛，設定走子的覆蓋層
definition = read_path(args.get("def"), "def")
if not os.path.isdir(definition):
    die("DefMissing", "def %r is not a folder" % args.get("def"))
alive, n = quota()
child_stack, notes = mount(name, definition, child_ws, limits)
if child_stack is None:
    die(*notes)
steps = [("llm set %s=%s" % (k, v), ["llm", "--target", name, "set", "%s=%s" % (k, v)]) for k, v in llm.items()] + \
        [("tools rm " + t, ["tools", "--target", name, "rm", t]) for t in tools_rm] + \
        [("tools add " + t, ["tools", "--target", name, "add", "--override", t, p]) for t, p in tool_list]
for what, argv in steps:
    _, err = agent(argv)
    if err:                    # 全有或全無：設定沒上，收回這隻
        _, err2 = agent(["ctl", "rm", name])
        die(err[0], err[1] + " (during %s; %s)" % (what, "rolled back: removed %s" % name if err2 is None
                                                    else "rollback failed too: %s %s" % err2))
report(name, child_stack, notes, alive, n)
