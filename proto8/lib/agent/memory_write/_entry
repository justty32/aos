#!/usr/bin/env python3
# memory_write - 改記憶庫：add／set／rm 一次寫好內容與它在表（_index.json 或 _index key）裡的那格；只寫庫根底下。
# 圖紙：proto8/thinking/2026-11/10/json-memory/03-工具.md（使用者 11-10 晚）。介面：stdin {"op": "add"|"set"|"rm", "path": 統一路徑,
#   "value"?: 任何 JSON（非 .json 檔要字串）, "description"?: 字串, "recursive"?: bool}。path 寫法與庫根的找法同 memory（memory_fs）。
#   add：path 以 / 結尾＝開資料夾（帶空的 _index.json）；否則新檔或物件裡新 key；description 必給，寫進上一層的表。
#   set：位置要已在；換 value、換 description，或兩個一起。rm：刪檔、資料夾（不空要 recursive: true）或 key，連表裡那格一起拔。
#   不加鎖（使用者「不管，自行承擔風險」）；每份檔由 aos-json 暫存後原子 rename。
# 結果 stdout：node: <路徑>，下一行 added／set／removed。錯：stderr 與 stdout 各一行「memory_write: error: 代號 原因」、退 1。
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io
except ModuleNotFoundError as error:
    if error.name != "tool_io":
        raise
    _line = "memory_write: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n"
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

HELP = """\
usage: memory_write [FLAGS] < ARGUMENTS.json   (a tool: run it with aos-exec)
Change a memory (a tree of folders and .json files; paths as in the memory tool:
folder/file.json#/key, relative to the memory root). Each op also keeps the index
up to date (the folder's _index.json, or the object's _index key):
  add  a new file, a new key in an object, or a folder (path ends with /);
       description is required and goes into the index.
  set  replace the value, the description, or both; the place must exist.
  rm   delete a file, a key, or a folder (recursive: true if not empty),
       and its index entry.
Writes must stay inside the memory root (after following symlinks). No locking:
two writers at once may overwrite each other. Needs aos-json on PATH. The root
comes from _memory.json next to the tool, otherwise AOS_MEMORY.
Result on stdout: node: PATH, then added, set or removed.
On error: one line "memory_write: error: CODE reason" on stderr and stdout, exit 1.
"""
tool_io.start("memory_write", HELP)
try:
    import memory_fs as fs
except ModuleNotFoundError as error:
    if error.name != "memory_fs":
        raise
    tool_io.die("ModuleMissing", "memory_fs.py not in the tool folder, not in lib/agent/, not on the Python path")
import writing

fs.install_signals()
args = tool_io.arguments()
op = args.get("op")
if op is None:
    tool_io.die("ArgumentsBad", "op is required (add, set or rm)")
if op not in ("add", "set", "rm"):
    tool_io.die("OpUnknown", "%r is not an op; use add, set or rm" % (op,))
path = args.get("path")
description = args.get("description")
if description is not None and (not isinstance(description, str) or not description.strip()):
    tool_io.die("ArgumentsBad", "description must be a non-empty string")
if op == "add" and description is None:
    tool_io.die("ArgumentsBad", "add needs description (one line saying what this is)")
recursive = args.get("recursive", False)
if not isinstance(recursive, bool):
    tool_io.die("ArgumentsBad", "recursive must be true or false")
root = fs.memory_root(HERE)
try:
    loc = fs.parse(root, path)
    if op == "add":
        if loc.fs == root and loc.tokens is None:
            raise tool_io.Error("NodeExists", "the memory root already exists; add a path under it")
        writing.add(root, loc, isinstance(path, str) and path.endswith("/") and "#" not in path,
                    "value" in args, args.get("value"), description)
    elif op == "set":
        writing.set_(root, loc, "value" in args, args.get("value"), description)
    else:
        writing.remove(root, loc, recursive)
except tool_io.Error as error:
    tool_io.die(error.code, str(error))
except OSError as error:
    tool_io.die("WriteFailed", str(error))
print("node: " + fs.show(root, loc))
print({"add": "added", "set": "set", "rm": "removed"}[op])
