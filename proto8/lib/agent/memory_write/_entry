#!/usr/bin/env python3
# memory_write - Add, replace or remove shared knowledge nodes with atomic writes and directory locks.
import os
import signal
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io
except ModuleNotFoundError as error:
    if error.name != "tool_io":
        raise
    _line = "memory_write: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n"
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

HELP = """\
usage: memory_write [FLAGS] < ARGUMENTS.json   (a tool: run it with aos-exec)
Add, replace or remove shared knowledge nodes. The root is configured by
_memory.json next to the tool, otherwise AOS_MEMORY; the root itself is read-only.
rm rejects root-level symlinks with PathBad; deeper symlinks are only unlinked.
Result on stdout: node: PATH, then written N bytes or removed.
On error: one line "memory_write: error: CODE reason" on stderr and stdout, exit 1.
"""
tool_io.start("memory_write", HELP)
try:
    import memory_fs as fs
except ModuleNotFoundError as error:
    if error.name != "memory_fs":
        raise
    try:
        from agent import memory_fs as fs
        sys.modules["memory_fs"] = fs
    except ModuleNotFoundError as fallback:
        if fallback.name not in ("agent", "agent.memory_fs"):
            raise
        tool_io.die("ModuleMissing", "memory_fs.py not in the tool folder, not in lib/agent/, not on the Python path")
import writing


def terminated(signum, frame):
    raise SystemExit(128 + signum)


signal.signal(signal.SIGTERM, terminated)
signal.signal(signal.SIGINT, terminated)
args = tool_io.arguments()
op = args.get("op")
if op is None:
    tool_io.die("ArgumentsBad", "op is required (add, edit or rm)")
if op not in ("add", "edit", "rm"):
    tool_io.die("OpUnknown", "%r is not an op; use add, edit or rm" % (op,))
segs = fs.parse_path(args.get("path"))
if not segs:
    tool_io.die("PathBad", "root is read-only; a human edits it")
if any(len(segment.encode("utf-8")) > 200 for segment in segs):
    tool_io.die("PathBad", "node path segments must not exceed 200 bytes")
root = fs.memory_root(os.environ.get("AOS_CD") or os.path.dirname(os.path.abspath(__file__)))
try:
    if op == "add":
        count = writing.add(root, segs, args.get("text"))
    elif op == "edit":
        count = writing.edit(root, segs, args.get("text"))
    else:
        writing.remove(root, segs, args.get("recursive", False))
except tool_io.Error as error:
    tool_io.die(error.code, str(error))
except OSError as error:
    tool_io.die("WriteFailed", str(error))
print("node: " + fs.show(segs))
print("removed" if op == "rm" else "written %d bytes" % count)
