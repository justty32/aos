#!/usr/bin/env python3
# knowledge_read - 唯讀查記憶庫（資料夾＋.json 的一棵 JSON 樹）：read 一個位置、ls 列枝幹的表、find 依關鍵字／標籤找路徑。
# 圖紙：proto8/thinking/2026-11/10/json-memory/02-格式規則.md、03-工具.md（使用者 11-10 晚「json本身就是節點樹」）。
# 介面（lib 契約）：stdin {"op": "read"|"ls"|"find", "path"?: 統一路徑, "query"?: 字串, "tag"?: 字串, "max_bytes"?: N}。
#   庫根（腦不能挑）：argv 的 --root DIR（不是 JSON 參數；相對從 $AOS_WS，沒設＝cwd）＞ 工具資料夾（$AOS_CD）的 _knowledge.json 的 base
#   ＞ $AOS_KNOWLEDGE（相對從 $AOS_DAEMON，沒有＝cwd）；都沒有＝KnowledgeMissing（工具沒有內建預設位置，11-10 深夜）；設定檔壞＝CfgBad（knowledge_fs）。
#   path＝`資料夾/檔.json#/JSON Pointer`，相對從庫根算；"" 或 "/"＝根；其他 / 開頭＝檔案系統絕對路徑（讀不限範圍）。
#   stdout 純文字、第一行 node: <路徑>；印出的每條路徑都能直接貼回 path：
#     read：資料夾或有 _index 的物件＝自己的簡介（資料夾的 _description.json、物件的 _description key；沒有就不印）＋children:（表）＋not in index:；
#           只有 _description 沒 _index 的物件＝簡介、空一行、其餘 key 的縮排 JSON；字串＝原文；其他 JSON＝縮排 JSON；
#           非 .json 檔＝UTF-8 原文、不是 UTF-8＝binary file, N bytes。內容的 $ref／$env 交給 aos-json --resolve 解。
#     ls：只印表（資料夾、物件、陣列）；對字串等枝葉＝TargetBad。
#     find：path 底下（含表指到外面的格）名字、說明（表那格的與自己的簡介）、字串內容含 query（不分大小寫）、且表那格 tags 含 tag 的位置；最多 20 筆；命中在內文＝附 [match: 那一行]。
#   輸出超過 max_bytes（預設 8000）截斷並附 [truncated: N more bytes]。
# 錯：stderr 與 stdout 各一行「knowledge_read: error: 代號 原因」、退 1；代號見 _tooldef.json 的 errors（aos-json 的照圖紙 03 換）。
# 不寫任何檔、不碰 $AOS_WS。子行程只有 aos-json（find 不起子行程，除了 $env 格的 aos-directive）；被 TERM 先收掉它、退 128＋N。
import json, os, sys
HELP = """\
usage: knowledge_read [--root DIR] < ARGUMENTS.json   (a tool: run it with aos-exec)
Read a knowledge base: a tree of folders and .json files. A path looks like
folder/file.json#/key/sub (JSON Pointer after #, ~1 = /, ~0 = ~); relative paths
start at the knowledge base root; "" or "/" is the root; other paths starting with / are
absolute file system paths.
  read  a folder or an object with _index: its own description, then children:
        (the index) and not in index:; a string: the text; other JSON: JSON;
        other files: the text, or "binary file, N bytes". A folder's own
        description is its _description.json (a JSON string); an object's is
        its _description key. Neither is listed as a child.
  ls    only the index of a folder, object or array.
  find  paths under path whose name, description or text contains query
        (case-insensitive) and whose index entry has tag in its tags; max 20;
        a hit inside the text ends with [match: that line].
Every path printed can be passed back as path. Output over max_bytes is cut.
Needs aos-json on PATH. The knowledge base root: --root DIR (command line only, not a
JSON argument), else _knowledge.json {"base": DIR} next to the tool, else
AOS_KNOWLEDGE. No default: none of them = KnowledgeMissing; not a folder = KnowledgeBad.
Result on stdout. On error: one line "knowledge_read: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

die = tool_io.die
try:
    import knowledge_fs as fs
except ModuleNotFoundError as error:
    if error.name != "knowledge_fs":
        raise
    die("ModuleMissing", "knowledge_fs.py not in the tool folder, not in lib/agent/, not on the Python path", prog="knowledge_read")
fs.take_root_flag("knowledge_read")                # --root DIR 不是 JSON 參數：先從 argv 拿掉，再交 tool_io 映射其餘旗標
tool_io.start("knowledge_read", HELP)
Loc, ToolError = fs.Loc, fs.ToolError
DEFAULT_MAX_BYTES = 8000
FIND_LIMIT = 20
SNIPPET = 160                          # find 附的命中那一行最多幾個字


def truncate(text, max_bytes):
    raw = text.encode("utf-8")
    if len(raw) <= max_bytes:
        return text
    head = raw[:max_bytes].decode("utf-8", "ignore").rstrip("\n")
    return "%s\n[truncated: %d more bytes]" % (head, len(raw) - max_bytes)


def op_read(root, loc):
    kind, value, table, kids = fs.load(root, loc)
    lines = ["node: " + fs.show(root, loc)]
    intro = fs.intro(kind, loc, value, lambda f: fs.get(Loc(f, None)))
    if kind == "folder" or table is not None:
        if intro:
            lines += [intro.rstrip("\n"), ""]
        lines += fs.listing(root, loc, kind, table, kids)
    elif intro:                                 # 只有 _description 沒 _index：簡介在前、其餘照印 JSON
        rest = fs.without_intro(value)
        lines += ["", intro.rstrip("\n")] + (["", json.dumps(rest, ensure_ascii=False, indent=2)] if rest else [])
    elif kind == "binary":
        lines += ["", "binary file, %d bytes" % value]
    elif kind == "text" or isinstance(value, str):
        lines += ["", value.rstrip("\n")]
    else:
        lines += ["", json.dumps(value, ensure_ascii=False, indent=2)]
    return lines


def op_ls(root, loc):
    kind, value, table, kids = fs.load(root, loc)
    if kind in ("text", "binary") or kind == "json" and not isinstance(value, (dict, list)):
        raise ToolError("TargetBad", "%s is a leaf, not a folder, object or array; use read" % fs.show(root, loc))
    return ["node: " + fs.show(root, loc)] + fs.listing(root, loc, kind, table, kids)


# ---- find：直接用 Python 讀 JSON 逛樹（圖紙 03 的唯一例外），不解內容裡的 $ref ----
def py_load(loc, cache):
    """回 (kind, value)；讀不到、壞 JSON、路上碰到指示詞＝None（find 安靜跳過）。"""
    if os.path.isdir(loc.fs):
        return ("folder", None) if loc.tokens is None else None
    if not os.path.isfile(loc.fs):
        return None
    real = os.path.realpath(loc.fs)
    if real not in cache:
        try:
            with open(real, "rb") as h:
                raw = h.read().decode("utf-8")
            cache[real] = json.loads(raw) if real.endswith(".json") else raw
        except (OSError, ValueError):
            cache[real] = None
    value = cache[real]
    if not loc.fs.endswith(".json"):
        return ("text", value) if loc.tokens is None and value is not None else None
    for t in loc.tokens or ():
        if isinstance(value, dict) and "$ref" not in value and "$env" not in value and t in value:
            value = value[t]
        elif isinstance(value, list) and t.isdigit() and int(t) < len(value):
            value = value[int(t)]
        else:
            return None
    return ("json", value)


def py_table(folder, cache):
    got = py_load(Loc(os.path.join(folder, "_index.json"), None), cache)
    return got[1] if got and isinstance(got[1], dict) else {}


def walk(loc, descs, tags, via_env, seen, cache):
    """深度優先：先表的格（照表的順序；$env 格只跳一次），再 not in index；走過的（實體路徑, 指標）跳過。"""
    key = (os.path.realpath(loc.fs), loc.tokens)
    if key in seen:
        return
    seen.add(key)
    got = py_load(loc, cache)
    if got is None:
        return
    kind, value = got
    table, kids, text = None, [], None
    if kind == "folder":
        table, kids = py_table(loc.fs, cache), fs.folder_kids(loc.fs)
    elif fs.is_branch(value):
        table, kids = value["_index"], fs.value_kids(loc, value)
    elif isinstance(value, dict) and "$ref" not in value and "$env" not in value or isinstance(value, list):
        kids = fs.value_kids(loc, value)
    elif isinstance(value, str):
        text = value
    def reader(f):
        got = py_load(Loc(f, None), cache)
        return got[1] if got else None
    own = fs.intro(kind, loc, value, reader)
    if own:
        descs = descs + [own]
    yield loc, descs, tags, text
    covered = set()
    for c in fs.cells(loc, table or {}, kind != "folder"):
        if c.target is None or (c.env and via_env):
            continue
        covered.add(c.target)
        yield from walk(c.target, [c.description] if c.description else [], c.tags, via_env or c.env, seen, cache)
    for k in kids:
        if k not in covered:
            yield from walk(k, [], [], via_env, seen, cache)


def snippet(sources, q):
    """第一個含 q 的那一行（去頭尾空白；太長就切 SNIPPET 字、以命中為中心）。"""
    for src in sources:
        for row in src.splitlines():
            at = row.casefold().find(q)
            if at < 0:
                continue
            row = row.strip()
            at = row.casefold().find(q)
            if len(row) <= SNIPPET:
                return row
            start = max(0, min(at - SNIPPET // 3, len(row) - SNIPPET))
            return ("…" if start else "") + row[start:start + SNIPPET] + ("…" if start + SNIPPET < len(row) else "")
    return ""


def op_find(root, loc, query, tag):
    fs.load(root, loc)                          # 起點要在（NodeMissing 附上一層有哪些）
    q = query.casefold() if query is not None else None
    hits = []
    for at, descs, tags, text in walk(loc, [], [], False, set(), {}):
        name = at.tokens[-1] if at.tokens else os.path.basename(at.fs)
        if q is not None and not (q in name.casefold() or any(q in d.casefold() for d in descs)
                                  or (text is not None and q in text.casefold())):
            continue
        if tag is not None and tag not in tags:
            continue
        line = ("  %s  %s" % (fs.show(root, at), descs[0].replace("\n", " ") if descs else "")).rstrip()
        if q is not None and q not in line.casefold():   # 命中在內文：附命中那一行，腦不用再 read 就知道哪格最對（11-10 S3 小模型實測）
            line += "  [match: %s]" % snippet(([text] if text is not None else []) + descs[1:], q)
        hits.append(line)
    lines = ["node: " + fs.show(root, loc)]
    if not hits:
        return lines + ["matches: (none)"]
    lines += ["matches:"] + hits[:FIND_LIMIT]
    if len(hits) > FIND_LIMIT:
        lines.append("  … %d more (narrow path or query)" % (len(hits) - FIND_LIMIT))
    return lines


fs.install_signals()
args = tool_io.arguments()
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (read, ls or find)")
if op not in ("read", "ls", "find"):
    die("OpUnknown", "%r is not an op; use read, ls or find" % (op,))
max_bytes = args.get("max_bytes", DEFAULT_MAX_BYTES)
if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes <= 0:
    die("ArgumentsBad", "max_bytes must be a positive integer")
query, tag = args.get("query"), args.get("tag")
if op == "find":
    if "query" in args and (not isinstance(query, str) or not query):
        die("ArgumentsBad", "query must be a non-empty string")
    if "tag" in args and not isinstance(tag, str):
        die("ArgumentsBad", "tag must be a string")
    if query is None and tag is None:
        die("ArgumentsBad", "find needs query or tag")
root = fs.knowledge_root(HERE)
try:
    loc = fs.parse(root, args.get("path"))
    if op == "read":
        out = op_read(root, loc)
    elif op == "ls":
        out = op_ls(root, loc)
    else:
        out = op_find(root, loc, query, tag)
except ToolError as error:
    die(error.code, str(error))
print(truncate("\n".join(out), max_bytes))
