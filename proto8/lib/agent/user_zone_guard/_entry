#!/usr/bin/env python3
# user_zone_guard - before_tool 的 hook handler：aos 工具的參數裡有路徑落在使用者專區（~/.aos/user）、又不在它的 mailbox/ 底下、工具也不是唯讀的＝擋（退 10）。
# 使用者 11-13 晚「專區第二階段可以開始了」；規劃 proto8/thinking/2026-11/13/user-zone-plan/04 段 2「守門 hook（eca 身）：aos 工具寫 ~/.aos/user/ 除 mailbox/ 以外一律擋。
#   只是紀律加一道，不是保證」。eca 的 before_tool 只看得到 aos 工具（json_set、jsonx_set…），CLI 自己的 Bash／Write 看不到（知識庫 aos/body.json）。
# 介面：hook handler（lib/agent/hooks.py 用 aos-exec 起）：stdin＝事件 JSON（name、arguments、stack…）；$AOS_WS＝agent 的工作區（相對路徑照它解）。
#   專區＝$AOS_USER_ZONE ＞ ~/.aos/user（跟 aos-user 同一套）。參數裡每個字串（含巢狀）像路徑的（有 / 或開頭 ~）都看：去掉 #/… 指標、展開 ~、相對路徑接 $AOS_WS、realpath。
#   落在專區裡、不在 mailbox/ 裡、工具名不是唯讀（*_get *_ls *_len *_search *_peek *_view、peek_*）＝stdout 一句原因、退 10（工具不跑，agent 看到那句當結果）。其餘＝什麼都不印、退 0。
# 錯：事件 JSON 壞＝stderr 一行「user_zone_guard: error: ArgumentsBad …」、退 1；掛它時用 on_error: continue，壞了只是一行 warning、不停 agent。
import json, os, re, sys

NAME = "user_zone_guard"
HELP = """usage: user_zone_guard < EVENT.json   (a before_tool hook handler)
Block an aos tool call whose arguments point inside the user zone (~/.aos/user, or $AOS_USER_ZONE)
but not inside its mailbox/, unless the tool only reads (*_get, *_ls, *_len, *_search, *_peek, *_view, peek_*).
Blocked = one sentence on stdout and exit 10; the tool does not run. Allowed = nothing printed, exit 0.
Relative paths are taken from $AOS_WS. Only aos tools are seen (on eca, not the CLI's own Bash/Write).
Add it: self_hook {"op": "add", "event": "before_tool", "name": "user_zone_guard",
  "path_json": {"$env": "AOS_HOME", "$path": "/lib/agent/user_zone_guard"}, "on_error": "continue", "timeout_ms": 5000}
exit codes: 0 allowed; 10 blocked; 1 error ("user_zone_guard: error: CODE reason").
"""
READ_ONLY = re.compile(r"(_get|_ls|_len|_search|_peek|_view)$|^peek_|multi_get")

if sys.argv[1:] in (["--help"], ["-h"]):
    sys.stdout.write(HELP)
    sys.exit(0)


def strings(v):
    if isinstance(v, str):
        yield v
    elif isinstance(v, dict):
        for x in v.values():
            yield from strings(x)
    elif isinstance(v, list):
        for x in v:
            yield from strings(x)


def inside(p, root):
    return p == root or p.startswith(root + os.sep)


try:
    ev = json.load(sys.stdin)
    if not isinstance(ev, dict):
        raise ValueError
except ValueError:
    sys.stderr.write("%s: error: ArgumentsBad the event on stdin is not a JSON object\n" % NAME)
    sys.exit(1)
name = ev.get("name") if isinstance(ev.get("name"), str) else ""
if READ_ONLY.search(name):
    sys.exit(0)
zone = os.path.realpath(os.path.expanduser(os.environ.get("AOS_USER_ZONE") or "~/.aos/user"))
box = os.path.join(zone, "mailbox")
ws = os.environ.get("AOS_WS") or os.getcwd()
for s in strings(ev.get("arguments")):
    s = s.split("#", 1)[0].strip()
    if not s or "\n" in s or not ("/" in s or s.startswith("~")):
        continue
    p = os.path.expanduser(s)
    p = os.path.realpath(p if os.path.isabs(p) else os.path.join(ws, p))
    if inside(p, zone) and not inside(p, box):
        print("%s: blocked: %s would touch %s, inside the user zone %s. Agents may only send letters to its "
              "mailbox/ (user_send, or mailbox_send with box %s); never write anywhere else in the zone "
              "(aos/user_zone.json)." % (NAME, name or "this tool", p, zone, box))
        sys.exit(10)
sys.exit(0)
