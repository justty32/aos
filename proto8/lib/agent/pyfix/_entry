#!/usr/bin/env python3
# pyfix - 把一件改 Python 的事交給子 agent（./agent，專改 Python），回它的報告＋改動的 diff
# 介面（lib/README 的契約）：stdin 收 {"task", "dir"?: "."}；stdout 印子 agent 的答案＋「--- 實際改動（diff）---」＋真正的 diff。
# 轉接（「把 agent 包成工具」）用 lib/agent/agent_tool.py：每次呼叫一個新的小格 $AOS_STACK/runs/<三位數>/（子 agent 的工作區 ws/ 與 stack/），
# 這裡多做的：改之前的備份 before/、跑完比對出真正的 diff（出口保證：不只信子 agent 自己說改了什麼）。
# 子 agent 的工具是庫的 ls、read、write、edit、bash（tools/ 裡的捷徑）；要改的資料夾＝$AOS_WS/<dir>（絕對路徑）寫進子 agent 的 stack 的
# pyfix_dir.txt（一行；11-01 起取代環境變數），它的 act 讀那個檔、把工具的工作區換成那裡，所以只碰得到那個資料夾
# （bash 的指令本身擋不住出去，同 lib/base/bash）。PYTHONDONTWRITEBYTECODE=1 往下帶：跑測試不在使用者的程式資料夾留 __pycache__。
# 錯：stderr 與 stdout 各一行「pyfix: error: 代號 原因」、退 1——ArgumentsBad、StackMissing、DirBad、AgentFailed、AnswerMissing。
# 來源：demo/agent-eve/tools/pyfix（10-24；遷移時子 agent 改掛 lib/base 的工具、轉接抽成 agent_tool.py；demo 11-04 刪了）。
import difflib, json, os, sys
HELP = """\
usage: pyfix < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Hand a Python fixing task to a sub-agent working on $AOS_WS/<dir>; print its
report and the actual diff.
Arguments: one JSON object on stdin (empty stdin = {}):
  task  string, required
  dir   string
Result on stdout. On error: one line "pyfix: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
sys.path[:0] = [HERE, os.path.dirname(HERE), os.path.dirname(os.path.dirname(HERE))]   # tool_io.py、agent_tool.py：先找自己資料夾、再找 lib/agent、lib/
import tool_io  # noqa: E402
import agent_tool  # noqa: E402

NAME = "pyfix"
tool_io.start(NAME, HELP)
SNAP_MAX = 256 * 1024          # 備份與 diff 只管這麼大以下的檔
DIFF_MAX = 8000                # 回給外層的 diff 最多幾個字


die = tool_io.die


stack, ws = os.environ.get("AOS_STACK"), os.path.realpath(os.environ.get("AOS_WS", "."))
if not stack:
    die("StackMissing", "AOS_STACK is not set")
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    die("ArgumentsBad", "stdin is not JSON")
if not isinstance(args, dict) or not isinstance(args.get("task"), str) or not args["task"].strip():
    die("ArgumentsBad", "missing task (a non-empty string)")
d = args.get("dir", ".")
if not isinstance(d, str):
    die("ArgumentsBad", "dir must be a string")
root = os.path.realpath(os.path.join(ws, d))
if root != ws and not root.startswith(ws + os.sep):
    die("DirBad", "%r is outside the workspace" % d)
if not os.path.isdir(root):
    die("DirBad", "%r is not a directory" % d)

run = agent_tool.fresh_cell(stack)


def files(top):
    """top 底下要備份／比對的檔：相對路徑 → 內容（不收 . 開頭、__pycache__、太大的、不是 UTF-8 的）"""
    got = {}
    for here, dirs, names in os.walk(top):
        dirs[:] = [x for x in dirs if not x.startswith(".") and x != "__pycache__"]
        for name in names:
            p = os.path.join(here, name)
            if name.startswith(".") or not os.path.isfile(p) or os.path.getsize(p) > SNAP_MAX:
                continue
            try:
                with open(p, encoding="utf-8") as f:
                    got[os.path.relpath(p, top)] = f.read()
            except (OSError, UnicodeDecodeError):
                pass
    return got


before = files(root)
for rel, text in before.items():          # 備份：子 agent 改壞了，從這裡拿回來（不自動還原）
    p = os.path.join(run, "before", rel)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w", encoding="utf-8") as f:
        f.write(text)

os.makedirs(os.path.join(run, "stack"))
with open(os.path.join(run, "stack", "pyfix_dir.txt"), "w", encoding="utf-8") as f:   # 子 agent 的 act 讀：要改的程式在哪
    f.write(root + "\n")
answer = agent_tool.run_agent("agent", args["task"], run, {"PYTHONDONTWRITEBYTECODE": "1"})

after = files(root)
diff = []
for rel in sorted(set(before) | set(after)):
    a, b = before.get(rel), after.get(rel)
    if a != b:
        diff += difflib.unified_diff((a or "").splitlines(True), (b or "").splitlines(True),
                                     "a/" + rel if a is not None else "/dev/null",
                                     "b/" + rel if b is not None else "/dev/null")
diff = "".join(x if x.endswith("\n") else x + "\n" for x in diff)
if len(diff) > DIFF_MAX:
    diff = diff[:DIFF_MAX] + "... (diff too long; %d more chars not shown; the files before the change are in %s)\n" % (len(diff) - DIFF_MAX, run)
sys.stdout.write(answer.rstrip("\n") + "\n\n--- actual changes (diff) ---\n" + (diff or "(no files changed)\n"))
