#!/usr/bin/env python3
# subagent - 我生的子 agent：生、殺、停起、說話、出生後調它的工具／腦／對話／hook；工具自己記帳（subagents.json）、算配額，只碰自己生的
# 使用者 11-10 晚（thinking 2026-11/10/agents-split）：「具備生殺大權的才能在出生後調整子agent的東西」；大權＝工具自己記帳（用這支生的記帳、歸我管、算配額）；
#   say／listen「如果要讓agent使用的話，我會希望只讓他能夠對子agent做」；11-05「工具自己有紀錄，會看到說超過四個，直接回error」。
# 介面（lib/README 的契約）：stdin 收 {"op": …, …}；別的鍵＝ArgumentsBad。
#   add {def | def_json, name, ws | ws_json, stack | stack_json, limits?, envs?, auto_restart?, timeout_s?, on_queued?}
#        先對帳、數配額（滿＝SubagentSlotMissing、不寄信）→ ctl add（旗標一對一，同 agents_ctl；../agents_cmd.py）→ 記帳；印 added … ; subagents N/MAX
#   rm {name, purge?, timeout_s?}  先抄公開子帳 → ctl rm [--purge -y]（預設留 stack）→ 從帳上拿掉
#   stop／sleep {name, timeout_s?}；start／wake {name, timeout_s?, on_queued?}；pause／resume／state {name}＝ctl 同名動作 --target
#   ls {long?, json?}  一行一隻「NAME TAB STATE TAB WORKSPACE TAB QUEUED TAB REASON」（同 ctl ls；排隊中的＝NAME queued - - letter L），末行 subagents N/MAX；
#        long: true＝每行多 ctl ls -l 的四欄 QUEUE RESTARTS COOLDOWN LAST ERROR（照抄 ctl ls -l 那行；排隊中的四欄都是 -）；
#        json: true＝{"subagents": [表上我生的那幾列（ctl ls --json 的整列）；排隊中的＝{name, queued_letter}], "max_subagents": N}；long 和 json 同給＝json
#        （11-10 深夜使用者選「改短版」；之後「1.好」：口徑跟 agents_ctl 一樣，long＝多幾欄文字、json 才是 JSON）
#   say {name, text}＝say --target（話走 stdin）；listen {name, timeout_s | timeout_cycles | last}＝listen --target（都沒給＝等 600 秒）；ask {name, text, timeout_s | timeout_cycles}＝say 接 listen
#   tools／llm／history／hook／system {name, args}：跑旁邊 self_tools／self_llm／self_history／self_hook／self_system（11-11）的 _entry，stdin＝args、AOS_STACK＝<子的 stack>/tools/<那支>/
#        （那支靠 ctl who 認自己＝變成改子的）；stdout 原樣（「your」改成子的名字）；它的錯誤代號與原因接成自己的；旁邊沒那支＝ToolMissing；子還在排隊＝SubagentQueued。
#   每個帶 name 的動作先對帳：不是我生的＝SubagentUnknown；記過但不在表上＝SubagentMissing（之後就忘掉）。ask／listen／rm 抄公開子帳（observed_children.copy_child）。
# 記帳：$AOS_STACK/subagents.json（$AOS_STACK＝我 stack 裡這支的小格 tools/subagent/）＝[{name, stack（相對 $AOS_DAEMON 的真實路徑）} | {name, queued_letter}]；對帳＝名字與 stack 都對得上 ctl ls --json 那列才算還在。
# 配額：max_subagents 從 subagents.json 讀——我的定義那份疊我的 stack 那份（ctl who --json 的 def 與 stack；只放改過的鍵）；都沒有＝4。
# 錯：stderr 與 stdout 各一行「subagent: error: 代號 原因」、退 1；下層 stderr 原樣透出；下層最後一行錯誤行接成自己的（C-52 例外 ⑤）。
import json, os, re, sys
HELP = """\
usage: subagent < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Your own subagents: add | rm | ls | state | stop | start | sleep | wake | pause | resume |
say | listen | ask, and tools | llm | history | hook | system (the self_* tool's arguments, aimed at the subagent).
Only agents started with this tool; counted against max_subagents (subagents.json; default 4).
Result on stdout. On error: one line "subagent: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、旁邊的 lib/agent（agents_cmd）、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE, os.path.dirname(HERE)] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
    import agents_cmd as cmd  # noqa: E402
    from observed_children import copy_child  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name not in ("tool_io", "agents_cmd", "observed_children"):
        raise
    _line = "%s: error: ModuleMissing %s.py not in the tool folder, not in lib/, not on the Python path\n" % (os.path.basename(HERE), error.name)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = os.path.basename(HERE)
tool_io.start(NAME, HELP)
cmd.install_signals()
die = tool_io.die
MAX_SUBAGENTS_DEFAULT = 4
CFG = "subagents.json"          # 配額設定檔（定義與 stack 裡），跟記帳檔同名、不同處
FORWARD = {"tools": "self_tools", "llm": "self_llm", "history": "self_history", "hook": "self_hook", "system": "self_system"}
OPS = dict({"add": cmd.ADD_KEYS, "ls": ("long", "json"), "say": ("name", "text"), "listen": ("name", "timeout_s", "timeout_cycles", "last"),
            "ask": ("name", "text", "timeout_s", "timeout_cycles")},
           **cmd.LIFE_OPS, **{op: ("name", "args") for op in FORWARD})


def load_json(path, missing):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return missing
    except (OSError, ValueError) as e:
        die("ReadFailed", "cannot read %s: %s" % (tool_io.place(path), tool_io.os_reason(e)))


def write_book(kids):
    tmp = os.path.join(stack, ".%s.%d" % (CFG, os.getpid()))
    try:
        os.makedirs(stack, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(json.dumps(kids, ensure_ascii=False) + "\n")
        os.replace(tmp, book_path)
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (tool_io.place(book_path), tool_io.os_reason(e)))


def stack_rel(p):
    """表上的（絕對）stack → 存進帳的：相對 $AOS_DAEMON 的真實路徑（daemon 拼表也從那裡）。"""
    return os.path.relpath(os.path.normpath(p), daemon_base)


def stack_abs(rel):
    return os.path.normpath(os.path.join(daemon_base, rel))


def reconcile():
    """對帳：名字與 stack 都對得上表上那列的才算還在；不在的忘掉（寫回）。回 (還在的, 忘掉的名字, 表)。"""
    kids = load_json(book_path, [])
    if not isinstance(kids, list) or not all(isinstance(k, dict) and isinstance(k.get("name"), str) for k in kids):
        die("ReadFailed", "%s is not a JSON array of {name, stack}" % book_path)
    rows = json.loads(cmd.agent(["ctl", "ls", "--json"]) or "[]")
    rows = [r for r in rows if isinstance(r, dict) and isinstance(r.get("stack"), str)] if isinstance(rows, list) else []
    on_table = {(r.get("name"), os.path.normpath(r["stack"])) for r in rows}
    by_name = {r.get("name"): r for r in rows}
    alive = []
    for kid in kids:
        if kid.get("queued_letter") and not isinstance(kid.get("stack"), str):
            row = by_name.get(kid["name"])            # 排隊中：還沒上表就照記；上表後改記表上的 stack
            alive.append({"name": kid["name"], "stack": stack_rel(row["stack"])} if row else kid)
        elif isinstance(kid.get("stack"), str) and (kid["name"], stack_abs(kid["stack"])) in on_table:
            alive.append(kid)
    gone = [k["name"] for k in kids if k["name"] not in {a["name"] for a in alive}]
    if alive != kids:
        write_book(alive)
    return alive, gone, rows


def max_subagents():
    me = json.loads(cmd.agent(["ctl", "who", "--json"]))
    cfg = {}
    for d in (me.get("def"), me.get("stack")):
        if d:
            v = load_json(os.path.join(d, CFG), {})
            if not isinstance(v, dict):
                die("CfgBad", "%s is not a JSON object" % os.path.join(d, CFG))
            cfg.update(v)
    n = cfg.get("max_subagents", MAX_SUBAGENTS_DEFAULT)
    if isinstance(n, bool) or not isinstance(n, int) or n < 0:
        die("CfgBad", "max_subagents in %s must be a non-negative integer, not %s" % (CFG, json.dumps(n)))
    return n


def my_subagent(name):
    """name 是我生的、還在表上（或還在排隊）＝回帳上那筆；不然 SubagentUnknown／SubagentMissing。"""
    alive, gone, _ = reconcile()
    if name in gone:
        die("SubagentMissing", "%s is no longer on the daemon table (removed elsewhere); forgotten" % name)
    for kid in alive:
        if kid["name"] == name:
            return kid
    die("SubagentUnknown", "%s was not started by you with %s (op ls lists yours)" % (name, NAME))


def preserve_child(name):
    for record in load_json(book_path, []):
        if isinstance(record, dict) and record.get("name") == name and isinstance(record.get("stack"), str):
            copy_child(stack, name, stack_abs(record["stack"]))
            break


args = tool_io.arguments()
op = cmd.check_op(args, OPS)
# ---- 先把參數查完（不碰 daemon、不寄信）----
if op == "add":
    argv = cmd.add_argv(args)
    name = cmd.text(args, "name") or ("" if "def_json" in args else os.path.basename(os.path.normpath(args["def"])))
    if not name:
        die("ArgumentsBad", "add with def_json needs name")
elif op != "ls":
    name = cmd.text(args, "name", True)
if op in cmd.LIFE_OPS:
    argv = cmd.life_argv(op, args)
elif op in ("say", "listen", "ask"):
    waits = [k for k in ("timeout_s", "timeout_cycles", "last") if k in args]
    if len(waits) > 1:
        die("ArgumentsBad", "give only one of %s (got %s)" % (", ".join(k for k in OPS[op] if k not in ("name", "text")), " and ".join(waits)))
    cyc, sec, last = cmd.cycles(args), cmd.seconds(args), args.get("last")
    if last is not None and (isinstance(last, bool) or not isinstance(last, int) or last < 0):
        die("ArgumentsBad", "last must be a whole number (0 or more)")
    words = cmd.text(args, "text", True) if op != "listen" else None
elif op in FORWARD:
    sub = FORWARD[op]
    entry = os.path.join(os.path.dirname(HERE), sub, "_entry")
    if not os.path.isfile(entry):
        die("ToolMissing", "op %s needs the tool %s next to this one (%s), and it is not there" % (op, sub, entry))
    if not isinstance(args.get("args"), dict):
        die("ArgumentsBad", "args must be an object: what %s takes, like {\"op\": \"ls\"}" % sub)
daemon = os.environ.get("AOS_DAEMON")
if not daemon:
    die("DaemonMissing", "AOS_DAEMON is not set (this tool manages subagents on the daemon that runs you)")
stack = os.environ.get("AOS_STACK")
if not stack:
    die("StackMissing", "AOS_STACK is not set")
book_path = os.path.join(stack, CFG)
daemon_base = os.path.realpath(daemon)

if op == "add":
    alive, gone, _ = reconcile()
    n = max_subagents()
    if len(alive) >= n:
        die("SubagentSlotMissing", "you already have %d of max %d subagents (%s); remove one with op rm first "
            "(max_subagents is set in %s of your definition or your stack)" % (len(alive), n, ", ".join(k["name"] for k in alive) or "-", CFG))
    cmd.make_ws(args)
    result = cmd.parse_added(cmd.agent(argv, timeout_s=cmd.guard(args)))
    record = {"name": name, "queued_letter": result["queued_letter"]} if "queued_letter" in result else {"name": name, "stack": stack_rel(result["stack"])}
    write_book([k for k in alive if k["name"] != name] + [record])
    print("%s; subagents %d/%d" % (result.get("message") or "added %s (stack %s)" % (name, result["stack"]), len(alive) + 1, n))
    sys.exit(0)

if op == "ls":
    alive, _, rows = reconcile()
    on = {k["name"]: stack_abs(k["stack"]) for k in alive if "stack" in k}
    listed = [r for r in rows if on.get(r.get("name")) == os.path.normpath(r["stack"])]
    queued = [{"name": k["name"], "queued_letter": k["queued_letter"]} for k in alive if "stack" not in k]
    n = max_subagents()
    if cmd.flag(args, "json"):
        print(json.dumps({"subagents": listed + queued, "max_subagents": n}, ensure_ascii=False))
        sys.exit(0)
    long = cmd.flag(args, "long")
    lines = {}
    if long and listed:                         # 多的四欄照抄 ctl ls -l 那行（同名那列）
        lines = {l.split("\t", 1)[0]: l for l in cmd.agent(["ctl", "ls", "-l"]).splitlines() if l.strip()}
    dash = lambda v: "-" if v is None or v == "" else " ".join(str(v).split())
    for r in listed:
        cols = [r["name"], dash(r.get("state")), dash(r.get("ws")), dash(r.get("queued")), dash(r.get("reason"))]
        print(lines.get(r["name"]) or "\t".join(cols + (["-"] * 4 if long else [])))
    for q in queued:
        print("\t".join([q["name"], "queued", "-", "-", "letter %s" % q["queued_letter"]] + (["-"] * 4 if long else [])))
    print("subagents %d/%d" % (len(listed) + len(queued), n))
    sys.exit(0)

kid = my_subagent(name)
if op in cmd.LIFE_OPS:
    if op == "rm":
        preserve_child(name)
    out = cmd.agent(argv, timeout_s=cmd.life_guard(op, args))
    if op == "rm":
        write_book([k for k in load_json(book_path, []) if k.get("name") != name])
elif op in ("say", "listen", "ask"):
    if op != "listen":
        out = cmd.agent(["say", "--target", name], text=words)
    if op != "say":
        try:
            if cyc is not None:
                out = cmd.agent(["listen", "--target", name, "--timeout-cycles", str(cyc)], timeout_cycles=cyc + 30)
            elif last is not None:
                out = cmd.agent(["listen", "--target", name, "--last", str(last)])
            else:
                sec = sec or cmd.LISTEN_DEFAULT_S
                out = cmd.agent(["listen", "--target", name, "--timeout-s", "%g" % sec], timeout_s=sec + 30)
        finally:
            preserve_child(name)
else:                                           # tools／llm／history／hook／system：用子的身分跑旁邊的 self_*
    if not isinstance(kid.get("stack"), str):
        die("SubagentQueued", "%s is still queued (letter %s) and has no stack yet; try again when op ls shows it on the table" % (name, kid.get("queued_letter")))
    env = dict(os.environ, AOS_STACK=os.path.join(stack_abs(kid["stack"]), "tools", sub))
    out = cmd.must([entry], text=json.dumps(args["args"], ensure_ascii=False), timeout_s=150, env=env,
                   err_re=re.compile(re.escape(sub) + r": error: ([A-Z][A-Za-z]+) (.*)\Z"))
    out = out.replace("your next", "%s's next" % name).replace("your body", "%s's body" % name)
cmd.emit(out)
