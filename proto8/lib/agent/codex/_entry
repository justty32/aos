#!/usr/bin/env python3
# codex - 把 stdin 的 {"prompt": "..."} 交給 codex CLI 做，stdout 印它的回答；對話續在這個工具的小格（$AOS_STACK），人可以用 agent 的 attach 接進去
# 介面（lib/README 的契約）：stdin 收 {"prompt"}；錯：stderr 與 stdout 各一行「codex: error: 代號 原因」、退 1（ArgumentsBad、CliMissing、CliFailed、SessionBad…）。
# 怎麼叫 CLI（旗標、逾時 timeout_ms）在同資料夾的 cli.json；做法在 proto8/py/cli_session.py（claude、codex 共用）。
# 10-30 eca 第 5 步：這就是 eca 的「工具形」——跟 aos-eca-turn --one（proto8/cmd/aos-eca/bin）走同一支 cli_session.call_main
# （問 CLI 那段是 cli_session.ask，平級形的 aos-eca-turn 也叫它；這裡用 on_busy 預設 yield）；不改成 exec aos-eca-turn：多一層行程。
# 來源：demo/agent-fay/tools/codex（10-24 遷移；agent-fay 11-03 晚刪了）。找 cli_session.py：先找工具自己、上一層與 agent 根，再找 proto8/py；
# 複製出 repo 時，最後從 PATH 上 aos-tools 的 cmd/aos-tools/bin 回到 proto8/py。
import os, shutil, sys
here = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
sys.path[:0] = [here, os.path.dirname(here), os.path.dirname(os.path.dirname(here)),
                os.path.join(here, "..", "..", "..", "py")]
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(shutil.which("aos-tools") or "/")), "..", "..", "..", "py"))
import cli_session  # noqa: E402
cli_session.call_main(here)
