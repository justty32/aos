#!/usr/bin/env python3
# memory_export - 把記憶庫（資料夾＋.json 的 JSON 樹）或其中一棵子樹整棵印成一份 Markdown，給人看；唯讀。
# 規劃：proto8/thinking/2026-11/05/agent-knowledge/03-接進agent與工具說明.md K6（使用者 11-05「人類想看的話，要麼直接問agent，
#   要麼agent弄一份輕鬆轉為markdown/html的工具，把json轉過去也可以」）；11-10 改逛純 JSON 樹（圖紙 thinking/2026-11/10/json-memory/04）。
# 介面（lib/docs/01 契約）：stdin {"path"?: 統一路徑, "max_bytes"?: N}。庫根與統一路徑的認法跟 memory_read 一模一樣
#   （--root ＞ _memory.json 的 base ＞ $AOS_MEMORY，都沒有＝MemoryMissing；`資料夾/檔.json#/JSON Pointer`，相對從庫根算，"" 或 "/"＝根），共用 lib/agent/memory_fs.py，不 import 隔壁工具。
# stdout：從 path（沒給＝根）開始深度優先；每個位置先一行「<!-- node: 路徑 -->」（路徑可直接貼回 memory_read 的 path），接著：
#   資料夾或有 _index 的物件＝自己的簡介（資料夾的 _description.json、物件的 _description key），再依序印表裡的格（照表的順序）、再印表沒列的（not in index）；
#   只有 _description 沒 _index 的物件＝簡介，其餘 key 包成 ```json 區塊；字串＝原文照接（標題層級不改）；其他 JSON 值（沒 _index 的物件、陣列、數字…）＝包成 ```json 區塊；
#   非 .json 檔＝UTF-8 原文，不是 UTF-8＝「binary file, N bytes」；指不到／讀不到的格＝一行括號裡的代號與原因、照樣往下。位置之間空一行。
#   防繞圈：走過的（實體路徑, 指標）再遇到＝只印一行「already exported above; not followed」；$env 格只跳一次、不連跳。
#   超過 max_bytes（預設 50000）就截，最後一行「[truncated: N more bytes; export a child path]」。
# 錯：「memory_export: error: 代號 原因」stderr 與 stdout 各一行、退 1：ArgumentsBad、PathBad、MemoryMissing、MemoryBad、CfgBad、NodeMissing、
#   TargetBad、FileBad、DirectiveBad、ReadFailed、LaunchFailed（起點讀不到才算錯；子孫讀不到印在文件裡）。子行程只有 aos-json（與 $env 格的 aos-directive）。
import json, os, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib, os.path.join(_lib, "agent")] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

HELP = """\
usage: memory_export [--root DIR] < ARGUMENTS.json   (a tool: run it with aos-exec)
Print a whole memory (folders and .json files), or the subtree at path, as one
Markdown document, for people. path looks like folder/file.json#/key (as in tool
memory_read); "" or "/" is the root (default).
Each place starts with a line <!-- node: PATH -->. A folder or an object with
_index prints its own description (a folder's _description.json, an object's
_description key), then its index entries in order, then what the index does
not list. Strings are printed as they are; other JSON values go
in a ```json block. A place already printed is not followed again. Output over
max_bytes (default 50000) is cut; then export a child path.
Needs aos-json on PATH. The memory root: --root DIR (command line only, not a
JSON argument), else _memory.json {"base": DIR} next to the tool, else
AOS_MEMORY. No default: none of them = MemoryMissing; not a folder = MemoryBad.
Result on stdout. On error: one line "memory_export: error: CODE reason" on stderr and stdout, exit 1.
"""
die = tool_io.die
try:
    import memory_fs as fs
except ModuleNotFoundError as error:
    if error.name != "memory_fs":
        raise
    die("ModuleMissing", "memory_fs.py not in the tool folder, not in lib/agent/, not on the Python path", prog="memory_export")
fs.take_root_flag("memory_export")              # --root DIR 不是 JSON 參數：先從 argv 拿掉，再交 tool_io 映射其餘旗標
tool_io.start("memory_export", HELP)
ToolError = fs.ToolError
DEFAULT_MAX_BYTES = 50000


def body(loc, kind, value, table):
    """這個位置自己要印的那段（不含子孫）。"""
    intro = fs.intro(kind, loc, value, lambda f: fs.get(fs.Loc(f, None))).rstrip("\n")
    if kind == "folder" or table is not None:
        return intro
    if intro:
        rest = fs.without_intro(value)
        return intro + ("\n\n```json\n%s\n```" % json.dumps(rest, ensure_ascii=False, indent=2) if rest else "")
    if kind == "binary":
        return "binary file, %d bytes" % value
    if kind == "text" or isinstance(value, str):
        return value.rstrip("\n")
    return "```json\n%s\n```" % json.dumps(value, ensure_ascii=False, indent=2)


def export(root, loc, out, seen, via_env, first=False):
    """深度優先印 loc：先自己，再表的格（$env 格只跳一次），再表沒列的。"""
    head = "<!-- node: %s -->" % fs.show(root, loc)
    key = (os.path.realpath(loc.fs), loc.tokens)
    if key in seen:
        out.append(head + "\n(already exported above; not followed)")
        return
    seen.add(key)
    try:
        kind, value, table, kids = fs.load(root, loc)
        text = body(loc, kind, value, table)
    except ToolError as error:
        if first:
            raise
        out.append("%s\n(%s %s)" % (head, error.code, error))
        return
    out.append(head + ("\n" + text if text else ""))
    if kind != "folder" and table is None:
        return                                   # 沒 _index 的物件、陣列整個在 ```json 裡，不再往下拆
    covered = set()
    for c in fs.cells(loc, table or {}, kind != "folder"):
        if c.target is None:
            out.append("<!-- node: %s -->\n(%s)" % (c.key, c.note))
            continue
        covered.add(c.target)
        if c.env and via_env:
            continue
        export(root, c.target, out, seen, via_env or c.env)
    for k in kids:
        if k not in covered:
            export(root, k, out, seen, via_env)


fs.install_signals()
args = tool_io.arguments()
max_bytes = args.get("max_bytes", DEFAULT_MAX_BYTES)
if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes <= 0:
    die("ArgumentsBad", "max_bytes must be a positive integer")
root = fs.memory_root(HERE)
out = []
try:
    export(root, fs.parse(root, args.get("path")), out, set(), False, first=True)
except ToolError as error:
    die(error.code, str(error))
doc = ("\n\n".join(out) + "\n").encode("utf-8")
if len(doc) > max_bytes:
    sys.stdout.write(doc[:max_bytes].decode("utf-8", "ignore").rstrip("\n") +
                     "\n[truncated: %d more bytes; export a child path]\n" % (len(doc) - max_bytes))
else:
    sys.stdout.write(doc.decode("utf-8"))
