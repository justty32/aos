#!/usr/bin/env python3
# memory_export - 把一個知識庫（或其中一棵子樹）整棵印成一份 Markdown，給人看；唯讀
# 規劃：proto8/thinking/2026-11/05/agent-knowledge/03-接進agent與工具說明.md K6（使用者 11-05「人類想看的話，要麼直接問agent，
#   要麼agent弄一份輕鬆轉為markdown/html的工具，把json轉過去也可以」）。另立工具、memory 保持純查詢（03 代定）。
# 介面（lib/docs/01 契約）：stdin {"path"?: 節點路徑, "max_bytes"?: N}。知識庫根、節點、子節點的認法跟 memory 一模一樣
#   （① 工具資料夾 $AOS_CD 的 _memory.json 的 base ＞ ② $AOS_MEMORY，相對 $AOS_DAEMON、沒有＝cwd；. 與 _ 開頭不算；同名資料夾蓋過葉、.md 蓋過 .json）。
#   節點介面共用 lib/agent/memory_fs.py，不 import 隔壁工具。
# stdout：從 path（沒給＝根）開始深度優先、子節點照名字排序；每個節點先一行「<!-- node: 路徑 -->」，
#   .md 的文原樣接上（標題層級不改），.json 的文包成 ```json 區塊（前面加「# 節點名」當標題）；節點之間空一行。
#   捷徑繞回這次印的上層資料夾＝那個節點只印一行「not followed」、不往下（11-05 晚）。
#   超過 max_bytes（預設 50000）就截，最後一行「[truncated: N more bytes; export a child path]」。
# 錯：「memory_export: error: 代號 原因」stderr 與 stdout 各一行、退 1：ArgumentsBad、PathBad、MemoryMissing、NodeMissing、CfgBad、ReadFailed。
import json, os, re, sys
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

HELP = """\
usage: memory_export < ARGUMENTS.json   (a tool: run it with aos-exec)
Print a whole knowledge base (or the subtree at path) as one Markdown document, for people.
The knowledge base is found like tool memory finds it (_memory.json next to the tool, else $AOS_MEMORY).
Result on stdout. On error: one line "memory_export: error: CODE reason" on stderr and stdout, exit 1.
"""
tool_io.start("memory_export", HELP)
die = tool_io.die
# 共用節點介面：工具本地優先，再找 lib/agent，最後標準 Python 路徑。
if os.path.basename(_lib) == "lib":
    sys.path.insert(1, os.path.join(_lib, "agent"))
try:
    try:
        import memory_fs
    except ModuleNotFoundError as error:
        if error.name != "memory_fs":
            raise
        import agent.memory_fs as memory_fs
except ModuleNotFoundError as error:
    if error.name not in ("memory_fs", "agent", "agent.memory_fs"):
        raise
    die("ModuleMissing", "memory_fs.py not in the tool folder, not in lib/agent/, not on the Python path")
SEGMENT = memory_fs.SEGMENT
LEAF_EXTS = memory_fs.LEAF_EXTS
memory_root = memory_fs.memory_root
parse_path = memory_fs.parse_path
show = memory_fs.show
locate = memory_fs.locate
leaf_file = memory_fs.leaf_file
children = memory_fs.children
title_summary = memory_fs.title_summary
read_text = memory_fs.read_text
node_or_die = memory_fs.node_or_die


def export(root, segs, out, chain=()):
    d = os.path.join(root, *segs)
    label = "/".join(segs) or "/"
    if os.path.isdir(d):
        real = os.path.realpath(d)
        if real in chain:                       # 捷徑繞回上層（11-05 晚邊緣測試：原本一路印到路徑太長）
            out.append("<!-- node: %s -->\n(a link back to an outer folder of this export; not followed)" % label)
            return
        chain += (real,)
        f = os.path.join(d, "README.md")
        text = read_text("dir", d)
    else:
        hit = locate(root, segs)
        if hit is None:
            die("NodeMissing", "node %s not found" % label)
        _, f = hit
        text = read_text("leaf", f)
        if f.endswith(".json"):
            text = "# %s\n\n```json\n%s\n```" % (segs[-1], text.rstrip("\n"))
    out.append("<!-- node: %s -->\n%s" % (label, text.rstrip("\n")))
    if os.path.isdir(d):
        for name, _ in children("dir", d):
            export(root, segs + [name], out, chain)


args = tool_io.arguments()
segs = parse_path(args.get("path"))
max_bytes = args.get("max_bytes", 50000)
if isinstance(max_bytes, bool) or not isinstance(max_bytes, int) or max_bytes <= 0:
    die("ArgumentsBad", "max_bytes must be a positive integer")
out = []
export(memory_root(HERE), segs, out)
doc = ("\n\n".join(out) + "\n").encode("utf-8")
if len(doc) > max_bytes:
    sys.stdout.write(doc[:max_bytes].decode("utf-8", "ignore").rstrip("\n") +
                     "\n[truncated: %d more bytes; export a child path]\n" % (len(doc) - max_bytes))
else:
    sys.stdout.write(doc.decode("utf-8"))
