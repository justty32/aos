#!/usr/bin/env python3
# json_rewrite - 「小念頭」式兩步改 JSON：stdin {"file": "fsm.json", "want": "把 act 那格的逾時改成 30 秒"}，在 $AOS_WS 底下改。
# 使用者 10-24：「修改的時候也是，AI可以一次生成一大堆函數，也可以一次生成一個值。這就需要用到小念頭概念，
# 也就是拆成"找到要修改的key"->"提供值"」。
#   一、找到要修改的 key：腦一開始只看到頂層（aos-json peek），用 peek 一層層往下，找到後呼叫 found 交出一個或多個 JSON 指標。
#   二、提供值：每個指標各問一次腦（一個小念頭，不帶第一步的對話）：只給要做的事、那個位置現在的值、上一層的摘要；
#       腦呼叫 give 交出那個位置的新值（JSON 文字，先解得開才收，解不開讓它重給，最多 3 次）。
#   最後 aos-json batch --check --follow 一次寫進去（全部驗過才寫；拆成 $ref 的檔也改得到）。
# 腦＝寄請求給 llm kernel、同步等回信：`aos-llm ask`（stdin＝{"request": {messages, tools, tool_choice}}；用 kernel 的預設代號，
#   thinking 2026-11-04 think-as-function 03 § 3）；$AOS_LLM_KERNEL 沒設由 aos-llm 報 LlmKernelMissing、這裡退 1（BrainFailed）。
# stdout：走過的位置（看過）、找到的位置、改了什麼。
# 錯照 lib 契約（stdio-unify R2，11-05 起；之前寫不進去印「not changed」退 0）：stderr 與 stdout 各一行「json_rewrite: error: 代號 原因」、退 1——
#   stdin 不對（ArgumentsBad）、file 不在工作區（PathBad）、腦連不上（BrainFailed）、回覆不對（ReplyBad）、找了 MAX_ROUNDS 輪還沒交（PointerMissing）、
#   aos-json 起不來（LaunchFailed）；aos-json 讀寫失敗＝接它錯誤行 `aos-json: error: 代號 原因` 的代號與原因（同 aos_json），沒那行＝CommandFailed。
#   寫不進去時 seen／found 兩行照印在錯誤行前面。aos-json、aos-llm 的 stderr 原樣透到 stderr。
# --help＝英文說明印 stdout、退 0；Ctrl-C＝退 130、不吐 traceback。
import json, os, re, subprocess, sys, tempfile

HELP = """\
usage: json_rewrite [FLAGS] < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Change a JSON file in two small steps: the brain first walks down with peek and names the
places (found), then gives each new value (give); written with aos-json batch --check --follow.
Result on stdout: seen, found and one changed line per place.
On error: one line "json_rewrite: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "json_rewrite"
tool_io.start(NAME, HELP)
die = tool_io.die

MAX_ROUNDS = 12                                    # 找 key 最多問幾輪（寫死；11-01 前可用環境變數調，沒人調過、拿掉）
ERR_RE = re.compile(r"aos-json: error: ([A-Z][A-Za-z]+) (.*)\Z")


def aos_json(*argv, stdin=None):
    """回 (結束碼, stdout, (代號, 原因))；aos-json 的 stderr 原樣透出，錯誤行的代號與原因另外拆出來。"""
    try:
        # 寫入值經檔案傳入，避免下層提早關 stdin 時被 SIGPIPE 打斷。
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as command_input:
            command_input.write(stdin or "")
            command_input.seek(0)
            r = subprocess.run(["aos-json", *argv], cwd=WS, stdin=command_input, capture_output=True, text=True)
    except OSError as e:
        die("LaunchFailed", "aos-json failed to start (aos-json must be on PATH): %s" % e)
    if r.stderr:
        sys.stderr.write(r.stderr if r.stderr.endswith("\n") else r.stderr + "\n")
    m = [x for x in map(ERR_RE.match, r.stderr.strip().splitlines()) if x]
    err = (m[-1].group(1), m[-1].group(2)) if m else ("CommandFailed", "aos-json %s exited %d" % (argv[0], r.returncode))
    return r.returncode, r.stdout, err


def ask(messages, tools):
    request = {"request": {"messages": messages, "tools": tools, "tool_choice": "required"}}
    try:
        # 下層提早退掉時不向已關閉的 pipe 寫入，避免 tool_io 的 SIGPIPE 預設蓋過 BrainFailed。
        with tempfile.TemporaryFile(mode="w+", encoding="utf-8") as request_input:
            json.dump(request, request_input, ensure_ascii=False)
            request_input.seek(0)
            r = subprocess.run(["aos-llm", "ask"], stdin=request_input,
                               stdout=subprocess.PIPE, text=True)  # stderr 不吞：aos-llm 自己說原因（LlmKernelMissing、kernel 回的錯）
    except OSError as e:
        die("BrainFailed", "aos-llm failed to start (aos-llm must be on PATH): %s" % e)
    if r.returncode != 0:
        die("BrainFailed", "aos-llm ask exited %d" % r.returncode)
    try:
        message = json.loads(r.stdout)
    except ValueError as e:
        die("ReplyBad", "aos-llm ask did not print JSON: %s" % e)
    if not isinstance(message, dict):
        die("ReplyBad", "the reply message is not an object")
    calls = message.get("tool_calls") or []
    out = {"role": "assistant", "content": message.get("content")}
    if calls:
        out["tool_calls"] = [{k: c[k] for k in ("id", "type", "function") if k in c} for c in calls]
    return out, calls


def fn(name, description, properties, required):
    return {"type": "function", "function": {"name": name, "description": description, "parameters": {
        "type": "object", "properties": properties, "required": required}}}


def call_args(call):
    try:
        a = json.loads(call["function"].get("arguments") or "{}")
        return a if isinstance(a, dict) else {}
    except (ValueError, KeyError, TypeError, AttributeError):
        return {}


job = tool_io.arguments("file", "want")
if not all(job[k].strip() for k in ("file", "want")):
    die("ArgumentsBad", "file and want must be non-empty strings")
WS = tool_io.workspace()
path, want = job["file"], job["want"].strip()
if os.path.isabs(path) or ".." in path.split("/") or "#" in path:
    die("PathBad", "file must be a relative path inside the workspace (no absolute path, .., or #): %s" % path)
if os.path.commonpath([WS, os.path.realpath(os.path.join(WS, path))]) != WS:
    die("PathBad", "file is outside the workspace: %s" % path)
rc, top, err = aos_json("peek", "--follow", path)
if rc != 0:
    die(*err)

# 一、找到要修改的 key（漸進展開）
seen = ["/"]
messages = [
    {"role": "system", "content": "Find the places to change in a JSON file. Initially you see only the top level; large values are folded into summaries ({N} for objects, [N] for arrays). "
                                  "Call peek to inspect a key, one level at a time, using a JSON pointer starting with / (for example /states/think). "
                                  "When you find the places to change or add, call found with their pointers; do not write values yourself."},
    {"role": "user", "content": "Task: %s\nFile: %s\nTop level:\n%s" % (want, path, top)}]
tools = [fn("peek", "Inspect the next level at a location", {"pointer": {"type": "string", "description": "JSON pointer starting with /"}}, ["pointer"]),
         fn("found", "Return the places to change", {"pointers": {"type": "array", "items": {"type": "string"},
                                              "description": "List of JSON pointers starting with /"}}, ["pointers"])]
pointers = None
for _ in range(MAX_ROUNDS):
    message, calls = ask(messages, tools)
    messages.append(message)
    if not calls:
        messages.append({"role": "user", "content": "Please call peek or found."})
        continue
    for call in calls:
        name, a = (call.get("function") or {}).get("name"), call_args(call)
        if name == "found" and isinstance(a.get("pointers"), list) and a["pointers"] and \
                all(isinstance(p, str) and p.startswith("/") for p in a["pointers"]):
            pointers = a["pointers"]
            reply = "ok"
        elif name == "peek" and isinstance(a.get("pointer"), str) and (a["pointer"] in ("", "/") or a["pointer"].startswith("/")):
            ptr = "" if a["pointer"] == "/" else a["pointer"]
            seen.append(ptr or "/")
            rc, out, err = aos_json("peek", "--follow", path + ("#" + ptr if ptr else ""))
            reply = out if rc == 0 else "error: %s %s" % err
        else:
            reply = "error: peek takes {pointer: \"/...\"}, found takes {pointers: [\"/...\"]}"
        messages.append({"role": "tool", "tool_call_id": call.get("id"), "content": reply})
    if pointers:
        break
if not pointers:
    die("PointerMissing", "asked %d rounds, the brain has not given the places to change" % MAX_ROUNDS)

# 二、提供值：每個位置一個小念頭，只看那一處
give = [fn("give", "Return the new value for this location", {"json": {"type": "string", "description": "New value as JSON text, for example 30000, \"abc\", or {\"a\": 1}"}},
           ["json"])]
values = {}
for ptr in pointers:
    rc, cur, _ = aos_json("get", "--follow", path + "#" + ptr)
    cur = cur.strip() if rc == 0 else "(This location does not exist yet; it will be added.)"
    parent = ptr.rsplit("/", 1)[0]
    rc, around, _ = aos_json("peek", "--follow", path + ("#" + parent if parent else ""))
    messages = [{"role": "system", "content": "You are a small helper responsible only for the new value at one JSON location. Call give with the new value as JSON text."},
                {"role": "user", "content": "Task: %s\nLocation: %s#%s\nCurrent value: %s\nParent level:\n%s" %
                                            (want, path, ptr, cur, around if rc == 0 else "(unavailable)")}]
    for _ in range(3):
        message, calls = ask(messages, give)
        messages.append(message)
        if not calls:
            messages.append({"role": "user", "content": "Please call give with the new value as JSON text in the json argument."})
            continue
        text = call_args(calls[0]).get("json")
        try:
            if not isinstance(text, str):
                raise ValueError("missing json argument")
            values[ptr] = json.loads(text)
            break
        except ValueError as e:
            for c in calls:
                messages.append({"role": "tool", "tool_call_id": c.get("id"), "content": "error: not JSON (%s); give it again" % e})
    if ptr not in values:
        die("ReplyBad", "%s: asked 3 times without getting a parseable JSON value" % ptr)

rc, _, err = aos_json("batch", "--check", "--follow", path, stdin=json.dumps(values, ensure_ascii=False))
print("seen: " + " -> ".join(seen))
print("found: " + ", ".join(pointers))
if rc != 0:
    die(*err)
for ptr, v in values.items():
    print("changed: %s#%s = %s" % (path, ptr, json.dumps(v, ensure_ascii=False)))
