#!/usr/bin/env python3
# json_edit - 「小念頭」式兩步改 JSON：stdin {"file": "fsm.json", "want": "把 act 那格的逾時改成 30 秒"}，在 $AOS_WS 底下改。
# 使用者 10-24：「修改的時候也是，AI可以一次生成一大堆函數，也可以一次生成一個值。這就需要用到小念頭概念，
# 也就是拆成"找到要修改的key"->"提供值"」。
#   一、找到要修改的 key：腦一開始只看到頂層（aos-json peek），用 peek 一層層往下，找到後呼叫 found 交出一個或多個 JSON 指標。
#   二、提供值：每個指標各問一次腦（一個小念頭，不帶第一步的對話）：只給要做的事、那個位置現在的值、上一層的摘要；
#       腦呼叫 give 交出那個位置的新值（JSON 文字，先解得開才收，解不開讓它重給，最多 3 次）。
#   最後 aos-json batch --check --follow 一次寫進去（全部驗過才寫；拆成 $ref 的檔也改得到）。
# 腦＝寄請求給 llm kernel、同步等回信：`aos-llm ask`（stdin＝{"request": {messages, tools, tool_choice}}；用 kernel 的預設代號，
#   thinking 2026-11-04 think-as-function 03 § 3）；$AOS_LLM_KERNEL 沒設由 aos-llm 報 LlmKernelMissing、這裡退 1（BrainFailed）。
# stdout：走過的位置（看過）、找到的位置、改了什麼。
# 錯照 lib 契約（stdio-unify R2，11-05 起；之前寫不進去印「not changed」退 0）：stderr 與 stdout 各一行「json_edit: error: 代號 原因」、退 1——
#   stdin 不對（ArgumentsBad）、file 不在工作區（PathBad）、腦連不上（BrainFailed）、回覆不對（ReplyBad）、找了 MAX_ROUNDS 輪還沒交（PointerMissing）、
#   aos-json 起不來（LaunchFailed）；aos-json 讀寫失敗＝接它錯誤行 `aos-json: error: 代號 原因` 的代號與原因（同 tools/json），沒那行＝CommandFailed。
#   寫不進去時 seen／found 兩行照印在錯誤行前面。aos-json、aos-llm 的 stderr 原樣透到 stderr。
# --help＝英文說明印 stdout、退 0；Ctrl-C＝退 130、不吐 traceback。
import json, os, re, signal, subprocess, sys

HELP = """\
usage: json_edit < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace, $AOS_LLM_KERNEL the brain)
Change a JSON file in the workspace in two small steps: the brain first walks down with peek
and names the places (found), then gives each new value (give); written with aos-json batch --check.
Arguments: one JSON object on stdin:
  file  string (relative to the workspace), required
  want  string (what to change), required
Result on stdout: seen, found and one changed line per place.
On error: one line "json_edit: error: CODE reason" on stderr and stdout, exit 1.
"""
if "--help" in sys.argv[1:]:                    # --help：英文說明印 stdout、退 0（stdio-unify R3）
    sys.stdout.write(HELP)
    sys.exit(0)
signal.signal(signal.SIGINT, lambda signum, frame: sys.exit(130))   # Ctrl-C：不吐 traceback、退 130（R12）

MAX_ROUNDS = 12                                    # 找 key 最多問幾輪（寫死；11-01 前可用環境變數調，沒人調過、拿掉）
WS = os.environ.get("AOS_WS") or "."
ERR_RE = re.compile(r"aos-json: error: ([A-Z][A-Za-z]+) (.*)\Z")


def die(code, reason):
    line = "json_edit: error: %s %s" % (code, str(reason).replace("\n", " "))
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


def aos_json(*argv, stdin=None):
    """回 (結束碼, stdout, (代號, 原因))；aos-json 的 stderr 原樣透出，錯誤行的代號與原因另外拆出來。"""
    try:
        r = subprocess.run(["aos-json", *argv], cwd=WS, input=stdin, capture_output=True, text=True)
    except OSError as e:
        die("LaunchFailed", "aos-json failed to start (aos-json must be on PATH): %s" % e)
    if r.stderr:
        sys.stderr.write(r.stderr if r.stderr.endswith("\n") else r.stderr + "\n")
    m = [x for x in map(ERR_RE.match, r.stderr.strip().splitlines()) if x]
    err = (m[-1].group(1), m[-1].group(2)) if m else ("CommandFailed", "aos-json %s exited %d" % (argv[0], r.returncode))
    return r.returncode, r.stdout, err


def ask(messages, tools):
    request = {"request": {"messages": messages, "tools": tools, "tool_choice": "required"}}
    try:
        r = subprocess.run(["aos-llm", "ask"], input=json.dumps(request, ensure_ascii=False),
                           stdout=subprocess.PIPE, text=True)      # stderr 不吞：aos-llm 自己說原因（LlmKernelMissing、kernel 回的錯）
    except OSError as e:
        die("BrainFailed", "aos-llm failed to start (aos-llm must be on PATH): %s" % e)
    if r.returncode != 0:
        die("BrainFailed", "aos-llm ask exited %d" % r.returncode)
    try:
        message = json.loads(r.stdout)
    except ValueError as e:
        die("ReplyBad", "aos-llm ask did not print JSON: %s" % e)
    if not isinstance(message, dict):
        die("ReplyBad", "the reply message is not an object")
    calls = message.get("tool_calls") or []
    out = {"role": "assistant", "content": message.get("content")}
    if calls:
        out["tool_calls"] = [{k: c[k] for k in ("id", "type", "function") if k in c} for c in calls]
    return out, calls


def fn(name, description, properties, required):
    return {"type": "function", "function": {"name": name, "description": description, "parameters": {
        "type": "object", "properties": properties, "required": required}}}


def call_args(call):
    try:
        a = json.loads(call["function"].get("arguments") or "{}")
        return a if isinstance(a, dict) else {}
    except (ValueError, KeyError, TypeError, AttributeError):
        return {}


try:
    job = json.loads(sys.stdin.read() or "null")
except ValueError:
    die("ArgumentsBad", "stdin is not JSON")
if not isinstance(job, dict) or not all(isinstance(job.get(k), str) and job[k].strip() for k in ("file", "want")):
    die("ArgumentsBad", "expects {\"file\": FILE, \"want\": what to change}")
path, want = job["file"], job["want"].strip()
if os.path.isabs(path) or ".." in path.split("/") or "#" in path:
    die("PathBad", "file must be a relative path inside the workspace (no absolute path, .., or #): %s" % path)
rc, top, err = aos_json("peek", "--follow", path)
if rc != 0:
    die(*err)

# 一、找到要修改的 key（漸進展開）
seen = ["/"]
messages = [
    {"role": "system", "content": "你在一份 JSON 檔裡找出要改的位置。你一開始只看得到頂層；大的值摺成摘要（{N} 是物件、[N] 是陣列）。"
                                  "想看哪個 key 就呼叫 peek（指標用 JSON pointer，/ 開頭，例 /states/think），一次看一層。"
                                  "找到要改（或要新加）的位置就呼叫 found，交出它們的指標；不要自己寫值。"},
    {"role": "user", "content": "要做的事：%s\n檔：%s\n頂層：\n%s" % (want, path, top)}]
tools = [fn("peek", "看某個位置的下一層", {"pointer": {"type": "string", "description": "JSON pointer，/ 開頭"}}, ["pointer"]),
         fn("found", "交出要改的位置", {"pointers": {"type": "array", "items": {"type": "string"},
                                              "description": "JSON pointer 清單，/ 開頭"}}, ["pointers"])]
pointers = None
for _ in range(MAX_ROUNDS):
    message, calls = ask(messages, tools)
    messages.append(message)
    if not calls:
        messages.append({"role": "user", "content": "請呼叫 peek 或 found。"})
        continue
    for call in calls:
        name, a = (call.get("function") or {}).get("name"), call_args(call)
        if name == "found" and isinstance(a.get("pointers"), list) and a["pointers"] and \
                all(isinstance(p, str) and p.startswith("/") for p in a["pointers"]):
            pointers = a["pointers"]
            reply = "ok"
        elif name == "peek" and isinstance(a.get("pointer"), str) and (a["pointer"] in ("", "/") or a["pointer"].startswith("/")):
            ptr = "" if a["pointer"] == "/" else a["pointer"]
            seen.append(ptr or "/")
            rc, out, err = aos_json("peek", "--follow", path + ("#" + ptr if ptr else ""))
            reply = out if rc == 0 else "error: %s %s" % err
        else:
            reply = "error: peek takes {pointer: \"/...\"}, found takes {pointers: [\"/...\"]}"
        messages.append({"role": "tool", "tool_call_id": call.get("id"), "content": reply})
    if pointers:
        break
if not pointers:
    die("PointerMissing", "asked %d rounds, the brain has not given the places to change" % MAX_ROUNDS)

# 二、提供值：每個位置一個小念頭，只看那一處
give = [fn("give", "交出這個位置的新值", {"json": {"type": "string", "description": "新值的 JSON 文字，例 30000、\"abc\"、{\"a\": 1}"}},
           ["json"])]
values = {}
for ptr in pointers:
    rc, cur, _ = aos_json("get", "--follow", path + "#" + ptr)
    cur = cur.strip() if rc == 0 else "（還沒有這個位置，會新加）"
    parent = ptr.rsplit("/", 1)[0]
    rc, around, _ = aos_json("peek", "--follow", path + ("#" + parent if parent else ""))
    messages = [{"role": "system", "content": "你是一個小念頭：只負責一個 JSON 位置的新值。呼叫 give，把新值寫成 JSON 文字交出來。"},
                {"role": "user", "content": "要做的事：%s\n位置：%s#%s\n現在的值：%s\n上一層：\n%s" %
                                            (want, path, ptr, cur, around if rc == 0 else "（看不到）")}]
    for _ in range(3):
        message, calls = ask(messages, give)
        messages.append(message)
        if not calls:
            messages.append({"role": "user", "content": "請呼叫 give，json 參數放新值的 JSON 文字。"})
            continue
        text = call_args(calls[0]).get("json")
        try:
            if not isinstance(text, str):
                raise ValueError("missing json argument")
            values[ptr] = json.loads(text)
            break
        except ValueError as e:
            for c in calls:
                messages.append({"role": "tool", "tool_call_id": c.get("id"), "content": "error: not JSON (%s); give it again" % e})
    if ptr not in values:
        die("ReplyBad", "%s: asked 3 times without getting a parseable JSON value" % ptr)

rc, _, err = aos_json("batch", "--check", "--follow", path, stdin=json.dumps(values, ensure_ascii=False))
print("seen: " + " -> ".join(seen))
print("found: " + ", ".join(pointers))
if rc != 0:
    die(*err)
for ptr, v in values.items():
    print("changed: %s#%s = %s" % (path, ptr, json.dumps(v, ensure_ascii=False)))
