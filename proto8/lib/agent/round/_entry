#!/usr/bin/env python3
# round - agent 的一輪：照「從哪接著做」把 queue／endpoint／history／act 與 hook/ 各格照順序叫一遍（零件庫的語法糖＝aos-loop 加「這一輪結束就停」）
"""叫法（agent-round § 2）：aos-exec <round 格> <agent 資料夾絕對路徑> [--step]
  （loop.json 叫它：{"exec": {"argv": ["aos-parts", "run", "round", {"$env": "AOS_CD"}]}}；要一格一格跑就加 --step）

結束碼（P-19、P-20）：0＝這輪好了（答案＝history 最新那則 assistant）或中途 yield（hook/pause 退 10）；
  queue 空＝照 ROUND_ON_EMPTY：stop（預設）退 10（loop 收工、射後不理）、idle 退 0 什麼都不做（loop 隔 interval_ms 再來、停著等）；
  其他＝失敗、停下等人。
  --step：只做下一格就退 0（queue 空照上面），給 aos-loop 一格一格跑（決定 12）。

從哪接著做（不另設狀態檔；看 queue 的 $AOS_STACK/queue/cur/、new/、$AOS_STACK/current.txt 與 history 最後一則；
  10-30 起，thinking 2026-10-30-agent-lifecycle 第 2 步，原本看 $AOS_WS/new/、cur/）：
  cur/ 與 new/ 都空 → queue 空（ROUND_ON_EMPTY）
  cur/ 有信沒列在 current.txt（queue claim 死在搬進 cur/ 之後、接進 history 之前）→ 「補認領」：queue claim（不叫 hook/pre_round）
  cur/ 空 → 「認領」：hook/pre_round → queue claim（退 10＝沒信＝queue 空）
  最後一則 user／tool（上一則 assistant 的 tool_calls 都有回）→ 「問腦」：
      hook/pre_think → endpoint/<目前的>（stdin {"messages": system＋history, "tools": tools}）
      → 失敗就問 hook/on_error（stop／retry／switch；沒掛＝stop）→ hook/post_think（stdout 非空＝取代）→ history append → queue emit
  最後一則 assistant、tool_calls 還有沒回的 → 「跑工具」：act（只給沒回的那幾個）→ 每則 history append
      → act 退 10（插話打斷）＝queue claim --more 把新題接進來 → hook/pause（退 10＝yield，round 退 0）
  最後一則 assistant 沒 tool_calls → 「交卷」：queue finish（cur/ 的信收掉）→ hook/post_round → 這輪好了
每叫一格都經 `aos-parts --file <agent>/parts.json which --json 槽`：退 10＝沒掛（掛勾照 § 3 表的預設；
  queue、history、act、endpoint/<名> 是必要的格＝PartMissing）；拿到就 `aos-exec 路徑 <agent> [子命令]`，註冊檔的 env 疊上去，
  AOS_STACK、AOS_WS 原樣傳（P-16 同一台狀態機）。endpoint 那格另外先設 ENDPOINT_NAME＝<名>（註冊檔的 env 有就以它為準）。
endpoint：$AOS_STACK/endpoint.txt 一行名字，沒有＝default；候選＝parts.json 的 endpoint/<名> 與 <agent>/endpoint/ 底下的名字聯集。
  switch＝排序在目前之後的下一個（繞一圈）寫進 endpoint.txt 再問；retry＝同一個再問；一次問腦最多重來 MAX_RETRIES 次（預設 3）。
tools＝aos-tools --file <agent>/tools.json ls --json 轉成 OpenAI tools 陣列；system＝<agent>/system.txt（有才帶，不存進 history）。
trace：每叫一格在 $AOS_STACK/trace.jsonl 追加一行 {"started_at", "unit", "code", "elapsed_ms"}（unit＝槽名，有子命令就接一個空格再子命令）。
格失敗（非 0）＝round 以那個碼退，stderr 不轉述（格自己說了）；格退了它不該退的 10＝round 說一行 UnitFailed、退 1（不讓 loop 當成「沒題」）。
設定（這格的 env：parts.json 的 env 或這格的 .env）：MAX_RETRIES（≥0 的整數）、ROUND_ON_EMPTY（stop｜idle，沒設或空＝stop）。
錯（自己這層的）：stderr 一行「round: 代號 原因」、退 1——ArgumentsBad、AgentBad、StackMissing、SettingBad、PartMissing、
  PartsBad、ToolsBad、HistoryBad、MessageBad、HookFailed、EndpointFailed（on_error 要重來但次數用完）、UnitFailed、WriteFailed。"""
import datetime, json, os, subprocess, sys, time

NAME = "round"
NOT_FOUND = 10
USAGE = "usage: aos-exec <round 格> <agent 資料夾絕對路徑> [--step]"


class Exit(Exception):
    """結束這次 round：code＝結束碼；reason 有值＝自己這層的錯（印一行）。"""

    def __init__(self, code, err=None, reason=None):
        super().__init__(reason)
        self.code, self.err, self.reason = code, err, reason


def fail(err, reason):
    raise Exit(1, err, reason)


def now_ms():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


# ---- 參數與環境 ----

args = sys.argv[1:]
STEP = "--step" in args
args = [a for a in args if a != "--step"]
if len(args) != 1:
    print("%s: ArgumentsBad %s" % (NAME, USAGE), file=sys.stderr)
    sys.exit(1)
AGENT = args[0]
if not os.path.isabs(AGENT) or not os.path.isdir(AGENT):
    print("%s: AgentBad agent 資料夾要是存在的絕對路徑（aos-exec 走進格以後 cwd 不在 agent 那邊），收到 %r" % (NAME, AGENT),
          file=sys.stderr)
    sys.exit(1)
STACK = os.environ.get("AOS_STACK")
PARTS = os.path.join(AGENT, "parts.json")
REQUIRED = ("queue", "history", "act")


def setting():
    """→ (MAX_RETRIES, queue 空時的結束碼)。"""
    v = os.environ.get("MAX_RETRIES")
    n = 3
    if v not in (None, ""):
        try:
            n = int(v)
            if n < 0:
                raise ValueError
        except ValueError:
            fail("SettingBad", "MAX_RETRIES 要是 ≥0 的整數，收到 %r" % v)
    empty = os.environ.get("ROUND_ON_EMPTY") or "stop"
    if empty not in ("stop", "idle"):
        fail("SettingBad", "ROUND_ON_EMPTY 要是 stop 或 idle，收到 %r" % empty)
    return n, (NOT_FOUND if empty == "stop" else 0)


# ---- 叫格 ----

def which(slot):
    """槽 → {"path", "env"}；沒掛＝None。"""
    try:
        r = subprocess.run(["aos-parts", "--file", PARTS, "which", "--json", slot],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)   # stderr 不吞：aos-parts 自己說哪裡壞
    except OSError as e:
        fail("PartsBad", "aos-parts 起不來：%s" % e)
    if r.returncode == NOT_FOUND:
        if slot in REQUIRED or slot.startswith("endpoint/"):
            fail("PartMissing", "沒掛 %s 格（%s 沒登記、%s 也沒有）" % (slot, PARTS, os.path.join(AGENT, slot)))
        return None
    if r.returncode != 0:
        fail("PartsBad", "aos-parts which %s 退 %d" % (slot, r.returncode))
    try:
        got = json.loads(r.stdout)
        return {"path": got["path"], "env": {k: str(v) for k, v in (got.get("env") or {}).items()}}
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        fail("PartsBad", "aos-parts which --json 印的不是 {path, env}：%s" % e)


def trace(unit, started, t0, code):
    line = {"started_at": started, "unit": unit, "code": code, "elapsed_ms": int((time.monotonic() - t0) * 1000)}
    try:
        with open(os.path.join(STACK, "trace.jsonl"), "a", encoding="utf-8") as f:   # 只追加、一次寫一整行
            f.write(json.dumps(line, ensure_ascii=False) + "\n")
    except OSError as e:
        fail("WriteFailed", "接不進 trace.jsonl：%s" % e)


def run(slot, got, sub=(), stdin="", extra_env=None, keep_err=False):
    """aos-exec 那格；回 CompletedProcess。keep_err＝把 stderr 收下（endpoint：要給 on_error），收下的照樣印出去。"""
    env = dict(os.environ)
    env.update(extra_env or {})
    env.update(got["env"])
    unit = " ".join((slot,) + tuple(sub))
    started, t0 = now_ms(), time.monotonic()
    try:
        r = subprocess.run(["aos-exec", got["path"], AGENT] + list(sub), input=stdin, stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE if keep_err else None, text=True, env=env)
    except OSError as e:
        fail("UnitFailed", "%s 起不來（aos-exec）：%s" % (unit, e))
    if keep_err and r.stderr:
        sys.stderr.write(r.stderr)
        sys.stderr.flush()
    trace(unit, started, t0, r.returncode)
    return r


def must(slot, sub=(), stdin="", ok=(0,)):
    """必要的格：結束碼不在 ok 裡＝round 以那個碼退（10 不往外傳，改說 UnitFailed 退 1）。"""
    r = run(slot, which(slot), sub, stdin)
    if r.returncode not in ok:
        unit = " ".join((slot,) + tuple(sub))
        if r.returncode == NOT_FOUND:
            fail("UnitFailed", "%s 退 10（這裡不該是 10）" % unit)
        raise Exit(r.returncode)
    return r


def hook(point, stdin="", ok=(0,)):
    """掛勾：沒掛＝None；結束碼不在 ok 裡＝round 失敗（同 must）。"""
    slot = "hook/" + point
    got = which(slot)
    if got is None:
        return None
    r = run(slot, got, (), stdin)
    if r.returncode not in ok:
        if r.returncode == NOT_FOUND:
            fail("UnitFailed", "%s 退 10（這裡不該是 10）" % slot)
        raise Exit(r.returncode)
    return r


def one_json(text, who):
    try:
        m = json.loads(text)
    except ValueError as e:
        fail("MessageBad", "%s 印的不是一則 JSON：%s" % (who, e))
    if not isinstance(m, dict):
        fail("MessageBad", "%s 印的不是 JSON 物件" % who)
    return m


def dumps(m):
    return json.dumps(m, ensure_ascii=False)


# ---- 現在在哪 ----

def names(stage):
    """queue 的某一格（$AOS_STACK/queue/<格>）裡的信號；. 開頭的不算（N-05）。"""
    try:
        return sorted(n for n in os.listdir(os.path.join(STACK, "queue", stage)) if not n.startswith("."))
    except (FileNotFoundError, NotADirectoryError):
        return []


def listed():
    """$AOS_STACK/current.txt 列的信號＝queue claim 已接進 history 的。"""
    try:
        with open(os.path.join(STACK, "current.txt"), encoding="utf-8") as f:
            return {l.strip() for l in f if l.strip()}
    except FileNotFoundError:
        return set()
    except OSError as e:
        fail("HistoryBad", "讀不了 current.txt：%s" % e)


def history():
    r = must("history", ("read",))
    try:
        rows = json.loads(r.stdout)
    except ValueError as e:
        fail("HistoryBad", "history read 印的不是 JSON：%s" % e)
    if not isinstance(rows, list) or not all(isinstance(m, dict) for m in rows):
        fail("HistoryBad", "history read 印的不是 JSON 物件的陣列")
    return rows


def unanswered(rows):
    """最後一則 assistant 的 tool_calls 裡還沒有 tool 回的那幾個（它後面只有 tool）；不是這種情形＝None。"""
    answered = set()
    for m in reversed(rows):
        if m.get("role") == "tool":
            answered.add(m.get("tool_call_id"))
            continue
        if m.get("role") != "assistant":
            return None
        calls = m.get("tool_calls") or []
        left = [c for c in calls if not (isinstance(c, dict) and c.get("id") in answered)]
        return (m, left) if calls else None
    return None


def where():
    """→ ("none",) | ("claim",) | ("resume",) | ("think", rows) | ("act", 那則 assistant 只留沒回的 calls) | ("finish", 那則 assistant)"""
    cur = names("cur")
    if not cur:
        return ("claim",) if names("new") else ("none",)
    if set(cur) - listed():
        return ("resume",)
    rows = history()
    if not rows:
        fail("HistoryBad", "queue 的 cur/ 有信，history 卻是空的（queue claim 會先接進 history 再寫 current.txt；是有人手動改的？）")
    last = rows[-1]
    pending = unanswered(rows)
    if pending and pending[1]:
        return ("act", dict(pending[0], tool_calls=pending[1]))
    if last.get("role") in ("user", "tool"):
        return ("think", rows)
    if last.get("role") == "assistant":
        return ("finish", last)
    fail("HistoryBad", "history 最後一則的 role 是 %r，不知道從哪接著做" % last.get("role"))


# ---- 各步 ----

def claim(pre_round=True):
    if pre_round:
        hook("pre_round")
    must("queue", ("claim",), ok=(0, NOT_FOUND))     # 10＝沒信（剛剛被撤回、或全是壞信）：照樣交給 main 判


def tools():
    try:
        r = subprocess.run(["aos-tools", "--file", os.path.join(AGENT, "tools.json"), "ls", "--json"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        fail("ToolsBad", "aos-tools 起不來：%s" % e)
    if r.returncode != 0:
        fail("ToolsBad", "aos-tools ls 退 %d" % r.returncode)
    out = []
    for t in json.loads(r.stdout):                    # 照 demo/agent-dan/brain.py：description／parameters 以外的 key 忽略
        function = {"name": t["name"]}
        function.update({k: t["tooldef"][k] for k in ("description", "parameters") if k in (t.get("tooldef") or {})})
        out.append({"type": "function", "function": function})
    return out


def endpoint_name():
    try:
        with open(os.path.join(STACK, "endpoint.txt"), encoding="utf-8") as f:
            return f.read().strip() or "default"
    except FileNotFoundError:
        return "default"
    except OSError as e:
        fail("SettingBad", "讀不了 endpoint.txt：%s" % e)


def candidates():
    """parts.json 的 endpoint/<名> 與 <agent>/endpoint/ 底下的名字聯集，排序。"""
    found = set()
    try:
        with open(PARTS, encoding="utf-8") as f:
            parts = json.load(f).get("parts")
    except FileNotFoundError:
        parts = {}
    except (OSError, ValueError, AttributeError) as e:
        fail("PartsBad", "%s 讀不了：%s" % (PARTS, e))
    if isinstance(parts, dict) and "$ref" not in parts and "$env" not in parts:
        slots = parts.keys()
    else:                                               # parts 是指示詞：交給 aos-parts 整份解
        r = subprocess.run(["aos-parts", "--file", PARTS, "ls", "--json"], stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, text=True)
        if r.returncode != 0:
            fail("PartsBad", "aos-parts ls 退 %d" % r.returncode)
        slots = [p["slot"] for p in json.loads(r.stdout)]
    found.update(s.split("/", 1)[1] for s in slots if s.startswith("endpoint/"))
    try:
        found.update(n for n in os.listdir(os.path.join(AGENT, "endpoint")) if not n.startswith("."))
    except (FileNotFoundError, NotADirectoryError):
        pass
    return sorted(found)


def switch(current):
    c = candidates()
    nxt = c[(c.index(current) + 1) % len(c)] if current in c else (c[0] if c else current)
    tmp = os.path.join(STACK, ".endpoint.txt.tmp")
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(nxt + "\n")
        os.replace(tmp, os.path.join(STACK, "endpoint.txt"))   # N-05
    except OSError as e:
        fail("WriteFailed", "寫不了 endpoint.txt：%s" % e)


def on_error(err_line):
    got = which("hook/on_error")
    if got is None:
        return "stop"                                   # 沒掛＝stop（P-20 預設停）
    r = run("hook/on_error", got, (), err_line + "\n")
    word = r.stdout.strip()
    return word if r.returncode == 0 and word in ("retry", "switch") else "stop"


def ask(rows, max_retries):
    if hook("pre_think") is not None:
        rows = history()                                # pre_think（compact）可能換了 history
    body = {"messages": system() + rows, "tools": tools()}
    tries = 0
    while True:
        name = endpoint_name()
        slot = "endpoint/" + name
        r = run(slot, which(slot), (), dumps(body) + "\n", {"ENDPOINT_NAME": name}, keep_err=True)
        if r.returncode == 0:
            return one_json(r.stdout.strip().splitlines()[-1] if r.stdout.strip() else "", slot)
        lines = [l for l in (r.stderr or "").splitlines() if l.strip()]
        word = on_error(lines[-1] if lines else "%s 退 %d" % (slot, r.returncode))
        if word == "stop":
            raise Exit(r.returncode if r.returncode != NOT_FOUND else 1)
        tries += 1
        if tries > max_retries:
            fail("EndpointFailed", "on_error 說 %s，但這次問腦已經重來 %d 次（MAX_RETRIES=%d）" % (word, max_retries, max_retries))
        if word == "switch":
            switch(name)


def system():
    p = os.path.join(AGENT, "system.txt")
    if not os.path.exists(p):
        return []
    with open(p, encoding="utf-8") as f:
        return [{"role": "system", "content": f.read()}]   # 每次從檔讀，不存進 history


def think(rows, max_retries):
    msg = ask(rows, max_retries)
    r = hook("post_think", dumps(msg) + "\n")
    if r is not None and r.stdout.strip():
        msg = one_json(r.stdout.strip(), "hook/post_think")
    must("history", ("append",), dumps(msg) + "\n")
    must("queue", ("emit",), dumps(msg) + "\n")


def act(msg):
    """跑工具；回 True＝hook/pause 說 yield。"""
    r = must("act", (), dumps(msg) + "\n", ok=(0, NOT_FOUND))
    for line in r.stdout.splitlines():
        if line.strip():
            must("history", ("append",), line + "\n")
    if r.returncode == NOT_FOUND:                       # 插話打斷：新信接進來（body 一則、信號進 current.txt），回去問腦
        must("queue", ("claim", "--more"), ok=(0, NOT_FOUND))
    p = hook("pause", ok=(0, NOT_FOUND))
    return p is not None and p.returncode == NOT_FOUND


def finish(msg):
    must("queue", ("finish",))                          # 答案已在 history（最新那則 assistant），queue 只收信
    hook("post_round", dumps(msg) + "\n")


def main():
    if not STACK:
        fail("StackMissing", "沒設定 AOS_STACK")
    os.makedirs(STACK, exist_ok=True)
    max_retries, on_empty = setting()
    while True:
        at = where()
        if at[0] == "none":
            raise Exit(on_empty)
        if at[0] in ("claim", "resume"):
            claim(pre_round=at[0] == "claim")
            if not names("cur"):
                raise Exit(on_empty)
        elif at[0] == "think":
            think(at[1], max_retries)
        elif at[0] == "act":
            if act(at[1]):
                raise Exit(0)                           # yield：狀態在 stack，下次接著做
        else:
            finish(at[1])
            raise Exit(0)
        if STEP:
            raise Exit(0)


try:
    main()
except Exit as e:
    if e.err:
        print("%s: %s %s" % (NAME, e.err, str(e.reason).replace("\n", " ")), file=sys.stderr)
    sys.exit(e.code)
