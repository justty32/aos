#!/usr/bin/env python3
# queue - agent 的 queue 格：$AOS_STACK/queue/（N-16 有順序的信箱，底下叫 aos-post）的放、等、認領、看、中間輸出、收掉、撤回
"""叫法（agent-round § 4）：aos-exec <queue 格> <agent 資料夾> <子命令> [args]
設計：thinking 2026-10-30-agent-lifecycle 結論 A-1～A-9、實作步驟第 1 步。

queue＝有順序的投遞（N-16）在 agent 層的名字：信箱 $AOS_STACK/queue/（tmp/ new/ cur/、order.lock/ order.json，done/ 選用），
一封信＝一則訊息，letter.json 的 body＝一則 OpenAI message 物件（{"role": ..., ...}），認領時原樣接進 history。
回答不另開通道：答案就是 history 最新那則沒有 tool_calls 的 assistant（A-6）。PATH 上要有 aos-post。

    push [--wait] [--timeout-s N]   stdin 一則 message（JSON 物件、要有字串 role）→ stdout 信號（new/ 裡的名字，帶序號）
                                    沒有 queue/ 就先 aos-post init；寄＝aos-post send --ordered
                                    --wait＝放完接著 pop（stdout 先印信號一行、再印答案）
    pop [--timeout-s N] 信號         信還在 new/ 或 cur/ 就等；不見了就印 history 最新那則沒有 tool_calls 的 assistant 的 content
                                    逾時退 10；一直沒看到這封、history 也沒有 assistant＝LetterUnknown；
                                    看到過、不見了，history 卻沒有 assistant＝AnswerMissing
    claim [--more]                  認領 → stdout 信號（一行一封）；沒信退 10
    peek | current | done           new/ ｜ cur/ ｜ done/ 的信號，一行一個
    emit                            stdin 一則訊息（JSON 物件）→ 追加一行進 $AOS_STACK/live.jsonl（只接不重寫）
    finish [--keep]                 cur/ 全部 aos-post finish（預設刪、--keep 進 done/）、清掉 current.txt；stdin 不看
    withdraw 信號                   只撤 new/ 裡的（aos-post withdraw）；已認領（cur/ done/ 有）＝LetterClaimed

claim 的順序（任何一步當掉重跑都接得上；current.txt＝「已接進 history 的信」）：
  ① aos-post claim（rename new/ → cur/）→ ② 讀信（aos-post check）、body 經 history 格 append → ③ 信號寫進 $AOS_STACK/current.txt。
  ② 的「接過了就不接」照舊：一般認領時 history 最後一則已是 user／tool 就不接；--more（插話：act 決定打斷時再認領一封）
  只在最後一則已是 user 時不接（被打斷後最後一則是 tool，要接；當掉重跑時最後一則已是這封的 user，不接兩次）。
  cur/ 有信卻沒列在 current.txt（上次死在 ①、② 之後）＝先把這幾封照 ②、③ 補完、印出來，不再認領新的
  （current.txt 已有別封＝那次是 --more，照 --more 的規則）。cur/ 有信、都列了、不是 --more＝只重寫 current.txt、印 cur/ 全部。
  壞信（aos-post check 不過、名字不是有序的 <12 位序號>.<信號>、body 不是有 role 的物件）＝aos-post finish 丟掉、認領下一封；
  不寫 stderr（N-43）；記 letter_warning 是之後 round 的事（它才知道有沒有 state 窗）。
history 格怎麼找：aos-parts --file <agent>/parts.json which --json history（沒掛＝PartMissing），拿到的 env 疊上去、aos-exec 它。
. 開頭的名字不算信（N-05）。寫檔一律先寫 . 開頭暫存再改名（N-05）。
錯：stderr 一行「queue: 代號 原因」、退 1（N-43；aos-post、history 自己的錯它們自己先說一行）。代號：ArgumentsBad、AgentMissing、
StackMissing、MessageBad、LetterUnknown、LetterClaimed、LetterMissing、AnswerMissing、PartMissing、PartsFailed、HistoryFailed、
PostFailed、WriteFailed。退 10＝pop 逾時、claim 沒信（正常停，P-19）。"""
import json, os, re, subprocess, sys, time

NAME = "queue"
USAGE = ("queue <agent 資料夾> push [--wait] [--timeout-s N] | pop [--timeout-s N] 信號 | claim [--more] | "
         "peek | current | done | emit | finish [--keep] | withdraw 信號")
POLL = 0.1
ORDERED = re.compile(r"^[0-9]{12}\.")      # 有序信的名字：<N 零填 12 位>.<信號>（N-16）


def die(code, reason):
    print("%s: %s %s" % (NAME, code, str(reason).replace("\n", " ")), file=sys.stderr)
    sys.exit(1)


def names(box, stage):
    try:
        return sorted(n for n in os.listdir(os.path.join(box, stage)) if not n.startswith("."))
    except (FileNotFoundError, NotADirectoryError):
        return []


def is_box(box):
    return all(os.path.isdir(os.path.join(box, s)) for s in ("tmp", "new", "cur"))


def write_atomic(path, text):
    """N-05：先寫同資料夾 . 開頭的暫存檔再改名。"""
    d = os.path.dirname(path)
    tmp = os.path.join(d, "." + os.path.basename(path) + ".tmp")
    try:
        os.makedirs(d, exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError as e:
        die("WriteFailed", "寫不了 %s：%s" % (path, e))


def check_id(sig):
    if not sig or sig.startswith(".") or "/" in sig:
        die("ArgumentsBad", "信號不能空、不能 . 開頭、不能有 /：%r" % sig)


def is_message(m):
    return isinstance(m, dict) and isinstance(m.get("role"), str)


def post(args, stdin_text=None, quiet=False):
    """叫 aos-post；回 (結束碼, stdout)。quiet＝stderr 丟掉（壞信不是這格的錯）。"""
    try:
        r = subprocess.run(["aos-post"] + args, input=stdin_text if stdin_text is not None else "",
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL if quiet else None, text=True)
    except OSError as e:
        die("PostFailed", "aos-post 起不來：%s" % e)
    return r.returncode, r.stdout


def must_post(args, stdin_text=None, ok=(0,)):
    code, out = post(args, stdin_text)
    if code not in ok:                                    # aos-post 自己已在 stderr 說了原因，這裡只說自己這層
        die("PostFailed", "aos-post %s 退 %d" % (args[0], code))
    return code, out


# ---- history 格 ----

def history_part(agent):
    try:
        r = subprocess.run(["aos-parts", "--file", os.path.join(agent, "parts.json"), "which", "--json", "history"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        die("PartsFailed", "aos-parts 起不來：%s" % e)
    if r.returncode == 10:
        die("PartMissing", "沒掛 history 格（%s/parts.json 沒登記、也沒有 %s/history）" % (agent, agent))
    if r.returncode != 0:
        die("PartsFailed", "aos-parts which history 退 %d" % r.returncode)
    try:
        part = json.loads(r.stdout)
        return part["path"], {k: str(v) for k, v in (part.get("env") or {}).items()}
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        die("PartsFailed", "aos-parts which --json 印的不是 {path, env}：%s" % e)


def history(agent, part, sub, stdin_text=""):
    path, env = part
    e = dict(os.environ)
    e.update(env)
    try:
        r = subprocess.run(["aos-exec", path, agent, sub], input=stdin_text, stdout=subprocess.PIPE, text=True, env=e)
    except OSError as ex:
        die("HistoryFailed", "aos-exec 起不來：%s" % ex)
    if r.returncode != 0:                                   # history 自己已在 stderr 說了原因（P-21），這裡只說自己這層
        die("HistoryFailed", "history %s 退 %d" % (sub, r.returncode))
    return r.stdout


def history_rows(agent, part):
    try:
        rows = json.loads(history(agent, part, "read"))
        if not isinstance(rows, list):
            raise ValueError
        return rows
    except (ValueError, TypeError):
        die("HistoryFailed", "history read 印的不是 JSON 陣列")


# ---- push／pop（aos-say／aos-listen 碰的同一套）----

def push(agent, box, text):
    try:
        m = json.loads(text)
    except ValueError as e:
        die("MessageBad", "stdin 不是 JSON：%s" % e)
    if not is_message(m):
        die("MessageBad", "stdin 要是一則 OpenAI message（JSON 物件、有字串 role）")
    if not is_box(box):
        must_post(["init", box])
    _, out = must_post(["send", "--ordered", box], json.dumps(m, ensure_ascii=False))
    return out.strip()


def answer(rows):
    for m in reversed(rows):
        if isinstance(m, dict) and m.get("role") == "assistant" and not m.get("tool_calls"):
            c = m.get("content")
            return c if isinstance(c, str) else json.dumps(c, ensure_ascii=False)
    return None


def pop(agent, box, sig, timeout):
    check_id(sig)
    start, seen = time.monotonic(), False
    while True:
        if any(os.path.lexists(os.path.join(box, s, sig)) for s in ("new", "cur")):
            seen = True
            if timeout is not None and time.monotonic() - start >= timeout:
                sys.exit(10)
            time.sleep(POLL)
            continue
        text = answer(history_rows(agent, history_part(agent)))
        if text is None:
            if seen:
                die("AnswerMissing", "%s 已經不在 new/ cur/，history 卻沒有 assistant 的回答" % sig)
            die("LetterUnknown", "queue 的 new/ cur/ 沒有 %s，history 也沒有 assistant 的回答" % sig)
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
        sys.stdout.flush()
        return


# ---- claim（要叫 history 格）----

def read_current(stack):
    try:
        with open(os.path.join(stack, "current.txt"), encoding="utf-8") as f:
            return [l.strip() for l in f if l.strip()]
    except OSError:
        return []


def letter_body(box, sig):
    """好信回 body；壞信回 None（不是這格的錯，不寫 stderr）。"""
    if not ORDERED.match(sig):
        return None
    code, out = post(["check", box, sig], quiet=True)
    if code != 0:
        return None
    try:
        body = json.loads(out).get("body")
    except (ValueError, AttributeError):
        return None
    return body if is_message(body) else None


def register(agent, part, box, stack, listed, sig, more):
    """② body 接進 history、③ current.txt；壞信丟掉回 False。"""
    body = letter_body(box, sig)
    if body is None:
        post(["finish", box, sig], quiet=True)              # 壞信一律丟（aos-post finish 不管 --keep）
        return False
    rows = history_rows(agent, part)
    last = rows[-1].get("role") if rows and isinstance(rows[-1], dict) else None
    if last not in (("user",) if more else ("user", "tool")):
        history(agent, part, "append", json.dumps(body, ensure_ascii=False))
    listed.append(sig)
    write_atomic(os.path.join(stack, "current.txt"), "".join(n + "\n" for n in listed))
    return True


def claim(agent, box, stack, more):
    cur = names(box, "cur")
    listed = [n for n in read_current(stack) if n in cur]
    pending = [n for n in cur if n not in listed]
    if pending:                                              # 上次死在 ①、② 之後：補完這幾封就好
        part = history_part(agent)
        was_more = more or bool(listed)
        got = [n for n in pending if register(agent, part, box, stack, listed, n, was_more)]
        if got:
            print("\n".join(listed if not more else got))
            return
        cur = names(box, "cur")                              # 全是壞信、丟掉了：剩下的照下面
    if cur and not more:
        write_atomic(os.path.join(stack, "current.txt"), "".join(n + "\n" for n in cur))
        print("\n".join(cur))
        return
    if not is_box(box):
        sys.exit(10)
    part = history_part(agent)                               # 先找到 history 格才搬信（沒掛＝信留在 new/）
    while True:
        code, out = must_post(["claim", box], ok=(0, 10))     # ① new/ → cur/
        if code == 10:
            sys.exit(10)
        sig = out.strip()
        if register(agent, part, box, stack, listed, sig, more):
            print(sig)
            return


# ---- 其他 ----

def emit(stack):
    text = sys.stdin.read()
    try:
        m = json.loads(text)
    except ValueError as e:
        die("MessageBad", "stdin 不是 JSON：%s" % e)
    if not isinstance(m, dict):
        die("MessageBad", "stdin 不是 JSON 物件")
    try:
        os.makedirs(stack, exist_ok=True)
        with open(os.path.join(stack, "live.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(m, ensure_ascii=False) + "\n")
    except OSError as e:
        die("WriteFailed", "接不進 live.jsonl：%s" % e)


def finish(box, stack, keep):
    cur = names(box, "cur")
    if not cur:
        die("LetterMissing", "queue 的 cur/ 是空的，沒有認領中的信可以收")
    for n in cur:                                             # 中途當掉：剩下的還在 cur/、還列在 current.txt，重跑接著收
        must_post(["finish"] + (["--keep"] if keep else []) + [box, n])
    try:
        os.unlink(os.path.join(stack, "current.txt"))
    except FileNotFoundError:
        pass
    except OSError as e:
        die("WriteFailed", "清不掉 current.txt：%s" % e)


def withdraw(box, sig):
    check_id(sig)
    claimed = [s for s in ("cur", "done") if os.path.lexists(os.path.join(box, s, sig))]
    if claimed:
        die("LetterClaimed", "%s 已經認領（在 %s/），不能撤回" % (sig, "、".join(claimed)))
    if not os.path.lexists(os.path.join(box, "new", sig)):
        die("LetterUnknown", "queue 的 new/ cur/ done/ 都沒有 %s" % sig)
    must_post(["withdraw", box, sig])


def take_flags(rest, valued, plain):
    """把 --x N 與 --y 從 rest 抽出來；其他 -- 開頭的＝ArgumentsBad。"""
    opts, left, i = {}, [], 0
    while i < len(rest):
        a = rest[i]
        if a in valued:
            if i + 1 >= len(rest):
                die("ArgumentsBad", "usage: %s（%s 後面要給值）" % (USAGE, a))
            opts[a] = rest[i + 1]
            i += 2
        elif a in plain:
            opts[a] = True
            i += 1
        elif a.startswith("--"):
            die("ArgumentsBad", "usage: %s（不認得 %s）" % (USAGE, a))
        else:
            left.append(a)
            i += 1
    return opts, left


def seconds(opts):
    v = opts.get("--timeout-s")
    if v is None:
        return None
    try:
        n = float(v)
        if n < 0 or n != n:
            raise ValueError
    except ValueError:
        die("ArgumentsBad", "usage: %s（--timeout-s 要給不小於 0 的數字：%s）" % (USAGE, v))
    return n


def main():
    argv = sys.argv[1:]
    if len(argv) < 2:
        die("ArgumentsBad", "usage: " + USAGE)
    agent, cmd, rest = os.path.abspath(argv[0]), argv[1], argv[2:]
    if not os.path.isdir(agent):
        die("AgentMissing", "agent 資料夾不存在：%s" % argv[0])
    stack = os.environ.get("AOS_STACK")
    if not stack:
        die("StackMissing", "沒設定 AOS_STACK")
    box = os.path.join(stack, "queue")
    if cmd == "push":
        opts, left = take_flags(rest, ("--timeout-s",), ("--wait",))
        if left or ("--timeout-s" in opts and "--wait" not in opts):
            die("ArgumentsBad", "usage: " + USAGE)
        sig = push(agent, box, sys.stdin.read())
        print(sig, flush=True)
        if opts.get("--wait"):
            pop(agent, box, sig, seconds(opts))
        return
    if cmd == "pop":
        opts, left = take_flags(rest, ("--timeout-s",), ())
        if len(left) != 1:
            die("ArgumentsBad", "usage: %s（pop 要一個信號）" % USAGE)
        pop(agent, box, left[0], seconds(opts))
        return
    if cmd == "claim":
        opts, left = take_flags(rest, (), ("--more",))
        if left:
            die("ArgumentsBad", "usage: " + USAGE)
        claim(agent, box, stack, bool(opts.get("--more")))
        return
    if cmd == "finish":
        opts, left = take_flags(rest, (), ("--keep",))
        if left:
            die("ArgumentsBad", "usage: " + USAGE)
        finish(box, stack, bool(opts.get("--keep")))
        return
    if cmd == "withdraw":
        if len(rest) != 1:
            die("ArgumentsBad", "usage: %s（withdraw 要一個信號）" % USAGE)
        withdraw(box, rest[0])
        return
    if rest:
        die("ArgumentsBad", "usage: %s（%s 不收參數）" % (USAGE, cmd))
    if cmd in ("peek", "current", "done"):
        ns = names(box, {"peek": "new", "current": "cur", "done": "done"}[cmd])
        if ns:
            print("\n".join(ns))
    elif cmd == "emit":
        emit(stack)
    else:
        die("ArgumentsBad", "usage: %s（不認得子命令 %s）" % (USAGE, cmd))


main()
