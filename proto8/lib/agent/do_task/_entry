#!/usr/bin/env python3
# do_task - 在自己的 history 裡做一段任務：start 留紀錄點、end 附總結把紀錄點之後那段換成一則總結（aos-agent history 改、原文照舊留在旁邊）、status 看自己在不在任務裡；只給 agent-fsm 的身體
# 使用者 11-11：「另一種是save/load，也就是從在呼叫do_task那時候留下一個紀錄點，等做完task後使用self_history修改history，將進行這段task的過程中的history做總結，
#   然後退回load那邊」；選項框裁「do_task改成save/load模式」「do_task有兩個子指令，一個是開始，一個是結束。結束的時候要附上總結」「eca 不給 do_task」
#   「拿掉這個能力」（舊的開一次性小幫手；要派工用 fork 或 subagent）。thinking 2026-11/11/fork-and-do-task（README 與 02-do_task）。
# 介面（lib/docs/01 的契約）：stdin 收 {"op": "start"|"end"|"status", …}；別的鍵＝ArgumentsBad：
#   start {task?}   在這一則（叫我的那則 assistant＝紀錄點）開一段任務；task＝一句這段要做什麼。任務裡再 start＝巢狀（最多 MAX_DEPTH 層，DepthExceeded）。
#   end {summary}   收最裡面那段：紀錄點那則與它的 tool 結果之後、到這一步之前的訊息換成一則「[aos] summary: lines A-B, N messages. Task "…" ended: 總結」
#                   （aos-agent history summarize；別人給的 user 訊息〔信、goal 提醒，不含 [aos] summary:〕不摺，照原順序接在總結後面，先用 history set 挪過去）。
#                   沒開任務＝TaskMissing；紀錄點那則已經不在 history（被刪、被 summarize 掉）＝MarkerMissing，這段任務就此關掉、不摺。
#   status {}       列開著的任務（外到內）：task、開始時間、紀錄點現在第幾行、之後幾則。
# 「這一步」與紀錄點：先 aos-agent ctl who 認出是哪隻、history ls --json 讀全部；最後一則 assistant 帶 tool_calls、後面只有 tool＝這一步，
#   它的 tool_calls 裡第一個還沒有 tool 結果的＝叫我的這一個（act 一個一個照順序跑）。找不到＝BodyUnsupported（eca 的工具來回在 CLI 裡、history 沒有這種行；
#   手動 aos-tools call 也一樣）——不看定義、只看 history 的形狀。
# 狀態：工具小格 $AOS_STACK（＝<agent stack>/tools/do_task/）的 tasks.json {"tasks": [{"call", "task"?, "started_at"}], "ended"?: {"call", "result"}}，
#   寫才建、暫存檔再改名。agent 掛掉或被停再起來，紀錄點照在（status 看得到）。act 中途斷了重跑同一個 call：start 同 id＝照印、不再開；
#   end 同 id（ended.call）＝照印上次的結果；摺完還沒記上就斷了（總結那則已在、內容對得上）＝不再摺、只關掉。
# 錯：stderr 與 stdout 各一行「do_task: error: 代號 原因」、退 1（tool_io.die）；aos-agent 退非 0＝它最後一行錯誤行的代號與原因接成自己的
#   （C-52 例外 ⑤，同 self_history）、沒那行＝CommandFailed。只在 daemon 下跑的 agent 能用。每次叫 aos-agent 最多 60 秒；被 TERM 先收掉它再走。
import json, os, re, signal, subprocess, sys
from datetime import datetime, timezone
HELP = """\
usage: do_task < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
Do one task inside your own conversation and keep only its summary: op start | end | status.
start marks the message that called it; end (with a summary) replaces every message after that
mark (up to the call of end) with one summary message. Messages from others that came in the
meantime (letters, goal reminders) stay, after the summary. Tasks may nest; end closes the innermost.
Removed messages are kept next to the history. Only for an agent-fsm body (BodyUnsupported otherwise).
Result on stdout. On error: one line "do_task: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name != "tool_io":
        raise
    _line = "%s: error: ModuleMissing tool_io.py not in the tool folder, not in lib/, not on the Python path\n" % os.path.basename(HERE)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "do_task"
tool_io.start(NAME, HELP)
TIMEOUT_S = 60
MAX_DEPTH = 5                                   # 巢狀最多幾層（代定：腦忘了 end 一直 start 時有個清楚的錯）
SUMMARY = "[aos] summary:"                      # aos-agent history summarize 寫的那則的開頭（aos_flags.aos_note；lib 不 import py）
STATE = "tasks.json"
ERR_RE = re.compile(r"aos-[a-z-]+: error: ([A-Z][A-Za-z]+) (.*)\Z")
die = tool_io.die
child = None


def on_term(signum, frame):
    if child is not None and child.poll() is None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            pass
    sys.exit(128 + signum)


def agent(*args):
    """aos-agent args…：stderr 原樣往上；退非 0＝它最後一行錯誤行的代號與原因當自己的錯（沒有＝CommandFailed）。回 stdout。"""
    global child
    try:
        child = subprocess.Popen(["aos-agent"] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE, text=True, start_new_session=True, cwd=tool_io.workspace())
    except OSError as e:
        die("LaunchFailed", "cannot run aos-agent (put it on PATH with proto8/install.sh): %s" % e)
    try:
        out, err = child.communicate(timeout=TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(child.pid, signal.SIGKILL)
        child.communicate()
        die("CommandFailed", "aos-agent %s took over %d s and was killed" % (" ".join(args[:4]), TIMEOUT_S))
    if err:                                     # 下層的 stderr 原樣透出（R10）
        sys.stderr.write(err if err.endswith("\n") else err + "\n")
        sys.stderr.flush()
    if child.returncode != 0:
        mine = [m for m in map(ERR_RE.match, err.splitlines()) if m]
        if mine:
            die(mine[-1].group(1), mine[-1].group(2))
        die("CommandFailed", "aos-agent %s exited %d" % (" ".join(args[:4]), child.returncode))
    return out


signal.signal(signal.SIGTERM, on_term)
signal.signal(signal.SIGINT, on_term)          # Ctrl-C：同 TERM，退 130、不吐 traceback（R12）
args = tool_io.arguments()
OPS = {"start": ("task",), "end": ("summary",), "status": ()}
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (%s)" % ", ".join(OPS))
if op not in OPS:
    die("OpUnknown", "op must be one of %s (got %r)" % (", ".join(OPS), op))
extra = sorted(k for k in args if k != "op" and k not in OPS[op])
if extra:
    die("ArgumentsBad", "op %s does not take %s (it takes %s)" % (op, ", ".join(extra), ", ".join(OPS[op]) or "nothing else"))
for key in OPS[op]:
    v = args.get(key)
    if (v is not None or op == "end") and (not isinstance(v, str) or not v.strip()):
        die("ArgumentsBad", "summary is required: a few sentences on what the task found or did (it replaces the task's messages)"
            if key == "summary" else "task must be a non-empty string (one sentence: what this task is for)")
cell = os.environ.get("AOS_STACK")
if not cell:
    die("StackMissing", "AOS_STACK is not set (it is this tool's cell, <your stack>/tools/do_task/)")
state_path = os.path.join(cell, STATE)


def load():
    try:
        with open(state_path, encoding="utf-8") as f:
            s = json.load(f)
    except FileNotFoundError:
        return {"tasks": []}
    except (OSError, ValueError) as e:
        die("StateBad", "cannot read %s: %s" % (state_path, e))
    ok = isinstance(s, dict) and isinstance(s.get("tasks"), list) and all(
        isinstance(t, dict) and isinstance(t.get("call"), str) for t in s["tasks"])
    if not ok:
        die("StateBad", "%s is not {\"tasks\": [{\"call\": ...}, ...]}" % state_path)
    return s


def save(s):
    tmp = os.path.join(cell, "." + STATE + ".tmp")
    try:
        os.makedirs(cell, exist_ok=True)        # 小格寫才建（11-11 tool-cells-lazy）
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(s, f, ensure_ascii=False, indent=1)
            f.write("\n")
        os.replace(tmp, state_path)
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (state_path, e))


def in_progress(msgs):
    """(這一步那則的行號, 叫我的 call id)。最後一則 assistant 帶 tool_calls、後面只有 tool，第一個沒結果的 call；找不到＝BodyUnsupported。"""
    last = max((i for i, m in enumerate(msgs) if m and m.get("role") == "assistant"), default=None)
    calls = msgs[last].get("tool_calls") if last is not None else None
    if isinstance(calls, list) and calls and all(m and m.get("role") == "tool" for m in msgs[last + 1:]):
        answered = {m.get("tool_call_id") for m in msgs[last + 1:]}
        for c in calls:
            if isinstance(c, dict) and isinstance(c.get("id"), str) and c["id"] not in answered:
                return last + 1, c["id"]
    die("BodyUnsupported", "do_task works only in an agent-fsm body, where each tool call is a line of your history; "
        "yours has no tool call in progress (an eca body such as claude or codex keeps its tool calls inside the CLI). "
        "For a separate task use subagent or fork")


def marker_line(msgs, call, lock):
    """紀錄點＝tool_calls 裡有這個 id 的那則 assistant（1 起；可以就是這一步那則：同一則裡先 start 後 end）；不在＝None。"""
    for i in range(lock - 1, -1, -1):
        m = msgs[i]
        if m and m.get("role") == "assistant" and any(isinstance(c, dict) and c.get("id") == call for c in m.get("tool_calls") or []):
            return i + 1
    return None


def kept(m):
    """摺的時候留下的：別人給的 user 訊息（信、goal 提醒）；[aos] summary: 是自己摺的，照摺。"""
    c = m.get("content") if m else None
    return bool(m) and m.get("role") == "user" and not (isinstance(c, str) and c.startswith(SUMMARY))


def quoted(t):
    return " \"%s\"" % t["task"] if t.get("task") else ""


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


me = agent("ctl", "who").strip()
rows = json.loads(agent("history", "--target", me, "ls", "--json"))
msgs = [r.get("message") if isinstance(r.get("message"), dict) else None for r in rows]
lock, call = in_progress(msgs)
state = load()
tasks = state["tasks"]

if op == "status":
    if not tasks:
        print("Not in a task. Start one with {\"op\": \"start\", \"task\": \"...\"}.")
        sys.exit(0)
    print("In %d task%s (outermost first):" % (len(tasks), "" if len(tasks) == 1 else "s"))
    for depth, t in enumerate(tasks, 1):
        at = marker_line(msgs, t["call"], lock)
        where = ("its start is line %d, %d messages after it" % (at, max(0, lock - 1 - at)) if at
                 else "its start is no longer in your history; end closes it without folding")
        print("%d.%s started %s; %s" % (depth, quoted(t) or " (no task text)", t.get("started_at", "?"), where))
    print("End the innermost with {\"op\": \"end\", \"summary\": \"...\"}.")
    sys.exit(0)

if op == "start":
    again = bool(tasks) and tasks[-1]["call"] == call          # act 斷了重跑同一個 call：不再開
    if not again:
        if len(tasks) >= MAX_DEPTH:
            die("DepthExceeded", "already %d tasks deep (at most %d); end one first" % (len(tasks), MAX_DEPTH))
        tasks.append(dict({"call": call, "started_at": now()}, **({"task": args["task"].strip()} if args.get("task") else {})))
        state.pop("ended", None)
        save(state)
    t = tasks[-1]
    print("Task started (depth %d)%s%s. From here on, what you do is folded when you end it: call do_task with "
          "{\"op\": \"end\", \"summary\": \"...\"} and only this start and your summary stay in your history."
          % (len(tasks), quoted(t), " inside%s" % (quoted(tasks[-2]) or " another task") if len(tasks) > 1 else ""))
    sys.exit(0)

# ---- end ----
ended = state.get("ended")
if isinstance(ended, dict) and ended.get("call") == call:      # 同一個 end 重跑：照印上次的
    sys.stdout.write(ended.get("result", ""))
    sys.exit(0)
if not tasks:
    die("TaskMissing", "you are not in a task (start one with {\"op\": \"start\", \"task\": \"...\"}); nothing folded")
t = tasks[-1]
summary = args["summary"].strip()
text = "Task%s ended: %s" % (quoted(t), summary)
at = marker_line(msgs, t["call"], lock)
if at is None:
    tasks.pop()
    save(state)
    die("MarkerMissing", "the start of task%s is no longer in your history (it was removed or summarized); "
        "nothing was folded and the task is closed" % quoted(t))
lo = at + 1
while lo < lock and msgs[lo - 1] and msgs[lo - 1].get("role") == "tool":   # 紀錄點那則的 tool 結果留著
    lo += 1
hi = lock - 1
keep = [n for n in range(lo, hi + 1) if kept(msgs[n - 1])]
fold = [n for n in range(lo, hi + 1) if not kept(msgs[n - 1])]
done_before = (len(fold) == 1 and isinstance((msgs[fold[0] - 1] or {}).get("content"), str)
               and msgs[fold[0] - 1]["content"].startswith(SUMMARY) and msgs[fold[0] - 1]["content"].endswith(text))
where = ""
if fold and not done_before:
    first = hi - len(keep) + 1                  # 留下的挪到這段最後（照原順序），前面空出來的一整段交給 summarize
    for j, n in enumerate(keep):
        if first + j != n:
            agent("history", "--target", me, "set", "--", str(first + j), json.dumps(msgs[n - 1], ensure_ascii=False))
    out = agent("history", "--target", me, "summarize", "--", "%d-%d" % (lo, lo + len(fold) - 1), text)
    where = out.strip().rpartition("; ")[2]
tasks.pop()
lines = ["Task ended (depth %d)%s." % (len(tasks) + 1, quoted(t))]
if not fold:
    lines.append("Nothing to fold: no messages of yours between the start and this call.")
elif done_before:
    lines.append("Already folded into the summary at line %d." % fold[0])
else:
    lines.append("%d message%s of yours (%s) %s now one summary at line %d; %s." % (
        len(fold), "" if len(fold) == 1 else "s", "line %d" % lo if lo == hi else "lines %d-%d" % (lo, hi),
        "is" if len(fold) == 1 else "are", lo, where or "the originals are kept next to your history"))
if keep:
    lines.append("%d message%s from others during the task %s kept after the summary." % (
        len(keep), "" if len(keep) == 1 else "s", "is" if len(keep) == 1 else "are"))
if tasks:
    lines.append("You are still in task (depth %d)%s." % (len(tasks), quoted(tasks[-1])))
result = "\n".join(lines) + "\n"
state["ended"] = {"call": call, "result": result}
save(state)
sys.stdout.write(result)
