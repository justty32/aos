#!/usr/bin/env python3
# goal - aos-agent goal 的包裝，目標改成叫我的那隻自己：get、set、done、pause、resume；狀態在那隻 stack 的 goal.json，身體在它自己停下來時丟提醒
# 使用者 11-11：「然後自動給agent看的，可能要做goal工具。預期是當agent自己停下來時(在沒有新user prompt的情況下，自己不再呼叫工具)，自動丟goal給他，」
#   「agent可以用goal_pause，宣告說自己因為一些原因所以暫時不做goal，還有goal_resume。」；選項框裁「一支 goal 分動作」（thinking 2026-11/11/goal/02）。
#   原則同 self_system（純包裝、不多給）。**對應關係**：aos-agent goal 加了動作或旗標，這支要跟著加（clear 不給：agent 收尾用 done）。
# 介面（lib/README 的契約）：stdin 收 {"op": "get"|"set"|"done"|"pause"|"resume", …}；別的鍵＝ArgumentsBad：
#   get {}                      ＝goal get（status、text、reminded N of LIMIT、reason…；沒有＝no goal）
#   set {text, limit?}          ＝goal set [--limit N] -（text 從 stdin 交給它）
#   done {status?, reason}      ＝goal done [--abandoned] REASON（status: done（預設）或 abandoned；reason 必給一句）
#   pause {reason}              ＝goal pause REASON（reason 必給一句：為什麼先停，例如在等誰）
#   resume {}                   ＝goal resume（計數歸零）
#   先 aos-agent ctl who（$AOS_STACK＝<agent stack>/tools/goal/ 查 daemon 表）認出是哪隻；aos-agent 在 $AOS_WS 跑。
#   aos-agent goal 看 $AOS_STACK 在目標 stack 裡＝記 set_by／updated_by＝agent。
#   錯：同 self_system（stderr 與 stdout 各一行「goal: error: 代號 原因」、退 1；下層最後一行錯誤行的代號與原因接上，C-52 例外 ⑤；
#   沒那行才是 CommandFailed）。只在 daemon 下跑的 agent 能用。
# 需要 PATH 上有 aos-agent（proto8/install.sh）。每次叫 aos-agent 最多 60 秒；被外面 TERM 時先收掉它再走（lib 契約規則 5）。
import os, re, sys
HELP = """\
usage: goal < ARGUMENTS.json   (a tool: run it with aos-exec; $AOS_WS is the workspace)
See or change the goal of the agent that calls me: op get | set | done | pause | resume
(aos-agent goal with the target = me). When you stop by yourself (your answer calls no tool)
and no letter waits, you get "[aos] goal: TEXT (reminder N of LIMIT...)".
Result on stdout. On error: one line "goal: error: CODE reason" on stderr and stdout, exit 1.
"""
HERE = os.path.dirname(os.path.realpath(__file__))
sys.dont_write_bytecode = True                  # 不在庫的資料夾留 __pycache__
# 只找自己的工具夾、旁邊的 lib/agent（cmd_call）、realpath 祖先的 lib，再交給標準 Python 路徑。
_lib = os.path.dirname(HERE)
while _lib != os.path.dirname(_lib):
    if os.path.basename(_lib) == "lib" and os.path.isfile(os.path.join(_lib, "tool_io.py")):
        break
    _lib = os.path.dirname(_lib)
sys.path[:0] = [HERE, os.path.dirname(HERE)] + ([_lib] if os.path.basename(_lib) == "lib" else [])
try:
    import tool_io  # noqa: E402
    import cmd_call  # noqa: E402
except ModuleNotFoundError as error:   # 只處理共用模組缺少，不掩蓋其內部錯誤
    if error.name not in ("tool_io", "cmd_call"):
        raise
    _line = "%s: error: ModuleMissing %s.py not in the tool folder, not in lib/, not on the Python path\n" % (os.path.basename(HERE), error.name)
    sys.stderr.write(_line)
    sys.stdout.write(_line)
    sys.exit(1)

NAME = "goal"
tool_io.start(NAME, HELP)
WARN_RE = re.compile(r"aos-agent: warning: (.*)\Z")
notes = []


die = tool_io.die


def agent(*args, text=None):
    """aos-agent args…（text＝給它的 stdin）：stderr 原樣往上；退非 0＝它最後一行錯誤行的代號與原因當自己的錯（沒有＝CommandFailed）。回 stdout。"""
    _, out, err = cmd_call.call("aos-agent", args, shown=2, text=text)
    notes.extend(m.group(1) for m in map(WARN_RE.match, err.splitlines()) if m)   # 腦只看 stdout：提醒也給它
    return out


def sentence(key):
    v = args.get(key)
    if not isinstance(v, str) or not v.strip():
        die("ArgumentsBad", "%s needs %s: one short sentence (a non-empty string)" % (op, key))
    return v.strip()


cmd_call.catch_signals()                       # TERM 與 Ctrl-C：先收掉正在跑的那一群，退 128＋N（Ctrl-C 130、不吐 traceback，R12）
args = tool_io.arguments()
OPS = {"get": (), "set": ("text", "limit"), "done": ("status", "reason"), "pause": ("reason",), "resume": ()}
op = args.get("op")
if op is None:
    die("ArgumentsBad", "op is required (%s)" % ", ".join(OPS))
if op not in OPS:
    die("OpUnknown", "op must be one of %s (got %r)" % (", ".join(OPS), op))
extra = sorted(k for k in args if k != "op" and k not in OPS[op])
if extra:
    die("ArgumentsBad", "op %s does not take %s (it takes %s)" % (op, ", ".join(extra), ", ".join(OPS[op]) or "nothing else"))

cmd, given = ["goal", "--target", None, op], None
if op == "set":
    given = sentence("text")
    if "limit" in args:
        limit = args["limit"]
        if not isinstance(limit, int) or isinstance(limit, bool) or limit < 1:
            die("ArgumentsBad", "limit must be a whole number >= 1 (reminders in a row without progress; default 10)")
        cmd += ["--limit", str(limit)]
    cmd += ["-"]
elif op == "done":
    status = args.get("status", "done")
    if status not in ("done", "abandoned"):
        die("ArgumentsBad", "status must be done or abandoned (got %r)" % (status,))
    if status == "abandoned":
        cmd += ["--abandoned"]
    cmd += ["--", sentence("reason")]
elif op == "pause":
    cmd += ["--", sentence("reason")]

cmd[2] = agent("ctl", "who").strip()
notes.clear()                                   # ctl who 的提醒不算這次的
out = agent(*cmd, text=given)
if out:
    sys.stdout.write(out if out.endswith("\n") else out + "\n")
for line in notes:
    print("(%s)" % line)
