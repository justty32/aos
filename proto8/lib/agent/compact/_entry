#!/usr/bin/env python3
# compact - history.jsonl 超過 MAX_BYTES 就壓成短版（三步：工具呼叫各一句 → 逐段總結＋保留行 → 最後修飾），交給 history 格換上
"""叫法：aos-exec <compact 格> <agent 資料夾> [--force]；掛在 hook/pre_think（掛勾只收 agent 資料夾這一個參數）。

觸發（agent-round § 4 history）：$AOS_STACK/history.jsonl 沒超過 MAX_BYTES（沒設＝65536）＝什麼都不動、退 0；--force＝不看門檻。
「壓」的實際內容在這格（實作時代定，見 agent-round 文末）：history 格的 compact 只負責「舊的整份收進 history_archive/、
換上給它的短版」，壓成什麼樣是這格的事。三步土法從 demo/agent-hal/compact 搬來（thinking 2026-10-24-compact）：
  第 1 步 note：每次叫工具（assistant 的 tool_calls＋對應的 tool 結果）交給腦，一個呼叫一句「在幹嘛，結果如何」。
  第 2 步 segment：第 1 步後的紀錄每 SEG_KB 切一段，各段產總結，並挑幾行原樣保留（keep，打標記＋理由）。
  第 3 步 final：各段總結＋候選保留行串起來修成一份摘要、選最後要留的 keep。
  最近 KEEP_TURNS 題與還沒答完的那題原樣不動；更早的換成一則 user（摘要＋保留原文）＋一則 assistant（讀過了）。
問腦走 endpoint 格：ENDPOINT（這格的設定）＞ $AOS_STACK/endpoint.txt ＞ default，槽名 endpoint/<名>；
  MODEL_NOTE／MODEL_SEG／MODEL_FINAL 有設才在請求裡帶 model（沒設＝用 endpoint 自己的）。腦回的不是 JSON 就走退路（照字面拼／整段當摘要）。
history 與 endpoint 怎麼找：aos-parts --file <agent>/parts.json which --json <槽>（沒掛＝PartMissing），env 疊上去、aos-exec 它。
做到一半的產物落在 $AOS_STACK/compact/run/（失敗重跑從斷的那步接著做）；換上之後改名成 compact/<run>/（report.json、log.jsonl）。
壓了沒變小＝不換（收成 compact/nosave-<run>/，同一份 history 不再壓）。同一個 stack 一次只壓一個（flock）。
設定（這格的 env；parts.json 的 env 或這格的 .env）：MAX_BYTES、SEG_KB（8）、KEEP_TURNS（2）、KEEP_MAX（3）、KEEP_FINAL_MAX（12）、
  KEEP_LINE_MAX（1500）、RESULT_CUT（2000）、ENDPOINT、MODEL_NOTE、MODEL_SEG、MODEL_FINAL。
錯：stderr 一行「compact: 代號 原因」、退 1（N-43）。代號：ArgumentsBad、AgentMissing、StackMissing、SettingBad、PartMissing、
PartsFailed、HistoryFailed、HistoryChanged、EndpointFailed、SummaryEmpty。"""
import datetime, fcntl, hashlib, json, os, subprocess, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import ask
from ask import die, flat

KEEP_TAGS = ("user_words", "decision", "number", "open", "other")
MARK = "【compact】"
ACK = "好，我已讀過先前對話的摘要與保留的原文，接著往下。"


def env_int(name, default):
    v = os.environ.get(name)
    if v in (None, ""):
        return default
    try:
        n = int(v)
    except ValueError:
        die("SettingBad", "%s 不是整數：%r" % (name, v))
    if n < 0:
        die("SettingBad", "%s 不能是負的：%r" % (name, v))
    return n


MAX_BYTES = env_int("MAX_BYTES", 65536)
SEG_KB = max(1, env_int("SEG_KB", 8))
KEEP_TURNS = env_int("KEEP_TURNS", 2)
KEEP_MAX = env_int("KEEP_MAX", 3)
KEEP_FINAL_MAX = env_int("KEEP_FINAL_MAX", 12)
KEEP_LINE_MAX = env_int("KEEP_LINE_MAX", 1500)
RESULT_CUT = env_int("RESULT_CUT", 2000)
MODEL_NOTE, MODEL_SEG, MODEL_FINAL = (os.environ.get(k) or "" for k in ("MODEL_NOTE", "MODEL_SEG", "MODEL_FINAL"))

args = sys.argv[1:]
if not args or any(a != "--force" for a in args[1:]):
    die("ArgumentsBad", "usage: compact <agent 資料夾> [--force]")
AGENT = os.path.abspath(args[0])
if not os.path.isdir(AGENT):
    die("AgentMissing", "agent 資料夾不存在：%s" % args[0])
FORCE = "--force" in args[1:]
STACK = os.environ.get("AOS_STACK")
if not STACK:
    die("StackMissing", "沒設定 AOS_STACK")
HIST = os.path.join(STACK, "history.jsonl")
CDIR = os.path.join(STACK, "compact")
RUN = os.path.join(CDIR, "run")
HERE = os.path.dirname(os.path.realpath(__file__))


# ---- 別的格 ----

def part(slot):
    try:
        r = subprocess.run(["aos-parts", "--file", os.path.join(AGENT, "parts.json"), "which", "--json", slot],
                           stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, text=True)
    except OSError as e:
        die("PartsFailed", "aos-parts 起不來：%s" % e)
    if r.returncode == 10:
        die("PartMissing", "沒掛 %s 格（%s/parts.json 沒登記、也沒有固定名字）" % (slot, AGENT))
    if r.returncode != 0:
        die("PartsFailed", "aos-parts which %s 退 %d" % (slot, r.returncode))
    try:
        p = json.loads(r.stdout)
        return p["path"], {k: str(v) for k, v in (p.get("env") or {}).items()}
    except (ValueError, KeyError, TypeError, AttributeError) as e:
        die("PartsFailed", "aos-parts which --json 印的不是 {path, env}：%s" % e)


def history(sub, extra=(), stdin_text=""):
    path, env = part("history")
    e = dict(os.environ)
    e.update(env)
    try:
        r = subprocess.run(["aos-exec", path, AGENT, sub] + list(extra), input=stdin_text,
                           stdout=subprocess.PIPE, text=True, env=e)
    except OSError as ex:
        die("HistoryFailed", "aos-exec 起不來：%s" % ex)
    if r.returncode != 0:                      # history 自己已說了原因（P-21）
        die("HistoryFailed", "history %s 退 %d" % (sub, r.returncode))
    return r.stdout


def endpoint():
    name = os.environ.get("ENDPOINT") or ""
    if not name:
        try:
            with open(os.path.join(STACK, "endpoint.txt"), encoding="utf-8") as f:
                name = f.read().strip()
        except FileNotFoundError:
            pass
    return part("endpoint/" + (name or "default"))


# ---- 小工具 ----

def prompt(name, max_keep=0):
    with open(os.path.join(HERE, "prompts", name + ".txt"), encoding="utf-8") as f:
        return f.read().replace("{max_keep}", str(max_keep))


def read_json(path, default=None):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def write_json(path, value):
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))   # N-05
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(value, f, ensure_ascii=False, indent=1)
        f.write("\n")
    os.replace(tmp, path)


def write_jsonl(path, lines):
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("".join(json.dumps(x, ensure_ascii=False) + "\n" for x in lines))
    os.replace(tmp, path)


def text(m):
    c = m.get("content")
    return c if isinstance(c, str) else ("" if c is None else json.dumps(c, ensure_ascii=False))


def cut_middle(s, n):
    if s is None or len(s) <= n:
        return s
    head = n * 3 // 4
    return s[:head] + "\n…（中間截掉 %d 字）…\n" % (len(s) - n) + s[-(n - head):]


def now_id():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")


def last_log():
    try:
        with open(os.path.join(CDIR, "log.jsonl"), encoding="utf-8") as f:
            lines = [x for x in f if x.strip()]
        return json.loads(lines[-1]) if lines else {}
    except (OSError, ValueError):
        return {}


def log(entry):
    with open(os.path.join(CDIR, "log.jsonl"), "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def count(st, fallbacks=0):
    st["counter_calls"] += 1
    st["counter_fallbacks"] += fallbacks


# ---- 切出要壓的那段 ----

def split_point(rows):
    """要壓的是 rows[:cut]。一題＝從 user 起、到一則沒有 tool_calls 的 assistant 止；最近 KEEP_TURNS 題與沒答完的那題不壓。"""
    done, start = [], None
    for i, (_, _, m) in enumerate(rows):
        role = m.get("role")
        if role == "user" and start is None:
            start = i
        elif role == "assistant" and not m.get("tool_calls") and start is not None:
            done.append(start)
            start = None
    if KEEP_TURNS:
        return done[-KEEP_TURNS] if len(done) > KEEP_TURNS else 0
    return start if start is not None else len(rows)


def old_compact(rows):
    """開頭是上一次 compact 留下的那一對（user 以 MARK 開頭＋assistant）就回 (run 名, 那則 user 的內容)。"""
    if len(rows) >= 2 and rows[0][2].get("role") == "user" and text(rows[0][2]).startswith(MARK) \
            and rows[1][2].get("role") == "assistant":
        words = text(rows[0][2]).split("\n", 1)[0][len(MARK):].split()
        run = words[0].replace("run=", "") if words else ""
        if not run or not all(ch.isdigit() or ch in "-x" for ch in run):
            run = ""                            # 認不出是哪一次（被手改過）：只拿那則的全文當舊摘要
        return run, text(rows[0][2])
    return None


# ---- 第 1 步：工具呼叫各一句 ----

def stage_note(body, report, ep):
    cache_path = os.path.join(RUN, "notes.json")
    cache = read_json(cache_path, {})
    results = {}
    for n, _, m in body:
        if m.get("role") == "tool" and m.get("tool_call_id") is not None:
            results.setdefault(m["tool_call_id"], (n, m))
    called, lines, last_user = set(), [], ""
    st = report["stages"]["note"]
    for n, _, m in body:
        role = m.get("role")
        if role == "tool":
            if m.get("tool_call_id") in called:
                continue
            lines.append({"_n": [None, n], "role": "tool_note", "tool_call_id": m.get("tool_call_id"),
                          "name": "?", "ok": None, "content": "（找不到是誰叫的）工具回：" + flat(text(m), 80)})
            continue
        calls = [c for c in (m.get("tool_calls") or []) if isinstance(c, dict)] if role == "assistant" else []
        if not calls:
            if role == "user":
                last_user = text(m)
            lines.append(dict(m, _n=n))
            continue
        if text(m).strip():
            lines.append({"_n": n, "role": "assistant", "content": text(m)})
        items = []
        for c in calls:
            fn = c.get("function") if isinstance(c.get("function"), dict) else {}
            cid = c.get("id")
            res = results.get(cid)
            items.append({"id": cid, "name": fn.get("name") or "?", "arguments": fn.get("arguments"),
                          "result": cut_middle(text(res[1]), RESULT_CUT) if res else None,
                          "n_result": res[0] if res else None})
            called.add(cid)
        key = str(n)
        if key not in cache:
            user = "使用者在問：%s\nagent 說：%s\n\n" % (flat(last_user, 300), flat(text(m), 300) or "（沒說話）")
            user += "\n\n".join("呼叫 id=%s\n工具：%s\n參數：%s\n結果：%s" % (
                it["id"], it["name"], flat(it["arguments"] if isinstance(it["arguments"], str)
                                           else json.dumps(it["arguments"], ensure_ascii=False), 1000),
                it["result"] if it["result"] is not None else "（沒有結果：中途停了）") for it in items)
            got = ask.parse_json(ask.ask(ep, AGENT, MODEL_NOTE, prompt("note"), user))
            notes = {}
            if got and isinstance(got.get("notes"), list):
                notes = {x.get("id"): x for x in got["notes"] if isinstance(x, dict) and isinstance(x.get("line"), str)}
            count(st, len([it for it in items if it["id"] not in notes]))
            cache[key] = {}
            for it in items:
                x = notes.get(it["id"])
                if x:
                    ok = x.get("ok") if isinstance(x.get("ok"), bool) else None
                    line = flat(x["line"], 200)
                else:
                    ok, line = None, ask.literal_note(it)
                if it["result"] is None:
                    ok = False
                cache[key][str(it["id"])] = {"ok": ok, "line": line}
            write_json(cache_path, cache)
        for it in items:
            x = cache[key].get(str(it["id"])) or {"ok": None, "line": "?"}
            lines.append({"_n": [n, it["n_result"]], "role": "tool_note", "tool_call_id": it["id"],
                          "name": it["name"], "ok": x["ok"], "content": x["line"]})
    return lines


# ---- 第 2 步：逐段總結＋挑保留行 ----

def first_n(line):
    n = line["_n"]
    return n if isinstance(n, int) else (n[0] if n[0] is not None else n[1])


def keep_text(line):
    return json.dumps({k: v for k, v in line.items() if k != "_n"}, ensure_ascii=False)


def size(line):
    return len(keep_text(line).encode("utf-8"))


def segments(lines):
    """每段約 SEG_KB；同一則 assistant 叫的幾個工具不拆開；超過時盡量切在一則 user 前（前半至少半段）。"""
    blocks = []
    for ln in lines:
        k = ln["_n"][0] if ln["role"] == "tool_note" and isinstance(ln["_n"], list) else None
        if blocks and k is not None and blocks[-1]["key"] == k:
            blocks[-1]["lines"].append(ln)
        elif blocks and k is not None and blocks[-1]["key"] is None \
                and blocks[-1]["lines"][-1]["role"] == "assistant" and blocks[-1]["lines"][-1]["_n"] == k:
            blocks[-1]["lines"].append(ln)
            blocks[-1]["key"] = k
        else:
            blocks.append({"key": k, "lines": [ln]})
    limit = SEG_KB * 1024
    segs, cur = [], []
    bsize = lambda b: sum(size(x) for x in b["lines"])
    for b in blocks:
        if cur and sum(map(bsize, cur)) + bsize(b) > limit:
            at = len(cur)
            for i in range(len(cur) - 1, 0, -1):
                if cur[i]["lines"][0]["role"] == "user" and sum(map(bsize, cur[:i])) >= limit // 2:
                    at = i
                    break
            segs.append(cur[:at])
            cur = cur[at:]
        cur.append(b)
    if cur:
        segs.append(cur)
    return [[ln for b in s for ln in b["lines"]] for s in segs]


def render(ln, cut):
    if ln["role"] == "tool_note":
        ok = {True: "成功", False: "失敗", None: "不確定"}[ln["ok"]]
        return "L%d 工具 %s（%s，id=%s）：%s" % (first_n(ln), ln["name"], ok, ln["tool_call_id"], ln["content"])
    return "L%d %s：%s" % (first_n(ln), ln.get("role"), cut_middle(text(ln), cut))


def stage_segment(lines, report, ep):
    st = report["stages"]["segment"]
    segs = segments(lines)
    st["counter_segments"] = len(segs)
    out = []
    os.makedirs(os.path.join(RUN, "seg"), exist_ok=True)
    for i, seg in enumerate(segs, 1):
        path = os.path.join(RUN, "seg", "%04d.json" % i)
        nums = [first_n(ln) for ln in seg]
        got = read_json(path)
        if got is None or got.get("lines") != nums:
            by_n = {first_n(ln): ln for ln in seg}
            user = "\n".join(render(ln, SEG_KB * 1024) for ln in seg)
            content = ask.ask(ep, AGENT, MODEL_SEG, prompt("segment", KEEP_MAX), user)
            reply = ask.parse_json(content)
            fallback = not (reply and isinstance(reply.get("summary"), str))
            summary = content.strip() if fallback else reply["summary"].strip()
            count(st, int(fallback))
            if not summary:                    # 空的摘要換上去＝這段整個不見：寧可停下（重跑會再問這段）
                die("SummaryEmpty", "第 %d 段（L%d～L%d）的摘要是空的" % (i, nums[0], nums[-1]))
            keeps, dropped = [], []
            ks = (reply or {}).get("keep")
            for k in (ks if isinstance(ks, list) and not fallback else []):
                n = k.get("n") if isinstance(k, dict) else k
                if isinstance(n, str) and n.lstrip("L").isdigit():
                    n = int(n.lstrip("L"))
                if n not in by_n:
                    dropped.append({"n": n, "why": "不在這段"})
                    continue
                if any(x["id"] == "L%d" % n for x in keeps):
                    continue
                if len(keeps) >= KEEP_MAX:
                    dropped.append({"n": n, "why": "超過每段上限 %d" % KEEP_MAX})
                    continue
                t = keep_text(by_n[n])
                if len(t) > KEEP_LINE_MAX:
                    dropped.append({"n": n, "why": "太長（%d 字 > %d）" % (len(t), KEEP_LINE_MAX)})
                    continue
                tag = k.get("tag") if isinstance(k, dict) and k.get("tag") in KEEP_TAGS else "other"
                why = flat(k.get("why"), 80) if isinstance(k, dict) and isinstance(k.get("why"), str) else ""
                keeps.append({"id": "L%d" % n, "tag": tag, "why": why, "text": t})
            got = {"lines": nums, "summary": summary, "keep": keeps, "dropped": dropped, "fallback": fallback}
            write_json(path, got)
        out.append(got)
    return out


# ---- 第 3 步：最後修飾 ----

def keep_entry(k):
    return "[%s %s：%s] %s" % (k["id"], k["tag"], k["why"] or "—", k["text"])


def stage_final(segs, old, report, ep):
    path = os.path.join(RUN, "final.json")
    got = read_json(path)
    if got is not None:
        return got
    st = report["stages"]["final"]
    old_final = read_json(os.path.join(CDIR, old[0], "final.json")) if old and old[0] else None
    old_summary = (old_final or {}).get("summary") or (old[1] if old else "")
    cands = [dict(k, id="old:" + k["id"].split(":")[-1]) for k in (old_final or {}).get("keep", [])]
    for s in segs:
        cands += s["keep"]
    user = ""
    if old:
        user += "## 更早一次壓縮留下的摘要\n%s\n\n" % old_summary
    user += "## 這次各段的摘要（照時間順序）\n"
    for i, s in enumerate(segs, 1):
        user += "### 第 %d 段（L%d～L%d）\n%s\n\n" % (i, s["lines"][0], s["lines"][-1], s["summary"])
    user += "## 候選保留行\n" + ("\n".join(keep_entry(k) for k in cands) or "（沒有）")
    content = ask.ask(ep, AGENT, MODEL_FINAL, prompt("final", KEEP_FINAL_MAX), user)
    reply = ask.parse_json(content)
    fallback = not (reply and isinstance(reply.get("summary"), str))
    count(st, int(fallback))
    summary = (content if fallback else reply["summary"]).strip()
    if not summary:
        die("SummaryEmpty", "第 3 步的摘要是空的")
    by_id = {k["id"]: k for k in cands}
    ids = [k["id"] for k in cands] if fallback else [x for x in (reply.get("keep") or []) if isinstance(x, str)]
    keep, seen = [], set()
    for x in ids:
        if x in by_id and x not in seen and len(keep) < KEEP_FINAL_MAX:
            keep.append(by_id[x])
            seen.add(x)
    got = {"summary": summary, "keep": keep, "counter_candidates": len(cands), "fallback": fallback}
    write_json(path, got)
    return got


# ---- 主流程 ----

def sha(s):
    return hashlib.sha256(s.encode("utf-8")).hexdigest()


def main():
    if not os.path.isfile(HIST):
        return 0
    before = os.path.getsize(HIST)
    if not FORCE and before <= MAX_BYTES and not os.path.isdir(RUN):
        return 0                               # 沒超過門檻：什麼都不動
    os.makedirs(CDIR, exist_ok=True)
    lock = open(os.path.join(CDIR, ".lock"), "w")
    fcntl.flock(lock, fcntl.LOCK_EX)           # 同一個 stack 一次只壓一個（手動跑與掛勾撞到時，後到的等）
    t0 = time.time()
    raw = history("read")
    if os.path.getsize(HIST) != before:
        die("HistoryChanged", "讀 history 的期間它被接了，這次不壓")
    try:
        msgs = json.loads(raw)
    except ValueError:
        die("HistoryFailed", "history read 印的不是 JSON")
    rows = [(n, json.dumps(m, ensure_ascii=False), m) for n, m in enumerate(msgs, 1) if isinstance(m, dict)]
    digest = sha(raw)
    src = read_json(os.path.join(RUN, "source.json"))
    if src and src.get("sha") != digest:       # history 在中斷後又變了：舊的半成品留著不用（不刪）
        os.replace(RUN, os.path.join(CDIR, "stale-" + now_id()))
        src = None
    if not src and not FORCE:
        if before <= MAX_BYTES:
            return 0
        if last_log().get("nosave") == digest:
            return 0                           # 這份上次壓了沒變小：同一份不再花錢壓（多接幾行才再試）
    cut = split_point(rows)
    prefix, tail = rows[:cut], rows[cut:]
    old = old_compact(prefix)
    body = prefix[2:] if old else prefix
    if not body:
        log({"skip": "沒有可以壓的（全是最近 %d 題、還沒答完的那題、或上次的摘要）" % KEEP_TURNS,
             "bytes": before, "time": now_id()})
        return 0
    ep = endpoint()
    os.makedirs(RUN, exist_ok=True)
    if not src:
        src = {"sha": digest, "bytes": before, "cut": cut, "started": now_id()}
        write_json(os.path.join(RUN, "source.json"), src)
    report = read_json(os.path.join(RUN, "report.json")) or {
        "stages": {s: {"counter_calls": 0, "counter_fallbacks": 0} for s in ("note", "segment", "final")}}
    report["stages"]["segment"].setdefault("counter_segments", 0)
    try:
        lines = stage_note(body, report, ep)
        write_jsonl(os.path.join(RUN, "stage1.jsonl"), lines)
        segs = stage_segment(lines, report, ep)
        final = stage_final(segs, old, report, ep)
    finally:
        write_json(os.path.join(RUN, "report.json"), report)    # 失敗也記下問了幾次（重跑接著累加）
    run_id = src["started"]
    while os.path.exists(os.path.join(CDIR, run_id)):
        run_id += "x"
    rnd = ((read_json(os.path.join(CDIR, old[0], "report.json")) or {}).get("round", 1) + 1) if old and old[0] else 1
    head = "%srun=%s 第 %d 次壓縮。以下是先前對話（原本 %d 則訊息、%.1f KB）的摘要與原樣保留的幾則；" \
           "原始紀錄整份在 $AOS_STACK/history_archive/（哪一份見 $AOS_STACK/compact/%s/report.json 的 archive）。" % (
               MARK, run_id, rnd, len(prefix), sum(len(r[1].encode()) + 1 for r in prefix) / 1024, run_id)
    content = head + "\n\n## 摘要\n" + final["summary"]
    if final["keep"]:
        content += "\n\n## 原樣保留的訊息（keep）\n" + "\n".join("- " + keep_entry(k) for k in final["keep"])
    new_lines = [json.dumps({"role": "user", "content": content}, ensure_ascii=False),
                 json.dumps({"role": "assistant", "content": ACK}, ensure_ascii=False)] + [r[1] for r in tail]
    new_text = "".join(x + "\n" for x in new_lines)
    after = len(new_text.encode("utf-8"))
    report.update({"run": run_id, "round": rnd, "seconds": round(time.time() - t0, 2),
                   "endpoint": ep[0], "models": {"note": MODEL_NOTE, "segment": MODEL_SEG, "final": MODEL_FINAL},
                   "settings": {"max_bytes": MAX_BYTES, "seg_kb": SEG_KB, "keep_turns": KEEP_TURNS, "keep_max": KEEP_MAX,
                                "keep_final_max": KEEP_FINAL_MAX, "keep_line_max": KEEP_LINE_MAX},
                   "before": {"bytes": before, "counter_messages": len(rows)},
                   "compacted": {"bytes": sum(len(r[1].encode()) + 1 for r in prefix), "counter_messages": len(prefix),
                                 "stage1_bytes": sum(size(x) + 1 for x in lines)},
                   "after": {"bytes": after, "counter_messages": len(new_lines)},
                   "counter_tail_messages": len(tail),
                   "keep": {"counter_candidates": final["counter_candidates"],
                            "final": [k["id"] + " " + k["tag"] for k in final["keep"]],
                            "dropped": [d for s in segs for d in s["dropped"]]}})
    write_json(os.path.join(RUN, "report.json"), report)
    if after >= before:                        # 沒變小就不換（摘要寫得比原文還長）；半成品收成 nosave-<run>
        os.replace(RUN, os.path.join(CDIR, "nosave-" + run_id))
        log({"nosave": digest, "run": "nosave-" + run_id, "before": before, "after": after})
        return 0                               # 不是錯：記在 log.jsonl，不印（stderr 只放錯，N-43）
    arch = history("compact", ["--expect-bytes", str(before)], new_text).strip()   # 舊的收進 history_archive/、新的換上
    report["archive"] = arch
    write_json(os.path.join(RUN, "report.json"), report)
    dest = os.path.join(CDIR, run_id)
    os.replace(RUN, dest)
    log(report)
    return 0


sys.exit(main())
