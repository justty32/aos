#!/usr/bin/env python3
# brain_notify - brain_failed 的 hook handler：把腦拒絕的原因寄到 AOS_NOTIFY_BOX，同一段 history、同一代號只通知一次。
# 介面：stdin＝事件 JSON（event、hook、stack＝agent 的絕對 stack、name＝錯誤代號、reason）；$AOS_STACK＝hook 自己的小格。
# 記帳：$AOS_STACK/notified.json＝{code, history_lines}；寄成才先寫暫存檔再改名，不靠 cooldown.json 的寫入順序。
# 寄信：aos-mailbox --stack <agent stack> send --from <agent 名> --box <box> --status BLOCKED --title ... -- <原因與重試說明>。
# AOS_NOTIFY_BOX 沒設＝warning、不寄；所有錯誤都只印一行英文 warning、退 0，不能讓 agent 因通知失敗而停下。
import json, os, subprocess, sys

NAME = "brain_notify"
HELP = """usage: brain_notify < EVENT.json   (a brain_failed hook handler; $AOS_STACK = this hook's own cell)
Send a BLOCKED letter to $AOS_NOTIFY_BOX about the agent's refused brain request.
The event supplies stack (the agent's absolute stack), name (error code), and reason.
The letter says that the same request is sent again after a cooldown (30 s doubling to 30 min).
Only send once for the same code and number of lines in STACK/history.jsonl.
After a successful send, save {code, history_lines} in $AOS_STACK/notified.json.
An unset or blank AOS_NOTIFY_BOX only prints a warning; subagent add defaults it to the parent's mailbox.
Needs aos-mailbox on PATH. All errors print one warning and exit 0; the agent is never failed.
exit codes: 0 done (also on any error).
"""
STEP_S = 8                                      # 範本 timeout_ms 10000，留餘裕
SEEN = "notified.json"


def die(code, why):
    sys.stderr.write("%s: warning: %s %s\n" % (NAME, code, " ".join(str(why).split())))
    sys.exit(0)


def run(argv):
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=STEP_S)
    except OSError as e:
        die("LaunchFailed", "cannot run %s (put it on PATH with proto8/install.sh): %s" % (argv[0], e))
    except subprocess.TimeoutExpired:
        die("CommandFailed", "%s send took over %d s" % (argv[0], STEP_S))
    if p.returncode != 0:
        last = [x for x in p.stderr.splitlines() if x.strip()]
        die("CommandFailed", "%s exited %d: %s" % (argv[0], p.returncode, last[-1] if last else "(no message)"))


def main():
    if sys.argv[1:2] in (["-h"], ["--help"]):
        sys.stdout.write(HELP)
        return 0
    if sys.argv[1:]:
        die("ArgumentsBad", "takes no arguments; the event JSON comes on stdin (usage: brain_notify < EVENT.json)")
    try:
        event = json.load(sys.stdin)
    except ValueError as e:
        die("ArgumentsBad", "the event on stdin is not JSON: %s" % e)
    if not isinstance(event, dict) or event.get("event") != "brain_failed":
        die("ArgumentsBad", "the event must be a brain_failed JSON object")
    stack, code, reason = (event.get(k) for k in ("stack", "name", "reason"))
    if not isinstance(stack, str) or not os.path.isabs(stack):
        die("ArgumentsBad", "the event needs stack (the agent's absolute stack folder)")
    if not isinstance(code, str) or not code.strip() or not isinstance(reason, str):
        die("ArgumentsBad", "the event needs name (an error code) and reason (a string)")
    agent = os.path.basename(os.path.normpath(stack))
    box = os.environ.get("AOS_NOTIFY_BOX", "").strip()
    if not box:
        sys.stderr.write("%s: warning: AOS_NOTIFY_BOX is not set; nobody is told that %s got %s\n"
                         % (NAME, " ".join(agent.split()), " ".join(code.split())))
        return 0
    cell = os.environ.get("AOS_STACK")
    if not cell:
        die("StackMissing", "AOS_STACK is not set (this hook's own cell)")
    history = os.path.join(stack, "history.jsonl")
    try:
        with open(history, "rb") as f:
            lines = sum(1 for _ in f)
    except FileNotFoundError:
        lines = 0
    except OSError as e:
        die("ReadFailed", "cannot read %s: %s" % (history, e))
    keep = {"code": code, "history_lines": lines}
    path = os.path.join(cell, SEEN)
    try:
        with open(path, encoding="utf-8") as f:
            seen = json.load(f)
    except (FileNotFoundError, ValueError):
        seen = None
    except OSError as e:
        die("ReadFailed", "cannot read %s: %s" % (path, e))
    if isinstance(seen, dict) and seen.get("code") == code and seen.get("history_lines") == lines:
        return 0
    title = "%s: brain refused (%s), waiting" % (agent, code)
    what = ("%s. It sends the same request again by itself after a cooldown (30 s doubling to 30 min). "
            "Raise the budget, or stop it." % reason)
    run(["aos-mailbox", "--stack", stack, "send", "--from", agent, "--box", box, "--status", "BLOCKED", "--title", title, "--", what])
    tmp = os.path.join(cell, ".%s.%d.tmp" % (SEEN, os.getpid()))
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(json.dumps(keep) + "\n")
        os.replace(tmp, path)
    except OSError as e:
        die("WriteFailed", "cannot write %s: %s" % (path, e))
    return 0


try:
    sys.exit(main())
except Exception as e:
    die("NotifyFailed", str(e))
