{"description": "Shared table for the $ref / index path rule (left of # = file system, right of # = inside the json; thinking 2026-11/13/ref-path-rules): one row per rule, run by lib/tests/test_ref_path.py.",
 "cases": [
  {"rule": "no # = file system, from the folder of the json file", "file": "kb/m.json", "here": ["a", "b"], "text": "other.json", "to": "kb/other.json"},
  {"rule": "no # ./", "file": "kb/m.json", "here": ["a", "b"], "text": "./zzz.json", "to": "kb/zzz.json"},
  {"rule": "no # ../", "file": "kb/m.json", "here": ["a", "b"], "text": "../xxx.json", "to": "xxx.json"},
  {"rule": "no # sub path", "file": "kb/m.json", "here": [], "text": "sub/x.json", "to": "kb/sub/x.json"},
  {"rule": "no # folder", "file": "kb/m.json", "here": [], "text": "sub/", "to": "kb/sub"},
  {"rule": "no # name never walks into the object", "file": "kb/m.json", "here": ["o", "p"], "text": "q/_index", "to": "kb/q/_index"},
  {"rule": "no # normalised", "file": "kb/m.json", "here": [], "text": "./sub/../other.json#/k", "to": "kb/other.json#/k"},
  {"rule": "no # absolute", "file": "kb/m.json", "here": [], "text": "/abs/x.json#/k", "to": "/abs/x.json#/k"},
  {"rule": "#/a/b from the root", "file": "kb/m.json", "here": ["o", "p"], "text": "#/key", "to": "kb/m.json#/key"},
  {"rule": "#/a/b from the root, deep", "file": "kb/m.json", "here": ["o"], "text": "#/a/b", "to": "kb/m.json#/a/b"},
  {"rule": "#/ .. is just a key", "file": "kb/m.json", "here": [], "text": "#/a/../b", "to": "kb/m.json#/a/../b"},
  {"rule": "#/ escapes kept", "file": "kb/m.json", "here": [], "text": "#/a~1b/c~0", "to": "kb/m.json#/a~1b/c~0"},
  {"rule": "#/ later # is part of the key", "file": "kb/m.json", "here": [], "text": "#/a#b", "to": "kb/m.json#/a#b"},
  {"rule": "#./b from the object it is written in", "file": "kb/m.json", "here": ["o", "p"], "text": "#./b", "to": "kb/m.json#/o/p/b"},
  {"rule": "#./ deep", "file": "kb/m.json", "here": ["o"], "text": "#./b/c", "to": "kb/m.json#/o/b/c"},
  {"rule": "#./ at the root", "file": "kb/m.json", "here": [], "text": "#./b", "to": "kb/m.json#/b"},
  {"rule": "#./ = that object", "file": "kb/m.json", "here": ["o", "p"], "text": "#./", "to": "kb/m.json#/o/p"},
  {"rule": "#. = that object", "file": "kb/m.json", "here": ["o", "p"], "text": "#.", "to": "kb/m.json#/o/p"},
  {"rule": "#../c one level up", "file": "kb/m.json", "here": ["o", "p"], "text": "#../c", "to": "kb/m.json#/o/c"},
  {"rule": "#../../c chained", "file": "kb/m.json", "here": ["o", "p"], "text": "#../../c", "to": "kb/m.json#/c"},
  {"rule": "#../ = the outer object", "file": "kb/m.json", "here": ["o", "p"], "text": "#../", "to": "kb/m.json#/o"},
  {"rule": "#.. = the outer object", "file": "kb/m.json", "here": ["o", "p"], "text": "#..", "to": "kb/m.json#/o"},
  {"rule": "#../.. up to the root = whole file", "file": "kb/m.json", "here": ["o", "p"], "text": "#../..", "to": "kb/m.json"},
  {"rule": "#../ .. after a name is a key", "file": "kb/m.json", "here": ["o", "p"], "text": "#../c/../d", "to": "kb/m.json#/o/c/../d"},
  {"rule": "#../ above the root", "file": "kb/m.json", "here": ["o"], "text": "#../../c", "err": "bad"},
  {"rule": "#../ above the root at the root", "file": "kb/m.json", "here": [], "text": "#../c", "err": "bad"},
  {"rule": "# = whole file", "file": "kb/m.json", "here": ["o"], "text": "#", "to": "kb/m.json"},
  {"rule": "#/ = whole file", "file": "kb/m.json", "here": ["o"], "text": "#/", "to": "kb/m.json"},
  {"rule": "y.json#/k", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#/kkk", "to": "kb/yyy.json#/kkk"},
  {"rule": "y.json# = whole", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#", "to": "kb/yyy.json"},
  {"rule": "y.json#/ = whole", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#/", "to": "kb/yyy.json"},
  {"rule": "../y.json#/k", "file": "kb/m.json", "here": ["o"], "text": "../up/y.json#/k", "to": "up/y.json#/k"},
  {"rule": "y.json#./ not allowed", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#./", "err": "bad"},
  {"rule": "y.json#./k not allowed", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#./k", "err": "bad"},
  {"rule": "y.json#../ not allowed", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#../", "err": "bad"},
  {"rule": "y.json#../k not allowed", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#../k", "err": "bad"},
  {"rule": "#aaa not allowed", "file": "kb/m.json", "here": ["o"], "text": "#aaa", "err": "bad"},
  {"rule": "y.json#aaa not allowed", "file": "kb/m.json", "here": ["o"], "text": "yyy.json#aaa", "err": "bad"},
  {"rule": "#.x not allowed", "file": "kb/m.json", "here": ["o"], "text": "#.x", "err": "bad"},
  {"rule": "#... not allowed", "file": "kb/m.json", "here": ["o"], "text": "#.../x", "err": "bad"},
  {"rule": "empty string not allowed", "file": "kb/m.json", "here": ["o"], "text": "", "err": "bad"},
  {"rule": "#/ without knowing the file", "file": null, "here": null, "text": "#/k", "err": "unknown"},
  {"rule": "#./ without knowing where", "file": "kb/m.json", "here": null, "text": "#./k", "err": "unknown"},
  {"rule": "#aaa is bad even without a file", "file": null, "here": null, "text": "y.json#aaa", "err": "bad"}
 ]}
