{"slots": 2, "timeout_ms": 120000,
 "exec": "../../lib/base/llm_http",
 "endpoint": "fake",
 "budget": {"senders": {"/tmp/aos-demo-sender": {"max_calls": 1}}},
 "endpoints": {
   "smart-high":  {"url": "http://localhost:4000/v1", "model": "claude-haiku-5-5", "fixed": {"temperature": 0.2},
                   "slots": 4, "speed": "normal", "cost": "high", "context": 200000,
                   "summary": "LiteLLM claude haiku: careful answers, costs money"},
   "stupid-fast": {"url": "http://localhost:1234/v1", "model": "qwen3-1.7b", "fixed": {"temperature": 0.7},
                   "slots": 1, "speed": "fast", "cost": "free", "context": 4096,
                   "summary": "LM Studio qwen3 1.7b on this machine: quick and rough, one at a time"},
   "luna":        {"url": "http://localhost:4000/v1", "model": "chatgpt-gpt-6-luna-low", "cost": "high",
                   "summary": "LiteLLM gpt-6 luna, low effort"},
   "sol":         {"url": "http://localhost:4000/v1", "model": "chatgpt-gpt-6-sol", "fixed": {"temperature": 0.2}, "cost": "high",
                   "summary": "LiteLLM gpt-6 sol"},
   "fake":        {"exec": "../../lib/base/llm_fake", "speed": "fast", "cost": "free",
                   "summary": "fake brain: calls the first tool, then answers FAKE ANSWER to ..."},
   "fake-demo-self": {"exec": "../../lib/base/llm_fake", "speed": "fast", "cost": "free",
                   "summary": "scripted fake brain for demo/docs/05 part 1: adds math to its own tools, then uses it",
                   "script": [
                     {"tool_calls": [{"name": "self_tools", "arguments": {"op": "add", "name": "math",
                                      "path": {"$env": "AOS_CD", "$path": "../../lib/base/math"}}}]},
                     {"tool_calls": [{"name": "math", "arguments": {"expr": "17*23"}}]},
                     {"content": "I added math to my own tools and used it right away: 17*23 = 391."}]},
   "fake-demo-spawn": {"exec": "../../lib/base/llm_fake", "speed": "fast", "cost": "free",
                   "summary": "scripted fake brain for demo/docs/05 part 4: starts kid, asks it, removes it; then tries four kids",
                   "script": [
                     {"tool_calls": [{"name": "agents", "arguments": {"op": "add", "name": "kid", "endpoint": "fake",
                                      "def": {"$env": "AOS_CD", "$path": "../agent-fsm"}}}]},
                     {"tool_calls": [{"name": "agents", "arguments": {"op": "ask", "name": "kid", "text": "what time is it?"}}]},
                     {"tool_calls": [{"name": "agents", "arguments": {"op": "rm", "name": "kid"}}]},
                     {"content": "I started kid, asked it the time (its answer is in the tool result above) and removed it again."},
                     {"tool_calls": [
                       {"name": "agents", "arguments": {"op": "add", "name": "kid1", "endpoint": "fake", "def": {"$env": "AOS_CD", "$path": "../agent-fsm"}}},
                       {"name": "agents", "arguments": {"op": "add", "name": "kid2", "endpoint": "fake", "def": {"$env": "AOS_CD", "$path": "../agent-fsm"}}},
                       {"name": "agents", "arguments": {"op": "add", "name": "kid3", "endpoint": "fake", "def": {"$env": "AOS_CD", "$path": "../agent-fsm"}}},
                       {"name": "agents", "arguments": {"op": "add", "name": "kid4", "endpoint": "fake", "def": {"$env": "AOS_CD", "$path": "../agent-fsm"}}}]},
                     {"tool_calls": [
                       {"name": "agents", "arguments": {"op": "rm", "name": "kid1"}},
                       {"name": "agents", "arguments": {"op": "rm", "name": "kid2"}},
                       {"name": "agents", "arguments": {"op": "rm", "name": "kid3"}}]},
                     {"content": "Only three kids fit: the judge allows 4 running at once and I count too, so kid4 was refused (SlotMissing). I removed the three again."}]},
   "fake-demo-fast": {"exec": "fake_slow", "delay_s": 3, "slots": 1, "speed": "fast", "cost": "free",
                   "summary": "fake brain that takes 3 s, one at a time, sorted first (demo/docs/05 part 3)"},
   "fake-demo-slow": {"exec": "fake_slow", "delay_s": 3, "slots": 1, "speed": "slow", "cost": "free",
                   "summary": "fake brain that takes 3 s, one at a time, sorted last (demo/docs/05 part 3)"}}}
