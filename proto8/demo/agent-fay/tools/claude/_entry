#!/usr/bin/env python3
# claude - 把 stdin 的 {"prompt": "..."} 交給 claude CLI 做，stdout 印它的回答；對話續在這個工具的小格（$AOS_STACK），人可以用 ../../attach claude 接進去
# 怎麼叫 CLI（旗標）在同資料夾的 cli.json；做法在 ../../cli_session.py。
import os, sys
here = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(here, "..", ".."))
import cli_session  # noqa: E402
cli_session.call_main(os.path.basename(here))
