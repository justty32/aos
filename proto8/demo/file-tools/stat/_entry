#!/usr/bin/env python3
# stat - stdin 收 {"path": "a.py"}，stdout 印一份 JSON：這個檔或資料夾的屬性
# 共有：path、type、mtime、mode、（連結）link_to。檔：size、exec、text（是不是 UTF-8 文字）、lines、format（json／python／markdown／shell／text）、
# JSON 檔的 top（頂層摘要）。資料夾：children、aos（_entry、.env、tool.json… 有哪些）。
import os, sys
sys.dont_write_bytecode = True                  # 不在工具資料夾留 __pycache__
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))   # file-tools 這層（common.py）
import json
from common import args, resolve, resolve_link, die, out, kind, iso, aos_marks, json_summary, WS

a = args(("path",))
lp, _ = resolve_link(a["path"]) if a["path"] not in (".", "") else resolve(a["path"])
p, shown = resolve(a["path"])
if not os.path.lexists(lp):
    die("FileMissing", a["path"])
res = {"path": shown, "type": kind(lp)}
if res["type"] == "link":
    res["link_to"] = os.path.relpath(p, WS)
    if not os.path.exists(p):
        res["broken"] = True
        out(res)
        sys.exit(0)
st = os.stat(p)
res["mtime"] = iso(st.st_mtime)
res["mode"] = "%04o" % (st.st_mode & 0o7777)
if os.path.isdir(p):
    res["children"] = len(os.listdir(p))
    res["aos"] = aos_marks(p)
    out(res)
    sys.exit(0)
res["size"] = st.st_size
res["exec"] = bool(st.st_mode & 0o111)
try:
    with open(p, "rb") as f:
        data = f.read(4 * 1024 * 1024)
except OSError as e:
    die("ReadFailed", "%s：%s" % (a["path"], e.strerror))
try:
    text = data.decode("utf-8")
    res["text"] = b"\0" not in data
except UnicodeDecodeError:
    res["text"] = False
if res["text"]:
    res["lines"] = text.count("\n") + (0 if text.endswith("\n") or not text else 1)
    first = text.split("\n", 1)[0]
    fmt = "text"
    try:
        v = json.loads(text)
        fmt = "json"
        res["top"] = json_summary(v)
    except ValueError:
        if p.endswith(".py") or ("python" in first and first.startswith("#!")):
            fmt = "python"
        elif p.endswith(".md"):
            fmt = "markdown"
        elif first.startswith("#!") or p.endswith(".sh"):
            fmt = "shell"
    res["format"] = fmt
out(res)
