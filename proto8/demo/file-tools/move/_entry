#!/usr/bin/env python3
# move - stdin 收 {"from": "a.txt", "to": "b/a.txt"}，搬移或改名（檔、資料夾、連結本身都行；to 的上層自動建），stdout 印 {"from", "to"}
# to 已經有東西＝不搬（FileBad）；要蓋就先 trash 掉它。to 不能在 from 裡面。從垃圾桶搬回來也用它。
import os, sys
sys.dont_write_bytecode = True                  # 不在工具資料夾留 __pycache__
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))   # file-tools 這層（common.py）
from common import args, resolve_link, die, out

a = args(("from", "to"))
src, s_rel = resolve_link(a["from"])
dst, d_rel = resolve_link(a["to"])
if not os.path.lexists(src):
    die("FileMissing", a["from"])
if os.path.lexists(dst):
    die("FileBad", "%s 已經有東西；要蓋先 trash 它" % a["to"])
if dst == src or dst.startswith(src + os.sep):
    die("PathBad", "%s 在 %s 裡面" % (a["to"], a["from"]))
try:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    os.rename(src, dst)
except OSError as e:
    die("MoveFailed", "%s → %s：%s" % (a["from"], a["to"], e.strerror))
out({"from": s_rel, "to": d_rel})
