#!/usr/bin/env python3
# mkdir - stdin 收 {"path": "a/b/c"}，建資料夾（上層一起建；已經有＝沒事），stdout 印 {"path", "created"}
import os, sys
sys.dont_write_bytecode = True                  # 不在工具資料夾留 __pycache__
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))   # file-tools 這層（common.py）
from common import args, resolve, die, out

a = args(("path",))
p, shown = resolve(a["path"], root_ok=False)
if os.path.isdir(p):
    out({"path": shown, "created": False})
    sys.exit(0)
if os.path.lexists(p):
    die("FileBad", "%s 已經是檔案" % a["path"])
try:
    os.makedirs(p)
except OSError as e:
    die("MkdirFailed", "%s：%s" % (a["path"], e.strerror))
out({"path": shown, "created": True})
