# .env - compact 的設定。預設不蓋外面已設的（N-59 第 4 件）：要臨時換就在叫它的那一行前面設。
# 腦的位置沿用 agent 的 AOS_BRAIN_URL（要另外指就設 COMPACT_URL）；都沒設＝假腦（照字面拼，demo、測試用）。
# history 超過幾 KB 才壓（在 fsm 裡當一格時看這個；手動 aos-exec compact --force 不看）
COMPACT_OVER_KB=32
# 第 2 步每段幾 KB
COMPACT_SEG_KB=8
# 最近幾題原樣不動（還沒答完的那題一定不動）
COMPACT_KEEP_TURNS=2
# 第 2 步每段最多挑幾行原樣保留；第 3 步最後最多留幾行；一行保留行最多幾字（超過不收）
COMPACT_KEEP_MAX=3
COMPACT_KEEP_FINAL_MAX=12
COMPACT_KEEP_LINE_MAX=1500
# 給第 1 步看的工具結果最多幾字（太長的截中間）
COMPACT_RESULT_CUT=2000
# 三步各用哪個模型：前兩步便宜的、最後修飾用強一點的
COMPACT_MODEL_NOTE=chatgpt-gpt-6-luna-low
COMPACT_MODEL_SEG=chatgpt-gpt-6-luna-low
COMPACT_MODEL_FINAL=chatgpt-gpt-6-sol
# 一次問腦最多等幾秒
COMPACT_TIMEOUT_S=120
