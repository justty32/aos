#!/usr/bin/env python3
# recall - 查先前的題目：stdin 收 {"op": "search", "query": "…"} 或 {"op": "read", "no": 3, "detail": true}，stdout 印給模型看的文字
# 讀的是 agent 自己的紀錄 $AOS_STACK/../history.jsonl：靠 P-17（工具的 stack＝<agent 的 stack>/<工具名>/，agent-kai 的 act 這樣給），
# 所以上一層就是 agent 的 stack。沒設 AOS_STACK、或那份檔不在＝HistoryMissing。
# 模型的錯（op 不認得、沒這題）照實回給它、退 0；紀錄本身壞了或沒指才 recall: 代號、退 1。
import json, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import turns  # noqa: E402

DETAIL_CUT = 3000                # detail 時每段工具輸出最多 3000 字


def say(s):
    print(s)
    sys.exit(0)


def die(code, reason):
    print("recall: %s %s" % (code, reason), file=sys.stderr)
    sys.exit(1)


stack = os.environ.get("AOS_STACK")
if not stack:
    die("HistoryMissing", "沒設定 AOS_STACK")
path = os.path.normpath(os.path.join(stack, "..", "history.jsonl"))   # 照字面往上一層（工具自己的 stack 資料夾不必存在）
if not os.path.isfile(path):
    die("HistoryMissing", "沒有 %s" % path)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = None
if not isinstance(args, dict):
    say("錯誤：參數要是 JSON 物件")
try:
    done, _ = turns.split(turns.load(path))
except turns.HistoryBad as e:
    die("HistoryBad", str(e))
op = args.get("op")
if op == "search":
    q = args.get("query") if isinstance(args.get("query"), str) else ""
    if not done:
        say("還沒有做完的舊題")
    ranked = sorted(((s, t["no"]) for s, t in zip(turns.score(q, done), done) if s > 0), reverse=True)[:5]
    if not ranked:
        say("沒有找到（共 %d 題）；目錄裡每題都有一行，也可以直接 read 某一題" % len(done))
    say("\n".join(turns.line(done[n - 1]) for _, n in sorted(ranked, key=lambda x: x[1])))
if op == "read":
    n = args.get("no")
    if type(n) is not int or not 1 <= n <= len(done):
        say("錯誤：no 要是 1～%d 的整數" % len(done))
    t = done[n - 1]
    out = ["#%d 問：%s" % (n, t["question"].rstrip("\n"))]
    if args.get("detail") is True:
        for m in t["msgs"][1:-1]:
            if m.get("role") == "assistant":
                for c in m.get("tool_calls") or []:
                    f = c.get("function", {}) if isinstance(c, dict) else {}
                    out.append("〔叫工具 %s %s〕" % (f.get("name"), f.get("arguments")))
            elif m.get("role") == "tool":
                body = turns.text(m)
                if len(body) > DETAIL_CUT:
                    body = body[:DETAIL_CUT] + "…（截斷）"
                out.append("〔工具結果〕\n" + body.rstrip("\n"))
    elif t["tools"]:
        out.append("（這題用過工具 %s；要看工具原始輸出就加 detail=true）" % "、".join(t["tools"]))
    out.append("#%d 答：%s" % (n, t["answer"].rstrip("\n")))
    say("\n".join(out))
say("錯誤：op 要是 search 或 read")
