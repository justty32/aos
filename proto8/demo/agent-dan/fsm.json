{"_entry": ["aos-fsm", {"$env": "AOS_CF"}],
 "start": "idle",
 "states": {
   "idle":  {"exec": "idle", "next": "think"},
   "think": {"exec": {"$env": "AOS_CF", "$path": "#/states/think/body"},
             "body": {"argv": ["python3", "brain.py"], "timeout_ms": 120000},
             "next": "act"},
   "act":   {"exec": {"$env": "AOS_CF", "$path": "#/states/act/body"},
             "body": {"argv": ["python3", "act.py"], "timeout_ms": 60000},
             "next": "idle"}}}
