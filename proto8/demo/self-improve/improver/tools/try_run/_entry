#!/usr/bin/env python3
# try_run - stdin 收 {"args": [...], "stdin": "...", "timeout": 10}，在 $AOS_WS/target 的暫時複本上 aos-exec 跑一次，stdout 印結束碼與輸出
# 不動 target/ 本身（每次複製一份、跑完刪）；函數的工作區也是一個空的暫時資料夾。錯：stderr 與 stdout 各一行「try_run: 代號 原因」、退 1。
import json, os, shutil, signal, subprocess, sys, tempfile

TAIL = 8000                                   # stdout、stderr 各留最後幾個字


def die(code, reason):
    line = "try_run: %s %s" % (code, reason)
    print(line, file=sys.stderr)
    print(line)                               # 給腦看的也有同一行（同 pi-tools）
    sys.exit(1)


def tail(text):
    return text if len(text) <= TAIL else "…（前面截掉 %d 字）\n" % (len(text) - TAIL) + text[-TAIL:]


ws = os.environ.get("AOS_WS")
if not ws or not os.path.isdir(ws):
    die("WsMissing", "沒設定 AOS_WS 或不是資料夾")
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    die("ArgumentsBad", "stdin 不是 JSON：%s" % e)
if not isinstance(args, dict):
    die("ArgumentsBad", "要一個 JSON 物件")
argv, stdin, timeout = args.get("args", []), args.get("stdin", ""), args.get("timeout", 10)
if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
    die("ArgumentsBad", "args 要是字串陣列")
if not isinstance(stdin, str):
    die("ArgumentsBad", "stdin 要是字串")
if type(timeout) not in (int, float) or not 0 < timeout <= 60:
    die("ArgumentsBad", "timeout 要是 0～60 之間的秒數")
src = next((p for p in ("target", "target.json") if os.path.lexists(os.path.join(ws, p))), None)
if src is None:
    die("TargetMissing", "工作資料夾裡沒有 target/ 也沒有 target.json")

with tempfile.TemporaryDirectory(prefix="try_run.") as tmp:
    dst = os.path.join(tmp, src)
    try:
        (shutil.copytree if os.path.isdir(os.path.join(ws, src)) else shutil.copy2)(os.path.join(ws, src), dst)
    except OSError as e:
        die("ReadFailed", "複製 %s 失敗：%s" % (src, e))
    os.mkdir(os.path.join(tmp, "ws"))
    env = {k: v for k, v in os.environ.items() if not k.startswith("AOS_")}    # 函數拿到的是乾淨的 aos 環境
    p = subprocess.Popen(["aos-exec", "--ws", os.path.join(tmp, "ws"), dst] + argv, stdin=subprocess.PIPE,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, start_new_session=True)
    try:
        out, err = p.communicate(stdin, timeout=timeout)
        head = "結束碼 %d" % p.returncode
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        out, err = p.communicate()
        head = "逾時（%g 秒），整群停掉" % timeout
print("%s\n--- stdout ---\n%s\n--- stderr ---\n%s" % (head, tail(out), tail(err)))
