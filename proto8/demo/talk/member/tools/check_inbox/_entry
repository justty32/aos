#!/usr/bin/env python3
# check_inbox - 看自己信箱裡還沒處理的信（$AOS_WS/new/），只看不認領；stdin 不讀，stdout 一封一行摘要。
import json, os, sys

new = os.path.join(os.environ.get("AOS_WS", "."), "new")
names = sorted(n for n in os.listdir(new) if not n.startswith(".")) if os.path.isdir(new) else []
if not names:
    print("信箱是空的：沒有還沒處理的信。")
    sys.exit(0)
print("還沒處理的有 %d 份（照到達順序，會一份一份變成你的題目）：" % len(names))
for n in names:
    try:
        with open(os.path.join(new, n), encoding="utf-8") as f:
            text = f.read()
    except OSError:
        continue
    try:
        l = json.loads(text) if n.endswith(".json") else None
    except ValueError:
        l = None
    if isinstance(l, dict) and l.get("kind") == "letter":
        body = " ".join(str(l.get("body", "")).split())
        print("- 來自 %s｜主旨：%s｜要回：%s｜%s" % (l.get("from"), l.get("subject") or "（無）",
                                             "是" if l.get("expect_reply") else "否", body[:200]))
    else:
        print("- 題目 %s｜%s" % (n, " ".join(text.split())[:200]))
