#!/usr/bin/env python3
# memory - 長期記憶庫工具：stdin 收 {"op": "save|search|read|forget", ...}，stdout 印結果（給模型看的文字）
# 模型的錯（op 不認得、kind 不對、id 找不到、太長）照實回給它、退 0；記憶庫本身壞了才 memory: HeapBad、退 1。
import json, os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import heap  # noqa: E402


def say(text):
    print(text)
    sys.exit(0)


try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = None
if not isinstance(args, dict):
    say("錯誤：參數要是 JSON 物件")
op = args.get("op")
h = heap.Heap()
try:
    if op == "save":
        kind, title, text = args.get("kind"), args.get("title"), args.get("text")
        tags = heap._tags(args.get("tags") or [] if isinstance(args.get("tags"), list) else [])
        if kind not in heap.KINDS:
            say("錯誤：kind 要是其中一個：%s" % "、".join(heap.KINDS))
        if not isinstance(title, str) or not title.strip() or len(title) > heap.TITLE_MAX:
            say("錯誤：title 要是 1～%d 字的字串" % heap.TITLE_MAX)
        if not isinstance(text, str) or not text.strip() or len(text) > heap.TEXT_MAX:
            say("錯誤：text 要是 1～%d 字的字串（太長就拆成幾筆）" % heap.TEXT_MAX)
        id_, prev = h.save(kind, " ".join(title.split()), text.strip(), tags[:10])
        if prev is None:
            say("已存 %s（新的一筆）" % id_)
        say("已更新 %s（同類同標題就覆蓋；舊內容：%s）" % (id_, " ".join(prev.split())[:200]))
    if op == "search":
        kinds = args.get("kind")
        kinds = [kinds] if isinstance(kinds, str) and kinds in heap.KINDS else None
        limit = args.get("limit") if isinstance(args.get("limit"), int) else 5
        rows = h.search(args.get("query") if isinstance(args.get("query"), str) else "", kinds,
                        max(1, min(limit, 20)))
        if not rows:
            say("沒有找到（記憶庫共 %d 筆）" % sum(h.counts().values()))
        say("\n".join(heap._item(r, h.text(r), 200) for r in rows))
    if op == "read":
        r = h.find(args.get("id"))
        if not r or r["status"] != "active":
            say("錯誤：沒有 %r 這一筆（id 長這樣：facts/001）" % args.get("id"))
        say("[%s] %s\n標籤：%s\n建立 %s，更新 %s\n\n%s" % (r["id"], r["title"], r["tags"] or "（無）",
                                                    r["created"], r["updated"], h.text(r).rstrip("\n")))
    if op == "forget":
        reason = args.get("reason") if isinstance(args.get("reason"), str) else ""
        r = h.forget(args.get("id"), reason)
        if not r:
            say("錯誤：沒有 %r 這一筆（或已經忘了）" % args.get("id"))
        say("已忘記 %s（搬到 archive/，人還找得到）" % r["id"])
    say("錯誤：op 要是 save、search、read、forget 其中一個")
except heap.HeapBad as e:
    print("memory: HeapBad %s" % e, file=sys.stderr)
    sys.exit(1)
