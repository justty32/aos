#!/bin/sh
# proto8 demo 的薄入口：放進 PATH，demo 的定義資料夾就不用寫相對腳本路徑（C-50），也不用寫死 demo 在哪。
#   aos-demo fsm/brains/fake.py ...   → python3 <demo>/fsm/brains/fake.py ...（路徑從 demo 資料夾算，跟 cwd 無關）
#   aos-demo 其他指令 ...             → 照原樣跑，環境多一個 AOS_DEMO＝demo 資料夾的絕對路徑（給 sh -c 裡指定義資料夾用）
AOS_DEMO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export AOS_DEMO
case "$1" in
  *.py) f="$1"; shift; exec python3 "$AOS_DEMO/$f" "$@" ;;
esac
exec "$@"
