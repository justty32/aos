#!/usr/bin/env python3
# write_file - stdin 收 {"path": "calc.py", "content": "..."}，整份寫進那個檔（先寫暫存檔再改名；資料夾不在就建）
import json, os, sys

root = os.environ.get("PYFIX_DIR")
if not root:
    print("write_file: DirMissing 沒設定 PYFIX_DIR", file=sys.stderr)
    sys.exit(1)
root = os.path.realpath(root)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
p, content = (args.get("path"), args.get("content")) if isinstance(args, dict) else (None, None)
if not isinstance(p, str) or not p or not isinstance(content, str):
    sys.exit(print("錯誤：要給 path 與 content（都是字串）"))
full = os.path.realpath(os.path.join(root, p))
if not full.startswith(root + os.sep):                  # 錯在模型：照實回給它，不當工具失敗
    sys.exit(print("錯誤：%r 跑出工作資料夾" % p))
if os.path.isdir(full):
    sys.exit(print("錯誤：%r 是資料夾" % p))
os.makedirs(os.path.dirname(full), exist_ok=True)
tmp = os.path.join(os.path.dirname(full), "." + os.path.basename(full) + ".tmp")   # N-05：寫一半被殺也不會留半個檔
with open(tmp, "w", encoding="utf-8") as f:
    f.write(content)
os.replace(tmp, full)
print("寫好了：%s（%d 個字）" % (p, len(content)))
