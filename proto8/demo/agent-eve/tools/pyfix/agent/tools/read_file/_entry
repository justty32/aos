#!/usr/bin/env python3
# read_file - stdin 收 {"path": "calc.py"}，stdout 印檔案全文（相對於 $PYFIX_DIR；超過 100 KB 只印前面）
import json, os, sys

root = os.environ.get("PYFIX_DIR")
if not root:
    print("read_file: DirMissing 沒設定 PYFIX_DIR", file=sys.stderr)
    sys.exit(1)
root = os.path.realpath(root)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
p = args.get("path") if isinstance(args, dict) else None
if not isinstance(p, str) or not p:
    sys.exit(print("錯誤：要給 path（字串）"))
full = os.path.realpath(os.path.join(root, p))
if not full.startswith(root + os.sep):                  # 錯在模型：照實回給它，不當工具失敗
    sys.exit(print("錯誤：%r 跑出工作資料夾" % p))
try:
    with open(full, encoding="utf-8", errors="replace") as f:
        text = f.read(100_001)
except OSError as e:
    sys.exit(print("錯誤：讀不到 %r：%s" % (p, e.strerror)))
sys.stdout.write(text[:100_000])
if len(text) > 100_000:
    print("\n……（超過 100 KB，後面沒印）")
