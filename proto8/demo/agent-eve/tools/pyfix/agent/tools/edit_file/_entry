#!/usr/bin/env python3
# edit_file - stdin 收 {"path", "old", "new"}，把檔裡唯一的一段 old 換成 new（old 要一字不差、只出現一次）
import json, os, sys

root = os.environ.get("PYFIX_DIR")
if not root:
    print("edit_file: DirMissing 沒設定 PYFIX_DIR", file=sys.stderr)
    sys.exit(1)
root = os.path.realpath(root)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
if not isinstance(args, dict):
    args = {}
p, old, new = args.get("path"), args.get("old"), args.get("new")
if not isinstance(p, str) or not p or not isinstance(old, str) or not old or not isinstance(new, str):
    sys.exit(print("錯誤：要給 path、old、new（都是字串，old 不能空）"))
full = os.path.realpath(os.path.join(root, p))
if not full.startswith(root + os.sep):                  # 錯在模型：照實回給它，不當工具失敗
    sys.exit(print("錯誤：%r 跑出工作資料夾" % p))
try:
    with open(full, encoding="utf-8") as f:
        text = f.read()
except (OSError, UnicodeDecodeError) as e:
    sys.exit(print("錯誤：讀不到 %r：%s" % (p, e)))
n = text.count(old)
if n != 1:
    sys.exit(print("錯誤：old 在 %s 裡出現 %d 次（要剛好 1 次）；先 read_file 看清楚再抄" % (p, n)))
tmp = os.path.join(os.path.dirname(full), "." + os.path.basename(full) + ".tmp")
with open(tmp, "w", encoding="utf-8") as f:
    f.write(text.replace(old, new))
os.replace(tmp, full)
print("改好了：%s" % p)
