#!/usr/bin/env python3
# run_python - stdin 收 {"args": ["-m", "unittest"], "timeout_s": 30}，在 $PYFIX_DIR 裡跑 python3 加這些參數，stdout 印結束碼與輸出
# 不是沙盒：跑的程式碼能碰到的跟這台機器的使用者一樣多。逾時（預設 30 秒、上限 120）就整群收掉、照實回報。
import json, os, signal, subprocess, sys

root = os.environ.get("PYFIX_DIR")
if not root:
    print("run_python: DirMissing 沒設定 PYFIX_DIR", file=sys.stderr)
    sys.exit(1)
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
if not isinstance(args, dict):
    args = {}
argv, limit = args.get("args"), args.get("timeout_s", 30)
if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
    sys.exit(print("錯誤：要給 args（字串陣列，例 [\"-m\", \"unittest\", \"-v\"] 或 [\"main.py\"]）"))
if not isinstance(limit, (int, float)) or isinstance(limit, bool) or limit <= 0:
    limit = 30
limit = min(limit, 120)
p = subprocess.Popen(["python3"] + argv, cwd=root, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                     stderr=subprocess.STDOUT, text=True, errors="replace", start_new_session=True,
                     env=dict(os.environ, PYTHONDONTWRITEBYTECODE="1"))
try:
    out, _ = p.communicate(timeout=limit)
    head = "結束碼 %d" % p.returncode
except subprocess.TimeoutExpired:
    os.killpg(p.pid, signal.SIGKILL)
    out, _ = p.communicate()
    head = "逾時：跑超過 %g 秒，已收掉" % limit
if len(out) > 20_000:
    out = out[:5_000] + "\n……（中間省略 %d 個字）……\n" % (len(out) - 15_000) + out[-10_000:]
print(head)
print(out, end="")
