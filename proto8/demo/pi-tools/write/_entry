#!/usr/bin/env python3
# write - stdin 收 {"path": "a.py", "content": "..."}，把整份內容寫進檔案（沒有就建、有就蓋、上層資料夾自動建；照 pi 的 write）
# 路徑從 $AOS_WS 算、不能跑出 $AOS_WS。先寫 . 開頭的暫存檔再改名（N-05）。錯：stderr 與 stdout 各一行「write: 代號 原因」、退 1。
import json, os, sys


def die(code, reason):
    line = "write: %s %s" % (code, reason)
    print(line, file=sys.stderr)
    print(line)                                 # stdout 也印：stdout 是給腦看的結果
    sys.exit(1)


ws = os.environ.get("AOS_WS")
if not ws or not os.path.isdir(ws):
    die("WsMissing", "沒設定 AOS_WS 或不是資料夾")
try:
    args = json.loads(sys.stdin.read())
except ValueError as e:
    die("ArgumentsBad", "stdin 不是 JSON：%s" % e)
if not isinstance(args, dict) or not isinstance(args.get("path"), str) or not args["path"]:
    die("ArgumentsBad", "缺 path（要一個字串）")
if not isinstance(args.get("content"), str):
    die("ArgumentsBad", "缺 content（要一個字串）")

root = os.path.realpath(ws)
path = os.path.realpath(os.path.join(root, args["path"]))
if os.path.commonpath([root, path]) != root or path == root:
    die("PathBad", "%s 在工作資料夾外面" % args["path"])
if os.path.isdir(path):
    die("FileBad", "%s 是資料夾" % args["path"])
try:
    os.makedirs(os.path.dirname(path), exist_ok=True)
except OSError as e:
    die("MkdirFailed", "%s：%s" % (os.path.dirname(args["path"]) or ".", e.strerror))
data = args["content"].encode("utf-8")
tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
try:
    with open(tmp, "wb") as f:
        f.write(data)
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)    # 蓋舊檔時留住它的權限（例如 +x）
    os.replace(tmp, path)
except OSError as e:
    try:
        os.unlink(tmp)
    except OSError:
        pass
    die("WriteFailed", "%s：%s" % (args["path"], e.strerror))
print("已寫入 %s（%d bytes）" % (args["path"], len(data)))
