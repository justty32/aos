{"description": "Main llm kernel with backend limits for local models", "backends": {"lmstudio": {"slots": 1, "max_packs": 1}}, "slots": 2, "reserved": {"high": 1}, "timeout_ms": 120000,
 "exec": {"$env": "AOS_HOME", "$path": "/lib/base/llm_http"},
 "endpoint": "fake",
 "budget": {"senders": {"/tmp/aos-demo-sender": {"max_calls": 1}}},
 "endpoints": {
   "smart-high":  {"exec": "endpoints/litellm", "url": "http://localhost:4000/v1", "model": "claude-haiku", "fixed": {"temperature": 0.2},
                   "slots": 4, "speed": "normal", "cost": "high", "context": 200000,
                   "summary": "LiteLLM claude haiku: careful answers, costs money"},
   "stupid-fast": {"backend": "lmstudio", "url": "http://localhost:1234/v1", "model": "qwen3-1.7b", "fixed": {"temperature": 0.7},
                   "slots": 1, "speed": "fast", "cost": "free", "context": 4096,
                   "summary": "LM Studio qwen3 1.7b on this machine: quick and rough, one at a time"},
   "luna":        {"exec": "endpoints/litellm", "url": "http://localhost:4000/v1", "model": "chatgpt-gpt-6-luna-low", "cost": "high",
                   "summary": "LiteLLM gpt-6 luna, low effort"},
   "sol":         {"exec": "endpoints/litellm", "url": "http://localhost:4000/v1", "model": "chatgpt-gpt-6-sol", "fixed": {"temperature": 0.2}, "cost": "high",
                   "summary": "LiteLLM gpt-6 sol"},
   "fake":        {"exec": {"$env": "AOS_HOME", "$path": "/lib/base/llm_fake"}, "speed": "fast", "cost": "free", "tool": "peek_now_time",
                   "summary": "fake brain: calls peek_now_time (or the first tool), then answers FAKE ANSWER to ..."},
   "fake-demo-self": {"exec": {"$env": "AOS_HOME", "$path": "/lib/base/llm_fake"}, "speed": "fast", "cost": "free",
                   "summary": "scripted fake brain for kernel/docs/03 part 1: adds math to its own tools, then uses it",
                   "script": [
                     {"tool_calls": [{"name": "self_tools", "arguments": {"op": "add", "name": "math",
                                      "path": {"$env": "AOS_HOME", "$path": "/lib/base/math"}}}]},
                     {"tool_calls": [{"name": "math", "arguments": {"expr": "17*23"}}]},
                     {"content": "I added math to my own tools and used it right away: 17*23 = 391."}]},
   "fake-demo-knowledge": {"exec": {"$env": "AOS_HOME", "$path": "/lib/base/llm_fake"}, "speed": "fast", "cost": "free",
                   "summary": "scripted fake brain for kernel/docs/03 part 1 with the knowledge base: reads knowledge_read aos/me.json#/self_tools, then adds math and uses it",
                   "script": [
                     {"tool_calls": [{"name": "knowledge_read", "arguments": {"op": "read", "path": "aos/me.json#/self_tools"}}]},
                     {"tool_calls": [{"name": "self_tools", "arguments": {"op": "add", "name": "math",
                                      "path": {"$env": "AOS_HOME", "$path": "/lib/base/math"}}}]},
                     {"tool_calls": [{"name": "math", "arguments": {"expr": "17*23"}}]},
                     {"content": "I read knowledge_read aos/me.json#/self_tools, added math to my own tools and used it: 17*23 = 391."}]},
   "fake-demo-spawn": {"exec": {"$env": "AOS_HOME", "$path": "/lib/base/llm_fake"}, "speed": "fast", "cost": "free",
                   "summary": "scripted fake brain for kernel/docs/03 part 4: starts kid, sets its brain, asks it, removes it; then copies a template to defs/helper and tries four kids",
                   "script": [
                     {"tool_calls": [{"name": "subagent", "arguments": {"op": "add", "name": "kid", "def_json": {"$env": "AOS_HOME", "$path": "/templates/agent-fsm"}}}]},
                     {"tool_calls": [{"name": "subagent", "arguments": {"op": "llm", "name": "kid", "args": {"op": "set", "settings": {"model": "fake"}}}}]},
                     {"tool_calls": [{"name": "subagent", "arguments": {"op": "ask", "name": "kid", "text": "what time is it?"}}]},
                     {"tool_calls": [{"name": "subagent", "arguments": {"op": "rm", "name": "kid", "purge": true}}]},
                     {"content": "I started kid, set its brain to fake, asked it the time (its answer is in the tool result above) and removed it again."},
                     {"tool_calls": [
                       {"name": "agent_def", "arguments": {"op": "new", "from": {"$env": "AOS_HOME", "$path": "/templates/agent-fsm"}, "path": "defs/helper"}},
                       {"name": "subagent", "arguments": {"op": "add", "name": "kid1", "def": "defs/helper"}},
                       {"name": "subagent", "arguments": {"op": "add", "name": "kid2", "def": "defs/helper"}},
                       {"name": "subagent", "arguments": {"op": "add", "name": "kid3", "def": "defs/helper", "ws": "kid3"}},
                       {"name": "subagent", "arguments": {"op": "add", "name": "kid4", "def": "defs/helper"}}]},
                     {"tool_calls": [
                       {"name": "subagent", "arguments": {"op": "rm", "name": "kid1", "purge": true}},
                       {"name": "subagent", "arguments": {"op": "rm", "name": "kid2", "purge": true}},
                       {"name": "subagent", "arguments": {"op": "rm", "name": "kid3", "purge": true}}]},
                     {"content": "I copied the template to defs/helper and started kid1, kid2 and kid3 from it; kid4 was refused by the judge (4 running at once, I count too). I removed the three again."}]},
   "fake-demo-fast": {"exec": "fake_slow", "delay_s": 3, "slots": 1, "speed": "fast", "cost": "free",
                   "summary": "fake brain that takes 3 s, one at a time, sorted first (kernel/docs/03 part 3)"},
   "fake-demo-slow": {"exec": "fake_slow", "delay_s": 3, "slots": 1, "speed": "slow", "cost": "free",
                   "summary": "fake brain that takes 3 s, one at a time, sorted last (kernel/docs/03 part 3)"}}}
