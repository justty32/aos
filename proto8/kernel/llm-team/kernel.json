{
  "description": "Forward team requests to the adjacent main llm kernel",
  "slots": 4,
  "timeout_ms": 180000,
  "exec": {"$env": "AOS_HOME", "$path": "/lib/aos/llm_forward"},
  "endpoint": "fake",
  "budget": {
    "max_calls": 3000,
    "window": "day"
  },
  "endpoints": {
    "fake": {
      "to": "fake",
      "kernel": {
        "$env": "AOS_STACK",
        "$path": "../llm-kernel"
      },
      "summary": "Forward to the main kernel fake"
    },
    "sol": {
      "to": "sol",
      "kernel": {
        "$env": "AOS_STACK",
        "$path": "../llm-kernel"
      },
      "summary": "Forward to the main kernel sol"
    },
    "luna": {
      "to": "luna",
      "kernel": {
        "$env": "AOS_STACK",
        "$path": "../llm-kernel"
      },
      "summary": "Forward to the main kernel luna"
    },
    "local": {
      "to": "stupid-fast",
      "kernel": {
        "$env": "AOS_STACK",
        "$path": "../llm-kernel"
      },
      "summary": "Forward to the main kernel stupid-fast"
    }
  }
}
