#!/usr/bin/env python3
"""aos-listen - 等工作區的 out/ 冒出答案、印出來（給人用，2026-10-24）。

    aos-listen [--ws WS] [--timeout 秒] [--trace] 題名     等這一題的答案，印出來就退 0
    aos-listen [--ws WS] [--last N] [--trace] [--follow]   跟著看：之後每冒出一個答案就印一段（像 tail -f）
    aos-listen [--ws WS] --status                          一份快照：誰在跑、停在哪一格、這題是哪題、各階段幾題

題名＝aos-say 印的那一行；答案＝$AOS_WS/out/<題名>（CONVENTION P-11；是資料夾就印裡面的 answer.txt，P-13）。
等一題時：答案已經在了就立刻印（先 say、後 listen 不會漏）；每秒看一次有沒有程式在跑這個工作區（/proc 裡 AOS_WS＝它、
argv[0] 是 aos-loop／aos-fsm／aos-exec／aos-daemon），沒有就在 stderr 提醒一次它停在哪、怎麼跑起來，然後**繼續等**
（可以先開 listen、再去別的終端機跑 agent）。--timeout 沒給＝一直等；Ctrl-C 離開（退 130）。
沒給題名：先印最後 N 個答案（--last N，照時間；沒給＝0 個），再跟著看新的；給了 --last 沒給 --follow＝印完就走。
--trace：同時把 stack 裡新長出來的 trace.jsonl（每格一行，P-07）與 history.jsonl 的工具呼叫（agent-dan，P-41）翻成短行印到 stderr。
stdout 只有答案；提醒、trace、錯都在 stderr。工作區＝--ws ＞ $AOS_WS ＞ cwd；stack＝$AOS_STACK ＞ $AOS_WS/.stack/。
錯：stderr 一行 `aos-listen: 代號 原因`、退 1（ArgumentsBad、FlagUnknown、WsMissing、QuestionUnknown〔四個階段資料夾都沒有這題〕、
AnswerMissing〔逾時、或題目到了 done/ 卻沒有答案〕）。"""
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import aos_human as h

PROG = "aos-listen"
USAGE = "aos-listen [--ws WS] [--timeout 秒] [--trace] 題名 | [--last N] [--follow] | --status"


def answer(ws, name):
    """out/<題名> 的內容；還沒有＝None（跟 aos-ai 共用 lib/aos/aos_ws.py 的 answer_text）。"""
    return h.aos_ws.answer_text(ws, name)


def show_tail(tail):
    if tail:
        for line in tail.lines():
            print(line, file=sys.stderr, flush=True)


def wait_one(ws, name, timeout, tail):
    start, warned, next_check = time.monotonic(), False, 0.0
    while True:
        text = answer(ws, name)
        if text is not None:
            show_tail(tail)
            sys.stdout.write(text)
            sys.stdout.flush()
            return
        stages = h.where(ws, name)
        if not stages and answer(ws, name) is None:
            h.die(PROG, "QuestionUnknown", "new/ cur/ out/ done/ 都沒有 %s" % name)
        if stages == ["done"] and answer(ws, name) is None:
            h.die(PROG, "AnswerMissing", "%s 已經在 done/，out/ 卻沒有答案" % name)
        show_tail(tail)
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            if h.runners(ws):
                warned = False
            elif not warned and answer(ws, name) is None:
                h.note(h.stuck_hint(ws, name) + "。我繼續等，Ctrl-C 離開")
                warned = True
        if timeout is not None and now - start >= timeout:
            h.die(PROG, "AnswerMissing", "等了 %g 秒，還沒有 out/%s（題目在 %s/）" % (timeout, name, "、".join(stages)))
        time.sleep(h.POLL)


def block(ws, name):
    q = h.read(os.path.join(ws, "done", name)) or h.read(os.path.join(ws, "done", name, "prompt.txt")) or ""
    out = "== %s\n" % name
    out += "".join("> %s\n" % l for l in q.rstrip("\n").splitlines())
    a = answer(ws, name) or ""
    return out + a + ("" if a.endswith("\n") else "\n")


def by_time(ws, ns):
    def mtime(n):
        try:
            return os.path.getmtime(os.path.join(ws, "out", n))
        except OSError:
            return 0
    return sorted(ns, key=lambda n: (mtime(n), n))


def follow(ws, last, keep, tail):
    seen = set(h.names(ws, "out"))
    for n in by_time(ws, seen)[-last:] if last else []:
        sys.stdout.write(block(ws, n))
    sys.stdout.flush()
    if not keep:
        return
    warned, next_check = False, 0.0
    while True:
        fresh = by_time(ws, [n for n in h.names(ws, "out") if n not in seen])
        show_tail(tail)
        for n in fresh:
            seen.add(n)
            sys.stdout.write(block(ws, n))
        sys.stdout.flush()
        now = time.monotonic()
        if now >= next_check:
            next_check = now + 1.0
            waiting = h.names(ws, "new") + h.names(ws, "cur")
            if not waiting or h.runners(ws):
                warned = False
            elif not warned:
                h.note("還有 %d 題沒答（%s），但目前沒有程式在跑這個工作區。%s。我繼續等，Ctrl-C 離開"
                       % (len(waiting), "、".join(waiting[:3]) + ("…" if len(waiting) > 3 else ""), h.run_hint(ws)))
                warned = True
        time.sleep(h.POLL)


def number(opts, key, flag):
    v = opts.get(key)
    if v is None:
        return None
    try:
        n = float(v)
        if n < 0 or n != n:
            raise ValueError
    except ValueError:
        h.die(PROG, "ArgumentsBad", "usage: %s（%s 要給不小於 0 的數字：%s）" % (USAGE, flag, v))
    return n


def main():
    opts, rest = h.parse(PROG, USAGE, sys.argv[1:], {"--ws": "ws", "--timeout": "timeout", "--last": "last"},
                         {"--trace": "trace", "--follow": "follow", "--status": "status"})
    timeout, last = number(opts, "timeout", "--timeout"), number(opts, "last", "--last")
    if len(rest) > 1:
        h.die(PROG, "ArgumentsBad", "usage: %s（題名只能一個，多給了 %s）" % (USAGE, rest[1]))
    if rest and (last is not None or opts.get("follow") or opts.get("status")):
        h.die(PROG, "ArgumentsBad", "usage: %s（給了題名就不收 --last／--follow／--status）" % USAGE)
    if opts.get("status") and (last is not None or opts.get("follow") or timeout is not None or opts.get("trace")):
        h.die(PROG, "ArgumentsBad", "usage: %s（--status 不跟別的旗標一起用）" % USAGE)
    if not rest and timeout is not None:
        h.die(PROG, "ArgumentsBad", "usage: %s（--timeout 只給等一題用）" % USAGE)
    try:
        ws = h.workspace(opts.get("ws"))
    except h.Error as e:
        h.die(PROG, e.code, str(e))
    tail = h.Tail(ws) if opts.get("trace") else None
    try:
        if opts.get("status"):
            print("\n".join(h.status_lines(ws)))
        elif rest:
            wait_one(ws, rest[0], timeout, tail)
        else:
            follow(ws, int(last or 0), last is None or bool(opts.get("follow")), tail)
    except KeyboardInterrupt:
        sys.exit(130 if rest else 0)


main()
