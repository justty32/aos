#!/usr/bin/env python3
# make_json - stdin 收 {"kind", "spec", "out"?}：aos-ai make <kind> --spec …，stdout 印 aos-ai 那行 JSON（含 notes）
# out 相對 $AOS_AI_ROOT（沒設＝$AOS_WS）。aos-ai 的錯印成 {"ok": false, "error"}、退 0（腦自己修）；aos-ai 起不來才退 1。
import json, os, subprocess, sys

ROOT = os.environ.get("AOS_AI_ROOT") or os.environ.get("AOS_WS") or "."


def say(obj):
    print(json.dumps(obj, ensure_ascii=False))
    sys.exit(0)


try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    say({"ok": False, "error": "arguments 不是 JSON：%s" % e})
if not isinstance(args, dict) or not isinstance(args.get("kind"), str) or not isinstance(args.get("spec"), dict):
    say({"ok": False, "error": "要 kind（字串）與 spec（物件）"})
cmd = ["aos-ai", "--root", ROOT, "make", args["kind"], "--spec", json.dumps(args["spec"], ensure_ascii=False)]
if isinstance(args.get("out"), str) and args["out"]:
    cmd += ["--out", os.path.join(ROOT, args["out"])]
try:
    r = subprocess.run(cmd, capture_output=True, text=True)
except OSError as e:
    print("make_json: LaunchFailed aos-ai 起不來：%s" % e, file=sys.stderr)
    sys.exit(1)
print(r.stdout.strip() if r.returncode == 0 else json.dumps(
    {"ok": False, "error": (r.stderr.strip().splitlines() or [""])[-1]}, ensure_ascii=False))
