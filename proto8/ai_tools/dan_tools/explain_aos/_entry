#!/usr/bin/env python3
# explain_aos - stdin 收 {"concept"?}：aos-ai explain [概念]，stdout 印 aos-ai 那行 JSON（白話＋範例＋常見錯＋條號）
import json, subprocess, sys

try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
c = args.get("concept") if isinstance(args, dict) else None
try:
    r = subprocess.run(["aos-ai", "explain"] + ([c] if isinstance(c, str) and c else []), capture_output=True, text=True)
except OSError as e:
    print("explain_aos: LaunchFailed aos-ai 起不來：%s" % e, file=sys.stderr)
    sys.exit(1)
print(r.stdout.strip() if r.returncode == 0 else json.dumps(
    {"ok": False, "error": (r.stderr.strip().splitlines() or [""])[-1]}, ensure_ascii=False))
