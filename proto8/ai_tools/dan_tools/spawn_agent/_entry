#!/usr/bin/env python3
# spawn_agent - stdin 收 {"name", "template"?}：aos-ai spawn，stdout 印 aos-ai 那行 JSON
# 子 agent 放在 $AOS_AI_ROOT（沒設＝$AOS_WS）的 agents/<名>/。aos-ai 的錯印成 {"ok": false, "error"}、退 0（腦自己修）。
import json, os, subprocess, sys

ROOT = os.environ.get("AOS_AI_ROOT") or os.environ.get("AOS_WS") or "."
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError as e:
    print(json.dumps({"ok": False, "error": "arguments 不是 JSON：%s" % e}, ensure_ascii=False))
    sys.exit(0)
if not isinstance(args.get("name"), str):
    print(json.dumps({"ok": False, "error": "要 name（字串）"}, ensure_ascii=False))
    sys.exit(0)
try:
    r = subprocess.run(["aos-ai", "--root", ROOT, "spawn", args["name"], "--from", args.get("template") or "agent-dan"],
                       capture_output=True, text=True)
except OSError as e:
    print("spawn_agent: LaunchFailed aos-ai 起不來：%s" % e, file=sys.stderr)
    sys.exit(1)
if r.returncode == 0:
    print(r.stdout.strip())
else:
    print(json.dumps({"ok": False, "error": (r.stderr.strip().splitlines() or [""])[-1]}, ensure_ascii=False))
