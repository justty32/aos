#!/usr/bin/env python3
# agent_status - stdin 收 {"name"?}：aos-ai status [名]，stdout 印 aos-ai 那行 JSON
# 子 agent 放在 $AOS_AI_ROOT（沒設＝$AOS_WS）的 agents/<名>/。aos-ai 的錯印成 {"ok": false, "error"}、退 0（腦自己修）。
import json, os, subprocess, sys

ROOT = os.environ.get("AOS_AI_ROOT") or os.environ.get("AOS_WS") or "."
try:
    args = json.loads(sys.stdin.read() or "{}")
except ValueError:
    args = {}
name = args.get("name") if isinstance(args, dict) else None
try:
    r = subprocess.run(["aos-ai", "--root", ROOT, "status"] + ([name] if isinstance(name, str) and name else []),
                       capture_output=True, text=True)
except OSError as e:
    print("agent_status: LaunchFailed aos-ai 起不來：%s" % e, file=sys.stderr)
    sys.exit(1)
if r.returncode == 0:
    print(r.stdout.strip())
else:
    print(json.dumps({"ok": False, "error": (r.stderr.strip().splitlines() or [""])[-1]}, ensure_ascii=False))
