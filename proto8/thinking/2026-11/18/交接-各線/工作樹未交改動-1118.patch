+            if os.environ.get("FAKE_CLI_COMPACT_FAIL"):
+                emit({"id": cmd.get("id"), "type": "response", "command": "compact", "success": False,
+                      "error": "Nothing to compact (session too small)"})
+            else:
+                summary = "FAKE SUMMARY of %d entries" % len(entries())
+                save({"type": "compaction", "summary": summary})
+                emit({"type": "compaction_end", "reason": "manual", "result": {"summary": summary}, "aborted": False, "willRetry": False})
+                emit({"id": cmd.get("id"), "type": "response", "command": "compact", "success": True,
+                      "data": {"summary": summary, "tokensBefore": 1000}})
+        elif kind == "prompt":
+            return cmd
+        return None
+
+    while not closed:
+        got, closed = lines_until(None)
+        for line in got:
+            cmd = handle(json.loads(line), False)
+            if not cmd:
+                continue
+            emit({"id": cmd.get("id"), "type": "response", "command": "prompt", "success": True, "data": {"disposition": "started"}})
+            emit({"type": "agent_start"})
+            emit({"type": "message_end", "message": user(cmd["message"])})
+            messages = []
+            later, closed = lines_until(time.time() + delay)
+            for l2 in later:
+                handle(json.loads(l2), True)
+            answer(cmd["message"], messages)
+            while queue and not fail:
+                text = queue.pop(0)
+                emit({"type": "queue_update", "steering": list(queue), "followUp": []})
+                emit({"type": "message_end", "message": user(text)})
+                answer(text, messages)
+            emit({"type": "agent_end", "messages": messages, "willRetry": False})
+            emit({"type": "agent_settled", "aborted": False})
+    write_log()
+
+
+def screen():
+    conf = None
+    for e in opts.get("-e") or []:
+        if e.endswith("pi-aos-screen.mjs"):
+            m = re.search(r"run\(pi, (\{.*\})\);", open(e, encoding="utf-8").read())
+            conf = json.loads(m.group(1)) if m else None
+    state = {"sid": sid, "busy": False}
+
+    def hook(payload):
+        if conf:
+            subprocess.run([conf["python"], conf["hook"], "hook", "pi", conf["cell"]], input=json.dumps(payload), text=True,
+                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+    def turn(text):
+        hook({"event": "agent_start", "session_id": state["sid"]})
+        time.sleep(float(os.environ.get("FAKE_PI_DELAY", "0")))
+        msg = assistant(text)
+        save({"type": "message", "message": user(text)})
+        save({"type": "message", "message": msg})
+        print("FAKE PI: %s" % text, flush=True)
+        slim = [{"role": "user", "stopReason": None, "text": text},
+                {"role": "assistant", "stopReason": msg["stopReason"], "text": "".join(c["text"] for c in msg["content"])}]
+        hook({"event": "agent_settled", "session_id": state["sid"], "aborted": False, "messages": slim})
+
+    hook({"event": "session_start", "reason": "startup", "session_id": sid})
+    print("fake pi screen, session %s" % sid, flush=True)
+    while True:
+        line = read_line(0.2)
+        if line == "":
+            break
+        if line is not None:
+            text = line.strip().replace("\x1b[200~", "").replace("\x1b[201~", "")
+            got_in.append(text)
+            if text == "/quit":
+                break
+            if text.startswith("/compact"):
+                save({"type": "compaction", "summary": "FAKE SCREEN SUMMARY"})
+                hook({"event": "compact", "session_id": state["sid"], "summary": "FAKE SCREEN SUMMARY"})
+            elif text == "/new":
+                global path
+                state["sid"] = str(uuid.uuid4())
+                path = session_path(state["sid"])
+                hook({"event": "session_start", "reason": "new", "session_id": state["sid"]})
+            elif text:
+                turn(text)
+        inbox = conf and conf.get("inbox")
+        names = sorted(n for n in os.listdir(inbox) if n.endswith(".json")) if inbox and os.path.isdir(inbox) else []
+        if names:
+            docs = []
+            for n in names:
+                with open(os.path.join(inbox, n), encoding="utf-8") as f:
+                    docs.append(json.load(f))
+                os.remove(os.path.join(inbox, n))
+            text = "\n\n".join(d["text"] for d in docs)
+            got_in.append(text)
+            hook({"event": "ack", "ids": [d["id"] for d in docs]})
+            turn(text)
+    write_log()
+
+
+rpc() if mode == "rpc" else screen()
