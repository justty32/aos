--- /dev/null
+++ b/proto8/py/aos/apps/agent/ctl/kit.py
@@ -0,0 +1,119 @@
+# aos/apps/agent/ctl/kit.py - ctl add／set-def 的 --kit：把 kit 夾的 system.txt、tools.json 寫成這隻 agent 在 stack 裡自己那份（定義不動），退回＝system reset、tools reset。
+# 使用者 11-18：「aos-kit也不用了，刪掉，功能整合進現有的。」選項框選「併進 aos-agent ctl (Recommended)」（thinking 2026-11/18/aos-kit-併進ctl.md）。
+# 為什麼寫 stack 不寫定義：system／tools 本來就有「stack 那份在＝蓋過定義那份」（aos-agent system set、tools add 寫的那層），
+#   agent-fsm 每格重讀；寫那裡＝不就地改使用者的定義夾、不用另存舊檔、退回用現成的 reset。
+import json
+import os
+from aos.declared_files import declared_files
+from ..common import Fail, note
+
+FILES = ("system", "tools")                     # 宣告鍵；kit 夾裡固定叫 system.txt、tools.json
+KIT_NAMES = {"system": "system.txt", "tools": "tools.json"}
+
+HELP_FLAG = """      --kit KIT       lay a kit over it: KIT is a kit folder holding system.txt and tools.json
+                      (shipped ones: $AOS_HOME/templates/kits/gather, .../review). They are written
+                      as the agent's own copies in its stack (as aos-agent system set and tools add
+                      do); the definition is not changed. Only for agent-fsm definitions (an eca
+                      one, with cli.json, = KitBad). An own copy already there and different =
+                      CopyExists, nothing written. To drop the kit later: aos-agent -t NAME system
+                      reset -y, then aos-agent -t NAME tools reset -y"""
+
+
+def read_bytes(path):
+    try:
+        with open(path, "rb") as f:
+            return f.read()
+    except OSError as e:
+        raise Fail("KitBad", "cannot read %s: %s" % (path, e.strerror or e))
+
+
+def plan(kit_arg, def_folder, stack, name):
+    """先全部檢查、什麼都不寫。回 [(宣告鍵, 內容, stack 裡的路徑, "create"|"unchanged")]。"""
+    kit = os.path.abspath(kit_arg)
+    if not os.path.isdir(kit):
+        raise Fail("KitMissing", "%s is not a folder (--kit takes a kit folder, e.g. $AOS_HOME/templates/kits/gather)" % kit_arg)
+    for key in FILES:
+        if not os.path.isfile(os.path.join(kit, KIT_NAMES[key])):
+            raise Fail("KitMissing", "%s has no %s (a kit folder holds system.txt and tools.json)" % (kit, KIT_NAMES[key]))
+    if os.path.exists(os.path.join(def_folder, "cli.json")):
+        raise Fail("KitBad", "%s is an eca definition (it has cli.json); kits are for agent-fsm definitions only "
+                   "(an eca CLI keeps its own built-in tools, so the kit's tool limits would not hold)" % def_folder)
+    try:
+        rels = declared_files(def_folder)
+    except ValueError as e:
+        raise Fail("InterfaceBad", str(e)) from e
+    missing = [k for k in FILES if k not in rels]
+    if missing:
+        raise Fail("KitBad", "%s does not declare %s in interfaces.json (a kit needs both system and tools, as in the agent-fsm template)"
+                   % (def_folder, " and ".join(missing)))
+    tools = read_bytes(os.path.join(kit, KIT_NAMES["tools"]))
+    try:
+        if not isinstance(json.loads(tools.decode("utf-8")), dict):
+            raise ValueError("not a JSON object")
+    except (ValueError, UnicodeError) as e:
+        raise Fail("KitBad", "%s is not a tools registry (a JSON object): %s" % (os.path.join(kit, KIT_NAMES["tools"]), e)) from e
+    new = {"system": read_bytes(os.path.join(kit, KIT_NAMES["system"])), "tools": tools}
+    steps = []
+    for key in FILES:
+        dest = os.path.join(stack, rels[key])
+        if os.path.isdir(dest):
+            raise Fail("KitBad", "%s is a folder" % dest)
+        if os.path.lexists(dest):
+            if read_bytes(dest) == new[key]:
+                steps.append((key, new[key], dest, "unchanged"))
+                continue
+            raise Fail("CopyExists", "%s already has its own %s in its stack (%s, from aos-agent %s or an earlier --kit); nothing written. "
+                       "To drop it first: aos-agent -t %s %s reset -y" % (name, rels[key], dest, "system set" if key == "system" else "tools add / rm",
+                                                                        name, key))
+        steps.append((key, new[key], dest, "create"))
+    return steps
+
+
+def write(steps):
+    """寫 create 那幾份（暫存檔再 link 上去：同名已出現＝不蓋、報錯）。回寫了的路徑（失敗時給 undo）。"""
+    made = []
+    try:
+        for key, data, dest, action in steps:
+            if action != "create":
+                continue
+            os.makedirs(os.path.dirname(dest), exist_ok=True)
+            tmp = os.path.join(os.path.dirname(dest), ".%s.kit.%d" % (os.path.basename(dest), os.getpid()))
+            with open(tmp, "wb") as f:
+                f.write(data)
+            try:
+                os.link(tmp, dest)
+            except FileExistsError:
+                raise Fail("CopyExists", "%s appeared meanwhile; nothing more written" % dest)
+            finally:
+                os.unlink(tmp)
+            made.append(dest)
+    except OSError as e:
+        undo(made)
+        raise Fail("WriteFailed", "cannot write the kit into the stack: %s" % (e.strerror or e)) from e
+    except Fail:
+        undo(made)
+        raise
+    return made
+
+
+UNSURE = ("WaitFailed", "DaemonFailed")         # 信寄出了、結果說不準（之後還可能掛上）：不收回
+
+
+def undo(made, err=None):
+    """掛不上時收回剛寫的（只收這次寫的；原本就在、內容相同的不動）。err 是說不準的那幾種＝留著、提醒一行。"""
+    if err is not None and getattr(err, "code", None) in UNSURE:
+        if made:
+            note("kept the kit files just written (%s): the daemon may still attach it" % ", ".join(made))
+        return
+    for p in made:
+        try:
+            os.unlink(p)
+        except OSError:
+            pass
+
+
+def said(steps, kit_arg, name):
+    """一行說明（stderr 的 warning 行；stdout 留給 ctl add 印 stack）。"""
+    parts = ["%s %s" % ("wrote" if a == "create" else "kept (same)", d) for _, _, d, a in steps]
+    return ("kit %s: %s, as %s's own copies (the definition is not changed; to drop the kit: "
+            "aos-agent -t %s system reset -y, aos-agent -t %s tools reset -y)" % (kit_arg, "; ".join(parts), name, name, name))
