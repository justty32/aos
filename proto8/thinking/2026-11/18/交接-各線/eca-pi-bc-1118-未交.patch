+def post(cfg, path, parts):
+    """投一批：claude＝包信封寫 socket（wire、deliver）；pi＝一封一個檔寫進收件夾（deliver_inbox）。回 [回執 id]；投不出去＝Undelivered。"""
+    if cfg.get("kind") == "pi":
