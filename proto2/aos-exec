#!/usr/bin/env python3
"""aos-exec <path> — 檔案就執行它，資料夾就把 .aos/inst 整段丟給 system()。

.aos/inst 是純文字檔，內容就是一行或幾行 shell 命令，不解析、不拆行，
原樣交給 os.system() 跑。退出碼：0 成功，2 用法／找不到／讀不懂，
其他情況原樣傳回命令自己的退出碼。
"""
import os
import subprocess
import sys


def die(msg):
    print("aos-exec: " + msg, file=sys.stderr)
    sys.exit(2)


def main():
    os.environ["PATH"] = (
        os.path.dirname(os.path.abspath(sys.argv[0])) + os.pathsep + os.environ.get("PATH", "")
    )
    if len(sys.argv) != 2:
        die("用法：aos-exec <path>")
    path = os.path.abspath(sys.argv[1])

    if os.path.isfile(path):
        sys.exit(subprocess.run([path], cwd=os.path.dirname(path)).returncode)

    if os.path.isdir(path):
        inst = os.path.join(path, ".aos", "inst")
        if not os.path.isfile(inst):
            die("資料夾裡沒有 .aos/inst：" + path)
        with open(inst, encoding="utf-8") as f:
            script = f.read()
        os.chdir(path)
        sys.exit(os.waitstatus_to_exitcode(os.system(script)))

    die("找不到這個路徑：" + path)


main()
