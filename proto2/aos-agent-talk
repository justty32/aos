#!/usr/bin/env python3
"""aos-agent-talk [dir] — 跟一個 agent 資料夾對話：你打字，它回話。

自己不推格：另一個終端機要有 `aos-loop <dir> --keep-inst` 在轉，不然沒人會回話。
每句用 aos-agent-say 寫進 new-prompts/，然後等 replies/ 冒出比進來時更新的檔就印。
等的時候 Ctrl-C 回到提示；提示下 Ctrl-C 或 Ctrl-D（或打 /quit）才離開。
"""
import argparse
import json
import os
import subprocess
import sys
import time

SAY = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "aos-agent-say")


def names(box):
    if not os.path.isdir(box):
        return []
    return sorted(n for n in os.listdir(box) if n.endswith(".json"))


def content(box, name):
    try:
        with open(os.path.join(box, name), encoding="utf-8") as f:
            return json.load(f).get("content") or ""
    except (ValueError, OSError):
        return ""


def main():
    ap = argparse.ArgumentParser(prog="aos-agent-talk")
    ap.add_argument("dir", nargs="?", default=".")
    args = ap.parse_args()
    box = os.path.join(args.dir, ".aos", "agent", "replies")
    print("（另一個終端機要跑 aos-loop 這個資料夾，不然沒人會回話）")

    while True:
        try:
            line = input("你> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return
        if line.strip() == "/quit":
            return
        if not line.strip():
            continue
        before = set(names(box))
        subprocess.run([SAY, args.dir, line], stderr=subprocess.DEVNULL)
        try:
            while True:
                fresh = [n for n in names(box) if n not in before]
                if fresh:
                    for name in fresh:
                        print("agent> " + content(box, name))
                        sys.stdout.flush()
                    break
                time.sleep(0.5)
        except KeyboardInterrupt:
            print("\n（不等了，可以繼續打）")


main()
