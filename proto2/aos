#!/usr/bin/env python3
"""aos exec <path> — 檔案就執行它，資料夾就跑它的 .aos/insts.json。

退出碼沿用舊 proto 的 aosp/exits.py：0 成功、2 用法／找不到／讀不懂。
命令自己的退出碼原樣傳回去。
"""
import json
import os
import subprocess
import sys


def die(msg):
    print("aos: " + msg, file=sys.stderr)
    sys.exit(2)


def run(argv, cwd):
    try:
        return subprocess.run(argv, cwd=cwd).returncode
    except OSError as e:
        die("跑不起來 %s：%s" % (argv[0], e))


def main():
    if len(sys.argv) != 3 or sys.argv[1] != "exec":
        die("用法：aos exec <path>")
    path = os.path.abspath(sys.argv[2])

    if os.path.isfile(path):
        sys.exit(run([path], os.path.dirname(path)))

    if os.path.isdir(path):
        insts = os.path.join(path, ".aos", "insts.json")
        if not os.path.isfile(insts):
            die("資料夾裡沒有 .aos/insts.json：" + path)
        try:
            with open(insts, encoding="utf-8") as f:
                cmds = json.load(f)
        except (ValueError, OSError) as e:
            die("讀不懂 %s：%s" % (insts, e))
        if not isinstance(cmds, list):
            die("%s 應該是一個陣列，每項是一條命令的 argv 陣列" % insts)
        for cmd in cmds:
            if not (isinstance(cmd, list) and cmd and all(isinstance(a, str) for a in cmd)):
                die("%s 裡有一項不是字串陣列：%r" % (insts, cmd))
            code = run(cmd, path)
            if code != 0:
                sys.exit(code)
        sys.exit(0)

    die("找不到這個路徑：" + path)


main()
