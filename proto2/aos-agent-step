#!/usr/bin/env python3
"""aos-agent-step [dir] — 一個 agent 資料夾走「一格」。

agent 本體就是 <dir>/.aos/agent/ 底下那幾個檔：人格（system-prompt.json）、
記憶（prompts.json）、這輪要加的話（new-prompts.json）、工具（tools.json）、
引擎（engine.json）、收新訊息的地方（new-prompts/、new-prompts/archived/）、
上次回覆（llm-result.json）、現在走到哪（state.json）。

四格輪流走：idle 收信（收信前先清 archived/，開新一輪）→ llm 思考 → act 行動
→ collect 再收信（不清 archived/，接在這一輪後面）→ llm …
沒工具可跑就回 idle。每格結束都把「自己 .」寫進 <dir>/.aos/inst，
所以 aos-loop 會一直回來看（給 --no-write-inst 就不寫，讓 aos-loop --keep-inst 去管）。
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request


def read_json(path, default):
    if not os.path.isfile(path):
        return default
    with open(path, encoding="utf-8") as f:
        text = f.read().strip()
    return json.loads(text) if text else default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
        f.write("\n")


def clear_archived(home):
    """清掉 new-prompts/archived/ 裡上一輪留下的檔——每輪從 idle 開始新一輪
    收信前都要清一次（也就是上一輪的在這一輪被清掉）；同一輪內 act→collect
    的補收不會再清，好讓這一輪收到的東西留在 archived 裡到輪完。
    """
    archived = os.path.join(home, "new-prompts", "archived")
    if os.path.isdir(archived):
        for name in os.listdir(archived):
            path = os.path.join(archived, name)
            if os.path.isfile(path):
                os.remove(path)


def collect_new_prompts(home):
    """把 new-prompts/ 裡的檔（頂層、排序、不含子目錄）變成訊息，原檔搬去
    new-prompts/archived/。每個檔可以是**一則**訊息（JSON 物件 {"role", "content"}），
    也可以是**一串**訊息（JSON 陣列，裡面每個物件各算一則、照原順序）；陣列裡不是
    物件的項印一行白話到 stderr 跳過。整個檔讀不成 JSON、或不是物件也不是陣列，
    也印一行跳過。不管收不收得成，檔一律搬走。
    """
    box = os.path.join(home, "new-prompts")
    archived = os.path.join(box, "archived")
    msgs = []
    if not os.path.isdir(box):
        return msgs
    for name in sorted(os.listdir(box)):
        src = os.path.join(box, name)
        if not os.path.isfile(src):
            continue
        with open(src, encoding="utf-8", errors="replace") as f:
            text = f.read()
        try:
            data = json.loads(text)
        except ValueError:
            data = None
        if isinstance(data, dict):
            msgs.append(data)
        elif isinstance(data, list):
            for i, item in enumerate(data):
                if isinstance(item, dict):
                    msgs.append(item)
                else:
                    print("aos-agent-step: new-prompts/%s 第 %d 項不是 JSON 物件，跳過"
                          % (name, i), file=sys.stderr)
        else:
            print("aos-agent-step: new-prompts/%s 不是合法的訊息（要 JSON 物件或陣列），跳過"
                  % name, file=sys.stderr)
        os.makedirs(archived, exist_ok=True)
        os.replace(src, os.path.join(archived, name))
    return msgs


def do_llm(home):
    """打一次 chat/completions。成功回 True，失敗印一行到 stderr 回 False。"""
    engine = read_json(os.path.join(home, "engine.json"), {})
    base = (engine.get("base_url") or "http://localhost:1234/v1").rstrip("/")
    url = base + "/chat/completions"

    messages = []
    persona = read_json(os.path.join(home, "system-prompt.json"), {})
    if persona.get("content"):
        messages.append({"role": "system", "content": persona["content"]})
    history = read_json(os.path.join(home, "prompts.json"), [])
    pending = read_json(os.path.join(home, "new-prompts.json"), [])
    messages += history + pending

    body = {"model": engine.get("model") or "local", "messages": messages}
    tools = read_json(os.path.join(home, "tools.json"), [])
    if tools:
        body["tools"] = [{"type": "function", "function": {
            "name": t.get("name"),
            "description": t.get("description", ""),
            "parameters": t.get("parameters", {}),
        }} for t in tools]

    key = os.environ.get(engine.get("api_key_env") or "") or "none"
    req = urllib.request.Request(
        url, data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + key},
        method="POST")
    try:
        with urllib.request.urlopen(req) as r:
            answer = json.loads(r.read().decode("utf-8", "replace"))
        assistant = answer["choices"][0]["message"]
    except (urllib.error.URLError, OSError, ValueError, KeyError, IndexError, TypeError) as e:
        print("aos-agent-step: 打不通 %s（%s），這格不算，下次再試" % (url, e), file=sys.stderr)
        return False

    write_json(os.path.join(home, "llm-result.json"), answer)
    # 存進歷史的 assistant 訊息只留 role、content、tool_calls 三個公開欄位，
    # 過濾掉伺服器可能夾帶的私有欄位（例如 reasoning_content）。
    stored = {"role": assistant.get("role") or "assistant", "content": assistant.get("content") or ""}
    tool_calls = assistant.get("tool_calls") or []
    if tool_calls:
        stored["tool_calls"] = tool_calls
    write_json(os.path.join(home, "prompts.json"), history + pending + [stored])
    write_json(os.path.join(home, "new-prompts.json"), [])
    return True


def do_act(home, workdir, step):
    """跑上一輪要的工具；沒工具就把它說的話印出來、同時落一個檔。回下一個 state。"""
    answer = read_json(os.path.join(home, "llm-result.json"), {})
    choices = answer.get("choices") or [{}]
    message = choices[0].get("message") or {}
    calls = message.get("tool_calls")
    # 明確判斷「有沒有工具要跑」：tool_calls 要存在而且是非空陣列。
    has_calls = isinstance(calls, list) and len(calls) > 0
    if not has_calls:
        content = message.get("content") or ""
        print(content)
        # 回話也落地一份，讓 aos-agent-listen／talk 這種旁邊看的人撿得到。
        write_json(os.path.join(home, "replies", "%04d.json" % step),
                   {"role": "assistant", "content": content})
        return "idle"

    tools = {t.get("name"): t for t in read_json(os.path.join(home, "tools.json"), [])}
    results = read_json(os.path.join(home, "new-prompts.json"), [])
    for call in calls:
        fn = call.get("function") or {}
        name = fn.get("name")
        args = fn.get("arguments")
        if not isinstance(args, str):
            args = json.dumps(args or {}, ensure_ascii=False)
        tool = tools.get(name)
        if tool is None:
            out = "沒有這個工具：%s" % name
        else:
            done = subprocess.run(tool.get("command", ""), shell=True, input=args,
                                  capture_output=True, text=True, cwd=workdir)
            out = done.stdout
            if done.stderr.strip():
                out += done.stderr
        results.append({"role": "tool", "tool_call_id": call.get("id"), "content": out})
    write_json(os.path.join(home, "new-prompts.json"), results)
    return "collect"


def main():
    ap = argparse.ArgumentParser(prog="aos-agent-step")
    ap.add_argument("dir", nargs="?", default=".")
    ap.add_argument("--no-write-inst", action="store_true")
    args = ap.parse_args()
    workdir = os.path.abspath(args.dir)
    home = os.path.join(workdir, ".aos", "agent")
    state_path = os.path.join(home, "state.json")
    saved = read_json(state_path, {})
    state = saved.get("state") or "idle"
    step = saved.get("step") or 0
    failed = False

    if state == "idle":
        clear_archived(home)
        msgs = collect_new_prompts(home)
        if msgs:
            write_json(os.path.join(home, "new-prompts.json"), msgs)
            nxt = "llm"
        else:
            nxt = "idle"
    elif state == "collect":
        pending = read_json(os.path.join(home, "new-prompts.json"), [])
        write_json(os.path.join(home, "new-prompts.json"), pending + collect_new_prompts(home))
        nxt = "llm"
    elif state == "llm":
        if do_llm(home):
            nxt = "act"
        else:
            nxt, failed = "llm", True
    elif state == "act":
        nxt = do_act(home, workdir, step + 1)
    else:
        print("aos-agent-step: 認不得的 state：%s，當 idle" % state, file=sys.stderr)
        state, nxt = "idle", "idle"

    write_json(state_path, {"state": nxt, "step": step + 1})
    if not args.no_write_inst:
        inst = os.path.join(workdir, ".aos", "inst")
        os.makedirs(os.path.dirname(inst), exist_ok=True)
        with open(inst, "w", encoding="utf-8") as f:
            f.write("%s .\n" % os.path.abspath(sys.argv[0]))
    print("aos-agent-step: step %d state %s -> %s" % (step, state, nxt), file=sys.stderr)
    sys.exit(1 if failed else 0)


main()
