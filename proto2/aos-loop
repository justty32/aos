#!/usr/bin/env python3
"""aos-loop [dir] — 無限（或指定步數）跑 aos-exec：讀 .aos/inst，清空，再執行。

每一步：讀 <dir>/.aos/inst（不存在＝空字串），立刻清空該檔（原本不存在就不建），
去頭尾空白後非空才 os.system() 執行；退出碼不影響迴圈，但每步印一行到 stderr。
--steps 限步數（預設無限），--interval 每步間隔秒數，--stop-when-empty 遇空即以
0 退出（不給的話空的那步什麼都不跑、照樣繼續），--keep-inst 不清空、每圈原樣重跑同一段。
"""
import argparse
import os
import sys
import time


def main():
    os.environ["PATH"] = (
        os.path.dirname(os.path.abspath(sys.argv[0])) + os.pathsep + os.environ.get("PATH", "")
    )
    ap = argparse.ArgumentParser(prog="aos-loop")
    ap.add_argument("dir", nargs="?", default=".")
    ap.add_argument("--steps", type=int, default=None)
    ap.add_argument("--interval", type=float, default=1)
    ap.add_argument("--stop-when-empty", action="store_true")
    ap.add_argument("--keep-inst", action="store_true")
    args = ap.parse_args()

    if not os.path.isdir(args.dir):
        print("aos-loop: 找不到這個資料夾：" + args.dir, file=sys.stderr)
        sys.exit(2)
    os.chdir(args.dir)

    step = 0
    warned_missing = False
    try:
        while args.steps is None or step < args.steps:
            step += 1
            inst = ".aos/inst"
            content = ""
            if os.path.isfile(inst):
                with open(inst, encoding="utf-8") as f:
                    content = f.read()
                if not args.keep_inst:
                    open(inst, "w").close()
            elif not warned_missing:
                warned_missing = True
                print(
                    f"aos-loop: {args.dir} 裡沒有 .aos/inst，這個資料夾沒有心跳指令，每圈都會是空的",
                    file=sys.stderr,
                )

            if content.strip():
                rc = os.waitstatus_to_exitcode(os.system(content))
                hint = "（127 通常是找不到指令）" if rc == 127 else ""
                print(f"aos-loop: step {step} exit {rc}{hint}", file=sys.stderr)
            else:
                print(f"aos-loop: step {step} empty", file=sys.stderr)
                if args.stop_when_empty:
                    sys.exit(0)

            if args.steps is not None and step >= args.steps:
                break
            time.sleep(args.interval)
    except KeyboardInterrupt:
        sys.exit(130)

    sys.exit(0)


main()
