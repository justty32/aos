#!/usr/bin/env python3
"""aos-daemon-kernel <start|restart|stop|ls|tick> [daemon 資料夾] — 常駐的時鐘總管。

daemon 不再是一個世界資料夾，而是一個**一直跑著的進程**：每隔一小段時間去
`<daemon 資料夾>/requests/` 看有沒有人丟請求進來，照請求開／關／暫停時鐘。
一個時鐘就是一個獨立的 `aos-loop <世界> --keep-inst` 進程，自己一個 process group，
所以暫停就是 SIGSTOP、續跑就是 SIGCONT、關掉就是 SIGTERM——排程直接用 Linux 那套輪子。

daemon 資料夾＝argv[2]，沒給就用環境變數 AOS_DAEMON_DIR（例如 ~/.aosd），都沒有就退 2。
裡面長這樣（第一次 start 會自己建）：

    kernel.json      {"pid": N, "started": "...", "tick": N}   跑著的 kernel 自己寫
    config.json      {"legacy_env": false}                        kernel 的設定；沒寫也是 false
    kernel.log       kernel 自己的輸出
    requests/        待處理的請求檔 <時間戳>.json
    requests/done/   處理過的，同檔名，多一個 "result"
    clocks/<id>.json 一個時鐘一個檔（dir／pid／state／interval／user／env／env_keep／env_from…）
    logs/<id>.log    那個時鐘的 aos-loop 輸出

`id` 是世界資料夾絕對真實路徑做 percent-encoding（`urllib.parse.quote(path, safe='')`，
`/tmp/a/b` → `%2Ftmp%2Fa%2Fb`）：可逆、不會兩個不同路徑撞到同一個 id；編出來超過 200 bytes
就退回 `sha256(路徑)` 的十六進位值。真正的路徑一律以檔案裡的 `dir` 為準（`ls` 印的也是 `dir`）。
**一個路徑只能有一個時鐘**，路徑就是時鐘的 id。

  start    背景開一個 kernel，等 pid 活著且第一格跑完才回（最多 5 秒）；已經有活著的退 1
  stop     對 kernel 送 SIGTERM，它會先把所有時鐘收掉再走；沒在跑退 1
  restart  跑著就先 stop，再 start
  ls       印現在有哪些時鐘（第一行是 kernel 自己），沒有 kernel 也看得到；--json 出 JSON
  tick     前景只推一格就走（測試用，不必開背景進程）；背景的 run 就是一直 tick
  resume   把上一輪的時鐘接回來（kernel 起來時自己會先做一次，這裡是給人／測試單獨叫的）

**重啟接得上**：start（restart 也是）會先掃一遍 clocks/：pid 還活著就直接認領（狀態原封不動），
pid 死了而狀態是 running 就照原本的設定重開一個，狀態已經是 dead 的不碰，資料夾不見了就標 dead。
stop 只殺進程、不刪時鐘檔也不改狀態，所以 stop → start 跑著的會自己回來。

**掛了自動重開**：kernel 每格都會巡一遍時鐘，running 的進程不見了就馬上照原設定再開一個，
`restarts` 加一（`ls` 有這欄）。`dead` 現在只代表「想重開卻開不起來」（資料夾不見了、開不起
進程），下一格還是會再試，成功就回 running；log 只在換邊時才記，不會每格刷一行。

**暫停的鐘不受 kernel 開關影響**：一個被 pause 掉的鐘，要麼被重新 register 或 continue 後才會
繼續跑，否則 kernel 的 start／stop 不會影響到他。所以 stop 一樣把它的進程收掉，但狀態留在
paused；start 的 resume 不會幫它重開（log 記 `tick 0 keep-paused`）；tick 巡邏看到 paused 的
進程不在也不標 dead。要它再跑：`continue`（進程還在就 SIGCONT，不在就重開一個）。

**環境相容開關**：daemon 目錄的 `config.json` 沒寫 `legacy_env` 時預設 false，只給時鐘
PATH／HOME／USER／LANG／AOS_DAEMON_DIR／AOS_LLM_DIR。設成 true 才繼承 kernel 的整包環境，
再套該時鐘的 env_keep → env → env_from；env_from 檔不是 600 就不開鐘，原因寫進請求結果。
"""
import argparse
import hashlib
import json
import os
import pwd
import signal
import stat
import subprocess
import sys
import time
import urllib.parse
from datetime import datetime

HERE = os.path.dirname(os.path.abspath(sys.argv[0]))


def log(msg):
    print("aos-daemon-kernel: " + msg, flush=True)


def die(msg, code=2):
    print("aos-daemon-kernel: " + msg, file=sys.stderr)
    sys.exit(code)


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
    except OSError:
        return default
    if not text:
        return default
    try:
        return json.loads(text)
    except ValueError:
        return default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
        f.write("\n")


MAX_ID = 200   # 檔名長度上限（bytes），超過就退回 sha256


def dir_id(path):
    """路徑 → 時鐘檔名。percent-encoding，可逆又不會撞名；太長就退回 sha256。"""
    enc = urllib.parse.quote(path, safe="")
    if len(enc.encode("utf-8")) > MAX_ID:
        return hashlib.sha256(path.encode("utf-8")).hexdigest()
    return enc or "%2F"


def id_dir(cid):
    """時鐘檔名 → 路徑（sha256 那種救不回來，所以只當 dir 缺了才拿來墊）。"""
    return urllib.parse.unquote(cid)


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except OSError:
        return False
    return True


def now():
    return datetime.now().isoformat(timespec="seconds")


def me():
    return pwd.getpwuid(os.getuid()).pw_name


class Home:
    def __init__(self, d):
        self.dir = os.path.abspath(d)
        self.kernel = os.path.join(self.dir, "kernel.json")
        self.log = os.path.join(self.dir, "kernel.log")
        self.requests = os.path.join(self.dir, "requests")
        self.done = os.path.join(self.requests, "done")
        self.clocks = os.path.join(self.dir, "clocks")
        self.logs = os.path.join(self.dir, "logs")

    def make(self):
        for p in (self.dir, self.requests, self.done, self.clocks, self.logs):
            os.makedirs(p, exist_ok=True)

    def clock_path(self, cid):
        return os.path.join(self.clocks, cid + ".json")

    def clock_files(self):
        if not os.path.isdir(self.clocks):
            return []
        return sorted(n for n in os.listdir(self.clocks)
                      if n.endswith(".json") and os.path.isfile(os.path.join(self.clocks, n)))

    def read_clocks(self):
        out = []
        for n in self.clock_files():
            c = read_json(os.path.join(self.clocks, n), None)
            if isinstance(c, dict):
                cid = n[: -len(".json")]
                c.setdefault("id", cid)
                if not c.get("dir"):
                    c["dir"] = id_dir(cid)   # 檔裡沒 dir 才從 id 解回來墊一個
                out.append(c)
        return out


# ── 一格 ────────────────────────────────────────────────────────────────────

def target_identity(user):
    """回傳時鐘要看到的 HOME／USER；沒切身份就是 kernel 自己。"""
    try:
        who = pwd.getpwnam(user) if user else pwd.getpwuid(os.getuid())
    except KeyError:
        return None, None, "找不到這個 user：%s" % user
    return who.pw_dir, who.pw_name, None


def read_env_file(path):
    """讀 600 的 KEY=VALUE 檔；成功回 (dict, None)，失敗回 (None, 訊息)。"""
    path = os.path.abspath(os.path.expanduser(path))
    try:
        mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError as e:
        return None, "env_from 讀不到：%s（%s）" % (path, e)
    if mode != 0o600:
        return None, "env_from 權限要是 600：%s（現在是 %03o）" % (path, mode)
    values = {}
    try:
        with open(path, encoding="utf-8") as f:
            for number, raw in enumerate(f, 1):
                line = raw.rstrip("\r\n")
                if not line or line.lstrip().startswith("#"):
                    continue
                if "=" not in line:
                    return None, "env_from 第 %d 行要寫 KEY=VALUE：%s" % (number, path)
                key, value = line.split("=", 1)
                key = key.strip()
                if not key:
                    return None, "env_from 第 %d 行的 KEY 是空的：%s" % (number, path)
                values[key] = value
    except OSError as e:
        return None, "env_from 讀不到：%s（%s）" % (path, e)
    return values, None


def build_env(home, cfg, user):
    """組時鐘環境；預設乾淨，legacy_env=true 才整包繼承。"""
    daemon_cfg = read_json(os.path.join(home.dir, "config.json"), {})
    legacy = isinstance(daemon_cfg, dict) and daemon_cfg.get("legacy_env") is True
    home_dir, user_name, error = target_identity(user)
    if error:
        return None, error

    if legacy:
        env = dict(os.environ)
    else:
        env = {
            "PATH": os.defpath,
            "HOME": home_dir,
            "USER": user_name,
            "LANG": os.environ.get("LANG") or "C.UTF-8",
            "AOS_DAEMON_DIR": home.dir,
            "AOS_LLM_DIR": os.environ.get("AOS_LLM_DIR", ""),
        }

    # 這兩個即使 legacy 模式下原本沒設，也給時鐘一個明確落點。
    env.setdefault("HOME", home_dir)
    env.setdefault("USER", user_name)
    env.setdefault("LANG", os.environ.get("LANG") or "C.UTF-8")
    env.setdefault("AOS_DAEMON_DIR", home.dir)
    env.setdefault("AOS_LLM_DIR", os.environ.get("AOS_LLM_DIR", ""))

    keep = cfg.get("env_keep", [])
    if not isinstance(keep, list) or not all(isinstance(name, str) for name in keep):
        return None, "env_keep 要是環境變數名字的 JSON 陣列"
    for name in keep:
        if name in os.environ:
            env[name] = os.environ[name]

    direct = cfg.get("env", {})
    if not isinstance(direct, dict):
        return None, "env 要是 JSON 物件"
    for key, value in direct.items():
        if not isinstance(key, str) or not isinstance(value, str):
            return None, "env 的名字和值都要是字串"
        env[key] = value

    source = cfg.get("env_from")
    if source is not None:
        if not isinstance(source, str) or not source:
            return None, "env_from 要是檔案路徑"
        loaded, error = read_env_file(source)
        if error:
            return None, error
        env.update(loaded)

    # config 可以換 PATH 的其餘內容，但 aos 工具目錄永遠放最前面。
    path = env.get("PATH") or os.defpath
    env["PATH"] = HERE if path == HERE else HERE + os.pathsep + path
    return env, None


def start_loop(home, world, interval, user, restarts=0, cfg=None):
    """真的把 aos-loop 開起來，成功回 (True, pid)，失敗回 (False, 訊息)。"""
    cfg = cfg if isinstance(cfg, dict) else {}
    cid = dir_id(world)
    cmd = [os.path.join(HERE, "aos-loop"), world, "--keep-inst", "--interval", str(interval)]
    if user and user != me():
        if os.geteuid() != 0:
            return False, "要切換身份得用 root 跑 kernel"
        cmd = ["runuser", "-u", user,
               "-w", "PATH,HOME,USER,LANG,AOS_DAEMON_DIR,AOS_LLM_DIR", "--"] + cmd

    env, error = build_env(home, cfg, user)
    if error:
        return False, error
    logfile = os.path.join(home.logs, cid + ".log")
    os.makedirs(home.logs, exist_ok=True)
    try:
        out = open(logfile, "ab")
        with open(os.devnull, "rb") as devnull:
            p = subprocess.Popen(cmd, cwd=world, env=env, stdin=devnull,
                                 stdout=out, stderr=out, start_new_session=True)
        out.close()
    except OSError as e:
        return False, "開不起時鐘：%s" % e
    clock = {
        "dir": world, "id": cid, "pid": p.pid, "state": "running",
        "interval": interval, "user": user, "started": now(),
        "restarts": restarts, "error": None,
    }
    for name in ("env", "env_keep", "env_from"):
        if name in cfg:
            clock[name] = cfg[name]
    write_json(home.clock_path(cid), clock)
    return True, p.pid


def spawn_clock(home, world, cfg):
    """register 用：先檢查沒人佔著這個路徑，再開時鐘。"""
    old = read_json(home.clock_path(dir_id(world)), None)
    if isinstance(old, dict) and old.get("state") in ("running", "paused"):
        return False, "已經有時鐘了（%s）；要續跑用 continue，要重做先 unregister：%s" % (
            old.get("state"), world)
    try:
        interval = float(cfg.get("interval", 1))
    except (TypeError, ValueError):
        return False, "interval 要是數字：%r" % cfg.get("interval")
    ok, r = start_loop(home, world, interval, cfg.get("user") or None, cfg=cfg)
    if not ok:
        return False, r
    return True, "時鐘開好了，pid %d，每 %g 秒一格" % (r, interval)


def resume(home):
    """kernel 起來時先把上一輪的時鐘接回來（log 記成 tick 0）。

    pid 還活著（kernel 被 SIGKILL 掉但時鐘沒死）就直接認領、狀態原封不動（暫停的還是暫停）；
    暫停的鐘 pid 死了也**不重開**，維持 paused——要它跑得自己 continue 或重新 register；
    running 而 pid 死了就照原本的 dir／interval／user 重開一個；狀態已經是 dead 的交給
    tick 去重試；資料夾不見了就標 dead。世界的進度存在世界資料夾裡，接回來就等於接上了。
    """
    for clock in home.read_clocks():
        world = clock.get("dir") or ""
        pid = int(clock.get("pid") or 0)
        if clock.get("state") == "dead":
            continue
        if alive(pid):
            log("tick 0 adopt %s pid %d" % (world, pid))
            continue
        if clock.get("state") == "paused":
            log("tick 0 keep-paused %s" % world)
            continue
        if not os.path.isdir(world):
            clock["state"] = "dead"
            clock["error"] = "資料夾不見了"
            write_json(home.clock_path(clock["id"]), clock)
            log("tick 0 %s 資料夾不見了，標成 dead" % world)
            continue
        try:
            interval = float(clock.get("interval") or 1)
        except (TypeError, ValueError):
            interval = 1
        ok, r = start_loop(home, world, interval, clock.get("user") or None,
                           int(clock.get("restarts") or 0), clock)
        if ok:
            log("tick 0 resume %s pid %d" % (world, r))
        else:
            clock["state"] = "dead"
            clock["error"] = str(r)
            write_json(home.clock_path(clock["id"]), clock)
            log("tick 0 %s 接不回來（%s），標成 dead" % (world, r))


def signal_clock(pid, sig):
    try:
        os.killpg(pid, sig)
        return True
    except OSError:
        try:
            os.kill(pid, sig)
            return True
        except OSError:
            return False


def reap(pid):
    try:
        os.waitpid(pid, os.WNOHANG)
    except OSError:
        pass


def do_op(home, req, tick):
    op = req.get("op")
    if op not in ("register", "unregister", "pause", "continue"):
        return False, "不認識的 op：%r" % op
    world = req.get("dir")
    if not world:
        return False, "請求裡沒有 dir"
    world = os.path.realpath(os.path.expanduser(str(world)))
    cid = dir_id(world)
    cfg = req.get("config") or {}
    if not isinstance(cfg, dict):
        cfg = {}

    if op == "register":
        if not os.path.isdir(world):
            return False, "找不到這個資料夾：" + world
        return spawn_clock(home, world, cfg)

    path = home.clock_path(cid)
    clock = read_json(path, None)
    if not isinstance(clock, dict):
        return False, "這個資料夾沒有時鐘：" + world
    pid = int(clock.get("pid") or 0)

    if op == "unregister":
        signal_clock(pid, signal.SIGTERM)
        signal_clock(pid, signal.SIGCONT)   # 被 STOP 住的收不到 TERM，先讓它醒
        reap(pid)
        try:
            os.remove(path)
        except OSError:
            pass
        return True, "時鐘關掉了（log 留著）：" + world

    if clock.get("state") == "dead":
        return False, "這個時鐘已經死了：" + world
    if op == "pause":
        if clock.get("state") == "paused":
            return False, "本來就暫停著：" + world
        if not signal_clock(pid, signal.SIGSTOP):
            return False, "送不出 SIGSTOP（pid %d 不在了？）" % pid
        clock["state"] = "paused"
        write_json(path, clock)
        return True, "暫停了：" + world
    if clock.get("state") != "paused":
        return False, "本來就在跑：" + world
    if alive(pid):
        if not signal_clock(pid, signal.SIGCONT):
            return False, "送不出 SIGCONT（pid %d 不在了？）" % pid
        clock["state"] = "running"
        write_json(path, clock)
        return True, "續跑了：" + world
    # 進程被 stop／別人收掉了：照原設定重開一個，這才是暫停的鐘回來跑的唯一途徑
    try:
        interval = float(clock.get("interval") or 1)
    except (TypeError, ValueError):
        interval = 1
    ok, r = start_loop(home, world, interval, clock.get("user") or None,
                       int(clock.get("restarts") or 0), clock)
    if not ok:
        return False, r
    return True, "續跑了（重新開了一個，pid %d）：%s" % (r, world)


def supervise(home, clock, tick):
    """時鐘掛了就馬上重開（restarts +1）；重開不了才標 dead，之後每格再試。

    log 只在狀態換邊時才寫（running→dead、dead→running），不然每格都會刷一行。
    """
    world = clock.get("dir") or ""
    was = clock.get("state")
    restarts = int(clock.get("restarts") or 0)
    try:
        interval = float(clock.get("interval") or 1)
    except (TypeError, ValueError):
        interval = 1
    if os.path.isdir(world):
        ok, r = start_loop(home, world, interval, clock.get("user") or None,
                           restarts + 1, clock)
    else:
        ok, r = False, "資料夾不見了"
    if ok:
        log("tick %d restart %s pid %d (restarts %d)" % (tick, world, r, restarts + 1))
        return
    clock["state"] = "dead"
    clock["error"] = str(r)
    write_json(home.clock_path(clock["id"]), clock)
    if was != "dead":
        log("tick %d %s 重開不了（%s），標成 dead，下一格再試" % (tick, world, r))


def tick_once(home):
    home.make()
    k = read_json(home.kernel, {})
    tick = int(k.get("tick") or 0) + 1
    k["tick"] = tick
    write_json(home.kernel, k)

    names = sorted(n for n in os.listdir(home.requests)
                   if n.endswith(".json") and os.path.isfile(os.path.join(home.requests, n)))
    for name in names:
        src = os.path.join(home.requests, name)
        req = read_json(src, None)
        if not isinstance(req, dict):
            req = {"result": None}
            ok, msg = False, "請求檔讀不成 JSON 物件"
        else:
            try:
                ok, msg = do_op(home, req, tick)
            except Exception as e:          # 一個壞請求不該弄死 kernel
                ok, msg = False, "處理請求時出錯：%s" % e
        req["result"] = {"ok": ok, "message": msg}
        write_json(os.path.join(home.done, name), req)
        try:
            os.remove(src)
        except OSError:
            pass
        log("tick %d %s %s %s：%s" % (tick, req.get("op"), req.get("dir"),
                                      "ok" if ok else "fail", msg))

    for clock in home.read_clocks():
        state = clock.get("state")
        if state not in ("running", "paused", "dead"):
            continue
        pid = int(clock.get("pid") or 0)
        reap(pid)
        if state == "paused":
            continue        # 暫停的鐘進程不在是正常的（被 stop 收掉），不動它
        if state == "running" and alive(pid):
            continue
        supervise(home, clock, tick)
    return tick


# ── 背景常駐 ────────────────────────────────────────────────────────────────

def run(home, interval):
    home.make()
    k = read_json(home.kernel, {})
    k["pid"] = os.getpid()
    k["started"] = now()
    k.setdefault("tick", 0)
    write_json(home.kernel, k)
    log("kernel 起來了，pid %d，每 %g 秒一格" % (os.getpid(), interval))
    resume(home)

    def bye(signum, frame):
        log("收到訊號 %d，收工" % signum)
        for clock in home.read_clocks():
            pid = int(clock.get("pid") or 0)
            signal_clock(pid, signal.SIGTERM)
            signal_clock(pid, signal.SIGCONT)
        time.sleep(0.3)
        for clock in home.read_clocks():
            pid = int(clock.get("pid") or 0)
            reap(pid)
            if alive(pid):
                signal_clock(pid, signal.SIGKILL)
            # 狀態不動：running 的下次 start 會接回來，paused 的要 continue 才會再跑
            clock["error"] = ("kernel 收工時一起收掉了，" +
                              ("要 continue 才會再跑" if clock.get("state") == "paused"
                               else "下次 start 會接回來"))
            write_json(home.clock_path(clock["id"]), clock)
        cur = read_json(home.kernel, {})
        cur["pid"] = None
        write_json(home.kernel, cur)
        sys.exit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    while True:
        tick_once(home)
        time.sleep(interval)


def cmd_start(home, interval):
    home.make()
    k = read_json(home.kernel, {})
    if alive(k.get("pid")):
        print("aos-daemon-kernel: kernel 已經在跑了，pid %s" % k["pid"], file=sys.stderr)
        sys.exit(1)
    before_tick = int(k.get("tick") or 0)
    out = open(home.log, "ab")
    with open(os.devnull, "rb") as devnull:
        p = subprocess.Popen(
            [sys.executable, os.path.abspath(sys.argv[0]), "run", home.dir,
             "--interval", str(interval)],
            stdin=devnull, stdout=out, stderr=out, start_new_session=True)
    out.close()
    deadline = time.time() + 5
    while time.time() < deadline:
        current = read_json(home.kernel, {})
        if (current.get("pid") == p.pid and alive(p.pid)
                and int(current.get("tick") or 0) >= max(1, before_tick + 1)):
            break
        if p.poll() is not None:
            print("aos-daemon-kernel: kernel 還沒跑完第一格就停了，請看 %s" % home.log,
                  file=sys.stderr)
            return 1
        time.sleep(0.05)
    else:
        print("aos-daemon-kernel: 等了 5 秒，kernel 還沒跑完第一格，請看 %s" % home.log,
              file=sys.stderr)
        try:
            os.kill(p.pid, signal.SIGTERM)
        except OSError:
            pass
        return 1
    print(p.pid)
    print("aos-daemon-kernel: kernel 起來了，pid %d，輸出在 %s" % (p.pid, home.log),
          file=sys.stderr)
    return 0


def cmd_stop(home):
    k = read_json(home.kernel, {})
    pid = k.get("pid")
    if not alive(pid):
        print("aos-daemon-kernel: kernel 沒在跑", file=sys.stderr)
        sys.exit(1)
    os.kill(int(pid), signal.SIGTERM)
    for _ in range(50):
        if not alive(pid):
            print("aos-daemon-kernel: kernel（pid %s）停了，時鐘一起收掉" % pid,
                  file=sys.stderr)
            return 0
        time.sleep(0.1)
    print("aos-daemon-kernel: 送了 SIGTERM 但 pid %s 還在" % pid, file=sys.stderr)
    sys.exit(1)


def cmd_ls(home, as_json):
    k = read_json(home.kernel, {})
    clocks = home.read_clocks()
    if as_json:
        print(json.dumps({"dir": home.dir, "kernel": k, "clocks": clocks},
                         ensure_ascii=False, indent=2))
        return 0
    up = alive(k.get("pid"))
    if up:
        print("kernel: 跑著 pid %s tick %s（%s）" % (k.get("pid"), k.get("tick"), home.dir))
    else:
        print("kernel: 沒在跑（%s）" % home.dir)
    if not clocks:
        print("（沒有時鐘）")
        return 0
    print("%-8s %-8s %-8s %-8s %-10s %s"
          % ("STATE", "PID", "INTERVAL", "RESTARTS", "USER", "DIR"))
    for c in clocks:
        state = c.get("state")
        # kernel 不在的時候，running 但進程已經沒了＝被 stop 收掉了，印 stopped
        # （檔裡還是 running，這只是顯示）；paused 就照樣印 paused
        if state == "running" and not up and not alive(c.get("pid")):
            state = "stopped"
        print("%-8s %-8s %-8s %-8s %-10s %s" % (
            state, c.get("pid"), c.get("interval"), int(c.get("restarts") or 0),
            c.get("user") or "-", c.get("dir")))
    return 0


def main():
    ap = argparse.ArgumentParser(prog="aos-daemon-kernel")
    ap.add_argument("cmd", choices=["start", "restart", "stop", "ls", "tick", "run", "resume"])
    ap.add_argument("dir", nargs="?", default=None)
    ap.add_argument("--interval", type=float, default=1)
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    d = args.dir or os.environ.get("AOS_DAEMON_DIR")
    if not d:
        die("沒給 daemon 目錄，也沒設 AOS_DAEMON_DIR")
    home = Home(os.path.expanduser(d))

    if args.cmd == "run":
        run(home, args.interval)
    if args.cmd == "resume":
        home.make()
        resume(home)
        return 0
    if args.cmd == "start":
        return cmd_start(home, args.interval)
    if args.cmd == "restart":
        if alive(read_json(home.kernel, {}).get("pid")):
            cmd_stop(home)
        return cmd_start(home, args.interval)
    if args.cmd == "stop":
        return cmd_stop(home)
    if args.cmd == "ls":
        if not os.path.isdir(home.dir):
            die("找不到 daemon 目錄：" + home.dir)
        return cmd_ls(home, args.json)
    tick_once(home)
    return 0


sys.exit(main())
