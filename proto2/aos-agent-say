#!/usr/bin/env python3
"""aos-agent-say [dir] [text] — 往一個 agent 資料夾的 new-prompts/ 丟一句話。

dir 省略就用目前目錄；text 省略就整段讀 stdin。檔名是時間戳到微秒
（20260905-231500-123456.json），同一秒內丟好幾句也排得出先後。目錄不在就建。
"""
import argparse
import datetime
import json
import os
import sys


def say(workdir, text):
    """寫一則 {"role":"user","content":text} 進 new-prompts/，回寫到哪個檔。"""
    now = datetime.datetime.now()
    name = now.strftime("%Y%m%d-%H%M%S") + "-%06d.json" % now.microsecond
    box = os.path.join(workdir, ".aos", "agent", "new-prompts")
    os.makedirs(box, exist_ok=True)
    path = os.path.join(box, name)
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"role": "user", "content": text}, f, ensure_ascii=False, indent=2)
        f.write("\n")
    return path


def main():
    ap = argparse.ArgumentParser(prog="aos-agent-say")
    ap.add_argument("dir", nargs="?", default=".")
    ap.add_argument("text", nargs="?", default=None)
    args = ap.parse_args()
    text = args.text if args.text is not None else sys.stdin.read()
    print("aos-agent-say: 寫了 " + say(args.dir, text), file=sys.stderr)


main()
