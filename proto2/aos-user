# ── team why／team tail：一個人在旁邊看整隊時要的兩件事 ────────────────────
def _wide(text):
    """一行有多寬：中日文字算兩格，欄位才對得齊。"""
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in str(text))


def _pad(text, width):
    """右邊補空白補到指定寬度（本來就太長就只補一格，不硬切）。"""
    return str(text) + " " * max(1, width - _wide(text))


def _cut_wide(text, width):
    """照顯示寬度切一段，切掉的地方補一個 …。"""
    out, used = "", 0
    for ch in str(text):
        step = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if used + step > width:
            return out + "…"
        out, used = out + ch, used + step
    return out


def _k(number):
    """12345 → 12k；不是數字就印 ?，免得看的人以為是 0。"""
    if not isinstance(number, (int, float)) or isinstance(number, bool):
        return "?"
    return "%dk" % round(number / 1000.0) if abs(number) >= 1000 else "%d" % round(number)


def _llm_queue(llm):
    """LLM 資料夾此刻的排隊順序與正在打的請求，回 (排隊檔名 list, 執行中檔名 set)。

    順序照 priority 大的先、同級先來先走；`aos-llm` 真正派工還會加等待、成本、最近誰用過
    的加減分，所以這裡的名次只是給人看個大概，不保證跟下一格的派工完全一樣。
    """
    box = os.path.join(llm, "requests") if llm else ""
    if not box or not os.path.isdir(box):
        return [], set()
    rows = []
    for name in os.listdir(box):
        path = os.path.join(box, name)
        if not (name.endswith(".json") and os.path.isfile(path)):
            continue
        req = read_json(path, {})
        level = req.get("priority") if isinstance(req, dict) else None
        if isinstance(level, dict):
            level = level.get("level")
        if not isinstance(level, (int, float)) or isinstance(level, bool):
            level = 0
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            mtime = 0
        rows.append((-level, mtime, name))
    run_box = os.path.join(box, "running")
    running = {n for n in os.listdir(run_box)
               if n.endswith(".json")} if os.path.isdir(run_box) else set()
    return [row[2] for row in sorted(rows)], running


def _queue_text(request, queue):
    order, running = queue
    if not request:
        return "沒有請求"
    if request in running:
        return "模型正在打"
    if request in order:
        return "排隊中，第 %d 位" % (order.index(request) + 1)
    return "不在排隊裡了，等結果掉出來"


def _open_tasks(root):
    """team/tasks/*.json 裡還沒做完（assigned／failed）的，照 owner 分組。"""
    box = os.path.join(root, "team", "tasks")
    out = {}
    if not os.path.isdir(box):
        return out
    for name in sorted(os.listdir(box)):
        if not name.endswith(".json"):
            continue
        task = read_json(os.path.join(box, name), {})
        if isinstance(task, dict) and task.get("status") in ("assigned", "failed"):
            out.setdefault(str(task.get("owner") or ""), []).append(task)
    return out


def _short_task(task_id):
    """order-20260907-120000-000001-t3 → order-…-t3，一行才塞得下。"""
    text = str(task_id or "?")
    head, mark, tail = text.partition("-t")
    if mark and len(text) > 16 and head.startswith("order-"):
        return "order-…-t" + tail
    return _cut_wide(text, 22)


def _task_text(tasks):
    if not tasks:
        return "沒有任務"
    more = "+%d" % (len(tasks) - 1) if len(tasks) > 1 else ""
    return "任務 %s（%s）%s" % (_short_task(tasks[0].get("id")),
                               tasks[0].get("status") or "?", more)


def _unread_text(home):
    counts = [(src, len(unread_names(home, src))) for src in sources(home)]
    counts = [(src, n) for src, n in counts if n]
    total = sum(n for _, n in counts)
    if not total:
        return "未讀 0 封"
    detail = "、".join("%s %d" % (src, n) for src, n in counts[:3])
    return "未讀 %d 封（%s）" % (total, detail)


def _last_tick(path):
    """state.json 上次被寫的時刻＝它上一格什麼時候走的。"""
    try:
        return time.strftime("%H:%M:%S", time.localtime(os.path.getmtime(path)))
    except OSError:
        return "?"


def _why_of(row, state, queue, tasks, home):
    """一個成員現在的短狀態與一句話原因。全部從既有的檔算出來，算不出來就印 ?。"""
    st = state.get("state") or "idle"
    blocked = row.get("blocked") or state.get("budget_block") or ""
    frozen = state.get("frozen_ticks") or 0
    sleeping = state.get("sleeping") if isinstance(state.get("sleeping"), dict) else None
    left = (row.get("remaining") or {}).get("tokens")
    if not row.get("active", True):
        return "停", "team stop 收掉了，檔案和帳都還在"
    if blocked.startswith("team:"):
        return "凍住", "整隊 %s 用完，全隊凍住 %s 格" % (blocked[5:] or "?", frozen)
    if blocked:
        return "凍住", "tokens 用完（上限 %s、已用 %s），等撥款 %s 格" % (
            _k((row.get("budget") or {}).get("tokens")),
            _k((row.get("today_spent") or {}).get("tokens")), frozen)
    if state.get("limit_pause"):
        return "等人", "撞到 llm.json 的 %s 上限，等使用者說一句繼續" % (
            state.get("limit_kind") or "?")
    if sleeping:
        return "睡", "等 %s %s 的回信，已 %s 格" % (
            sleeping.get("kind") or "?", _cut_wide(sleeping.get("id") or "?", 15),
            state.get("question_sleep_steps") or 0)
    if st == "wait":
        return "llm→wait", "等 LLM 回（%s，已等 %s 格）" % (
            _queue_text(state.get("request"), queue), state.get("wait_ticks") or 0)
    base = {"idle": "閒", "llm": "要問模型", "act": "跑工具", "collect": "收信"}.get(st, st)
    detail = {"llm": "正把 prompt 丟進 LLM 資料夾", "act": "正在跑模型點的工具",
              "collect": "跑完工具，再掃一次信箱"}.get(
                  st, "上一格 %s" % _last_tick(os.path.join(home, "state.json")))
    return base, "%s，%s" % (detail, _task_text(tasks))


def do_team_why(args):
    """一人一行：現在在幹嘛、為什麼卡著、還有幾封沒讀、tokens 還剩多少。"""
    world = os.path.abspath(args.dir)
    try:
        data = team_status_of(world, light=True)
    except (OSError, ValueError) as e:
        warn(str(e))
        return 2
    root = data["root"]
    rows = data["members"]
    if args.member:
        rows = [row for row in rows if row["name"] == args.member]
        if not rows:
            warn("名冊裡沒有這個成員：%s" % args.member)
            return 2
    tasks, queues = _open_tasks(root), {}
    print("工作室 %s（%s）" % (data["name"], data["day"]))
    for row in rows:
        member_world = os.path.abspath(os.path.join(root, row.get("path") or "."))
        home = resolve_home(member_world, None)
        state = read_json(os.path.join(home, "state.json"), {})
        state = state if isinstance(state, dict) else {}
        llm = find_llm(home, member_world) or ""
        if llm not in queues:
            queues[llm] = _llm_queue(llm)
        label, why = _why_of(row, state, queues[llm], tasks.get(row["name"]) or [], home)
        print("%s%s%s%s%s" % (
            _pad(row["name"], 8), _pad(label, 10), _pad(_cut_wide(why, 48), 50),
            _pad(_unread_text(home), 26),
            "tokens 剩 " + _k((row.get("remaining") or {}).get("tokens"))))
    return 0


def _rounds_of(history):
    """把記憶切成一輪一輪：一則 assistant 開一輪，後面接著的 tool 結果算同一輪。"""
    rounds = []
    for msg in history:
        if not isinstance(msg, dict):
            continue
        if msg.get("role") == "assistant":
            rounds.append({"say": msg, "results": []})
        elif msg.get("role") == "tool" and rounds:
            rounds[-1]["results"].append(msg)
    return rounds


def _call_names(history):
    """tool_call_id → 工具名（tool 結果自己沒帶名字，要回頭去 assistant 那則找）。"""
    names = {}
    for msg in history:
        if not isinstance(msg, dict):
            continue
        for call in msg.get("tool_calls") or []:
            if isinstance(call, dict) and call.get("id"):
                names[call["id"]] = (call.get("function") or {}).get("name") or "?"
    return names


def _one_line(text, cut):
    return " ".join(str(text or "").split())[:cut]


def do_team_tail(args):
    """看某個成員最近幾輪的「模型說 / 工具回」，就是它 prompts.json 的尾巴。"""
    root = team_root_of(os.path.abspath(args.dir))
    if not root:
        warn("這不是工作室：" + os.path.abspath(args.dir))
        return 2
    world = _team_member(root, args.member)
    if not world:
        warn("名冊裡沒有這個成員：%s" % args.member)
        return 2
    home = resolve_home(world, None)
    state = read_json(os.path.join(home, "state.json"), {})
    state = state if isinstance(state, dict) else {}
    tokens = today_usage_for(home, world).get("total_tokens")
    print("%s  state=%s  step=%s  今日 tokens %s" % (
        args.member, state.get("state") or "?", state.get("step") if isinstance(
            state.get("step"), int) else "?", _k(tokens)))
    history = read_json(os.path.join(home, "prompts.json"), [])
    history = history if isinstance(history, list) else []
    names = _call_names(history)
    rounds = _rounds_of(history)
    if not rounds:
        print("（還沒有模型回合：prompts.json 裡只有起手信）")
        return 0
    picked = rounds[-max(1, args.n):]
    for back, item in enumerate(picked, 1):
        print("--- 倒數第 %d 輪 ---" % (len(picked) - back + 1))
        calls = item["say"].get("tool_calls") or []
        text = _one_line(item["say"].get("content"), 300)
        print("模型說：" + (text or "（沒說話，只點工具）"))
        for call in calls:
            fn = call.get("function") if isinstance(call, dict) else None
            fn = fn if isinstance(fn, dict) else {}
            raw = fn.get("arguments")
            if not isinstance(raw, str):
                raw = json.dumps(raw or {}, ensure_ascii=False)
            print("  → %s %s" % (fn.get("name") or "?", _one_line(raw, 120)))
        if item["results"]:
            print("工具回：")
        for result in item["results"]:
            print("  ← %s: %s" % (names.get(result.get("tool_call_id"), "?"),
                                  _one_line(result.get("content"), 200)))
    return 0


def do_team_stop(args):
    root = team_root_of(os.path.abspath(args.dir))
    if not root:
        warn("找不到 team/team.json：" + os.path.abspath(args.dir))
        return 2
    path = os.path.join(root, "team", "team.json")
    roster = read_json(path, {})
    failed = []
    if os.environ.get("AOS_DAEMON_DIR"):
        for member in reversed(roster.get("members", [])):
            if not isinstance(member, dict) or member.get("clock") != "own":
                continue
            target = os.path.abspath(os.path.join(root, member.get("path") or "."))
            done = subprocess.run([os.path.join(HERE, "aos-daemon"), "unregister", target],
                                  capture_output=True, text=True)
            if done.returncode != 0 and "找不到這個時鐘" not in (done.stderr or done.stdout):
                failed.append(member.get("name") or target)
    with team_lock(root):                 # 名冊是共用檔，跟成員那邊的改寫互斥
        roster = read_json(path, {})
        for member in roster.get("members", []):
            if isinstance(member, dict):
                member["active"] = False
        write_json_atomic(path, roster)
    if failed:
        warn("這些鐘沒收乾淨：" + "、".join(failed))
        return 1
    print("整隊已停；檔案、記憶和帳都留著：" + root)
    return 0


def do_order(args):
    root = team_root_of(os.path.abspath(args.dir))
    if not root:
        warn("這不是工作室：" + os.path.abspath(args.dir))
        return 2
    sales = _team_member(root, "sales")
    if not sales:
        warn("名冊裡沒有 sales")
        return 2
    try:
        budget = json_object(args.budget, "--budget") if args.budget else {}
        # order 可只給這張單在意的欄位，不替甲方偷偷補一串數字。
        normalize_team_budget({}, budget)
    except ValueError as e:
        warn(str(e))
        return 2
    order_id = "order-" + time.strftime("%Y%m%d-%H%M%S") + ("-%06d" % (time.time_ns() % 1000000))
    body = {"order": args.task, "budget": budget,
            "acceptance": list(args.accept or []), "out_of_scope": []}
    content = json.dumps(body, ensure_ascii=False, separators=(",", ":"))
    home = resolve_home(sales, None)
    box = os.path.join(home, "inbox", DIRECT_SOURCE)
    letter = {"from": "user", "to": "sales", "time": now_iso(), "order_id": order_id,
              "content": content, **body}
    path = os.path.join(box, order_id + ".json")
    write_json_atomic(path, letter)
    user_dir = os.environ.get("AOS_USER_DIR")
    if user_dir:
        write_json_atomic(os.path.join(os.path.abspath(user_dir), "outbox", order_id + ".json"), letter)
    print("訂單已送 sales：%s" % order_id)
    return 0


def show(box, name):
    msg = read_json(os.path.join(box, name), {})
    if isinstance(msg, dict) and msg.get("error"):
        print("agent!> " + (msg.get("content") or ""))
        print()
        sys.stdout.flush()
        return
    print("--- reply %s ---" % os.path.splitext(name)[0])
    print(outbox_content(box, name))
    print()
    sys.stdout.flush()


def do_say(args):
    world = os.path.abspath(args.dir)
    home = _client_home(world, args.home)
    text = args.text if args.text is not None else sys.stdin.read()
    warn("寫了 " + put_mail(home, DIRECT_SOURCE, text, DIRECT_SOURCE))
    return 0


def do_listen(args):
    world = os.path.abspath(args.dir)
    box = os.path.join(_client_home(world, args.home), "outbox")
    seen = set(outbox_names(box))
    if not args.new:
        for name in sorted(seen):
            show(box, name)
        if args.once:
            return 0
    try:
        while True:
            fresh = [n for n in outbox_names(box) if n not in seen]
            for name in fresh:
                show(box, name)
                seen.add(name)
            if fresh and args.once:
                return 0
            time.sleep(0.5)
    except KeyboardInterrupt:
        return 0


def do_talk(args):
    world = os.path.abspath(args.dir)
    home = _client_home(world, args.home)
    box = os.path.join(home, "outbox")
    print("（另一個終端機要跑 aos-loop 這個資料夾，不然沒人會回話）")
    while True:
        try:
            line = input("你> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if line.strip() == "/quit":
            return 0
        if not line.strip():
            continue
        before = set(outbox_names(box))
        put_mail(home, DIRECT_SOURCE, line, DIRECT_SOURCE)
        try:
            while True:
                fresh = [n for n in outbox_names(box) if n not in before]
                if fresh:
                    for name in fresh:
                        msg = read_json(os.path.join(box, name), {})
                        prefix = "agent!> " if isinstance(msg, dict) and msg.get("error") else "agent> "
                        print(prefix + outbox_content(box, name))
                        sys.stdout.flush()
                    break
                time.sleep(0.5)
        except KeyboardInterrupt:
            print("\n（不等了，可以繼續打）")


def do_status(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    print(json.dumps(status_of(world, home), ensure_ascii=False, indent=2))
    return 0


def do_spawn(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    ok, msg = spawn(world, home, args.name, args.persona, args.clock, args.template)
    warn(msg)
    return 0 if ok else 2


def main():
    ap = argparse.ArgumentParser(prog="aos-user")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("new", help="用模板開一個新 agent")
    p.add_argument("dir")
    p.add_argument("--template", default=None)
    p.add_argument("--packs", default=None, metavar="包1,包2")
    who = p.add_mutually_exclusive_group()
    who.add_argument("--persona", default=None)
    who.add_argument("--persona-file", default=None, metavar="路徑")
    p.add_argument("--prompts", default=None, metavar="路徑.json")
    p.add_argument("--engine", default=None)
    p.add_argument("--priority", type=int, default=None)
    p.add_argument("--home", default=None, metavar="子路徑")
    p.add_argument("--clock", choices=["own", "none"], default=None)
    p.set_defaults(fn=do_new)
    sub.add_parser("templates", help="列出可用模板").set_defaults(fn=do_templates)
    sub.add_parser("packs", help="列出可用工具包").set_defaults(fn=do_packs)

    team = sub.add_parser("team", help="一次建立、查看或停止整隊").add_subparsers(dest="team_cmd")
    p = team.add_parser("new")
    p.add_argument("dir")
    p.add_argument("--preset", default="studio")
    p.add_argument("--engine", default=None)
    p.add_argument("--budget", default=None)
    p.set_defaults(fn=do_team_new)
    p = team.add_parser("status")
    p.add_argument("dir")
    p.set_defaults(fn=do_team_status)
    p = team.add_parser("budget", help="看整隊預算；--add 追加")
    p.add_argument("dir")
    p.add_argument("--add", default=None, help='追加的量，JSON，例如 \'{"tokens": 100000}\'')
    p.add_argument("--to", default=None, help="追加的份給誰（預設 leader）")
    p.set_defaults(fn=do_team_budget)
    p = team.add_parser("why", help="一人一行：現在在幹嘛、為什麼卡著")
    p.add_argument("dir")
    p.add_argument("--member", default=None, help="只看這一個人")
    p.set_defaults(fn=do_team_why)
    p = team.add_parser("tail", help="看某個成員最近幾輪的模型說／工具回")
    p.add_argument("dir")
    p.add_argument("member")
    p.add_argument("-n", type=int, default=3, help="看最後幾輪（預設 3）")
    p.set_defaults(fn=do_team_tail)
    p = team.add_parser("stop")
    p.add_argument("dir")
    p.set_defaults(fn=do_team_stop)

    p = sub.add_parser("order", help="把訂單交給工作室 sales")
    p.add_argument("dir")
    p.add_argument("task")
    p.add_argument("--budget", default=None)
    p.add_argument("--accept", action="append", default=[])
    p.set_defaults(fn=do_order)

    def world_args(p):
        p.add_argument("dir", nargs="?", default=".")
        p.add_argument("--home", default=None)
        return p

    p = world_args(sub.add_parser("say"))
    p.add_argument("text", nargs="?", default=None)
    p.set_defaults(fn=do_say)
    p = world_args(sub.add_parser("listen"))
    p.add_argument("--new", action="store_true")
    p.add_argument("--once", action="store_true")
    p.set_defaults(fn=do_listen)
    world_args(sub.add_parser("talk")).set_defaults(fn=do_talk)
    world_args(sub.add_parser("status")).set_defaults(fn=do_status)
    # spawn 的世界是必填的（三個位置參數都必填，argparse 才允許 --clock 跟它們交錯）
    p = sub.add_parser("spawn")
    p.add_argument("dir")
    p.add_argument("--home", default=None)
    p.add_argument("name")
    p.add_argument("persona")
    p.add_argument("--clock", choices=["shared", "own"], default="shared")
    p.add_argument("--template", default=None)
    p.set_defaults(fn=do_spawn)

    # Python 3.12 的 argparse：`say <dir> --home agent <text>` 這種「位置、選項、再位置」的順序，
    # nargs="?" 的 text 會被吃成空、原字掉進 extras（3.13 才修）。只有 say 有這個形狀，這裡補回去。
    args, extras = ap.parse_known_args()
    if extras and getattr(args, "fn", None) is do_say and args.text is None and len(extras) == 1:
        args.text = extras[0]
    elif extras:
        ap.error("unrecognized arguments: %s" % " ".join(extras))
    if not getattr(args, "fn", None):
        ap.print_help(sys.stderr)
        return 2
    return args.fn(args)


sys.exit(main())
