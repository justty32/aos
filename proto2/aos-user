#!/usr/bin/env python3
"""aos-user <new|team|order|templates|packs|say|listen|talk|status|spawn> — 人用的殼。

指令切成兩種：**agent 自己跑的時候需要的**（狀態機、它的工具）在 `aos-agent`；
**給人方便用的**在這裡。`aos-user` 自己不推格，只是把「一個人想對某個 agent 做的事」
翻成檔案動作——投一封信、盯著它的 outbox、看它的狀態、幫它生一個小孩。

> **這支是暫時的殼。** 使用者自己之後也會被當成一個 agent，這些動作到時候會變成
> agent 之間的交流（寄信給對方的 inbox、看對方的 outbox），使用者的特殊地位到時再談。

    aos-user say <世界> [文字]        寫一封信進 <home>/inbox/user/（不給文字就整段讀 stdin）
    aos-user listen <世界> [--new] [--once]   盯著 <home>/outbox/，錯誤用 agent!> 印
    aos-user talk <世界>              互動聊天（say ＋ listen，/quit 離開）
    aos-user status <世界>            印它的自我狀態（就是 self_status 那一包）
    aos-user spawn <世界> <名字> <人格> [--clock shared|own] [--template 名字]   幫它生一個小孩
    aos-user new <世界> [設定]        用模板開一個新 agent
    aos-user templates               列出可用模板
    aos-user packs                   列出可用工具包

`--home` 不給就去世界的 `.aos/inst` 把 `--home X` 撈出來用，撈不到就是 `.`——所以
平常打 `aos-user talk examples/agent` 就好，不用每次重複 `--home agent`。
版面與信箱規則見旁邊的 `aos_agent.py`。
"""
import argparse
import json
import os
import shlex
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from aos_agent import (   # noqa: E402
    DIRECT_SOURCE, create_team_world, create_world, load_pack, normalize_team_budget, now_iso,
    outbox_content, outbox_names, put_mail, read_json, resolve_home, spawn,
    status_of, team_add_budget, team_root_of, team_status_of, warn, write_json_atomic)


HERE = os.path.dirname(os.path.abspath(__file__))
TEMPLATES_DIR = os.path.join(HERE, "templates")
PRESETS_DIR = os.path.join(HERE, "presets")


def available_packs():
    try:
        names = os.listdir(os.path.join(HERE, "packs"))
    except OSError:
        return []
    return sorted(n[:-3] for n in names
                  if n.endswith(".py") and not n.startswith("_")
                  and os.path.isfile(os.path.join(HERE, "packs", n)))


def available_templates():
    try:
        names = os.listdir(TEMPLATES_DIR)
    except OSError:
        return []
    return sorted(n for n in names if os.path.isdir(os.path.join(TEMPLATES_DIR, n)))


def first_plain_line(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    return line
    except OSError:
        pass
    return "（沒有說明）"


def first_sentence(text):
    text = " ".join(str(text or "").split())
    if "。" in text:
        return text.split("。", 1)[0] + "。"
    return text or "（沒有說明）"


def do_templates(_args):
    names = available_templates()
    if not names:
        print("目前沒有模板。")
        return 0
    for name in names:
        desc = first_plain_line(os.path.join(TEMPLATES_DIR, name, "README.md"))
        print("%-10s %s" % (name, desc))
    return 0


def do_packs(_args):
    names = available_packs()
    if not names:
        print("目前沒有工具包。")
        return 0
    no_home = os.path.join(HERE, "__沒有這個本體__")
    for name in names:
        module = load_pack(no_home, name)
        desc = first_sentence(getattr(module, "PROMPT", "")) if module else "（載入失敗）"
        print("%-14s %s" % (name, desc))
    return 0


def strict_json(path, label):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except OSError as e:
        raise ValueError("讀不到%s：%s" % (label, e))
    except ValueError as e:
        raise ValueError("%s不是合法 JSON：%s" % (label, e))


def json_object(text, label):
    try:
        data = json.loads(text) if text else {}
    except ValueError as e:
        raise ValueError("%s不是合法 JSON：%s" % (label, e))
    if not isinstance(data, dict):
        raise ValueError("%s最外層要是 JSON 物件" % label)
    return data


def template_settings(name):
    if name not in available_templates():
        raise ValueError("不認得的模板：%s\n可用的模板：%s" %
                         (name, "、".join(available_templates()) or "（沒有）"))
    base = os.path.join(TEMPLATES_DIR, name)
    tools = strict_json(os.path.join(base, "tools.json"), "模板 tools.json")
    persona = strict_json(os.path.join(base, "system-prompt.json"), "模板 system-prompt.json")
    prompts = strict_json(os.path.join(base, "prompts.json"), "模板 prompts.json")
    llm = strict_json(os.path.join(base, "llm.json"), "模板 llm.json")
    if not isinstance(tools, dict) or not isinstance(persona, dict) \
            or not isinstance(prompts, list) or not isinstance(llm, dict):
        raise ValueError("模板的 JSON 形狀不對：" + name)
    return {"tools": tools, "persona": persona, "prompts": prompts, "llm": llm}


def parse_packs(text):
    names = [n.strip() for n in str(text).split(",") if n.strip()]
    unknown = [n for n in names if n not in available_packs()]
    if unknown:
        raise ValueError("認不得的工具包：%s\n可用的工具包：%s" %
                         ("、".join(unknown), "、".join(available_packs()) or "（沒有）"))
    return names


def ask(label, default):
    shown = default if str(default).strip() else "無"
    answer = input("%s [%s]：" % (label, shown)).strip()
    return answer if answer else default


def interactive_settings(args):
    print("來開一個新 agent。直接按 Enter 就用中括號裡的預設。")
    template = ask("模板", "chat")
    settings = template_settings(template)
    default_packs = ",".join(settings["tools"].get("packs") or [])
    packs = parse_packs(ask("工具包（逗號分隔）", default_packs))
    default_persona = settings["persona"].get("content") or ""
    persona = ask("人格一句話", default_persona)
    old_prompts = settings["prompts"]
    first_prompt = ""
    if old_prompts and isinstance(old_prompts[0], dict):
        first_prompt = old_prompts[0].get("content") or ""
    prompt = ask("起手指示", first_prompt)
    prompts = [{"role": "user", "content": prompt}] if prompt else []
    engine = ask("engine", settings["llm"].get("engine") or "")
    clock = "own" if ask("現在開鐘？y/n", "n").lower() in ("y", "yes") else "none"
    settings["tools"]["packs"] = packs
    settings["persona"] = {"role": "system", "content": persona}
    settings["prompts"] = prompts
    if engine:
        settings["llm"]["engine"] = engine
    else:
        settings["llm"].pop("engine", None)
    args.template, args.home, args.clock = template, "agent", clock
    print("\n將要建這些：")
    print("  世界：%s" % os.path.abspath(args.dir))
    print("  模板：%s" % template)
    print("  home：agent")
    print("  packs：%s" % ("、".join(packs) or "無"))
    print("  engine：%s" % (engine or "照 LLM 預設"))
    print("  鐘：%s" % ("現在開" if clock == "own" else "先不開"))
    if ask("確定建立？y/n", "y").lower() not in ("y", "yes"):
        print("取消了，沒有建立。")
        return None
    return settings


def configured_settings(args):
    settings = template_settings(args.template or "chat")
    if args.packs is not None:
        settings["tools"]["packs"] = parse_packs(args.packs)
    if args.persona is not None:
        settings["persona"] = {"role": "system", "content": args.persona}
    elif args.persona_file is not None:
        try:
            with open(args.persona_file, encoding="utf-8") as f:
                text = f.read().strip()
        except OSError as e:
            raise ValueError("讀不到人格檔：%s" % e)
        settings["persona"] = {"role": "system", "content": text}
    if args.prompts is not None:
        prompts = strict_json(args.prompts, "prompts 檔")
        if not isinstance(prompts, list):
            raise ValueError("prompts 檔最外層要是 JSON 陣列")
        settings["prompts"] = prompts
    if args.engine is not None:
        settings["llm"]["engine"] = args.engine
    if args.priority is not None:
        settings["llm"]["priority"] = args.priority
    return settings


def do_new(args):
    world = os.path.abspath(args.dir)
    if os.path.exists(world):
        warn("資料夾已經存在，不會蓋掉：" + world)
        return 2
    interactive = all(getattr(args, key) is None for key in
                      ("template", "packs", "persona", "persona_file", "prompts",
                       "engine", "priority", "home", "clock"))
    try:
        settings = interactive_settings(args) if interactive else configured_settings(args)
    except (ValueError, EOFError) as e:
        warn(str(e) if str(e) else "問答中斷了，沒有建立")
        return 2
    if settings is None:
        return 0
    home_arg = args.home or "agent"
    clock = args.clock or "none"
    try:
        home = create_world(world, home=home_arg, tools=settings["tools"],
                            persona=settings["persona"], prompts=settings["prompts"],
                            llm=settings["llm"])
    except (OSError, ValueError) as e:
        warn(str(e))
        return 2
    clock_text = "沒開"
    if clock == "own":
        if not os.environ.get("AOS_DAEMON_DIR"):
            warn("世界建好了，但沒設 AOS_DAEMON_DIR，所以沒有開鐘")
            clock_text = "沒開（沒設 AOS_DAEMON_DIR）"
        else:
            done = subprocess.run([os.path.join(HERE, "aos-daemon"), "register", world],
                                  capture_output=True, text=True)
            if done.returncode == 0:
                clock_text = "已開"
            else:
                warn("世界建好了，但開鐘失敗：" + (done.stderr or done.stdout).strip())
                clock_text = "沒開（register 失敗）"
    packs = settings["tools"].get("packs") or []
    engine = settings["llm"].get("engine") or "照 LLM 預設"
    print("建好了：" + world)
    print("home：" + home)
    print("packs：" + ("、".join(packs) or "無"))
    print("engine：" + str(engine))
    print("鐘：" + clock_text)
    if clock_text != "已開":
        print("下一步：aos-daemon register %s" % shlex.quote(world))
    print("聊天：aos-user talk %s" % shlex.quote(world))
    return 0


def _team_member(root, name):
    roster = read_json(os.path.join(root, "team", "team.json"), {})
    for member in roster.get("members", []) if isinstance(roster, dict) else []:
        if isinstance(member, dict) and member.get("name") == name:
            return os.path.abspath(os.path.join(root, member.get("path") or "."))
    return None


def _client_home(world, home_opt):
    """對工作室根說話或收聽時，甲方的窗口固定是 sales。"""
    if home_opt is None and team_root_of(world) == os.path.abspath(world):
        sales = _team_member(world, "sales")
        if sales:
            return resolve_home(sales, None)
    return resolve_home(world, home_opt)


def do_team_new(args):
    world = os.path.abspath(args.dir)
    preset_dir = os.path.join(PRESETS_DIR, args.preset)
    if not os.path.isdir(preset_dir):
        warn("不認得的整隊 preset：%s" % args.preset)
        return 2
    try:
        budget = json_object(args.budget, "--budget") if args.budget else None
        roster = create_team_world(world, preset_dir, args.engine, budget)
    except (OSError, ValueError) as e:
        warn(str(e))
        return 2
    opened, failed = [], []
    if os.environ.get("AOS_DAEMON_DIR"):
        for member in roster["members"]:
            if member.get("clock") != "own":
                continue
            target = os.path.abspath(os.path.join(world, member.get("path") or "."))
            done = subprocess.run([os.path.join(HERE, "aos-daemon"), "register", target],
                                  capture_output=True, text=True)
            (opened if done.returncode == 0 else failed).append(member["name"])
            if done.returncode != 0:
                warn("%s 的鐘沒開成：%s" %
                     (member["name"], (done.stderr or done.stdout).strip()))
    print("工作室建好了：" + world)
    print("成員：" + "、".join(m["name"] for m in roster["members"]))
    print("鐘：" + (("已開 " + "、".join(opened)) if opened else "沒開"))
    if failed:
        print("開鐘失敗：" + "、".join(failed))
    print("下單：aos-user order %s \"任務\"" % shlex.quote(world))
    return 0 if not failed else 1


def _short_budget(data):
    return "tokens=%s hours=%s ticks=%s money=%s" % (
        data.get("tokens"), data.get("hours"), data.get("ticks"), data.get("money_usd"))


def do_team_status(args):
    try:
        data = team_status_of(os.path.abspath(args.dir))
    except ValueError as e:
        warn(str(e))
        return 2
    print("工作室 %s（%s）" % (data["name"], data["day"]))
    print("NAME     ROLE      STATE    BUSY  UNREAD  INFLIGHT  TODAY TOKENS  TOKEN LEFT  BLOCKED")
    for row in data["members"]:
        flight = row.get("in_flight") or {}
        print("%-8s %-9s %-8s %5s %7s %9s %13s %11s  %s" % (
            row["name"], row["role"], row["state"], row["busy"], row["unread"],
            "%s+%s" % (flight.get("main", 0), flight.get("side", 0)),
            row["today_spent"]["tokens"], row["remaining"]["tokens"], row.get("blocked") or "-"))
    flight = data.get("in_flight") or {}
    print("在途：主線 %s 筆、旁線 %s 筆" % (flight.get("main", 0), flight.get("side", 0)))
    print("今天花費：" + _short_budget(data["spent"]))
    print("整隊剩餘：" + _short_budget(data["remaining"]))
    if data["spent"].get("mem_mb") is None:
        print("記憶體：未知（軟上限）")
    return 0


def do_team_budget(args):
    """看整隊預算；--add 是甲方追加（總額加上去、同一份給 --to 的人，預設 leader）。"""
    world = os.path.abspath(args.dir)
    try:
        if args.add:
            amount = json_object(args.add, "--add")
            book = team_add_budget(world, amount, args.to)
            print("已追加：" + json.dumps(amount, ensure_ascii=False) + "（給 %s）" % (
                args.to or "leader"))
            print("總額：" + _short_budget(book["total"]))
            return 0
        data = team_status_of(world, light=True)
    except (OSError, ValueError) as e:
        warn(str(e))
        return 2
    print("總額：" + _short_budget(data["budget"]))
    print("已花：" + _short_budget(data["spent"]))
    print("剩餘：" + _short_budget(data["remaining"]))
    print("NAME     TOKEN LIMIT   TOKEN USED   TOKEN LEFT  BLOCKED")
    for row in data["members"]:
        print("%-8s %11s %12s %12s  %s" % (
            row["name"], row["budget"].get("tokens"), row["today_spent"]["tokens"],
            row["remaining"]["tokens"], row.get("blocked") or "-"))
    return 0


def do_team_stop(args):
    root = team_root_of(os.path.abspath(args.dir))
    if not root:
        warn("找不到 team/team.json：" + os.path.abspath(args.dir))
        return 2
    path = os.path.join(root, "team", "team.json")
    roster = read_json(path, {})
    failed = []
    if os.environ.get("AOS_DAEMON_DIR"):
        for member in reversed(roster.get("members", [])):
            if not isinstance(member, dict) or member.get("clock") != "own":
                continue
            target = os.path.abspath(os.path.join(root, member.get("path") or "."))
            done = subprocess.run([os.path.join(HERE, "aos-daemon"), "unregister", target],
                                  capture_output=True, text=True)
            if done.returncode != 0 and "找不到這個時鐘" not in (done.stderr or done.stdout):
                failed.append(member.get("name") or target)
    for member in roster.get("members", []):
        if isinstance(member, dict):
            member["active"] = False
    write_json_atomic(path, roster)
    if failed:
        warn("這些鐘沒收乾淨：" + "、".join(failed))
        return 1
    print("整隊已停；檔案、記憶和帳都留著：" + root)
    return 0


def do_order(args):
    root = team_root_of(os.path.abspath(args.dir))
    if not root:
        warn("這不是工作室：" + os.path.abspath(args.dir))
        return 2
    sales = _team_member(root, "sales")
    if not sales:
        warn("名冊裡沒有 sales")
        return 2
    try:
        budget = json_object(args.budget, "--budget") if args.budget else {}
        # order 可只給這張單在意的欄位，不替甲方偷偷補一串數字。
        normalize_team_budget({}, budget)
    except ValueError as e:
        warn(str(e))
        return 2
    order_id = "order-" + time.strftime("%Y%m%d-%H%M%S") + ("-%06d" % (time.time_ns() % 1000000))
    body = {"order": args.task, "budget": budget,
            "acceptance": list(args.accept or []), "out_of_scope": []}
    content = json.dumps(body, ensure_ascii=False, separators=(",", ":"))
    home = resolve_home(sales, None)
    box = os.path.join(home, "inbox", DIRECT_SOURCE)
    letter = {"from": "user", "to": "sales", "time": now_iso(), "order_id": order_id,
              "content": content, **body}
    path = os.path.join(box, order_id + ".json")
    write_json_atomic(path, letter)
    user_dir = os.environ.get("AOS_USER_DIR")
    if user_dir:
        write_json_atomic(os.path.join(os.path.abspath(user_dir), "outbox", order_id + ".json"), letter)
    print("訂單已送 sales：%s" % order_id)
    return 0


def show(box, name):
    msg = read_json(os.path.join(box, name), {})
    if isinstance(msg, dict) and msg.get("error"):
        print("agent!> " + (msg.get("content") or ""))
        print()
        sys.stdout.flush()
        return
    print("--- reply %s ---" % os.path.splitext(name)[0])
    print(outbox_content(box, name))
    print()
    sys.stdout.flush()


def do_say(args):
    world = os.path.abspath(args.dir)
    home = _client_home(world, args.home)
    text = args.text if args.text is not None else sys.stdin.read()
    warn("寫了 " + put_mail(home, DIRECT_SOURCE, text, DIRECT_SOURCE))
    return 0


def do_listen(args):
    world = os.path.abspath(args.dir)
    box = os.path.join(_client_home(world, args.home), "outbox")
    seen = set(outbox_names(box))
    if not args.new:
        for name in sorted(seen):
            show(box, name)
        if args.once:
            return 0
    try:
        while True:
            fresh = [n for n in outbox_names(box) if n not in seen]
            for name in fresh:
                show(box, name)
                seen.add(name)
            if fresh and args.once:
                return 0
            time.sleep(0.5)
    except KeyboardInterrupt:
        return 0


def do_talk(args):
    world = os.path.abspath(args.dir)
    home = _client_home(world, args.home)
    box = os.path.join(home, "outbox")
    print("（另一個終端機要跑 aos-loop 這個資料夾，不然沒人會回話）")
    while True:
        try:
            line = input("你> ")
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if line.strip() == "/quit":
            return 0
        if not line.strip():
            continue
        before = set(outbox_names(box))
        put_mail(home, DIRECT_SOURCE, line, DIRECT_SOURCE)
        try:
            while True:
                fresh = [n for n in outbox_names(box) if n not in before]
                if fresh:
                    for name in fresh:
                        msg = read_json(os.path.join(box, name), {})
                        prefix = "agent!> " if isinstance(msg, dict) and msg.get("error") else "agent> "
                        print(prefix + outbox_content(box, name))
                        sys.stdout.flush()
                    break
                time.sleep(0.5)
        except KeyboardInterrupt:
            print("\n（不等了，可以繼續打）")


def do_status(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    print(json.dumps(status_of(world, home), ensure_ascii=False, indent=2))
    return 0


def do_spawn(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    ok, msg = spawn(world, home, args.name, args.persona, args.clock, args.template)
    warn(msg)
    return 0 if ok else 2


def main():
    ap = argparse.ArgumentParser(prog="aos-user")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("new", help="用模板開一個新 agent")
    p.add_argument("dir")
    p.add_argument("--template", default=None)
    p.add_argument("--packs", default=None, metavar="包1,包2")
    who = p.add_mutually_exclusive_group()
    who.add_argument("--persona", default=None)
    who.add_argument("--persona-file", default=None, metavar="路徑")
    p.add_argument("--prompts", default=None, metavar="路徑.json")
    p.add_argument("--engine", default=None)
    p.add_argument("--priority", type=int, default=None)
    p.add_argument("--home", default=None, metavar="子路徑")
    p.add_argument("--clock", choices=["own", "none"], default=None)
    p.set_defaults(fn=do_new)
    sub.add_parser("templates", help="列出可用模板").set_defaults(fn=do_templates)
    sub.add_parser("packs", help="列出可用工具包").set_defaults(fn=do_packs)

    team = sub.add_parser("team", help="一次建立、查看或停止整隊").add_subparsers(dest="team_cmd")
    p = team.add_parser("new")
    p.add_argument("dir")
    p.add_argument("--preset", default="studio")
    p.add_argument("--engine", default=None)
    p.add_argument("--budget", default=None)
    p.set_defaults(fn=do_team_new)
    p = team.add_parser("status")
    p.add_argument("dir")
    p.set_defaults(fn=do_team_status)
    p = team.add_parser("budget", help="看整隊預算；--add 追加")
    p.add_argument("dir")
    p.add_argument("--add", default=None, help='追加的量，JSON，例如 \'{"tokens": 100000}\'')
    p.add_argument("--to", default=None, help="追加的份給誰（預設 leader）")
    p.set_defaults(fn=do_team_budget)
    p = team.add_parser("stop")
    p.add_argument("dir")
    p.set_defaults(fn=do_team_stop)

    p = sub.add_parser("order", help="把訂單交給工作室 sales")
    p.add_argument("dir")
    p.add_argument("task")
    p.add_argument("--budget", default=None)
    p.add_argument("--accept", action="append", default=[])
    p.set_defaults(fn=do_order)

    def world_args(p):
        p.add_argument("dir", nargs="?", default=".")
        p.add_argument("--home", default=None)
        return p

    p = world_args(sub.add_parser("say"))
    p.add_argument("text", nargs="?", default=None)
    p.set_defaults(fn=do_say)
    p = world_args(sub.add_parser("listen"))
    p.add_argument("--new", action="store_true")
    p.add_argument("--once", action="store_true")
    p.set_defaults(fn=do_listen)
    world_args(sub.add_parser("talk")).set_defaults(fn=do_talk)
    world_args(sub.add_parser("status")).set_defaults(fn=do_status)
    # spawn 的世界是必填的（三個位置參數都必填，argparse 才允許 --clock 跟它們交錯）
    p = sub.add_parser("spawn")
    p.add_argument("dir")
    p.add_argument("--home", default=None)
    p.add_argument("name")
    p.add_argument("persona")
    p.add_argument("--clock", choices=["shared", "own"], default="shared")
    p.add_argument("--template", default=None)
    p.set_defaults(fn=do_spawn)

    # Python 3.12 的 argparse：`say <dir> --home agent <text>` 這種「位置、選項、再位置」的順序，
    # nargs="?" 的 text 會被吃成空、原字掉進 extras（3.13 才修）。只有 say 有這個形狀，這裡補回去。
    args, extras = ap.parse_known_args()
    if extras and getattr(args, "fn", None) is do_say and args.text is None and len(extras) == 1:
        args.text = extras[0]
    elif extras:
        ap.error("unrecognized arguments: %s" % " ".join(extras))
    if not getattr(args, "fn", None):
        ap.print_help(sys.stderr)
        return 2
    return args.fn(args)


sys.exit(main())
