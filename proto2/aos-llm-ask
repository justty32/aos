#!/usr/bin/env python3
"""aos-llm-ask [dir] [--no-wait] — 從 stdin 丟一個請求給某個 LLM 資料夾，然後等回覆。

現在只是 `aos-llm send - --llm <dir> --timeout 0` 的一層薄殼（留著是因為順手、
也因為 README 一路都這樣寫）。行為跟以前一樣：整包 body 從 stdin 進來，丟進
requests/，等 results/ 冒出同名檔就整包印到 stdout 並把結果檔刪掉；--no-wait
只丟不等，把檔名印出來就走；Ctrl-C 退 130。唯一的差別是結果裡有 error 會退 1。
"""
import os
import sys

args = sys.argv[1:]
no_wait = "--no-wait" in args
rest = [a for a in args if a != "--no-wait"]
where = rest[0] if rest else "."

cmd = [sys.executable,
       os.path.join(os.path.dirname(os.path.abspath(__file__)), "aos-llm"),
       "send", "-", "--llm", where, "--timeout", "0"]
if no_wait:
    cmd.append("--no-wait")
os.execv(sys.executable, cmd)
