#!/usr/bin/env python3
"""aos-daemon-unregister <daemon 資料夾> <名字> — 把一個登記從登記表拿掉。

刪掉 <daemon>/.aos/daemon/registry/<名字>.json，沒有這個登記就印一句退 2。
被登記的資料夾本身不動，只是 daemon 以後不再推它。
"""
import argparse
import os
import sys


def die(msg):
    print("aos-daemon-unregister: " + msg, file=sys.stderr)
    sys.exit(2)


def main():
    ap = argparse.ArgumentParser(prog="aos-daemon-unregister")
    ap.add_argument("daemon")
    ap.add_argument("name")
    args = ap.parse_args()

    path = os.path.join(os.path.abspath(args.daemon), ".aos", "daemon", "registry",
                        args.name + ".json")
    if not os.path.isfile(path):
        die("沒有這個登記：" + path)
    os.remove(path)
    print("aos-daemon-unregister: 取消登記 %s" % args.name, file=sys.stderr)
    sys.exit(0)


main()
