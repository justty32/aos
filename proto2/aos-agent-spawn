#!/usr/bin/env python3
"""aos-agent-spawn <父資料夾> <子名> <人格文字> [--clock shared|own] — 生一個子 agent。

子 agent 就是父資料夾底下的一個子資料夾，裡面有自己完整的 .aos/agent/。
兩種鐘：
  shared（預設，時間沒脫節）——在父的 .aos/inst 尾端加一行 `aos-exec <子名>`，
    父走一格就順手推子走一格，子自己沒有 loop。
  own（時間脫節）——資料夾建起來以後，順手 `aos-daemon register <子路徑> --no-wait`，
    請 daemon 幫它開一個自己的時鐘。

子的 llm.json 指到跟父同一個 LLM 資料夾：把父 llm.json 的 dir 解成絕對路徑，
再換算成相對於子資料夾的相對路徑（父是 ../llm，子就會是 ../../llm）。
父沒有 llm.json 就不生，退 2——沒有 LLM 的 agent 走不動。

own 的子生完會呼叫隔壁的 `aos-daemon register <子路徑> --no-wait`（daemon 目錄看
環境變數 AOS_DAEMON_DIR），一生出來就有人推。沒設 AOS_DAEMON_DIR 就印一句
「子建好了，但沒跟 daemon 要時鐘」，退出碼還是 0——資料夾是真的生出來了。
shared 不用要時鐘——父走一格它就走一格了。
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys

NAME_OK = re.compile(r"^[A-Za-z0-9_-]+$")
INST_LINE = "aos-agent-step . --no-write-inst"


def die(msg):
    print("aos-agent-spawn: " + msg, file=sys.stderr)
    sys.exit(2)


def read_json(path, default):
    if not os.path.isfile(path):
        return default
    with open(path, encoding="utf-8") as f:
        text = f.read().strip()
    return json.loads(text) if text else default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
        f.write("\n")


def append_line(path, line):
    """在檔尾加一行；已經有這一行就不加。結尾沒換行先補一個。"""
    old = ""
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as f:
            old = f.read()
    if line in [l.strip() for l in old.splitlines()]:
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        if old and not old.endswith("\n"):
            old += "\n"
        f.write(old + line + "\n")
    return True


def main():
    ap = argparse.ArgumentParser(prog="aos-agent-spawn")
    ap.add_argument("parent")
    ap.add_argument("name")
    ap.add_argument("persona")
    ap.add_argument("--clock", choices=["shared", "own"], default="shared")
    args = ap.parse_args()

    if not NAME_OK.match(args.name):
        die("子名只能用英數字、底線、減號：" + args.name)
    parent = os.path.abspath(args.parent)
    if not os.path.isdir(parent):
        die("找不到父資料夾：" + parent)
    child = os.path.join(parent, args.name)
    if os.path.exists(child):
        die("這個名字已經被佔走了：" + child)

    parent_home = os.path.join(parent, ".aos", "agent")
    parent_llm = os.path.join(parent_home, "llm.json")
    if not os.path.isfile(parent_llm):
        die("父沒有 .aos/agent/llm.json，不知道 LLM 在哪，生不出子 agent：" + parent_llm)
    where = read_json(parent_llm, {}).get("dir") or "../llm"
    llm_abs = os.path.abspath(os.path.join(parent, where))

    home = os.path.join(child, ".aos", "agent")
    os.makedirs(home)
    write_json(os.path.join(home, "system-prompt.json"), {"content": args.persona})
    write_json(os.path.join(home, "prompts.json"), [])
    write_json(os.path.join(home, "tools.json"),
               read_json(os.path.join(parent_home, "tools.json"), []))
    write_json(os.path.join(home, "state.json"), {"state": "idle", "step": 0, "busy": 0, "request": ""})
    write_json(os.path.join(home, "llm.json"), {"dir": os.path.relpath(llm_abs, child)})

    with open(os.path.join(child, ".aos", "inst"), "w", encoding="utf-8") as f:
        f.write(INST_LINE + "\n")

    src = os.path.join(parent, ".gitignore")
    if not os.path.isfile(src):
        src = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])),
                           "examples", "agent", ".gitignore")
    if os.path.isfile(src):
        shutil.copyfile(src, os.path.join(child, ".gitignore"))

    if args.clock == "shared":
        append_line(os.path.join(parent, ".aos", "inst"), "aos-exec " + args.name)
        print("aos-agent-spawn: %s 建好了（shared，父走一格它走一格）" % child, file=sys.stderr)
    elif os.environ.get("AOS_DAEMON_DIR"):
        daemon = os.path.join(os.path.dirname(os.path.abspath(sys.argv[0])), "aos-daemon")
        rc = subprocess.run([daemon, "register", child, "--no-wait"]).returncode
        if rc == 0:
            print("aos-agent-spawn: %s 建好了（own，已經跟 daemon 要了一個時鐘）" % child,
                  file=sys.stderr)
        else:
            print("aos-agent-spawn: %s 建好了（own），但跟 daemon 要時鐘失敗（退出碼 %d），"
                  "要自己開 aos-loop %s --keep-inst 它才會走" % (child, rc, child),
                  file=sys.stderr)
    else:
        print("aos-agent-spawn: %s 建好了（own），但沒設 AOS_DAEMON_DIR，沒跟 daemon 要時鐘，"
              "要自己開 aos-loop %s --keep-inst 它才會走" % (child, child), file=sys.stderr)
    sys.exit(0)


main()
