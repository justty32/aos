#!/usr/bin/env python3
"""aos-llm <exec|usage|ls> — 一個「LLM 資料夾」的派工員。

LLM 不是誰的私有功能，是一個跟 agent 平起平坐的資料夾，也靠 `aos-loop` 一格一格轉。
資料夾是**平鋪**的，東西直接放在 `<dir>` 底下（`.aos/` 裡只有一句 `inst`）：

    .aos/inst           `aos-llm exec .`
    engines.json        引擎清單（陣列，第一個是預設）
    defaults.json       這個資料夾自己的預設 {"engine": ..., "priority": ...}，可有可無
    requests/           排隊中的請求 <名字>.json
    requests/running/   正在打的（多一個 "aos" 欄位記 pid／engine／priority／started）
                        worker 做完另留 <名字>.json.done，免得結果先被拿走時誤判死亡
    requests/done/      做完的（成功、失敗、壞掉的都在這）
    results/            回覆 <跟請求同檔名>
    usage/pending/      每個 worker 做完丟一張用量小紙條
    usage/<YYYY-MM-DD>.json  當天的帳本
    logs/<名字>.log     那個 worker 的輸出
    state.json          {"tick", "served", "errors"}

**有沒有 engines.json 就是「這是不是一個 LLM 資料夾」**。

請求檔是一個 JSON 物件。aos 自己吃四個鍵：`priority`（舊數字或排程物件）、`requester`
（誰丟的）、`engine`（引擎名字）、`params`（一包蓋在引擎 params 上的參數）。
**沒寫 priority／engine 就用
這個資料夾自己的預設**：defaults.json 說了算，它沒說就是 engines.json 第一台＋priority 0。
**其他所有頂層鍵都原樣當成 chat/completions 的 body 欄位**（messages、tools、temperature…）。
實際送出去的 body ＝ 引擎 params ← 請求 params ← 請求其他頂層鍵，model 一律引擎說了算。

引擎可以寫 `"max_concurrent": N`（不寫＝1）：**那台一次最多同時跑幾個請求**。
例如 deepseek 開 2、本機 LM Studio 開 1，四個請求進來就是三個開跑、一個排著。
引擎也可以寫 `"strip_think": false`（不寫＝true）：預設會把 qwen 那種漏進 `content` 的
`<think>…</think>` 切掉（只留最後一個 `</think>` 之後的東西），這是 LLM 這一側的家務，
撿結果的人不用自己處理；`reasoning_content` 這種供應商私有欄位原樣不動。
引擎還可以寫 `"api": "anthropic"`（不寫＝openai）：**直接打 Anthropic 的 /v1/messages**，
不必架 LiteLLM 之類的轉接器。外面的人（aos-agent、帳本、packs）永遠只看得到 OpenAI 的
chat/completions 形狀，一進一出兩邊都在 worker 裡翻（見 to_anthropic／from_anthropic）。
`"api": "claude-cli"` 則是**把 Claude Code 的 headless 模式當引擎**：開一個 `claude -p` 子進程、
對話從 stdin 餵、工具用一台只登記不執行的 MCP（aos-mcp-tools）掛上去、只讓它跑一個回合，
再從 stream-json 撿回那一輪的 tool_use（給有訂閱、沒 API key 的人用，見 call_claude_cli）。

  aos-llm exec [dir]
      **每一格做的事**，不給 dir 就是目前目錄。一格很短，**絕對不等網路**：
      1. tick 加一。
      2. 把 usage/pending/ 的小紙條折進當天帳本，紙條刪掉。
      3. 巡 requests/running/：完成標記或結果出現了就把請求搬去 done/（served／errors
         在這裡算）；pid 死了、又沒有完成標記和結果，才補一個 "worker died" 的錯誤結果、
         也補一張 errors=1 的用量紙條。剩下的算進「那台引擎正在跑幾個」。
      4. 讀 requests/ 頂層，照期限、分數、mtime、檔名排。每開一筆就重算：那台引擎
         `running < max_concurrent` 就開一個背景 worker、請求搬進 running/；滿了的
         留在隊伍裡等下一格。一格能開幾個就開幾個。
      5. 印一行摘要到 stderr，外加每個 launch／done／died 各一行。
      **所以結果是「丟了之後過幾格才回來」**，不是同一格。
  aos-llm worker <dir> <請求檔名>
      內部用：真正去打那一發 HTTP 的背景進程。人不用自己叫。
  aos-llm usage [YYYY-MM-DD] [--by model|requester]
      印那天的模型與 requester 用量表（預設今天、兩張都印）。帳本是拿來算錢的，
      模型回了哪些數字就有哪些欄（思考 token、快取命中都在內）。
  aos-llm ls
      印**執行中**（running/，帶 engine／pid／已經跑多久）跟**排隊中**（下一格會被派的
      順序），最後一行一台引擎印 `engine X: running r/max`。請求沒寫 priority／engine 的，
      印的是資料夾預設幫它補的值，後面加一個 `*`。

usage／ls 的資料夾：`--dir <dir>`，沒給就看環境變數 AOS_LLM_DIR，都沒有就退 2。
"""
import argparse
import datetime
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import aos_llm as lib   # noqa: E402  （同一個資料夾裡的小幫手，共用路徑與原子寫）

HERE = os.path.dirname(os.path.abspath(sys.argv[0]))
AOS_KEYS = ("priority", "requester", "engine", "params", "aos")
TIMEOUT = 300
CONNECT_TIMEOUT = 10   # 先探一下 TCP 連不連得上；WSL 對關掉的埠會吞 SYN，不探就要等滿 300 秒
FIRST_COLS = ("requests", "errors", "took_ms")
COL_LABEL = {"requests": "請求", "errors": "錯誤", "took_ms": "毫秒"}
KIND_SCORE = {"chat": 40, "tool": 20, "think": 0, "background": -40}
COST_SCORE = {"cheap": 0, "normal": 10, "expensive": 30}


def die(msg, code=2):
    print("aos-llm: " + msg, file=sys.stderr)
    sys.exit(code)


def home_of(args):
    """usage／ls 用：--dir → AOS_LLM_DIR → 退 2。"""
    where = getattr(args, "dir", "") or os.environ.get("AOS_LLM_DIR") or ""
    if not where:
        die("沒給 LLM 目錄，也沒設 AOS_LLM_DIR")
    return lib.home_of(where)


# ── 引擎與預設 ──────────────────────────────────────────────────────────────

def load_engines(home):
    """引擎清單：engines.json，一個陣列，第一個是預設。"""
    engines = lib.read_json(os.path.join(home, "engines.json"), None)
    if not isinstance(engines, list):
        return []
    return [e for e in engines if isinstance(e, dict)]


def load_defaults(home, engines):
    """這個資料夾自己的預設：defaults.json ← engines.json 第一台／priority 0。"""
    conf = lib.read_json(os.path.join(home, "defaults.json"), {})
    if not isinstance(conf, dict):
        conf = {}
    engine = conf.get("engine") or (engines[0].get("name") if engines else "") or ""
    priority = conf.get("priority", 0)
    if not isinstance(priority, (int, float, dict)) or isinstance(priority, bool):
        priority = 0
    return engine, priority


def resolve(req, defaults):
    """請求沒寫 priority／engine 就補上資料夾的預設，回 (engine, 原始 priority)。"""
    d_engine, d_priority = defaults
    priority = req.get("priority", d_priority)
    if not isinstance(priority, (int, float, dict)) or isinstance(priority, bool):
        priority = d_priority
    return (req.get("engine") or d_engine), priority


def number(value, default=0):
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def requester_from_name(name):
    """請求沒 requester 時的最後備援：拿檔名前綴。"""
    stem = name[:-5] if name.endswith(".json") else name
    bits = stem.rsplit("-", 3)
    if len(bits) == 4 and bits[-3].isdigit() and bits[-2].isdigit() and bits[-1].isdigit():
        return bits[0] or "unknown"
    return stem or "unknown"


def requester_group(requester):
    return str(requester or "unknown").split("/", 1)[0] or "unknown"


def deadline_is_late(value, now):
    if not isinstance(value, str) or not value:
        return False
    try:
        text = value[:-1] + "+00:00" if value.endswith("Z") else value
        deadline = datetime.datetime.fromisoformat(text)
        if deadline.tzinfo is None:
            return False
        return deadline.timestamp() <= now
    except (TypeError, ValueError, OverflowError):
        return False


def priority_info(req, defaults, engine, name, mtime, recent, now=None):
    """把舊數字／新物件算成這一格的分數、排序鍵與短理由。"""
    now = time.time() if now is None else now
    _, raw = resolve(req, defaults)
    d_raw = defaults[1]
    base = dict(d_raw) if isinstance(d_raw, dict) else {}
    data = dict(base)
    if isinstance(raw, dict):
        for key in ("level", "deadline", "kind", "requester"):
            if key in raw:
                data[key] = raw[key]
    else:
        data["level"] = raw

    level = number(data.get("level"), 0)
    kind = str(data.get("kind") or "chat")
    kind_points = KIND_SCORE.get(kind, 0)
    requester = str(data.get("requester") or req.get("requester")
                    or requester_from_name(name) or "unknown")

    default_boost = max(0, number(base.get("age_boost"), 1))
    asked_boost = number(raw.get("age_boost"), default_boost) if isinstance(raw, dict) else default_boost
    age_boost = min(default_boost, max(0, asked_boost))
    wait_minutes = max(0, int((now - mtime) // 60))
    wait_points = min(300, wait_minutes * age_boost)

    cost_class = str((engine or {}).get("cost_class") or base.get("cost_class") or "normal")
    if cost_class not in COST_SCORE:
        cost_class = "normal"
    cost_points = COST_SCORE[cost_class]
    recent_points = sum(1 for group in recent if group == requester_group(requester)) * 25
    score = level * 100 + kind_points + wait_points - cost_points - recent_points
    late = deadline_is_late(data.get("deadline"), now)
    reason = "score=%d level=%d %s %+d wait=%d %s=-%d recent=-%d requester=%s" % (
        score, level, kind, kind_points, wait_points, cost_class, cost_points,
        recent_points, requester)
    if late:
        reason += " deadline=late"
    return {"raw": raw, "level": level, "kind": kind, "requester": requester,
            "group": requester_group(requester), "score": score, "late": late,
            "reason": reason}


def rank_key(item):
    """過期先行；再照分數高、mtime 早、檔名小。"""
    return (0 if item[3]["late"] else 1, -item[3]["score"], item[1], item[0])


def pick_engine(engines, name):
    for e in engines:
        if e.get("name") == name:
            return e
    return None


def max_concurrent(engine):
    """那台引擎一次最多同時跑幾個；沒寫＝1，寫壞了也當 1。"""
    try:
        n = int(engine.get("max_concurrent") or 1)
    except (TypeError, ValueError):
        n = 1
    return max(1, n)


# ── 用量 ────────────────────────────────────────────────────────────────────

def flatten_numbers(obj, prefix=""):
    """把一包 usage 攤成 {點號鍵: 數字}——巢狀字典往下走，非數字（含 bool）丟掉。"""
    out = {}
    if not isinstance(obj, dict):
        return out
    for key, value in obj.items():
        name = prefix + str(key)
        if isinstance(value, dict):
            out.update(flatten_numbers(value, name + "."))
        elif isinstance(value, bool):
            continue
        elif isinstance(value, (int, float)):
            out[name] = value
    return out


def add(row, field, more):
    old = row.get(field)
    old = old if isinstance(old, (int, float)) and not isinstance(old, bool) else 0
    total = old + more
    return int(total) if float(total).is_integer() else total


def fold_pending(home):
    """把 usage/pending/ 的小紙條折進當天帳本，紙條刪掉，回折了幾張。

    帳本是拿來算錢的，所以模型回的 usage 裡**每個數字都累加**（巢狀攤成點號鍵，例如
    completion_tokens_details.reasoning_tokens），外加我們自己數的 requests／errors／took_ms。
    紙條上寫著那個 worker **做完那天**的日期，所以跨午夜也記在對的那一天。
    """
    box = os.path.join(home, "usage", "pending")
    if not os.path.isdir(box):
        return 0
    names = sorted(n for n in os.listdir(box)
                   if n.endswith(".json") and os.path.isfile(os.path.join(box, n)))
    if not names:
        return 0
    books, used = {}, []
    for name in names:
        path = os.path.join(box, name)
        rec = lib.read_json(path, None)
        used.append(path)
        if not isinstance(rec, dict):
            continue
        day = str(rec.get("day") or datetime.date.today().isoformat())
        if day not in books:
            old = lib.read_json(os.path.join(home, "usage", day + ".json"), {})
            old = old if isinstance(old, dict) else {}
            if "by-model" in old or "by-requester" in old:
                by_model = old.get("by-model") if isinstance(old.get("by-model"), dict) else {}
                by_requester = old.get("by-requester") if isinstance(old.get("by-requester"), dict) else {}
            else:
                by_model, by_requester = old, {}
            books[day] = {"by-model": dict(by_model), "by-requester": dict(by_requester)}
        book = books[day]
        key = str(rec.get("key") or "|")
        requester = str(rec.get("requester") or "unknown")
        try:
            took = int(rec.get("took_ms") or 0)
        except (TypeError, ValueError):
            took = 0
        for section, row_key in (("by-model", key), ("by-requester", requester)):
            rows = book[section]
            row = rows.get(row_key)
            row = dict(row) if isinstance(row, dict) else {}
            for field, more in flatten_numbers(rec.get("usage")).items():
                row[field] = add(row, field, more)
            row["requests"] = add(row, "requests", 1)
            row["errors"] = add(row, "errors", 1 if rec.get("error") else 0)
            row["took_ms"] = add(row, "took_ms", took)
            rows[row_key] = row
    for day, book in books.items():
        lib.write_json(os.path.join(home, "usage", day + ".json"), book)
    for path in used:
        try:
            os.remove(path)
        except OSError:
            pass
    return len(used)


def write_pending(home, name, key, usage, error, took_ms, requester="unknown", day=None):
    """一張用量小紙條——worker 做完寫一張，下一格被 exec 折進帳本。"""
    lib.write_json_atomic(os.path.join(home, "usage", "pending", name), {
        "day": day or datetime.date.today().isoformat(),
        "key": key, "requester": requester or "unknown",
        "usage": usage if isinstance(usage, dict) else {},
        "error": bool(error), "took_ms": int(took_ms),
    })


# ── 隊伍 ────────────────────────────────────────────────────────────────────

def queue(box):
    """requests/ 頂層的 .json，回 [(檔名, mtime)]（子資料夾 running/、done/ 不算）。"""
    out = []
    if not os.path.isdir(box):
        return out
    for name in sorted(os.listdir(box)):
        path = os.path.join(box, name)
        if name.endswith(".json") and os.path.isfile(path):
            out.append((name, os.path.getmtime(path)))
    return out


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(int(pid), 0)
    except OSError:
        return False
    return True


def reap(pid):
    """是自己的小孩就順手收屍；不是（跨 tick 的 worker 早就被 init 收了）就算了。"""
    try:
        os.waitpid(int(pid), os.WNOHANG)
    except (OSError, ValueError):
        pass


def finish_now(home, name, result):
    """當場了結一個還在 requests/ 頂層的請求：寫結果、把請求搬去 done/。"""
    lib.write_json_atomic(os.path.join(home, "results", name), result)
    box = os.path.join(home, "requests")
    done = os.path.join(box, "done")
    os.makedirs(done, exist_ok=True)
    os.replace(os.path.join(box, name), os.path.join(done, name))


# ── exec：每一格 ────────────────────────────────────────────────────────────

def spawn_worker(home, world, name):
    """開一個背景 worker 去打那一發；回 (True, pid) 或 (False, 訊息)。"""
    logs = os.path.join(home, "logs")
    os.makedirs(logs, exist_ok=True)
    env = dict(os.environ)
    env["PATH"] = HERE + os.pathsep + env.get("PATH", "")
    cmd = [sys.executable, os.path.abspath(sys.argv[0]), "worker", world, name]
    try:
        out = open(os.path.join(logs, name + ".log"), "ab")
        with open(os.devnull, "rb") as devnull:
            p = subprocess.Popen(cmd, cwd=world, env=env, stdin=devnull,
                                 stdout=out, stderr=out, start_new_session=True)
        out.close()
    except OSError as e:
        return False, "開不起 worker：%s" % e
    return True, p.pid


def do_exec(args):
    home = lib.home_of(args.dir)
    if not os.path.isfile(os.path.join(home, "engines.json")):
        print("aos-llm exec: %s 不是一個 LLM 資料夾（沒有 engines.json）" % args.dir,
              file=sys.stderr)
        return 1
    box = os.path.join(home, "requests")
    running_box = os.path.join(box, "running")
    done_box = os.path.join(box, "done")

    state = lib.read_json(os.path.join(home, "state.json"), {})
    if not isinstance(state, dict):
        state = {}
    tick = int(state.get("tick") or 0) + 1
    served = int(state.get("served") or 0)
    errors = int(state.get("errors") or 0)

    def say(line):
        print("aos-llm exec: " + line, file=sys.stderr)

    # 2. 先把上幾格 worker 留下的用量紙條折進帳本
    fold_pending(home)

    # 3. 巡一遍正在跑的：worker 的完成標記才是正規交棒；相容舊 worker 的結果檔。
    #    只有 pid、標記、結果三個都不在，才算死在半路。
    engines = load_engines(home)
    defaults = load_defaults(home, engines)
    running = {}          # engine 名字 → 現在跑幾個
    died = 0
    if os.path.isdir(running_box):
        for name in sorted(os.listdir(running_box)):
            src = os.path.join(running_box, name)
            if not (name.endswith(".json") and os.path.isfile(src)):
                continue
            rec = lib.read_json(src, {})
            rec = rec if isinstance(rec, dict) else {}
            aos = rec.get("aos") if isinstance(rec.get("aos"), dict) else {}
            pid = aos.get("pid") or 0
            result_path = os.path.join(home, "results", name)
            marker_path = src + ".done"
            marker = lib.read_json(marker_path, None)
            has_marker = os.path.isfile(marker_path)
            has_result = os.path.isfile(result_path)
            reap(pid)
            # 正常 worker 先寫結果、用量紙條，最後才寫完成標記。看到結果但 worker 還活著時
            # 先不搶著收，避免 worker 隨後留下孤零零的標記。
            if not has_marker and alive(pid):
                who = aos.get("engine") or ""
                running[who] = running.get(who, 0) + 1
                continue
            if has_marker or has_result:
                reap(pid)
                answer = lib.read_json(result_path, {}) if has_result else {}
                answer = answer if isinstance(answer, dict) else {}
                marker = marker if isinstance(marker, dict) else {}
                ok = not (answer.get("error") if has_result else marker.get("error"))
                ans_aos = answer.get("aos") if isinstance(answer.get("aos"), dict) else {}
                use = ans_aos.get("usage") if isinstance(ans_aos.get("usage"), dict) else {}
                if not use and isinstance(marker.get("usage"), dict):
                    use = marker["usage"]
                took_ms = ans_aos.get("took_ms") if ans_aos else marker.get("took_ms")
                os.makedirs(done_box, exist_ok=True)
                os.replace(src, os.path.join(done_box, name))
                if has_marker:
                    try:
                        os.remove(marker_path)
                    except OSError:
                        pass
                if ok:
                    served += 1
                else:
                    errors += 1
                say("done %s %s tokens=%s took=%sms"
                    % (name, "ok" if ok else "error",
                       use.get("total_tokens") or 0, took_ms or 0))
                continue
            # 進程不見了、又沒標記也沒結果：補一個錯誤結果，免得有人等到天荒地老
            lib.write_json_atomic(result_path, {"error": "worker died", "aos": aos})
            os.makedirs(done_box, exist_ok=True)
            os.replace(src, os.path.join(done_box, name))
            engine = pick_engine(engines, aos.get("engine") or "") or {}
            write_pending(home, name, "%s|%s" % (engine.get("base_url") or "",
                                                 engine.get("model") or ""),
                          {}, True, 0, aos.get("requester") or requester_from_name(name))
            errors += 1
            died += 1
            say("died %s" % name)
    if died:
        fold_pending(home)   # 剛補的錯誤也當格入帳，不用再等一格

    # 4. 每開一筆就更新近期開工並重算；滿載的引擎跳過，不擋別台
    todo = []
    for name, mtime in queue(box):
        with open(os.path.join(box, name), encoding="utf-8", errors="replace") as f:
            text = f.read()
        try:
            req = json.loads(text)
            if not isinstance(req, dict):
                raise ValueError("請求要是一個 JSON 物件")
        except ValueError as e:
            finish_now(home, name, {"error": "請求讀不成 JSON：%s" % e})
            errors += 1
            say("bad-json %s" % name)
            continue
        todo.append((name, mtime, req))

    recent = state.get("recent") if isinstance(state.get("recent"), list) else []
    recent = [str(x) for x in recent[-10:]]
    launched = 0
    while todo:
        ranked = []
        now = time.time()
        for name, mtime, req in todo:
            want, priority = resolve(req, defaults)
            engine = pick_engine(engines, want) if want else None
            ranked.append((name, mtime, req,
                           priority_info(req, defaults, engine, name, mtime, recent, now),
                           want, engine))
        ranked.sort(key=rank_key)

        chosen = None
        for item in ranked:
            want, engine = item[4], item[5]
            if engine is None or running.get(want, 0) < max_concurrent(engine):
                chosen = item
                break
        if chosen is None:
            break
        name, mtime, req, info, want, engine = chosen
        todo.remove((name, mtime, req))
        if engine is None:
            why = "沒有引擎設定（engines.json 是空的）" if not want \
                else "不認得這個引擎：%s" % want
            finish_now(home, name, {"error": why,
                                    "aos": {"engine": want, "priority": info["raw"],
                                            "score": info["score"], "reason": info["reason"],
                                            "requester": info["requester"]}})
            errors += 1
            say("error %s engine=%s priority=%d（%s）" %
                (name, want or "-", info["level"], why))
            continue
        # 先搬進 running/（多一個 aos 欄位），再開 worker，最後把 pid 補回去
        aos = {"pid": 0, "engine": want, "priority": info["raw"],
               "score": info["score"], "reason": info["reason"],
               "requester": info["requester"],
               "started": datetime.datetime.now().isoformat(timespec="seconds")}
        os.makedirs(running_box, exist_ok=True)
        lib.write_json_atomic(os.path.join(running_box, name), dict(req, aos=aos))
        os.remove(os.path.join(box, name))
        ok, r = spawn_worker(home, os.path.abspath(args.dir), name)
        if not ok:
            lib.write_json_atomic(os.path.join(home, "results", name),
                                  {"error": str(r), "aos": aos})
            os.makedirs(done_box, exist_ok=True)
            os.replace(os.path.join(running_box, name), os.path.join(done_box, name))
            errors += 1
            say("error %s engine=%s priority=%d（%s）" % (name, want, info["level"], r))
            continue
        aos["pid"] = r
        lib.write_json_atomic(os.path.join(running_box, name), dict(req, aos=aos))
        running[want] = running.get(want, 0) + 1
        recent.append(info["group"])
        recent = recent[-10:]
        launched += 1
        say("launch %s engine=%s priority=%d pid=%d score=%d requester=%s" %
            (name, want, info["level"], r, info["score"], info["requester"]))

    lib.write_json(os.path.join(home, "state.json"),
                   {"tick": tick, "served": served, "errors": errors, "recent": recent})
    queued_left = len(todo)
    say("tick %d launched %d running %d queued %d"
        % (tick, launched, sum(running.values()), queued_left))
    return 0


# ── worker：真的去打那一發 ──────────────────────────────────────────────────

def build_body(engine, req):
    """引擎 params ← 請求 params ← 請求其他頂層鍵；model 一律引擎說了算。"""
    body = dict(engine.get("params") or {})
    body.update(req.get("params") or {})
    for key, value in req.items():
        if key not in AOS_KEYS:
            body[key] = value
    body["model"] = engine.get("model") or "local"
    return body


def strip_think(answer):
    """把 qwen 這種「思考漏進 content」的東西清掉——**這是 LLM 這一側的家務**，
    不該讓每個 agent 自己去處理。每個 `choices[*].message.content`：有 `</think>` 就只留
    最後一個之後的東西，再去頭尾空白。`reasoning_content` 那種供應商自己的私有欄位原樣不動。
    引擎寫 `"strip_think": false` 就不清（預設清）。"""
    for choice in (answer.get("choices") or []):
        if not isinstance(choice, dict):
            continue
        message = choice.get("message")
        if not isinstance(message, dict):
            continue
        text = message.get("content")
        if isinstance(text, str) and "</think>" in text:
            message["content"] = text.rsplit("</think>", 1)[1].strip()
    return answer


# ── Anthropic 直連：把 OpenAI 那一味翻成 Messages API，再翻回來 ────────────────
# 引擎寫 `"api": "anthropic"` 就走這條路（不寫＝openai，行為完全不變）。
# 整個系統只認 OpenAI 的 chat/completions 形狀，所以進出兩邊都在這裡翻，
# 外面的 aos-agent、帳本、packs 都不用知道有這回事。

ANTHROPIC_VERSION = "2023-06-01"   # 引擎可以寫 anthropic_version 蓋掉
ANTHROPIC_MAX_TOKENS = 4096        # Anthropic 的 max_tokens 是必填，沒人給就用這個
# 這些是 OpenAI 才有的鍵，原樣送過去 Anthropic 會回 400，先丟掉。
OPENAI_ONLY = ("n", "presence_penalty", "frequency_penalty", "logit_bias", "logprobs",
               "top_logprobs", "seed", "response_format", "stream", "stream_options",
               "user", "parallel_tool_calls", "reasoning_effort", "modalities",
               "prompt_cache_key", "safety_identifier", "function_call", "functions")
# Anthropic 的 stop_reason → OpenAI 的 finish_reason
STOP_REASON = {"tool_use": "tool_calls", "end_turn": "stop", "stop_sequence": "stop",
               "max_tokens": "length", "refusal": "content_filter", "pause_turn": "stop"}


def api_of(engine):
    """這台引擎走哪一味的 API：不寫就是 openai。"""
    return str((engine or {}).get("api") or "openai").strip().lower()


def flat_text(content):
    """OpenAI 的 content 可能是字串，也可能是 [{"type": "text", ...}] 陣列——一律攤成字串。"""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for item in content:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict) and isinstance(item.get("text"), str):
                parts.append(item["text"])
        return "\n".join(parts)
    if content is None:
        return ""
    return str(content)


def anthropic_tools(tools):
    """OpenAI {"type":"function","function":{name,description,parameters}} → {name,description,input_schema}。"""
    out = []
    for tool in tools or []:
        if not isinstance(tool, dict):
            continue
        fn = tool.get("function")
        if not isinstance(fn, dict):
            if tool.get("name"):   # 已經是 Anthropic 那一味就原樣收下
                out.append(tool)
            continue
        schema = fn.get("parameters")
        out.append({
            "name": str(fn.get("name") or ""),
            "description": str(fn.get("description") or ""),
            "input_schema": schema if isinstance(schema, dict) else {"type": "object", "properties": {}},
        })
    return out


def anthropic_tool_choice(choice):
    """OpenAI 的 tool_choice → Anthropic 的；看不懂就回 None（＝不送）。"""
    if isinstance(choice, str):
        return {"auto": {"type": "auto"}, "required": {"type": "any"},
                "any": {"type": "any"}, "none": {"type": "none"}}.get(choice)
    if isinstance(choice, dict):
        fn = choice.get("function")
        if isinstance(fn, dict) and fn.get("name"):
            return {"type": "tool", "name": str(fn["name"])}
        if choice.get("type"):     # 已經是 Anthropic 那一味
            return choice
    return None


def to_anthropic(body):
    """OpenAI 的 chat/completions body → Anthropic 的 /v1/messages body。

    規矩就幾條：system 訊息抽到頂層 `system`（好幾則用空行接起來）；assistant 的
    `tool_calls` 變成 `tool_use` 內容塊（arguments 那串 JSON 要 parse 回物件）；
    `role: tool` 變成一則 user 的 `tool_result` 塊；**連續同一邊的訊息一定要併成一輪**
    （Anthropic 不收兩個 user 連著，而工具結果一多就會連著好幾則）；tools 換成
    input_schema 的寫法；max_tokens 是必填。其他頂層鍵原樣過（temperature 那些），
    只有 OpenAI 專屬、Anthropic 不吃的先丟掉，免得整發被打回 400。
    """
    out, systems, turns = {}, [], []

    def push(role, blocks):
        if not blocks:
            return
        if turns and turns[-1][0] == role:
            turns[-1][1].extend(blocks)
        else:
            turns.append((role, blocks))

    for key, value in (body or {}).items():
        if key in ("messages", "tools", "tool_choice", "system", "stop",
                   "max_completion_tokens") or key in OPENAI_ONLY:
            continue
        out[key] = value
    if isinstance((body or {}).get("system"), str) and body["system"]:
        systems.append(body["system"])   # 有人直接寫 Anthropic 那一味的頂層 system

    for index, msg in enumerate((body or {}).get("messages") or []):
        if not isinstance(msg, dict):
            continue
        role = msg.get("role")
        text = flat_text(msg.get("content"))
        if role == "system":
            if text:
                systems.append(text)
        elif role == "tool":
            push("user", [{"type": "tool_result",
                           "tool_use_id": str(msg.get("tool_call_id") or ""),
                           "content": text}])
        elif role == "assistant":
            blocks = []
            if text.strip():
                blocks.append({"type": "text", "text": text})
            for slot, tc in enumerate(msg.get("tool_calls") or []):
                if not isinstance(tc, dict):
                    continue
                fn = tc.get("function") if isinstance(tc.get("function"), dict) else {}
                args = fn.get("arguments")
                if isinstance(args, str):
                    try:
                        args = json.loads(args) if args.strip() else {}
                    except ValueError:
                        args = {"_raw": args}   # 模型自己吐壞 JSON 時別讓整發掛掉
                if not isinstance(args, dict):
                    args = {}
                blocks.append({"type": "tool_use",
                               "id": str(tc.get("id") or "toolu_%d_%d" % (index, slot)),
                               "name": str(fn.get("name") or ""), "input": args})
            push("assistant", blocks)
        elif text:
            push("user", [{"type": "text", "text": text}])

    if systems:
        out["system"] = "\n\n".join(systems)
    out["messages"] = [{"role": role, "content": blocks} for role, blocks in turns]
    tools = anthropic_tools((body or {}).get("tools"))
    if tools:
        out["tools"] = tools
    choice = anthropic_tool_choice((body or {}).get("tool_choice"))
    if choice:
        out["tool_choice"] = choice
    stop = (body or {}).get("stop")
    if isinstance(stop, str):
        out["stop_sequences"] = [stop]
    elif isinstance(stop, list) and stop:
        out["stop_sequences"] = [str(s) for s in stop]
    if not isinstance(out.get("max_tokens"), int) or isinstance(out.get("max_tokens"), bool):
        out["max_tokens"] = number((body or {}).get("max_completion_tokens"),
                                   ANTHROPIC_MAX_TOKENS) or ANTHROPIC_MAX_TOKENS
    out["max_tokens"] = int(out["max_tokens"])
    return out


def anthropic_usage(raw):
    """Anthropic 的 usage → OpenAI 的三個數字。帳本（write_pending／fold_pending）與
    packs 的算錢都只認 prompt_tokens／completion_tokens／total_tokens，所以一定要補齊。

    **快取讀到的 token 算進 prompt_tokens**：OpenAI 的 prompt_tokens 本來就含快取命中，
    而算錢那邊是 `(prompt - cached) × 進價 + cached × 快取價`，不折進去會少算。
    寫快取（cache_creation）同樣是這一發的輸入，也折進 prompt_tokens。
    折進去之後另外留 `prompt_tokens_details.cached_tokens`（給算錢的看折扣）與
    Anthropic 原本的兩個數字（帳本會各自成一欄，不會重複進 total）。
    """
    if not isinstance(raw, dict):
        return {}

    def num(key):
        value = raw.get(key)
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            return 0
        return int(value)

    cache_read = num("cache_read_input_tokens")
    cache_make = num("cache_creation_input_tokens")
    prompt = num("input_tokens") + cache_read + cache_make
    completion = num("output_tokens")
    usage = {"prompt_tokens": prompt, "completion_tokens": completion,
             "total_tokens": prompt + completion}
    if cache_read or cache_make:
        usage["prompt_tokens_details"] = {"cached_tokens": cache_read}
        usage["cache_read_input_tokens"] = cache_read
        usage["cache_creation_input_tokens"] = cache_make
    return usage


def from_anthropic(answer):
    """Anthropic 的 /v1/messages 回覆 → OpenAI 的 chat/completions 形狀。

    text 塊接成 `message.content`、tool_use 塊變成 `message.tool_calls`（input 再
    json.dumps 回字串）、thinking 塊放進 `reasoning_content`（跟別的供應商同一格）、
    stop_reason 換成 finish_reason、usage 換成三個數字。
    """
    if not isinstance(answer, dict):
        return answer
    texts, thinks, calls = [], [], []
    for block in answer.get("content") or []:
        if not isinstance(block, dict):
            continue
        kind = block.get("type")
        if kind == "text":
            texts.append(str(block.get("text") or ""))
        elif kind == "thinking":
            thinks.append(str(block.get("thinking") or ""))
        elif kind == "tool_use":
            data = block.get("input")
            calls.append({"id": str(block.get("id") or ""), "type": "function",
                          "function": {"name": str(block.get("name") or ""),
                                       "arguments": json.dumps(
                                           data if isinstance(data, dict) else {},
                                           ensure_ascii=False)}})
    message = {"role": "assistant", "content": "\n".join(texts)}
    if thinks:
        message["reasoning_content"] = "\n".join(thinks)
    if calls:
        message["tool_calls"] = calls
    return {
        "id": answer.get("id"), "object": "chat.completion",
        "model": answer.get("model"),
        "choices": [{"index": 0, "message": message,
                     "finish_reason": STOP_REASON.get(answer.get("stop_reason"), "stop")}],
        "usage": anthropic_usage(answer.get("usage")),
    }


def http_error_text(engine, code, reason, detail):
    """HTTP 錯誤變成結果檔裡那句 error。Anthropic 的錯誤 body 是
    {"type":"error","error":{"type","message"}}，挑出那句人看得懂的話接在狀態碼後面。"""
    if api_of(engine) == "anthropic":
        try:
            data = json.loads(detail)
        except (ValueError, TypeError):
            data = None
        err = data.get("error") if isinstance(data, dict) else None
        if isinstance(err, dict):
            detail = ("%s: %s" % (err.get("type") or "error", err.get("message") or "")).strip()
    return ("HTTP %s %s %s" % (code, reason, detail)).strip()


# ── claude-cli：把 Claude Code 的 headless 模式當成一台引擎 ────────────────────
# 給「有 Claude 訂閱、沒有 API key」的人用：引擎寫 `"api": "claude-cli"`，worker 就開一個
# `claude -p` 的子進程，把整段對話從 stdin 餵進去，結果從 stream-json 撿回來，
# 再翻成 OpenAI 的形狀。用量算在訂閱的五小時窗口裡，不是 API 帳單。
#
# **工具一定要用 MCP 給，不能用文字列**：以前是把工具清單寫進 --system-prompt、再用
# --json-schema 要一包 {content, tool_calls}。實跑會壞——haiku／sonnet 看到工具名字就吐**真的**
# tool_use block，Claude Code 回一句 `<tool_use_error>No such tool available: task_assign`，
# 模型繞五六輪、最後回「工具調用異常，無法執行派工」，tool_calls 空的。
# 現在改成：起一台 aos-mcp-tools（只登記、不執行的 stdio MCP server）把工具真的掛上去，
# `--allowedTools "mcp__aos__*"` 放行、`--max-turns 1` 在第一個 assistant 回合就收工，
# 那一輪的 tool_use block 就是我們要的 tool_calls（工具留給 aos-agent 下一回合自己跑）。
#
# **不用 --bare**：--bare 的認證只認 ANTHROPIC_API_KEY，訂閱制的 OAuth 會直接「Not logged in」。
# **也不能用 --safe-mode**：它把 MCP 一起關了，連 --mcp-config 給的都不載（實測 init 事件回
# `mcp_servers: []`、`tools: []`，模型看不到工具，只好用 `<function_calls>` 假 XML 亂寫）。
# 乾淨是靠這幾支湊出來的：--setting-sources ""（不載使用者／專案／本地 settings，hooks 一起沒）、
# --disable-slash-commands（關 skills）、--tools ""（關內建工具）、--strict-mcp-config
# （只認我們這一台 MCP）、--system-prompt（整個換掉，CLAUDE.md 那些也就進不來）。

MCP_NAME = "aos"                     # --mcp-config 裡那台伺服器的名字
MCP_PREFIX = "mcp__%s__" % MCP_NAME  # Claude Code 給 MCP 工具加的前綴，撿回來要剝掉
MCP_TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "aos-mcp-tools")
CLI_RULE = "要叫工具就用工具，不要用文字描述；content 是給人看的話。"


class CliFailed(Exception):
    """claude-cli 這條路自己的失敗：找不到執行檔、跑掛了、一句 assistant 都沒回。"""


def cli_system_prompt(body):
    """--system-prompt 那一段：請求裡的 system 訊息 ＋ 一條規矩。

    工具**不寫在這裡**（寫了模型只會更想直接叫），改用 MCP 真的掛上去，見 cli_specs。
    """
    parts = []
    for msg in (body or {}).get("messages") or []:
        if isinstance(msg, dict) and msg.get("role") == "system":
            text = flat_text(msg.get("content"))
            if text:
                parts.append(text)
    parts.append(CLI_RULE)
    return "\n\n".join(parts)


def cli_specs(body):
    """請求裡的 tools → aos-mcp-tools 吃的那個陣列（OpenAI 那一味的三個鍵）。"""
    specs = []
    for tool in anthropic_tools((body or {}).get("tools")):
        if not tool.get("name"):
            continue
        specs.append({"name": str(tool["name"]),
                      "description": str(tool.get("description") or ""),
                      "parameters": tool.get("input_schema")
                      or {"type": "object", "properties": {}}})
    return specs


def cli_mcp_config(specs_path, record_path):
    """--mcp-config 那一串 JSON：起一台 aos-mcp-tools，specs 當參數、記錄檔走環境變數。"""
    return json.dumps({"mcpServers": {MCP_NAME: {
        "command": sys.executable or "python3",
        "args": [MCP_TOOL, specs_path],
        "env": {"AOS_MCP_RECORD": record_path},
    }}}, ensure_ascii=False, separators=(",", ":"))


def cli_command(engine, body, specs_path, record_path):
    """組出那一行指令。找不到執行檔就當場講清楚，不要拖到 300 秒逾時。"""
    binary = str((engine or {}).get("bin") or "claude")
    found = shutil.which(binary)
    if not found:
        raise CliFailed("找不到 claude 執行檔（%s）：claude-cli 這種引擎要先裝好 "
                        "Claude Code、讓它在 PATH 上，或在引擎裡寫 \"bin\"" % binary)
    argv = [found, "-p", "--no-session-persistence",
            # **不能用 --safe-mode**：它會把 MCP 一起關掉，--mcp-config 給的也不例外
            # （實測 init 事件回 mcp_servers: []、tools: []）。改用這兩支達到一樣乾淨：
            "--setting-sources", "",        # 使用者／專案／本地 settings 都不載（含 hooks）
            "--disable-slash-commands",     # skills 也關掉
            # stream-json 才看得到那一輪的 tool_use block；-p 模式下它一定要配 --verbose
            "--output-format", "stream-json", "--verbose",
            "--model", str((engine or {}).get("model") or "sonnet"),
            "--tools", "",                  # 內建工具全關，只留我們掛上去的
            "--mcp-config", cli_mcp_config(specs_path, record_path),
            "--strict-mcp-config",          # 別人裝的 MCP 一概不載
            "--allowedTools", MCP_PREFIX + "*",
            "--max-turns", "1",             # 第一個 assistant 回合就收工
            # 用 --system-prompt 整個換掉，不是 append：留著 Claude Code 自己那兩萬 token 的
            # 身份，它會拿我們的工具當「要在這台機器上執行的事」，繞好幾輪才回話
            "--system-prompt", cli_system_prompt(body)]
    effort = (body or {}).get("effort")
    if effort:
        argv += ["--effort", str(effort)]
    for extra in (engine or {}).get("extra_args") or []:
        argv.append(str(extra))
    return argv


def cli_transcript(body):
    """從 stdin 餵進去的那段對話：一則一段，最後留一個空的【assistant】讓它接下去。"""
    names, lines = {}, []
    for msg in (body or {}).get("messages") or []:
        if not isinstance(msg, dict):
            continue
        role = msg.get("role")
        text = flat_text(msg.get("content"))
        if role == "system":
            continue
        if role == "assistant":
            block = ["【assistant】" + text]
            for tc in msg.get("tool_calls") or []:
                if not isinstance(tc, dict):
                    continue
                fn = tc.get("function") if isinstance(tc.get("function"), dict) else {}
                name = str(fn.get("name") or "")
                args = fn.get("arguments")
                if not isinstance(args, str):
                    args = json.dumps(args if args is not None else {}, ensure_ascii=False)
                names[str(tc.get("id") or "")] = name
                block.append("→ %s %s" % (name, args.strip()))
            lines.append("\n".join(block))
        elif role == "tool":
            who = msg.get("name") or names.get(str(msg.get("tool_call_id") or "")) or "tool"
            lines.append("【tool:%s】%s" % (who, text))
        else:
            lines.append("【user】" + text)
    lines.append("【assistant】")
    return "\n\n".join(lines)


def cli_events(out):
    """stream-json 的 stdout → 一串事件。壞掉的行跳過（前面可能夾雜警告）。"""
    events = []
    for line in (out or "").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            one = json.loads(line)
        except ValueError:
            continue
        if isinstance(one, dict):
            events.append(one)
    return events


def cli_record(path):
    """記錄檔（aos-mcp-tools 寫的一行一筆）→ [{name, arguments}]。沒有就空的。"""
    rows = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    one = json.loads(line)
                except ValueError:
                    continue
                if isinstance(one, dict) and one.get("name"):
                    rows.append(one)
    except OSError:
        pass
    return rows


def from_claude_cli(events, model="", recorded=None):
    """stream-json 的那串事件 → OpenAI 的 chat/completions 形狀。

    只看**第一則** assistant 訊息（--max-turns 1 本來就只會有一則）：text block 併成
    content、tool_use block 翻成 tool_calls（名字剝掉 `mcp__aos__` 前綴），thinking 丟掉。

    注意：**一則訊息會拆成好幾個 `type: "assistant"` 事件**（一個 block 一個事件，實測
    thinking 一包、text 一包），所以是照 `message.id` 把同一則的都收齊，不是只拿第一個事件。
    記錄檔當備援：MCP 那邊登記過、stream 裡卻沒有的，補進去。
    usage／花費從最後的 `type: "result"` 事件拿，快取 token 折進 prompt_tokens。
    """
    blocks, first_id, msg_id, result = [], None, None, {}
    for one in events or []:
        if one.get("type") == "assistant":
            msg = one.get("message") if isinstance(one.get("message"), dict) else {}
            here = msg.get("id")
            if first_id is None:
                first_id, msg_id = here, here
            elif here != first_id:
                continue          # 第二則訊息了，不關我們的事
            blocks += [b for b in (msg.get("content") or []) if isinstance(b, dict)]
        if one.get("type") == "result":
            result = one
    if first_id is None and not blocks:
        raise CliFailed("claude-cli 沒有回任何 assistant 訊息：%s"
                        % (result.get("subtype") or result.get("result") or "沒有 result 事件"))

    texts, calls, seen = [], [], set()
    for block in blocks:
        if block.get("type") == "text" and block.get("text"):
            texts.append(str(block["text"]))
        elif block.get("type") == "tool_use" and block.get("name"):
            name = str(block["name"])
            if name.startswith(MCP_PREFIX):
                name = name[len(MCP_PREFIX):]
            args = block.get("input")
            if not isinstance(args, dict):
                args = {}
            seen.add((name, json.dumps(args, ensure_ascii=False, sort_keys=True)))
            calls.append({"id": str(block.get("id") or "call_%d" % (len(calls) + 1)),
                          "type": "function",
                          "function": {"name": name,
                                       "arguments": json.dumps(args, ensure_ascii=False)}})
    for one in recorded or []:
        name = str(one.get("name") or "")
        if name.startswith(MCP_PREFIX):
            name = name[len(MCP_PREFIX):]
        args = one.get("arguments")
        if not isinstance(args, dict):
            args = {}
        key = (name, json.dumps(args, ensure_ascii=False, sort_keys=True))
        if not name or key in seen:
            continue
        seen.add(key)
        calls.append({"id": "call_%d" % (len(calls) + 1), "type": "function",
                      "function": {"name": name,
                                   "arguments": json.dumps(args, ensure_ascii=False)}})

    message = {"role": "assistant", "content": "\n".join(texts)}
    if calls:
        message["tool_calls"] = calls
    return {
        "id": result.get("session_id") or msg_id,
        "object": "chat.completion", "model": model,
        "choices": [{"index": 0, "message": message,
                     "finish_reason": "tool_calls" if calls else "stop"}],
        "usage": anthropic_usage(result.get("usage")),
        # 這一包會被 worker 挪到結果的 aos.cli 底下，留個帳好對。
        "cli": {"session_id": result.get("session_id"),
                "total_cost_usd": result.get("total_cost_usd"),
                "num_turns": result.get("num_turns"),
                "stop_reason": result.get("subtype")},
    }


def call_claude_cli(engine, body, home):
    """開一個 claude -p 子進程打那一發。cwd 一律是 LLM 資料夾（絕不是誰的專案目錄）。

    工具清單先落在 `side/cli/<請求>.tools.json`，MCP server 的登記簿落在同一個資料夾的
    `.calls.jsonl`；跑順了就順手掃掉，**失敗才留著**給人翻。
    """
    side = os.path.join(home or os.getcwd(), "side", "cli")
    try:
        os.makedirs(side, exist_ok=True)
    except OSError:
        side = tempfile.mkdtemp(prefix="aos-cli-")
    stem = os.path.join(side, "%d-%d" % (int(time.time()), os.getpid()))
    specs_path, record_path = stem + ".tools.json", stem + ".calls.jsonl"
    lib.write_json_atomic(specs_path, cli_specs(body))
    open(record_path, "a", encoding="utf-8").close()

    argv = cli_command(engine, body, specs_path, record_path)
    text = cli_transcript(body)
    try:
        proc = subprocess.run(argv, input=text.encode("utf-8"),
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              cwd=home or os.getcwd(), timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        raise CliFailed("claude-cli 超時（%s 秒）" % TIMEOUT)
    except OSError as e:
        raise CliFailed("claude-cli 開不起來：%s" % e)
    out = proc.stdout.decode("utf-8", "replace")
    err = proc.stderr.decode("utf-8", "replace")
    events = cli_events(out)
    has_assistant = any(one.get("type") == "assistant" for one in events)
    # --max-turns 1 撞上限時 result 會是 is_error／error_max_turns，那是**正常收工**，
    # 只要有 assistant 那一輪就算數；沒有才回錯。
    if proc.returncode != 0 and not has_assistant:
        tail = err.strip() or out.strip()
        raise CliFailed("claude-cli 失敗（exit %s）：%s" % (proc.returncode, tail[-300:]))
    if not has_assistant:
        tail = (err.strip() or out.strip())[-200:]
        subtype = ""
        for one in events:
            if one.get("type") == "result":
                subtype = str(one.get("subtype") or one.get("result") or "")
        raise CliFailed("claude-cli 沒有回任何 assistant 訊息：%s" % (subtype or tail or "沒有 result 事件"))
    answer = from_claude_cli(events, (engine or {}).get("model") or "",
                             cli_record(record_path))
    for path in (specs_path, record_path):
        try:
            os.remove(path)
        except OSError:
            pass
    return answer


def call(engine, body, home=""):
    """真的送出那一發。引擎寫 `"api": "anthropic"` 就改打 /v1/messages、換一組 header，
    body 進去前翻成 Anthropic 那一味、回來再翻回 OpenAI 那一味；`"api": "claude-cli"` 走的是
    本機的 claude 子進程（不打網路、也就不探 TCP）；其餘的（預設）原樣打 /chat/completions。"""
    if api_of(engine) == "claude-cli":
        return call_claude_cli(engine, body, home)
    anthropic = api_of(engine) == "anthropic"
    default_base = "https://api.anthropic.com" if anthropic else "http://localhost:1234/v1"
    base = (engine.get("base_url") or default_base).rstrip("/")
    headers = {"Content-Type": "application/json"}
    key = os.environ.get(engine.get("api_key_env") or "")
    if anthropic:
        if key:
            headers["x-api-key"] = key
        headers["anthropic-version"] = str(engine.get("anthropic_version") or ANTHROPIC_VERSION)
        url = base + ("/messages" if base.endswith("/v1") else "/v1/messages")
        body = to_anthropic(body)
    else:
        if key:
            headers["Authorization"] = "Bearer " + key
        url = base + "/chat/completions"
    parts = urllib.parse.urlsplit(base)
    port = parts.port or (443 if parts.scheme == "https" else 80)
    socket.create_connection((parts.hostname or "localhost", port), timeout=CONNECT_TIMEOUT).close()
    req = urllib.request.Request(
        url, data=json.dumps(body, ensure_ascii=False).encode("utf-8"),
        headers=headers, method="POST")
    with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
        answer = json.loads(r.read().decode("utf-8", "replace"))
    return from_anthropic(answer) if anthropic else answer


def do_worker(args):
    """背景進程：讀 requests/running/<name>.json 去打，結果原子落在 results/，
    再寫一張用量小紙條，最後在 running 檔旁留完成標記。退出碼永遠 0——死活看結果檔。"""
    home = lib.home_of(args.dir)
    name = args.name
    rec = lib.read_json(os.path.join(home, "requests", "running", name), None)
    if not isinstance(rec, dict):
        lib.write_json_atomic(os.path.join(home, "results", name),
                              {"error": "worker 找不到請求：%s" % name})
        return 0
    aos = rec.get("aos") if isinstance(rec.get("aos"), dict) else {}
    engines = load_engines(home)
    engine = pick_engine(engines, aos.get("engine") or "") or {}
    body = build_body(engine, rec)
    out = {"engine": engine.get("name") or aos.get("engine") or "",
           "base_url": engine.get("base_url") or "",
           "model": body.get("model"), "priority": aos.get("priority"),
           "score": aos.get("score"), "reason": aos.get("reason"),
           "requester": aos.get("requester") or requester_from_name(name)}

    started = time.time()
    try:
        answer = call(engine, body, home)
        ok = True
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode("utf-8", "replace")[:500]
        except OSError:
            pass
        answer = {"error": http_error_text(engine, e.code, e.reason, detail)}
        ok = False
    except CliFailed as e:
        answer = {"error": str(e)}
        ok = False
    except (urllib.error.URLError, OSError, ValueError) as e:
        answer = {"error": "打不通 %s（%s）" % (out["base_url"], e)}
        ok = False
    took_ms = int((time.time() - started) * 1000)
    out["took_ms"] = took_ms
    if ok and not isinstance(answer, dict):
        answer, ok = {"error": "回覆不是一個 JSON 物件"}, False
    usage = answer.get("usage") if ok else None
    if ok and isinstance(answer.get("cli"), dict):
        out["cli"] = answer.pop("cli")   # claude-cli 的 session_id／花費，留在 aos 底下
    if ok:
        out["usage"] = usage if isinstance(usage, dict) else None
        if engine.get("strip_think", True):
            answer = strip_think(answer)
    answer["aos"] = out

    lib.write_json_atomic(os.path.join(home, "results", name), answer)
    write_pending(home, name, "%s|%s" % (out["base_url"], out["model"] or ""),
                  usage, not ok, took_ms, out["requester"])
    # 這是 worker 最後一個動作：consumer 就算已經把 result 拿走，exec 仍知道這發做完了。
    lib.write_json_atomic(os.path.join(home, "requests", "running", name + ".done"), {
        "error": not ok,
        "usage": usage if isinstance(usage, dict) else {},
        "took_ms": took_ms,
    })
    return 0


