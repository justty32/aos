#!/usr/bin/env python3
"""aos-daemon-step [dir] — daemon 資料夾走一格：照登記表把該推的資料夾各推一格。

daemon 自己也只是一個資料夾，靠 aos-loop 轉。東西全在 <dir>/.aos/daemon/：
登記表 registry/<名字>.json（{"dir": "路徑", "every": 1}，dir 可絕對可相對——
相對的話是相對於 daemon 資料夾本身；every 缺就 1，表示每格都推）、
走到哪 state.json（{"tick": N}）。

一格做的事：tick 加一，再把 registry/ 頂層的 .json 照檔名排序，逐個看
tick % every == 0 就 `aos-exec <解好的 dir>` 推它一格，不然跳過。誰失敗誰的事，
不影響其他登記，也不影響退出碼——daemon 永遠回 0，這樣 aos-loop 的每圈都乾淨。
"""
import argparse
import json
import os
import subprocess
import sys


def log(msg):
    print("aos-daemon-step: " + msg, file=sys.stderr)


def read_json(path, default):
    if not os.path.isfile(path):
        return default
    with open(path, encoding="utf-8") as f:
        text = f.read().strip()
    return json.loads(text) if text else default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)
        f.write("\n")


def main():
    os.environ["PATH"] = (
        os.path.dirname(os.path.abspath(sys.argv[0])) + os.pathsep + os.environ.get("PATH", "")
    )
    ap = argparse.ArgumentParser(prog="aos-daemon-step")
    ap.add_argument("dir", nargs="?", default=".")
    args = ap.parse_args()

    home = os.path.join(os.path.abspath(args.dir), ".aos", "daemon")
    base = os.path.abspath(args.dir)
    registry = os.path.join(home, "registry")
    state_path = os.path.join(home, "state.json")

    state = read_json(state_path, {})
    tick = int(state.get("tick") or 0) + 1
    state["tick"] = tick
    write_json(state_path, state)

    names = []
    if os.path.isdir(registry):
        names = sorted(n for n in os.listdir(registry)
                       if n.endswith(".json") and os.path.isfile(os.path.join(registry, n)))
    if not names:
        log("tick %d 沒有登記" % tick)
        return 0

    for filename in names:
        name = filename[: -len(".json")]
        try:
            entry = read_json(os.path.join(registry, filename), None)
            if not isinstance(entry, dict) or not entry.get("dir"):
                raise ValueError("登記檔要是一個有 dir 的 JSON 物件")
            every = entry.get("every")
            every = 1 if every is None else int(every)
            if every < 1:
                raise ValueError("every 要是 1 以上的整數：%r" % entry.get("every"))
        except (ValueError, TypeError, OSError) as e:
            log("tick %d %s 登記檔讀不了（%s），跳過" % (tick, name, e))
            continue

        target = os.path.normpath(os.path.join(base, entry["dir"]))
        if not os.path.isdir(target):
            log("tick %d %s 找不到資料夾 %s，跳過" % (tick, name, target))
            continue
        if tick % every != 0:
            log("tick %d %s skip" % (tick, name))
            continue
        rc = subprocess.run(["aos-exec", target]).returncode
        log("tick %d %s exit %d" % (tick, name, rc))

    return 0


sys.exit(main())
