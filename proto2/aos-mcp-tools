#!/usr/bin/env python3
"""aos-mcp-tools <specs.json> — 一支「只登記、不執行」的 stdio MCP server。

給誰用：`aos-llm` 的 `"api": "codex-cli"` 那條路。Codex CLI 沒有「把工具清單塞進請求、
它回一包 tool_calls 就結束」的介面——它是一個 agent，工具得**真的掛上去**，它才會發出
真正的工具呼叫（用講的它多半只會寫一段「我要叫 say」的字，形狀不對）。

所以這裡把請求裡的工具清單原封不動變成一台 MCP server 掛給 codex，但**每個工具都不做事**：
被叫到就把 `{"name", "arguments"}` 當一行 JSON append 進 `AOS_MCP_RECORD` 指的檔案，
然後回一句「已登記，這一輪到此為止」。真正跑工具的是外面的 aos-agent——它下一回合才會做，
做完把結果當 `role: tool` 的訊息接回對話裡。我們要的只是**它這一輪決定叫誰、帶什麼參數**。

specs.json 是一個陣列，一項就是一個 OpenAI 形狀的工具：`{name, description, parameters}`。
`tools/list` 時把 `parameters` 改名成 MCP 要的 `inputSchema`，其他原樣。

協定：JSON-RPC 2.0，一行一則，protocol version 2024-11-05。認得 initialize、
notifications/initialized、tools/list、tools/call、ping；不認得的通知直接吞掉，
不認得的請求回 -32601。純標準函式庫，沒有任何相依。

自己試一支：

    echo '[{"name":"say","description":"說一句","parameters":{"type":"object"}}]' > /tmp/s.json
    printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
      | AOS_MCP_RECORD=/tmp/rec.jsonl ./aos-mcp-tools /tmp/s.json
"""
import json
import os
import sys

PROTOCOL = "2024-11-05"
# 回給模型的那句話：把「這一輪到此為止」講白，免得它登記完又接著叫第二、第三個工具。
DONE_TEXT = "已登記 %s；這一輪到此為止，不要再叫工具、直接結束"


def load_specs(path):
    """讀 specs.json，順手把 OpenAI 的 parameters 換成 MCP 的 inputSchema。"""
    try:
        with open(path, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, ValueError) as e:
        print("aos-mcp-tools: 讀不到工具清單 %s：%s" % (path, e), file=sys.stderr)
        return []
    tools = []
    for one in raw if isinstance(raw, list) else []:
        if not isinstance(one, dict) or not one.get("name"):
            continue
        schema = one.get("parameters")
        if not isinstance(schema, dict):
            schema = {"type": "object", "properties": {}}
        tools.append({"name": str(one["name"]),
                      "description": str(one.get("description") or ""),
                      "inputSchema": schema})
    return tools


def record(name, arguments):
    """把這一次呼叫 append 成一行 JSON。沒設 AOS_MCP_RECORD 就只印到 stderr。"""
    path = os.environ.get("AOS_MCP_RECORD") or ""
    line = json.dumps({"name": name, "arguments": arguments},
                      ensure_ascii=False, separators=(",", ":"))
    if not path:
        print("aos-mcp-tools: 沒有 AOS_MCP_RECORD，這次呼叫只印在這裡：" + line,
              file=sys.stderr)
        return
    with open(path, "a", encoding="utf-8") as f:
        f.write(line + "\n")
        f.flush()
        os.fsync(f.fileno())   # 外面那支 worker 正在盯這個檔，寫完就要看得到


def result(req_id, value):
    return {"jsonrpc": "2.0", "id": req_id, "result": value}


def error(req_id, code, message):
    return {"jsonrpc": "2.0", "id": req_id,
            "error": {"code": code, "message": message}}


def handle(req, tools):
    if not isinstance(req, dict) or req.get("jsonrpc") != "2.0" or "method" not in req:
        return error(req.get("id") if isinstance(req, dict) else None,
                     -32600, "Invalid Request")
    req_id = req.get("id")
    method = req["method"]
    if method == "initialize":
        return result(req_id, {"protocolVersion": PROTOCOL,
                               "capabilities": {"tools": {}},
                               "serverInfo": {"name": "aos-mcp-tools", "version": "0.1"}})
    if method == "ping":
        return result(req_id, {})
    if method == "tools/list":
        return result(req_id, {"tools": tools})
    if method == "tools/call":
        params = req.get("params") if isinstance(req.get("params"), dict) else {}
        name = str(params.get("name") or "")
        args = params.get("arguments")
        if not isinstance(args, dict):
            args = {}
        try:
            record(name, args)
        except OSError as e:
            print("aos-mcp-tools: 寫不進登記檔：%s" % e, file=sys.stderr)
            return result(req_id, {"content": [{"type": "text", "text": "登記失敗：%s" % e}],
                                   "isError": True})
        return result(req_id, {"content": [{"type": "text", "text": DONE_TEXT % name}]})
    if "id" not in req:
        return None   # 不認得的通知：吞掉就好
    return error(req_id, -32601, "Method not found")


def main():
    if len(sys.argv) < 2:
        print("用法：aos-mcp-tools <specs.json>", file=sys.stderr)
        return 2
    tools = load_specs(sys.argv[1])
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            request = json.loads(line)
        except ValueError:
            response = error(None, -32700, "Parse error")
        else:
            response = handle(request, tools)
        if response is not None:
            print(json.dumps(response, ensure_ascii=False, separators=(",", ":")), flush=True)
    return 0


sys.exit(main())
