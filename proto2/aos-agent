LLM_WAIT_TICKS = 60            # 請求已經不在 LLM 世界的排隊／執行中，結果卻沒出現：等這麼多格就放棄
LLM_WAIT_TICKS_ALIVE = 1800    # 請求還排著或還在打（大家共用幾路引擎，慢模型一發就要一兩分鐘）：最多等這麼多格
PROTOCOL_RETRIES = 1        # 模型把工具呼叫吐成壞文字：救不回來就同題重送這麼多次
BUDGET_NAG_TICKS = 300      # 凍住的人喊過「請補額度」之後，每這麼多格再喊一次
LLM_ERROR_RETRY_TICKS = 20  # 模型回錯（打不通、500、找不到執行檔…）：對話尾巴那句沒人回的話，隔這麼多格再送一次
LLM_ERROR_MAX = 5           # 同一句連續錯這麼多次就放著不送了，等新信來再說
AUTO_GRANT_RETRY_TICKS = 10 # 個人額度凍住、喊過主管之後：每這麼多格再試一次自動撥款（天花板抬高、主管有錢了就當格解凍）
TOOL_CALL_SMELL = re.compile(r"<tool_call|</tool_call>|\[TOOL_CALLS\]|<function=|<\|tool")


def call_idle_hooks(ctx):
    for name, module in ctx.loaded:
        hook = getattr(module, "on_idle", None)
        if not hook:
            continue
        try:
            hook(ctx.for_pack(name))
        except Exception as e:
            ctx.log("工具包 %s 的 on_idle 出錯：%s" % (name, e))


def call_main_result_hooks(ctx, request, result):
    """主線結果照包順序通知；旁線仍只通知原本登記的包。"""
    for name, module in ctx.loaded:
        hook = getattr(module, "on_main_result", None)
        if not hook:
            continue
        try:
            hook(ctx.for_pack(name), request, result)
        except Exception as e:
            ctx.log("工具包 %s 的 on_main_result 出錯：%s" % (name, e))


def do_llm(ctx, loaded, extra):
    """把整包 body 寫成請求檔丟進 LLM 資料夾的 requests/，回請求檔名。"""
    messages = []
    text = system_text(ctx, loaded)
    if text:
        messages.append({"role": "system", "content": text})
    history = read_json(os.path.join(ctx.home, "prompts.json"), [])
    messages += history if isinstance(history, list) else []

    body = {"messages": messages}
    specs = tool_specs(loaded, extra, tools_only(ctx.home))
    if specs:
        body["tools"] = [{"type": "function", "function": t} for t in specs]
    conf = read_json(os.path.join(ctx.home, "llm.json"), {})
    conf = conf if isinstance(conf, dict) else {}
    name = aos_llm.write_request(
        ctx.llm_dir(), body, priority=conf.get("priority"), engine=conf.get("engine"),
        name="%s-main" % ctx.name,
        requester=team_requester(ctx.world) or ctx.name)
    warn("問 LLM，請求丟成 %s" % name)
    return name


def _json_objects(text):
    """把一段文字裡所有頂層 JSON 物件挖出來（qwen 的 <tool_call>…</tool_call>、mistral 的
    [TOOL_CALLS] [...]、或整段就是 {...}／```json 圍起來的都吃得到）。壞掉的就跳過。"""
    found, depth, start = [], 0, None
    in_str, esc = False, False
    for i, ch in enumerate(text):
        if in_str:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            continue
        if ch == '"':
            in_str = True
        elif ch == "{":
            if depth == 0:
                start = i
            depth += 1
        elif ch == "}" and depth:
            depth -= 1
            if depth == 0 and start is not None:
                try:
                    found.append(json.loads(text[start:i + 1]))
                except ValueError:
                    pass
                start = None
    return [obj for obj in found if isinstance(obj, dict)]


def _balanced_object(text, start):
    """從 text[start]（一定是 '{'）往後找到配對的 '}'，回那段 JSON 解出來的 dict；壞掉回 None。"""
    depth, in_str, esc = 0, False, False
    for i in range(start, len(text)):
        ch = text[i]
        if in_str:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            continue
        if ch == '"':
            in_str = True
        elif ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0:
                try:
                    obj = json.loads(text[start:i + 1])
                except ValueError:
                    return None
                return obj if isinstance(obj, dict) else None
    return None


NAMED_OBJECT = re.compile(r"`?([A-Za-z_][A-Za-z0-9_]*)`?\s*[:：]?\s*(?:```\w*\s*)?(\{)")


def named_tool_objects(content, known):
    """小模型另一種寫法：`team_grant:` 後面接一個參數 JSON（常包在 ```plaintext 裡）。
    回 [(工具名, 參數 dict)]，只收我們真的有的工具。"""
    found = []
    for m in NAMED_OBJECT.finditer(content or ""):
        if m.group(1) not in known:
            continue
        obj = _balanced_object(content, m.start(2))
        if obj is not None:
            found.append((m.group(1), obj))
    return found


def salvage_tool_calls(content, known):
    """content 裡看得像工具呼叫的 JSON，只要 name 是我們真的有的工具，就救成正式 tool_calls。"""
    calls = []
    pairs = []
    for obj in _json_objects(content or ""):
        inner = obj.get("function") if isinstance(obj.get("function"), dict) else obj
        name = inner.get("name")
        if name in known:
            pairs.append((name, inner.get("arguments", inner.get("parameters", {}))))
    if not pairs:
        pairs = named_tool_objects(content, known)
    for name, args in pairs:
        if isinstance(args, str):
            try:
                args = json.loads(args) if args.strip() else {}
            except ValueError:
                continue
        if not isinstance(args, dict):
            args = {}
        calls.append({"id": "salvaged_%d" % (len(calls) + 1), "type": "function",
                      "function": {"name": name, "arguments": json.dumps(args, ensure_ascii=False)}})
    return calls


def note_llm_error(ctx, reason=""):
    """記一次模型出錯：錯第幾次、第幾格錯的、為什麼。三樣都留著，`retry` 才知道何時重送、
    `aos-user team why` 才講得出「上次出錯什麼」。"""
    ctx.state["llm_errors"] = int(ctx.state.get("llm_errors") or 0) + 1
    ctx.state["llm_error_step"] = int(ctx.state.get("step") or 0)
    ctx.state["llm_error_reason"] = str(reason)[:200]


def clear_llm_errors(state):
    """這句終於有人回了、或來了新信：出錯那幾筆帳全清掉，從頭算。"""
    for key in ("llm_errors", "llm_error_step", "llm_error_reason", "llm_gave_up"):
        state.pop(key, None)


def dangling_turn(home):
    """對話尾巴是不是一句還沒人回的話（user／tool）。模型出錯回 idle 之後就會長這樣。"""
    history = read_json(os.path.join(home, "prompts.json"), [])
    if not isinstance(history, list) or not history:
        return False
    last = history[-1]
    return isinstance(last, dict) and last.get("role") in ("user", "tool")


def do_retry(ctx, state, msgs, step):
    """兩格「出錯之後」的狀態，回 (下一格 state, 這格算不算做事)。

    `retry`＝對話尾巴那句還沒人回，等 LLM_ERROR_RETRY_TICKS 格就同題再送一次；
    `stuck`＝連錯 LLM_ERROR_MAX 次，這句先放著、喊一聲，等新信來再說。
    兩格都照樣讀信，因為新信就是把它救回來的那件事。"""
    if msgs:
        clear_llm_errors(ctx.state)
        warn("來了新信，出錯那幾筆帳清掉，重新問模型")
        return "llm", True
    if state == "stuck":
        return "stuck", False
    errors = int(ctx.state.get("llm_errors") or 0)
    if errors >= LLM_ERROR_MAX:
        text = "（模型連續出錯 %d 次，這句先放著；來新信我再試）" % errors
        ctx.state["llm_gave_up"] = True
        ctx.reply(text, error=True)
        warn(text)
        return "stuck", False
    since = step - int(ctx.state.get("llm_error_step") or 0)
    if since >= LLM_ERROR_RETRY_TICKS:
        warn("對話尾巴那句還沒人回（上次出錯 %d 次），重送" % errors)
        return "llm", True
    warn("等重送（上次出錯 %d 次，還有 %d 格）" % (errors, LLM_ERROR_RETRY_TICKS - since))
    return "retry", False


def do_wait(ctx, request, waited, loaded=(), extra=()):
    """去 LLM 資料夾撿回覆。回 (下一格 state, 這次的用量或 False, 已等幾格)。
    模型把工具呼叫吐成文字：認得的救回來當正式 tool_calls；救不回來當協定錯誤，同題重送一次。"""
    answer = aos_llm.read_result(ctx.llm_dir(), request)
    if answer is None:
        clock = ctx.clock_of(ctx.llm_dir())
        if clock["kind"] == "none" or clock["state"] != "running":
            text = "LLM 的鐘沒有在跑，這題先停下來。"
            ctx.reply(text, error=True)
            warn(text)
            note_llm_error(ctx, "LLM 的鐘沒有在跑")
            return "retry", False, 0
        waited += 1
        box = os.path.join(aos_llm.home_of(ctx.llm_dir()), "requests")
        alive = bool(request) and (os.path.isfile(os.path.join(box, request)) or
                                   os.path.isfile(os.path.join(box, "running", request)))
        limit = LLM_WAIT_TICKS_ALIVE if alive else LLM_WAIT_TICKS
        if waited >= limit:
            text = ("（等 LLM 超過 %d 格還沒回，放棄這題）" % limit if alive else
                    "（請求已經不在 LLM 的排隊裡、結果卻 %d 格沒出現，放棄這題）" % limit)
            ctx.reply(text, error=True)
            warn(text)
            note_llm_error(ctx, text)
            return "retry", False, 0
        warn("等 LLM（%s，%s）" % (request or "沒有請求", "排隊／執行中" if alive else "不在排隊裡"))
        return "wait", False, waited
    write_json(os.path.join(ctx.home, "llm-result.json"), answer)
    call_main_result_hooks(ctx, request, answer)
    aos = answer.get("aos") if isinstance(answer, dict) else None
    usage = aos.get("usage") if isinstance(aos, dict) else False

    if answer.get("error"):
        reason = str(answer.get("error"))[:200]
        ctx.reply("（LLM 出錯：%s）" % reason, error=True)
        warn("LLM 回了 error（%s），這輪不算，改走 retry；%d 格後重送" % (reason, LLM_ERROR_RETRY_TICKS))
        note_llm_error(ctx, reason)
        return "retry", usage, 0
    clear_llm_errors(ctx.state)
    try:
        assistant = answer["choices"][0]["message"]
    except (KeyError, IndexError, TypeError):
        warn("回覆裡找不到 choices[0].message，這輪不算，改走 retry")
        note_llm_error(ctx, "回覆裡找不到 choices[0].message")
        return "retry", usage, 0

    # 只留 role／content／tool_calls，把伺服器夾帶的私有欄位（reasoning_content…）濾掉。
    # content 裡漏出來的 <think> 不歸這裡管——那是 LLM 資料夾那側的家務（engines.json 的 strip_think）。
    stored = {"role": assistant.get("role") or "assistant",
              "content": assistant.get("content") or ""}
    calls = assistant.get("tool_calls") or []
    content = stored["content"] if isinstance(stored["content"], str) else ""
    known = {t.get("name") for t in tool_specs(list(loaded), list(extra))} if content and not calls else set()
    smells = bool(content) and not calls and (
        bool(TOOL_CALL_SMELL.search(content)) or
        any("name" in obj and ("arguments" in obj or "parameters" in obj)
            for obj in _json_objects(content)) or
        bool(named_tool_objects(content, known)))
    if smells:
        calls = salvage_tool_calls(content, known)
        if calls:
            warn("模型把工具呼叫寫成文字，救回 %d 個" % len(calls))
            stored["content"] = ""
            assistant = dict(assistant, content="", tool_calls=calls)
            answer["choices"][0]["message"] = assistant
            write_json(os.path.join(ctx.home, "llm-result.json"), answer)
        else:
            tries = int(ctx.state.get("protocol_retries") or 0)
            if tries < PROTOCOL_RETRIES:
                ctx.state["protocol_retries"] = tries + 1
                warn("模型的工具呼叫格式壞了、救不回來，同題重送（第 %d 次）" % (tries + 1))
                return "llm", usage, 0
            warn("模型的工具呼叫格式壞了兩次，這次照普通回覆處理")
    ctx.state.pop("protocol_retries", None)
    if calls:
        stored["tool_calls"] = calls
    append_history(ctx.home, [stored])
    return "act", usage, 0


def run_tool(ctx, owners, extra, name, args_text):
    """跑一個工具：名字屬於哪個工具包就交給那包的 run()，其餘的走 tools.json 的
    `tools[]`（一句 shell 指令，參數 JSON 從 stdin 進去）。認不得的名字回一句話，不當機。"""
    try:
        args = json.loads(args_text) if args_text.strip() else {}
    except ValueError:
        args = {}
    if not isinstance(args, dict):
        args = {}
    owner = owners.get(name)
    if owner is None:
        result = run_custom(ctx, extra, name, args_text)
        return result, args, False
    pack_name, module = owner
    try:
        result = module.run(name, args, ctx.for_pack(pack_name))
        return result, args, True
    except Exception as e:      # 一個工具壞掉不該弄死整格
        result = {"error": "%s 出錯：%s" % (name, e)}
        return result, args, True


def do_act(ctx, loaded, extra):
    """有工具就跑工具；沒工具就回話。回 (下一格 state, 是否收到空白回覆)。"""
    answer = read_json(os.path.join(ctx.home, "llm-result.json"), {})
    message = ((answer.get("choices") or [{}])[0] or {}).get("message") or {}
    calls = message.get("tool_calls")
    if not (isinstance(calls, list) and calls):
        content = message.get("content") or ""
        if not isinstance(content, str):
            content = str(content)
        if not content.strip():
            warn("模型回空白")
            return "idle", True
        print(content)
        ctx.reply(content)
        recent = ctx.state.get("recent_question_steps")
        recent = recent if isinstance(recent, list) else []
        ctx.state["recent_question_steps"] = (recent + [
            int(ctx.state.get("question_steps") or 0) + 1])[-5:]
        ctx.state["question_active"] = False
        return "idle", False

    owners = pack_owners(loaded)
    results = []
    for call in calls:
        fn = call.get("function") or {}
        args = fn.get("arguments")
        if not isinstance(args, str):
            args = json.dumps(args or {}, ensure_ascii=False)
        started = time.monotonic()
        raw_result, parsed_args, json_result = run_tool(
            ctx, owners, extra, fn.get("name"), args)
        took_ms = int((time.monotonic() - started) * 1000)
        warn("跑工具 %s" % fn.get("name"))
        final_result = raw_result
        for pack_name, module in loaded:
            hook = getattr(module, "on_act", None)
            if not hook:
                continue
            try:
                replacement = hook(ctx.for_pack(pack_name), fn.get("name"), parsed_args,
                                   final_result, took_ms)
                if replacement is not None:
                    final_result = replacement
            except Exception as e:
                ctx.log("工具包 %s 的 on_act 出錯：%s" % (pack_name, e))
        if json_result or not isinstance(final_result, str):
            out = json.dumps(final_result, ensure_ascii=False)
        else:
            out = final_result
        results.append({"role": "tool", "tool_call_id": call.get("id"), "content": out})
    append_history(ctx.home, results)
    return ("idle" if ctx.state.get("sleeping") else "collect"), False


def budget_block(ctx):
    """工作室額度是硬閘門，每格都守。回 True 表示這格整個凍住（不走狀態機、step 不加）。
    整隊任一項用完→全隊凍住，只有 sales 開口問甲方要不要追加（追加走 aos-user team budget --add）。
    個人 tokens 用完（0 額度就是 0 上限）→自己凍住、報主管一次；主管 team_grant 後自然解凍。"""
    try:
        data = team_status_of(ctx.world, light=True)
    except (OSError, ValueError):
        ctx.state.pop("budget_block", None)
        return False
    mine = next((row for row in data["members"] if row["name"] == ctx.name), None)
    total_over = [key for key in ("tokens", "hours", "ticks", "money_usd")
                  if data["budget"].get(key) and data["remaining"].get(key) is not None
                  and data["remaining"][key] <= 0]
    own_over = []
    if mine and data["budget"].get("tokens"):
        limit = mine["budget"].get("tokens") or 0
        spent = mine["today_spent"].get("tokens") or 0
        if spent >= limit:
            own_over.append("tokens")
    mark = "team:" + ",".join(total_over) if total_over else \
        "own:" + ",".join(own_over) if own_over else ""
    if not mark:
        if ctx.state.pop("budget_block", None):
            warn("額度回來了，解凍")
        ctx.state.pop("budget_told", None)
        return False
    ctx.state["budget_block"] = mark
    # 只開口一次；個人額度 0 的人沒事做（沒信、也不在題目中間）就安靜凍著，
    # 等真的有人派活給他才喊——不然開隊當下四個沒分到額度的人會同時抱怨，主管還沒收單就先燒 token。
    # 喊過了還凍著，每 BUDGET_NAG_TICKS 格再喊一次（主管讀了沒動作、或把那封讀錯了）。
    frozen = int(ctx.state.get("frozen_ticks") or 0)
    if ctx.state.get("budget_told") == mark and (frozen == 0 or frozen % BUDGET_NAG_TICKS):
        # 喊過了就不再喊；但撥款政策可能變了（天花板抬高、主管剛拿到錢），每 AUTO_GRANT_RETRY_TICKS 格再試一次自動撥款。
        # 以前只在第一次凍住和每 300 格才試，天花板抬了也要等五分鐘。
        if own_over and not total_over and frozen % AUTO_GRANT_RETRY_TICKS == 0:
            granted, why = team_auto_grant(ctx.world, ctx.name)
            if granted:
                warn(why + "，解凍")
                ctx.state.pop("budget_block", None)
                ctx.state.pop("budget_told", None)
                return False
        return True
    if total_over:
        ctx.state["budget_told"] = mark
        if ctx.name == "sales":
            ctx.reply("整隊額度用完了（%s），全隊已停。要追加請跑：aos-user team budget %s --add "
                      "'{\"tokens\": 數量}'（hours／ticks／money_usd 也可以加）。" % (
                          "、".join(total_over), data["root"]), error=True)
        else:
            warn("整隊額度用完（%s），凍住等 sales 問甲方追加" % "、".join(total_over))
        return True
    # retry 手上那句還等著送出去，算有工作；stuck 是放著等新信，不算
    has_work = (ctx.state.get("state") or "idle") not in ("idle", "stuck") or \
        any(ctx.unread(source) for source in ctx.sources())
    if not has_work:
        return True
    granted, why = team_auto_grant(ctx.world, ctx.name)
    if granted:
        warn(why + "，解凍")
        ctx.state.pop("budget_block", None)
        ctx.state.pop("budget_told", None)
        return False
    ctx.state["budget_told"] = mark
    supervisor = mine.get("reports_to") if mine else None
    text = "我的 tokens 額度用完了（上限 %s、已用 %s），有工作在等，請用 team_grant 加給我（一次至少 20000）。" % (
        mine["budget"].get("tokens"), mine["today_spent"].get("tokens"))
    if supervisor:
        ctx.put_mail(supervisor, "budget", text)
    else:
        ctx.reply(text, error=True)
    if why.startswith("撥錢的人"):
        # 池子乾了：整隊總額還沒到，但能撥錢的人都沒剩——直接替 sales 問甲方，不必再繞一輪模型
        sales = next((row for row in data["members"] if row["name"] == "sales"), None)
        if sales and ctx.name != "sales":
            sales_world = os.path.join(data["root"], sales.get("path") or ".")
            Ctx(sales_world, resolve_home(sales_world, None)).reply(
                "額度撥不出來了（%s；整隊還剩 %s tokens 但都在已凍住的人手上）。要追加請跑："
                "aos-user team budget %s --add '{\"tokens\": 數量}' --to pm" % (
                    why, data["remaining"].get("tokens"), data["root"]), error=True)
    return True


def hard_limit(ctx):
    limits = agent_limits(ctx.home)
    steps = int(ctx.state.get("question_steps") or 0)
    if ctx.state.get("question_active") and steps >= limits["max_steps_per_question"]:
        return "steps", "這題我已經跑了 %d 格，要不要繼續？" % steps
    token_limit = limits["max_tokens_per_day"]
    used = today_usage_for(ctx.home, ctx.world).get("total_tokens") or 0
    today = datetime.date.today().isoformat()
    if (token_limit is not None and used >= token_limit
            and ctx.state.get("token_limit_ack_day") != today):
        return "tokens", "今天用量到頂了，要不要繼續？"
    return None, None


def do_exec(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    st_path = os.path.join(home, "state.json")
    saved = read_json(st_path, {})
    saved = saved if isinstance(saved, dict) else {}
    state = saved.get("state") or "idle"
    step = saved.get("step") or 0
    busy = saved.get("busy") or 0
    request = saved.get("request") or ""
    last_usage = saved.get("last_usage")
    started = saved.get("started") or now_iso()
    announced = saved.get("announced") or []
    wait_ticks = int(saved.get("wait_ticks") or 0)
    empty_replies = int(saved.get("empty_replies") or 0)
    pending = saved.get("pending")
    saved["pending"] = pending if isinstance(pending, list) else []
    loaded, extra = load_packs(home)
    ctx = Ctx(world, home, saved, loaded)

    if budget_block(ctx):
        saved["frozen_ticks"] = int(saved.get("frozen_ticks") or 0) + 1
        write_json(st_path, saved)
        warn("step %d 額度閘門（%s）：這格凍住不動" % (step, saved.get("budget_block")))
        return 0
    saved.pop("frozen_ticks", None)

    side_msgs = ctx.collect_results()
    inbox_msgs, direct = [], False
    if state in ("idle", "collect", "retry", "stuck") or saved.get("limit_pause") \
            or saved.get("sleeping"):
        direct = bool(ctx.unread("user"))
        # retry／stuck 就是閒著在等，未讀提醒那條路要照走（scan_inbox 只認 idle）
        view = dict(saved, state="idle") if state in ("retry", "stuck") else saved
        inbox_msgs, announced = scan_inbox(home, announced, view)
        if view is not saved and "unread_told_step" in view:
            saved["unread_told_step"] = view["unread_told_step"]
        if direct:
            if saved.get("limit_kind") == "tokens" and saved.get("limit_pause"):
                saved["token_limit_ack_day"] = datetime.date.today().isoformat()
            saved.update({"question_active": True, "question_steps": -1,
                          "question_sleep_steps": 0,
                          "limit_pause": False})
        if (direct or side_msgs or inbox_msgs) and saved.get("sleeping"):
            saved.pop("sleeping", None)
    append_history(home, side_msgs + inbox_msgs)

    limit_kind, limit_text = (None, None) if direct else hard_limit(ctx)
    if saved.get("limit_pause") and not direct:
        nxt, did = "idle", False
    elif limit_text:
        if not saved.get("limit_pause"):
            ctx.reply(limit_text, error=True)
        saved["limit_pause"] = True
        saved["limit_kind"] = limit_kind
        request, wait_ticks = "", 0
        nxt, did = "idle", True
    elif state == "idle":
        call_idle_hooks(ctx)
        msgs = side_msgs + inbox_msgs
        if msgs:
            clear_llm_errors(saved)                 # 新信來了，之前出錯放棄的那句跟著一起再試
            nxt, did = "llm", True
        else:
            nxt, did = "idle", False
    elif state in ("retry", "stuck"):
        nxt, did = do_retry(ctx, state, side_msgs + inbox_msgs, step)
    elif state == "collect":
        nxt, did = "llm", True
    elif state == "llm":
        request = do_llm(ctx, loaded, extra)
        wait_ticks = 0
        nxt, did = "wait", True
    elif state == "wait":
        nxt, usage, wait_ticks = do_wait(ctx, request, wait_ticks, loaded, extra)
        if usage is not False:
            last_usage = usage
        did = nxt != "wait"
        if did:
            request = ""
    elif state == "act":
        nxt, empty = do_act(ctx, loaded, extra)
        if empty:
            empty_replies += 1
        did = True
    else:
        warn("認不得的 state：%s，當 idle" % state)
        state, nxt, did = "idle", "idle", False

    if did:
        busy += 1
    if saved.get("question_active") and not saved.get("limit_pause"):
        # 睡著等旁線、或主線在排隊等模型回，都不是 agent 自己在繞圈，不算每題動作格
        if not did and (saved.get("sleeping")
                        or state in ("wait", "idle", "retry", "stuck")):
            # 睡著等旁線、排隊等模型、或模型出錯後閒著等重送：都不是 agent 自己在繞圈
            saved["question_sleep_steps"] = int(saved.get("question_sleep_steps") or 0) + 1
        else:
            saved["question_steps"] = int(saved.get("question_steps") or 0) + 1
    if (nxt == "idle" and dangling_turn(home)
            and not saved.get("sleeping") and not saved.get("limit_pause")):
        # 哪天又多一條「出錯就回 idle」的路，這裡把它撈回來：對話尾巴那句沒人回就不准回 idle
        warn("安全網：這格要回 idle 但對話尾巴還有沒人回的話，改成 retry")
        nxt = "retry"
        saved["llm_error_step"] = step
        saved["llm_errors"] = max(1, int(saved.get("llm_errors") or 0))
        saved.setdefault("llm_error_reason", "不知道哪條路回了 idle，安全網撈回來")
    saved.update({"state": nxt, "step": step + 1, "busy": busy,
                  "request": request, "last_usage": last_usage,
                  "started": started, "announced": announced,
                  "wait_ticks": wait_ticks, "empty_replies": empty_replies})
    write_json(st_path, saved)
    warn("step %d busy %d state %s -> %s" % (step, busy, state, nxt))
    return 0



def main():
    ap = argparse.ArgumentParser(prog="aos-agent")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("exec")
    p.add_argument("dir", nargs="?", default=".")
    p.add_argument("--home", default=None)
    p.set_defaults(fn=do_exec)
    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help(sys.stderr)
        return 2
    return args.fn(args)


sys.exit(main())
