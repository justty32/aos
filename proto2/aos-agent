#!/usr/bin/env python3
"""aos-agent exec：執行 agent 狀態機的一格。"""
import argparse
import datetime
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import aos_llm            # noqa: E402
from aos_agent import (   # noqa: E402
    Ctx, agent_limits, append_history, load_packs, now_iso, pack_owners, read_json,
    resolve_home, run_custom, scan_inbox, system_text, team_requester, team_status_of,
    today_usage_for, tool_specs, warn, write_json)

LLM_WAIT_TICKS = 60


def call_idle_hooks(ctx):
    for name, module in ctx.loaded:
        hook = getattr(module, "on_idle", None)
        if not hook:
            continue
        try:
            hook(ctx.for_pack(name))
        except Exception as e:
            ctx.log("工具包 %s 的 on_idle 出錯：%s" % (name, e))


def call_main_result_hooks(ctx, request, result):
    """主線結果照包順序通知；旁線仍只通知原本登記的包。"""
    for name, module in ctx.loaded:
        hook = getattr(module, "on_main_result", None)
        if not hook:
            continue
        try:
            hook(ctx.for_pack(name), request, result)
        except Exception as e:
            ctx.log("工具包 %s 的 on_main_result 出錯：%s" % (name, e))


def do_llm(ctx, loaded, extra):
    """把整包 body 寫成請求檔丟進 LLM 資料夾的 requests/，回請求檔名。"""
    messages = []
    text = system_text(ctx, loaded)
    if text:
        messages.append({"role": "system", "content": text})
    history = read_json(os.path.join(ctx.home, "prompts.json"), [])
    messages += history if isinstance(history, list) else []

    body = {"messages": messages}
    specs = tool_specs(loaded, extra)
    if specs:
        body["tools"] = [{"type": "function", "function": t} for t in specs]
    conf = read_json(os.path.join(ctx.home, "llm.json"), {})
    conf = conf if isinstance(conf, dict) else {}
    name = aos_llm.write_request(
        ctx.llm_dir(), body, priority=conf.get("priority"), engine=conf.get("engine"),
        name="%s-main" % ctx.name,
        requester=team_requester(ctx.world) or ctx.name)
    warn("問 LLM，請求丟成 %s" % name)
    return name


def do_wait(ctx, request, waited):
    """去 LLM 資料夾撿回覆。回 (下一格 state, 這次的用量或 False, 已等幾格)。"""
    answer = aos_llm.read_result(ctx.llm_dir(), request)
    if answer is None:
        clock = ctx.clock_of(ctx.llm_dir())
        if clock["kind"] == "none" or clock["state"] != "running":
            text = "LLM 的鐘沒有在跑，這題先停下來。"
            ctx.reply(text, error=True)
            warn(text)
            return "idle", False, 0
        waited += 1
        if waited >= LLM_WAIT_TICKS:
            text = "（等 LLM 超過 %d 格沒回應，請確認 LLM 的鐘有沒有在跑）" % LLM_WAIT_TICKS
            ctx.reply(text, error=True)
            warn(text)
            return "idle", False, 0
        warn("等 LLM（%s）" % (request or "沒有請求"))
        return "wait", False, waited
    write_json(os.path.join(ctx.home, "llm-result.json"), answer)
    call_main_result_hooks(ctx, request, answer)
    aos = answer.get("aos") if isinstance(answer, dict) else None
    usage = aos.get("usage") if isinstance(aos, dict) else False

    if answer.get("error"):
        reason = str(answer.get("error"))[:200]
        ctx.reply("（LLM 出錯：%s）" % reason, error=True)
        warn("LLM 回了 error（%s），這輪不算，回 idle" % reason)
        return "idle", usage, 0
    try:
        assistant = answer["choices"][0]["message"]
    except (KeyError, IndexError, TypeError):
        warn("回覆裡找不到 choices[0].message，這輪不算，回 idle")
        return "idle", usage, 0

    # 只留 role／content／tool_calls，把伺服器夾帶的私有欄位（reasoning_content…）濾掉。
    # content 裡漏出來的 <think> 不歸這裡管——那是 LLM 資料夾那側的家務（engines.json 的 strip_think）。
    stored = {"role": assistant.get("role") or "assistant",
              "content": assistant.get("content") or ""}
    calls = assistant.get("tool_calls") or []
    if calls:
        stored["tool_calls"] = calls
    append_history(ctx.home, [stored])
    return "act", usage, 0


def run_tool(ctx, owners, extra, name, args_text):
    """跑一個工具：名字屬於哪個工具包就交給那包的 run()，其餘的走 tools.json 的
    `tools[]`（一句 shell 指令，參數 JSON 從 stdin 進去）。認不得的名字回一句話，不當機。"""
    try:
        args = json.loads(args_text) if args_text.strip() else {}
    except ValueError:
        args = {}
    if not isinstance(args, dict):
        args = {}
    owner = owners.get(name)
    if owner is None:
        result = run_custom(ctx, extra, name, args_text)
        return result, args, False
    pack_name, module = owner
    try:
        result = module.run(name, args, ctx.for_pack(pack_name))
        return result, args, True
    except Exception as e:      # 一個工具壞掉不該弄死整格
        result = {"error": "%s 出錯：%s" % (name, e)}
        return result, args, True


def do_act(ctx, loaded, extra):
    """有工具就跑工具；沒工具就回話。回 (下一格 state, 是否收到空白回覆)。"""
    answer = read_json(os.path.join(ctx.home, "llm-result.json"), {})
    message = ((answer.get("choices") or [{}])[0] or {}).get("message") or {}
    calls = message.get("tool_calls")
    if not (isinstance(calls, list) and calls):
        content = message.get("content") or ""
        if not isinstance(content, str):
            content = str(content)
        if not content.strip():
            warn("模型回空白")
            return "idle", True
        print(content)
        ctx.reply(content)
        recent = ctx.state.get("recent_question_steps")
        recent = recent if isinstance(recent, list) else []
        ctx.state["recent_question_steps"] = (recent + [
            int(ctx.state.get("question_steps") or 0) + 1])[-5:]
        ctx.state["question_active"] = False
        return "idle", False

    owners = pack_owners(loaded)
    results = []
    for call in calls:
        fn = call.get("function") or {}
        args = fn.get("arguments")
        if not isinstance(args, str):
            args = json.dumps(args or {}, ensure_ascii=False)
        started = time.monotonic()
        raw_result, parsed_args, json_result = run_tool(
            ctx, owners, extra, fn.get("name"), args)
        took_ms = int((time.monotonic() - started) * 1000)
        warn("跑工具 %s" % fn.get("name"))
        final_result = raw_result
        for pack_name, module in loaded:
            hook = getattr(module, "on_act", None)
            if not hook:
                continue
            try:
                replacement = hook(ctx.for_pack(pack_name), fn.get("name"), parsed_args,
                                   final_result, took_ms)
                if replacement is not None:
                    final_result = replacement
            except Exception as e:
                ctx.log("工具包 %s 的 on_act 出錯：%s" % (pack_name, e))
        if json_result or not isinstance(final_result, str):
            out = json.dumps(final_result, ensure_ascii=False)
        else:
            out = final_result
        results.append({"role": "tool", "tool_call_id": call.get("id"), "content": out})
    append_history(ctx.home, results)
    return ("idle" if ctx.state.get("sleeping") else "collect"), False


def budget_block(ctx):
    """工作室額度是硬閘門。回 True 表示這格不能再叫 LLM。"""
    try:
        data = team_status_of(ctx.world)
    except (OSError, ValueError):
        ctx.state.pop("budget_block", None)
        return False
    mine = next((row for row in data["members"] if row["name"] == ctx.name), None)
    total_over = [key for key in ("tokens", "hours", "ticks", "money_usd")
                  if data["budget"].get(key) and data["remaining"].get(key) is not None
                  and data["remaining"][key] <= 0]
    own_over = []
    if mine:
        for key in ("tokens", "ticks", "money_usd"):
            limit = mine["budget"].get(key) or 0
            spent = mine["today_spent"].get(key) or 0
            if data["budget"].get(key) and limit > 0 and spent >= limit:
                own_over.append(key)
    mark = "team:" + ",".join(total_over) if total_over else \
        "own:" + ",".join(own_over) if own_over else ""
    if not mark:
        ctx.state.pop("budget_block", None)
        return False
    if ctx.state.get("budget_block") == mark:
        return True
    ctx.state["budget_block"] = mark
    if total_over:
        if ctx.name == "sales":
            ctx.reply("整隊額度用完了，要不要追加？", error=True)
        else:
            ctx.put_mail("sales", "budget", "整隊額度用完，請向使用者申請追加。")
    else:
        supervisor = mine.get("reports_to") if mine else None
        if supervisor:
            ctx.put_mail(supervisor, "budget", "額度用完，等主管加。")
    return True


def hard_limit(ctx):
    limits = agent_limits(ctx.home)
    steps = int(ctx.state.get("question_steps") or 0)
    if ctx.state.get("question_active") and steps >= limits["max_steps_per_question"]:
        return "steps", "這題我已經跑了 %d 格，要不要繼續？" % steps
    token_limit = limits["max_tokens_per_day"]
    used = today_usage_for(ctx.home, ctx.world).get("total_tokens") or 0
    today = datetime.date.today().isoformat()
    if (token_limit is not None and used >= token_limit
            and ctx.state.get("token_limit_ack_day") != today):
        return "tokens", "今天用量到頂了，要不要繼續？"
    return None, None


def do_exec(args):
    world = os.path.abspath(args.dir)
    home = resolve_home(world, args.home)
    st_path = os.path.join(home, "state.json")
    saved = read_json(st_path, {})
    saved = saved if isinstance(saved, dict) else {}
    state = saved.get("state") or "idle"
    step = saved.get("step") or 0
    busy = saved.get("busy") or 0
    request = saved.get("request") or ""
    last_usage = saved.get("last_usage")
    started = saved.get("started") or now_iso()
    announced = saved.get("announced") or []
    wait_ticks = int(saved.get("wait_ticks") or 0)
    empty_replies = int(saved.get("empty_replies") or 0)
    pending = saved.get("pending")
    saved["pending"] = pending if isinstance(pending, list) else []
    loaded, extra = load_packs(home)
    ctx = Ctx(world, home, saved, loaded)

    side_msgs = ctx.collect_results()
    inbox_msgs, direct = [], False
    if state in ("idle", "collect") or saved.get("limit_pause") or saved.get("sleeping"):
        direct = bool(ctx.unread("user"))
        inbox_msgs, announced = scan_inbox(home, announced)
        if direct:
            if saved.get("limit_kind") == "tokens" and saved.get("limit_pause"):
                saved["token_limit_ack_day"] = datetime.date.today().isoformat()
            saved.update({"question_active": True, "question_steps": -1,
                          "question_sleep_steps": 0,
                          "limit_pause": False})
        if (direct or side_msgs or inbox_msgs) and saved.get("sleeping"):
            saved.pop("sleeping", None)
    append_history(home, side_msgs + inbox_msgs)

    limit_kind, limit_text = (None, None) if direct else hard_limit(ctx)
    if saved.get("limit_pause") and not direct:
        nxt, did = "idle", False
    elif limit_text:
        if not saved.get("limit_pause"):
            ctx.reply(limit_text, error=True)
        saved["limit_pause"] = True
        saved["limit_kind"] = limit_kind
        request, wait_ticks = "", 0
        nxt, did = "idle", True
    elif state == "idle":
        call_idle_hooks(ctx)
        msgs = side_msgs + inbox_msgs
        nxt, did = (("llm", True) if msgs else ("idle", False))
    elif state == "collect":
        nxt, did = "llm", True
    elif state == "llm":
        if budget_block(ctx):
            nxt, did = "idle", False
        else:
            request = do_llm(ctx, loaded, extra)
            wait_ticks = 0
            nxt, did = "wait", True
    elif state == "wait":
        nxt, usage, wait_ticks = do_wait(ctx, request, wait_ticks)
        if usage is not False:
            last_usage = usage
        did = nxt != "wait"
        if did:
            request = ""
    elif state == "act":
        nxt, empty = do_act(ctx, loaded, extra)
        if empty:
            empty_replies += 1
        did = True
    else:
        warn("認不得的 state：%s，當 idle" % state)
        state, nxt, did = "idle", "idle", False

    if did:
        busy += 1
    if saved.get("question_active") and not saved.get("limit_pause"):
        if saved.get("sleeping") and not did:
            saved["question_sleep_steps"] = int(saved.get("question_sleep_steps") or 0) + 1
        else:
            saved["question_steps"] = int(saved.get("question_steps") or 0) + 1
    saved.update({"state": nxt, "step": step + 1, "busy": busy,
                  "request": request, "last_usage": last_usage,
                  "started": started, "announced": announced,
                  "wait_ticks": wait_ticks, "empty_replies": empty_replies})
    write_json(st_path, saved)
    warn("step %d busy %d state %s -> %s" % (step, busy, state, nxt))
    return 0



def main():
    ap = argparse.ArgumentParser(prog="aos-agent")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("exec")
    p.add_argument("dir", nargs="?", default=".")
    p.add_argument("--home", default=None)
    p.set_defaults(fn=do_exec)
    args = ap.parse_args()
    if not getattr(args, "fn", None):
        ap.print_help(sys.stderr)
        return 2
    return args.fn(args)


sys.exit(main())
