#!/bin/sh
# act：執行 plan（在 stack）——經 tools/stamp 把答案寫進 $AOS_WS/out/<題名>，題目搬到 done/
[ -n "$AOS_STACK" ] || { echo "agent-bob: 沒設定 AOS_STACK" >&2; exit 1; }
name=$(cat "$AOS_STACK/current")
mkdir -p "$AOS_WS/out" "$AOS_WS/done"
plan=$AOS_STACK/plan
sub=$AOS_STACK/stamp/
AOS_STACK=$sub aos-exec tools/stamp < "$plan" > "$AOS_WS/out/$name" || exit 1
mv "$AOS_WS/inbox/$name" "$AOS_WS/done/$name"
