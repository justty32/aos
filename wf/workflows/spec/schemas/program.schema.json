{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aos.local/schemas/program.schema.json",
  "title": "aos 模板：編譯器吐的 .aos/program/<模板名>.json",
  "type": "object",
  "required": ["format_version", "name", "source_hash", "steps"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "type": "integer", "const": 1 },
    "name": { "$ref": "#/$defs/id" },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "ext": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "path": { "type": "string", "minLength": 1 },
    "args": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "clock": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["steps", "every", "until", "once"] },
        "steps": { "type": "integer", "minimum": 1 },
        "every_ms": { "type": "integer", "minimum": 1 },
        "until": { "const": "idle" }
      }
    },
    "step": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["inst", "call", "await"] },
        "then": { "$ref": "#/$defs/id" },
        "on_fail": { "$ref": "#/$defs/id" },
        "select": { "$ref": "#/$defs/path" }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "inst" } } },
          "then": {
            "required": ["inst"],
            "properties": {
              "inst": { "$ref": "inst.schema.json" },
              "expect": { "$ref": "#/$defs/path" }
            }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "call" } } },
          "then": {
            "required": ["child", "mode", "result"],
            "properties": {
              "child": { "$ref": "#/$defs/path" },
              "mode": { "enum": ["sync", "async"] },
              "result": { "$ref": "#/$defs/path" },
              "args": { "$ref": "#/$defs/args" },
              "clock": { "$ref": "#/$defs/clock" },
              "cleanup": { "type": "boolean" }
            }
          }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "await" } } },
          "then": {
            "required": ["result"],
            "properties": {
              "result": { "$ref": "#/$defs/path" },
              "max_ticks": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
