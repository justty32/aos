+cd "$SOLO/D/plain"
+$AOS agent init
+$AOS say '幫我在 README.md 最後加一行 # tried'
+timeout 900 $AOS run . --step 12
+$AOS listen --once
+tail -1 README.md
+timeout 900 $AOS run . --step 3
+$AOS listen --once
+tail -1 README.md
+```
+
