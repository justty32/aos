+
+mkdir -p "$WORLD/.aos"
+cp -r "$TEMPLATE/." "$WORLD/"
+cd "$WORLD"
+"$AOS" agent init
+
+set +e
+timeout 2 "$AOS" talk --interface pi < /dev/null > talk-pi.log 2>&1
