+set -e
+
+printf 'EXPECT: CLI 清楚回報 --interface pi 尚未內建。\n'
+printf 'ACTUAL: exit=%s，完整輸出如下：\n' "$TALK_RC"
+cat talk-pi.log
+printf 'EVIDENCE_DIR: %s\n' "$CASE_DIR"
