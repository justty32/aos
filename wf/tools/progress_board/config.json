{
  "description": "Config for the aos progress board: lines, repos, polling and the LLM summarizer.",
  "sites": [{"mount": "arknights", "dir": "~/Desktop/aos-arknights"}],
  "port": 8765,
  "collect_interval_sec": 15,
  "aos_repo": "~/repo/simple_tools/aos",
  "read_roots": ["~/repo/simple_tools/aos", "~/code/playground-ak", "~/Desktop/aos-arknights", "~/Desktop/aos-進度", "/tmp/claude-1000"],
  "report_globs": ["~/code/playground-ak/runs/*/*-report.md"],
  "repos": [
    {"name": "aos", "path": "~/repo/simple_tools/aos"},
    {"name": "playground-ak", "path": "~/code/playground-ak"}
  ],
  "lines": [
    {"id": "arknights-kb", "title": "明日方舟知識庫（第三輪）", "round_pages": {"第一輪": "arknights/round1.html", "第二輪": "arknights/round2.html", "第三輪": "arknights/round3.html"}, "handoff": "proto8/thinking/2026-11/07/arknights-kb/交棒.md", "commit_filters": [{"repo": "aos", "grep": "arknights"}, {"repo": "aos", "path": "proto8/thinking/2026-11/07/arknights-kb/"}, {"repo": "playground-ak"}]},
    {"id": "impl-plan", "title": "五份設計實作", "handoff": "proto8/thinking/2026-11/07/impl-plan/交棒.md", "commit_filters": [{"repo": "aos", "grep": "impl-plan"}, {"repo": "aos", "path": "proto8/thinking/2026-11/07/impl-plan/"}]},
    {"id": "progress-board", "title": "進度看板", "handoff": null, "commit_filters": [{"repo": "aos", "path": "wf/tools/progress_board/"}, {"repo": "aos", "path": "wf/tools/progress_post.sh"}]}
  ],
  "designs": {"file": "designs.json", "globs": ["proto8/thinking/**/*fable*.md"]},
  "links": [{"title": "fable 的設計", "href": "designs.html"}, {"title": "明日方舟網站", "href": "../aos-arknights/index.html", "http_href": "arknights/index.html"}],
  "stale_after_min": 120,
  "summary": {
    "enabled": true,
    "eli5_enabled": true,
    "eli5_min_interval_min": 4,
    "eli5_max_tokens": 2500,
    "min_interval_min": 15,
    "base_url": "http://localhost:4000/v1",
    "model": "chatgpt-gpt-5.6-terra",
    "max_tokens": 2500,
    "timeout_sec": 300
  }
}
