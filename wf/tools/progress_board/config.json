{
  "description": "Config for the aos progress board: lines, repos, polling and the LLM summarizer.",
  "port": 8765,
  "collect_interval_sec": 15,
  "aos_repo": "~/repo/simple_tools/aos",
  "repos": [
    {"name": "aos", "path": "~/repo/simple_tools/aos"},
    {"name": "playground-ak", "path": "~/code/playground-ak"}
  ],
  "lines": [
    {"id": "arknights-kb", "title": "明日方舟知識庫（第三輪）", "handoff": "proto8/thinking/2026-11/07/arknights-kb/交棒.md"},
    {"id": "impl-plan", "title": "五份設計實作", "handoff": "proto8/thinking/2026-11/07/impl-plan/交棒.md"},
    {"id": "progress-board", "title": "進度看板", "handoff": null}
  ],
  "links": [{"title": "明日方舟網站", "href": "../aos-arknights/index.html"}],
  "stale_after_min": 120,
  "summary": {
    "enabled": true,
    "min_interval_min": 15,
    "base_url": "http://localhost:4000/v1",
    "model": "chatgpt-gpt-5.6-terra",
    "max_tokens": 2500,
    "timeout_sec": 300
  }
}
