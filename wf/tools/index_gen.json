{
 "description": "index_gen 的範圍：哪些夾可以建 `_index.json`（deep＝連底下每一層）、門檻 more_than（夾裡直接的東西超過這個數才放，11-12 的門檻＝15）、哪些夾裡面不建（只在上一層留一項）。stage 1＝文件區，2＝程式區；templates、kernel 只看頂層與 docs／tests（定義夾會被整夾抄走）、lib/packs 與各 bin、cases 的 expect／ws 不放、knowledge 不在範圍（那棵樹手寫維護）。",
 "more_than": 15,
 "scopes": [
  {
   "path": ".",
   "stage": 1
  },
  {
   "path": "wf",
   "deep": true,
   "stage": 1
  },
  {
   "path": "proto8",
   "stage": 1
  },
  {
   "path": "proto8/docs",
   "deep": true,
   "stage": 1
  },
  {
   "path": "proto8/thinking",
   "deep": true,
   "stage": 1
  },
  {
   "path": "proto8/notes",
   "deep": true,
   "stage": 1
  },
  {
   "path": "proto8/user-advice",
   "deep": true,
   "stage": 1
  },
  {
   "path": "proto8/lib",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/cmd",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/py",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/impls",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/extras",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/cases",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/feedback",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/templates",
   "stage": 2
  },
  {
   "path": "proto8/templates/docs",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/templates/tests",
   "deep": true,
   "stage": 2
  },
  {
   "path": "proto8/kernel",
   "stage": 2
  },
  {
   "path": "proto8/kernel/docs",
   "deep": true,
   "stage": 2
  }
 ],
 "skip_dir_names": [
  "archive",
  "__pycache__",
  ".git",
  ".claude",
  ".vscode",
  "bin",
  "expect",
  "ws"
 ],
 "skip_dirs": [
  "wf/inbox",
  "proto8/lib/packs"
 ],
 "usual_dirs": {
  "tests": "{parent} 的測試",
  "src": "{parent} 的原始碼",
  "include": "{parent} 對外的標頭（別的專案只 include 這裡）",
  "bin": "{parent} 的啟動檔：指令的入口",
  "docs": "{parent} 的說明文件",
  "cmake": "{parent} 共用的 CMake 設定",
  "scripts": "{parent} 的腳本",
  ".vscode": "{parent} 的 VS Code 設定"
 },
 "usual_files": {
  ".gitignore": "{parent} 這一夾不進版控的東西",
  ".gitkeep": "空檔，只為了讓空夾進版控",
  "CMakeLists.txt": "{parent} 的 CMake 建置檔",
  "vcpkg.json": "{parent} 用到的 vcpkg 套件清單",
  "CMakePresets.json": "{parent} 的 CMake 預設組"
 },
 "codemap": {
  "description": "逐檔 code map 的範圍（原本寫死在舊的 code map 生成器）：掃 `git ls-files proto8`，去掉 skip_top 的頂層夾、任何一層叫 skip_any_dir 的夾、skip_names 的檔、.md（md_dirs 的頂層夾除外）。out＝逐檔表 json 寫在哪（repo 根相對），一個 proto8 頂層夾一檔、頂層單檔進 proto8.json。",
  "out": "wf/knowledge/code-map/proto8",
  "skip_top": [
   "thinking",
   "archive",
   "notes",
   "user-advice",
   "docs"
  ],
  "skip_any_dir": [
   "archive",
   "docs",
   "__pycache__",
   ".vscode"
  ],
  "skip_names": [
   ".gitignore",
   ".gitattributes",
   "_index.json"
  ],
  "md_dirs": [
   "knowledge"
  ]
 }
}
