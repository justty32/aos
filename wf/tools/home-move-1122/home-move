#!/usr/bin/env bash
# home-move：11-23 起退場：stack 不再跟著 git 搬（使用者「直接變成.stack，然後把它git ignore，就這樣。換機那一套就不用了。」），留著等使用者決定刪不刪。原本是線 6（家機搬家，11-22）的一次性工具——把 eca-aos 與三個 subagent 從舊樹 ~/aos-home/.stack 搬到 ~/repo/aos/_stack，分段可單獨跑，all 照順序跑、任何一步失敗自動 rollback。
#
# 用法、每段做什麼、真跑時外面那個 Claude 的完整步驟：同夾 README.md。規劃：proto8/thinking/2026-11/22/工作區與stack-1122/02-規劃.md「線 6」。
#   home-move check|stop-old|copy|fix|retire-old|start-llm|start-root|reattach|verify|rollback|start-old|screen|probe|all|status
# 路徑全部從 HM_* 變數來（預設從 HM_HOME＝$HOME 推）；演練＝HM_HOME 指暫存夾裡的假家目錄，同一支腳本。
# 不刪檔：要拿掉的檔一律 mv 進 $HM_WORK 底下的備份夾；不讀、不印、不寫任何金鑰（LITELLM_KEY 只看有沒有設）；不把整份環境寫進 log。
# 輸出與 log 英文（使用者偏好：程式輸出一律英文）；註解中文。
[ -n "${BASH_VERSION:-}" ] || { echo "home-move: error: run me with bash" >&2; exit 2; }
set -u -o pipefail
umask 022
PROG=home-move

# ---- 清環境（硬規則 2）：AOS_* 全清，之後每個 aos 指令都在 aos() 裡明確給 AOS_HOME ----
for _v in $(compgen -e | grep '^AOS_' || true); do unset "$_v"; done
if compgen -e | grep -q '^AOS_'; then echo "$PROG: error: AOS_* still set after unset" >&2; exit 2; fi
unset _v

# ---- 設定（全部可用環境變數蓋；演練只給 HM_HOME 與 HM_PATH_PREPEND、HM_GIT_REPO）----
HM_HOME=${HM_HOME:-$HOME}
HM_REPO=${HM_REPO:-$HM_HOME/repo/aos}                     # 新樹所在的 repo（_stack 放它的根）
HM_AOS_HOME=${HM_AOS_HOME:-$HM_REPO/proto8}               # 跑哪一份 bin/ lib/（線 3 已 install.py 過的）
HM_GIT_REPO=${HM_GIT_REPO:-$HM_REPO}                      # check 查 commit 用的 git repo（演練的 repo 是 git archive，沒有 .git）
HM_OLD=${HM_OLD:-$HM_HOME/aos-home}                       # 舊樹（往後只留 llm/ 與 .llm-stack/）
HM_RETIRE=${HM_RETIRE:-$HM_HOME/aos-home.old-1122}        # 退路：舊樹 llm 以外的東西整批搬來這裡
HM_LLM_DEF=${HM_LLM_DEF:-$HM_OLD/llm}                     # llm kernel 的定義（原地用）
HM_LLM_STACK=${HM_LLM_STACK:-$HM_OLD/.llm-stack}          # 新的 llm kernel 的 stack（AOS_LLM_KERNEL）
HM_WORK=${HM_WORK:-$HM_HOME/.aos/scratch/home-move-1122}  # log、備份、狀態記號、runner、tmux socket
HM_TMUX_SOCK=${HM_TMUX_SOCK:-$HM_WORK/tmux.sock}
HM_TMUX_SESSION=${HM_TMUX_SESSION:-home-move}
HM_PATH_PREPEND=${HM_PATH_PREPEND:-}                      # 演練：放假 claude 的夾，排在 PATH 最前面
HM_TIMEOUT=${HM_TIMEOUT:-300}                             # 每個等待的上限（秒）；關畫面時 eca-aos 正在答話會一直等到這裡
HM_SUBAGENTS=${HM_SUBAGENTS:-add}                         # add＝reattach 從外面把三個 subagent 掛回；hint＝只印提示，留給 eca-aos 自己 rm/add
HM_FAIL_AT=${HM_FAIL_AT:-}                                # 演練用：all 跑完這一步後故意失敗（驗 rollback）
HM_SKIP_REBASE=${HM_SKIP_REBASE:-}                        # 演練用：非空＝fix 只列相對指標、不改寫（驗 verify 抓得到；線 override-path-1122）
HM_SYS_TO=${HM_SYS_TO:-'~/repo/aos'}                      # system.txt 裡的 $HM_REPO 改寫成這串（提示詞文字）

STACK=$HM_REPO/_stack
OLD_STACK=$HM_OLD/.stack
ROOT_DEF=wf/tree/root                                     # 相對 HM_REPO
ECA_DEF_JSON='{"$env": "AOS_HOME", "$path": "/templates/eca-claude"}'
PARENT=eca-aos
SUBAGENTS=(eca-aos-templates aos-eca-frontend eca-aos-kb)  # 照 eca-aos 帳上的順序
MOVED=("$PARENT" "${SUBAGENTS[@]}")
SCREENS=("$PARENT" "${SUBAGENTS[@]}" eca-claude)            # stop-old 先關這幾隻還開著的畫面
POINTER_FILES=(tools.json hookeds.json)                    # eca-claude 宣告的 tools 與 hookeds 覆蓋層：相對的指標從檔所在資料夾算，stack 換深度就斷（線 override-path-1122）
# 舊樹頂層：清單寫死，對不上就停（規劃線 6 第 6 步；01「第三輪量到的」）
RETIRE_ITEMS=(.stack README.md README.md.bak-1121c README.md.bak-1121d agents env.sh perm root root.log)
KEEP_ITEMS=(llm)
# 要已經在 HEAD 裡的 commit（線 1～5、9）
COMMITS=("b6a3702e2 line 1 (.gitignore, wf/ws)" "15c23d7b5 line 2 (size check)" "139d8dd2b line 3 (relative paths)"
         "7b596847f line 4 (stack-commit)" "6dff15cdb line 5 (wf/tree/root)" "db7d1b9be line 9 (move manual)")
# 線 3 改到、要已經 install 進 lib/ 的檔（py/ 與 lib/ 一模一樣才算裝了）
LINE3_FILES=(tools/agent/subagent/_entry aos/apps/agent/common.py)
STEPS_ALL=(stop-old copy fix retire-old start-llm start-root reattach verify)

for _p in HM_HOME HM_REPO HM_AOS_HOME HM_OLD HM_RETIRE HM_LLM_DEF HM_LLM_STACK HM_WORK HM_TMUX_SOCK; do
    case ${!_p} in /*) ;; *) echo "$PROG: error: $_p must be an absolute path, not ${!_p}" >&2; exit 2;; esac
    printf -v "$_p" '%s' "$(realpath -m -- "${!_p}")"
done
unset _p
STACK=$HM_REPO/_stack
OLD_STACK=$HM_OLD/.stack
STATE=$HM_WORK/state
LOG=$HM_WORK/home-move.log

# ---- 小工具 ----
say()  { printf '%s %s: %s\n' "$(date '+%F %T')" "$PROG" "$*"; }
warn() { say "warning: $*"; }
fail() { say "error: $*"; return 1; }
mark() { mkdir -p "$STATE" && date '+%F %T' > "$STATE/$1"; }
marked() { [ -e "$STATE/$1" ]; }

unset_claude() { local v; for v in $(compgen -e | grep -E '^(CLAUDECODE$|CLAUDE_)' || true); do unset "$v"; done; unset TMUX TMUX_PANE; }

# 在乾淨的 aos 環境跑一支 aos 指令：只有 AOS_HOME（env.sh 清其他 AOS_*、放 PATH）、HOME＝HM_HOME、沒有 CLAUDE*。不帶腳本的鎖 fd。
aos() {
    ( unset_claude
      export HOME="$HM_HOME" AOS_HOME="$HM_AOS_HOME"
      . "$HM_AOS_HOME/env.sh" >/dev/null || exit 1
      [ -z "$HM_PATH_PREPEND" ] || PATH="$HM_PATH_PREPEND:$PATH"
      exec "$@" 9>&- )
}
tm() { tmux -S "$HM_TMUX_SOCK" "$@" 9>&- </dev/null; }

# 共用的 Python 小幫手（純標準庫；只讀寫這次點名的檔）
read -r -d '' PYH <<'PY'
import hashlib, json, os, sys
op, args = sys.argv[1], sys.argv[2:]
def load(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)
def write_atomic(p, text):
    tmp = os.path.join(os.path.dirname(p), ".%s.home-move.%d" % (os.path.basename(p), os.getpid()))
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, p)
if op == "ledger-state":            # FILE OLDPROCS NAMES… → print old|new|other
    path, oldprocs, names = args[0], args[1], args[2:]
    try:
        kids = load(path)
    except Exception as e:
        print("other cannot read: %s" % e); sys.exit(0)
    if not isinstance(kids, list) or [k.get("name") if isinstance(k, dict) else None for k in kids] != names:
        print("other names are %s" % json.dumps([k.get("name") if isinstance(k, dict) else k for k in kids] if isinstance(kids, list) else kids)); sys.exit(0)
    stacks = [k.get("stack") for k in kids]
    if stacks == [os.path.join(oldprocs, n) for n in names]:
        print("old")
    elif stacks == ["procs/%s" % n for n in names]:
        print("new")
    else:
        print("other stacks are %s" % json.dumps(stacks))
elif op == "ledger-write":          # FILE NAMES…
    path, names = args[0], args[1:]
    write_atomic(path, json.dumps([{"name": n, "stack": "procs/%s" % n} for n in names], ensure_ascii=False) + "\n")
elif op == "replace":               # FILE FROM TO → print how many
    path, old, new = args
    with open(path, encoding="utf-8") as f:
        text = f.read()
    n = text.count(old)
    if n:
        st = os.stat(path)
        write_atomic(path, text.replace(old, new))
        os.chmod(path, st.st_mode & 0o7777)
    print(n)
elif op == "table":                 # stdin = aos-daemon-ctl ls -j → "name phase" lines
    rows = json.load(sys.stdin)
    if isinstance(rows, dict):
        rows = [dict(v, name=k) for k, v in (rows.get("procs") or rows).items() if isinstance(v, dict)]
    for r in rows:
        if isinstance(r, dict):
            print("%s %s" % (r.get("name"), r.get("phase") or r.get("state")))
elif op == "pids":                  # procs_state.json → pid lines (table rows and the daemon itself)
    try:
        d = load(args[0])
    except Exception:
        sys.exit(0)
    out = [d.get("pid")] + [r.get("pid") for r in (d.get("procs") or {}).values() if isinstance(r, dict)]
    for p in out:
        if isinstance(p, int) and p > 0:
            print(p)
elif op == "envjson":               # FILE → KEY=VALUE for the path variables only (they hold no secrets)
    d = load(args[0])
    for k in ("AOS_HOME", "AOS_DAEMON", "AOS_LLM_KERNEL", "AOS_KERNEL", "AOS_CLOCK"):
        print("%s=%s" % (k, d.get(k, "")))
elif op == "exec-check":            # FILE PARENT → problems, one per line (none = fine)
    d = load(args[0]).get("exec", {})
    envs, parent = d.get("envs", {}), args[1]
    want = {"AOS_PARENT_STACK": {"$env": "AOS_DAEMON", "$path": "procs/%s" % parent},
            "AOS_NOTIFY_BOX": {"$env": "AOS_DAEMON", "$path": "procs/%s/mailbox" % parent}}
    for k, v in want.items():
        if envs.get(k) != v:
            print("envs.%s is %s, want %s" % (k, json.dumps(envs.get(k)), json.dumps(v)))
    cwd = d.get("cwd")
    if not (isinstance(cwd, dict) and cwd.get("$env") == "AOS_DAEMON"):
        print("cwd is %s, want an AOS_DAEMON directive" % json.dumps(cwd))
elif op == "screen-sock":           # CELL → the screen's tmux socket (same rule as aos.agentlib.cli_cell.tty_socket)
    cell = os.path.realpath(args[0])
    h = hashlib.sha256(cell.encode()).hexdigest()[:16] + ".sock"
    sub = "aos-tty-%d" % os.getuid()
    xdg = os.environ.get("XDG_RUNTIME_DIR") or ""
    base = os.path.join(xdg, sub) if (os.path.isabs(xdg) and os.path.isdir(xdg) and os.access(xdg, os.W_OK | os.X_OK)
                                      and len(os.path.join(xdg, sub).encode()) <= 80) else os.path.join("/tmp", sub)
    for cand in (os.path.join(base, h), os.path.join("/tmp", sub, h), os.path.join(cell, "tty.sock")):
        if os.path.exists(cand):
            print(cand); break
    else:
        print(os.path.join(base, h))
elif op == "procscan":              # OLDSTACKS DIRS TABLE… (OLDSTACKS, DIRS: ':'-separated) → "own\tPID" / "stray\tPID\tWHY\tCWD\tCMD" lines
    # 舊樹的行程（own）＝表上的 pid、AOS_STACK 指進舊 stack 的、根 daemon 的父行程 aos-exec，再加它們的子孫。
    # 其他 cwd 在 DIRS 底下或 AOS_DAEMON 指著舊 stack 的（使用者的終端機分頁、aos-frontend serve、aos-agent open）＝stray：不等、只列。
    # environ 只取 AOS_STACK、AOS_DAEMON 兩個鍵，其餘不留、不印。
    olds = [os.path.normpath(x) for x in args[0].split(":") if x]
    dirs = [os.path.normpath(x) for x in args[1].split(":") if x]
    def under(p, bases):
        if not p:
            return False
        p = os.path.normpath(p)
        return any(p == b or p.startswith(b + "/") for b in bases)
    uid, me, procs = os.getuid(), {os.getpid(), os.getppid()}, {}
    for n in os.listdir("/proc"):
        if not n.isdigit():
            continue
        d = "/proc/" + n
        try:
            if os.stat(d).st_uid != uid:
                continue
            with open(d + "/stat", "rb") as f:
                st = f.read().decode("utf-8", "replace")
            ppid = int(st.rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            continue
        env = {}
        try:
            with open(d + "/environ", "rb") as f:
                for kv in f.read().split(b"\0"):
                    for k in (b"AOS_STACK=", b"AOS_DAEMON="):
                        if kv.startswith(k):
                            env[k[:-1].decode()] = kv[len(k):].decode("utf-8", "replace")
        except OSError:
            pass
        try:
            cwd = os.readlink(d + "/cwd")
        except OSError:
            cwd = ""
        try:
            exe = os.path.basename(os.readlink(d + "/exe")).replace(" (deleted)", "")
        except OSError:
            exe = ""
        procs[int(n)] = {"ppid": ppid, "env": env, "cwd": cwd, "exe": exe}
    own, roots = set(), []
    for t in args[2:]:
        try:
            tb = load(t)
        except Exception:
            continue
        if isinstance(tb.get("pid"), int):
            roots.append(tb["pid"])
        for p in [tb.get("pid")] + [r.get("pid") for r in (tb.get("procs") or {}).values() if isinstance(r, dict)]:
            if isinstance(p, int) and p in procs:
                own.add(p)
    for p, i in procs.items():
        if under(i["env"].get("AOS_STACK"), olds):
            own.add(p)
    for r in roots:                 # 起根 daemon 的 aos-exec（cwd 在舊樹、自己沒有 AOS_STACK；根停了它就退）
        pp = procs.get(r, {}).get("ppid")
        if pp in procs and procs[pp]["exe"] == "aos-exec":
            own.add(pp)
    kids = {}
    for p, i in procs.items():
        kids.setdefault(i["ppid"], []).append(p)
    todo = list(own)
    while todo:
        for c in kids.get(todo.pop(), []):
            if c not in own:
                own.add(c); todo.append(c)
    for p in sorted(procs):
        i = procs[p]
        if p in own:
            print("own\t%d" % p); continue
        if p in me or "AOS_STACK" in i["env"] or i["exe"] in ("aos-exec", "aos-daemon", "aos-loop"):
            continue                # 這支掃描自己；別棵樹的行程（新的 llm kernel 也住舊樹的 llm/）
        why = [w for w, hit in (("cwd", under(i["cwd"], dirs)), ("AOS_DAEMON", under(i["env"].get("AOS_DAEMON"), olds))) if hit]
        if not why:
            continue
        try:
            with open("/proc/%d/cmdline" % p, "rb") as f:
                argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
        except OSError:
            argv = []
        cmd = " ".join(os.path.basename(a) for a in argv[:3] if "=" not in a)[:60] or "?"   # 指令名：前三個字的檔名，帶 = 的不印
        print("stray\t%d\t%s\t%s\t%s" % (p, "+".join(why), i["cwd"], cmd))
elif op == "aos-at":                # DIR → pids with cwd DIR that are aos programs or carry AOS_STACK (a user's shell there is not one)
    want = os.path.normpath(args[0])
    for n in sorted(os.listdir("/proc"), key=lambda s: int(s) if s.isdigit() else 0):
        if not n.isdigit():
            continue
        d = "/proc/" + n
        try:
            if os.stat(d).st_uid != os.getuid() or os.readlink(d + "/cwd") != want:
                continue
            exe = os.path.basename(os.readlink(d + "/exe")).replace(" (deleted)", "")
            with open(d + "/environ", "rb") as f:
                has_stack = any(kv.startswith(b"AOS_STACK=") for kv in f.read().split(b"\0"))
        except OSError:
            continue
        if exe in ("aos-exec", "aos-daemon", "aos-loop") or has_stack:
            print(n)
elif op == "ledger-on-table":       # LEDGER DAEMON ; stdin = ls -j → "on N of M" and the missing names
    kids = load(args[0]); daemon = args[1]
    rows = json.load(sys.stdin)
    if isinstance(rows, dict):
        rows = [dict(v, name=k) for k, v in (rows.get("procs") or rows).items() if isinstance(v, dict)]
    on = {(r.get("name"), os.path.normpath(os.path.join(daemon, r["stack"]))) for r in rows if isinstance(r, dict) and isinstance(r.get("stack"), str)}
    hit = [k["name"] for k in kids if (k.get("name"), os.path.normpath(os.path.join(daemon, k.get("stack", "")))) in on]
    print("on %d of %d; missing: %s" % (len(hit), len(kids), " ".join(k["name"] for k in kids if k["name"] not in hit) or "-"))
elif op == "rebase":                # FILE OLDPROC NEWPROC AOSHOME [--dry-run] → rewrite the relative pointers of FILE that leave the stack; one line per change
    # 線 override-path-1122：tools.json 的 $override／tools.*.path／tools.*.env_file 與 hookeds.json 的 *.handler 寫相對時，是從檔所在資料夾算；
    # stack 換了深度就指空。照舊位置解出目標：在 stack 裡＝原樣（跟著搬）；在 AOSHOME 底下＝{"$env": "AOS_HOME", ...}（env_file 只收字串＝絕對）；其餘＝絕對。
    path, oldp, newp, home = (os.path.normpath(a) for a in args[:4])
    dry = "--dry-run" in args[4:]
    doc, changes = load(path), []
    oldf = os.path.normpath(os.path.join(oldp, os.path.relpath(os.path.dirname(path), newp)))
    inside = lambda t, base: t == base or t.startswith(base + "/")
    def fix(v, where, env_ok=True):
        if not isinstance(v, str) or not v or os.path.isabs(v):
            return v
        f, h, p = v.partition("#")
        t = os.path.normpath(os.path.join(oldf, f))
        if inside(t, oldp):
            return v
        nv = {"$env": "AOS_HOME", "$path": "/" + os.path.relpath(t, home) + h + p} if env_ok and inside(t, home) else t + h + p
        changes.append("%s %s -> %s" % (where, json.dumps(v), json.dumps(nv)))
        return nv
    if not isinstance(doc, dict):
        sys.exit("%s is not a JSON object" % path)
    if os.path.basename(path) == "hookeds.json":
        for k, e in doc.items():
            if k != "description" and isinstance(e, dict) and "handler" in e:
                e["handler"] = fix(e["handler"], "/%s/handler" % k)
    else:
        o = doc.get("$override")
        if isinstance(o, list):
            doc["$override"] = [fix(x, "/$override/%d" % i) for i, x in enumerate(o)]
        elif o is not None:
            doc["$override"] = fix(o, "/$override")
        for k, e in (doc.get("tools") or {}).items():
            if isinstance(e, dict):
                if "path" in e:
                    e["path"] = fix(e["path"], "/tools/%s/path" % k)
                if "env_file" in e:
                    e["env_file"] = fix(e["env_file"], "/tools/%s/env_file" % k, env_ok=False)
    if changes and not dry:
        st = os.stat(path)
        write_atomic(path, json.dumps(doc, ensure_ascii=False, indent=1) + "\n")
        os.chmod(path, st.st_mode & 0o7777)
    print("; ".join(changes))
elif op == "mcp-probe":             # MCPJSON OLDPROC NEWPROC SECONDS → start aos-mcp with mcp.json's aos args (OLDPROC paths mapped to NEWPROC), initialize + tools/list, close
    # mcp.json 是上一次起 CLI 時 cli_mcp 寫的（搬過來還寫舊 stack；下次起 CLI 會照新位置重寫）：舊 stack 的路徑換成新的再起，看 aos-mcp 起不起得來、列不列得出工具。
    import subprocess
    cfg, oldp, newp, secs = args[0], os.path.normpath(args[1]), os.path.normpath(args[2]), float(args[3])
    srv = ((load(cfg).get("mcpServers") or {}).get("aos")) or {}
    if not isinstance(srv.get("args"), list):
        print("%s has no aos server with args" % cfg); sys.exit(1)
    mapped = lambda a: newp + a[len(oldp):] if isinstance(a, str) and (a == oldp or a.startswith(oldp + "/")) else a
    argv = [srv.get("command") or "aos-mcp"] + [mapped(a) for a in srv["args"]]
    msgs = [{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                                                                           "clientInfo": {"name": "home-move", "version": "0"}}},
            {"jsonrpc": "2.0", "method": "notifications/initialized"}, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}]
    try:
        p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, cwd="/")
    except OSError as e:
        print("cannot start %s: %s" % (argv[0], e)); sys.exit(1)
    try:
        out, err = p.communicate("".join(json.dumps(m) + "\n" for m in msgs), timeout=secs)   # stdin 關掉＝aos-mcp 答完就退
    except subprocess.TimeoutExpired:
        p.kill(); out, err = p.communicate()
        print("aos-mcp did not finish within %g s (killed pid %d)" % (secs, p.pid)); sys.exit(1)
    tools = None
    for line in out.splitlines():
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if isinstance(m, dict) and m.get("id") == 2:
            tools = ((m.get("result") or {}).get("tools"))
    errs = [l for l in err.splitlines() if ": error: " in l]
    if not isinstance(tools, list) or not tools:
        print("exit %s, no tools/list answer; %s" % (p.returncode, (errs or err.splitlines() or ["no stderr"])[-1])); sys.exit(1)
    i = argv.index("--own") if "--own" in argv else -1
    print("%d tools (exit %s; --own %s)" % (len(tools), p.returncode, argv[i + 1] if i >= 0 else "-"))
else:
    sys.exit("unknown op " + op)
PY
py() { python3 -I -c "$PYH" "$@"; }

alive() { [ -d "/proc/$1" ]; }
all_gone() { local p; for p in "$@"; do alive "$p" && return 1; done; return 0; }
aos_at() { py aos-at "$1" | tr '\n' ' ' | sed 's/ $//'; }   # cwd 正好是 DIR 的 aos 程式（llm kernel 在不在；使用者在那裡開的殼不算）
no_aos_at() { [ -z "$(aos_at "$1")" ]; }
pdesc() { local p; for p in "$@"; do alive "$p" && printf '%s(%s, cwd %s) ' "$p" "$(cat "/proc/$p/comm" 2>/dev/null)" "$(readlink "/proc/$p/cwd" 2>/dev/null)"; done; }
daemons_at() {   # cwd 正好是 DIR、執行檔是 aos-daemon 的行程（一台 daemon 一支）
    local p c
    for p in /proc/[0-9]*; do
        [ -O "$p" ] || continue
        c=$(readlink "$p/cwd" 2>/dev/null) || continue
        [ "$c" = "$1" ] || continue
        case $(readlink "$p/exe" 2>/dev/null) in */aos-daemon|*"/aos-daemon (deleted)") echo "${p#/proc/}";; esac
    done
}
close_screen() {   # DAEMON NAME SOCK：請它關畫面，關掉了才算
    aos aos-agent -d "$1" close -t "$2" >>"$LOG" 2>&1
    ! tmux -S "$3" has-session -t cli 2>/dev/null 9>&-
}
screen_open() { [ -S "$1" ] && tmux -S "$1" has-session -t cli 2>/dev/null 9>&-; }
# 有 daemon 握著 stack 資料夾的鎖（daemon.cpp check_running 鎖資料夾本身）＝在跑。只在「不該有東西正在起」的時候用（拿鎖那一瞬會擋住正要起的 daemon）。
locked() { [ -d "$1" ] || return 1; flock -n -E 75 "$1" true 9>&- ; [ $? -eq 75 ]; }
daemon_up() { [ -d "$1" ] && aos aos-daemon-ctl -d "$1" ping --timeout-s 3 >/dev/null 2>&1; }
table() { aos aos-daemon-ctl -d "$1" ls -j 2>/dev/null | py table; }
row_phase() { table "$1" | awk -v n="$2" '$1==n {print $2}'; }
wait_every() {   # SECONDS STEP DESC CMD… ：每 STEP 秒試一次
    local t=$1 step=$2 desc=$3 end=$((SECONDS + $1)); shift 3
    while :; do
        "$@" && return 0
        [ $SECONDS -ge $end ] && { say "timed out after ${t}s waiting for: $desc"; return 1; }
        sleep "$step"
    done
}
wait_until() { local t=$1; shift; wait_every "$t" 1 "$@"; }   # SECONDS DESC CMD… ：每秒試一次
listing() { LC_ALL=C ls -A "$1" 2>/dev/null | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'; }
want_listing() { printf '%s\n' "$@" | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'; }
all_running() {   # STACK NAME… ：每一列都 running
    local t n; t=$(table "$1") || return 1; shift
    for n in "$@"; do grep -qx "$n running" <<<"$t" || return 1; done
}
same_fs() { [ "$(stat -c %d "$1")" = "$(stat -c %d "$2")" ]; }
backup_mv() {   # SRC DEST：DEST 已在就停（不蓋）
    [ -e "$2" ] && { fail "backup $2 already exists; not overwriting"; return 1; }
    mkdir -p "$(dirname "$2")" && mv -n -T -- "$1" "$2" && [ -e "$2" ] && [ ! -e "$1" ] || { fail "could not move $1 to $2"; return 1; }
    say "moved $1 -> $2"
}
ps_line() { echo "pgrep -u $USER -af aos-daemon (pid cwd):"; local p; for p in $(pgrep -u "$USER" aos-daemon); do echo "  $p $(readlink /proc/$p/cwd 2>/dev/null)"; done; }

# 舊樹還活著的行程（py procscan）：舊表上記的 pid、AOS_STACK 指進舊 stack（或退路夾裡那份）的、根 daemon 的父行程 aos-exec，加上它們的子孫。
# 只是 cwd 在舊樹底下、沒有 AOS_STACK 的（使用者的終端機分頁、aos-frontend serve 只帶 AOS_DAEMON、aos-agent open 兩個都沒帶）不算：
# 腳本不收也不等它們，只列成 warning（warn_strays）。11-22 13:53 真跑就是被這種分頁擋到 stop-old 逾時。
procscan() {
    local f tables=()
    for f in "$OLD_STACK/procs_state.json" "$HM_RETIRE/.stack/procs_state.json"; do [ -f "$f" ] && tables+=("$f"); done
    py procscan "$OLD_STACK:$HM_RETIRE/.stack" "$HM_OLD:$HM_RETIRE" "${tables[@]}"
}
old_pids() { procscan | awk -F'\t' '$1=="own" {print $2}'; }
no_old_pids() { [ -z "$(old_pids)" ]; }
warn_strays() {   # WHEN：列出留著的非舊樹行程，不擋；回 0
    local when=$1 k p why cwd cmd n=0 moved=0 daemon=0
    while IFS=$'\t' read -r k p why cwd cmd; do
        n=$((n + 1))
        case $cwd in "$OLD_STACK"|"$OLD_STACK"/*|"$HM_RETIRE"|"$HM_RETIRE"/*) moved=1;; esac
        [[ $why == *AOS_DAEMON* ]] && daemon=1
        warn "$when: left running, not part of the old tree (no AOS_STACK): pid $p, cwd $cwd, command: $cmd$([[ $why == *AOS_DAEMON* ]] && echo "; its AOS_DAEMON names $OLD_STACK")"
    done < <(procscan | grep '^stray')
    [ $n = 0 ] && return 0
    warn "$when: these $n are the user's own terminal tabs or programs; home-move neither stops nor waits for them. After the move the user closes those tabs (or cd's out)."
    [ $moved = 1 ] && warn "$when: a process whose cwd is under $OLD_STACK keeps working: retire-old renames the folder, so its cwd moves along to $HM_RETIRE/.stack/... (it then sits in the retired copy, not in $STACK)"
    [ $daemon = 1 ] && warn "$when: a program with AOS_DAEMON=$OLD_STACK (aos-frontend serve, say) still talks to the old root, which is gone; restart it against the new root (AOS_DAEMON=$STACK)"
    return 0
}
under_old_tree() {   # 這支腳本是不是舊樹行程的子孫（停舊根會連自己一起停）
    local olds p=$$ pp
    olds=" $(old_pids | tr '\n' ' ') "
    while [ "$p" -gt 1 ] 2>/dev/null; do
        case $olds in *" $p "*) return 0;; esac
        pp=$(sed 's/.*) //' "/proc/$p/stat" 2>/dev/null | cut -d' ' -f2) || break   # 指令名可能有空白（tmux: client），切掉括號再取
        p=$pp
    done
    return 1
}

# tmux 視窗裡跑的一支前台 daemon：寫成 runner 檔（值已展開；只 export 需要的變數），再開一個視窗跑它
make_runner() {   # FILE DIR LOGFILE KEY(keep|drop) LLMK CMD…
    local f=$1 dir=$2 log=$3 key=$4 llmk=$5; shift 5
    {
        echo '#!/bin/bash'
        echo "# runner written by home-move at $(date '+%F %T'): one daemon in the foreground of a tmux window; its output goes to the log below"
        echo 'for v in $(compgen -e | grep -E "^(AOS_|CLAUDECODE$|CLAUDE_)"); do unset "$v"; done'
        echo 'unset TMUX TMUX_PANE'
        [ "$key" = drop ] && echo 'unset LITELLM_KEY   # the root does not need it; agents then do not inherit it'
        printf 'export HOME=%q AOS_HOME=%q\n' "$HM_HOME" "$HM_AOS_HOME"
        echo '. "$AOS_HOME/env.sh" || exit 1   # clears AOS_* but AOS_HOME, puts bin/ on PATH'
        [ -z "$HM_PATH_PREPEND" ] || printf 'export PATH=%q:"$PATH"\n' "$HM_PATH_PREPEND"
        [ -z "$llmk" ] || printf 'export AOS_LLM_KERNEL=%q\n' "$llmk"
        printf 'cd %q || exit 1\n' "$dir"
        printf 'echo "== $(date "+%%F %%T") start (pid $$): %s" >>%q\n' "$*" "$log"
        printf 'exec'; printf ' %q' "$@"; printf ' >>%q 2>&1\n' "$log"
    } > "$f"
    chmod 755 "$f"
}
open_window() {   # NAME RUNNER
    if tm has-session -t "=$HM_TMUX_SESSION" 2>/dev/null; then
        tm new-window -d -t "=$HM_TMUX_SESSION:" -n "$1" "bash $(printf %q "$2")" >>"$LOG" 2>&1
    else
        tm new-session -d -s "$HM_TMUX_SESSION" -n "$1" "bash $(printf %q "$2")" >>"$LOG" 2>&1
    fi || { fail "tmux could not open window $1"; return 1; }
    say "tmux window $1 opened: tmux -S $HM_TMUX_SOCK attach -t $HM_TMUX_SESSION   (its log: $HM_WORK/$1.log)"
}

