{
 "kind": "claude",
 "flags": [
  "--tools",
  "Read,Write,Edit,Glob,Grep,Bash,Agent,Skill,Artifact,ArtifactComments,ArtifactData,ArtifactCheck,WebSearch,WebFetch,ToolSearch,Monitor",
  "--permission-mode",
  "dontAsk",
  "--allowedTools",
  "Read,Glob,Grep,Write,Edit,Bash,Agent,Skill,Artifact,ArtifactComments,ArtifactData,ArtifactCheck,WebSearch,WebFetch,ToolSearch,Monitor,mcp__plugin_discord_discord",
  "--no-chrome",
  "--setting-sources",
  "project,local",
  "--channels",
  "plugin:discord@claude-plugins-official"
 ],
 "claude_mcp": [
  "user",
  "project",
  "local"
 ],
 "tools_sub": "tools_sub.json",
 "timeout_ms": 0,
 "settings": {
  "hooks": {
   "PreCompact": [
    {
     "hooks": [
      {
       "type": "command",
       "command": "python3 \"$AOS_CLI_DEF/compact_hook\" pre",
       "timeout": 60
      }
     ]
    }
   ],
   "PostCompact": [
    {
     "hooks": [
      {
       "type": "command",
       "command": "python3 \"$AOS_CLI_DEF/compact_hook\" post",
       "timeout": 60
      }
     ]
    }
   ],
   "SessionStart": [
    {
     "matcher": "compact",
     "hooks": [
      {
       "type": "command",
       "command": "python3 \"$AOS_CLI_DEF/compact_hook\" start",
       "timeout": 60
      }
     ]
    }
   ]
  },
  "skillOverrides": {
   "anthropic-skills:built-in-browser": "off",
   "anthropic-skills:chrome-browser": "off",
   "anthropic-skills:computer-use": "off",
   "anthropic-skills:deep-research": "off",
   "anthropic-skills:docs": "off",
   "anthropic-skills:docx": "off",
   "anthropic-skills:google-workspace": "off",
   "anthropic-skills:import-memory": "off",
   "anthropic-skills:morning": "off",
   "anthropic-skills:pdf": "off",
   "anthropic-skills:pptx": "off",
   "anthropic-skills:skill-creator": "off",
   "anthropic-skills:xlsx": "off",
   "cowork-plugin-management:cowork-plugin-customizer": "off",
   "cowork-plugin-management:create-cowork-plugin": "off"
  },
  "enabledPlugins": {
   "cc-plugin-easel@builtin": false,
   "claude-md-management@claude-plugins-official": false,
   "code-review@claude-plugins-official": false,
   "code-simplifier@claude-plugins-official": false,
   "commit-commands@claude-plugins-official": false,
   "context7@claude-plugins-official": false,
   "feature-dev@claude-plugins-official": false,
   "github@claude-plugins-official": false,
   "skill-creator@claude-plugins-official": false,
   "discord@claude-plugins-official": true
  },
  "tui": "fullscreen"
 }
}
