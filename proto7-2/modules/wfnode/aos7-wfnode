#!/usr/bin/env python3
"""替 aos node 建立工作流並記錄續行點。"""
import argparse
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
import aos7_wfnode as wfnode


def main():
    parser = argparse.ArgumentParser(
        description='替 AI 準備一個「工作筆記資料夾」(node)，並記下每次停在哪。',
        epilog="例：aos7-wfnode init /tmp/mynode；aos7-wfnode state /tmp/mynode '寫完第一版，下一步跑測試'；"
               'aos7-wfnode check /tmp/mynode',
        formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True, metavar='{init,state,check}',
                                     help='要做的事')
    setup = commands.add_parser('init', help='裝好資料夾（新 node 跑一次；重跑安全，只補缺的）')
    setup.add_argument('node', help='資料夾路徑，不存在會自動建')
    setup.add_argument('--flavor', help='進階：要裝哪些模板包，逗號分隔；不給＝aos node 標準配備')
    record = commands.add_parser('state', help="記一行「停在哪、下一步」；不給句子＝印出最新那份")
    record.add_argument('node', help='init 過的資料夾')
    record.add_argument('line', nargs='?', help="一行文字，例：'寫完第一版，下一步跑測試'")
    inspect = commands.add_parser('check', help='體檢：印 OK（退出碼 0）＝資料夾沒壞')
    inspect.add_argument('node', help='init 過的資料夾')
    args = parser.parse_args()
    node = Path(os.path.abspath(args.node))
    try:
        if args.command == 'init':
            return wfnode.init(node, args.flavor)
        if args.command == 'check':
            return wfnode.check(node)
        return wfnode.state(node, args.line)
    except (OSError, ValueError) as error:
        print(f'無法完成：{error}', file=sys.stderr)
        return 2 if isinstance(error, ValueError) else 1


if __name__ == '__main__':
    sys.exit(main())
