#!/usr/bin/env python3
"""aos7-subd：子 daemon 包的包裝程式——讓一個 node 的任務擁有一個子空間根（spec S-21 路一；modules/subd/README.md）。

    aos7-subd <subroot> [--allow-stop] -- <argv...>

以任務身分被 tick 起（要有 AOS7_ROOT／AOS7_NODE_ID／AOS7_TID）。<subroot> 是空間路徑（相對空間根，跟 node id 同一套）。
起之前檢查，不合就印原因、退出碼 1、什麼都不起：
- 子根要在自己的 node 底下、不能是 node 本身、不能包住父 daemon 已登記的 node（讀 `$AOS7_ROOT/.aosd/nodes.json`）；
- `<subroot>/.aosd/stopped.json` 存在（被允許的 stop 停過，刪掉才再起）；
- 已有別的 aos7-subd 認領這個子根（`<subroot>/.aosd/subd.lock`），或子根 daemon.lock 有人拿著（例如人手起的）。
通過後寫 `<subroot>/.aosd/stop-guard.json`（核心的通用守門檔：`allow`＝有沒有 --allow-stop、`note` 說屬於誰）與
`owner.json`（給人看：owner 塊與現役 daemon 的 pid），設 `AOS7_SUBROOT`（子根絕對路徑）後起 argv 當子程序並等它。
argv 結束後問 `allowed_stop`（被允許的 stop 停過沒有：子根 status.json 是 `stopped: true`，且 ctl-done 有本代起點之後的
成功 stop 回條——控制檔 stop 一定留回條，SIGTERM（父 kill）不留）：成立就提交，先寫 `stopped.json`＝`{"by","why","at"}`（那份回條）
再寫生命週期 `stopped`；父 node 的 keep 項之後再起它會被擋。stop 生效但回條沒寫成（本代有 last_ctl_error，A8-09）＝不知道，
也照被允許的 stop 提交（`unconfirmed`），不轉成可回收。退出碼照 argv（被訊號殺＝128＋訊號號）。

重開前回收（A5-01）：父 kill 只給 1 秒寬限，子 daemon 不一定收得完自己的任務；核心重開會把還活著的任務當活接回來（§5.4）。
所以包自己記生命週期（`<subroot>/.aosd/subd-life.json`），起 argv 前收前代：
- 拿到 subd.lock 後，回收期間也拿著子根的 daemon.lock（有人拿著＝有 daemon 在跑，不起）；
- 生命週期記錄是 `running` 時先問同一個 `allowed_stop`（A6-01：stop 的提交在三個窗口被殺時記錄還是 running）：成立＝
  補完提交（stopped.json、生命週期 stopped）、退出碼 1、不回收；讀不到＝不知道＝不起、不收。`stopped.json` 還在而被擋時也順手
  補完生命週期（這樣人刪掉 stopped.json 再起就直接接回）；
- 從 `stopped` 接回時新 `running` 帶 `kept`：本代 daemon 起來之前被打斷（gen.json 早於 since），下一次仍不回收（MC-01）；
- 其他（不是 `stopped`）就回收（`recovering` 的 `prev` 只留最初那份前代記錄，R8-18）：子根裡前代的 launcher（子 daemon、tick、tock）、runner、任務，
  掃到一次「確定沒有」才算乾淨；paused node 一樣收（照環境身分掃，不看 pause）；
- 乾淨了先寫本代 `running` 記錄，再放 daemon.lock、起 argv；掃描讀不完整、收不掉、記錄讀不到＝印原因、退出碼 1、不起，
  記錄留著，下一次再接著收。
"""
import fcntl
import os
import signal
import subprocess
import sys
sys.dont_write_bytecode = True
import time

TOP = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.path.join(TOP, "lib"))
import aos7_proc  # noqa: E402
from aos7_fs import N, OK, Unknown, fact, now, test_point, write_json  # noqa: E402

LIFE = "subd-life.json"   # 包自有的生命週期記錄：running／recovering／stopped
REAP_PASSES = 5           # 回收最多幾輪「掃描→收」；之後還掃得到＝收不掉
RUNNER_WAIT = 0.5         # 任務死後等 runner 自己寫完 exit.json 退出的秒數，還在才收它


def norm(p):
    """空間路徑正規化；絕對路徑或跑出空間根回 None。"""
    if not isinstance(p, str) or os.path.isabs(p):
        return None
    q = os.path.normpath(p).replace(os.sep, "/")
    return None if q == ".." or q.startswith("../") else q


def check(root, node_id, sub):
    """子根位置檢查：回 (子根絕對路徑, None) 或 (None, 原因)。"""
    sp = norm(sub)
    if sp is None:
        return None, "subroot %r 要是空間根底下的相對路徑" % (sub,)
    node = os.path.realpath(root if node_id in (".", "") else os.path.join(root, node_id))
    real = os.path.realpath(os.path.join(root, sp))
    if not real.startswith(node + os.sep):
        return None, "subroot %s 要在自己的 node（%s）底下，不能是 node 本身" % (sp, node_id)
    st, nj = fact(os.path.join(root, ".aosd", "nodes.json"))
    if st not in (OK, N):
        return None, "父 daemon 的 nodes.json %s，不知道子根有沒有包住已登記的 node，不起" % nj
    nodes = (nj or {}).get("nodes") if isinstance(nj, dict) else {}
    inside = sorted(n for n in (nodes or {})
                    if (nr := os.path.realpath(os.path.join(root, n))) == real or nr.startswith(real + os.sep))
    if inside:
        return None, "subroot %s 包住了父 daemon 已登記的 node %s" % (sp, ", ".join(inside))
    return real, None


def take_lock(path):
    """非阻塞拿 path 的 flock，回開著的檔（拿著）或 None（有人拿著）。鎖檔不 unlink（flock 綁 inode）；fd 不傳給子程序。"""
    f = open(path, "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


def leftovers(sub):
    """子根 sub 裡前代留下的活程序，分三類回 {"launcher", "task", "runner"}：
    - task／runner：環境 AOS7_NODE 是 sub 或在它底下、有 AOS7_TID（核心的任務身分，spec §5.2；巢狀子空間也在內）；
    - launcher：環境 AOS7_SUBROOT 正好是 sub（這個包起的子 daemon 與它的 tick／tock）。
    不含自己與祖先；sibling 子根的路徑不同（比到 `/` 為止），不會算進來。掃描讀不完整丟 Unknown（不能說乾淨）。"""
    node_eq = b"AOS7_NODE=" + sub.encode()
    node_in = node_eq + b"/"
    sub_eq = b"AOS7_SUBROOT=" + sub.encode()
    skip = aos7_proc.me_and_ancestors()
    out = {"launcher": [], "task": [], "runner": []}
    for pid in aos7_proc.all_pids():
        if pid in skip:
            continue
        env = aos7_proc.environ_of(pid)
        if not env:
            continue
        task = any(x == node_eq or x.startswith(node_in) for x in env) and any(x.startswith(b"AOS7_TID=") for x in env)
        if not task and sub_eq not in env:
            continue
        st = aos7_proc.stat_of(pid)
        if st is None or st[0] == "Z":
            continue
        out["runner" if aos7_proc.is_runner(pid) else "task" if task else "launcher"].append(pid)
    return out


def reap(sub):
    """收子根 sub 裡前代的程序，回 (乾淨?, 說明, 收了幾個)。每輪：先打 launcher（TERM 後立刻 KILL，tick 收到 TERM 會把動作做完、
    可能再起 runner）→ 任務照核心 kill 的寬限（TERM、最多等 1 秒、KILL）→ 等 runner 自己寫完 exit.json 退出，還在的再收；
    下一輪重掃。要一次掃描確定沒有才算乾淨。收程序都經核心的 aos7_proc（群組連同後代、不打自己與祖先的群組）。"""
    total = 0
    try:
        for i in range(REAP_PASSES):
            found = leftovers(sub)
            n = sum(len(v) for v in found.values())
            if not n:
                return True, "前代已空（收了 %d 個程序、%d 輪）" % (total, i), total
            total += n
            test_point("subd-reaping")
            if found["launcher"]:
                aos7_proc.kill_groups(aos7_proc.groups_of(found["launcher"]), grace=0)
            if found["task"]:
                aos7_proc.kill_groups(aos7_proc.groups_of(found["task"]))
            end = time.monotonic() + RUNNER_WAIT
            runners = found["runner"]
            while runners and time.monotonic() < end:
                time.sleep(0.02)
                runners = [p for p in runners if aos7_proc.proc(p)[0] != N]
            if runners:
                aos7_proc.kill_groups(aos7_proc.groups_of(runners))
        left = leftovers(sub)
    except Unknown as e:
        return False, "掃描子根的程序讀不完整，不知道前代收乾淨沒有（%s）" % e, total
    if not any(left.values()):
        return True, "前代已空（收了 %d 個程序）" % total, total
    return False, "收了 %d 輪還有前代程序 %s" % (REAP_PASSES, sorted(sum(left.values(), []))), total


def allowed_stop(aosd, since, allow=True):
    """被允許的 stop 停過沒有（A6-01）：起點與收尾共用的持久判定，不信生命週期的 `stopped`（那只是快取）。
    成立＝子根 status.json 是 `stopped: true`，**且** ctl-done 有 `op: stop`、`result.ok: true`、`result.at ≥ since`（本代
    running 記錄的起點）的回條——SIGTERM（父 kill）不留回條（核心 §2.3）；舊於 since 的是上一代的 stop，不算。
    回條沒寫成（A8-09）：核心處理例外時刪請求、記 `last_ctl_error`，那件可能就是已生效的 stop——本代（at ≥ since）有它、
    這代又允許 stop（allow 不是 False）＝不知道，不轉成可回收：當被允許的 stop（`unconfirmed: true`）。不解析錯誤文字。
    成立回 {"by","why","at"[,"unconfirmed"]}（寫 stopped.json 用），不成立回 None；status／回條讀不到丟 Unknown（不起、不收）。"""
    if not isinstance(since, str):
        return None   # 記錄沒有起點（舊版包寫的）：判不出是不是本代的 stop，照前代沒收乾淨處理
    st, status = fact(os.path.join(aosd, "status.json"))
    if st == N:
        return None
    if st != OK or not isinstance(status, dict):
        raise Unknown("子根 status.json %s" % (status if st != OK else "不是物件"))
    if status.get("stopped") is not True:
        return None
    try:
        names = os.listdir(os.path.join(aosd, "ctl-done"))
    except FileNotFoundError:
        return None
    except OSError as e:
        raise Unknown("列不出子根 ctl-done：%s" % e)
    best = None
    for n in names:
        if n.startswith(".") or not n.endswith(".json"):
            continue
        st, c = fact(os.path.join(aosd, "ctl-done", n))
        if st == N:
            continue
        if st != OK:
            raise Unknown("子根回條 %s %s" % (n, c))
        if not isinstance(c, dict):
            raise Unknown("子根回條 %s 不是物件" % n)
        res = c.get("result")
        if c.get("op") == "stop" and isinstance(res, dict) and res.get("ok") is True and isinstance(res.get("at"), str) \
                and res["at"] >= since and (best is None or res["at"] > best["at"]):
            best = {"by": c.get("by"), "why": c.get("why"), "at": res["at"]}
    err = status.get("last_ctl_error")
    if best is None and allow is not False and isinstance(err, dict) and isinstance(err.get("at"), str) and err["at"] >= since:
        best = {"by": None, "at": err["at"], "unconfirmed": True,
                "why": "status 是 stopped、本代有控制檔處理例外（last_ctl_error：%s）而沒有 stop 回條：可能是回條沒寫成的"
                       "被允許的 stop，不收；確認後刪掉 stopped.json 就照核心接回" % err.get("file")}
    return best


def kept_pending(aosd, life):
    """MC-01：`running` 記錄帶 `kept`（從被允許的 stop 接回中）且本代還沒有 daemon 起來過（gen.json 的 at 早於 since）
    ＝保留的任務還沒被接回，仍照被允許的 stop 不回收。gen.json 讀不到丟 Unknown。"""
    if life.get("state") != "running" or not isinstance(life.get("kept"), dict) or not isinstance(life.get("since"), str):
        return False
    st, g = fact(os.path.join(aosd, "gen.json"))
    if st == N:
        return True
    if st != OK or not isinstance(g, dict):
        raise Unknown("子根 gen.json %s" % (g if st != OK else "不是物件"))
    return not (isinstance(g.get("at"), str) and g["at"] >= life["since"])


def commit_stop(aosd, life_path, rec, life):
    """提交被允許的 stop：先 stopped.json（還沒有才寫），再生命週期 `stopped`（life 是要寫的內容）。順序固定：
    中間被殺時記錄還是 running，下一代用 allowed_stop 判得出來、補完（A6-01）。"""
    test_point("subd-stop-seen")
    if fact(os.path.join(aosd, "stopped.json"))[0] == N:
        write_json(os.path.join(aosd, "stopped.json"), rec)
    test_point("subd-stop-marked")
    write_json(life_path, dict(life, state="stopped", at=now()))


def finish_stop(aosd, life_path, me):
    """生命週期是 `running` 而 allowed_stop 成立＝前代的 stop 提交被中斷：補完（不回收）。回 True＝補完了（被允許的 stop 停過）、
    False＝不是。記錄讀不到或 status／回條讀不到丟 Unknown。呼叫的人拿著 subd.lock 與 daemon.lock。"""
    st, life = fact(life_path)
    if st == N:
        return False
    if st != OK or not isinstance(life, dict):
        raise Unknown("%s %s" % (LIFE, life if st != OK else "內容不合"))
    if life.get("state") != "running":
        return False
    rec = allowed_stop(aosd, life.get("since"), life.get("allow_stop"))
    if rec is None:
        return False
    commit_stop(aosd, life_path, rec, {"subroot": life.get("subroot"), "owner": life.get("owner"),
                                        "since": life.get("since"), "allow_stop": life.get("allow_stop"), "finished_by": me})
    return True


def main(argv):
    if argv in (["--help"], ["-h"]):
        print("用法：aos7-subd <subroot> [--allow-stop] -- <argv...>")
        return 0
    allow = "--allow-stop" in argv[:argv.index("--")] if "--" in argv else False
    head = [a for a in (argv[:argv.index("--")] if "--" in argv else argv) if a != "--allow-stop"]
    cmd = argv[argv.index("--") + 1:] if "--" in argv else []
    if len(head) != 1 or not cmd:
        print("aos7-subd: 參數不合，要給 aos7-subd <subroot> [--allow-stop] -- <argv...>。例：aos7-subd a/sub -- aos7-daemon a/sub", file=sys.stderr)
        return 2
    e = os.environ
    root, node_id, tid = e.get("AOS7_ROOT"), e.get("AOS7_NODE_ID"), e.get("AOS7_TID")
    if not (root and node_id and tid):
        print("aos7-subd: 要以任務身分起（缺 AOS7_ROOT／AOS7_NODE_ID／AOS7_TID）。在 tasks.json 登記，例如 argv=[\"aos7-subd\", \"a/sub\", \"--\", \"aos7-daemon\", \"a/sub\"]", file=sys.stderr)
        return 2
    sub, why = check(root, node_id, head[0])
    if why:
        print("aos7-subd: %s，沒起" % why, file=sys.stderr)
        return 1
    # D9：子根整棵是這個任務合法寫的地方。通用 AOS7_AUDIT_ALLOW（os.pathsep 分隔的絕對路徑）自己與 argv 都帶著，
    # 給寫入紀錄類模組看；這個包不認識 audit。子 daemon 起的任務拿不到（核心只傳自己的 AOS7_*）
    # 路徑裡有分隔符就不加（拆開會豁免錯的地方）：寧可紀錄多報 ok:false
    if os.pathsep not in sub:
        e["AOS7_AUDIT_ALLOW"] = os.pathsep.join(x for x in (e.get("AOS7_AUDIT_ALLOW"), sub) if x)
    aosd = os.path.join(sub, ".aosd")
    os.makedirs(aosd, exist_ok=True)
    life_path = os.path.join(aosd, LIFE)
    me = {"node": node_id, "tid": tid, "run": e.get("AOS7_RUN"), "pid": os.getpid()}
    st, stopped = fact(os.path.join(aosd, "stopped.json"))
    if st != N:
        # 被擋時順手補完生命週期（stopped.json 寫了、life 還沒寫就被殺的窗口）：之後人刪 stopped.json 再起就直接接回
        lk = take_lock(os.path.join(aosd, "subd.lock"))
        dl = lk and take_lock(os.path.join(aosd, "daemon.lock"))
        if dl:
            try:
                finish_stop(aosd, life_path, me)
            except Unknown:
                pass   # 補不完也照樣擋；下一次再看
        s = stopped if st == OK and isinstance(stopped, dict) else {}
        print("aos7-subd: 子 daemon（%s）已被 %s 在 %s stop%s；刪掉 %s 就會再起" % (
            head[0], s.get("by") or "?", s.get("at") or "?", "（%s）" % s["why"] if s.get("why") else "",
            os.path.join(aosd, "stopped.json")), file=sys.stderr)
        return 1
    lk = take_lock(os.path.join(aosd, "subd.lock"))   # 全程拿著，直到這個程序結束
    if lk is None:
        print("aos7-subd: 子根 %s 已經有別的 aos7-subd 認領，沒起" % head[0], file=sys.stderr)
        return 1
    dl = take_lock(os.path.join(aosd, "daemon.lock"))  # 回收期間拿著：其他 daemon 起不來
    if dl is None:
        print("aos7-subd: 子根 %s 已經有 daemon 在跑（不是這個包裝起的），沒起" % head[0], file=sys.stderr)
        return 1
    st, life = fact(life_path)
    if st not in (OK, N) or (st == OK and not (isinstance(life, dict) and isinstance(life.get("state"), str))):
        print("aos7-subd: %s %s，不知道前代收乾淨沒有，沒起；確認子根裡沒有前代程序後修好或刪掉它" % (
            LIFE, life if st != OK else "內容不合"), file=sys.stderr)
        return 1
    try:
        done = finish_stop(aosd, life_path, me)
        keep = st == OK and (life["state"] == "stopped" or kept_pending(aosd, life))
    except Unknown as ex:
        print("aos7-subd: 不知道前代是不是被允許的 stop 停的（%s），不收也不起；記錄留著，下一次再看" % ex, file=sys.stderr)
        return 1
    if done:
        print("aos7-subd: 子 daemon（%s）被允許的 stop 停過（前代的記錄提交被中斷，已補完）；不回收、沒起；刪掉 %s 就會再起" % (
            head[0], os.path.join(aosd, "stopped.json")), file=sys.stderr)
        return 1
    if not keep:
        # 前代沒有照允許的 stop 結束（或沒有記錄＝不知道前代怎麼結束）：先收再起。回收一再被打斷時 prev 只留最初那份
        # 前代記錄、attempt 計次，不一層包一層（R8-18）
        again = st == OK and life["state"] == "recovering"
        n_try = life.get("attempt") if again and isinstance(life.get("attempt"), int) else 1
        write_json(life_path, {"state": "recovering", "subroot": head[0], "owner": me, "at": now(),
                               "attempt": n_try + 1 if again else 1,
                               "prev": life.get("prev") if again else life if st == OK else None})
        clean, msg, n = reap(sub)
        if not clean:
            print("aos7-subd: %s；記錄留著，下一次再收，沒起" % msg, file=sys.stderr)
            return 1
        if n:
            print("aos7-subd: 子根 %s %s" % (head[0], msg), file=sys.stderr)   # 進 out.log：前代留了東西
        test_point("subd-reaped")
    since = now()
    rec = {"state": "running", "subroot": head[0], "owner": me, "since": since, "allow_stop": allow}
    if keep:   # 從被允許的 stop 接回：新 daemon 起來之前被打斷，下一次仍不回收（MC-01）
        rec["kept"] = life["kept"] if isinstance(life.get("kept"), dict) else {"stopped_at": life.get("at"),
                                                                              "since": life.get("since")}
    write_json(life_path, rec)
    test_point("subd-before-argv")
    owner = {"node": node_id, "tid": tid, "allow_stop": allow}
    write_json(os.path.join(aosd, "stop-guard.json"), {
        "allow": allow, "note": "這個 daemon 屬於 node %s（任務 %s）%s" % (
            node_id, tid, "，允許外部 stop" if allow else "；要停請 %s 那項加 --allow-stop，或由 %s kill 這個任務" % (
                node_id, node_id))})
    got_term = []

    def on_term(signum, _frame):
        got_term.append(signum)
        if child is not None and child.poll() is None:
            child.send_signal(signum)
    child = None
    for s in (signal.SIGTERM, signal.SIGINT):
        signal.signal(s, on_term)
    dl.close()   # 放掉 daemon.lock，讓 argv 的子 daemon 拿
    if got_term:  # 起之前就被收：不起，running 記錄留著，下一代照樣先收
        return 128 + got_term[0]
    child = subprocess.Popen(cmd, env=dict(e, AOS7_SUBROOT=sub))
    write_json(os.path.join(aosd, "owner.json"), {"owner": owner, "daemon": {"pid": child.pid, "since": now()}})
    while True:
        try:
            rc = child.wait()
            break
        except InterruptedError:
            continue
    # 收尾跟起點同一個判定（A6-01）：被允許的 stop 是擁有者要的結束，提交後下一代不回收（不帶 kill 的 stop 留下的任務照核心接回）。
    # 不成立或讀不到就不寫：running 記錄留著，下一代再用同一個判定看一次（讀到了照樣補完、不回收）
    try:
        rec = allowed_stop(aosd, since, allow)
    except Unknown:
        rec = None
    if rec is not None:
        commit_stop(aosd, life_path, rec, {"subroot": head[0], "owner": me, "since": since, "allow_stop": allow})
    return 128 - rc if rc < 0 else rc


if __name__ == "__main__":
    try:
        code = main(sys.argv[1:])
    except Exception:
        print("aos7-subd: 不確定：入口遇到未預期錯誤，無法確認是否完成。證據留著，先檢查後再跑", file=sys.stderr)
        code = 3
    sys.exit(code)
