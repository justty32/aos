#!/usr/bin/env python3
import sys
sys.dont_write_bytecode = True

if any(arg in ("--help", "-h") for arg in sys.argv[1:]):
    print("aos7-llmdiag 已併入 aos7-diag：改用 aos7-diag --llm <node>（r5 移除本入口）")
    raise SystemExit(0)
print("aos7-llmdiag: 這個指令已併入 aos7-diag。改用 aos7-diag --llm <node>", file=sys.stderr)
raise SystemExit(1)
