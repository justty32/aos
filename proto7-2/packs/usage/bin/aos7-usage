#!/usr/bin/env python3
"""轉址：aos7-usage 已併入 aos7-metrics（舊程式在 proto7-2/archive/usage/）。"""
import sys

path = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith('-') else 'PATH'
path = ' '.join(path.splitlines())
print(f"aos7-usage: 這個工具已停用，功能併進 aos7-metrics。看每個模型用多少，從 repo 根跑：python3 proto7-2/modules/metrics/aos7-metrics job {path} --by model（說明見 proto7-2/modules/metrics/README.md）", file=sys.stderr)
sys.exit(1)
