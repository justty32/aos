#!/usr/bin/env python3
"""aos-exec 的命令列入口——薄薄一層，真東西在 ../lib/aos_exec.py。"""
# 由 aos7-run 呼叫以執行 inst JSON；輸入與結果交 aos_exec 處理（spec §4.1，S-12）。
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))

import aos_exec  # noqa: E402

if __name__ == "__main__":
    sys.exit(aos_exec.main())
