#!/usr/bin/env python3
"""aos7-wait-tock：給非 Python 任務用——等 `$AOS7_TASK/tock.json` 的回合數大於 --after，印出回合數（spec.md 第 5 節）。

    aos7-wait-tock [--after N] [--timeout 秒] [--task 任務資料夾]

逾時退出碼 1、什麼都不印。sh 裡：`r=$(aos7-wait-tock --after "$r")`。

由人或任務呼叫，唯讀 --task（預設 AOS7_TASK）下的 tock.json，不寫檔（spec §5.5，S-11）。
讀不到或未見較新回合就繼續等；逾時回 1，缺任務路徑回 2。只觀察最新通知，不補漏掉的回合。
"""
import argparse
import os
import sys
TOP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path[:0] = [os.path.join(TOP, "modules", "tools"), os.path.join(TOP, "lib")]   # 本體在工具包
from aos7_taskside import wait_tock  # noqa: E402

if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--after", type=int, default=0)
    ap.add_argument("--timeout", type=float, default=None)
    ap.add_argument("--task", default=os.environ.get("AOS7_TASK"))
    a = ap.parse_args()
    if not a.task:
        print("aos7-wait-tock: 沒有 AOS7_TASK，也沒給 --task", file=sys.stderr)
        sys.exit(2)
    # spec §5.5：把跨語言的等待委派同一輪詢規則；未知先等，沒有新通知不印假回合。
    r = wait_tock(a.task, a.after, timeout=a.timeout)
    if r is None:
        sys.exit(1)
    print(r)
