sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import aos7_step  # noqa: E402
if __name__ == "__main__":
    try:
        code = aos7_step.main()
    except Exception:
        print("aos7-step: 不確定：入口遇到未預期錯誤，無法確認是否完成。證據留著，先檢查後再跑", file=sys.stderr)
        code = 3
    sys.exit(code)
