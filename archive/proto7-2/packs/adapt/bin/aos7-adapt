#!/usr/bin/env python3
"""aos7-adapt 的命令列入口——本體在 ../aos7_adapt.py（adapt 任務包）。"""
import os
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import aos7_adapt  # noqa: E402
if __name__ == "__main__":
    try:
        code = aos7_adapt.main()
    except Exception:
        print("aos7-adapt: 不確定：入口遇到未預期錯誤，無法確認是否完成。證據留著，先檢查後再跑", file=sys.stderr)
        code = 3
    sys.exit(code)
