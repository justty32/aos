{"v": 1,
 "note": "第一刀固定 CSV 工具卡：argv 樣板、參數（型別、角色、允許值）、產物、腳本來源與雜湊。finite／idempotent 只由卡決定，候選宣告無效。路徑 src 相對 packs/。",
 "answer_checker": "examples/csv-request/check_answer.py",
 "tools": {
  "csv.convert": {
   "script": {"src": "step/examples/csv/convert.py", "as": "convert.py",
              "sha256": "f5c03903a4e679a797d87eb8503316d6b89d5f2f90e5b4fb9a2dd14365b3b62e"},
   "argv": ["python3", "${job}/convert.py", "{src}", "{dst}", "{request}"],
   "params": {
    "src": {"type": "string", "role": "input", "value": "${job}/data.csv"},
    "dst": {"type": "string", "role": "write", "value": "${out}/data.json"},
    "request": {"type": "string", "role": "request", "value": "${request}"}},
   "finite": true, "idempotent": true,
   "writes": ["${out}", "<dst>.tmp（同目錄暫存，再 rename）"],
   "artifacts": ["${out}/data.json"]},
  "csv.stats": {
   "script": {"src": "step/examples/csv/stats.py", "as": "stats.py",
              "sha256": "75cb120eb82a52e84eeb41041ec5a0b5db17f1e5a329a6c156a3d5e25b132ed8"},
   "argv": ["python3", "${job}/stats.py", "{src}", "{request}", "{dst}"],
   "params": {
    "src": {"type": "string", "role": "read", "value": "${out}/data.json"},
    "request": {"type": "string", "role": "req", "tool": "csv.convert"},
    "dst": {"type": "string", "role": "write", "value": "${out}/report.json"}},
   "finite": true, "idempotent": true,
   "writes": ["${out}", "<dst>.tmp（同目錄暫存，再 rename）"],
   "artifacts": ["${out}/report.json"]}}}
