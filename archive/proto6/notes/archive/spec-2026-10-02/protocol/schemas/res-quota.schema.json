{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 resource quota",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "node_id": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "object",
          "properties": {
            "quota_us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "period_us": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "quota_us",
            "period_us"
          ]
        },
        "memory": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "bytes"
          ]
        },
        "pids": {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "max"
          ]
        },
        "llm": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pool_id": {
                "$ref": "common.schema.json#/$defs/ID"
              },
              "concurrent_requests": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "pool_id",
              "concurrent_requests"
            ]
          },
          "minItems": 1
        },
        "disk": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "bytes"
          ]
        }
      },
      "required": [],
      "description": "範本六類的配額欄位形狀固定；其他鍵是 kernel 自訂資源，形狀由定義它的 kernel 定（P-501、T-06）。"
    }
  },
  "required": [
    "version",
    "node_id",
    "seq",
    "resources"
  ]
}
