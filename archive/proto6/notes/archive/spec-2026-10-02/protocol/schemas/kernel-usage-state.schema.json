{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proto6 kernel-usage-state",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "member_id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "source_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "成員有 git 時，這次讀用量所釘的 commit；成員走 git 備援時為 null（S-207）。"
          },
          "source_journal_seq": {
            "description": "成員走 git 備援時，這次讀取時成員最新一筆完成紀錄的 seq（P-205），只當「有沒有新東西」的游標；有 git 或讀不到日誌時省略或 null（S-207）。",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at_ms": {
            "$ref": "common.schema.json#/$defs/TimeMs"
          },
          "status": {
            "enum": [
              "ok",
              "missing",
              "stale",
              "invalid"
            ]
          }
        },
        "required": [
          "member_id",
          "source_commit",
          "observed_at_ms",
          "status"
        ]
      }
    }
  },
  "required": [
    "version",
    "members"
  ]
}
