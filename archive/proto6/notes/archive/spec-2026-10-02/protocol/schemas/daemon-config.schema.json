{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "daemon 啟動設定（P-101）；持久檔，不認得的欄位忽略（C-07）",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "common_user": {
      "$ref": "daemon-registration.schema.json#/$defs/User"
    },
    "socket_path": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "shutdown_grace_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs"
    },
    "cgroup_root": {
      "$ref": "common.schema.json#/$defs/NodeId",
      "description": "已準備好（或要 daemon 自己建）的 cgroup v2 子樹；明寫了卻準備不好就回 125。省略就自動偵測：systemd 確認 daemon 所在單位 Delegate=yes 才用（B-605）"
    },
    "create_cgroup": {
      "type": "boolean",
      "default": false,
      "description": "true＝cgroup 子樹不在時 daemon 自己建（同 --create-cgroup）；此時 cgroup_root 必填（B-605）"
    },
    "kill_escape_cgroups": {
      "type": "boolean",
      "default": false,
      "description": "true＝daemon 重啟與解除登記時，連 node 自開的子框（逃生口）一起收尾；預設不管（B-605，第十八批 Q19、納入 cgroup 與 git 疑-7）"
    },
    "disable": {
      "type": "array",
      "items": {
        "enum": [
          "quota"
        ]
      },
      "uniqueItems": true
    },
    "roots": {
      "type": "array",
      "items": {
        "$ref": "daemon-registration.schema.json#/$defs/TopRegistrationOpen"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "state_dir": {
      "$ref": "common.schema.json#/$defs/NodeId"
    },
    "pause_save_interval_ms": {
      "type": "integer",
      "minimum": 1,
      "default": 1000
    },
    "stop_mode": {
      "enum": [
        "immediate",
        "drain"
      ],
      "default": "immediate",
      "description": "SIGINT／SIGTERM 走立即停或排空停（B-604）"
    },
    "drain_timeout_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 600000
    },
    "mount_diag_max": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "default": 1024,
      "description": "掛載行程的診斷最多留幾筆，0＝不留（B-610）"
    },
    "mount_diag_ttl_ticks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "default": 1000,
      "description": "掛載行程的診斷結束後，掛它的上層再開幾格就淘汰（B-610；astra 審整理區裁定裁-2，取代 mount_diag_ttl_ms）"
    }
  },
  "required": [
    "version",
    "socket_path",
    "state_dir",
    "roots"
  ],
  "if": {
    "properties": {
      "create_cgroup": {
        "const": true
      }
    },
    "required": [
      "create_cgroup"
    ]
  },
  "then": {
    "required": [
      "cgroup_root"
    ]
  }
}
