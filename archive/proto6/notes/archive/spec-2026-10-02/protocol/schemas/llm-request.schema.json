{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/FileRpcRequest"
    },
    {
      "properties": {
        "method": {
          "const": "llm.chat"
        },
        "params": {
          "$ref": "inst.schema.json"
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "llm.chat"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "properties": {
              "argv": {
                "if": {
                  "type": "array"
                },
                "then": {
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "anyOf": [
                        {
                          "const": "aos"
                        },
                        {
                          "$ref": "inst.schema.json#/$defs/ValueDirective"
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "const": "llm"
                        },
                        {
                          "$ref": "inst.schema.json#/$defs/ValueDirective"
                        }
                      ]
                    },
                    {
                      "anyOf": [
                        {
                          "const": "chat"
                        },
                        {
                          "$ref": "inst.schema.json#/$defs/ValueDirective"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
