{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tick-record.schema.json",
  "title": "每項結束碼紀錄",
  "description": "展開後的完整紀錄：.aos/tick/current/（本格）與 last/（上一格）的 record.json 把 ran、tasks、hooks 的 $ref 展開後的樣子；record.json 本體見 $defs/RecordFile。欄位意思見 protocol/tick.md（P-213），寫入時機以 lib/aos_tick_record.py 為準。不認得的欄位忽略（P-007）。跨欄位關係 schema 表達不了，由 examples/messages/record_rules.py 補查。",
  "type": "object",
  "required": [
    "version",
    "seq",
    "ran",
    "tasks",
    "ended"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/TickSeq",
      "description": "本工作資料夾的格數，從 1 起；預設不 fsync，斷電後可能倒退（B-633）"
    },
    "started_at_ms": {
      "$ref": "common.schema.json#/$defs/TimeMs",
      "description": "只給人看，不參與計算"
    },
    "ran": {
      "type": "integer",
      "minimum": 0,
      "description": "本格到目前為止跑完幾項 tasks（含結束碼不是 0 的；被 tasks-blocked 擋掉、沒跑到的不算）；開格時 0，每跑完一項加 1。hooks 不算在內。拆檔後存在 ran.json（一個數字）"
    },
    "tasks": {
      "type": "array",
      "description": "已跑完而且結束碼不是 0（含被訊號殺）的項，照順序；結束碼 0 的不記、沒跑到的不列（第八批）。拆檔後存在 task-exits.json（這個陣列）",
      "items": {
        "$ref": "#/$defs/TaskEnd"
      }
    },
    "ended": {
      "type": "boolean",
      "description": "照表跑完（或被 tasks-blocked 擋下）而且所有 hooks（含 after_all）跑完之後才是 true〔使用者 2026-10-01 第十八批〕；tick 中途出錯或被殺（含跑 hook 時）停在 false"
    },
    "exit": {
      "const": 0,
      "description": "這格 tick 的結束碼。有紀錄收尾時 tick 一定回 0（C-08；busy、blocked、bad_table 不寫紀錄，tick 出錯時停在 ended:false），所以只會是 0（P-203、B-633）；只在 ended 為 true 時有"
    },
    "blocked_before": {
      "$ref": "common.schema.json#/$defs/ID",
      "description": "被 tasks-blocked 全部擋下時，被擋下、沒跑的第一項 id（沒寫 id 時是位置字串）；只在 ended 為 true 時有"
    },
    "skipped": {
      "type": "array",
      "description": "〔第二十四批，AI 隊定〕被 tasks-blocked 的 kinds 擋掉、沒跑的任務，照順序；每筆 id（任務表那一項的 id，沒寫 id 時是位置字串）與 index（在 tasks 陣列的位置）。不算 ran、不進 tasks、相關 hooks 不跑；只有被 kinds 擋過才有，跟 blocked_before 一樣只在 ended 為 true 時有（收尾才寫進 record.json）",
      "items": {
        "type": "object",
        "required": [
          "id",
          "index"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/ID"
          },
          "index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "任務表寫了哪些掛點就有哪些鍵；開格就建好各掛點的 []，格中也會更新（ended:false 時也可能有）。拆檔後存在 hook-exits.json",
      "properties": {
        "after_all": {
          "type": "array",
          "description": "已跑完而且結束碼不是 0 的 after_all 項，照順序；格式同 tasks 每項（index 是它在 after_all 的位置），0 不記；hooks 不記 ran",
          "items": {
            "$ref": "#/$defs/TaskEnd"
          }
        },
        "before_all": {
          "type": "array",
          "description": "已跑完而且結束碼不是 0 的 before_all 項（第十七批），格式同 after_all",
          "items": {
            "$ref": "#/$defs/TaskEnd"
          }
        },
        "before_kind": {
          "type": "array",
          "description": "〔第二十四批〕已跑完而且結束碼不是 0 的 before_kind 項：所有 kind 的混在一起照跑的順序；每筆另帶 task_index；index 是它在那個 kind 的陣列裡的位置",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/TaskEnd"
              },
              {
                "required": [
                  "task_index"
                ],
                "properties": {
                  "task_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "觸發它的那一項任務在 tasks 陣列的位置"
                  }
                }
              }
            ]
          }
        },
        "after_task": {
          "type": "array",
          "description": "已跑完而且結束碼不是 0 的 after_task 項（第十七批）：所有任務 id 的混在一起照跑的順序；每筆另帶 task_index；index 是它在那個任務 id 的陣列裡的位置",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/TaskEnd"
              },
              {
                "required": [
                  "task_index"
                ],
                "properties": {
                  "task_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "觸發它的那一項任務在 tasks 陣列的位置"
                  }
                }
              }
            ]
          }
        },
        "after_kind": {
          "type": "array",
          "description": "〔第二十四批〕已跑完而且結束碼不是 0 的 after_kind 項，格式同 before_kind",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/TaskEnd"
              },
              {
                "required": [
                  "task_index"
                ],
                "properties": {
                  "task_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "觸發它的那一項任務在 tasks 陣列的位置"
                  }
                }
              }
            ]
          }
        },
        "after_every_task": {
          "type": "array",
          "description": "已跑完而且結束碼不是 0 的 after_every_task 項（第十七批），每筆另帶 task_index",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/TaskEnd"
              },
              {
                "required": [
                  "task_index"
                ],
                "properties": {
                  "task_index": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "觸發它的那一項任務在 tasks 陣列的位置"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "ended": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "exit"
    ]
  },
  "else": {
    "allOf": [
      {
        "not": {
          "required": [
            "exit"
          ]
        }
      },
      {
        "not": {
          "required": [
            "blocked_before"
          ]
        }
      },
      {
        "not": {
          "required": [
            "skipped"
          ]
        }
      }
    ]
  },
  "$defs": {
    "TaskEnd": {
      "type": "object",
      "required": [
        "id",
        "index"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/ID",
          "description": "任務表那一項的 id（同 AOS_TASK_ID；沒寫 id 時是位置字串）"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "這一項在 tasks（或 after_all）陣列的位置，從 0 起；同 AOS_TASK_INDEX"
        },
        "exit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255,
          "description": "結束碼；0 不記，所以從 1 起（第八批）"
        },
        "signal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "oneOf": [
        {
          "required": [
            "exit"
          ]
        },
        {
          "required": [
            "signal"
          ]
        }
      ],
      "description": "一項結束碼不是 0 的紀錄（第八批）：{id, index, exit} 或 {id, index, signal}"
    },
    "RecordFile": {
      "type": "object",
      "description": "record.json 本體：不常改的欄位留在這裡，開格寫一次、收尾寫一次；常改的 ran、tasks、hooks 用 $ref 指向同資料夾的 ran.json、task-exits.json、hook-exits.json（任務表寫了 hooks 才有 hooks，開格就有）。展開後要符合本 schema 的根。不認得的欄位忽略（P-007）",
      "required": [
        "version",
        "seq",
        "ran",
        "tasks",
        "ended"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "seq": {
          "$ref": "common.schema.json#/$defs/TickSeq"
        },
        "started_at_ms": {
          "$ref": "common.schema.json#/$defs/TimeMs"
        },
        "ran": {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "const": "ran.json"
            }
          },
          "description": "指示詞 {\"$ref\":\"ran.json\"}：相對 record.json 所在資料夾，整個資料夾改名後仍指得對"
        },
        "tasks": {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "const": "task-exits.json"
            }
          },
          "description": "指示詞 {\"$ref\":\"task-exits.json\"}：相對 record.json 所在資料夾，整個資料夾改名後仍指得對"
        },
        "ended": {
          "type": "boolean"
        },
        "exit": {
          "const": 0
        },
        "blocked_before": {
          "$ref": "common.schema.json#/$defs/ID"
        },
        "skipped": {
          "$ref": "#/properties/skipped"
        },
        "hooks": {
          "type": "object",
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "const": "hook-exits.json"
            }
          },
          "description": "指示詞 {\"$ref\":\"hook-exits.json\"}：相對 record.json 所在資料夾，整個資料夾改名後仍指得對"
        }
      },
      "if": {
        "properties": {
          "ended": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "exit"
        ]
      },
      "else": {
        "allOf": [
          {
            "not": {
              "required": [
                "exit"
              ]
            }
          },
          {
            "not": {
              "required": [
                "blocked_before"
              ]
            }
          },
          {
            "not": {
              "required": [
                "skipped"
              ]
            }
          }
        ]
      }
    }
  }
}
