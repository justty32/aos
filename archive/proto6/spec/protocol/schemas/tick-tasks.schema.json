{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tick-tasks.schema.json",
  "title": "工作資料夾的任務註冊表",
  "description": "<工作資料夾>/.aos/tasks.json 展開指示詞之前的寫法（AOS_DIRNAME 空字串時是 <工作資料夾>/tasks.json）。完整格式，給工具與人驗用；aos-tick 自己只做極簡檢查（B-620）。展開時機、預設合併、hooks、modules 的行為以 spec tick.md、protocol/tick.md（P-202）與 lib/aos_tick_table.py 為準，這裡不重述。不認得的鍵照收、核心忽略（P-007）。",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "tasks": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/Task"
              },
              {
                "$ref": "#/$defs/Ref"
              }
            ]
          }
        },
        {
          "$ref": "#/$defs/Ref",
          "description": "讀表時展開成陣列，例如 {\"$ref\": \"tasks.d/list.json\"}"
        }
      ]
    },
    "_metainfo": {
      "type": "object",
      "description": "可省（使用者裁定 2026-10-01）；整份表的格式標記，核心不看，不是預設",
      "properties": {
        "_type": {
          "const": "aos-tasks"
        },
        "_version": {
          "const": 1
        }
      },
      "required": [
        "_type",
        "_version"
      ]
    },
    "argv": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/argv",
      "description": "每一項的預設 argv；有它時各項可不寫 argv"
    },
    "cwd": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/cwd",
      "description": "每一項的預設 cwd；不改 tick 自己的 cwd，相對路徑以工作資料夾為起點"
    },
    "envs": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/envs",
      "description": "每一項的預設 envs；項自己寫了 envs 就整包換掉，不逐變數合併"
    },
    "stdin": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stdin"
    },
    "stdout": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stdout"
    },
    "stderr": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/stderr"
    },
    "exit": {
      "$ref": "inst.schema.json#/$defs/Inst/properties/exit"
    },
    "hooks": {
      "description": "外掛掛點（B-635）：不是預設；不認得的鍵照收不理。整個可以是指示詞，開格展開。行為見 spec tick/hooks.md",
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^\\$"
            }
          },
          "properties": {
            "after_all": {
              "description": "照表跑完（含被 tasks-blocked 擋下）之後依序跑的一串 inst；寫法比照 tasks；不看 tasks-blocked、碼記進紀錄 hooks.after_all、不影響 tick 的結束碼",
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/Task"
                      },
                      {
                        "$ref": "#/$defs/Ref"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成陣列"
                }
              ]
            },
            "before_all": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/Task"
                      },
                      {
                        "$ref": "#/$defs/Ref"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成陣列"
                }
              ],
              "description": "〔第十七批〕開格後、第一項（含 tasks-blocked 的檢查）之前依序跑的一串 inst；給 AOS_HOOK_*，不給 AOS_TASK_*"
            },
            "before_kind": {
              "description": "〔使用者 2026-10-02 第二十四批〕鍵＝kind，值＝那一類每一個任務跑之前（tasks-blocked 檢查之後）依序跑的一串 inst（只有一個也寫陣列）；給 AOS_HOOK_*、AOS_TASK_ID／INDEX（沒有 AOS_TASK_EXIT）；沒有任務用的 kind＝永遠不跑、不報錯",
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "$ref": "#/$defs/Task"
                            },
                            {
                              "$ref": "#/$defs/Ref"
                            }
                          ]
                        }
                      },
                      {
                        "$ref": "#/$defs/Ref",
                        "description": "讀表時展開成陣列"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成物件"
                }
              ]
            },
            "after_every_task": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/Task"
                      },
                      {
                        "$ref": "#/$defs/Ref"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成陣列"
                }
              ],
              "description": "〔第十七批〕每一項任務跑完之後依序跑的一串 inst（同一項也有 after_task 時排在它後面）；另給剛跑完那一項的 AOS_TASK_ID／INDEX／EXIT"
            },
            "after_task": {
              "description": "〔第十七批〕鍵＝任務 id（沒寫 id 的任務 id 是位置字串），值＝那一項跑完之後依序跑的一串 inst（只有一個也寫陣列）；不存在的 id＝永遠不跑、不報錯",
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "$ref": "#/$defs/Task"
                            },
                            {
                              "$ref": "#/$defs/Ref"
                            }
                          ]
                        }
                      },
                      {
                        "$ref": "#/$defs/Ref",
                        "description": "讀表時展開成陣列"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成物件"
                }
              ]
            },
            "after_kind": {
              "description": "〔使用者 2026-10-02 第二十四批〕鍵＝kind，值＝那一類每一個任務跑完之後依序跑的一串 inst（排在 after_task.<id> 之後、after_every_task 之前）；比照 after_task 另給 AOS_TASK_ID／INDEX／EXIT；沒有任務用的 kind＝永遠不跑、不報錯",
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "oneOf": [
                            {
                              "$ref": "#/$defs/Task"
                            },
                            {
                              "$ref": "#/$defs/Ref"
                            }
                          ]
                        }
                      },
                      {
                        "$ref": "#/$defs/Ref",
                        "description": "讀表時展開成陣列"
                      }
                    ]
                  }
                },
                {
                  "$ref": "#/$defs/Ref",
                  "description": "讀表時展開成物件"
                }
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/Ref",
          "description": "讀表時展開成物件"
        }
      ]
    },
    "modules": {
      "type": "object",
      "description": "一個模組一個鍵；不是 inst 欄位、不當任務預設值。開格整個展開（$ref:\"\"／#… 指整份 tasks.json，相對檔名以工作資料夾為起點；展開失敗＝bad_table）。目前認 tasks-blocked（B-636、P-214），其他鍵照樣展開、但沒人執行",
      "properties": {
        "tasks-blocked": {
          "description": "B-636：某一項之前發現 tasks-blocked 時先依序跑 insts、跑完再看一次（檔被刪就放行）；碼不記、非 0 沒影響。insts 每一元素的寫法與展開同 tasks 每一項",
          "anyOf": [
            {
              "type": "object",
              "required": [
                "insts"
              ],
              "properties": {
                "insts": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/Task"
                          },
                          {
                            "$ref": "#/$defs/Ref"
                          }
                        ]
                      }
                    },
                    {
                      "$ref": "#/$defs/Ref",
                      "description": "讀表時展開成陣列"
                    }
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/Ref",
              "description": "讀表時展開成物件"
            }
          ]
        }
      }
    }
  },
  "if": {
    "not": {
      "required": [
        "argv"
      ]
    }
  },
  "then": {
    "description": "頂層沒給 argv 時，tasks、hooks 各掛點與 modules[\"tasks-blocked\"].insts 的每一項（整項 $ref 的除外，解開後才知道）都要自己有 argv",
    "properties": {
      "tasks": {
        "items": {
          "anyOf": [
            {
              "required": [
                "argv"
              ]
            },
            {
              "required": [
                "$ref"
              ]
            }
          ]
        }
      },
      "hooks": {
        "properties": {
          "after_all": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "argv"
                  ]
                },
                {
                  "required": [
                    "$ref"
                  ]
                }
              ]
            }
          },
          "before_all": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "argv"
                  ]
                },
                {
                  "required": [
                    "$ref"
                  ]
                }
              ]
            }
          },
          "after_every_task": {
            "items": {
              "anyOf": [
                {
                  "required": [
                    "argv"
                  ]
                },
                {
                  "required": [
                    "$ref"
                  ]
                }
              ]
            }
          },
          "after_task": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "required": [
                      "argv"
                    ]
                  },
                  {
                    "required": [
                      "$ref"
                    ]
                  }
                ]
              }
            }
          },
          "before_kind": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "required": [
                      "argv"
                    ]
                  },
                  {
                    "required": [
                      "$ref"
                    ]
                  }
                ]
              }
            }
          },
          "after_kind": {
            "additionalProperties": {
              "items": {
                "anyOf": [
                  {
                    "required": [
                      "argv"
                    ]
                  },
                  {
                    "required": [
                      "$ref"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "modules": {
        "properties": {
          "tasks-blocked": {
            "properties": {
              "insts": {
                "items": {
                  "anyOf": [
                    {
                      "required": [
                        "argv"
                      ]
                    },
                    {
                      "required": [
                        "$ref"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Ref": {
      "type": "object",
      "properties": {
        "$ref": {
          "type": "string"
        },
        "$at": {
          "type": "string"
        }
      },
      "required": [
        "$ref"
      ]
    },
    "Task": {
      "type": "object",
      "description": "inst 的欄位加上 id、kind；argv 可由頂層預設補上（必填與否由根的 if／then 判）",
      "propertyNames": {
        "not": {
          "pattern": "^\\$"
        }
      },
      "properties": {
        "id": {
          "description": "可省；沒寫時 id＝它在 tasks 陣列的位置轉字串（P-202）。可寫指示詞，開格展開後要是字串",
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/ID"
            },
            {
              "$ref": "inst.schema.json#/$defs/ValueDirective"
            }
          ]
        },
        "kind": {
          "description": "可省；任意非空字串，沒有固定清單，不寫＝沒有類別。只拿展開後的字串比對 hooks.before_kind／after_kind 的鍵與 tasks-blocked 的 kinds；頂層的 kind 不是預設。可寫指示詞",
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "inst.schema.json#/$defs/ValueDirective"
            }
          ]
        },
        "_metainfo": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/_metainfo",
          "description": "照 inst（aos-exec）的規則（使用者裁定 2026-10-01）：可省，沒寫＝posix 第 1 版；寫了跑到這一項、合併頂層預設後才照 inst 規則驗，驗不過自然丟錯（tick 回 1）"
        },
        "argv": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/argv"
        },
        "cwd": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/cwd"
        },
        "envs": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/envs"
        },
        "stdin": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stdin"
        },
        "stdout": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stdout"
        },
        "stderr": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/stderr"
        },
        "exit": {
          "$ref": "inst.schema.json#/$defs/Inst/properties/exit"
        }
      }
    }
  }
}
