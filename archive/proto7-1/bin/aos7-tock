#!/usr/bin/env python3
"""aos7-tock 的命令列入口——本體在 ../lib/aos7_tock.py。"""
# 由 daemon 每回合呼叫，也可人手恢復；tock 通知與回合總結交給本體（spec.md 第 7 節）。
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import aos7_tock  # noqa: E402
if __name__ == "__main__":
    sys.exit(aos7_tock.main())
