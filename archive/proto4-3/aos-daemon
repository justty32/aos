#!/usr/bin/env python3
"""aos-daemon：普通的前台程式，本身不背景化。

    aos-daemon [--home H]

家怎麼決定：`--home H` → 環境變數 `AOS_DAEMON_HOME` → 預設 `~/.aos-daemon`。跑起來就寫
`daemon.pid`、進主迴圈，直到收到 SIGTERM／SIGINT（Ctrl-C）或 `{"op":"stop"}` 請求
（用 aos-daemon-ctl stop 丟）才收工。家裡已經有一個活著的 daemon（`daemon.pid` 那個
pid 還活著）→ 印「已經在跑（pid N）」、退出碼 1，不會搶著跑。

stdout／stderr 就是它自己的、原樣印到你的終端機——這支不幫你導去哪個檔。要放背景，
自己來：`aos-daemon &`、丟給 tmux／screen，或交給 systemd 之類的常駐管理員，aos 不管。
下指令用另一支 `aos-daemon-ctl`（add／rm／restart／get／ls／pause／resume／stop）。
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aos_daemon import Daemon
from aos_home import Home, resolve_home


def _pop_home(argv):
    """把 `--home H`／`--home=H` 從任何位置挑掉，回它的值（沒給就是 None）。"""
    for i, a in enumerate(list(argv)):
        if a == "--home" and i + 1 < len(argv):
            argv.pop(i)                 # --home
            return argv.pop(i)          # H
        if a.startswith("--home="):
            argv.pop(i)
            return a.split("=", 1)[1]
    return None


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    home_dir = resolve_home(_pop_home(argv))
    if argv:
        print("不認得的參數：%s（aos-daemon 沒有子命令，下指令用 aos-daemon-ctl）"
              % " ".join(argv), file=sys.stderr)
        return 2
    home = Home(home_dir)
    home.ensure()
    if home.alive():
        print("已經在跑（pid %d）" % home.pid())
        return 1
    Daemon(home).serve()
    return 0


if __name__ == "__main__":
    sys.exit(main())
