#!/usr/bin/env python3
"""驗收員（lib/aos_team_verify.py）在牢裡跑 wf-lint 用的小程式，不是給模型的工具（不在 wf.json）。

aos-jail 把本資料夾唯讀掛在 /opt/tool、專案唯讀掛在 /work/ws、起點 /work/ws（AOS_TOOL_ROOT）。
stdin {"strict": true|false}；stdout 一行 JSON：_wf.lint() 的結果（不含全文 output），或 {"error": 代號, "message": …}。
"""
import json
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _wf  # noqa: E402


def main():
    try:
        args = json.loads(sys.stdin.read() or '{}')
    except ValueError:
        args = {}
    root = os.environ.get('AOS_TOOL_ROOT') or os.getcwd()
    try:
        res = _wf.lint(root, strict=bool(args.get('strict', True)))
    except _wf.WfError as e:
        print(json.dumps({'error': e.code, 'message': e.message}, ensure_ascii=False))
        return 0
    res.pop('output', None)
    print(json.dumps(res, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
