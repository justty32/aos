{
  "_說明": "wrap-cli 機械版 vs 模型版的標準答案（人手寫）。選項用 flags 對（有交集＝同一個），位置參數用出現順序對。type＝string/integer/number/boolean（count 開關算 integer），array＝可以給好幾個值。-h/--help、--version 不算。",
  "csvsum": {"cmd": "csvsum.py", "params": [
    {"flags": [], "type": "string", "array": false, "required": true},
    {"flags": [], "type": "string", "array": true, "required": false},
    {"flags": ["-d", "--delimiter"], "type": "string", "array": false, "required": false},
    {"flags": ["--limit"], "type": "integer", "array": false, "required": false},
    {"flags": ["--ratio"], "type": "number", "array": false, "required": false},
    {"flags": ["--mode"], "type": "string", "array": false, "required": false, "choices": ["sum", "mean", "max"]},
    {"flags": ["-v", "--verbose"], "type": "integer", "array": false, "required": false},
    {"flags": ["--no-header"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--tag"], "type": "string", "array": true, "required": false},
    {"flags": ["--out"], "type": "string", "array": false, "required": true},
    {"flags": ["--strict"], "type": "boolean", "array": false, "required": false}]},
  "gnu_wc": {"cmd": "wc", "help_file": "gnu_wc.txt", "params": [
    {"flags": [], "type": "string", "array": true, "required": false},
    {"flags": ["-c", "--bytes"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-m", "--chars"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-l", "--lines"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--debug"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--files0-from"], "type": "string", "array": false, "required": false},
    {"flags": ["-L", "--max-line-length"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-w", "--words"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--total"], "type": "string", "array": false, "required": false, "choices": ["auto", "always", "only", "never"]}]},
  "gnu_sort": {"cmd": "sort", "help_file": "gnu_sort.txt", "params": [
    {"flags": [], "type": "string", "array": true, "required": false},
    {"flags": ["-b", "--ignore-leading-blanks"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-d", "--dictionary-order"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-f", "--ignore-case"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-g", "--general-numeric-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-i", "--ignore-nonprinting"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-M", "--month-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-h", "--human-numeric-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-n", "--numeric-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-R", "--random-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--random-source"], "type": "string", "array": false, "required": false},
    {"flags": ["-r", "--reverse"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--sort"], "type": "string", "array": false, "required": false, "choices": ["general-numeric", "human-numeric", "month", "numeric", "random", "version"]},
    {"flags": ["-V", "--version-sort"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--batch-size"], "type": "integer", "array": false, "required": false},
    {"flags": ["-c", "--check"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-C"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--compress-program"], "type": "string", "array": false, "required": false},
    {"flags": ["--debug"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--files0-from"], "type": "string", "array": false, "required": false},
    {"flags": ["-k", "--key"], "type": "string", "array": false, "required": false},
    {"flags": ["-m", "--merge"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-o", "--output"], "type": "string", "array": false, "required": false},
    {"flags": ["-s", "--stable"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-S", "--buffer-size"], "type": "string", "array": false, "required": false},
    {"flags": ["-t", "--field-separator"], "type": "string", "array": false, "required": false},
    {"flags": ["-T", "--temporary-directory"], "type": "string", "array": true, "required": false},
    {"flags": ["--parallel"], "type": "integer", "array": false, "required": false},
    {"flags": ["-u", "--unique"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-z", "--zero-terminated"], "type": "boolean", "array": false, "required": false}]},
  "weird_angle": {"cmd": "echoargs.py", "help_file": "weird_angle.txt", "params": [
    {"flags": [], "type": "string", "array": false, "required": true},
    {"flags": [], "type": "string", "array": false, "required": false},
    {"flags": ["-o"], "type": "string", "array": false, "required": false},
    {"flags": ["-q", "--quality"], "type": "integer", "array": false, "required": false},
    {"flags": ["--format"], "type": "string", "array": false, "required": false, "choices": ["png", "jpg", "webp"]},
    {"flags": ["-s", "--strip"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--resize"], "type": "string", "array": false, "required": false},
    {"flags": ["-v"], "type": "integer", "array": false, "required": false}]},
  "weird_bsd": {"cmd": "echoargs.py", "help_file": "weird_bsd.txt", "params": [
    {"flags": [], "type": "string", "array": true, "required": false},
    {"flags": ["-c"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-x"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-v"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-z"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-t"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-C"], "type": "string", "array": false, "required": false},
    {"flags": ["-f"], "type": "string", "array": false, "required": false},
    {"flags": ["-b"], "type": "integer", "array": false, "required": false}]},
  "weird_free": {"cmd": "echoargs.py", "help_file": "weird_free.txt", "params": [
    {"flags": [], "type": "string", "array": false, "required": false},
    {"flags": ["--ignore-case"], "type": "boolean", "array": false, "required": false},
    {"flags": ["--keep"], "type": "string", "array": false, "required": false, "choices": ["first", "last"]},
    {"flags": ["--min-count"], "type": "integer", "array": false, "required": false},
    {"flags": ["--sep"], "type": "string", "array": false, "required": false},
    {"flags": ["-n", "--dry-run"], "type": "boolean", "array": false, "required": false},
    {"flags": ["-z", "--zero"], "type": "boolean", "array": false, "required": false}]}
}
