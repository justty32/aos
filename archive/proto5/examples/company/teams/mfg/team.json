{
  "_metainfo": {
    "_type": "aos_team",
    "_version": 1
  },
  "project": "~/tmp/company-run/proj",
  "tz": "Asia/Taipei",
  "members": {
    "mfg-lead": {
      "template": "lead",
      "model": "gpt-5.5",
      "mail_to": [
        "mfg-writer1",
        "mfg-reviewer",
        "human"
      ],
      "spawn": {
        "allow": true,
        "templates": [
          "worker"
        ],
        "approve": false
      }
    },
    "mfg-writer1": {
      "template": "worker",
      "model": "gpt-6-astra",
      "mail_to": [
        "mfg-lead",
        "human"
      ],
      "mounts": {
        "arknights-corpus": {
          "$opt": "ro",
          "$val": "~/tmp/arknights-corpus"
        }
      }
    },
    "mfg-reviewer": {
      "template": "reviewer",
      "model": "gpt-5.5",
      "mail_to": [
        "mfg-lead",
        "human"
      ],
      "mounts": {
        "arknights-corpus": {
          "$opt": "ro",
          "$val": "~/tmp/arknights-corpus"
        }
      }
    }
  },
  "limits": {
    "stale_minutes": 30,
    "max_members": 6
  },
  "spawn": {
    "templates": []
  },
  "cmd_ok": [
    {
      "run": [
        "python3",
        "scripts/check_links.py",
        "lore"
      ],
      "timeout_s": 180,
      "mounts": {
        "arknights-corpus": "~/tmp/arknights-corpus"
      }
    },
    {
      "run": [
        "python3",
        "scripts/check_simplified.py",
        "lore/characters/{name}.md",
        "lore/evidence/characters/{name}.md"
      ],
      "timeout_s": 180,
      "pattern": true
    },
    {
      "run": [
        "python3",
        "scripts/verify_split.py",
        "aos-drafts/{name}/證據草稿.md",
        "lore/evidence/characters/{name}.md",
        "lore/evidence/characters/{name}"
      ],
      "timeout_s": 180,
      "pattern": true
    }
  ]
}
